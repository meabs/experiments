+package com.salesmanager.core.model.shoppingcart.limit;
+
+import javax.persistence.Column;
+import javax.persistence.Entity;
+import javax.persistence.Id;
+import javax.persistence.Table;
+
+/** How many units of a product one cart may hold (reference implementation for CARTLIMIT). */
+@Entity
+@Table(name = "PRODUCT_CART_LIMIT")
+public class ProductCartLimit {
+
+	/** The product's id: one row per product, and a plain column so deleting a product is never blocked. */
+	@Id
+	@Column(name = "PRODUCT_ID")
+	private Long productId;
+
+	@Column(name = "MIN_PER_CART")
+	private Integer minPerCart;
+
+	@Column(name = "MAX_PER_CART")
+	private Integer maxPerCart;
+
+	@Column(name = "PACK_SIZE")
+	private Integer packSize;
+
+	public Long getProductId() { return productId; }
+	public void setProductId(Long productId) { this.productId = productId; }
+	public Integer getMinPerCart() { return minPerCart; }
+	public void setMinPerCart(Integer minPerCart) { this.minPerCart = minPerCart; }
+	public Integer getMaxPerCart() { return maxPerCart; }
+	public void setMaxPerCart(Integer maxPerCart) { this.maxPerCart = maxPerCart; }
+	public Integer getPackSize() { return packSize; }
+	public void setPackSize(Integer packSize) { this.packSize = packSize; }
+}
