+package com.salesmanager.shop.store.controller.shoppingCart.limit;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.Optional;
+
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.stereotype.Component;
+
+import com.salesmanager.core.business.repositories.shoppingcart.limit.ProductCartLimitRepository;
+import com.salesmanager.core.business.repositories.shoppingcart.limit.StoreCartRuleRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+import com.salesmanager.core.model.shoppingcart.limit.ProductCartLimit;
+import com.salesmanager.core.model.shoppingcart.limit.StoreCartRule;
+import com.salesmanager.shop.model.shoppingcart.ReadableCartLimitWarning;
+import com.salesmanager.shop.store.api.exception.CartLimitException;
+
+/**
+ * Checks cart changes against products' purchase limits and the store's cart caps (reference implementation for
+ * CARTLIMIT). A change is checked against the lines it touches, and against the caps only when it grows the cart, so a
+ * cart that breaks a newer rule can still be fixed one change at a time.
+ */
+@Component
+public class CartLimitChecker {
+
+	public static final String MIN_PER_CART = "MIN_PER_CART", MAX_PER_CART = "MAX_PER_CART", PACK_SIZE = "PACK_SIZE",
+			MAX_LINES = "MAX_LINES", MAX_UNITS = "MAX_UNITS";
+
+	@Autowired
+	private ProductCartLimitRepository limits;
+
+	@Autowired
+	private StoreCartRuleRepository rules;
+
+	@Autowired
+	private ProductService productService;
+
+	/** sku -> quantity for the cart as it is. */
+	public static Map<String, Integer> quantities(ShoppingCart cart) {
+		Map<String, Integer> q = new LinkedHashMap<>();
+		if (cart != null && cart.getLineItems() != null) {
+			for (ShoppingCartItem i : cart.getLineItems()) {
+				q.merge(i.getSku(), i.getQuantity() == null ? 0 : i.getQuantity(), Integer::sum);
+			}
+		}
+		return q;
+	}
+
+	/** Throws CartLimitException if going from before to after breaks a rule. */
+	public void check(Map<String, Integer> before, Map<String, Integer> after, MerchantStore store) {
+		for (Map.Entry<String, Integer> e : after.entrySet()) {
+			int q = e.getValue();
+			if (q > 0 && !Objects.equals(before.get(e.getKey()), q)) {
+				String broken = productRule(e.getKey(), q, store);
+				if (broken != null) {
+					throw new CartLimitException(broken, "quantity " + q + " of " + e.getKey() + " breaks " + broken);
+				}
+			}
+		}
+		Optional<StoreCartRule> rule = rules.findById(store.getId());
+		if (rule.isPresent()) {
+			int linesBefore = lines(before), linesAfter = lines(after), unitsBefore = units(before), unitsAfter = units(after);
+			if (rule.get().getMaxLines() != null && linesAfter > linesBefore && linesAfter > rule.get().getMaxLines()) {
+				throw new CartLimitException(MAX_LINES, "a cart holds at most " + rule.get().getMaxLines() + " products");
+			}
+			if (rule.get().getMaxUnits() != null && unitsAfter > unitsBefore && unitsAfter > rule.get().getMaxUnits()) {
+				throw new CartLimitException(MAX_UNITS, "a cart holds at most " + rule.get().getMaxUnits() + " units");
+			}
+		}
+	}
+
+	/** Every rule the cart breaks now. */
+	public List<ReadableCartLimitWarning> warnings(ShoppingCart cart, MerchantStore store) {
+		List<ReadableCartLimitWarning> w = new ArrayList<>();
+		Map<String, Integer> q = quantities(cart);
+		for (Map.Entry<String, Integer> e : q.entrySet()) {
+			for (String broken : productRules(e.getKey(), e.getValue(), store)) {
+				w.add(new ReadableCartLimitWarning(e.getKey(), broken));
+			}
+		}
+		Optional<StoreCartRule> rule = rules.findById(store.getId());
+		if (rule.isPresent()) {
+			if (rule.get().getMaxLines() != null && lines(q) > rule.get().getMaxLines()) {
+				w.add(new ReadableCartLimitWarning(null, MAX_LINES));
+			}
+			if (rule.get().getMaxUnits() != null && units(q) > rule.get().getMaxUnits()) {
+				w.add(new ReadableCartLimitWarning(null, MAX_UNITS));
+			}
+		}
+		return w;
+	}
+
+	private String productRule(String sku, int q, MerchantStore store) {
+		List<String> r = productRules(sku, q, store);
+		return r.isEmpty() ? null : r.get(0);
+	}
+
+	private List<String> productRules(String sku, int q, MerchantStore store) {
+		List<String> broken = new ArrayList<>();
+		Product p;
+		try {
+			p = productService.getBySku(sku, store, store.getDefaultLanguage());
+		} catch (Exception e) {
+			return broken;
+		}
+		if (p == null) {
+			return broken;
+		}
+		Optional<ProductCartLimit> l = limits.findById(p.getId());
+		if (!l.isPresent() || q <= 0) {
+			return broken;
+		}
+		if (l.get().getMinPerCart() != null && q < l.get().getMinPerCart()) {
+			broken.add(MIN_PER_CART);
+		}
+		if (l.get().getMaxPerCart() != null && q > l.get().getMaxPerCart()) {
+			broken.add(MAX_PER_CART);
+		}
+		if (l.get().getPackSize() != null && q % l.get().getPackSize() != 0) {
+			broken.add(PACK_SIZE);
+		}
+		return broken;
+	}
+
+	private static int lines(Map<String, Integer> q) {
+		return (int) q.values().stream().filter(v -> v > 0).count();
+	}
+
+	private static int units(Map<String, Integer> q) {
+		return q.values().stream().mapToInt(Integer::intValue).sum();
+	}
+}
