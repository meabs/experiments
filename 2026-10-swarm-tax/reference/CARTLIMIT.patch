@@ -0,0 +1,139 @@
+package com.salesmanager.shop.store.api.v1.shoppingCart;
+
+import java.math.BigDecimal;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.repositories.shoppingcart.limit.ProductCartLimitRepository;
+import com.salesmanager.core.business.repositories.shoppingcart.limit.StoreCartRuleRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.limit.ProductCartLimit;
+import com.salesmanager.core.model.shoppingcart.limit.StoreCartRule;
+
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Admin API for purchase limits: per product, and the store's cart caps (reference implementation for CARTLIMIT). */
+@RestController
+@RequestMapping("/api/v1/private")
+@ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT") })
+public class CartLimitApi {
+
+	@Autowired
+	private ProductCartLimitRepository limits;
+
+	@Autowired
+	private StoreCartRuleRepository rules;
+
+	@Autowired
+	private ProductService productService;
+
+	@GetMapping("/product/{id}/limits")
+	public ResponseEntity<?> getLimits(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+		if (productService.findOne(id, store) == null) {
+			return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+		}
+		return ResponseEntity.ok(readable(limits.findById(id).orElse(null)));
+	}
+
+	@PutMapping("/product/{id}/limits")
+	public ResponseEntity<?> setLimits(@PathVariable Long id, @RequestBody Map<String, Object> body, @ApiIgnore MerchantStore store) {
+		if (productService.findOne(id, store) == null) {
+			return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+		}
+		Integer min, max, pack;
+		try {
+			min = positive(body.get("minPerCart"));
+			max = positive(body.get("maxPerCart"));
+			pack = positive(body.get("packSize"));
+		} catch (IllegalArgumentException e) {
+			return bad("limits are whole numbers of at least 1");
+		}
+		if (min != null && max != null && min > max) {
+			return bad("minPerCart is more than maxPerCart");
+		}
+		if (pack != null && max != null && max < pack) {
+			return bad("maxPerCart is less than packSize");
+		}
+		if (min == null && max == null && pack == null) {
+			limits.findById(id).ifPresent(limits::delete);
+			return ResponseEntity.ok(readable((ProductCartLimit) null));
+		}
+		ProductCartLimit l = limits.findById(id).orElseGet(ProductCartLimit::new);
+		l.setProductId(id);
+		l.setMinPerCart(min);
+		l.setMaxPerCart(max);
+		l.setPackSize(pack);
+		return ResponseEntity.ok(readable(limits.save(l)));
+	}
+
+	@GetMapping("/cart-rules")
+	public Map<String, Object> getRules(@ApiIgnore MerchantStore store) {
+		return readable(rules.findById(store.getId()).orElse((StoreCartRule) null));
+	}
+
+	@PutMapping("/cart-rules")
+	public ResponseEntity<?> setRules(@RequestBody Map<String, Object> body, @ApiIgnore MerchantStore store) {
+		Integer lines, units;
+		try {
+			lines = positive(body.get("maxLines"));
+			units = positive(body.get("maxUnits"));
+		} catch (IllegalArgumentException e) {
+			return bad("caps are whole numbers of at least 1");
+		}
+		StoreCartRule r = rules.findById(store.getId()).orElseGet(StoreCartRule::new);
+		r.setMerchantId(store.getId());
+		r.setMaxLines(lines);
+		r.setMaxUnits(units);
+		return ResponseEntity.ok(readable(rules.save(r)));
+	}
+
+	/** null for a missing value; a whole number of at least 1, or IllegalArgumentException. */
+	private static Integer positive(Object o) {
+		if (o == null) {
+			return null;
+		}
+		BigDecimal d;
+		try {
+			d = new BigDecimal(String.valueOf(o));
+		} catch (NumberFormatException e) {
+			throw new IllegalArgumentException(e);
+		}
+		if (d.stripTrailingZeros().scale() > 0 || d.compareTo(BigDecimal.ONE) < 0) {
+			throw new IllegalArgumentException("not a whole number of at least 1");
+		}
+		return d.intValueExact();
+	}
+
+	private static ResponseEntity<?> bad(String message) {
+		return ResponseEntity.badRequest().body(Collections.singletonMap("message", message));
+	}
+
+	private static Map<String, Object> readable(ProductCartLimit l) {
+		Map<String, Object> m = new LinkedHashMap<>();
+		m.put("minPerCart", l == null ? null : l.getMinPerCart());
+		m.put("maxPerCart", l == null ? null : l.getMaxPerCart());
+		m.put("packSize", l == null ? null : l.getPackSize());
+		return m;
+	}
+
+	private static Map<String, Object> readable(StoreCartRule r) {
+		Map<String, Object> m = new LinkedHashMap<>();
+		m.put("maxLines", r == null ? null : r.getMaxLines());
+		m.put("maxUnits", r == null ? null : r.getMaxUnits());
+		return m;
+	}
+}
