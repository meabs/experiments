+++ b/sm-shop/src/main/java/com/salesmanager/shop/store/api/v1/product/ProductQuestionApi.java
@@ -0,0 +1,203 @@
+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.text.SimpleDateFormat;
+import java.util.Collections;
+import java.util.Date;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.TimeZone;
+import java.util.stream.Collectors;
+
+import javax.servlet.http.HttpServletRequest;
+
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Product questions: customers ask, admins answer or reject, everyone reads the answered ones (reference for PRODUCTQA). */
+@RestController
+@RequestMapping("/api/v1")
+@ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT"),
+		@ApiImplicitParam(name = "lang", dataType = "String", defaultValue = "en") })
+public class ProductQuestionApi {
+
+	static final int MIN_TEXT = 10, MAX_TEXT = 500, MAX_ANSWER = 2000, MAX_PENDING = 3;
+
+	@Autowired
+	private ProductQuestionRepository repository;
+
+	@Autowired
+	private ProductService productService;
+
+	@Autowired
+	private CustomerFacade customerFacade;
+
+	@PostMapping("/auth/products/{sku}/questions")
+	public ResponseEntity<?> ask(@PathVariable String sku, @RequestBody Map<String, Object> body, @ApiIgnore MerchantStore store,
+			@ApiIgnore Language language, HttpServletRequest request) {
+		Customer customer = customer(store, request);
+		Product product = product(sku, store, language);
+		if (product == null) {
+			return status(HttpStatus.NOT_FOUND, "unknown product");
+		}
+		String text = body.get("text") == null ? "" : String.valueOf(body.get("text")).trim();
+		if (text.length() < MIN_TEXT || text.length() > MAX_TEXT) {
+			return status(HttpStatus.BAD_REQUEST, "a question has " + MIN_TEXT + " to " + MAX_TEXT + " characters");
+		}
+		if (repository.countPendingByCustomer(customer.getId()) >= MAX_PENDING) {
+			return status(HttpStatus.BAD_REQUEST, "at most " + MAX_PENDING + " questions can wait for an answer");
+		}
+		ProductQuestion q = new ProductQuestion();
+		q.setMerchantId(store.getId());
+		q.setProductId(product.getId());
+		q.setSku(product.getSku());
+		q.setCustomerId(customer.getId());
+		q.setAskedBy(customer.getBilling() == null ? null : customer.getBilling().getFirstName());
+		q.setText(text);
+		q.setStatus(ProductQuestion.PENDING);
+		q.setAskedAt(new Date());
+		return ResponseEntity.status(HttpStatus.CREATED).body(full(repository.save(q)));
+	}
+
+	@GetMapping("/auth/customer/questions")
+	public List<Map<String, Object>> mine(@ApiIgnore MerchantStore store, HttpServletRequest request) {
+		return repository.findByCustomer(customer(store, request).getId()).stream().map(ProductQuestionApi::full)
+				.collect(Collectors.toList());
+	}
+
+	@GetMapping("/products/{sku}/questions")
+	public ResponseEntity<?> published(@PathVariable String sku, @ApiIgnore MerchantStore store, @ApiIgnore Language language) {
+		Product product = product(sku, store, language);
+		if (product == null) {
+			return status(HttpStatus.NOT_FOUND, "unknown product");
+		}
+		List<Map<String, Object>> items = repository.findPublished(product.getId()).stream().map(q -> {
+			Map<String, Object> m = new LinkedHashMap<>();
+			m.put("id", q.getId());
+			m.put("text", q.getText());
+			m.put("answer", q.getAnswer());
+			m.put("askedBy", q.getAskedBy());
+			m.put("answeredAt", iso(q.getAnsweredAt()));
+			return m;
+		}).collect(Collectors.toList());
+		Map<String, Object> out = new LinkedHashMap<>();
+		out.put("count", items.size());
+		out.put("items", items);
+		return ResponseEntity.ok(out);
+	}
+
+	@GetMapping("/private/questions")
+	public ResponseEntity<?> moderation(@RequestParam(value = "status", required = false, defaultValue = "PENDING") String status,
+			@ApiIgnore MerchantStore store) {
+		if (!ProductQuestion.PENDING.equals(status) && !ProductQuestion.PUBLISHED.equals(status) && !ProductQuestion.REJECTED.equals(status)) {
+			return status(HttpStatus.BAD_REQUEST, "status must be PENDING, PUBLISHED or REJECTED");
+		}
+		return ResponseEntity.ok(repository.findByStoreAndStatus(store.getId(), status).stream().map(ProductQuestionApi::full)
+				.collect(Collectors.toList()));
+	}
+
+	@PutMapping("/private/questions/{id}/answer")
+	public ResponseEntity<?> answer(@PathVariable Long id, @RequestBody Map<String, Object> body, @ApiIgnore MerchantStore store) {
+		Optional<ProductQuestion> found = repository.findByStoreAndId(store.getId(), id);
+		if (!found.isPresent()) {
+			return status(HttpStatus.NOT_FOUND, "unknown question");
+		}
+		ProductQuestion q = found.get();
+		if (ProductQuestion.REJECTED.equals(q.getStatus())) {
+			return status(HttpStatus.CONFLICT, "a rejected question cannot be answered");
+		}
+		String answer = body.get("answer") == null ? "" : String.valueOf(body.get("answer")).trim();
+		if (StringUtils.isBlank(answer) || answer.length() > MAX_ANSWER) {
+			return status(HttpStatus.BAD_REQUEST, "an answer has 1 to " + MAX_ANSWER + " characters");
+		}
+		q.setAnswer(answer);
+		q.setStatus(ProductQuestion.PUBLISHED);
+		q.setAnsweredAt(new Date());
+		return ResponseEntity.ok(full(repository.save(q)));
+	}
+
+	@PutMapping("/private/questions/{id}/reject")
+	public ResponseEntity<?> reject(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+		Optional<ProductQuestion> found = repository.findByStoreAndId(store.getId(), id);
+		if (!found.isPresent()) {
+			return status(HttpStatus.NOT_FOUND, "unknown question");
+		}
+		ProductQuestion q = found.get();
+		q.setStatus(ProductQuestion.REJECTED);
+		return ResponseEntity.ok(full(repository.save(q)));
+	}
+
+	private Customer customer(MerchantStore store, HttpServletRequest request) {
+		Principal principal = request.getUserPrincipal();
+		Customer customer;
+		try {
+			customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+		} catch (Exception e) {
+			customer = null;
+		}
+		if (customer == null) {
+			throw new ResourceNotFoundException("No customer for " + principal.getName());
+		}
+		return customer;
+	}
+
+	private Product product(String sku, MerchantStore store, Language language) {
+		try {
+			return productService.getBySku(sku, store, language);
+		} catch (Exception e) {
+			return null;
+		}
+	}
+
+	private static ResponseEntity<?> status(HttpStatus s, String message) {
+		return ResponseEntity.status(s).body(Collections.singletonMap("message", message));
+	}
+
+	private static String iso(Date d) {
+		if (d == null) {
+			return null;
+		}
+		SimpleDateFormat f = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'");
+		f.setTimeZone(TimeZone.getTimeZone("UTC"));
+		return f.format(d);
+	}
+
+	private static Map<String, Object> full(ProductQuestion q) {
+		Map<String, Object> m = new LinkedHashMap<>();
+		m.put("id", q.getId());
+		m.put("sku", q.getSku());
+		m.put("text", q.getText());
+		m.put("status", q.getStatus());
+		m.put("answer", q.getAnswer());
+		m.put("askedBy", q.getAskedBy());
+		m.put("askedAt", iso(q.getAskedAt()));
+		m.put("answeredAt", iso(q.getAnsweredAt()));
+		return m;
+	}
+}
