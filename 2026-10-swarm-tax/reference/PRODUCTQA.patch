@@ -0,0 +1,34 @@
+package com.salesmanager.core.business.repositories.catalog.product.question;
+
+import java.util.List;
+import java.util.Optional;
+
+import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Modifying;
+import org.springframework.data.jpa.repository.Query;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+
+public interface ProductQuestionRepository extends JpaRepository<ProductQuestion, Long> {
+
+	@Query("select q from ProductQuestion q where q.productId = ?1 and q.status = 'PUBLISHED' order by q.answeredAt desc, q.id desc")
+	List<ProductQuestion> findPublished(Long productId);
+
+	@Query("select q from ProductQuestion q where q.merchantId = ?1 and q.status = ?2 order by q.askedAt, q.id")
+	List<ProductQuestion> findByStoreAndStatus(Integer merchantId, String status);
+
+	@Query("select q from ProductQuestion q where q.customerId = ?1 order by q.askedAt desc, q.id desc")
+	List<ProductQuestion> findByCustomer(Long customerId);
+
+	@Query("select count(q) from ProductQuestion q where q.customerId = ?1 and q.status = 'PENDING'")
+	long countPendingByCustomer(Long customerId);
+
+	@Query("select q from ProductQuestion q where q.merchantId = ?1 and q.id = ?2")
+	Optional<ProductQuestion> findByStoreAndId(Integer merchantId, Long id);
+
+	@Transactional
+	@Modifying
+	@Query("delete from ProductQuestion q where q.productId = ?1")
+	void deleteByProduct(Long productId);
+}
diff --git a/sm-shop/src/main/java/com/salesmanager/shop/store/api/v1/product/ProductQuestionApi.java b/sm-shop/src/main/java/com/salesmanager/shop/store/api/v1/product/ProductQuestionApi.java
