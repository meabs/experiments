+package com.salesmanager.core.business.services.catalog.product.alert;
+
+import java.util.Date;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Component;
+
+import com.salesmanager.core.business.repositories.catalog.product.alert.StockAlertMessageRepository;
+import com.salesmanager.core.business.repositories.catalog.product.alert.StockAlertRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.alert.StockAlert;
+import com.salesmanager.core.model.catalog.product.alert.StockAlertMessage;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+
+/**
+ * Sends a product's pending back-in-stock alerts once it has stock (reference implementation for BACKINSTOCK). Alerts can
+ * only be made while a product has no stock, so "has stock now and has pending alerts" means stock rose from zero.
+ */
+@Component
+public class StockAlertNotifier {
+
+	@Inject
+	private StockAlertRepository alerts;
+
+	@Inject
+	private StockAlertMessageRepository messages;
+
+	public static int stock(Product product) {
+		int q = 0;
+		if (product != null && product.getAvailabilities() != null) {
+			for (ProductAvailability a : product.getAvailabilities()) {
+				q += a.getProductQuantity() == null ? 0 : a.getProductQuantity();
+			}
+		}
+		return q;
+	}
+
+	public void stockChanged(Product product, int stock) {
+		if (product == null || product.getId() == null || stock <= 0) {
+			return;
+		}
+		Date now = new Date();
+		for (StockAlert a : alerts.findByProductAndStatus(product.getId(), StockAlert.PENDING)) {
+			a.setStatus(StockAlert.SENT);
+			a.setSentAt(now);
+			alerts.save(a);
+			StockAlertMessage m = new StockAlertMessage();
+			m.setMerchantId(a.getMerchantId());
+			m.setTo(a.getEmail());
+			m.setSku(a.getSku());
+			m.setSubject((a.getProductName() == null ? a.getSku() : a.getProductName()) + " is back in stock");
+			m.setCreatedAt(now);
+			messages.save(m);
+		}
+	}
+}
