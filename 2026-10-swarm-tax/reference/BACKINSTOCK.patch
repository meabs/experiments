@@ -0,0 +1,162 @@
+package com.salesmanager.shop.store.api.v1.product;
+
+import java.text.SimpleDateFormat;
+import java.util.Collections;
+import java.util.Date;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.TimeZone;
+import java.util.regex.Pattern;
+import java.util.stream.Collectors;
+
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.repositories.catalog.product.alert.StockAlertMessageRepository;
+import com.salesmanager.core.business.repositories.catalog.product.alert.StockAlertRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.alert.StockAlertNotifier;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.alert.StockAlert;
+import com.salesmanager.core.model.catalog.product.alert.StockAlertMessage;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Back-in-stock alerts: shoppers ask, admins see the alerts and the outbox (reference implementation for BACKINSTOCK). */
+@RestController
+@RequestMapping("/api/v1")
+@ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT"),
+		@ApiImplicitParam(name = "lang", dataType = "String", defaultValue = "en") })
+public class StockAlertApi {
+
+	private static final Pattern EMAIL = Pattern.compile("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$");
+
+	@Autowired
+	private StockAlertRepository alerts;
+
+	@Autowired
+	private StockAlertMessageRepository messages;
+
+	@Autowired
+	private ProductService productService;
+
+	@PostMapping("/products/{sku}/alerts")
+	public ResponseEntity<?> subscribe(@PathVariable String sku, @RequestBody Map<String, Object> body,
+			@ApiIgnore MerchantStore store, @ApiIgnore Language language) {
+		Product product = product(sku, store, language);
+		if (product == null) {
+			return ResponseEntity.status(HttpStatus.NOT_FOUND).body(Collections.singletonMap("message", "unknown product"));
+		}
+		String email = body.get("email") == null ? null : String.valueOf(body.get("email")).trim();
+		if (StringUtils.isBlank(email) || !EMAIL.matcher(email).matches()) {
+			return ResponseEntity.badRequest().body(Collections.singletonMap("message", "a valid email is required"));
+		}
+		if (StockAlertNotifier.stock(product) > 0) {
+			return ResponseEntity.status(HttpStatus.CONFLICT).body(Collections.singletonMap("message", "the product is in stock"));
+		}
+		Optional<StockAlert> same = pending(product, email);
+		if (same.isPresent()) {
+			return ResponseEntity.ok(readable(same.get()));
+		}
+		StockAlert a = new StockAlert();
+		a.setMerchantId(store.getId());
+		a.setProductId(product.getId());
+		a.setSku(product.getSku());
+		a.setProductName(product.getProductDescription() == null ? product.getSku() : product.getProductDescription().getName());
+		a.setEmail(email);
+		a.setEmailKey(email.toLowerCase());
+		a.setStatus(StockAlert.PENDING);
+		a.setCreatedAt(new Date());
+		return ResponseEntity.status(HttpStatus.CREATED).body(readable(alerts.save(a)));
+	}
+
+	@DeleteMapping("/products/{sku}/alerts")
+	public ResponseEntity<?> unsubscribe(@PathVariable String sku, @RequestParam(value = "email", required = false) String email,
+			@ApiIgnore MerchantStore store, @ApiIgnore Language language) {
+		Product product = product(sku, store, language);
+		if (product == null || StringUtils.isBlank(email)) {
+			return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+		}
+		Optional<StockAlert> a = pending(product, email.trim());
+		if (!a.isPresent()) {
+			return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+		}
+		alerts.delete(a.get());
+		return ResponseEntity.noContent().build();
+	}
+
+	@GetMapping("/private/stock-alerts")
+	public ResponseEntity<?> list(@RequestParam(value = "status", required = false) String status, @ApiIgnore MerchantStore store) {
+		List<StockAlert> l;
+		if (status == null) {
+			l = alerts.findByStore(store.getId());
+		} else if (StockAlert.PENDING.equals(status) || StockAlert.SENT.equals(status)) {
+			l = alerts.findByStoreAndStatus(store.getId(), status);
+		} else {
+			return ResponseEntity.badRequest().body(Collections.singletonMap("message", "status must be PENDING or SENT"));
+		}
+		return ResponseEntity.ok(l.stream().map(StockAlertApi::readable).collect(Collectors.toList()));
+	}
+
+	@GetMapping("/private/stock-alerts/outbox")
+	public List<Map<String, Object>> outbox(@ApiIgnore MerchantStore store) {
+		return messages.findByStore(store.getId()).stream().map(m -> {
+			Map<String, Object> r = new LinkedHashMap<>();
+			r.put("to", m.getTo());
+			r.put("sku", m.getSku());
+			r.put("subject", m.getSubject());
+			r.put("createdAt", iso(m.getCreatedAt()));
+			return r;
+		}).collect(Collectors.toList());
+	}
+
+	private Optional<StockAlert> pending(Product product, String email) {
+		String key = email.toLowerCase();
+		return alerts.findByProductAndStatus(product.getId(), StockAlert.PENDING).stream()
+				.filter(a -> a.getEmailKey().equals(key)).findFirst();
+	}
+
+	private Product product(String sku, MerchantStore store, Language language) {
+		try {
+			return productService.getBySku(sku, store, language);
+		} catch (Exception e) {
+			return null;
+		}
+	}
+
+	private static String iso(Date d) {
+		if (d == null) {
+			return null;
+		}
+		SimpleDateFormat f = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'");
+		f.setTimeZone(TimeZone.getTimeZone("UTC"));
+		return f.format(d);
+	}
+
+	private static Map<String, Object> readable(StockAlert a) {
+		Map<String, Object> m = new LinkedHashMap<>();
+		m.put("id", a.getId());
+		m.put("sku", a.getSku());
+		m.put("email", a.getEmail());
+		m.put("status", a.getStatus());
+		m.put("createdAt", iso(a.getCreatedAt()));
+		m.put("sentAt", iso(a.getSentAt()));
+		return m;
+	}
+}
