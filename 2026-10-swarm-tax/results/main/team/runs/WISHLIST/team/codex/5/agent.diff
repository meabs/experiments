+package com.salesmanager.core.business.services.customer;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.customer.WishlistItemRepository;
+import com.salesmanager.core.model.customer.WishlistItem;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("wishlistService") @Transactional
+public class WishlistServiceImpl implements WishlistService {
+ @Inject private WishlistItemRepository repository;
+ public List<WishlistItem> get(Long c,MerchantStore s){return repository.findByCustomerIdAndMerchantStoreIdOrderByCreatedAtDesc(c,s.getId());}
+ public WishlistItem add(Long c,String sku,MerchantStore s){Optional<WishlistItem> old=repository.findByCustomerIdAndMerchantStoreIdAndSku(c,s.getId(),sku); if(old.isPresent()) return old.get(); WishlistItem w=new WishlistItem();w.setCustomerId(c);w.setSku(sku);w.setMerchantStore(s);return repository.save(w);}
+ public void remove(Long c,String sku,MerchantStore s){repository.deleteByCustomerIdAndMerchantStoreIdAndSku(c,s.getId(),sku);}
+ public List<Object[]> popular(MerchantStore s){return repository.popular(s.getId());}
+ public void purgeSku(String sku,MerchantStore store){repository.deleteBySkuAndMerchantStoreId(sku,store.getId());}
+}
