+package com.salesmanager.core.model.customer;
+
+import java.io.Serializable;
+import java.util.Date;
+import javax.persistence.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+/** A customer's saved product SKU, scoped to a merchant store. */
+@Entity
+@Table(name="WISHLIST_ITEM", uniqueConstraints=@UniqueConstraint(name="WISHLIST_CUSTOMER_SKU_UK", columnNames={"CUSTOMER_ID","MERCHANT_ID","SKU"}), indexes={@Index(name="WISHLIST_STORE_IDX", columnList="MERCHANT_ID"), @Index(name="WISHLIST_SKU_IDX", columnList="SKU")})
+public class WishlistItem implements Serializable {
+ private static final long serialVersionUID=1L;
+ @Id @GeneratedValue(strategy=GenerationType.TABLE, generator="TABLE_GEN")
+ @TableGenerator(name="TABLE_GEN", table="SM_SEQUENCER", pkColumnName="SEQ_NAME", valueColumnName="SEQ_COUNT", pkColumnValue="WISHLIST_SEQ_NEXT_VAL")
+ @Column(name="WISHLIST_ID") private Long id;
+ @Column(name="CUSTOMER_ID",nullable=false) private Long customerId;
+ @ManyToOne(fetch=FetchType.LAZY,optional=false) @JoinColumn(name="MERCHANT_ID",nullable=false) private MerchantStore merchantStore;
+ @Column(name="SKU",nullable=false,length=255) private String sku;
+ @Temporal(TemporalType.TIMESTAMP) @Column(name="CREATED_AT",nullable=false) private Date createdAt=new Date();
+ public Long getId(){return id;} public void setId(Long v){id=v;}
+ public Long getCustomerId(){return customerId;} public void setCustomerId(Long v){customerId=v;}
+ public MerchantStore getMerchantStore(){return merchantStore;} public void setMerchantStore(MerchantStore v){merchantStore=v;}
+ public String getSku(){return sku;} public void setSku(String v){sku=v;}
+ public Date getCreatedAt(){return createdAt;} public void setCreatedAt(Date v){createdAt=v;}
+}
