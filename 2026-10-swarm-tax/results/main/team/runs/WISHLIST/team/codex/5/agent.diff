+package com.salesmanager.shop.store.api.v1.customer;
+import java.security.Principal;
+import java.util.*;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.*;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.business.services.customer.WishlistService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.model.wishlist.*;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController @RequestMapping("/api/v1")
+public class WishlistApi {
+ @Inject private WishlistService wishlistService; @Inject private CustomerService customerService; @Inject private ProductService productService; @Inject private ShoppingCartFacade cartFacade;
+ private Customer customer(HttpServletRequest r,MerchantStore s){Principal p=r.getUserPrincipal(); if(p==null) throw new org.springframework.web.server.ResponseStatusException(HttpStatus.UNAUTHORIZED); Customer c=customerService.getByNick(p.getName(),s.getId()); if(c==null) throw new org.springframework.web.server.ResponseStatusException(HttpStatus.UNAUTHORIZED); return c;}
+ private Product product(String sku,MerchantStore s){try{return productService.getBySku(sku,s);}catch(Exception e){return null;}}
+ @GetMapping("/auth/customer/wishlist") public ReadableWishlist list(@ApiIgnore MerchantStore s,HttpServletRequest r) throws Exception {Customer c=customer(r,s); List<ReadableWishlistItem> out=new ArrayList<>(); wishlistService.get(c.getId(),s).forEach(w->out.add(new ReadableWishlistItem(w.getSku(),w.getCreatedAt()))); return new ReadableWishlist(out);}
+ @PostMapping("/auth/customer/wishlist") public ResponseEntity<ReadableWishlistItem> addBody(@RequestBody PersistableWishlistItem body,@ApiIgnore MerchantStore s,HttpServletRequest r) throws Exception { return add(body.getProduct(),s,r); }
+ @PostMapping("/auth/customer/wishlist/{sku}") public ResponseEntity<ReadableWishlistItem> add(@PathVariable String sku,@ApiIgnore MerchantStore s,HttpServletRequest r) throws Exception {Customer c=customer(r,s); Product p=product(sku,s); if(p==null) return ResponseEntity.badRequest().build(); List<?> all=wishlistService.get(c.getId(),s); if(all.size()>=50 && !wishlistService.get(c.getId(),s).stream().anyMatch(w->w.getSku().equals(sku))) return ResponseEntity.badRequest().build(); com.salesmanager.core.model.customer.WishlistItem w=wishlistService.add(c.getId(),sku,s); return ResponseEntity.status(all.stream().anyMatch(x->((com.salesmanager.core.model.customer.WishlistItem)x).getSku().equals(sku))?HttpStatus.OK:HttpStatus.CREATED).body(new ReadableWishlistItem(w.getSku(),w.getCreatedAt()));}
+ @DeleteMapping("/auth/customer/wishlist/{sku}") public ResponseEntity<Void> remove(@PathVariable String sku,@ApiIgnore MerchantStore s,HttpServletRequest r) throws Exception {Customer c=customer(r,s); if(!wishlistService.get(c.getId(),s).stream().anyMatch(w->w.getSku().equals(sku)))return ResponseEntity.notFound().build(); wishlistService.remove(c.getId(),sku,s); return ResponseEntity.noContent().build();}
+ @PostMapping("/auth/customer/wishlist/{sku}/cart/{cartCode}") public ResponseEntity<ReadableShoppingCart> move(@PathVariable String sku,@PathVariable String cartCode,@ApiIgnore MerchantStore s,@ApiIgnore Language l,HttpServletRequest r){Customer c=customer(r,s); Product p=product(sku,s); if(p==null)return ResponseEntity.notFound().build(); if(!p.isAvailable())return ResponseEntity.status(HttpStatus.CONFLICT).build(); try {PersistableShoppingCartItem i=new PersistableShoppingCartItem();i.setProduct(sku);i.setQuantity(1);ReadableShoppingCart cart=cartFacade.modifyCart(cartCode,i,s,l);wishlistService.remove(c.getId(),sku,s);return ResponseEntity.ok(cart);}catch(Exception e){return ResponseEntity.status(HttpStatus.NOT_FOUND).build();}}
+}
