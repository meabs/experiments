+package com.salesmanager.shop.store.api.v1.customer;
+import java.security.Principal;
+import java.util.*;
+import javax.servlet.http.HttpServletRequest;
+import javax.inject.Inject;
+import org.springframework.web.bind.annotation.*;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.server.ResponseStatusException;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.business.services.customer.wishlist.WishlistService;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.wishlist.Wishlist;
+import com.salesmanager.core.model.shoppingcart.*;
+import com.salesmanager.core.business.services.shoppingcart.ShoppingCartService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.customer.wishlist.ReadableWishlist;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class WishlistApi {
+ @Inject private WishlistService wishlistService; @Inject private CustomerService customerService; @Inject private ProductService productService; @Inject private ShoppingCartService cartService;
+ private Customer customer(HttpServletRequest r, MerchantStore s){Principal p=r.getUserPrincipal(); return customerService.getByNick(p.getName(),s.getCode());}
+ private ReadableWishlist dto(Wishlist w){ReadableWishlist d=new ReadableWishlist();d.setId(w.getId());d.setProductId(w.getProduct().getId());d.setCreatedAt(w.getCreatedAt());return d;}
+ @GetMapping("/auth/customer/wishlist") public List<ReadableWishlist> list(@ApiIgnore MerchantStore s,HttpServletRequest r){List<ReadableWishlist> out=new ArrayList<>();for(Wishlist w:wishlistService.get(customer(r,s),s))out.add(dto(w));return out;}
+ @PostMapping("/auth/customer/wishlist/{productId}") public ReadableWishlist add(@PathVariable Long productId,@ApiIgnore MerchantStore s,HttpServletRequest r) throws Exception {Product p=productService.findOne(productId,s);if(p==null)throw new com.salesmanager.shop.store.api.exception.ResourceNotFoundException("Product not found");return dto(wishlistService.add(customer(r,s),p,s));}
+ @DeleteMapping("/auth/customer/wishlist/{productId}") public void remove(@PathVariable Long productId,@ApiIgnore MerchantStore s,HttpServletRequest r){Product p=productService.findOne(productId,s);if(p==null || wishlistService.get(customer(r,s),s).stream().noneMatch(w->w.getProduct().getId().equals(productId)))throw new com.salesmanager.shop.store.api.exception.ResourceNotFoundException("Wishlist item not found");wishlistService.remove(customer(r,s),p,s);}
+ @Transactional @PostMapping("/auth/customer/wishlist/{sku}/cart/{cartCode}") public void transfer(@PathVariable String sku,@PathVariable String cartCode,@ApiIgnore MerchantStore s,HttpServletRequest r) throws Exception {Customer c=customer(r,s);Product p=productService.getBySku(sku,s);if(p==null)throw new com.salesmanager.shop.store.api.exception.ResourceNotFoundException("Product not found");if(!p.isAvailable())throw new ResponseStatusException(HttpStatus.CONFLICT,"Product unavailable");ShoppingCart cart=cartService.getByCode(cartCode,s);if(cart==null || !c.getId().equals(cart.getCustomerId()))throw new com.salesmanager.shop.store.api.exception.ResourceNotFoundException("Cart not found");ShoppingCartItem found=null;for(ShoppingCartItem i:cart.getLineItems())if(sku.equals(i.getSku()))found=i;if(found==null){found=cartService.populateShoppingCartItem(p,s);found.setShoppingCart(cart);cart.getLineItems().add(found);}else found.setQuantity(found.getQuantity()+1);cartService.saveOrUpdate(cart);wishlistService.remove(c,p,s);}
+ @GetMapping("/private/wishlists/popular") public List<Map<String,Object>> popular(@ApiIgnore MerchantStore s){List<Map<String,Object>> out=new ArrayList<>();for(Object[] row:wishlistService.popular(s)){Map<String,Object> m=new LinkedHashMap<>();m.put("sku",row[0]);m.put("count",row[1]);out.add(m);if(out.size()==10)break;}return out;}
+}
