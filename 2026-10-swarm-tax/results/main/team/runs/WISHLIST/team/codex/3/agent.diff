+package com.salesmanager.core.business.services.customer.wishlist;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.customer.wishlist.WishlistRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.customer.wishlist.Wishlist;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("wishlistService")
+public class WishlistServiceImpl extends SalesManagerEntityServiceImpl<Long,Wishlist> implements WishlistService {
+ private final WishlistRepository repository;
+ @Inject public WishlistServiceImpl(WishlistRepository r){super(r);repository=r;}
+ public Wishlist add(Customer c, Product p, MerchantStore s) throws ServiceException { Wishlist w=repository.findByCustomerIdAndProductIdAndMerchantStoreId(c.getId(),p.getId(),s.getId()); if(w!=null)return w; w=new Wishlist();w.setCustomer(c);w.setProduct(p);w.setMerchantStore(s);save(w);return w; }
+ public void remove(Customer c, Product p, MerchantStore s){Wishlist w=repository.findByCustomerIdAndProductIdAndMerchantStoreId(c.getId(),p.getId(),s.getId());if(w!=null)repository.delete(w);}
+ public List<Wishlist> get(Customer c, MerchantStore s){return repository.findByCustomerIdAndMerchantStoreIdOrderByCreatedAtDesc(c.getId(),s.getId());}
+ public List<Object[]> popular(MerchantStore s){return repository.popular(s.getId());}
+ public void deleteByProduct(Product p){repository.deleteByProductId(p.getId());}
+ public void deleteByCustomer(Customer c){repository.deleteByCustomerId(c.getId());}
+}
