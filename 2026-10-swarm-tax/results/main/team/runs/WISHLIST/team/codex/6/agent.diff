+package com.salesmanager.core.business.services.customer;
+import java.util.*; import javax.inject.Inject; import org.springframework.data.domain.PageRequest; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional; import com.salesmanager.core.business.repositories.customer.WishlistRepository; import com.salesmanager.core.model.customer.*; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("wishlistService") public class WishlistServiceImpl implements WishlistService {
+ @Inject WishlistRepository repo;
+ @Transactional public WishlistItem add(Customer c,Product p,MerchantStore s){ Optional<WishlistItem> old=repo.findByCustomerIdAndProductSkuAndMerchantStoreId(c.getId(),p.getSku(),s.getId()); if(old.isPresent()) return old.get(); if(repo.countByCustomerIdAndMerchantStoreId(c.getId(),s.getId())>=50) throw new IllegalStateException("Wishlist limit exceeded"); WishlistItem w=new WishlistItem(); w.setCustomer(c);w.setProduct(p);w.setMerchantStore(s);return repo.save(w); }
+ @org.springframework.transaction.annotation.Transactional(readOnly=true) public List<WishlistItem> list(Customer c,MerchantStore s){List<WishlistItem> result=repo.findByCustomerIdAndMerchantStoreIdOrderByAddedAtDesc(c.getId(),s.getId()); for(WishlistItem w:result){Product p=w.getProduct(); p.getDescriptions().size(); for(com.salesmanager.core.model.catalog.product.availability.ProductAvailability a:p.getAvailabilities()) a.getPrices().size();} return result;}
+ @Transactional public void remove(Customer c,String sku,MerchantStore s){repo.deleteByCustomerIdAndProductSkuAndMerchantStoreId(c.getId(),sku,s.getId());}
+ public List<Object[]> popular(MerchantStore s){return repo.popular(s.getId(),PageRequest.of(0,10));}
+}
