+package com.salesmanager.core.business.repositories.customer;
+import java.util.*;
+import org.springframework.data.jpa.repository.*;
+import com.salesmanager.core.model.customer.WishlistItem;
+public interface WishlistRepository extends JpaRepository<WishlistItem,Long> {
+ Optional<WishlistItem> findByCustomerIdAndProductSkuAndMerchantStoreId(Long customerId,String sku,Integer storeId);
+ List<WishlistItem> findByCustomerIdAndMerchantStoreIdOrderByAddedAtDesc(Long customerId,Integer storeId);
+ void deleteByCustomerIdAndProductSkuAndMerchantStoreId(Long customerId,String sku,Integer storeId);
+ long countByCustomerIdAndMerchantStoreId(Long customerId,Integer storeId);
+ @Query("select w.product.sku, count(w) from WishlistItem w where w.merchantStore.id=?1 group by w.product.sku order by count(w) desc") List<Object[]> popular(Integer storeId, org.springframework.data.domain.Pageable pageable);
+}
