+package com.salesmanager.shop.store.api.v1.customer;
+import java.security.Principal; import java.util.*; import javax.inject.Inject; import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.customer.WishlistService; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.customer.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.reference.language.Language; import com.salesmanager.shop.model.customer.WishlistItemData; import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem; import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart; import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade; import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class WishlistApi {
+ @Inject WishlistService service; @Inject ProductService products; @Inject CustomerFacade customers; @Inject ShoppingCartFacade carts;
+ public static class WishlistResponse { private int count; private List<WishlistItemData> items; public WishlistResponse(int c,List<WishlistItemData> i){count=c;items=i;} public int getCount(){return count;} public List<WishlistItemData> getItems(){return items;} }
+ private Customer customer(HttpServletRequest r,MerchantStore s){Principal p=r.getUserPrincipal(); return customers.getCustomerByUserName(p.getName(),s);}
+ private WishlistItemData dto(WishlistItem w){Product p=w.getProduct(); String n=p.getProductDescription()==null?null:p.getProductDescription().getName(); Integer stock=0; if(p.getAvailabilities()!=null) for(com.salesmanager.core.model.catalog.product.availability.ProductAvailability a:p.getAvailabilities()) if(a.getMerchantStore()!=null&&a.getMerchantStore().getId().equals(w.getMerchantStore().getId())) stock=a.getProductQuantity(); java.math.BigDecimal price=null; if(p.getAvailabilities()!=null) for(com.salesmanager.core.model.catalog.product.availability.ProductAvailability a:p.getAvailabilities()) if(a.getMerchantStore()!=null&&a.getMerchantStore().getId().equals(w.getMerchantStore().getId())) price=a.defaultPrice().getProductPriceAmount(); return new WishlistItemData(p.getSku(),n,w.getAddedAt(),price,stock); }
+ @PostMapping("/auth/customer/wishlist") public ResponseEntity<WishlistItemData> add(@RequestBody Map<String,String> body,@ApiIgnore MerchantStore store,HttpServletRequest r){String sku=body==null?null:body.get("product");if(sku==null||sku.trim().isEmpty()) throw new org.springframework.web.server.ResponseStatusException(HttpStatus.BAD_REQUEST,"product is required");try{Product p=products.getBySku(sku,store);if(p==null) throw new org.springframework.web.server.ResponseStatusException(HttpStatus.NOT_FOUND,"Product not found");Customer c=customer(r,store);boolean duplicate=service.list(c,store).stream().anyMatch(w->sku.equals(w.getProduct().getSku()));WishlistItem item=service.add(c,p,store);return new ResponseEntity<>(dto(item),duplicate?HttpStatus.OK:HttpStatus.CREATED);}catch(org.springframework.web.server.ResponseStatusException e){throw e;}catch(IllegalStateException e){throw new org.springframework.web.server.ResponseStatusException(HttpStatus.BAD_REQUEST,e.getMessage());}catch(Exception e){throw new org.springframework.web.server.ResponseStatusException(HttpStatus.NOT_FOUND,"Product not found");}}
+ @GetMapping("/auth/customer/wishlist") public WishlistResponse list(@ApiIgnore MerchantStore store,HttpServletRequest r){List<WishlistItemData> out=new ArrayList<>();for(WishlistItem w:service.list(customer(r,store),store))out.add(dto(w));return new WishlistResponse(out.size(),out);}
+ @DeleteMapping("/auth/customer/wishlist/{sku}") @ResponseStatus(HttpStatus.NO_CONTENT) public void remove(@PathVariable String sku,@ApiIgnore MerchantStore store,HttpServletRequest r){service.remove(customer(r,store),sku,store);}
+ @PostMapping("/auth/customer/wishlist/{sku}/cart/{cartCode}") public ReadableShoppingCart cart(@PathVariable String sku,@PathVariable String cartCode,@ApiIgnore MerchantStore store,@ApiIgnore Language language,HttpServletRequest r) throws Exception {Customer c=customer(r,store);if(service.list(c,store).stream().noneMatch(w->sku.equals(w.getProduct().getSku()))) throw new org.springframework.web.server.ResponseStatusException(HttpStatus.NOT_FOUND,"Wishlist item not found");PersistableShoppingCartItem i=new PersistableShoppingCartItem();i.setProduct(sku);i.setQuantity(1);try{ReadableShoppingCart result=carts.modifyCart(cartCode,i,store,language);service.remove(c,sku,store);return result;}catch(Exception e){throw new org.springframework.web.server.ResponseStatusException(HttpStatus.CONFLICT,"Product unavailable");}}
+ @GetMapping("/private/wishlists/popular") public List<Map<String,Object>> popular(@ApiIgnore MerchantStore store){List<Map<String,Object>> out=new ArrayList<>(); for(Object[] row:service.popular(store)){Map<String,Object> m=new LinkedHashMap<>();m.put("sku",row[0]);m.put("count",row[1]);out.add(m);}return out;}
+}
