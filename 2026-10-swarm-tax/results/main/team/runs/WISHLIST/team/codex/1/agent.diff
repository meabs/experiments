+package com.salesmanager.shop.store.api.v1.customer;
+import java.security.Principal; import java.util.List; import javax.inject.Inject; import javax.servlet.http.HttpServletRequest;
+import org.springframework.web.bind.annotation.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.reference.language.Language; import com.salesmanager.core.model.shoppingcart.ShoppingCart; import com.salesmanager.core.business.services.shoppingcart.ShoppingCartService; import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem; import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart; import com.salesmanager.shop.model.wishlist.*; import com.salesmanager.shop.store.controller.wishlist.facade.WishlistFacade; import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class WishlistApi {
+ @Inject private WishlistFacade facade; @Inject private ShoppingCartFacade cartFacade; @Inject private ShoppingCartService cartService; @Inject private com.salesmanager.core.business.services.catalog.product.ProductService productService;
+ private String user(HttpServletRequest r){Principal p=r.getUserPrincipal(); if(p==null) throw new org.springframework.security.access.AccessDeniedException("Authentication required"); return p.getName();}
+ @GetMapping("/auth/customer/wishlist") public List<ReadableWishlistItem> list(@ApiIgnore MerchantStore s,HttpServletRequest r){return facade.list(user(r),s);}
+ @PostMapping("/auth/customer/wishlist") @ResponseStatus(org.springframework.http.HttpStatus.CREATED) public ReadableWishlistItem add(@RequestBody PersistableWishlistItem i,@ApiIgnore MerchantStore s,HttpServletRequest r){return facade.add(user(r),i.getSku(),s);}
+ @DeleteMapping("/auth/customer/wishlist/{id}") @ResponseStatus(org.springframework.http.HttpStatus.NO_CONTENT) public void remove(@PathVariable Long id,@ApiIgnore MerchantStore s,HttpServletRequest r){facade.remove(user(r),id,s);}
+ @PostMapping("/auth/customer/wishlist/{sku}/cart/{cartCode}") public ReadableShoppingCart move(@PathVariable String sku,@PathVariable String cartCode,@ApiIgnore MerchantStore s,@ApiIgnore Language language,HttpServletRequest r) throws Exception { if(facade.list(user(r),s).stream().noneMatch(x->sku.equals(x.getSku()))) throw new com.salesmanager.shop.store.api.exception.ResourceNotFoundException("Wishlist item not found"); ShoppingCart cart=cartService.getByCode(cartCode,s); if(cart==null) throw new com.salesmanager.shop.store.api.exception.ResourceNotFoundException("Cart not found"); int qty=1; com.salesmanager.core.model.catalog.product.Product p; try {p=new com.salesmanager.core.business.services.catalog.product.ProductServiceImpl(null).getBySku(sku,s);} catch(Exception e){throw new com.salesmanager.shop.store.api.exception.ResourceNotFoundException("Product not found");} for(com.salesmanager.core.model.shoppingcart.ShoppingCartItem i:cart.getLineItems()) if(i.getProduct()!=null&&i.getProduct().getId().equals(p.getId())) qty=i.getQuantity()+1; PersistableShoppingCartItem item=new PersistableShoppingCartItem(); item.setProduct(sku);item.setQuantity(qty); try{return cartFacade.modifyCart(cartCode,item,s,language);}catch(Exception e){throw new org.springframework.web.server.ResponseStatusException(org.springframework.http.HttpStatus.CONFLICT,"Insufficient stock",e);} }
+ @GetMapping("/private/wishlist/popular") public List<ReadableWishlistItem> popular(@ApiIgnore MerchantStore s){return facade.popular(s);}
+}
diff --git a/sm-shop/src/main/java/com/salesmanager/shop/store/facade/wishlist/WishlistFacadeImpl.java b/sm-shop/src/main/java/com/salesmanager/shop/store/facade/wishlist/WishlistFacadeImpl.java
