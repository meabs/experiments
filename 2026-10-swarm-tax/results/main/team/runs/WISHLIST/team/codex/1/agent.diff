+package com.salesmanager.core.business.services.customer.wishlist;
+import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.customer.wishlist.WishlistRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.model.customer.*; import com.salesmanager.core.model.customer.wishlist.WishlistItem;
+import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.catalog.product.Product;
+@Service("wishlistService") public class WishlistServiceImpl extends SalesManagerEntityServiceImpl<Long,WishlistItem> implements WishlistService {
+ private final WishlistRepository repo; @Inject public WishlistServiceImpl(WishlistRepository r){super(r);repo=r;}
+ public List<WishlistItem> list(Customer c,MerchantStore s){return repo.findByCustomerIdAndMerchantStoreIdOrderByCreatedAtDesc(c.getId(),s.getId());}
+ public WishlistItem add(Customer c,MerchantStore s,Product p){Optional<WishlistItem> x=repo.findByCustomerIdAndMerchantStoreIdAndSku(c.getId(),s.getId(),p.getSku()); if(x.isPresent())return x.get(); if(repo.findByCustomerIdAndMerchantStoreIdOrderByCreatedAtDesc(c.getId(),s.getId()).size()>=50) throw new IllegalArgumentException("Wishlist limit exceeded"); WishlistItem w=new WishlistItem();w.setCustomer(c);w.setMerchantStore(s);w.setProduct(p);w.setSku(p.getSku()); try{create(w);}catch(ServiceException e){throw new IllegalStateException(e);} return w;}
+ public void remove(Customer c,MerchantStore s,Long id){repo.findByIdAndCustomerIdAndMerchantStoreId(id,c.getId(),s.getId()).ifPresent(x->{try{delete(x);}catch(ServiceException e){throw new IllegalStateException(e);}});}
+ public void removeProduct(Product p){repo.deleteByProductId(p.getId());}
+ public List<Object[]> popular(MerchantStore s){return repo.popular(s.getId());}
+}
