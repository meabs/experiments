@@ -0,0 +1,10 @@
+package com.salesmanager.shop.store.facade.wishlist;
+import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.services.customer.CustomerService; import com.salesmanager.core.business.services.customer.wishlist.WishlistService; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.wishlist.*; import com.salesmanager.shop.store.controller.wishlist.facade.WishlistFacade; import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+@Service("wishlistFacade") public class WishlistFacadeImpl implements WishlistFacade { @Inject WishlistService ws; @Inject CustomerService cs; @Inject ProductService ps;
+ private Customer customer(String n,MerchantStore s){return cs.getByNick(n,s.getCode());} private ReadableWishlistItem map(com.salesmanager.core.model.customer.wishlist.WishlistItem w){ReadableWishlistItem r=new ReadableWishlistItem();r.setId(w.getId());r.setSku(w.getSku());r.setCreatedAt(w.getCreatedAt());r.setProductId(w.getProduct()==null?null:w.getProduct().getId());return r;}
+ public List<ReadableWishlistItem> list(String n,MerchantStore s){Customer c=customer(n,s);if(c==null)return Collections.emptyList();List<ReadableWishlistItem> out=new ArrayList<>();for(com.salesmanager.core.model.customer.wishlist.WishlistItem w:ws.list(c,s))out.add(map(w));return out;}
+ public ReadableWishlistItem add(String n,String sku,MerchantStore s){Customer c=customer(n,s);if(c==null)throw new ResourceNotFoundException("Customer not found");if(sku==null||sku.trim().isEmpty())throw new IllegalArgumentException("Product SKU is required");try{Product p=ps.getBySku(sku,s);if(p==null)throw new ResourceNotFoundException("Product not found");return map(ws.add(c,s,p));}catch(ResourceNotFoundException e){throw e;}catch(IllegalArgumentException e){throw e;}catch(Exception e){throw new ResourceNotFoundException("Product not found");}}
+ public void remove(String n,Long id,MerchantStore s){Customer c=customer(n,s);if(c!=null)ws.remove(c,s,id);}
+ public List<ReadableWishlistItem> popular(MerchantStore s){List<ReadableWishlistItem> out=new ArrayList<>();for(Object[] x:ws.popular(s)){if(out.size()>=10)break;ReadableWishlistItem r=new ReadableWishlistItem();r.setSku((String)x[0]);r.setCount(((Number)x[1]).longValue());out.add(r);}return out;}
+}
