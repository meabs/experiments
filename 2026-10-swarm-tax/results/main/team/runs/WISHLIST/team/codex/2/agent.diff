+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.security.Principal;
+import java.util.*;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import javax.validation.Valid;
+import org.springframework.http.*;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.customer.wishlist.WishlistService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.catalog.product.ReadableProduct;
+import com.salesmanager.shop.model.customer.wishlist.*;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.product.facade.ProductFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class WishlistApi {
+ @Inject private WishlistService wishlistService; @Inject private CustomerFacade customerFacade; @Inject private com.salesmanager.shop.store.controller.customer.facade.v1.CustomerFacade customerFacadeV1; @Inject private ProductFacade productFacade;
+ private Customer customer(HttpServletRequest req, MerchantStore store){ Principal p=req.getUserPrincipal(); if(p==null) throw new ResourceNotFoundException("Authentication required"); Customer c=customerFacade.getCustomerByUserName(p.getName(),store); if(c==null) throw new ResourceNotFoundException("Customer not found"); customerFacadeV1.authorize(c,p); return c; }
+ @GetMapping("/auth/customer/wishlist") public List<ReadableWishlistItem> list(@ApiIgnore MerchantStore store,@ApiIgnore Language lang,HttpServletRequest req){Customer c=customer(req,store); List<ReadableWishlistItem> out=new ArrayList<>(); wishlistService.list(c.getId(),store).forEach(w->{ReadableWishlistItem x=new ReadableWishlistItem();x.setProduct(w.getProductId());x.setSku(w.getSku());x.setCreatedAt(w.getCreatedAt());try{x.setProductDetails(productFacade.getProduct(store,w.getSku(),lang));}catch(Exception ignored){}out.add(x);});return out;}
+ @PostMapping("/auth/customer/wishlist") public ResponseEntity<ReadableWishlistItem> add(@Valid @RequestBody PersistableWishlistItem input,@ApiIgnore MerchantStore store,@ApiIgnore Language lang,HttpServletRequest req){Customer c=customer(req,store); Product p=productFacade.getProduct(input.getProduct(),store); if(p==null) throw new ResourceNotFoundException("Product not found"); String sku=input.getSku()==null?p.getSku():input.getSku(); if(input.getSku()!=null){try{ReadableProduct resolved=productFacade.getProduct(store,input.getSku(),lang); if(resolved==null || resolved.getId()==null || !p.getId().equals(resolved.getId())) throw new ResourceNotFoundException("SKU does not belong to product");}catch(ResourceNotFoundException e){throw e;}catch(Exception e){throw new ResourceNotFoundException("SKU does not belong to product");}} ReadableWishlistItem out=new ReadableWishlistItem();out.setProduct(p.getId());out.setSku(sku);wishlistService.add(c.getId(),store,p.getId(),sku);try{out.setProductDetails(productFacade.getProduct(store,sku,lang));}catch(Exception ignored){}return new ResponseEntity<>(out,HttpStatus.CREATED);}
+ @DeleteMapping("/auth/customer/wishlist/{product}") public ResponseEntity<Void> remove(@PathVariable Long product,@RequestParam(required=false) String sku,@ApiIgnore MerchantStore store,HttpServletRequest req){Customer c=customer(req,store);wishlistService.remove(c.getId(),store,product,sku);return ResponseEntity.noContent().build();}
+ @GetMapping("/private/wishlists/popular") public List<ReadableWishlistItem> popular(@ApiIgnore MerchantStore store,@ApiIgnore Language lang){List<ReadableWishlistItem> out=new ArrayList<>();wishlistService.popular(store).forEach(a->{ReadableWishlistItem x=new ReadableWishlistItem();x.setProduct(((Number)a[0]).longValue());x.setCount(((Number)a[1]).longValue());try{Product p=productFacade.getProduct(x.getProduct(),store);if(p!=null){x.setSku(p.getSku());x.setProductDetails(productFacade.getProduct(store,p.getSku(),lang));}}catch(Exception ignored){}out.add(x);});return out;}
+}
