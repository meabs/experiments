@@ -0,0 +1,50 @@
+package com.salesmanager.shop.store.api.v1;
+
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductLimits;
+import com.salesmanager.shop.model.store.CartRules;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@Controller
+@RequestMapping("/api/v1/private")
+public class CartLimitsApi {
+    @Inject private ProductService productService;
+    @Inject private MerchantStoreService merchantStoreService;
+
+    @GetMapping("/product/{id}/limits")
+    @ResponseBody public ProductLimits getProduct(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        Product p = productService.findOne(id, store);
+        if (p == null || p.getMerchantStore() == null || !p.getMerchantStore().getId().equals(store.getId())) throw new RestApiException("NOT_FOUND", "Product not found");
+        return productLimits(p);
+    }
+    @PutMapping("/product/{id}/limits")
+    @ResponseBody public ProductLimits putProduct(@PathVariable Long id, @RequestBody ProductLimits in, @ApiIgnore MerchantStore store) {
+        validate(in.getMinPerCart(), in.getMaxPerCart(), in.getPackSize());
+        Product p = productService.findOne(id, store);
+        if (p == null || p.getMerchantStore() == null || !p.getMerchantStore().getId().equals(store.getId())) throw new RestApiException("NOT_FOUND", "Product not found");
+        p.setMinPerCart(in.getMinPerCart()); p.setMaxPerCart(in.getMaxPerCart()); p.setPackSize(in.getPackSize());
+        try { productService.saveProduct(p); } catch (Exception e) { throw new RestApiException(e); }
+        return productLimits(p);
+    }
+    @GetMapping("/cart-rules")
+    @ResponseBody public CartRules getRules(@ApiIgnore MerchantStore store) { return rules(store); }
+    @PutMapping("/cart-rules")
+    @ResponseBody public CartRules putRules(@RequestBody CartRules in, @ApiIgnore MerchantStore store) {
+        validate(in.getMaxLines(), in.getMaxUnits());
+        store.setMaxLines(in.getMaxLines()); store.setMaxUnits(in.getMaxUnits());
+        try { merchantStoreService.saveOrUpdate(store); } catch (Exception e) { throw new RestApiException(e); }
+        return rules(store);
+    }
+    private ProductLimits productLimits(Product p) { ProductLimits x = new ProductLimits(); x.setMinPerCart(p.getMinPerCart()); x.setMaxPerCart(p.getMaxPerCart()); x.setPackSize(p.getPackSize()); return x; }
+    private CartRules rules(MerchantStore s) { CartRules x = new CartRules(); x.setMaxLines(s.getMaxLines()); x.setMaxUnits(s.getMaxUnits()); return x; }
+    private void validate(Integer... values) { for (Integer v : values) if (v != null && v <= 0) throw new RestApiException("BAD_REQUEST", "Cart limits must be positive whole numbers"); }
+    private void validate(Integer min, Integer max, Integer pack) { validate(new Integer[]{min,max,pack}); if (min != null && max != null && min > max) throw new RestApiException("BAD_REQUEST", "minPerCart must not exceed maxPerCart"); if (pack != null && max != null && max < pack) throw new RestApiException("BAD_REQUEST", "maxPerCart must be at least packSize"); }
+}
