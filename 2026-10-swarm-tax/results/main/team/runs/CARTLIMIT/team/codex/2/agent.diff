+package com.salesmanager.shop.store.api.v1.shoppingCart;
+
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+import org.springframework.web.server.ResponseStatusException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.shoppingcart.CartLimits;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/cart/limits")
+public class CartLimitsApi {
+ @Inject private ProductService productService;
+ @Inject private MerchantStoreService merchantStoreService;
+ @GetMapping("/product/{sku}") public CartLimits getProduct(@PathVariable String sku, @ApiIgnore MerchantStore store) throws Exception {
+  Product p=productService.getBySku(sku,store); if(p==null) throw new ResourceNotFoundException("Product not found"); return productLimits(p);
+ }
+ @PutMapping("/product/{sku}") public ResponseEntity<CartLimits> putProduct(@PathVariable String sku,@RequestBody CartLimits in,@ApiIgnore MerchantStore store) throws Exception {
+  Product p=productService.getBySku(sku,store); if(p==null) throw new ResourceNotFoundException("Product not found"); validate(in.getMinPerCart(),in.getMaxPerCart(),in.getPackSize(),null,null);
+  p.setMinPerCart(in.getMinPerCart());p.setMaxPerCart(in.getMaxPerCart());p.setPackSize(in.getPackSize()); productService.saveProduct(p); return ResponseEntity.ok(productLimits(p));
+ }
+ @GetMapping("/store") public CartLimits getStore(@ApiIgnore MerchantStore store){return storeLimits(store);}
+ @PutMapping("/store") public ResponseEntity<CartLimits> putStore(@RequestBody CartLimits in,@ApiIgnore MerchantStore store) throws Exception {
+  validate(null,null,null,in.getMaxLines(),in.getMaxUnits()); store.setMaxLines(in.getMaxLines());store.setMaxUnits(in.getMaxUnits());merchantStoreService.saveOrUpdate(store);return ResponseEntity.ok(storeLimits(store));
+ }
+ private void validate(Integer min,Integer max,Integer pack,Integer lines,Integer units){for(Integer v:new Integer[]{min,max,pack,lines,units})if(v!=null&&v<1)throw new ResponseStatusException(HttpStatus.BAD_REQUEST,"limits must be positive integers");if(min!=null&&max!=null&&min>max)throw new ResponseStatusException(HttpStatus.BAD_REQUEST,"minPerCart must not exceed maxPerCart");}
+ private CartLimits productLimits(Product p){CartLimits x=new CartLimits();x.setMinPerCart(p.getMinPerCart());x.setMaxPerCart(p.getMaxPerCart());x.setPackSize(p.getPackSize());return x;}
+ private CartLimits storeLimits(MerchantStore s){CartLimits x=new CartLimits();x.setMaxLines(s.getMaxLines());x.setMaxUnits(s.getMaxUnits());return x;}
+}
