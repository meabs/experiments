+	private void validateLimits(ShoppingCart cart, com.salesmanager.core.model.shoppingcart.ShoppingCartItem candidate,
+			int requested, MerchantStore store, boolean delta) {
+		Product product = candidate.getProduct();
+		if (requested < 0) throw new ServiceRuntimeException("CART_INVALID_QUANTITY", "Quantity cannot be negative");
+		int existingQuantity = 0;
+		if (cart.getLineItems() != null) for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem existing : cart.getLineItems())
+			if (existing.getProduct() != null && existing.getProduct().getId().equals(product.getId())) existingQuantity += existing.getQuantity() == null ? 0 : existing.getQuantity();
+		int resultingQuantity = delta ? existingQuantity + requested : requested;
+		if (resultingQuantity > 0 && product.getMinPerCart() != null && resultingQuantity < product.getMinPerCart())
+			throw new ServiceRuntimeException("PRODUCT_MIN_PER_CART", "Minimum quantity for " + product.getSku() + " is " + product.getMinPerCart());
+		if (resultingQuantity > 0 && product.getMaxPerCart() != null && resultingQuantity > product.getMaxPerCart())
+			throw new ServiceRuntimeException("PRODUCT_MAX_PER_CART", "Maximum quantity for " + product.getSku() + " is " + product.getMaxPerCart());
+		if (resultingQuantity > 0 && product.getPackSize() != null && product.getPackSize() > 1 && resultingQuantity % product.getPackSize() != 0)
