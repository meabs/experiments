+package com.salesmanager.shop.store.api.v1.cart;
+
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.shop.model.cart.CartRules;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/cart-rules")
+public class CartRulesApi {
+  @javax.inject.Inject private MerchantStoreService merchantStoreService;
+  @GetMapping public CartRules get(@ApiIgnore MerchantStore store) { return rules(store); }
+  @PutMapping public CartRules put(@RequestBody CartRules request, @ApiIgnore MerchantStore store) {
+    validate(request.getMaxLines(), request.getMaxUnits());
+    store.setMaxLines(request.getMaxLines()); store.setMaxUnits(request.getMaxUnits());
+    try { merchantStoreService.saveOrUpdate(store); } catch (Exception e) { throw new ServiceRuntimeException("INVALID_CART_RULES", "Unable to save cart rules", e); }
+    return rules(store);
+  }
+  private CartRules rules(MerchantStore store) { CartRules r = new CartRules(); r.setMaxLines(store.getMaxLines()); r.setMaxUnits(store.getMaxUnits()); return r; }
+  private void validate(Integer lines, Integer units) {
+    if (lines != null && lines <= 0 || units != null && units <= 0)
+      throw new ServiceRuntimeException("INVALID_CART_RULES", "Cart limits must be positive");
+  }
+}
