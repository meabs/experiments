+package com.salesmanager.shop.store.api.v1.product;
+
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.product.ProductLimits;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import springfox.documentation.annotations.ApiIgnore;
+import javax.inject.Inject;
+
+@RestController
+@RequestMapping("/api/v1/private/product")
+public class ProductLimitsApi {
+  @Inject private ProductService productService;
+  @GetMapping("/{id}/limits") public ProductLimits get(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+    return toLimits(product(id, store));
+  }
+  @PutMapping("/{id}/limits") public ProductLimits put(@PathVariable Long id, @RequestBody ProductLimits request, @ApiIgnore MerchantStore store) {
+    Product p = product(id, store); validate(request);
+    p.setMinPerCart(request.getMinPerCart()); p.setMaxPerCart(request.getMaxPerCart()); p.setPackSize(request.getPackSize());
+    try { productService.saveProduct(p); } catch (Exception e) { throw new ServiceRuntimeException("INVALID_PRODUCT_LIMITS", "Unable to save product limits", e); }
+    return toLimits(p);
+  }
+  private Product product(Long id, MerchantStore store) { Product p = productService.findOne(id, store); if (p == null || p.getMerchantStore() == null || !p.getMerchantStore().getId().equals(store.getId())) throw new ResourceNotFoundException("404", "Product not found"); return p; }
+  private void validate(ProductLimits l) { if (l.getMinPerCart()!=null && l.getMinPerCart()<=0 || l.getMaxPerCart()!=null && l.getMaxPerCart()<=0 || l.getPackSize()!=null && l.getPackSize()<=0 || l.getMinPerCart()!=null && l.getMaxPerCart()!=null && l.getMinPerCart()>l.getMaxPerCart()) throw new ServiceRuntimeException("INVALID_PRODUCT_LIMITS", "Invalid product limits"); }
+  private ProductLimits toLimits(Product p) { ProductLimits l = new ProductLimits(); l.setMinPerCart(p.getMinPerCart()); l.setMaxPerCart(p.getMaxPerCart()); l.setPackSize(p.getPackSize()); return l; }
+}
