+	private ReadableShoppingCart withLimitWarnings(ReadableShoppingCart out, ShoppingCart cart, MerchantStore store) {
+		List<String> warnings = new ArrayList<String>();
+		int lines = cart.getLineItems() == null ? 0 : cart.getLineItems().size(), units = 0;
+		if (cart.getLineItems() != null) for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : cart.getLineItems()) {
+			int q = i.getQuantity() == null ? 0 : i.getQuantity(); units += q; Product p = i.getProduct();
+			if (p.getMinPerCart() != null && q < p.getMinPerCart()) warnings.add("MIN_PER_CART:" + p.getSku());
+			if (p.getMaxPerCart() != null && q > p.getMaxPerCart()) warnings.add("MAX_PER_CART:" + p.getSku());
+			if (p.getPackSize() != null && p.getPackSize() > 0 && q % p.getPackSize() != 0) warnings.add("PACK_SIZE:" + p.getSku());
+		}
+		if (store.getMaxLines() != null && lines > store.getMaxLines()) warnings.add("MAX_LINES");
+		if (store.getMaxUnits() != null && units > store.getMaxUnits()) warnings.add("MAX_UNITS");
+		out.setLimitWarnings(warnings); return out;
+	}
