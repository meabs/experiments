+			if (p.getMaxPerCart()!=null && q>p.getMaxPerCart()) fail("MAX_PER_CART");
+			if (p.getPackSize()!=null && p.getPackSize()>0 && q>0 && q%p.getPackSize()!=0) fail("PACK_SIZE");
+		}
+		int units=quantities.values().stream().mapToInt(Integer::intValue).sum(), lines=quantities.size();
+		// Store caps intentionally apply only when the operation increases the cart.
