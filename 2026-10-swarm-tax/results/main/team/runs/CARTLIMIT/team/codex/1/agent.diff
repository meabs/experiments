+package com.salesmanager.shop.store.api.v1.cart;
+
+import javax.inject.Inject;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.cart.ProductLimits;
+import com.salesmanager.shop.model.cart.CartRules;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+
+@Controller
+@RequestMapping("/api/v1/private")
+public class CartLimitsApi {
+ @Inject private ProductService productService;
+ @Inject private MerchantStoreService storeService;
+
+ @GetMapping("/product/{id}/limits")
+ @ResponseBody public ProductLimits product(@PathVariable Long id, @RequestParam(value="store", required=false) String store, @RequestAttribute(value="MERCHANT_STORE", required=false) MerchantStore injected) {
+  Product p = productService.findOne(id, resolveStore(store, injected));
+  if (p==null) throw new ResourceNotFoundException("Product not found: " + id);
+  ProductLimits out=new ProductLimits(); out.setMinPerCart(p.getMinPerCart()); out.setMaxPerCart(p.getMaxPerCart()); out.setPackSize(p.getPackSize()); return out;
+ }
+ @PutMapping("/product/{id}/limits")
+ @ResponseBody public ProductLimits updateProduct(@PathVariable Long id, @RequestParam(value="store", required=false) String store, @RequestBody ProductLimits body, @RequestAttribute(value="MERCHANT_STORE", required=false) MerchantStore injected) {
+  MerchantStore s=resolveStore(store,injected); Product p=productService.findOne(id,s); if(p==null) throw new ResourceNotFoundException("Product not found: " + id);
+  positive(body.getMinPerCart(),"MIN_PER_CART"); positive(body.getMaxPerCart(),"MAX_PER_CART"); positive(body.getPackSize(),"PACK_SIZE");
+  p.setMinPerCart(body.getMinPerCart()); p.setMaxPerCart(body.getMaxPerCart()); p.setPackSize(body.getPackSize()); try { productService.saveProduct(p); } catch(Exception e) { throw new ServiceRuntimeException(e); } return body;
+ }
+ @GetMapping("/cart-rules") @ResponseBody public CartRules rules(@RequestParam(value="store", required=false) String store, @RequestAttribute(value="MERCHANT_STORE", required=false) MerchantStore injected) { MerchantStore s=resolveStore(store,injected); CartRules r=new CartRules(); r.setMaxLines(s.getMaxLines()); r.setMaxUnits(s.getMaxUnits()); return r; }
+ @PutMapping("/cart-rules") @ResponseBody public CartRules updateRules(@RequestParam(value="store", required=false) String store, @RequestBody CartRules body, @RequestAttribute(value="MERCHANT_STORE", required=false) MerchantStore injected) { MerchantStore s=resolveStore(store,injected); positive(body.getMaxLines(),"MAX_LINES"); positive(body.getMaxUnits(),"MAX_UNITS"); s.setMaxLines(body.getMaxLines()); s.setMaxUnits(body.getMaxUnits()); try { storeService.saveOrUpdate(s); } catch(Exception e) { throw new ServiceRuntimeException(e); } return body; }
+ private MerchantStore resolveStore(String code, MerchantStore injected) { try { MerchantStore s=code==null?injected:storeService.getByCode(code); if(s==null) throw new ResourceNotFoundException("Store not found: "+code); return s; } catch(ResourceNotFoundException e){throw e;} catch(Exception e){throw new ResourceNotFoundException("Store not found: "+code);} }
+ private void positive(Integer n,String code) { if(n!=null && n<=0) throw new ServiceRuntimeException(code,"Value must be positive"); }
+}
