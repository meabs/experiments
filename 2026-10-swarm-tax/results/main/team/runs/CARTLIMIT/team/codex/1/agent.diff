+	private void validateLimits(ShoppingCart cart, List<PersistableShoppingCartItem> incoming, MerchantStore store, boolean incrementExisting) {
+		Map<String,Integer> quantities = new HashMap<>();
+		if (cart != null && cart.getLineItems() != null) for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : cart.getLineItems())
+			quantities.put(i.getSku(), i.getQuantity());
+		int oldUnits = quantities.values().stream().mapToInt(Integer::intValue).sum();
+		int oldLines = quantities.size();
+		Map<String,Product> products = new HashMap<>();
+		for (PersistableShoppingCartItem request : incoming) {
+			if (request.getQuantity() < 0) throw new ServiceRuntimeException("CART_LIMIT", "Quantity must not be negative");
+			Product p = fetchProduct(request.getProduct(), store, store.getDefaultLanguage());
+			if (p == null) throw new ResourceNotFoundException("Product with sku " + request.getProduct() + " does not exist");
+			products.put(request.getProduct(), p);
+			int proposed = request.getQuantity();
+			if (incrementExisting && CollectionUtils.isEmpty(request.getAttributes())) {
+				Integer current = quantities.get(request.getProduct());
+				if (current != null) proposed += current;
+			}
+			quantities.put(request.getProduct(), proposed);
+		}
