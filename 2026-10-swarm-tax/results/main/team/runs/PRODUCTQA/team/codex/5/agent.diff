+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.Date;
+import java.util.List;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import javax.validation.Valid;
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import org.springframework.web.server.ResponseStatusException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.*;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.model.catalog.product.*;
+import com.salesmanager.shop.store.controller.user.facade.UserFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Customer product questions and merchant moderation. */
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+ private static final long MAX_PENDING=3;
+ @Inject private ProductQuestionService questionService;
+ @Inject private ProductService productService;
+ @Inject private CustomerService customerService;
+ @Inject private UserFacade userFacade;
+
+ @PostMapping("/auth/products/{sku}/questions")
+ @ResponseStatus(HttpStatus.CREATED)
+ public ProductQuestionEntity ask(@PathVariable String sku,@Valid @RequestBody ProductQuestionRequest request,
+   @ApiIgnore MerchantStore store,HttpServletRequest http) throws Exception {
+  Customer customer=currentCustomer(store,http); Product product=product(sku,store);
+  if(questionService.countPending(customer.getId(),store.getId())>=MAX_PENDING) throw new ResponseStatusException(HttpStatus.CONFLICT,"Pending question limit reached");
+  ProductQuestion q=new ProductQuestion(); q.setProduct(product); q.setCustomer(customer); q.setMerchantStore(store); q.setQuestion(StringUtils.trim(request.getQuestion())); q.setStatus(ProductQuestionStatus.PENDING); q.setCreatedAt(new Date()); questionService.create(q); return map(q);
+ }
+
+ @GetMapping("/products/{sku}/questions")
+ public List<ProductQuestionEntity> published(@PathVariable String sku,@ApiIgnore MerchantStore store) throws Exception { return questionService.getPublished(product(sku,store).getId(),store.getId()).stream().map(this::map).collect(Collectors.toList()); }
+
+ @GetMapping("/auth/customer/questions")
+ public List<ProductQuestionEntity> mine(@ApiIgnore MerchantStore store,HttpServletRequest http) throws Exception { Customer c=currentCustomer(store,http); return questionService.getByCustomer(c.getId(),store.getId()).stream().map(this::map).collect(Collectors.toList()); }
+
+ @GetMapping("/private/questions")
+ public List<ProductQuestionEntity> pending(@ApiIgnore MerchantStore store,HttpServletRequest http) { authorize(http); return questionService.getPending(store.getId()).stream().map(this::map).collect(Collectors.toList()); }
+
+ @PostMapping("/private/questions/{id}/answer")
+ public ProductQuestionEntity answer(@PathVariable Long id,@Valid @RequestBody ProductQuestionAnswer body,@ApiIgnore MerchantStore store,HttpServletRequest http) throws Exception { authorize(http); ProductQuestion q=find(id,store); if(q.getStatus()==ProductQuestionStatus.REJECTED) throw new ResponseStatusException(HttpStatus.CONFLICT,"Rejected question cannot be answered"); q.setAnswer(StringUtils.trim(body.getAnswer())); q.setStatus(ProductQuestionStatus.PUBLISHED); q.setAnsweredAt(new Date()); questionService.update(q); return map(q); }
+
+ @PostMapping("/private/questions/{id}/reject")
+ public ProductQuestionEntity reject(@PathVariable Long id,@ApiIgnore MerchantStore store,HttpServletRequest http) throws Exception { authorize(http); ProductQuestion q=find(id,store); if(q.getStatus()!=ProductQuestionStatus.PENDING) throw new ResponseStatusException(HttpStatus.CONFLICT,"Only pending questions can be rejected"); q.setStatus(ProductQuestionStatus.REJECTED); q.setAnsweredAt(new Date()); questionService.update(q); return map(q); }
+
+ private ProductQuestion find(Long id,MerchantStore store){ ProductQuestion q=questionService.getById(id); if(q==null || q.getMerchantStore()==null || !store.getId().equals(q.getMerchantStore().getId())) throw new ResponseStatusException(HttpStatus.NOT_FOUND,"Question not found"); return q; }
+ private Product product(String sku,MerchantStore store) throws Exception { Product p=productService.getBySku(sku,store); if(p==null) throw new ResponseStatusException(HttpStatus.NOT_FOUND,"Product not found"); return p; }
+ private Customer currentCustomer(MerchantStore store,HttpServletRequest r){ Principal p=r.getUserPrincipal(); if(p==null) throw new ResponseStatusException(HttpStatus.UNAUTHORIZED,"Authentication required"); Customer c=customerService.getByNick(p.getName(),store.getId()); if(c==null) throw new ResponseStatusException(HttpStatus.UNAUTHORIZED,"Customer not found"); return c; }
+ private void authorize(HttpServletRequest r){ String u=userFacade.authenticatedUser(); if(u==null) throw new ResponseStatusException(HttpStatus.UNAUTHORIZED,"Authentication required"); userFacade.authorizedGroup(u,java.util.Arrays.asList(Constants.GROUP_SUPERADMIN,Constants.GROUP_ADMIN,Constants.GROUP_ADMIN_RETAIL)); }
+ private ProductQuestionEntity map(ProductQuestion q){ ProductQuestionEntity e=new ProductQuestionEntity(); e.setId(q.getId()); e.setQuestion(q.getQuestion()); e.setAnswer(q.getAnswer()); e.setStatus(q.getStatus()==null?null:q.getStatus().name()); e.setCreatedAt(q.getCreatedAt()); e.setAnsweredAt(q.getAnsweredAt()); if(q.getProduct()!=null)e.setSku(q.getProduct().getSku()); if(q.getCustomer()!=null && q.getCustomer().getBilling()!=null)e.setCustomerFirstName(q.getCustomer().getBilling().getFirstName()); return e; }
+}
