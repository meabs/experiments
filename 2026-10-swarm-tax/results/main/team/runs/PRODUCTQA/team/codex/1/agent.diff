+package com.salesmanager.core.business.services.catalog.product;
+import java.util.List; import java.util.Optional; import javax.inject.Inject; import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.ProductQuestionRepository; import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl; import com.salesmanager.core.model.catalog.product.*; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("productQuestionService") public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long,ProductQuestion> implements ProductQuestionService {
+ private final ProductQuestionRepository repo; @Inject public ProductQuestionServiceImpl(ProductQuestionRepository r){super(r);repo=r;}
+ public List<ProductQuestion> getPublished(Product p){return repo.findByProductAndStatusOrderByAskedAtDesc(p,ProductQuestionStatus.PUBLISHED);} public List<ProductQuestion> getByCustomer(Customer c){return repo.findByCustomerOrderByAskedAtDesc(c);} public List<ProductQuestion> getByStore(MerchantStore s,ProductQuestionStatus st){return repo.findByProduct_MerchantStoreAndStatusOrderByAskedAtDesc(s,st);} public long countPending(Customer c){return repo.countByCustomerAndStatus(c,ProductQuestionStatus.PENDING);}
+ public Optional<ProductQuestion> find(Long id){return repo.findById(id);}
+ @Override public ProductQuestion getById(Long id){return repo.findById(id).orElse(null);}
+ public void save(ProductQuestion q){try{super.save(q);}catch(Exception e){throw new IllegalStateException(e);}}
+ public void update(ProductQuestion q){try{super.update(q);}catch(Exception e){throw new IllegalStateException(e);}}
+}
