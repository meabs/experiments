+package com.salesmanager.shop.store.api.v1.product;
+import java.security.Principal; import java.util.*; import javax.inject.Inject; import javax.servlet.http.HttpServletRequest; import javax.validation.Valid;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.core.business.exception.ServiceException;
+import org.springframework.http.*; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductQuestionService; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.customer.CustomerService; import com.salesmanager.core.model.catalog.product.ProductQuestion; import com.salesmanager.core.model.catalog.product.ProductQuestionStatus; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.catalog.product.PersistableProductAnswer; import com.salesmanager.shop.model.catalog.product.PersistableProductQuestion; import com.salesmanager.shop.model.catalog.product.ReadableProductQuestion; import com.salesmanager.shop.store.api.exception.RestApiException; import com.salesmanager.shop.store.security.user.JWTUser; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class ProductQuestionApi {
+ @Inject private ProductQuestionService questions; @Inject private ProductService products; @Inject private CustomerService customers;
+ private Customer customer(Principal p, MerchantStore s){ if(p==null) throw new RestApiException("401","Authentication required"); Long id=p instanceof JWTUser?((JWTUser)p).getId():null; Customer c=id==null?customers.getByNick(p.getName(),s.getCode()):customers.getById(id); if(c==null||c.getMerchantStore().getId().longValue()!=s.getId().longValue()) throw new RestApiException("404","Customer not found"); return c; }
+ private Product product(String sku,MerchantStore s){try {Product p=products.getBySku(sku,s); if(p==null) throw new ResourceNotFoundException("Product not found"); return p;} catch(ServiceException e){throw new ResourceNotFoundException("Product not found");}}
+ private ProductQuestion question(Long id,MerchantStore s){ProductQuestion q=questions.find(id).orElseThrow(()->new ResourceNotFoundException("Question not found")); if(q.getProduct().getMerchantStore().getId().longValue()!=s.getId().longValue()) throw new ResourceNotFoundException("Question not found"); return q;}
+ private String clean(String v){return v==null?null:v.trim();}
+ @PostMapping("/auth/products/{sku}/questions") @ResponseStatus(HttpStatus.CREATED) public ReadableProductQuestion ask(@PathVariable String sku,@Valid @RequestBody PersistableProductQuestion body,Principal principal,@ApiIgnore MerchantStore store){String t=clean(body.getText()); if(t==null||t.length()<10||t.length()>500) throw new RestApiException("400","Question text must be 10-500 characters"); Customer c=customer(principal,store); if(questions.countPending(c)>=3) throw new RestApiException("409","Maximum pending questions reached"); ProductQuestion q=new ProductQuestion(); q.setProduct(product(sku,store));q.setCustomer(c);q.setText(t);q.setStatus(ProductQuestionStatus.PENDING);questions.save(q);return new ReadableProductQuestion(q);}
+ @GetMapping("/auth/customer/questions") public List<ReadableProductQuestion> mine(Principal p,@ApiIgnore MerchantStore s){List<ReadableProductQuestion> out=new ArrayList<>();for(ProductQuestion q:questions.getByCustomer(customer(p,s)))out.add(new ReadableProductQuestion(q));return out;}
+ @GetMapping("/products/{sku}/questions") public List<ReadableProductQuestion> published(@PathVariable String sku,@ApiIgnore MerchantStore s){List<ReadableProductQuestion> out=new ArrayList<>();for(ProductQuestion q:questions.getPublished(product(sku,s)))out.add(new ReadableProductQuestion(q));return out;}
+ @GetMapping("/private/questions") public List<ReadableProductQuestion> admin(@RequestParam(required=false) String status,@ApiIgnore MerchantStore s){ProductQuestionStatus st;try{st=status==null?ProductQuestionStatus.PENDING:ProductQuestionStatus.valueOf(status.trim().toUpperCase());}catch(Exception e){throw new RestApiException("400","Invalid status");}List<ReadableProductQuestion> out=new ArrayList<>();for(ProductQuestion q:questions.getByStore(s,st))out.add(new ReadableProductQuestion(q));return out;}
+ @PutMapping("/private/questions/{id}/answer") public ReadableProductQuestion answer(@PathVariable Long id,@Valid @RequestBody PersistableProductAnswer body,@ApiIgnore MerchantStore s){ProductQuestion q=questions.getById(id);if(q==null||q.getProduct().getMerchantStore().getId().intValue()!=s.getId().intValue())throw new RestApiException("404","Question not found");if(q.getStatus()==ProductQuestionStatus.REJECTED)throw new RestApiException("409","Rejected question cannot be answered");String a=clean(body.getAnswer());if(a==null||a.length()<1||a.length()>2000)throw new RestApiException("400","Answer must be 1-2000 characters");q.setAnswer(a);q.setStatus(ProductQuestionStatus.PUBLISHED);q.setAnsweredAt(new Date());questions.update(q);return new ReadableProductQuestion(q);}
+ @PutMapping("/private/questions/{id}/reject") @ResponseStatus(HttpStatus.NO_CONTENT) public void reject(@PathVariable Long id,@ApiIgnore MerchantStore s){ProductQuestion q=questions.getById(id);if(q==null||q.getProduct().getMerchantStore().getId().intValue()!=s.getId().intValue())throw new RestApiException("404","Question not found");q.setStatus(ProductQuestionStatus.REJECTED);q.setAnsweredAt(new Date());questions.update(q);}
+}
