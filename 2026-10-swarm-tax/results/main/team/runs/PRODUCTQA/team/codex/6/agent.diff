+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.ArrayList;
+import java.util.List;
+import javax.inject.Inject;
+import javax.validation.Valid;
+import org.springframework.data.domain.PageRequest;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.*;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.product.*;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+ @Inject private ProductQuestionService questionService;
+ @Inject private ProductService productService;
+ @Inject private CustomerService customerService;
+
+ @GetMapping({"/products/{sku}/questions","/private/products/{sku}/questions"})
+ public List<ReadableProductQuestion> list(@PathVariable String sku, @ApiIgnore MerchantStore store, @RequestParam(required=false) ProductQuestionStatus status, @RequestParam(defaultValue="0") int page, @RequestParam(defaultValue="20") int count) {
+  Product p=product(sku,store); List<ProductQuestion> qs=questionService.getByProduct(p,status == null ? ProductQuestionStatus.PUBLISHED : status,PageRequest.of(Math.max(0,page),Math.min(Math.max(1,count),100))); return readable(qs);
+ }
+ @PostMapping({"/customer/products/{sku}/questions","/auth/products/{sku}/questions"}) @ResponseStatus(HttpStatus.CREATED)
+ public ReadableProductQuestion ask(@PathVariable String sku,@Valid @RequestBody PersistableProductQuestion body,@ApiIgnore MerchantStore store,Principal principal) throws Exception {
+  if(principal==null) throw new org.springframework.security.access.AccessDeniedException("Authentication required");
+  Product p=product(sku,store); Customer c=customerService.getByNick(principal.getName(),store.getCode()); if(c==null) throw new ResourceNotFoundException("Customer not found");
+  ProductQuestion q=new ProductQuestion(); q.setProduct(p);q.setMerchantStore(store);q.setCustomer(c);q.setQuestion(body.getQuestion().trim());q.setStatus(ProductQuestionStatus.PENDING);questionService.create(q);return readable(q);
+ }
+ @GetMapping({"/customer/questions","/auth/customer/questions"}) public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store,Principal principal){if(principal==null) throw new org.springframework.security.access.AccessDeniedException("Authentication required"); Customer c=customerService.getByNick(principal.getName(),store.getCode()); if(c==null) return new ArrayList<>(); return readable(questionService.getByCustomer(c,store));}
+ @PutMapping("/private/questions/{id}/answer") public ReadableProductQuestion answer(@PathVariable Long id,@RequestBody PersistableProductQuestion body,@ApiIgnore MerchantStore store){ ProductQuestion q=adminQuestion(id,store); if(q.getStatus()==ProductQuestionStatus.REJECTED) throw new org.springframework.web.server.ResponseStatusException(HttpStatus.CONFLICT,"Rejected question cannot be answered"); String a=body.getAnswer()!=null?body.getAnswer():body.getQuestion(); if(a==null || a.trim().length()<1 || a.trim().length()>2000) throw new org.springframework.web.server.ResponseStatusException(HttpStatus.BAD_REQUEST,"Answer must be 1-2000 characters"); q.setAnswer(a.trim());q.setStatus(ProductQuestionStatus.PUBLISHED);save(q);return readable(q);}
+ @PutMapping("/private/questions/{id}/reject") public ReadableProductQuestion reject(@PathVariable Long id,@ApiIgnore MerchantStore store){ ProductQuestion q=adminQuestion(id,store); q.setStatus(ProductQuestionStatus.REJECTED);save(q);return readable(q);}
+ @PatchMapping("/private/products/questions/{id}") public ReadableProductQuestion legacyAnswer(@PathVariable Long id,@RequestBody PersistableProductQuestion body,@ApiIgnore MerchantStore store){return answer(id,body,store);}
+ private ProductQuestion adminQuestion(Long id,MerchantStore store){try {ProductQuestion q=questionService.getById(id);if(q==null || q.getMerchantStore()==null || !q.getMerchantStore().getId().equals(store.getId())) throw new ResourceNotFoundException("Question not found");return q;}catch(ResourceNotFoundException e){throw e;}catch(Exception e){throw new ResourceNotFoundException("Question not found");}}
+ private void save(ProductQuestion q){try{questionService.update(q);}catch(Exception e){throw new RuntimeException(e);}}
+ private Product product(String sku,MerchantStore s){try { Product p=productService.getBySku(sku,s);if(p==null)throw new ResourceNotFoundException("Product not found");return p; } catch (ResourceNotFoundException e) { throw e; } catch (Exception e) { throw new ResourceNotFoundException("Product not found"); }}
+ private List<ReadableProductQuestion> readable(List<ProductQuestion> list){List<ReadableProductQuestion> out=new ArrayList<>();for(ProductQuestion q:list)out.add(readable(q));return out;}
+ private ReadableProductQuestion readable(ProductQuestion q){ReadableProductQuestion r=new ReadableProductQuestion();r.setId(q.getId());r.setQuestion(q.getQuestion());r.setAnswer(q.getAnswer());r.setStatus(q.getStatus());r.setCreatedAt(q.getCreatedAt());r.setUpdatedAt(q.getUpdatedAt());r.setSku(q.getProduct()==null?null:q.getProduct().getSku());r.setCustomerId(q.getCustomer()==null?null:q.getCustomer().getId());return r;}
+}
