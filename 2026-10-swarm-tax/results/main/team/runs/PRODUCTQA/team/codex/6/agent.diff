+@Service("productQuestionService")
+public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long,ProductQuestion> implements ProductQuestionService {
+ private final ProductQuestionRepository repository;
+ @Inject public ProductQuestionServiceImpl(ProductQuestionRepository repository){super(repository);this.repository=repository;}
+ public List<ProductQuestion> getByProduct(Product p, ProductQuestionStatus s, Pageable page){return s==null?repository.findByProductIdOrderByCreatedAtDesc(p.getId(),page):repository.findByProductIdAndStatusOrderByCreatedAtDesc(p.getId(),s,page);}
+ public List<ProductQuestion> getByProduct(Product p, Pageable page){return repository.findByProductIdOrderByCreatedAtDesc(p.getId(),page);}
+ public List<ProductQuestion> getByCustomer(Customer c, MerchantStore s){return repository.findByCustomerIdAndMerchantStoreIdOrderByCreatedAtDesc(c.getId(),s.getId());}
+ public List<ProductQuestion> getByStore(MerchantStore s, Pageable page){return repository.findByMerchantStoreIdOrderByCreatedAtDesc(s.getId(),page);}
+}
