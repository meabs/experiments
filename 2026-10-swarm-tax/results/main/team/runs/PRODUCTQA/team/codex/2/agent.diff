+package com.salesmanager.core.business.services.catalog.product.question;
+
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.question.*;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long, ProductQuestion> implements ProductQuestionService {
+  private final ProductQuestionRepository repository;
+  @Inject public ProductQuestionServiceImpl(ProductQuestionRepository repository){super(repository);this.repository=repository;}
+  public List<ProductQuestion> listByProduct(Long id, boolean answeredOnly){return answeredOnly ? repository.findByProductIdAndStatusOrderByCreatedAtAsc(id, ProductQuestionStatus.ANSWERED) : repository.findByProductIdOrderByCreatedAtAsc(id);}
+  public List<ProductQuestion> listByCustomer(Long customer, Long store){return repository.findByCustomerIdAndMerchantStoreIdOrderByCreatedAtDesc(customer, store);}
+  public List<ProductQuestion> listByStore(Long store){return repository.findByMerchantStoreIdOrderByCreatedAtAsc(store);}
+  public long countPending(Long customer, Long store){return repository.countByCustomerIdAndMerchantStoreIdAndStatus(customer, store, ProductQuestionStatus.PENDING);}
+}
