+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.*;
+import javax.inject.Inject;
+import javax.validation.Valid;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import org.springframework.security.core.context.SecurityContextHolder;
+import org.springframework.security.core.Authentication;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.*;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.*;
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.store.security.user.JWTUser;
+import com.salesmanager.shop.utils.AuthorizationUtils;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Product Q&A endpoints. Questions are always scoped to the current merchant store. */
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+  @Inject private ProductQuestionService questionService;
+  @Inject private ProductService productService;
+  @Inject private CustomerService customerService;
+  @Inject private AuthorizationUtils authorizationUtils;
+
+  @PostMapping("/auth/products/{id}/questions") @ResponseStatus(HttpStatus.CREATED)
+  public ReadableProductQuestion ask(@PathVariable Long id, @Valid @RequestBody ProductQuestionRequest request, @ApiIgnore MerchantStore store) throws Exception {
+    Product product = productService.findOne(id, store);
+    if (product == null) throw new IllegalArgumentException("Product does not exist");
+    Long authenticatedCustomerId = authenticatedCustomerId();
+    if (request.getCustomerId() != null && !authenticatedCustomerId.equals(request.getCustomerId())) throw new com.salesmanager.shop.store.api.exception.UnauthorizedException();
+    if (questionService.countPending(authenticatedCustomerId, store.getId().longValue()) >= 3) throw new IllegalStateException("Maximum of 3 pending questions");
+    Customer customer = customerService.getById(authenticatedCustomerId);
+    if (customer == null) throw new IllegalArgumentException("Customer does not exist");
+    ProductQuestion q = new ProductQuestion(); q.setProduct(product); q.setMerchantStore(store); q.setCustomer(customer); q.setQuestion(request.getQuestion().trim()); q.setStatus(ProductQuestionStatus.PENDING); q.setCreatedAt(new Date());
+    questionService.create(q); return read(q);
+  }
+
+  @GetMapping("/products/{id}/questions")
+  public List<ReadableProductQuestion> productQuestions(@PathVariable Long id, @ApiIgnore MerchantStore store) throws Exception {
+    Product product = productService.findOne(id, store); if (product == null) throw new IllegalArgumentException("Product does not exist");
+    List<ReadableProductQuestion> out=new ArrayList<>(); for(ProductQuestion q: questionService.listByProduct(id,true)) out.add(read(q)); return out;
+  }
+
+  @GetMapping("/auth/customers/{id}/questions")
+  public List<ReadableProductQuestion> customerQuestions(@PathVariable Long id, @ApiIgnore MerchantStore store) { if (!authenticatedCustomerId().equals(id)) throw new com.salesmanager.shop.store.api.exception.UnauthorizedException(); List<ReadableProductQuestion> out=new ArrayList<>(); for(ProductQuestion q:questionService.listByCustomer(id,store.getId().longValue())) out.add(read(q)); return out; }
+
+  @GetMapping("/private/questions")
+  public List<ReadableProductQuestion> all(@ApiIgnore MerchantStore store) { authorizeAdmin(store); List<ReadableProductQuestion> out=new ArrayList<>(); for(ProductQuestion q:questionService.listByStore(store.getId().longValue())) out.add(read(q)); return out; }
+
+  @PutMapping("/private/questions/{id}")
+  public ReadableProductQuestion moderate(@PathVariable Long id, @Valid @RequestBody ProductQuestionAnswer request, @ApiIgnore MerchantStore store) throws Exception {
+    authorizeAdmin(store); ProductQuestion q=questionService.getById(id); if(q==null || !q.getMerchantStore().getId().equals(store.getId())) throw new IllegalArgumentException("Question does not exist");
+    ProductQuestionStatus status; try { status=ProductQuestionStatus.valueOf(request.getStatus().trim().toUpperCase(Locale.ENGLISH)); } catch(Exception e){throw new IllegalArgumentException("Invalid question status");}
+    if(status==ProductQuestionStatus.ANSWERED){if(request.getAnswer()==null || request.getAnswer().trim().isEmpty()) throw new IllegalArgumentException("Answer is required"); q.setAnswer(request.getAnswer().trim()); q.setAnsweredAt(new Date());} else if(status==ProductQuestionStatus.REJECTED){q.setAnswer(null); q.setAnsweredAt(new Date());} else throw new IllegalArgumentException("Invalid question status");
+    q.setStatus(status); questionService.update(q); return read(q);
+  }
+  private ReadableProductQuestion read(ProductQuestion q){ReadableProductQuestion r=new ReadableProductQuestion();r.setId(q.getId());r.setProductId(q.getProduct().getId());r.setCustomerId(q.getCustomer().getId());r.setQuestion(q.getQuestion());r.setAnswer(q.getAnswer());r.setStatus(q.getStatus().name());r.setCreatedAt(q.getCreatedAt());r.setAnsweredAt(q.getAnsweredAt());return r;}
+  private Long authenticatedCustomerId() { Authentication a=SecurityContextHolder.getContext().getAuthentication(); if(a==null || !(a.getPrincipal() instanceof JWTUser)) throw new com.salesmanager.shop.store.api.exception.UnauthorizedException(); return ((JWTUser)a.getPrincipal()).getId(); }
+  private void authorizeAdmin(MerchantStore store) { String user=authorizationUtils.authenticatedUser(); authorizationUtils.authorizeUser(user, Arrays.asList(Constants.GROUP_SUPERADMIN, Constants.GROUP_ADMIN), store); }
+}
