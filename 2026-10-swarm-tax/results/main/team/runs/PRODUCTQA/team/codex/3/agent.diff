+ @Inject ProductQuestionService service; @Inject ProductService products; @Inject CustomerService customers;
+ @PostMapping("/auth/products/{sku}/questions") @ResponseStatus(HttpStatus.CREATED) public CustomerQuestion ask(@PathVariable String sku,@Valid @RequestBody PersistableProductQuestion dto,@ApiIgnore MerchantStore store,Authentication auth){Product p=findSku(sku,store);Long cid=principal(auth);if(cid==null)throw err(HttpStatus.UNAUTHORIZED,"Customer authentication required");Customer c=customers.getById(cid);if(c==null)throw err(HttpStatus.NOT_FOUND,"Customer does not exist");ProductQuestion q=new ProductQuestion();q.setProduct(p);q.setCustomer(c);q.setMerchantStore(p.getMerchantStore());q.setQuestion(clean(dto.getQuestion(),2000,"Question"));q.setStatus(ProductQuestionStatus.PENDING);save(q);return customer(q);}
+ @GetMapping("/product/{sku}/questions") public PublicQuestions list(@PathVariable String sku,@ApiIgnore MerchantStore store){Product p=findSku(sku,store);List<ReadableProductQuestion> a=new ArrayList<>();for(ProductQuestion q:service.getByProduct(p))if(q.getStatus()==ProductQuestionStatus.PUBLISHED)a.add(publicItem(q));return new PublicQuestions(a);}
+ @GetMapping("/auth/customer/questions") public List<CustomerQuestion> mine(Authentication auth){Long id=principal(auth);if(id==null)throw err(HttpStatus.UNAUTHORIZED,"Customer authentication required");Customer c=customers.getById(id);if(c==null)throw err(HttpStatus.NOT_FOUND,"Customer does not exist");List<CustomerQuestion> out=new ArrayList<>();for(ProductQuestion q:service.getByCustomer(c))out.add(customer(q));return out;}
+ @GetMapping("/private/questions") public List<AdminQuestion> admin(@RequestParam(defaultValue="PENDING") String status,@ApiIgnore MerchantStore store){ProductQuestionStatus s;try{s=ProductQuestionStatus.valueOf(status.toUpperCase());}catch(Exception e){throw err(HttpStatus.BAD_REQUEST,"Invalid status");}if(store==null)throw err(HttpStatus.NOT_FOUND,"Store does not exist");List<AdminQuestion> out=new ArrayList<>();for(ProductQuestion q:service.getByStoreAndStatus(store,s))out.add(admin(q));return out;}
+ @PutMapping("/private/questions/{id}/answer") public AdminQuestion answer(@PathVariable Long id,@RequestBody PersistableProductQuestion dto,@ApiIgnore MerchantStore store){ProductQuestion q=owned(id,store);if(q.getStatus()==ProductQuestionStatus.REJECTED)throw err(HttpStatus.CONFLICT,"Rejected question cannot be answered");q.setAnswer(clean(dto.getAnswer(),2000,"Answer"));q.setStatus(ProductQuestionStatus.PUBLISHED);q.setUpdatedAt(new Date());save(q);return admin(q);}
+ @PutMapping("/private/questions/{id}/reject") public AdminQuestion reject(@PathVariable Long id,@ApiIgnore MerchantStore store){ProductQuestion q=owned(id,store);if(q.getStatus()==ProductQuestionStatus.REJECTED)throw err(HttpStatus.CONFLICT,"Question already rejected");q.setStatus(ProductQuestionStatus.REJECTED);q.setUpdatedAt(new Date());save(q);return admin(q);}
+ private Product findSku(String sku,MerchantStore s){try{Product p=products.getBySku(sku,s);if(p==null)throw err(HttpStatus.NOT_FOUND,"Product does not exist");return p;}catch(Exception e){throw err(HttpStatus.NOT_FOUND,"Product does not exist");}}
+ private ProductQuestion owned(Long id,MerchantStore s){ProductQuestion q=service.getById(id);if(q==null||s==null||q.getMerchantStore()==null||!s.getId().equals(q.getMerchantStore().getId()))throw err(HttpStatus.NOT_FOUND,"Question does not exist");return q;}
+ private Long principal(Authentication a){if(a==null)return null;Object p=a.getPrincipal();if(p instanceof CustomerDetails)return ((CustomerDetails)p).getId();if(p instanceof JWTUser)return ((JWTUser)p).getId();return null;}
+ private String clean(String s,int max,String n){if(s==null||s.trim().isEmpty()||s.trim().length()>max)throw err(HttpStatus.BAD_REQUEST,n+" is invalid");return s.trim();}
+ private void save(ProductQuestion q){try{if(q.getId()==null)service.create(q);else service.update(q);}catch(Exception e){throw new RuntimeException(e);}}
+ private RuntimeException err(HttpStatus s,String m){return new org.springframework.web.server.ResponseStatusException(s,m);}
+ private CustomerQuestion customer(ProductQuestion q){CustomerQuestion d=new CustomerQuestion();d.id=q.getId();d.sku=q.getProduct().getSku();d.text=q.getQuestion();d.status=q.getStatus().name();d.answer=q.getAnswer();d.askedBy=q.getCustomer().getId();d.askedAt=q.getCreatedAt();d.answeredAt=q.getStatus()==ProductQuestionStatus.PUBLISHED?q.getUpdatedAt():null;return d;}
+ private AdminQuestion admin(ProductQuestion q){AdminQuestion d=new AdminQuestion();CustomerQuestion c=customer(q);d.id=c.id;d.sku=c.sku;d.text=c.text;d.status=c.status;d.answer=c.answer;d.askedBy=c.askedBy;d.askedAt=c.askedAt;d.answeredAt=c.answeredAt;return d;}
