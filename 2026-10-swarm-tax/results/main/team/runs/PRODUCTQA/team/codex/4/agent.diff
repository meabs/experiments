+package com.salesmanager.shop.store.api.v1.product;
+import java.security.Principal; import java.util.*; import javax.inject.Inject; import javax.servlet.http.HttpServletRequest; import javax.validation.Valid;
+import org.springframework.http.HttpStatus; import org.springframework.web.bind.annotation.*; import springfox.documentation.annotations.ApiIgnore;
+import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.catalog.product.question.*; import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.question.*; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.catalog.product.*;
+import com.salesmanager.shop.store.api.exception.*;
+@RestController @RequestMapping("/api/v1") public class ProductQuestionApi {
+ @Inject private ProductQuestionService service; @Inject private ProductService products; @Inject private CustomerService customers;
+ private ReadableProductQuestion read(ProductQuestion q){ReadableProductQuestion r=new ReadableProductQuestion();r.setId(q.getId());r.setSku(q.getProduct().getSku());r.setText(q.getText());r.setAnswer(q.getAnswer());r.setStatus(q.getStatus().name());r.setAskedAt(q.getAskedAt());r.setAnsweredAt(q.getAnsweredAt()); if(q.getCustomer()!=null&&q.getCustomer().getBilling()!=null)r.setAskedBy(q.getCustomer().getBilling().getFirstName()); return r;}
+ private Customer customer(HttpServletRequest req,MerchantStore store){Principal p=req.getUserPrincipal();if(p==null)throw new UnauthorizedException();Customer c=customers.getByNick(p.getName(),store.getId());if(c==null)throw new UnauthorizedException();return c;}
+ private Product product(String sku,MerchantStore store) throws Exception {Product p=products.getBySku(sku,store);if(p==null)throw new ResourceNotFoundException("product not found");return p;}
+ @PostMapping("/auth/products/{sku}/questions") @ResponseStatus(HttpStatus.CREATED) public ReadableProductQuestion ask(@PathVariable String sku,@Valid @RequestBody PersistableProductQuestion body,@ApiIgnore MerchantStore store,HttpServletRequest req) throws Exception {ProductQuestion q=new ProductQuestion();q.setProduct(product(sku,store));q.setMerchantStore(store);q.setCustomer(customer(req,store));q.setText(body.getText());try{return read(service.ask(q));}catch(IllegalStateException|IllegalArgumentException e){throw new BadRequestException(e.getMessage());}}
+ @GetMapping("/auth/customer/questions") public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store,HttpServletRequest req){List<ReadableProductQuestion> out=new ArrayList<>();for(ProductQuestion q:service.getByCustomer(customer(req,store),store))out.add(read(q));return out;}
+ @GetMapping("/products/{sku}/questions") public Map<String,Object> published(@PathVariable String sku,@ApiIgnore MerchantStore store) throws Exception {Product p=product(sku,store);List<ReadableProductQuestion> items=new ArrayList<>();for(ProductQuestion q:service.getPublishedByProduct(p.getId()))items.add(read(q));Map<String,Object> out=new LinkedHashMap<>();out.put("count",(long)items.size());out.put("items",items);return out;}
+ @GetMapping("/private/questions") public List<ReadableProductQuestion> pending(@ApiIgnore MerchantStore store){List<ReadableProductQuestion> out=new ArrayList<>();for(ProductQuestion q:service.getPendingByStore(store))out.add(read(q));return out;}
+ @PutMapping("/private/questions/{id}") public ReadableProductQuestion moderate(@PathVariable Long id,@Valid @RequestBody ModerateProductQuestion body,@ApiIgnore MerchantStore store){ProductQuestionStatus s;try{s=ProductQuestionStatus.valueOf(body.getStatus().trim().toUpperCase());}catch(Exception e){throw new BadRequestException("status must be PUBLISHED or REJECTED");}try{return read(service.answer(id,body.getAnswer(),s,store));}catch(NoSuchElementException e){throw new ResourceNotFoundException("question not found");}catch(SecurityException e){throw new ForbiddenException(e.getMessage());}catch(IllegalArgumentException|IllegalStateException e){throw new BadRequestException(e.getMessage());}}
+}
