+package com.salesmanager.core.business.services.catalog.product.question;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.question.*;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long,ProductQuestion> implements ProductQuestionService {
+ private final ProductQuestionRepository repo;
+ @Inject public ProductQuestionServiceImpl(ProductQuestionRepository repo){super(repo);this.repo=repo;}
+ private String clean(String s,int min,int max,String field){if(s==null) throw new IllegalArgumentException(field+" is required"); s=s.trim(); if(s.length()<min||s.length()>max) throw new IllegalArgumentException(field+" length must be between "+min+" and "+max); return s;}
+ public ProductQuestion ask(ProductQuestion q){ if(q==null||q.getCustomer()==null||q.getProduct()==null||q.getMerchantStore()==null) throw new IllegalArgumentException("question ownership is required"); if(repo.countByCustomerIdAndStatus(q.getCustomer().getId(),ProductQuestionStatus.PENDING)>=3) throw new IllegalStateException("maximum pending questions reached"); q.setText(clean(q.getText(),10,500,"text")); q.setAnswer(null); q.setStatus(ProductQuestionStatus.PENDING); q.setAskedAt(new Date()); return repo.save(q); }
+ public ProductQuestion answer(Long id,String answer,ProductQuestionStatus status,MerchantStore store){ProductQuestion q=repo.findById(id).orElse(null);if(q==null) throw new NoSuchElementException("question not found");if(store!=null&&q.getMerchantStore()!=null&&!store.getId().equals(q.getMerchantStore().getId())) throw new SecurityException("question belongs to another store");if(q.getStatus()!=ProductQuestionStatus.PENDING) throw new IllegalStateException("only pending questions can be moderated");if(status==null) status=ProductQuestionStatus.PUBLISHED;if(status==ProductQuestionStatus.PUBLISHED){q.setAnswer(clean(answer,1,2000,"answer"));} else if(status==ProductQuestionStatus.REJECTED){if(answer!=null&&!answer.trim().isEmpty()) throw new IllegalArgumentException("rejected questions cannot have an answer");q.setAnswer(null);} else throw new IllegalArgumentException("invalid status transition");q.setStatus(status);q.setAnsweredAt(new Date());return repo.save(q);}
+ public List<ProductQuestion> getByCustomer(Customer c){return repo.findByCustomerIdOrderByAskedAtDesc(c.getId());}
+ public List<ProductQuestion> getByCustomer(Customer c, MerchantStore s){return repo.findByCustomerIdAndMerchantStoreIdOrderByAskedAtDesc(c.getId(),s.getId());}
+ public void deleteByProductId(Long id){repo.deleteByProductId(id);}
+ public List<ProductQuestion> getPublishedByProduct(Long id){return repo.findByProductIdAndStatusOrderByAskedAtDesc(id,ProductQuestionStatus.PUBLISHED);}
+ public List<ProductQuestion> getPendingByStore(MerchantStore s){return repo.findByMerchantStoreIdAndStatusOrderByAskedAtAsc(s.getId(),ProductQuestionStatus.PENDING);}
+ public long countPending(Customer c){return repo.countByCustomerIdAndStatus(c.getId(),ProductQuestionStatus.PENDING);} public long countPublished(Long id){return repo.countByProductAndStatus(id,ProductQuestionStatus.PUBLISHED);}
+}
