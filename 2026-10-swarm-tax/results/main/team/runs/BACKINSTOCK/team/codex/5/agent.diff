+import springfox.documentation.annotations.ApiIgnore;
+@RestController
+@RequestMapping("/api/v1")
+public class StockAlertApi {
+ @org.springframework.beans.factory.annotation.Autowired private StockAlertService service;
+ public static class Request { @NotBlank @Email private String email; public String getEmail(){return email;} public void setEmail(String e){email=e;} }
+ @PostMapping("/products/{sku}/alerts") @ResponseStatus(HttpStatus.CREATED)
+ public AlertResponse subscribe(@PathVariable String sku,@Valid @RequestBody Request request,@ApiIgnore MerchantStore store){return new AlertResponse(service.subscribe(sku,request.email,store));}
+ @DeleteMapping("/products/{sku}/alerts") @ResponseStatus(HttpStatus.NO_CONTENT)
+ public void cancel(@PathVariable String sku,@Valid @RequestBody Request request,@ApiIgnore MerchantStore store){if(!service.cancel(sku,request.email,store)) throw new org.springframework.web.server.ResponseStatusException(HttpStatus.NOT_FOUND,"Alert not found");}
+ public static class AlertResponse { public Long id; public String sku,email,status,subject; public java.util.Date createdAt,sentAt; AlertResponse(StockAlert a){id=a.getId();sku=a.getSku();email=a.getEmail();status=a.getStatus();subject=a.getSubject();createdAt=a.getCreatedAt();sentAt=a.getSentAt();} }
+ public static class OutboxResponse { public Long id; public String sku,email,subject,message; public java.util.Date createdAt; OutboxResponse(StockAlertOutbox o){id=o.getId();sku=o.getSku();email=o.getEmail();subject=o.getSubject();message=o.getMessage();createdAt=o.getCreatedAt();} }
+ @GetMapping("/private/stock-alerts") public List<AlertResponse> pending(@ApiIgnore MerchantStore store){List<AlertResponse> r=new java.util.ArrayList<>();for(StockAlert a:service.pending(store))r.add(new AlertResponse(a));return r;}
+ @GetMapping("/private/stock-alerts/outbox") public List<OutboxResponse> outbox(@ApiIgnore MerchantStore store){List<OutboxResponse> r=new java.util.ArrayList<>();for(StockAlertOutbox o:service.outbox(store))r.add(new OutboxResponse(o));return r;}
+}
