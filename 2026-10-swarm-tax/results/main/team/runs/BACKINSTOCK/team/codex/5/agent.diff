+package com.salesmanager.core.business.services.catalog.product.alert;
+import java.util.*;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.beans.factory.annotation.Autowired;
+import com.salesmanager.core.business.repositories.catalog.product.alert.*;
+import com.salesmanager.core.model.catalog.product.alert.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+ @Autowired private StockAlertRepository alerts; @Autowired private StockAlertOutboxRepository outbox;
+ private int id(MerchantStore s){return s.getId().intValue();}
+ @Transactional public StockAlert subscribe(String sku,String email,MerchantStore store){
+  Optional<StockAlert> old=alerts.findFirstByMerchantStoreIdAndSkuIgnoreCaseAndEmailIgnoreCaseAndStatus(id(store),sku,email,"PENDING"); if(old.isPresent()) return old.get();
+  StockAlert a=new StockAlert(); a.setMerchantStore(store); a.setSku(sku); a.setEmail(email); return alerts.save(a);
+ }
+ @Transactional public boolean cancel(String sku,String email,MerchantStore store){ Optional<StockAlert> a=alerts.findFirstByMerchantStoreIdAndSkuIgnoreCaseAndEmailIgnoreCaseAndStatus(id(store),sku,email,"PENDING"); if(!a.isPresent()) return false; a.get().setStatus("CANCELLED"); alerts.save(a.get()); return true; }
+ public List<StockAlert> pending(String sku,MerchantStore store){return alerts.findByMerchantStoreIdAndSkuIgnoreCaseAndStatusOrderByCreatedAtAsc(id(store),sku,"PENDING");}
+ public List<StockAlert> pending(MerchantStore store){return alerts.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(id(store),"PENDING");}
+ public List<StockAlertOutbox> outbox(MerchantStore store){return outbox.findByMerchantStoreIdOrderByCreatedAtAsc(id(store));}
+ @Transactional public void dispatch(String sku,String productName,MerchantStore store){ for(StockAlert a: pending(sku,store)){ String subject="Back in stock: "+productName; a.setStatus("SENT"); a.setSubject(subject); a.setSentAt(new Date()); alerts.save(a); StockAlertOutbox o=new StockAlertOutbox(); o.setMerchantStore(store);o.setSku(a.getSku());o.setEmail(a.getEmail());o.setSubject(subject);o.setMessage("Product "+productName+" is back in stock.");outbox.save(o); } }
+ @Transactional public void remove(String sku,MerchantStore store){alerts.deleteByMerchantStoreIdAndSkuIgnoreCase(id(store),sku);}
+}
