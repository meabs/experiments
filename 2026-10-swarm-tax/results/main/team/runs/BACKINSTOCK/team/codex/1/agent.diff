+package com.salesmanager.core.business.services.catalog.product.alert;
+import java.util.*;
+import javax.inject.Inject;
+import org.apache.commons.lang3.Validate;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.catalog.product.alert.*;
+import com.salesmanager.core.model.catalog.product.alert.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+ @Inject StockAlertRepository alerts; @Inject StockAlertOutboxRepository outbox;
+ private String norm(String s){return s==null?null:s.trim().toLowerCase(Locale.ROOT);}
+ @Transactional public StockAlert subscribe(String sku,String email,MerchantStore store){
+  Validate.notBlank(sku,"SKU is required"); Validate.notBlank(email,"Email is required"); Validate.notNull(store,"MerchantStore is required");
+  String e=norm(email), k=norm(sku); Optional<StockAlert> existing=alerts.findByMerchantStoreIdAndSkuIgnoreCaseAndEmailIgnoreCaseAndStatus(store.getId(),k,e,StockAlertStatus.PENDING);
+  if(existing.isPresent()) return existing.get();
+  StockAlert a=new StockAlert(); a.setSku(k); a.setEmail(e); a.setMerchantStore(store); a.setStatus(StockAlertStatus.PENDING); return alerts.save(a);
+ }
+ @Transactional public void cancel(String sku,String email,MerchantStore store){ alerts.findByMerchantStoreIdAndSkuIgnoreCaseAndEmailIgnoreCaseAndStatus(store.getId(),norm(sku),norm(email),StockAlertStatus.PENDING).ifPresent(a->{outbox.deleteByAlertId(a.getId()); a.setStatus(StockAlertStatus.CANCELLED); alerts.save(a);}); }
+ @Transactional public synchronized void enqueue(String sku,MerchantStore store){
+  for(StockAlert a: alerts.findByMerchantStoreIdAndSkuIgnoreCaseAndStatus(store.getId(),norm(sku),StockAlertStatus.PENDING)) if(!outbox.existsByAlertIdAndStatus(a.getId(),StockAlertStatus.PENDING)){ StockAlertOutbox o=new StockAlertOutbox(); o.setAlert(a);o.setSku(a.getSku());o.setEmail(a.getEmail());o.setMerchantStore(store);o.setStatus(StockAlertStatus.PENDING);outbox.save(o); }
+ }
+ public List<StockAlert> list(MerchantStore s){return alerts.findByMerchantStoreId(s.getId());}
+ public List<StockAlertOutbox> outbox(MerchantStore s){return outbox.findByMerchantStoreIdAndStatus(s.getId(),StockAlertStatus.PENDING);}
+ @Transactional public void deleteForProduct(String sku,MerchantStore store){for(StockAlert a: alerts.findByMerchantStoreIdAndSkuIgnoreCase(store.getId(),norm(sku))){outbox.deleteByAlertId(a.getId()); alerts.delete(a);}}
+}
