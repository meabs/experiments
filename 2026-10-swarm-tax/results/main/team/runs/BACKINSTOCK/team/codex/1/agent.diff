+@RestController @RequestMapping("/api/v1")
+public class StockAlertApi {
+ @Inject private StockAlertService service;
+ private ReadableStockAlert read(StockAlert a){ReadableStockAlert r=new ReadableStockAlert();r.setId(a.getId());r.setSku(a.getSku());r.setEmail(a.getEmail());r.setStatus(a.getStatus().name());return r;}
+ @PostMapping("/products/{sku}/alerts") @ResponseStatus(HttpStatus.CREATED) public ReadableStockAlert subscribe(@PathVariable String sku,@Valid @RequestBody PersistableStockAlert body,@ApiIgnore MerchantStore store){return read(service.subscribe(sku,body.getEmail(),store));}
+ @DeleteMapping("/products/{sku}/alerts") @ResponseStatus(HttpStatus.NO_CONTENT) public void cancel(@PathVariable String sku,@RequestParam String email,@ApiIgnore MerchantStore store){service.cancel(sku,email,store);}
+ @GetMapping("/private/stock-alerts") public List<ReadableStockAlert> alerts(@ApiIgnore MerchantStore store){List<ReadableStockAlert> r=new ArrayList<>();for(StockAlert a:service.list(store))r.add(read(a));return r;}
+ @GetMapping("/private/stock-alerts/outbox") public List<ReadableStockAlert> outbox(@ApiIgnore MerchantStore store){List<ReadableStockAlert> r=new ArrayList<>();for(StockAlertOutbox o:service.outbox(store)){ReadableStockAlert x=new ReadableStockAlert();x.setId(o.getId());x.setSku(o.getSku());x.setEmail(o.getEmail());x.setStatus(o.getStatus().name());r.add(x);}return r;}
+}
