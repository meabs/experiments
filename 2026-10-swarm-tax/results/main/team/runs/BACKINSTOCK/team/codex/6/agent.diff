+import java.util.*; import com.salesmanager.core.model.catalog.product.*; import com.salesmanager.core.model.merchant.MerchantStore;
+public interface StockAlertService { StockAlert subscribe(String sku,String email,MerchantStore store); void unsubscribe(String sku,String email,MerchantStore store); List<StockAlert> list(MerchantStore store); List<StockAlertOutbox> outbox(MerchantStore store); void inventoryRestocked(String sku,MerchantStore store); }
