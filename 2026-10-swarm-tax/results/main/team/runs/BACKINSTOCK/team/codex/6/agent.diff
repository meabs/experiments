+package com.salesmanager.core.business.services.catalog.product;
+import java.util.*; import java.util.regex.Pattern; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional; import org.springframework.beans.factory.annotation.Autowired; import com.salesmanager.core.business.repositories.catalog.product.*; import com.salesmanager.core.model.catalog.product.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("stockAlertService") public class StockAlertServiceImpl implements StockAlertService {
+ private static final Pattern EMAIL=Pattern.compile("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"); @Autowired StockAlertRepository alerts; @Autowired StockAlertOutboxRepository outbox; @Autowired ProductService products;
+ private void valid(String sku,String email,MerchantStore s){if(s==null||sku==null||sku.trim().isEmpty()||email==null||!EMAIL.matcher(email).matches()) throw new IllegalArgumentException("Valid store, sku and email are required");}
+ @Transactional public StockAlert subscribe(String sku,String email,MerchantStore store){valid(sku,email,store); try { com.salesmanager.core.model.catalog.product.Product p=products.getBySku(sku,store); if(p==null) throw new NoSuchElementException(); boolean stock=p.getAvailabilities()!=null && p.getAvailabilities().stream().anyMatch(a->a.getProductQuantity()!=null&&a.getProductQuantity()>0); if(stock) throw new IllegalStateException("Product is already in stock"); StockAlert a=alerts.findByMerchantStoreCodeAndSkuAndEmail(store.getCode(),sku,email.toLowerCase()).orElseGet(()->{StockAlert n=new StockAlert();n.setMerchantStore(store);n.setProduct(p);n.setSku(sku);n.setEmail(email.toLowerCase());return n;}); a.setStatus("PENDING"); return alerts.save(a); } catch(com.salesmanager.core.business.exception.ServiceException e){throw new NoSuchElementException();} }
+ @Transactional public void unsubscribe(String sku,String email,MerchantStore store){valid(sku,email,store); StockAlert a=alerts.findByMerchantStoreCodeAndSkuAndEmail(store.getCode(),sku,email.toLowerCase()).orElseThrow(NoSuchElementException::new); if(!"PENDING".equals(a.getStatus())) throw new NoSuchElementException(); alerts.delete(a);}
+ public List<StockAlert> list(MerchantStore s){return alerts.findByMerchantStoreCodeAndStatusOrderByCreatedAtAsc(s.getCode(), "PENDING");}
+ public List<StockAlertOutbox> outbox(MerchantStore s){return outbox.findByMerchantStoreCodeAndStatusOrderByCreatedAtAsc(s.getCode(),"PENDING");}
+ @Transactional public void inventoryRestocked(String sku,MerchantStore store){for(StockAlert a:alerts.findByMerchantStoreCodeAndSkuAndStatus(store.getCode(),sku,"PENDING")){StockAlertOutbox o=new StockAlertOutbox();o.setMerchantStore(store);o.setSku(sku);o.setEmail(a.getEmail());o.setSubject((a.getProduct()!=null&&a.getProduct().getProductDescription()!=null?a.getProduct().getProductDescription().getName():sku)+" is back in stock");outbox.save(o);a.setStatus("SENT");alerts.save(a);}}
+}
