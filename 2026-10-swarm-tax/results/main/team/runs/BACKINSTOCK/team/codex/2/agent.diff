+package com.salesmanager.shop.store.api.v1.product;
+import javax.inject.Inject; import javax.validation.Valid; import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import java.util.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.catalog.product.alert.*; import com.salesmanager.core.business.services.merchant.MerchantStoreService; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.alert.*; import com.salesmanager.core.model.catalog.product.availability.ProductAvailability; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.catalog.product.alert.*; import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+@RestController @RequestMapping("/api/v1") public class StockAlertApi {
+ @Inject ProductService products; @Inject MerchantStoreService stores; @Inject StockAlertService service;
+ @PostMapping("/products/{sku}/alerts") public ResponseEntity<ReadableStockAlert> subscribe(@PathVariable String sku,@RequestParam(defaultValue="DEFAULT") String store,@Valid @RequestBody PersistableStockAlert request){ try { MerchantStore ms=stores.getByCode(store); Product p=products.getBySku(sku,ms); boolean zero=true; for(ProductAvailability a:p.getAvailabilities()) if(a.getMerchantStore()!=null&&a.getMerchantStore().getId().equals(ms.getId())&&a.getProductQuantity()!=null&&a.getProductQuantity()>0) zero=false; if(!zero)return ResponseEntity.status(HttpStatus.CONFLICT).build(); String email=request.getEmail().toLowerCase(Locale.ROOT); StockAlert existing=null; for(StockAlert x:service.list(ms,StockAlertStatus.PENDING)) if(x.getProduct().getId().equals(p.getId())&&x.getEmail().equalsIgnoreCase(email)){existing=x;break;} StockAlert a=existing==null?service.subscribe(p,ms,email):existing; return ResponseEntity.status(existing==null?HttpStatus.CREATED:HttpStatus.OK).body(read(a)); } catch(Exception e){throw new ResourceNotFoundException("Product or store not found");} }
+ @DeleteMapping("/products/{sku}/alerts") public ResponseEntity<Void> cancel(@PathVariable String sku,@RequestParam(defaultValue="DEFAULT") String store,@RequestParam String email){try{MerchantStore ms=stores.getByCode(store);Product p=products.getBySku(sku,ms);if(!service.cancel(p,ms,email))return ResponseEntity.notFound().build();return ResponseEntity.ok().build();}catch(Exception e){return ResponseEntity.notFound().build();}}
+ @GetMapping("/private/stock-alerts") public List<ReadableStockAlert> list(@RequestParam(defaultValue="PENDING") String status,@RequestParam(required=false) String store){StockAlertStatus st;try{st=StockAlertStatus.valueOf(status.toUpperCase(Locale.ROOT));}catch(Exception e){throw new IllegalArgumentException("Invalid status");}MerchantStore ms=null;try{if(store!=null)ms=stores.getByCode(store);}catch(Exception e){throw new ResourceNotFoundException("Store not found");}List<ReadableStockAlert> out=new ArrayList<>();for(StockAlert a:service.list(ms,st))out.add(read(a));return out;}
+ @GetMapping("/private/stock-alerts/outbox") public List<ReadableStockAlert> outbox(@RequestParam(required=false) String store){MerchantStore ms=null;try{if(store!=null)ms=stores.getByCode(store);}catch(Exception e){throw new ResourceNotFoundException("Store not found");}List<ReadableStockAlert> out=new ArrayList<>();for(StockAlertOutbox o:service.outbox(ms)){ReadableStockAlert r=new ReadableStockAlert();r.setId(o.getId());r.setEmail(o.getEmail());r.setSku(o.getSku());r.setStore(o.getStore());r.setSubject(o.getSubject());r.setCreatedAt(o.getCreatedAt());out.add(r);}return out;}
+ private ReadableStockAlert read(StockAlert a){ReadableStockAlert r=new ReadableStockAlert();r.setId(a.getId());r.setEmail(a.getEmail());r.setStatus(a.getStatus().name());r.setCreatedAt(a.getCreatedAt());r.setSentAt(a.getSentAt());r.setSku(a.getProduct().getSku());r.setStore(a.getMerchantStore().getCode());return r;}
+}
