+package com.salesmanager.core.business.services.catalog.product.alert;
+import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.catalog.product.alert.*; import com.salesmanager.core.model.catalog.product.*; import com.salesmanager.core.model.catalog.product.alert.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("stockAlertService") public class StockAlertServiceImpl implements StockAlertService {
+ @Inject StockAlertRepository alerts; @Inject StockAlertOutboxRepository outbox;
+ @Transactional public StockAlert subscribe(Product p, MerchantStore s, String email){ Optional<StockAlert> old=alerts.findFirstByProductIdAndMerchantStoreIdAndEmailIgnoreCaseAndStatus(p.getId(),s.getId(),email,StockAlertStatus.PENDING); if(old.isPresent()) return old.get(); StockAlert a=new StockAlert(); a.setProduct(p); a.setMerchantStore(s); a.setEmail(email); a.setStatus(StockAlertStatus.PENDING); return alerts.save(a); }
+ @Transactional public boolean cancel(Product p, MerchantStore s, String email){ Optional<StockAlert> a=alerts.findFirstByProductIdAndMerchantStoreIdAndEmailIgnoreCaseAndStatus(p.getId(),s.getId(),email,StockAlertStatus.PENDING); if(!a.isPresent()) return false; a.get().setStatus(StockAlertStatus.CANCELLED); alerts.save(a.get()); return true; }
+ public List<StockAlert> list(MerchantStore s, StockAlertStatus st){ return s==null?alerts.findByStatusOrderByCreatedAtAsc(st):alerts.findByStatusAndMerchantStoreCodeOrderByCreatedAtAsc(st,s.getCode()); }
+ public List<StockAlertOutbox> outbox(){return outbox.findAll();} public List<StockAlertOutbox> outbox(MerchantStore s){return s==null?outbox():outbox.findByStoreOrderByCreatedAtAsc(s.getCode());}
+ @Transactional public void inventoryChanged(Product p, MerchantStore s,int before,int after){ if(before>0||after<=0)return; for(StockAlert a:alerts.findByProductIdAndMerchantStoreIdAndStatus(p.getId(),s.getId(),StockAlertStatus.PENDING)){a.setStatus(StockAlertStatus.SENT);a.setSentAt(new Date());alerts.save(a); StockAlertOutbox o=new StockAlertOutbox();o.setAlertId(a.getId());o.setProduct(p);o.setEmail(a.getEmail());o.setSku(p.getSku());o.setStore(s.getCode());String name=p.getSku();if(p.getDescriptions()!=null&&!p.getDescriptions().isEmpty())name=p.getDescriptions().iterator().next().getName();o.setSubject("Back in stock: "+name);outbox.save(o);} }
+}
