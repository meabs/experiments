+package com.salesmanager.core.business.services.alert;
+import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional; import org.apache.commons.lang3.Validate; import com.salesmanager.core.business.repositories.alert.*; import com.salesmanager.core.model.alert.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("stockAlertService") public class StockAlertServiceImpl implements StockAlertService {
+ @Inject private StockAlertRepository alerts; @Inject private StockAlertOutboxRepository outbox;
+ @Transactional public StockAlert subscribe(String sku,String email,MerchantStore store){Validate.notBlank(sku,"SKU cannot be blank"); Validate.notBlank(email,"Email cannot be blank"); Optional<StockAlert> old=alerts.findByMerchantStoreIdAndSkuIgnoreCaseAndEmailIgnoreCase(store.getId(),sku,email); if(old.isPresent()){old.get().setStatus("ACTIVE"); return alerts.save(old.get());} StockAlert a=new StockAlert();a.setMerchantStore(store);a.setSku(sku);a.setEmail(email.trim().toLowerCase());return alerts.save(a);}
+ @Transactional public void cancel(String sku,String email,MerchantStore store){alerts.deleteByMerchantStoreIdAndSkuIgnoreCaseAndEmailIgnoreCase(store.getId(),sku,email);}
+ public List<StockAlert> list(String sku,MerchantStore store){return alerts.findByMerchantStoreIdAndSkuIgnoreCaseAndStatus(store.getId(),sku,"ACTIVE");}
+ public List<StockAlertOutbox> outbox(MerchantStore store){return outbox.findByMerchantStoreIdAndStatus(store.getId(),"PENDING");}
+ @Transactional public void stockTransition(String sku,MerchantStore store){for(StockAlert a:list(sku,store)){StockAlertOutbox o=new StockAlertOutbox();o.setMerchantStore(store);o.setSku(a.getSku());o.setEmail(a.getEmail());outbox.save(o);a.setStatus("NOTIFIED");alerts.save(a);}}
+ @Transactional public void deleteForProduct(String sku,MerchantStore store){alerts.deleteByMerchantStoreIdAndSkuIgnoreCase(store.getId(),sku);outbox.deleteByMerchantStoreIdAndSkuIgnoreCase(store.getId(),sku);}
+ @Transactional public void deleteForStore(MerchantStore store){alerts.deleteByMerchantStoreId(store.getId());outbox.deleteByMerchantStoreId(store.getId());}
+}
