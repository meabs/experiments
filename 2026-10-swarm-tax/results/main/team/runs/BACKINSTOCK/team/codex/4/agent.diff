+package com.salesmanager.shop.store.api.v1.product;
+import java.util.*; import javax.validation.Valid; import org.springframework.beans.factory.annotation.Autowired; import org.springframework.http.HttpStatus; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.business.services.alert.StockAlertService; import com.salesmanager.core.model.alert.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.alert.*; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class StockAlertApi {
+ @Autowired private StockAlertService service;
+ @ResponseStatus(HttpStatus.CREATED) @PostMapping("/products/{sku}/alerts") public ReadableStockAlert subscribe(@PathVariable String sku,@Valid @RequestBody PersistableStockAlert request,@ApiIgnore MerchantStore store){return readable(service.subscribe(sku,request.getEmail(),store));}
+ @ResponseStatus(HttpStatus.NO_CONTENT) @DeleteMapping("/products/{sku}/alerts") public void cancel(@PathVariable String sku,@RequestParam String email,@ApiIgnore MerchantStore store){service.cancel(sku,email,store);}
+ @GetMapping("/private/stock-alerts") public List<ReadableStockAlert> alerts(@RequestParam(required=false) String sku,@ApiIgnore MerchantStore store){List<ReadableStockAlert> r=new ArrayList<>(); if(sku!=null) for(StockAlert a:service.list(sku,store)) r.add(readable(a)); return r;}
+ @GetMapping("/private/stock-alerts/outbox") public List<ReadableStockAlertOutbox> outbox(@ApiIgnore MerchantStore store){List<ReadableStockAlertOutbox> r=new ArrayList<>(); for(StockAlertOutbox a:service.outbox(store)){ReadableStockAlertOutbox x=new ReadableStockAlertOutbox();x.setId(a.getId());x.setSku(a.getSku());x.setEmail(a.getEmail());x.setStatus(a.getStatus());r.add(x);} return r;}
+ private ReadableStockAlert readable(StockAlert a){ReadableStockAlert r=new ReadableStockAlert();r.setId(a.getId());r.setSku(a.getSku());r.setEmail(a.getEmail());r.setStatus(a.getStatus());return r;}
+}
