+package com.salesmanager.core.business.services.discount;
+import java.math.*; import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.discount.DiscountCodeRepository; import com.salesmanager.core.model.discount.DiscountCode; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("discountCodeService") public class DiscountCodeServiceImpl implements DiscountCodeService {
+ @Inject private DiscountCodeRepository repo;
+ private void validate(DiscountCode c){ if(c.getCode()==null||c.getCode().trim().isEmpty()) throw new IllegalArgumentException("code required"); c.setCode(c.getCode().trim()); if(!"PERCENT".equalsIgnoreCase(c.getType())&&!"AMOUNT".equalsIgnoreCase(c.getType())) throw new IllegalArgumentException("invalid type"); if(c.getValue()==null||c.getValue().compareTo(BigDecimal.ZERO)<0||("PERCENT".equalsIgnoreCase(c.getType())&&c.getValue().compareTo(new BigDecimal("100"))>0)) throw new IllegalArgumentException("invalid value"); if(c.getStartDate()!=null&&c.getEndDate()!=null&&c.getEndDate().before(c.getStartDate())) throw new IllegalArgumentException("invalid dates"); }
+ public DiscountCode create(DiscountCode c,MerchantStore s){c.setMerchantStore(s);validate(c);if(repo.findByMerchantStoreIdAndCodeIgnoreCase(s.getId(),c.getCode()).isPresent())throw new IllegalStateException("duplicate code");return repo.save(c);}
+ public DiscountCode save(DiscountCode c,MerchantStore s){c.setMerchantStore(s);validate(c);Optional<DiscountCode> x=repo.findByMerchantStoreIdAndCodeIgnoreCase(s.getId(),c.getCode());if(x.isPresent()&&!x.get().getId().equals(c.getId()))throw new IllegalStateException("duplicate code");return repo.save(c);}
+ public void delete(Long id,MerchantStore s){DiscountCode c=get(id,s);if(c!=null)repo.delete(c);}
+ public DiscountCode get(Long id,MerchantStore s){DiscountCode c=repo.findById(id).orElse(null);return c!=null&&c.getMerchantStore().getId().equals(s.getId())?c:null;}
+ public DiscountCode find(String code,MerchantStore s){return code==null?null:repo.findByMerchantStoreIdAndCodeIgnoreCase(s.getId(),code.trim()).orElse(null);}
+ public List<DiscountCode> list(MerchantStore s){return repo.findByMerchantStoreId(s.getId());}
+ public boolean eligible(DiscountCode c,BigDecimal subtotal,Collection<String> cats,Date now){if(c==null||!c.isActive()||now==null)return false;if(c.getStartDate()!=null&&now.before(c.getStartDate())||c.getEndDate()!=null&&!now.before(c.getEndDate()))return false;if(c.getMinimumOrderAmount()!=null&&subtotal.compareTo(c.getMinimumOrderAmount())<0)return false;if(c.getCategories()!=null&&!c.getCategories().trim().isEmpty()){Set<String> allowed=new HashSet<>();for(String x:c.getCategories().split(","))allowed.add(x.trim().toLowerCase());boolean hit=false;for(String x:cats)if(allowed.contains(x.toLowerCase())){hit=true;break;}if(!hit)return false;}return true;}
+ public BigDecimal calculate(DiscountCode c,BigDecimal subtotal){if(c==null||subtotal==null)return BigDecimal.ZERO;BigDecimal d="PERCENT".equalsIgnoreCase(c.getType())?subtotal.multiply(c.getValue()).divide(new BigDecimal("100"),2,RoundingMode.HALF_UP):c.getValue();return d.max(BigDecimal.ZERO).min(subtotal).setScale(2,RoundingMode.HALF_UP);}
+}
