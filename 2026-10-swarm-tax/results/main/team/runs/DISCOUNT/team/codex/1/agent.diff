+package com.salesmanager.shop.store.api.v1.privatearea;
+
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.http.*;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.discount.DiscountCodeService;
+import com.salesmanager.core.model.discount.DiscountCode;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Merchant administration endpoints for store promotions. */
+@RestController
+@RequestMapping("/api/v1/private/discounts")
+public class DiscountCodeApi {
+ @Inject private DiscountCodeService service;
+ @GetMapping public List<DiscountCode> list(@ApiIgnore MerchantStore store){return service.list(store);}
+ @GetMapping("/{id}") public ResponseEntity<DiscountCode> get(@PathVariable Long id,@ApiIgnore MerchantStore store){DiscountCode c=service.get(id,store);return c==null?ResponseEntity.notFound().build():ResponseEntity.ok(c);}
+ @PostMapping @ResponseStatus(HttpStatus.CREATED) public DiscountCode create(@RequestBody DiscountCode c,@ApiIgnore MerchantStore store){try{return service.create(c,store);}catch(IllegalStateException e){throw new ConflictException(e.getMessage());}catch(IllegalArgumentException e){throw new BadRequestException(e.getMessage());}}
+ @PutMapping("/{id}") public DiscountCode update(@PathVariable Long id,@RequestBody DiscountCode c,@ApiIgnore MerchantStore store){c.setId(id);try{return service.save(c,store);}catch(IllegalStateException e){throw new ConflictException(e.getMessage());}catch(IllegalArgumentException e){throw new BadRequestException(e.getMessage());}}
+ @DeleteMapping("/{id}") @ResponseStatus(HttpStatus.NO_CONTENT) public void delete(@PathVariable Long id,@ApiIgnore MerchantStore store){service.delete(id,store);}
+}
+@ResponseStatus(HttpStatus.CONFLICT) class ConflictException extends RuntimeException { ConflictException(String m){super(m);} }
+@ResponseStatus(HttpStatus.BAD_REQUEST) class BadRequestException extends RuntimeException { BadRequestException(String m){super(m);} }
