+package com.salesmanager.core.business.services.discount;
+import java.math.BigDecimal; import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service; import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.business.repositories.discount.DiscountRepository; import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl; import com.salesmanager.core.model.discount.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("discountService") public class DiscountServiceImpl extends SalesManagerEntityServiceImpl<Long,Discount> implements DiscountService {
+ private final DiscountRepository repo; @Inject public DiscountServiceImpl(DiscountRepository r){super(r);repo=r;}
+ public Discount getByCode(MerchantStore s,String c){return c==null||s==null?null:repo.findByMerchantStoreIdAndCodeIgnoreCase(s.getId(),c.trim()).orElse(null);}
+ public List<Discount> listByStore(MerchantStore s){return repo.findByMerchantStoreId(s.getId());}
+ public void validate(Discount d)throws ServiceException { if(d==null||d.getMerchantStore()==null||d.getCode()==null||d.getCode().trim().isEmpty()||d.getType()==null||d.getValue()==null||d.getValue().compareTo(BigDecimal.ZERO)<=0) throw new ServiceException("Invalid discount"); if(d.getType()==DiscountType.PERCENT&&d.getValue().compareTo(new BigDecimal("100"))>0) throw new ServiceException("Percent discount must be <= 100"); }
+ public void save(Discount d)throws ServiceException{validate(d); d.setCode(d.getCode().trim().toUpperCase(Locale.ROOT)); super.save(d);}
+ public void update(Discount d)throws ServiceException{validate(d); d.setCode(d.getCode().trim().toUpperCase(Locale.ROOT)); super.update(d);}
+}
