+package com.salesmanager.shop.store.api.v1.discount;
+import java.util.*; import javax.inject.Inject; import javax.validation.Valid; import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import springfox.documentation.annotations.ApiIgnore; import com.salesmanager.core.business.services.discount.DiscountService; import com.salesmanager.core.model.discount.Discount; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.discount.*; import com.salesmanager.shop.store.controller.user.facade.UserFacade; import com.salesmanager.shop.store.api.exception.UnauthorizedException; import java.util.stream.Collectors; import java.util.stream.Stream;
+@RestController @RequestMapping("/api/v1/private/discounts") public class DiscountApi {
+ @Inject private DiscountService service;
+ @Inject private UserFacade userFacade;
+ private void authorize(MerchantStore s){String user=userFacade.authenticatedUser(); if(user==null) throw new UnauthorizedException(); userFacade.authorizedGroup(user, Stream.of("SUPERADMIN","ADMIN_RETAILER").collect(Collectors.toList())); if(s==null) throw new UnauthorizedException();}
+ private Discount map(PersistableDiscount p,MerchantStore s){Discount d=new Discount(); d.setMerchantStore(s); d.setCode(p.getCode());d.setType(p.getType());d.setValue(p.getValue());d.setMinimumSubtotal(p.getMinimumSubtotal());d.setStartDate(p.getStartDate());d.setEndDate(p.getEndDate());d.setActive(p.isActive());d.setCategories(p.getCategories());return d;}
+ private ReadableDiscount out(Discount d){ReadableDiscount r=new ReadableDiscount();r.setId(d.getId());r.setCode(d.getCode());r.setType(d.getType());r.setValue(d.getValue());r.setMinimumSubtotal(d.getMinimumSubtotal());r.setStartDate(d.getStartDate());r.setEndDate(d.getEndDate());r.setActive(d.isActive());r.setCategories(d.getCategories());return r;}
+ @GetMapping public List<ReadableDiscount> list(@ApiIgnore MerchantStore s){authorize(s);List<ReadableDiscount> r=new ArrayList<>();for(Discount d:service.listByStore(s))r.add(out(d));return r;}
+ @GetMapping("/{id}") public ResponseEntity<ReadableDiscount> get(@PathVariable Long id,@ApiIgnore MerchantStore s){authorize(s);Discount d=service.getById(id);return d!=null&&d.getMerchantStore().getId().equals(s.getId())?ResponseEntity.ok(out(d)):ResponseEntity.notFound().build();}
+ @PostMapping public ResponseEntity<?> create(@Valid @RequestBody PersistableDiscount p,@ApiIgnore MerchantStore s){authorize(s);try{if(service.getByCode(s,p.getCode())!=null)return ResponseEntity.status(HttpStatus.CONFLICT).build();Discount d=map(p,s);service.save(d);return ResponseEntity.status(HttpStatus.CREATED).body(out(d));}catch(Exception e){return ResponseEntity.badRequest().body(e.getMessage());}}
+ @PutMapping("/{id}") public ResponseEntity<?> update(@PathVariable Long id,@Valid @RequestBody PersistableDiscount p,@ApiIgnore MerchantStore s){authorize(s);try{Discount d=service.getById(id);if(d==null||!d.getMerchantStore().getId().equals(s.getId()))return ResponseEntity.notFound().build();d.setCode(p.getCode());d.setType(p.getType());d.setValue(p.getValue());d.setMinimumSubtotal(p.getMinimumSubtotal());d.setStartDate(p.getStartDate());d.setEndDate(p.getEndDate());d.setActive(p.isActive());d.setCategories(p.getCategories());service.update(d);return ResponseEntity.ok(out(d));}catch(Exception e){return ResponseEntity.badRequest().body(e.getMessage());}}
+ @DeleteMapping("/{id}") public ResponseEntity<?> delete(@PathVariable Long id,@ApiIgnore MerchantStore s){authorize(s);Discount d=service.getById(id);if(d==null||!d.getMerchantStore().getId().equals(s.getId()))return ResponseEntity.notFound().build();try{service.delete(d);return ResponseEntity.noContent().build();}catch(Exception e){return ResponseEntity.badRequest().build();}}
+}
