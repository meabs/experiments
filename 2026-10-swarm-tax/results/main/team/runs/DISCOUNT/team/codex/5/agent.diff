+package com.salesmanager.shop.store.api.v1.discount;
+
+import java.math.BigDecimal;
+import java.util.*;
+import java.text.SimpleDateFormat;
+import javax.inject.Inject;
+import org.springframework.http.*;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.discount.DiscountCodeService;
+import com.salesmanager.core.model.discount.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.controller.store.facade.StoreFacade;
+
+@RestController
+@RequestMapping("/api/v1/private/discounts")
+public class DiscountCodeApi {
+ @Inject private DiscountCodeService service; @Inject private StoreFacade stores;
+ private MerchantStore store(String code){return stores.getByCode(code);}
+ private DiscountCode from(Map<String,Object> m,MerchantStore s) throws Exception { DiscountCode d=new DiscountCode(); d.setMerchantStore(s); d.setCode((String)m.get("code")); d.setType(DiscountCodeType.valueOf(String.valueOf(m.get("type")).toUpperCase())); d.setValue(new BigDecimal(String.valueOf(m.get("value")))); if(m.get("minimumSubtotal")!=null)d.setMinimumSubtotal(new BigDecimal(String.valueOf(m.get("minimumSubtotal")))); SimpleDateFormat f=new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSSXXX"); if(m.get("startDate")!=null)d.setStartDate(f.parse(String.valueOf(m.get("startDate")))); if(m.get("endDate")!=null)d.setEndDate(f.parse(String.valueOf(m.get("endDate")))); d.setActive(m.get("active")==null||Boolean.parseBoolean(String.valueOf(m.get("active")))); Object c=m.get("categories"); if(c instanceof Collection) for(Object x:(Collection<?>)c)d.getCategories().add(String.valueOf(x)); return d; }
+ @GetMapping public List<DiscountCode> list(@RequestParam("store") String store){return service.list(store(store));}
+ @PostMapping public ResponseEntity<?> create(@RequestParam("store") String store,@RequestBody Map<String,Object> body){try{return ResponseEntity.status(HttpStatus.CREATED).body(service.save(from(body,store(store))));}catch(Exception e){return ResponseEntity.status(e.getMessage()!=null&&e.getMessage().contains("exists")?409:400).body(e.getMessage());}}
+ @PutMapping("/{id}") public ResponseEntity<?> update(@PathVariable Long id,@RequestParam("store") String store,@RequestBody Map<String,Object> body){try{MerchantStore s=store(store);DiscountCode old=null;for(DiscountCode x:service.list(s))if(id.equals(x.getId()))old=x;if(old==null)return ResponseEntity.notFound().build();DiscountCode d=from(body,s);d.setId(id);return ResponseEntity.ok(service.save(d));}catch(Exception e){return ResponseEntity.badRequest().body(e.getMessage());}}
+ @DeleteMapping("/{id}") @ResponseStatus(HttpStatus.NO_CONTENT) public void delete(@PathVariable Long id,@RequestParam("store") String store){for(DiscountCode d:service.list(store(store)))if(id.equals(d.getId())){try{service.delete(d);}catch(Exception e){throw new RuntimeException(e);}return;}}
+}
