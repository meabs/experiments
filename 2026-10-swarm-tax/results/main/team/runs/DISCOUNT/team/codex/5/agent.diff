+public class DiscountCode extends SalesManagerEntity<Long, DiscountCode> {
+ private static final long serialVersionUID=1L;
+ @Id @GeneratedValue(strategy=GenerationType.TABLE, generator="TABLE_GEN") @TableGenerator(name="TABLE_GEN",table="SM_SEQUENCER",pkColumnName="SEQ_NAME",valueColumnName="SEQ_COUNT",pkColumnValue="DISCOUNT_CODE_SEQ_NEXT_VAL") @Column(name="DISCOUNT_CODE_ID") private Long id;
