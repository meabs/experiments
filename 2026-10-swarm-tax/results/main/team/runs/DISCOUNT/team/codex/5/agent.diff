+package com.salesmanager.core.business.services.discount;
+import java.math.BigDecimal;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.util.StringUtils;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.discount.DiscountCodeRepository;
+import com.salesmanager.core.model.discount.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("discountCodeService") public class DiscountCodeServiceImpl implements DiscountCodeService {
+ @Inject private DiscountCodeRepository repository;
+ public DiscountCode getByCode(MerchantStore s,String c){return s==null||!StringUtils.hasText(c)?null:repository.findByStoreAndCode(s.getId(),c.trim());}
+ public List<DiscountCode> list(MerchantStore s){return repository.findByStore(s.getId());}
+ public DiscountCode save(DiscountCode d)throws ServiceException {validate(d); DiscountCode old=getByCode(d.getMerchantStore(),d.getCode()); if(old!=null&&!old.getId().equals(d.getId())) throw new ServiceException("Discount code already exists"); d.setCode(d.getCode().trim()); return repository.saveAndFlush(d);}
+ public void delete(DiscountCode d)throws ServiceException {repository.delete(d);}
+ public void validate(DiscountCode d)throws ServiceException {if(d==null||d.getMerchantStore()==null||!StringUtils.hasText(d.getCode())||d.getType()==null||d.getValue()==null||d.getValue().compareTo(BigDecimal.ZERO)<=0) throw new ServiceException("Invalid discount code"); if(d.getType()==DiscountCodeType.PERCENT&&d.getValue().compareTo(new BigDecimal("100"))>0) throw new ServiceException("Percent must be <= 100"); if(d.getStartDate()!=null&&d.getEndDate()!=null&&d.getStartDate().after(d.getEndDate())) throw new ServiceException("Invalid discount dates"); if(d.getCategories()!=null) for(String c:d.getCategories()) if(!StringUtils.hasText(c)) throw new ServiceException("Invalid category");}
+}
