+package com.salesmanager.core.business.services.discount;
+import java.math.BigDecimal; import java.util.*; import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.discount.DiscountCodeRepository;
+import com.salesmanager.core.model.discount.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("discountCodeService") public class DiscountCodeServiceImpl implements DiscountCodeService {
+ @Inject private DiscountCodeRepository repo;
+ public DiscountCode save(DiscountCode d,MerchantStore s){
+  if(d==null||d.getCode()==null||d.getCode().trim().isEmpty()||d.getType()==null||d.getValue()==null) throw new IllegalArgumentException("code, type and value are required");
+  if(d.getType()==DiscountCodeType.PERCENT && (d.getValue().compareTo(BigDecimal.ZERO)<0||d.getValue().compareTo(new BigDecimal("100"))>0)) throw new IllegalArgumentException("percent must be 0..100");
+  if(d.getType()==DiscountCodeType.AMOUNT && d.getValue().compareTo(BigDecimal.ZERO)<0) throw new IllegalArgumentException("amount must be non-negative");
+  if(d.getStartDate()!=null&&d.getEndDate()!=null&&d.getStartDate().after(d.getEndDate())) throw new IllegalArgumentException("startDate must not be after endDate");
+  if (d.getId()!=null) {
+   DiscountCode existing=repo.findById(d.getId()).orElseThrow(() -> new NoSuchElementException("discount code not found"));
+   if (existing.getMerchantStore()==null || !existing.getMerchantStore().getId().equals(s.getId())) throw new NoSuchElementException("discount code not found");
+  }
+  d.setMerchantStore(s); String key=d.getCode().trim().toLowerCase(Locale.ROOT); d.setCodeKey(key);
+  Optional<DiscountCode> old=repo.findByMerchantStoreIdAndCodeKey(s.getId(),key); if(old.isPresent()&&(d.getId()==null||!old.get().getId().equals(d.getId()))) throw new IllegalStateException("discount code already exists");
+  return repo.save(d);
+ }
+ public List<DiscountCode> list(MerchantStore s){return repo.findByMerchantStoreId(s.getId());}
+ public Optional<DiscountCode> find(MerchantStore s,String code){return repo.findByMerchantStoreIdAndCodeKey(s.getId(),code.trim().toLowerCase(Locale.ROOT));}
+ public void delete(Long id,MerchantStore s){repo.findById(id).filter(x->x.getMerchantStore().getId().equals(s.getId())).ifPresent(repo::delete);}
+}
