+package com.salesmanager.core.model.discount;
+
+import java.math.BigDecimal;
+import java.util.Date;
+import javax.persistence.*;
+import com.salesmanager.core.model.generic.SalesManagerEntity;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Entity
+@Table(name="DISCOUNT_CODE", uniqueConstraints=@UniqueConstraint(columnNames={"MERCHANT_ID","CODE_KEY"}))
+public class DiscountCode extends SalesManagerEntity<Long, DiscountCode> {
+ private static final long serialVersionUID=1L;
+ @Id @GeneratedValue(strategy=GenerationType.AUTO) private Long id;
+ @ManyToOne(fetch=FetchType.LAZY, optional=false) @JoinColumn(name="MERCHANT_ID",nullable=false) private MerchantStore merchantStore;
+ @Column(nullable=false) private String code;
+ @Column(name="CODE_KEY",nullable=false) private String codeKey;
+ @Enumerated(EnumType.STRING) @Column(nullable=false) private DiscountCodeType type;
+ @Column(nullable=false,precision=19,scale=4) private BigDecimal value;
+ @Column(nullable=false) private boolean active=true;
+ @Temporal(TemporalType.TIMESTAMP) private Date startDate;
+ @Temporal(TemporalType.TIMESTAMP) private Date endDate;
+ @Column(precision=19,scale=4) private BigDecimal minimumSpend;
+ @Column(length=4000) private String categoryIds;
+ public Long getId(){return id;} public void setId(Long v){id=v;}
+ public MerchantStore getMerchantStore(){return merchantStore;} public void setMerchantStore(MerchantStore v){merchantStore=v;}
+ public String getCode(){return code;} public void setCode(String v){code=v; codeKey=v==null?null:v.trim().toLowerCase(java.util.Locale.ROOT);}
+ public String getCodeKey(){return codeKey;} public void setCodeKey(String v){codeKey=v;}
+ public DiscountCodeType getType(){return type;} public void setType(DiscountCodeType v){type=v;}
+ public BigDecimal getValue(){return value;} public void setValue(BigDecimal v){value=v;}
+ public boolean isActive(){return active;} public void setActive(boolean v){active=v;}
+ public Date getStartDate(){return startDate;} public void setStartDate(Date v){startDate=v;}
+ public Date getEndDate(){return endDate;} public void setEndDate(Date v){endDate=v;}
+ public BigDecimal getMinimumSpend(){return minimumSpend;} public void setMinimumSpend(BigDecimal v){minimumSpend=v;}
+ public String getCategoryIds(){return categoryIds;} public void setCategoryIds(String v){categoryIds=v;}
+}
