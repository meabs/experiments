+package com.salesmanager.shop.store.api.v1.discount;
+import java.util.*; import javax.inject.Inject; import javax.validation.Valid;
+import org.springframework.http.*; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.discount.DiscountCodeService; import com.salesmanager.core.model.discount.DiscountCode; import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.discount.PersistableDiscountCode; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/discounts") public class DiscountCodeApi {
+ @Inject private DiscountCodeService service;
+ @PostMapping public ResponseEntity<DiscountCode> create(@Valid @RequestBody PersistableDiscountCode in,@ApiIgnore MerchantStore store){return new ResponseEntity<>(service.save(convert(in,null),store),HttpStatus.CREATED);}
+ @GetMapping public List<DiscountCode> list(@ApiIgnore MerchantStore store){return service.list(store);}
+ @PutMapping("/{id}") public DiscountCode update(@PathVariable Long id,@Valid @RequestBody PersistableDiscountCode in,@ApiIgnore MerchantStore store){try{return service.save(convert(in,id),store);}catch(NoSuchElementException e){throw new org.springframework.web.server.ResponseStatusException(HttpStatus.NOT_FOUND,e.getMessage());}}
+ @DeleteMapping("/{id}") @ResponseStatus(HttpStatus.NO_CONTENT) public void delete(@PathVariable Long id,@ApiIgnore MerchantStore store){service.delete(id,store);}
+ private DiscountCode convert(PersistableDiscountCode x,Long id){DiscountCode d=new DiscountCode(); d.setId(id); d.setCode(x.getCode()); d.setType(x.getType()); d.setValue(x.getValue()); d.setActive(x.isActive()); d.setStartDate(x.getStartDate()); d.setEndDate(x.getEndDate()); d.setMinimumSpend(x.getMinimumSpend()); d.setCategoryIds(x.getCategoryIds()); return d;}
+}
