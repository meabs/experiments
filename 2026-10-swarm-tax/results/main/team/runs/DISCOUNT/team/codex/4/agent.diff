+package com.salesmanager.core.model.discount;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.List;
+import javax.persistence.*;
+import com.salesmanager.core.model.generic.SalesManagerEntity;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Entity
+@Table(name="MERCHANT_DISCOUNT", uniqueConstraints=@UniqueConstraint(columnNames={"MERCHANT_ID","CODE_NORMALIZED"}))
+public class Discount extends SalesManagerEntity<Long, Discount> {
+  @Id @GeneratedValue(strategy=GenerationType.TABLE, generator="TABLE_GEN")
+  @TableGenerator(name="TABLE_GEN", table="SM_SEQUENCER", pkColumnName="SEQ_NAME", valueColumnName="SEQ_COUNT", pkColumnValue="DISCOUNT_SEQ_NEXT_VAL")
+  private Long id;
+  @ManyToOne(fetch=FetchType.LAZY, optional=false) @JoinColumn(name="MERCHANT_ID", nullable=false)
+  private MerchantStore merchantStore;
+  @Column(nullable=false, length=100) private String code;
+  @Column(name="CODE_NORMALIZED", nullable=false, length=100) private String codeNormalized;
+  @Enumerated(EnumType.STRING) @Column(nullable=false, length=16) private DiscountType type;
+  @Column(nullable=false, precision=19, scale=4) private BigDecimal value;
+  @Column(precision=19, scale=4) private BigDecimal minimumSubtotal;
+  @Temporal(TemporalType.TIMESTAMP) private Date startDate = new Date();
+  @Temporal(TemporalType.TIMESTAMP) private Date endDate;
+  @Column(nullable=false) private boolean active = true;
+  @ElementCollection @CollectionTable(name="MERCHANT_DISCOUNT_CATEGORY", joinColumns=@JoinColumn(name="DISCOUNT_ID"))
+  @Column(name="CATEGORY_CODE") private List<String> categories = new ArrayList<String>();
+  public Long getId(){return id;} public void setId(Long id){this.id=id;}
+  public MerchantStore getMerchantStore(){return merchantStore;} public void setMerchantStore(MerchantStore s){merchantStore=s;}
+  public String getCode(){return code;} public void setCode(String v){code=v; codeNormalized=v==null?null:v.trim().toLowerCase(java.util.Locale.ROOT);}
+  public String getCodeNormalized(){return codeNormalized;} public void setCodeNormalized(String v){codeNormalized=v;}
+  public DiscountType getType(){return type;} public void setType(DiscountType v){type=v;}
+  public BigDecimal getValue(){return value;} public void setValue(BigDecimal v){value=v;}
+  public BigDecimal getMinimumSubtotal(){return minimumSubtotal;} public void setMinimumSubtotal(BigDecimal v){minimumSubtotal=v;}
+  public Date getStartDate(){return startDate;} public void setStartDate(Date v){startDate=v;}
+  public Date getEndDate(){return endDate;} public void setEndDate(Date v){endDate=v;}
+  public boolean isActive(){return active;} public void setActive(boolean v){active=v;}
+  public List<String> getCategories(){return categories;} public void setCategories(List<String> v){categories=v==null?new ArrayList<String>():v;}
+}
