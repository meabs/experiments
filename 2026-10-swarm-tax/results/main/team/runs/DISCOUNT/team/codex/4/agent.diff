+	private boolean eligible(Product product, List<String> codes) {
+		if (product.getCategories() == null) return false;
+		for (Category category : product.getCategories()) {
+			for (Category current = category; current != null; current = current.getParent()) {
+				for (String code : codes) if (sameCode(current.getCode(), code)) return true;
+			}
+		}
+		return false;
+	}
+
+	private boolean sameCode(String left, String right) {
+		return left != null && right != null && left.trim().toLowerCase(Locale.ROOT)
+				.equals(right.trim().toLowerCase(Locale.ROOT));
+	}
+
+	private boolean sameItem(ShoppingCartItem left, ShoppingCartItem right) {
+		return left == right || (left != null && right != null && left.getId() != null
+				&& left.getId().equals(right.getId()));
+	}
