+package com.salesmanager.shop.store.api.v1.discount;
+import java.util.List;
+import java.util.ArrayList;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import javax.validation.Valid;
+import org.springframework.dao.DataIntegrityViolationException;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.discount.DiscountService;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.discount.PersistableDiscount;
+import com.salesmanager.shop.model.discount.ReadableDiscount;
+import com.salesmanager.shop.store.api.exception.GenericRuntimeException;
+import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/discounts")
+public class DiscountApi {
+ @Inject private DiscountService service;
+ @GetMapping public List<ReadableDiscount> list(@ApiIgnore MerchantStore store){return service.listByStore(store).stream().map(this::read).collect(Collectors.toList());}
+ @GetMapping("/{id}") public ReadableDiscount get(@PathVariable Long id,@ApiIgnore MerchantStore store) throws Exception{Discount d=service.getById(id); if(d==null||d.getMerchantStore()==null||!store.getId().equals(d.getMerchantStore().getId())) throw new GenericRuntimeException("Discount not found"); return read(d);}
+ @PostMapping @ResponseStatus(HttpStatus.CREATED) public ReadableDiscount create(@Valid @RequestBody PersistableDiscount in,@ApiIgnore MerchantStore store) throws Exception{return save(null,in,store);}
+ @PutMapping("/{id}") public ReadableDiscount update(@PathVariable Long id,@Valid @RequestBody PersistableDiscount in,@ApiIgnore MerchantStore store) throws Exception{return save(id,in,store);}
+ @DeleteMapping("/{id}") @ResponseStatus(HttpStatus.NO_CONTENT) public void delete(@PathVariable Long id,@ApiIgnore MerchantStore store) throws Exception{service.delete(getEntity(id,store));}
+ private ReadableDiscount save(Long id,PersistableDiscount in,MerchantStore store) throws Exception{if(in.getCode()==null||in.getCode().trim().isEmpty())throw new GenericRuntimeException("code is required"); if(in.getType()==null||in.getValue()==null||in.getValue().compareTo(java.math.BigDecimal.ZERO)<0||(in.getType()==com.salesmanager.core.model.discount.DiscountType.PERCENT&&in.getValue().compareTo(new java.math.BigDecimal("100"))>0))throw new org.springframework.web.server.ResponseStatusException(HttpStatus.BAD_REQUEST,"Invalid discount value"); Discount collision=service.getByCode(store,in.getCode()); if(collision!=null&&(id==null||!collision.getId().equals(id)))throw new org.springframework.web.server.ResponseStatusException(HttpStatus.CONFLICT,"Discount code already exists"); Discount d=id==null?new Discount():getEntity(id,store); d.setMerchantStore(store); d.setCode(in.getCode());d.setType(in.getType());d.setValue(in.getValue());d.setMinimumSubtotal(in.getMinimumSubtotal());d.setStartDate(in.getStartDate()==null?new java.util.Date():in.getStartDate());d.setEndDate(in.getEndDate());d.setActive(in.getActive()==null||in.getActive());d.setCategories(in.getCategories());try{service.saveOrUpdate(d);}catch(DataIntegrityViolationException e){throw new org.springframework.web.server.ResponseStatusException(HttpStatus.CONFLICT,"Discount code already exists");}return read(d);}
+ private Discount getEntity(Long id,MerchantStore s) throws Exception{Discount d=service.getById(id);if(d==null||d.getMerchantStore()==null||!s.getId().equals(d.getMerchantStore().getId()))throw new GenericRuntimeException("Discount not found");return d;}
+ private ReadableDiscount read(Discount d){ReadableDiscount r=new ReadableDiscount();r.setId(d.getId());r.setCode(d.getCode());r.setType(d.getType());r.setValue(d.getValue());r.setMinimumSubtotal(d.getMinimumSubtotal());r.setStartDate(d.getStartDate());r.setEndDate(d.getEndDate());r.setActive(d.isActive());r.setCategories(d.getCategories());return r;}
+}
