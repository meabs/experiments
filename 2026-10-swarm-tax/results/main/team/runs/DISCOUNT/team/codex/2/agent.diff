+package com.salesmanager.core.business.services.discount;
+import java.util.*;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.util.StringUtils;
+import com.salesmanager.core.business.repositories.discount.DiscountRepository;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service
+public class DiscountServiceImpl implements DiscountService {
+ private final DiscountRepository repository;
+ public DiscountServiceImpl(DiscountRepository repository){this.repository=repository;}
+ private void check(Discount d, MerchantStore s){ if(d==null||s==null||!StringUtils.hasText(d.getCode())||d.getValue()==null) throw new DiscountValidationException("Invalid discount"); if(d.getValue().signum()<0 || (d.getMinimumOrderTotal()!=null&&d.getMinimumOrderTotal().signum()<0) || (d.getMaximumDiscount()!=null&&d.getMaximumDiscount().signum()<0)) throw new DiscountValidationException("Discount values cannot be negative"); String type=d.getType()==null?"PERCENTAGE":d.getType().trim().toUpperCase(Locale.ROOT); if(!type.equals("PERCENTAGE")&&!type.equals("PERCENT")&&!type.equals("FIXED")&&!type.equals("AMOUNT")) throw new DiscountValidationException("Invalid discount type"); if((type.equals("PERCENTAGE")||type.equals("PERCENT"))&&d.getValue().compareTo(new java.math.BigDecimal("100"))>0) throw new DiscountValidationException("Percentage discount cannot exceed 100"); d.setType(type); d.setCode(d.getCode().trim().toUpperCase(Locale.ROOT)); d.setMerchantStore(s); }
+ @Transactional public Discount save(Discount d, MerchantStore s){check(d,s); if(repository.existsByMerchantStoreIdAndCodeIgnoreCase(s.getId(),d.getCode())) throw new IllegalStateException("Discount code already exists"); return repository.save(d);}
+ @Transactional public Discount update(Discount d,Long id,MerchantStore s){Discount old=get(id,s); check(d,s); d.setId(old.getId()); if(!old.getCode().equalsIgnoreCase(d.getCode())&&repository.existsByMerchantStoreIdAndCodeIgnoreCase(s.getId(),d.getCode())) throw new IllegalStateException("Discount code already exists"); return repository.save(d);}
+ @Transactional public void delete(Long id,MerchantStore s){repository.delete(get(id,s));}
+ public Discount get(Long id,MerchantStore s){return repository.findById(id).filter(d->d.getMerchantStore().getId().equals(s.getId())).orElseThrow(()->new NoSuchElementException("Discount not found"));}
+ public Optional<Discount> findByCode(String c,MerchantStore s){return StringUtils.hasText(c)?repository.findByMerchantStoreIdAndCodeIgnoreCase(s.getId(),c.trim()):Optional.empty();}
+ public List<Discount> list(MerchantStore s){return repository.findByMerchantStoreId(s.getId());}
+}
