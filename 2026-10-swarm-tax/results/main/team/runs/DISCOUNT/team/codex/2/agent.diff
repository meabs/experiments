+import java.math.BigDecimal;
+import java.util.Date;
+import javax.persistence.*;
+import com.salesmanager.core.model.generic.SalesManagerEntity;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+/** A coupon owned by one merchant store. Dates are inclusive. */
+@Entity
+@Table(name="DISCOUNT", uniqueConstraints=@UniqueConstraint(columnNames={"STORE_ID","CODE"}), indexes=@Index(columnList="STORE_ID,CODE"))
+public class Discount extends SalesManagerEntity<Long, Discount> {
+  @Id @GeneratedValue(strategy=GenerationType.TABLE, generator="TABLE_GEN")
+  @TableGenerator(name="TABLE_GEN", table="SM_SEQUENCER", pkColumnName="SEQ_NAME", valueColumnName="SEQ_COUNT", pkColumnValue="DISCOUNT_SEQ_NEXT_VAL")
+  private Long id;
+  @ManyToOne(fetch=FetchType.LAZY, optional=false) @JoinColumn(name="STORE_ID", nullable=false)
+  private MerchantStore merchantStore;
+  @Column(nullable=false, length=100) private String code;
+  @Column(nullable=false, length=20) private String type = "PERCENTAGE";
+  @Column(nullable=false, precision=19, scale=6) private BigDecimal value;
+  private BigDecimal minimumOrderTotal;
+  private BigDecimal maximumDiscount;
+  @Temporal(TemporalType.TIMESTAMP) private Date startDate;
+  @Temporal(TemporalType.TIMESTAMP) private Date endDate;
+  private String categoryCode;
+  private boolean enabled = true;
+  public Long getId(){return id;} public void setId(Long v){id=v;}
+  public MerchantStore getMerchantStore(){return merchantStore;} public void setMerchantStore(MerchantStore v){merchantStore=v;}
+  public String getCode(){return code;} public void setCode(String v){code=v;}
+  public String getType(){return type;} public void setType(String v){type=v;}
+  public BigDecimal getValue(){return value;} public void setValue(BigDecimal v){value=v;}
+  public BigDecimal getMinimumOrderTotal(){return minimumOrderTotal;} public void setMinimumOrderTotal(BigDecimal v){minimumOrderTotal=v;}
+  public BigDecimal getMaximumDiscount(){return maximumDiscount;} public void setMaximumDiscount(BigDecimal v){maximumDiscount=v;}
+  public Date getStartDate(){return startDate;} public void setStartDate(Date v){startDate=v;}
+  public Date getEndDate(){return endDate;} public void setEndDate(Date v){endDate=v;}
+  public String getCategoryCode(){return categoryCode;} public void setCategoryCode(String v){categoryCode=v;}
+  public boolean isEnabled(){return enabled;} public void setEnabled(boolean v){enabled=v;}
+}
