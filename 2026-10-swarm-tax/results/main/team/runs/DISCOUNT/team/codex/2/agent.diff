+package com.salesmanager.shop.store.api.v1.discount;
+import java.util.*; import javax.inject.Inject; import org.springframework.http.*; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.discount.DiscountService; import com.salesmanager.core.model.discount.Discount; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.discount.*; import com.salesmanager.shop.model.entity.Entity; import springfox.documentation.annotations.ApiIgnore; import io.swagger.annotations.Api;
+@RestController @RequestMapping("/api/v1/private/discounts") @Api(tags={"Discounts"})
+public class DiscountApi {
+ @Inject private DiscountService service;
+ private ReadableDiscount out(Discount d){ReadableDiscount r=new ReadableDiscount();r.setId(d.getId());r.setCode(d.getCode());r.setType(d.getType());r.setValue(d.getValue());r.setMinimumOrderTotal(d.getMinimumOrderTotal());r.setMaximumDiscount(d.getMaximumDiscount());r.setStartDate(d.getStartDate());r.setEndDate(d.getEndDate());r.setCategoryCode(d.getCategoryCode());r.setEnabled(d.isEnabled());return r;}
+ private Discount in(PersistableDiscount p){Discount d=new Discount();d.setCode(p.getCode());d.setType(p.getType());d.setValue(p.getValue());d.setMinimumOrderTotal(p.getMinimumOrderTotal());d.setMaximumDiscount(p.getMaximumDiscount());d.setStartDate(p.getStartDate());d.setEndDate(p.getEndDate());d.setCategoryCode(p.getCategoryCode());if(p.getEnabled()!=null)d.setEnabled(p.getEnabled());return d;}
+ @GetMapping public List<ReadableDiscount> list(@ApiIgnore MerchantStore s){List<ReadableDiscount> r=new ArrayList<>();for(Discount d:service.list(s))r.add(out(d));return r;}
+ @GetMapping("/{id}") public ReadableDiscount get(@PathVariable Long id,@ApiIgnore MerchantStore s){return out(service.get(id,s));}
+ @PostMapping public Entity create(@RequestBody PersistableDiscount p,@ApiIgnore MerchantStore s){Discount d=service.save(in(p),s);Entity e=new Entity();e.setId(d.getId());return e;}
+ @PutMapping("/{id}") public void update(@PathVariable Long id,@RequestBody PersistableDiscount p,@ApiIgnore MerchantStore s){service.update(in(p),id,s);}
+ @DeleteMapping("/{id}") @ResponseStatus(HttpStatus.NO_CONTENT) public void delete(@PathVariable Long id,@ApiIgnore MerchantStore s){service.delete(id,s);}
+}
