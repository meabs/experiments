+package com.salesmanager.shop.store.api.v1.product;
+import java.util.*;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductTierService;
+import com.salesmanager.core.model.catalog.product.ProductTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.*;
+import springfox.documentation.annotations.ApiIgnore;
+@RestController
+@RequestMapping("/api/v1/private/product/{productId}/tiers")
+public class ProductTierApi {
+ @Autowired private ProductTierService service;
+ @GetMapping public List<ReadableProductTier> get(@PathVariable Long productId,@ApiIgnore MerchantStore store){ return map(service.findByProduct(productId,store)); }
+ @PutMapping @PostMapping public List<ReadableProductTier> replace(@PathVariable Long productId,@RequestBody List<PersistableProductTier> body,@ApiIgnore MerchantStore store){
+   List<ProductTier> tiers=new ArrayList<>(); for(PersistableProductTier d:body){ProductTier t=new ProductTier();t.setMinimumQuantity(d.getMinimumQuantity());t.setPrice(d.getPrice());tiers.add(t);} return map(service.replace(productId,store,tiers)); }
+ private List<ReadableProductTier> map(List<ProductTier> in){List<ReadableProductTier> out=new ArrayList<>();for(ProductTier t:in){ReadableProductTier d=new ReadableProductTier();d.setId(t.getId());d.setMinimumQuantity(t.getMinimumQuantity());d.setPrice(t.getPrice());out.add(d);}out.sort(Comparator.comparing(ReadableProductTier::getMinimumQuantity));return out;}
+}
