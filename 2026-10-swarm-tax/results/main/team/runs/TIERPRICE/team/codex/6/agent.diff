+package com.salesmanager.core.business.services.catalog.product;
+import java.math.BigDecimal;
+import java.util.*;
+import javax.transaction.Transactional;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.ProductTierRepository;
+import com.salesmanager.core.model.catalog.product.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("productTierService")
+public class ProductTierServiceImpl implements ProductTierService {
+    private final ProductTierRepository repository; private final ProductService productService;
+    @Inject public ProductTierServiceImpl(ProductTierRepository repository, ProductService productService) { this.repository=repository; this.productService=productService; }
+    public List<ProductTier> findByProduct(Long id, MerchantStore store) { product(id, store); return repository.findByProductIdOrderByMinimumQuantityAsc(id); }
+    @Transactional public List<ProductTier> replace(Long id, MerchantStore store, List<ProductTier> tiers) {
+        Product product=product(id,store); validate(tiers);
+        repository.deleteByProductId(id); repository.flush();
+        for(ProductTier tier: tiers) tier.setProduct(product);
+        return repository.saveAll(tiers);
+    }
+    public BigDecimal priceForQuantity(Long id, int quantity, BigDecimal base) {
+        BigDecimal result=base; for(ProductTier t: repository.findByProductIdOrderByMinimumQuantityAsc(id)) if(quantity>=t.getMinimumQuantity() && t.getPrice().compareTo(result)<0) result=t.getPrice(); return result;
+    }
+    private Product product(Long id, MerchantStore store) { return productService.retrieveById(id,store).orElseThrow(() -> new IllegalArgumentException("Product not found")); }
+    private void validate(List<ProductTier> tiers) {
+        if(tiers==null || tiers.size()<2 || tiers.size()>10) throw new IllegalArgumentException("Tier count must be between 2 and 10");
+        tiers.sort(Comparator.comparing(ProductTier::getMinimumQuantity, Comparator.nullsFirst(Integer::compareTo)));
+        Set<Integer> mins=new HashSet<>(); BigDecimal previous=null;
+        for(ProductTier t: tiers) { if(t.getMinimumQuantity()==null || t.getMinimumQuantity()<1 || !mins.add(t.getMinimumQuantity()) || t.getPrice()==null || t.getPrice().signum()<=0) throw new IllegalArgumentException("Invalid tier"); if(previous!=null && t.getPrice().compareTo(previous)>=0) throw new IllegalArgumentException("Prices must strictly decrease"); previous=t.getPrice(); }
+    }
+}
