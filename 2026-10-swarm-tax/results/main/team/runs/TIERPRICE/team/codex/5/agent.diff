+	/** Returns the quantity price tiers configured for a product. */
+	@GetMapping(value = {"/private/product/{id}/tiers", "/auth/product/{id}/tiers"}, produces = APPLICATION_JSON_VALUE)
+	@ResponseBody
+	public Set<ProductQuantityPriceTier> getQuantityPriceTiers(@PathVariable Long id,
+			@ApiIgnore MerchantStore merchantStore) {
+		Product product = productService.findOne(id, merchantStore);
+		if (product == null) throw new ResourceNotFoundException("Product not found");
+		return product.getQuantityPriceTiers();
+	}
+
+	/** Replaces all quantity price tiers atomically. */
+	@RequestMapping(value = {"/private/product/{id}/tiers", "/auth/product/{id}/tiers"}, method = RequestMethod.PUT,
+			consumes = APPLICATION_JSON_VALUE, produces = APPLICATION_JSON_VALUE)
+	@ResponseBody
+	public Set<ProductQuantityPriceTier> setQuantityPriceTiers(@PathVariable Long id,
+			@RequestBody List<ProductQuantityPriceTier> tiers, @ApiIgnore MerchantStore merchantStore) throws ServiceException {
+		Product product = productService.findOne(id, merchantStore);
+		if (product == null) throw new ResourceNotFoundException("Product not found");
+		if (tiers == null || tiers.size() > 10) throw new ServiceRuntimeException("400", "At most 10 tiers are allowed");
+		Set<Integer> quantities = new HashSet<Integer>();
+		for (ProductQuantityPriceTier tier : tiers) {
+			if (tier == null || tier.getMinQuantity() == null || tier.getMinQuantity() < 2
+					|| tier.getPrice() == null || tier.getPrice().compareTo(BigDecimal.ZERO) <= 0
+					|| !quantities.add(tier.getMinQuantity()))
+				throw new ServiceRuntimeException("400", "Invalid quantity price tier");
+		}
+		tiers.sort(Comparator.comparing(ProductQuantityPriceTier::getMinQuantity));
+		for (int i = 1; i < tiers.size(); i++) {
+			if (tiers.get(i).getPrice().compareTo(tiers.get(i - 1).getPrice()) >= 0)
+				throw new ServiceRuntimeException("400", "Tier prices must strictly decrease");
+		}
+		Set<ProductQuantityPriceTier> replacement = new HashSet<ProductQuantityPriceTier>();
+		for (ProductQuantityPriceTier tier : tiers) { tier.setId(null); tier.setProduct(product); replacement.add(tier); }
+		product.setQuantityPriceTiers(replacement);
+		productService.update(product);
+		return product.getQuantityPriceTiers();
+	}
