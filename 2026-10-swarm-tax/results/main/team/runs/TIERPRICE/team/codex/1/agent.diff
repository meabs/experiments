+	@ResponseStatus(HttpStatus.OK)
+	@RequestMapping(value = "/private/product/{id}/tiers", method = RequestMethod.PUT)
+	@ResponseBody
+	public List<com.salesmanager.shop.model.catalog.product.ProductPriceTier> putTiers(@PathVariable Long id, @RequestBody List<com.salesmanager.shop.model.catalog.product.ProductPriceTier> tiers, @ApiIgnore MerchantStore merchantStore) throws Exception {
+		Product p = productService.retrieveById(id, merchantStore).orElseThrow(() -> new ResourceNotFoundException("Product [" + id + "] not found"));
+		if (tiers == null || tiers.size() > 10) throw new ServiceRuntimeException("400", "At most 10 tiers are allowed");
+		HashSet<Integer> mins = new HashSet<>(); List<ProductPriceTier> replacement = new ArrayList<>();
