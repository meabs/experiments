+	private FinalPrice applyQuantityPrice(FinalPrice base, Product product, Integer quantity) {
+		if (base == null || base.getFinalPrice() == null || quantity == null) return base;
+		for (ProductQuantityPrice tier : quantityPriceService.list(product)) {
+			if (quantity >= tier.getMinQuantity() && tier.getPrice().compareTo(base.getFinalPrice()) < 0) {
+				base.setFinalPrice(tier.getPrice());
+				return base;
+			}
+		}
+		return base;
+	}
