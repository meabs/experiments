+package com.salesmanager.shop.store.api.v1.product;
+import java.util.*; import javax.inject.Inject; import org.springframework.http.HttpStatus; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.catalog.product.price.ProductQuantityPriceService; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.price.ProductQuantityPrice; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.catalog.product.PersistableProductPriceTier; import com.salesmanager.shop.store.api.exception.ResourceNotFoundException; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/product") public class ProductPriceTierApi {
+ @Inject private ProductService productService; @Inject private ProductQuantityPriceService tierService;
+ @GetMapping("/{id}/tiers") public List<PersistableProductPriceTier> get(@PathVariable Long id,@ApiIgnore MerchantStore store){return toDto(product(id,store));}
+ @PutMapping("/{id}/tiers") @ResponseStatus(HttpStatus.OK) public List<PersistableProductPriceTier> put(@PathVariable Long id,@RequestBody List<PersistableProductPriceTier> input,@ApiIgnore MerchantStore store){Product p=product(id,store); List<ProductQuantityPrice> tiers=new ArrayList<ProductQuantityPrice>(); if(input!=null)for(PersistableProductPriceTier d:input){ProductQuantityPrice t=new ProductQuantityPrice();t.setMinQuantity(d.getMinQuantity());t.setPrice(d.getPrice());tiers.add(t);} tiers.sort(Comparator.comparing(ProductQuantityPrice::getMinQuantity,Comparator.nullsFirst(Integer::compareTo))); try{tierService.replace(p,tiers);}catch(ServiceException e){throw new IllegalArgumentException(e.getMessage(),e);} return toDto(p);}
+ private Product product(Long id,MerchantStore store){Product p=productService.findOne(id,store);if(p==null)throw new ResourceNotFoundException("Product not found");return p;}
+ private List<PersistableProductPriceTier> toDto(Product p){List<PersistableProductPriceTier> out=new ArrayList<PersistableProductPriceTier>();for(ProductQuantityPrice t:tierService.list(p)){PersistableProductPriceTier d=new PersistableProductPriceTier();d.setMinQuantity(t.getMinQuantity());d.setPrice(t.getPrice());out.add(d);}return out;}
+}
