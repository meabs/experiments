+import java.util.*; import java.math.BigDecimal; import javax.inject.Inject; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.business.repositories.catalog.product.price.ProductQuantityPriceRepository; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.price.ProductQuantityPrice;
+@Service("productQuantityPriceService") public class ProductQuantityPriceServiceImpl implements ProductQuantityPriceService {
+ @Inject private ProductQuantityPriceRepository repository;
+ public List<ProductQuantityPrice> list(Product p){return repository.findByProductIdOrderByMinQuantityAsc(p.getId());}
+ @Transactional public void replace(Product p,List<ProductQuantityPrice> tiers)throws ServiceException { if(tiers==null||tiers.size()>10)throw new ServiceException("At most 10 tiers are allowed"); Set<Integer> seen=new HashSet<Integer>(); BigDecimal previous=null; for(ProductQuantityPrice t:tiers){if(t==null||t.getMinQuantity()==null||t.getMinQuantity()<2||!seen.add(t.getMinQuantity())||t.getPrice()==null||t.getPrice().signum()<=0)throw new ServiceException("Invalid quantity price tier"); if(previous!=null&&t.getPrice().compareTo(previous)>=0)throw new ServiceException("Tier prices must strictly decrease"); previous=t.getPrice(); t.setProduct(p);} repository.deleteAll(repository.findByProductIdOrderByMinQuantityAsc(p.getId())); repository.flush(); repository.saveAll(tiers); }
+}
