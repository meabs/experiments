+	private void refreshTierPrices(ShoppingCart cart, MerchantStore store) throws ServiceException {
+		for (ShoppingCartItem item : cart.getLineItems()) {
+			Product product = item.getProduct();
+			if (product == null || item.getQuantity() == null) continue;
+			List<ProductAttribute> attributes = new ArrayList<ProductAttribute>();
+			if (item.getAttributes() != null) for (ShoppingCartAttributeItem attribute : item.getAttributes()) if (attribute.getProductAttribute() != null) attributes.add(attribute.getProductAttribute());
