+			item.setItemPrice(productTierService.priceFor(product, store, item.getQuantity(), fallback.getFinalPrice()));
+			item.setSubTotal(item.getItemPrice().multiply(new java.math.BigDecimal(item.getQuantity())));
+		}
+	}
