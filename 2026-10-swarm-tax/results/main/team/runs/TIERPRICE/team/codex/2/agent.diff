+package com.salesmanager.core.business.services.catalog.product;
+import java.math.BigDecimal;
+import java.util.Collections;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.ProductTierRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("productTierService")
+public class ProductTierServiceImpl implements ProductTierService {
+    @Inject private ProductTierRepository repository;
+    private void own(Product p, MerchantStore s) throws ServiceException {
+        if (p == null || s == null || p.getMerchantStore() == null || !s.getId().equals(p.getMerchantStore().getId())) throw new ServiceException("Product does not belong to store");
+    }
+    @Override @Transactional(readOnly=true) public List<ProductTier> list(Product p, MerchantStore s) throws ServiceException { own(p,s); return repository.findByProductIdOrderByMinQuantityAsc(p.getId()); }
+    @Override @Transactional public void replace(Product p, MerchantStore s, List<ProductTier> tiers) throws ServiceException { own(p,s); repository.deleteByProductId(p.getId()); if (tiers != null) for (ProductTier t: tiers) { t.setId(null); t.setProduct(p); repository.save(t); } }
+    @Override @Transactional(readOnly=true) public BigDecimal priceFor(Product p, MerchantStore s, int quantity, BigDecimal fallback) throws ServiceException { own(p,s); BigDecimal result=fallback; for(ProductTier t: repository.findByProductIdOrderByMinQuantityAsc(p.getId())) if(quantity >= t.getMinQuantity()) result=t.getPrice(); return result; }
+}
