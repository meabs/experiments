+package com.salesmanager.core.business.services.catalog.product;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.catalog.product.ProductPriceTierRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductPriceTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("productPriceTierService")
+public class ProductPriceTierServiceImpl implements ProductPriceTierService {
+ @Inject private ProductPriceTierRepository repository;
+ public List<ProductPriceTier> findByProduct(Product p, MerchantStore s){
+  if (p == null || p.getMerchantStore() == null || s == null || !p.getMerchantStore().getId().equals(s.getId())) return java.util.Collections.emptyList();
+  return repository.findByProductIdOrderByMinQuantityAsc(p.getId());
+ }
+ @Transactional public void replace(Product p, MerchantStore s, List<ProductPriceTier> tiers){
+  if (p == null || p.getMerchantStore() == null || s == null || !p.getMerchantStore().getId().equals(s.getId())) throw new IllegalArgumentException("Product does not belong to store");
+  repository.deleteByProductId(p.getId()); for(ProductPriceTier t:tiers){t.setProduct(p); repository.save(t);}
+ }
+}
