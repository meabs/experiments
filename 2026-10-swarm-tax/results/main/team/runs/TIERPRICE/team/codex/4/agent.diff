+package com.salesmanager.core.model.catalog.product;
+
+import java.math.BigDecimal;
+import javax.persistence.*;
+
+@Entity
+@Table(name="PRODUCT_PRICE_TIER", uniqueConstraints=@UniqueConstraint(columnNames={"PRODUCT_ID","MIN_QUANTITY"}))
+public class ProductPriceTier {
+    @Id @GeneratedValue(strategy=GenerationType.TABLE, generator="TABLE_GEN")
+    @TableGenerator(name="TABLE_GEN", table="SM_SEQUENCER", pkColumnName="SEQ_NAME", valueColumnName="SEQ_COUNT", pkColumnValue="PRODUCT_PRICE_TIER_SEQ_NEXT_VAL")
+    @Column(name="TIER_ID") private Long id;
+    @ManyToOne(fetch=FetchType.LAZY, optional=false) @JoinColumn(name="PRODUCT_ID", nullable=false)
+    private Product product;
+    @Column(name="MIN_QUANTITY", nullable=false) private Integer minQuantity;
+    @Column(name="PRICE", nullable=false, precision=19, scale=4) private BigDecimal price;
+    public Long getId(){return id;} public void setId(Long id){this.id=id;}
+    public Product getProduct(){return product;} public void setProduct(Product p){this.product=p;}
+    public Integer getMinQuantity(){return minQuantity;} public void setMinQuantity(Integer n){this.minQuantity=n;}
+    public BigDecimal getPrice(){return price;} public void setPrice(BigDecimal p){this.price=p;}
+}
