+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.Date;
+import java.util.List;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestMethod;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductAnswerRequest;
+import com.salesmanager.shop.model.catalog.product.ProductQuestionRequest;
+import com.salesmanager.shop.model.catalog.product.PublicProductQuestion;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestionList;
+import com.salesmanager.shop.store.api.exception.ConflictException;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+    private static final int MIN_TEXT = 10;
+    @Inject private ProductService productService;
+    @Inject private ProductQuestionService questionService;
+    @Inject private CustomerFacade customerFacade;
+
+    @RequestMapping(value = "/auth/products/{sku}/questions", method = RequestMethod.POST)
+    @ResponseStatus(HttpStatus.CREATED)
+    public ReadableProductQuestion ask(@PathVariable String sku, @RequestBody ProductQuestionRequest request,
+            @ApiIgnore MerchantStore store, HttpServletRequest servletRequest) throws ServiceException {
+        Product product = productService.getBySku(sku, store);
+        if (product == null) throw new ResourceNotFoundException("Product sku " + sku + " does not exist");
+        String text = trim(request == null ? null : request.getText());
+        requireLength(text, MIN_TEXT, 500, "Question text must be between 10 and 500 characters");
+        Customer customer = currentCustomer(servletRequest, store);
+        if (questionService.countPendingByCustomer(customer.getId()) >= 3)
+            throw new RestApiException("400", "A customer can have at most 3 pending questions");
+        ProductQuestion question = new ProductQuestion();
+        question.setProduct(product); question.setCustomer(customer); question.setText(text);
+        question.setStatus(ProductQuestionStatus.PENDING); question.setAskedAt(new Date());
+        questionService.create(question);
+        return ReadableProductQuestion.from(question);
+    }
+
+    @RequestMapping(value = "/auth/customer/questions", method = RequestMethod.GET)
+    public List<ReadableProductQuestion> mine(HttpServletRequest request, @ApiIgnore MerchantStore store) {
+        Customer customer = currentCustomer(request, store);
+        return questionService.findByCustomer(customer.getId()).stream().map(ReadableProductQuestion::from).collect(Collectors.toList());
+    }
+
+    @RequestMapping(value = "/products/{sku}/questions", method = RequestMethod.GET)
+    public ReadableProductQuestionList published(@PathVariable String sku, @ApiIgnore MerchantStore store) throws ServiceException {
+        Product product = productService.getBySku(sku, store);
+        if (product == null) throw new ResourceNotFoundException("Product sku " + sku + " does not exist");
+        List<PublicProductQuestion> items = questionService.findPublishedByProduct(product.getId()).stream().map(ReadableProductQuestion::from)
+                .map(PublicProductQuestion::new).collect(Collectors.toList());
+        return new ReadableProductQuestionList(items);
+    }
+
+    @RequestMapping(value = "/private/questions", method = RequestMethod.GET)
+    public List<ReadableProductQuestion> adminList(@RequestParam(defaultValue = "PENDING") String status,
+            @ApiIgnore MerchantStore store) {
+        ProductQuestionStatus parsed = parseStatus(status);
+        return questionService.findByStoreAndStatus(store.getId(), parsed).stream().map(ReadableProductQuestion::from).collect(Collectors.toList());
+    }
+
+    @RequestMapping(value = "/private/questions/{id}/answer", method = RequestMethod.PUT)
+    public ReadableProductQuestion answer(@PathVariable Long id, @RequestBody ProductAnswerRequest request, @ApiIgnore MerchantStore store) throws ServiceException {
+        ProductQuestion question = findAdminQuestion(id, store);
+        if (question.getStatus() == ProductQuestionStatus.REJECTED) throw new ConflictException("A rejected question cannot be answered");
+        String answer = trim(request == null ? null : request.getAnswer());
+        requireLength(answer, 1, 2000, "Answer must be between 1 and 2000 characters");
+        question.setAnswer(answer); question.setStatus(ProductQuestionStatus.PUBLISHED); question.setAnsweredAt(new Date());
