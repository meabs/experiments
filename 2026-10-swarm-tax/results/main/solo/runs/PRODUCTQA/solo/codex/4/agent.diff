+package com.salesmanager.shop.model.catalog.product;
+
+import java.text.SimpleDateFormat;
+import java.util.Date;
+
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+
+public class ReadableProductQuestion {
+    private Long id;
+    private String sku;
+    private String text;
+    private String status;
+    private String answer;
+    private String askedBy;
+    private String askedAt;
+    private String answeredAt;
+
+    public static ReadableProductQuestion from(ProductQuestion source) {
+        ReadableProductQuestion result = new ReadableProductQuestion();
+        result.id = source.getId();
+        result.sku = source.getProduct().getSku();
+        result.text = source.getText();
+        result.status = source.getStatus().name();
+        result.answer = source.getAnswer();
+        result.askedBy = source.getCustomer().getBilling() == null ? null : source.getCustomer().getBilling().getFirstName();
+        result.askedAt = format(source.getAskedAt());
+        result.answeredAt = format(source.getAnsweredAt());
+        return result;
+    }
+
+    private static String format(Date value) {
+        return value == null ? null : new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSSXXX").format(value);
+    }
+    public Long getId() { return id; }
+    public String getSku() { return sku; }
+    public String getText() { return text; }
+    public String getStatus() { return status; }
+    public String getAnswer() { return answer; }
+    public String getAskedBy() { return askedBy; }
+    public String getAskedAt() { return askedAt; }
+    public String getAnsweredAt() { return answeredAt; }
+}
