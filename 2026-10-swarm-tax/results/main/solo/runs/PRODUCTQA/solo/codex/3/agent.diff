+package com.salesmanager.core.business.services.catalog.product.question;
+
+import java.util.Date;
+import java.util.List;
+import java.util.Optional;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long, ProductQuestion>
+        implements ProductQuestionService {
+    private final ProductQuestionRepository repository;
+
+    @Inject
+    public ProductQuestionServiceImpl(ProductQuestionRepository repository) {
+        super(repository);
+        this.repository = repository;
+    }
+
+    @Override
+    public ProductQuestion ask(Product product, Customer customer, String text) {
+        ProductQuestion question = new ProductQuestion();
+        question.setProduct(product);
+        question.setCustomer(customer);
+        question.setText(text);
+        question.setStatus(ProductQuestionStatus.PENDING);
+        question.setAskedAt(new Date());
+        repository.saveAndFlush(question);
+        return question;
+    }
+
+    public List<ProductQuestion> findByCustomer(Customer customer) { return repository.findByCustomerIdOrderByAskedAtDesc(customer.getId()); }
+    public List<ProductQuestion> findPublished(Product product) { return repository.findByProductIdAndStatusOrderByAnsweredAtDesc(product.getId(), ProductQuestionStatus.PUBLISHED); }
+    public List<ProductQuestion> findByStoreAndStatus(MerchantStore store, ProductQuestionStatus status) { return repository.findByProductMerchantStoreIdAndStatusOrderByAskedAtAsc(store.getId(), status); }
+    public long countPending(Customer customer) { return repository.countByCustomerIdAndStatus(customer.getId(), ProductQuestionStatus.PENDING); }
+    public Optional<ProductQuestion> findById(Long id) { return repository.findById(id); }
+}
