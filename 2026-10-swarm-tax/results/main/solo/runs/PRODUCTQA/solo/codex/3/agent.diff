@@ -0,0 +1,175 @@
+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.stream.Collectors;
+import java.util.stream.Stream;
+
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.model.catalog.product.ProductAnswerRequest;
+import com.salesmanager.shop.model.catalog.product.ProductQuestionRequest;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestionList;
+import com.salesmanager.shop.model.catalog.product.ReadablePublicProductQuestion;
+import com.salesmanager.shop.store.api.exception.ConflictException;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.api.exception.UnauthorizedException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.user.facade.UserFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+    private static final int MIN_TEXT = 10;
+    private static final int MAX_TEXT = 500;
+    private static final int MAX_ANSWER = 2000;
+
+    @Inject private ProductService productService;
+    @Inject private ProductQuestionService questionService;
+    @Inject private CustomerFacade customerFacade;
+    @Inject private UserFacade userFacade;
+
+    @PostMapping("/auth/products/{sku}/questions")
+    @ResponseStatus(HttpStatus.CREATED)
+    public ReadableProductQuestion ask(@PathVariable String sku, @RequestBody ProductQuestionRequest request,
+            @ApiIgnore MerchantStore store, HttpServletRequest httpRequest) {
+        Customer customer = currentCustomer(store, httpRequest);
+        Product product = product(sku, store);
+        String text = trimmed(request == null ? null : request.getText());
+        validateLength(text, MIN_TEXT, MAX_TEXT, "Question");
+        if (questionService.countPending(customer) >= 3) {
+            throw new RestApiException("400", "A customer may have at most 3 pending questions");
+        }
+        return map(questionService.ask(product, customer, text));
+    }
+
+    @GetMapping("/auth/customer/questions")
+    public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store, HttpServletRequest request) {
+        Customer customer = currentCustomer(store, request);
+        return questionService.findByCustomer(customer).stream().map(this::map).collect(Collectors.toList());
+    }
+
+    @GetMapping("/products/{sku}/questions")
+    public ReadableProductQuestionList published(@PathVariable String sku, @ApiIgnore MerchantStore store) {
+        Product product = product(sku, store);
+        List<ReadablePublicProductQuestion> items = questionService.findPublished(product).stream().map(this::mapPublic).collect(Collectors.toList());
+        return new ReadableProductQuestionList(items);
+    }
+
+    @GetMapping("/private/questions")
+    public List<ReadableProductQuestion> adminList(@RequestParam(value = "status", defaultValue = "PENDING") String status,
+            @ApiIgnore MerchantStore store) {
+        ProductQuestionStatus parsed = parseStatus(status);
+        authorizeAdmin();
+        return questionService.findByStoreAndStatus(store, parsed).stream().map(this::map).collect(Collectors.toList());
+    }
+
+    @PutMapping("/private/questions/{id}/answer")
+    public ReadableProductQuestion answer(@PathVariable Long id, @RequestBody ProductAnswerRequest request,
+            @ApiIgnore MerchantStore store) {
+        authorizeAdmin();
+        ProductQuestion question = question(id, store);
+        if (question.getStatus() == ProductQuestionStatus.REJECTED) throw new ConflictException("A rejected question cannot be answered");
+        String answer = trimmed(request == null ? null : request.getAnswer());
+        validateLength(answer, 1, MAX_ANSWER, "Answer");
+        question.setAnswer(answer);
+        question.setStatus(ProductQuestionStatus.PUBLISHED);
+        question.setAnsweredAt(new java.util.Date());
+        save(question);
+        return map(question);
+    }
+
+    @PutMapping("/private/questions/{id}/reject")
+    public ReadableProductQuestion reject(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        authorizeAdmin();
+        ProductQuestion question = question(id, store);
+        question.setStatus(ProductQuestionStatus.REJECTED);
+        save(question);
+        return map(question);
+    }
+
+    private Customer currentCustomer(MerchantStore store, HttpServletRequest request) {
+        Principal principal = request.getUserPrincipal();
+        if (principal == null) throw new UnauthorizedException();
+        Customer customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (customer == null) throw new UnauthorizedException();
+        return customer;
+    }
+
+    private void authorizeAdmin() {
+        String user = userFacade.authenticatedUser();
+        if (user == null) throw new UnauthorizedException();
+        userFacade.authorizedGroup(user, Stream.of(Constants.GROUP_SUPERADMIN, Constants.GROUP_ADMIN, Constants.GROUP_ADMIN_RETAIL).collect(Collectors.toList()));
+    }
+
+    private Product product(String sku, MerchantStore store) {
+        try {
+            Product product = productService.getBySku(sku, store);
