+package com.salesmanager.core.business.services.catalog.product.question;
+
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.repositories.catalog.product.ProductQuestionRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl implements ProductQuestionService {
+    private final ProductQuestionRepository repository;
+
+    @Inject
+    public ProductQuestionServiceImpl(ProductQuestionRepository repository) { this.repository = repository; }
+
+    @Override public ProductQuestion create(String sku, String text, Product product, Customer customer) {
+        ProductQuestion question = new ProductQuestion();
+        question.setSku(sku); question.setText(text); question.setProduct(product); question.setCustomer(customer);
+        question.setStatus(ProductQuestionStatus.PENDING);
+        return repository.saveAndFlush(question);
+    }
+    @Override public List<ProductQuestion> findByCustomer(Customer c, MerchantStore s) { return repository.findByCustomerAndStore(c.getId(), s.getId()); }
+    @Override public List<ProductQuestion> findByStore(MerchantStore s, ProductQuestionStatus status) { return repository.findByStoreAndStatus(s.getId(), status); }
+    @Override public List<ProductQuestion> findPublished(Product p) { return repository.findPublishedByProduct(p.getId()); }
+    @Override public ProductQuestion findById(Long id, MerchantStore s) { return repository.findByIdAndStore(id, s.getId()); }
+    @Override public ProductQuestion save(ProductQuestion q) { return repository.saveAndFlush(q); }
+    @Override public long countPending(Customer c) { return repository.countByCustomerIdAndStatus(c.getId(), ProductQuestionStatus.PENDING); }
+}
