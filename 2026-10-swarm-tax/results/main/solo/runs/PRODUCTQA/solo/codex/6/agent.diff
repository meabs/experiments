+package com.salesmanager.core.business.repositories.catalog.product;
+
+import java.util.List;
+
+import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Query;
+
+import com.salesmanager.core.model.catalog.product.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.ProductQuestionStatus;
+
+public interface ProductQuestionRepository extends JpaRepository<ProductQuestion, Long> {
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch q.customer c where q.id = ?1 and p.merchantStore.id = ?2")
+    ProductQuestion findByIdAndStore(Long id, Integer storeId);
+
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch q.customer c where c.id = ?1 and p.merchantStore.id = ?2 order by q.askedAt desc, q.id desc")
+    List<ProductQuestion> findByCustomerAndStore(Long customerId, Integer storeId);
+
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch q.customer c where p.merchantStore.id = ?1 and q.status = ?2 order by q.askedAt asc, q.id asc")
+    List<ProductQuestion> findByStoreAndStatus(Integer storeId, ProductQuestionStatus status);
+
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch q.customer c where p.id = ?1 and q.status = com.salesmanager.core.model.catalog.product.ProductQuestionStatus.PUBLISHED order by q.answeredAt desc, q.id desc")
+    List<ProductQuestion> findPublishedByProduct(Long productId);
+
+    @Query("select count(q) from ProductQuestion q where q.customer.id = ?1 and q.status = ?2")
+    long countByCustomerIdAndStatus(Long customerId, ProductQuestionStatus status);
+}
