+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.Arrays;
+import java.util.List;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.security.core.Authentication;
+import org.springframework.security.core.context.SecurityContextHolder;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.model.catalog.product.ProductAnswerRequest;
+import com.salesmanager.shop.model.catalog.product.ProductQuestionRequest;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestionList;
+import com.salesmanager.shop.model.catalog.product.ReadablePublishedProductQuestion;
+import com.salesmanager.shop.store.api.exception.GenericRuntimeException;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.UnauthorizedException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.user.facade.UserFacade;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+    @Inject private ProductService productService;
+    @Inject private ProductQuestionService questionService;
+    @Inject private CustomerFacade customerFacade;
+    @Inject private UserFacade userFacade;
+
+    @PostMapping("/auth/products/{sku}/questions")
+    @ResponseStatus(HttpStatus.CREATED)
+    public ReadableProductQuestion ask(@PathVariable String sku, @RequestBody ProductQuestionRequest request,
+            @ApiIgnore MerchantStore store) {
+        Customer customer = currentCustomer(store);
+        Product product = product(sku, store);
+        String text = trim(request == null ? null : request.getText());
+        if (text == null || text.length() < 10 || text.length() > 500) bad("Question must be between 10 and 500 characters");
+        if (questionService.countPending(customer) >= 3) bad("A customer may have at most 3 pending questions");
+        return read(questionService.create(sku, text, product, customer));
+    }
+
+    @GetMapping("/auth/customer/questions")
+    public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store) {
+        Customer customer = currentCustomer(store);
+        return questionService.findByCustomer(customer, store).stream().map(this::read).collect(Collectors.toList());
+    }
+
+    @GetMapping("/products/{sku}/questions")
+    public ReadableProductQuestionList published(@PathVariable String sku, @ApiIgnore MerchantStore store) {
+        Product product = product(sku, store);
+        List<ReadablePublishedProductQuestion> items = questionService.findPublished(product).stream().map(this::publicRead).collect(Collectors.toList());
+        return new ReadableProductQuestionList(items);
+    }
+
+    @GetMapping("/private/questions")
+    public List<ReadableProductQuestion> adminList(@RequestParam(defaultValue = "PENDING") String status, @ApiIgnore MerchantStore store) {
+        authorizeAdmin();
+        ProductQuestionStatus parsed;
+        try { parsed = ProductQuestionStatus.valueOf(status); } catch (Exception e) { bad("Invalid question status"); return null; }
+        return questionService.findByStore(store, parsed).stream().map(this::read).collect(Collectors.toList());
+    }
+
+    @PutMapping("/private/questions/{id}/answer")
+    public ReadableProductQuestion answer(@PathVariable Long id, @RequestBody ProductAnswerRequest request, @ApiIgnore MerchantStore store) {
+        authorizeAdmin(); ProductQuestion question = question(id, store);
+        if (question.getStatus() == ProductQuestionStatus.REJECTED) throw new GenericRuntimeException("409", "Rejected questions cannot be answered");
+        String answer = trim(request == null ? null : request.getAnswer());
+        if (answer == null || answer.length() < 1 || answer.length() > 2000) bad("Answer must be between 1 and 2000 characters");
+        question.setAnswer(answer); question.setStatus(ProductQuestionStatus.PUBLISHED); question.setAnsweredAt(new java.util.Date());
+        return read(questionService.save(question));
+    }
+
+    @PutMapping("/private/questions/{id}/reject")
+    public ReadableProductQuestion reject(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        authorizeAdmin(); ProductQuestion question = question(id, store);
+        question.setStatus(ProductQuestionStatus.REJECTED);
+        return read(questionService.save(question));
+    }
+
+    private Product product(String sku, MerchantStore store) {
+        try { Product p = productService.getBySku(sku, store); if (p == null) throw new ResourceNotFoundException("Unknown product sku " + sku); return p; }
+        catch (ResourceNotFoundException e) { throw e; } catch (Exception e) { throw new ResourceNotFoundException("Unknown product sku " + sku); }
+    }
+    private ProductQuestion question(Long id, MerchantStore store) { ProductQuestion q = questionService.findById(id, store); if (q == null) throw new ResourceNotFoundException("Unknown question id " + id); return q; }
+    private Customer currentCustomer(MerchantStore store) {
+        Authentication a = SecurityContextHolder.getContext().getAuthentication();
+        if (a == null || !a.isAuthenticated() || a.getName() == null || "anonymousUser".equals(a.getName())) throw new UnauthorizedException();
+        Customer c = customerFacade.getCustomerByUserName(a.getName(), store); if (c == null) throw new UnauthorizedException(); return c;
+    }
+    private void authorizeAdmin() { String user = userFacade.authenticatedUser(); if (user == null) throw new UnauthorizedException(); userFacade.authorizedGroup(user, Arrays.asList(Constants.GROUP_SUPERADMIN, Constants.GROUP_ADMIN, Constants.GROUP_ADMIN_RETAIL)); }
+    private static String trim(String value) { return value == null ? null : value.trim(); }
