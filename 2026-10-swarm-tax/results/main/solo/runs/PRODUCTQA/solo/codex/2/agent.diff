+package com.salesmanager.core.business.services.catalog.product.question;
+
+import java.util.Date;
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long, ProductQuestion> implements ProductQuestionService {
+    private final ProductQuestionRepository repository;
+
+    @Inject
+    public ProductQuestionServiceImpl(ProductQuestionRepository repository) {
+        super(repository);
+        this.repository = repository;
+    }
+
+    @Override
+    public ProductQuestion ask(Product product, Customer customer, MerchantStore store, String text) {
+        ProductQuestion question = new ProductQuestion();
+        question.setProduct(product);
+        question.setCustomer(customer);
+        question.setMerchantStore(store);
+        question.setText(text);
+        question.setStatus(ProductQuestionStatus.PENDING);
+        question.setAskedAt(new Date());
+        return repository.saveAndFlush(question);
+    }
+
+    public List<ProductQuestion> listByCustomer(Customer customer, MerchantStore store) {
+        return repository.findByCustomerAndStore(customer.getId(), store.getId());
+    }
+    public List<ProductQuestion> listByProduct(Product product, ProductQuestionStatus status) {
+        return repository.findByProductAndStatus(product.getId(), status);
+    }
+    public List<ProductQuestion> listByStore(MerchantStore store, ProductQuestionStatus status) {
+        return repository.findByStoreAndStatus(store.getId(), status);
+    }
+    public ProductQuestion findById(Long id, MerchantStore store) {
+        return repository.findByIdAndStore(id, store.getId());
+    }
+    public long countPending(Customer customer, MerchantStore store) {
+        return repository.countByCustomerAndStoreAndStatus(customer.getId(), store.getId(), ProductQuestionStatus.PENDING);
+    }
+
+    @Override
+    public void update(ProductQuestion question) {
+        repository.saveAndFlush(question);
+    }
+}
