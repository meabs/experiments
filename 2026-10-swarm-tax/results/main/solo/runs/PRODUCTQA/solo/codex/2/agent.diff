+
+    @PostMapping("/auth/products/{sku}/questions")
+    @ResponseStatus(HttpStatus.CREATED)
+    public ReadableProductQuestion ask(@PathVariable String sku, @RequestBody ProductQuestionRequest request,
+            @ApiIgnore MerchantStore store, HttpServletRequest httpRequest) {
+        Customer customer = currentCustomer(httpRequest, store);
+        String text = requiredText(request == null ? null : request.getText(), 10, 500, "Question");
