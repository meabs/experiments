+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+
+public interface ProductQuestionRepository extends JpaRepository<ProductQuestion, Long> {
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch q.customer c join fetch q.merchantStore s where c.id = ?1 and s.id = ?2 order by q.askedAt desc, q.id desc")
+    List<ProductQuestion> findByCustomerAndStore(Long customerId, Integer storeId);
+
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch q.customer c join fetch q.merchantStore s where p.id = ?1 and q.status = ?2 order by q.answeredAt desc, q.id desc")
+    List<ProductQuestion> findByProductAndStatus(Long productId, ProductQuestionStatus status);
+
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch q.customer c join fetch q.merchantStore s where s.id = ?1 and q.status = ?2 order by q.askedAt asc, q.id asc")
+    List<ProductQuestion> findByStoreAndStatus(Integer storeId, ProductQuestionStatus status);
+
+    @Query("select count(q) from ProductQuestion q where q.customer.id = ?1 and q.merchantStore.id = ?2 and q.status = ?3")
+    long countByCustomerAndStoreAndStatus(Long customerId, Integer storeId, ProductQuestionStatus status);
+
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch q.customer c join fetch q.merchantStore s where q.id = ?1 and s.id = ?2")
+    ProductQuestion findByIdAndStore(Long id, Integer storeId);
