+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.Date;
+import java.util.List;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductQuestionAnswerRequest;
+import com.salesmanager.shop.model.catalog.product.ProductQuestionRequest;
+import com.salesmanager.shop.model.catalog.product.PublicProductQuestion;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestion;
+import com.salesmanager.shop.store.api.exception.ConflictException;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.utils.DateUtil;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+  @Inject private ProductService productService;
+  @Inject private ProductQuestionService questionService;
+  @Inject private CustomerService customerService;
+
+  @PostMapping("/auth/products/{sku}/questions")
+  @ResponseStatus(HttpStatus.CREATED)
+  public ReadableProductQuestion ask(@PathVariable String sku, @RequestBody ProductQuestionRequest request,
+      @ApiIgnore MerchantStore store, HttpServletRequest httpRequest) {
+    String text = request == null ? null : StringUtils.trimToNull(request.getText());
+    if (text == null || text.length() < 10 || text.length() > 500) throw bad("Question must be between 10 and 500 characters");
+    Product product = product(sku, store);
+    Principal principal = httpRequest.getUserPrincipal();
+    Customer customer = customerService.getByNick(principal.getName());
+    if (customer == null || !customer.getMerchantStore().getId().equals(store.getId())) throw new RestApiException("401", "Customer not authorized");
+    if (questionService.countPending(customer.getId(), store.getId()) >= 3) throw bad("A customer may have at most 3 pending questions");
+    ProductQuestion question = new ProductQuestion(); question.setProduct(product); question.setCustomer(customer); question.setText(text); question.setAskedAt(new Date());
+    return readable(questionService.save(question));
+  }
+
+  @GetMapping("/auth/customer/questions")
+  public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store, HttpServletRequest httpRequest) {
+    Customer customer = customerService.getByNick(httpRequest.getUserPrincipal().getName());
+    if (customer == null) throw new RestApiException("401", "Customer not authorized");
+    return questionService.findByCustomer(customer.getId(), store.getId()).stream().map(this::readable).collect(Collectors.toList());
+  }
+
+  @GetMapping("/products/{sku}/questions")
+  public QuestionList publicQuestions(@PathVariable String sku, @ApiIgnore MerchantStore store) {
+    Product product = product(sku, store);
+    List<PublicProductQuestion> items = questionService.findByProduct(product.getId()).stream().map(this::publicReadable).collect(Collectors.toList());
+    return new QuestionList(items);
+  }
+
+  @GetMapping("/private/questions")
+  public List<ReadableProductQuestion> adminList(@RequestParam(defaultValue="PENDING") String status, @ApiIgnore MerchantStore store) {
+    ProductQuestionStatus parsed = parseStatus(status);
+    return questionService.findByStore(store.getId(), parsed).stream().map(this::readable).collect(Collectors.toList());
+  }
+
+  @PutMapping("/private/questions/{id}/answer")
+  public ReadableProductQuestion answer(@PathVariable Long id, @RequestBody ProductQuestionAnswerRequest request, @ApiIgnore MerchantStore store) {
+    ProductQuestion question = question(id, store);
+    if (question.getStatus() == ProductQuestionStatus.REJECTED) throw new ConflictException("A rejected question cannot be answered");
+    String answer = request == null ? null : StringUtils.trimToNull(request.getAnswer());
+    if (answer == null || answer.length() < 1 || answer.length() > 2000) throw bad("Answer must be between 1 and 2000 characters");
+    question.setAnswer(answer); question.setStatus(ProductQuestionStatus.PUBLISHED); question.setAnsweredAt(new Date());
+    return readable(questionService.save(question));
+  }
+
+  @PutMapping("/private/questions/{id}/reject")
+  public ReadableProductQuestion reject(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+    ProductQuestion question = question(id, store); question.setStatus(ProductQuestionStatus.REJECTED); return readable(questionService.save(question));
+  }
+
+  private Product product(String sku, MerchantStore store) {
+    try { Product product = productService.getBySku(sku, store); if (product == null) throw new Exception(); return product; }
+    catch (Exception e) { throw new ResourceNotFoundException("Product with sku [" + sku + "] does not exist"); }
+  }
+  private ProductQuestion question(Long id, MerchantStore store) {
+    ProductQuestion question = questionService.getById(id);
+    if (question == null || question.getProduct() == null || !question.getProduct().getMerchantStore().getId().equals(store.getId())) throw new ResourceNotFoundException("Question [" + id + "] does not exist");
+    return question;
+  }
+  private ProductQuestionStatus parseStatus(String value) {
+    try { return ProductQuestionStatus.valueOf(value.toUpperCase()); } catch (Exception e) { throw bad("Invalid question status"); }
+  }
+  private RestApiException bad(String message) { return new RestApiException("400", message); }
+  private ReadableProductQuestion readable(ProductQuestion source) {
+    ReadableProductQuestion target = new ReadableProductQuestion(); target.setId(source.getId()); target.setSku(source.getProduct().getSku()); target.setText(source.getText()); target.setStatus(source.getStatus().name()); target.setAnswer(source.getAnswer());
+    target.setAskedBy(source.getCustomer().getBilling() == null ? null : source.getCustomer().getBilling().getFirstName()); target.setAskedAt(DateUtil.formatLongDate(source.getAskedAt())); target.setAnsweredAt(DateUtil.formatLongDate(source.getAnsweredAt())); return target;
+  }
+  private PublicProductQuestion publicReadable(ProductQuestion source) {
+    PublicProductQuestion target = new PublicProductQuestion(); target.setId(source.getId()); target.setText(source.getText()); target.setAnswer(source.getAnswer());
+    target.setAskedBy(source.getCustomer().getBilling() == null ? null : source.getCustomer().getBilling().getFirstName()); target.setAnsweredAt(DateUtil.formatLongDate(source.getAnsweredAt())); return target;
+  }
+  public static class QuestionList { private final int count; private final List<PublicProductQuestion> items; public QuestionList(List<PublicProductQuestion> items){this.items=items;this.count=items.size();} public int getCount(){return count;} public List<PublicProductQuestion> getItems(){return items;} }
+}
