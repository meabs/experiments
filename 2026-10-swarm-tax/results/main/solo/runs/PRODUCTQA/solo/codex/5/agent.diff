+package com.salesmanager.core.business.services.catalog.product.question;
+
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl implements ProductQuestionService {
+  @Inject private ProductQuestionRepository repository;
+  public ProductQuestion save(ProductQuestion question) { return repository.saveAndFlush(question); }
+  public ProductQuestion getById(Long id) { return repository.findById(id).orElse(null); }
+  public List<ProductQuestion> findByCustomer(Long customerId, Integer storeId) { return repository.findByCustomerIdAndProductMerchantStoreIdOrderByAskedAtDesc(customerId, storeId); }
+  public List<ProductQuestion> findByProduct(Long productId) { return repository.findByProductIdAndStatusOrderByAnsweredAtDesc(productId, ProductQuestionStatus.PUBLISHED); }
+  public List<ProductQuestion> findByStore(Integer storeId, ProductQuestionStatus status) { return repository.findByProductMerchantStoreIdAndStatusOrderByAskedAtAsc(storeId, status); }
+  public long countPending(Long customerId, Integer storeId) { return repository.countByCustomerIdAndProductMerchantStoreIdAndStatus(customerId, storeId, ProductQuestionStatus.PENDING); }
+}
