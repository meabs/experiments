+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.*;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.*;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.productquestion.*;
+import com.salesmanager.shop.store.api.exception.*;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+ @Inject private ProductService productService; @Inject private ProductQuestionService questionService; @Inject private CustomerFacade customerFacade;
+
+ @PostMapping("/auth/products/{sku}/questions") @ResponseStatus(HttpStatus.CREATED)
+ public ReadableProductQuestion ask(@PathVariable String sku, @RequestBody ProductQuestionRequest body, @ApiIgnore MerchantStore store, HttpServletRequest request){
+  String text=trim(body==null?null:body.getText()); validate(text,10,500,"Question");
+  Customer customer=customer(request,store); Product product=product(sku,store);
+  if(questionService.pendingByCustomer(customer.getId())>=3) throw new RestApiException("400","A customer may have at most 3 pending questions");
+  ProductQuestion q=new ProductQuestion(); q.setProduct(product); q.setCustomer(customer); q.setSku(sku); q.setText(text); save(q); return view(q);
+ }
+ @GetMapping("/auth/customer/questions") public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store,HttpServletRequest request){ Customer c=customer(request,store); List<ReadableProductQuestion> out=new ArrayList<>(); for(ProductQuestion q:questionService.byCustomer(c.getId())) out.add(view(q)); return out; }
+ @GetMapping("/products/{sku}/questions") public ReadableProductQuestionList published(@PathVariable String sku,@ApiIgnore MerchantStore store){ Product p=product(sku,store); List<PublicProductQuestion> out=new ArrayList<>(); for(ProductQuestion q:questionService.published(p.getId())) out.add(publicView(q)); ReadableProductQuestionList r=new ReadableProductQuestionList();r.setItems(out);r.setCount(out.size());return r; }
+ @GetMapping("/private/questions") public List<ReadableProductQuestion> adminList(@RequestParam(defaultValue="PENDING") String status,@ApiIgnore MerchantStore store){ ProductQuestionStatus s=status(status); List<ReadableProductQuestion> out=new ArrayList<>(); for(ProductQuestion q:questionService.byStore(store.getId(),s)) out.add(view(q)); return out; }
+ @PutMapping("/private/questions/{id}/answer") public ReadableProductQuestion answer(@PathVariable Long id,@RequestBody ProductQuestionAnswerRequest body,@ApiIgnore MerchantStore store){ ProductQuestion q=question(id,store); if(q.getStatus()==ProductQuestionStatus.REJECTED) throw new ConflictException("Rejected questions cannot be answered"); String a=trim(body==null?null:body.getAnswer());validate(a,1,2000,"Answer");q.setAnswer(a);q.setStatus(ProductQuestionStatus.PUBLISHED);q.setAnsweredAt(new Date());save(q);return view(q); }
+ @PutMapping("/private/questions/{id}/reject") public ReadableProductQuestion reject(@PathVariable Long id,@ApiIgnore MerchantStore store){ ProductQuestion q=question(id,store);q.setStatus(ProductQuestionStatus.REJECTED);save(q);return view(q); }
+ private void save(ProductQuestion q){try{questionService.save(q);}catch(Exception e){throw new RestApiException("400",e.getMessage(),e);}}
+ private Customer customer(HttpServletRequest r,MerchantStore s){Principal p=r.getUserPrincipal();if(p==null)throw new UnauthorizedException();Customer c=customerFacade.getCustomerByUserName(p.getName(),s);if(c==null)throw new UnauthorizedException();return c;}
+ private Product product(String sku,MerchantStore s){try{Product p=productService.getBySku(sku,s);if(p==null)throw new ResourceNotFoundException("Product ["+sku+"] not found");return p;}catch(ResourceNotFoundException e){throw e;}catch(Exception e){throw new ResourceNotFoundException("Product ["+sku+"] not found");}}
+ private ProductQuestion question(Long id,MerchantStore s){ProductQuestion q;try{q=questionService.getById(id);}catch(Exception e){throw new ResourceNotFoundException("Question ["+id+"] not found");}if(q==null||q.getProduct()==null||!q.getProduct().getMerchantStore().getId().equals(s.getId()))throw new ResourceNotFoundException("Question ["+id+"] not found");return q;}
+ private ProductQuestionStatus status(String s){try{return ProductQuestionStatus.valueOf(s);}catch(Exception e){throw new RestApiException("400","Invalid question status");}}
+ private String trim(String s){return s==null?null:s.trim();} private void validate(String s,int min,int max,String what){if(s==null||s.length()<min||s.length()>max)throw new RestApiException("400",what+" length must be between "+min+" and "+max);}
+ private ReadableProductQuestion view(ProductQuestion q){ReadableProductQuestion r=new ReadableProductQuestion();r.setId(q.getId());r.setSku(q.getSku());r.setText(q.getText());r.setStatus(q.getStatus().name());r.setAnswer(q.getAnswer());r.setAskedAt(q.getAskedAt());r.setAnsweredAt(q.getAnsweredAt());r.setAskedBy(q.getCustomer()!=null&&q.getCustomer().getBilling()!=null?q.getCustomer().getBilling().getFirstName():null);return r;}
+ private PublicProductQuestion publicView(ProductQuestion q){PublicProductQuestion r=new PublicProductQuestion();r.setId(q.getId());r.setText(q.getText());r.setAnswer(q.getAnswer());r.setAnsweredAt(q.getAnsweredAt());r.setAskedBy(q.getCustomer()!=null&&q.getCustomer().getBilling()!=null?q.getCustomer().getBilling().getFirstName():null);return r;}
+}
