+package com.salesmanager.core.model.catalog.product.question;
+
+import java.util.Date;
+import javax.persistence.*;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.generic.SalesManagerEntity;
+
+@Entity
+@Table(name = "PRODUCT_QUESTION")
+public class ProductQuestion extends SalesManagerEntity<Long, ProductQuestion> {
+    @Id @GeneratedValue(strategy = GenerationType.TABLE, generator = "TABLE_GEN")
+    @TableGenerator(name = "TABLE_GEN", table = "SM_SEQUENCER", pkColumnName = "SEQ_NAME", valueColumnName = "SEQ_COUNT", pkColumnValue = "PRODUCT_QUESTION_SEQ_NEXT_VAL")
+    @Column(name = "QUESTION_ID") private Long id;
+    @ManyToOne(fetch = FetchType.LAZY, optional = false) @JoinColumn(name = "PRODUCT_ID", nullable = false) private Product product;
+    @ManyToOne(fetch = FetchType.LAZY, optional = false) @JoinColumn(name = "CUSTOMER_ID", nullable = false) private Customer customer;
+    @Column(name = "SKU", nullable = false, length = 255) private String sku;
+    @Column(name = "QUESTION_TEXT", nullable = false, length = 500) private String text;
+    @Enumerated(EnumType.STRING) @Column(name = "STATUS", nullable = false, length = 20) private ProductQuestionStatus status = ProductQuestionStatus.PENDING;
+    @Column(name = "ANSWER", length = 2000) private String answer;
+    @Temporal(TemporalType.TIMESTAMP) @Column(name = "ASKED_AT", nullable = false) private Date askedAt = new Date();
+    @Temporal(TemporalType.TIMESTAMP) @Column(name = "ANSWERED_AT") private Date answeredAt;
+    public Long getId(){return id;} public void setId(Long v){id=v;}
+    public Product getProduct(){return product;} public void setProduct(Product v){product=v;}
+    public Customer getCustomer(){return customer;} public void setCustomer(Customer v){customer=v;}
+    public String getSku(){return sku;} public void setSku(String v){sku=v;}
+    public String getText(){return text;} public void setText(String v){text=v;}
+    public ProductQuestionStatus getStatus(){return status;} public void setStatus(ProductQuestionStatus v){status=v;}
+    public String getAnswer(){return answer;} public void setAnswer(String v){answer=v;}
+    public Date getAskedAt(){return askedAt;} public void setAskedAt(Date v){askedAt=v;}
+    public Date getAnsweredAt(){return answeredAt;} public void setAnsweredAt(Date v){answeredAt=v;}
+}
