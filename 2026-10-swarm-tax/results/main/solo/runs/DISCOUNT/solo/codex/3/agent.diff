+package com.salesmanager.shop.store.api.v1.discount;
+
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.util.List;
+import java.util.Locale;
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.business.services.discount.DiscountService;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/discounts")
+public class DiscountApi {
+ @Inject private DiscountService discounts;
+ @Inject private CategoryService categories;
+
+ @GetMapping public ResponseEntity<?> list(@ApiIgnore MerchantStore store){return ResponseEntity.ok(discounts.list(store));}
+ @PostMapping public ResponseEntity<?> create(@RequestBody Discount input,@ApiIgnore MerchantStore store) throws Exception{
+   ResponseEntity<?> error=validate(input,store); if(error!=null)return error;
+   if(discounts.find(store,input.getCode()).isPresent()) return ResponseEntity.status(HttpStatus.CONFLICT).build();
+   input.setId(null); input.setMerchantStore(store); if(input.getStartDate()==null)input.setStartDate(LocalDate.now());
+   if(input.getCategories()==null)input.setCategories(new java.util.ArrayList<>()); return ResponseEntity.status(HttpStatus.CREATED).body(discounts.save(input));
+ }
+ @PutMapping("/{id}") public ResponseEntity<?> update(@PathVariable Long id,@RequestBody Discount input,@ApiIgnore MerchantStore store) throws Exception{
+   ResponseEntity<?> error=validate(input,store); if(error!=null)return error;
+   java.util.Optional<Discount> old=discounts.find(store,id); if(old.isEmpty())return ResponseEntity.notFound().build();
+   java.util.Optional<Discount> same=discounts.find(store,input.getCode()); if(same.isPresent()&&!same.get().getId().equals(id))return ResponseEntity.status(HttpStatus.CONFLICT).build();
+   input.setId(id); input.setMerchantStore(store); if(input.getStartDate()==null)input.setStartDate(LocalDate.now()); return ResponseEntity.ok(discounts.save(input));
+ }
+ @DeleteMapping("/{id}") public ResponseEntity<?> delete(@PathVariable Long id,@ApiIgnore MerchantStore store){
+   java.util.Optional<Discount> d=discounts.find(store,id); if(d.isEmpty())return ResponseEntity.notFound().build(); discounts.delete(d.get()); return ResponseEntity.noContent().build();
+ }
+ private ResponseEntity<?> validate(Discount d,MerchantStore store) throws Exception{
+   if(d==null||d.getCode()==null||d.getCode().trim().isEmpty()||d.getValue()==null||d.getType()==null)return ResponseEntity.badRequest().build();
+   if(d.getType()==DiscountType.PERCENT&&(d.getValue().compareTo(BigDecimal.ZERO)<=0||d.getValue().compareTo(new BigDecimal("100"))>0))return ResponseEntity.badRequest().build();
+   if(d.getType()==DiscountType.AMOUNT&&d.getValue().compareTo(BigDecimal.ZERO)<=0)return ResponseEntity.badRequest().build();
+   if(d.getStartDate()!=null&&d.getEndDate()!=null&&d.getEndDate().isBefore(d.getStartDate()))return ResponseEntity.badRequest().build();
+   if(d.getCategories()!=null)for(String c:d.getCategories())if(c==null||categories.getByCode(store,c)==null)return ResponseEntity.badRequest().build();
+   return null;
+ }
+}
