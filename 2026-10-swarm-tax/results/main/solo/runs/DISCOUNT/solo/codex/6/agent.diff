+package com.salesmanager.shop.store.api.v1.discount;
+import java.time.LocalDate; import java.util.List; import java.util.stream.Stream; import javax.inject.Inject;
+import org.springframework.http.HttpStatus; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.discount.DiscountService; import com.salesmanager.core.business.services.discount.DiscountServiceImpl.DiscountConflictException; import com.salesmanager.core.model.discount.Discount; import com.salesmanager.core.model.discount.DiscountType; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.constants.Constants; import com.salesmanager.shop.model.discount.DiscountData; import com.salesmanager.shop.store.api.exception.ServiceRuntimeException; import com.salesmanager.shop.store.api.exception.UnauthorizedException; import com.salesmanager.shop.store.api.exception.ConflictException; import com.salesmanager.shop.store.controller.user.facade.UserFacade; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/discounts") public class DiscountApi {
+ @Inject private DiscountService service; @Inject private UserFacade users;
+ private void auth(MerchantStore s){String u=users.authenticatedUser();if(u==null)throw new UnauthorizedException();users.authorizedGroup(u,Stream.of(Constants.GROUP_SUPERADMIN,Constants.GROUP_ADMIN,Constants.GROUP_ADMIN_RETAIL).collect(java.util.stream.Collectors.toList()));if(!users.userInRoles(u,java.util.Arrays.asList(Constants.GROUP_SUPERADMIN))&&!users.authorizedStore(u,s.getCode()))throw new UnauthorizedException();}
+ private Discount convert(DiscountData x,MerchantStore s){try{Discount d=new Discount();d.setCode(x.getCode());d.setType(DiscountType.valueOf(x.getType()==null?"":x.getType().toUpperCase()));d.setValue(x.getValue());d.setMinimumSubtotal(x.getMinimumSubtotal());d.setStartDate(x.getStartDate()==null?LocalDate.now():LocalDate.parse(x.getStartDate()));d.setEndDate(x.getEndDate()==null?null:LocalDate.parse(x.getEndDate()));d.setCategories(x.getCategories());d.setActive(x.getActive()==null||x.getActive());return d;}catch(Exception e){throw new ServiceRuntimeException("400",e.getMessage());}}
+ private DiscountData view(Discount d){DiscountData x=new DiscountData();x.setId(d.getId());x.setCode(d.getCode());x.setType(d.getType().name());x.setValue(d.getValue());x.setMinimumSubtotal(d.getMinimumSubtotal());x.setStartDate(d.getStartDate().toString());x.setEndDate(d.getEndDate()==null?null:d.getEndDate().toString());x.setCategories(d.getCategories());x.setActive(d.isActive());return x;}
+ @PostMapping @ResponseStatus(HttpStatus.CREATED) public DiscountData create(@RequestBody DiscountData x,@ApiIgnore MerchantStore s){auth(s);try{return view(service.create(convert(x,s),s));}catch(DiscountConflictException e){throw new ConflictException("discount code already exists");}catch(IllegalArgumentException e){throw new ServiceRuntimeException("400",e.getMessage());}}
+ @GetMapping public List<DiscountData> list(@ApiIgnore MerchantStore s){auth(s);return service.list(s).stream().map(this::view).collect(java.util.stream.Collectors.toList());}
+ @PutMapping("/{id}") public DiscountData update(@PathVariable Long id,@RequestBody DiscountData x,@ApiIgnore MerchantStore s){auth(s);try{return view(service.update(id,convert(x,s),s));}catch(DiscountConflictException e){throw new ConflictException("discount code already exists");}catch(IllegalArgumentException e){throw new ServiceRuntimeException("400",e.getMessage());}}
+ @DeleteMapping("/{id}") @ResponseStatus(HttpStatus.NO_CONTENT) public void delete(@PathVariable Long id,@ApiIgnore MerchantStore s){auth(s);try{service.delete(id,s);}catch(IllegalArgumentException e){throw new ServiceRuntimeException("404",e.getMessage());}}
+}
