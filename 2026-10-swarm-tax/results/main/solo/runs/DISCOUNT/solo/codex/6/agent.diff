+package com.salesmanager.core.business.services.discount;
+import java.math.BigDecimal; import java.math.RoundingMode; import java.time.LocalDate; import java.util.List; import java.util.Locale;
+import javax.inject.Inject; import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.category.CategoryRepository; import com.salesmanager.core.business.repositories.discount.DiscountRepository; import com.salesmanager.core.model.catalog.category.Category; import com.salesmanager.core.model.discount.Discount; import com.salesmanager.core.model.discount.DiscountType; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.shoppingcart.ShoppingCart; import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+@Service("discountService") public class DiscountServiceImpl implements DiscountService {
+ @Inject private DiscountRepository repo; @Inject private CategoryRepository categories;
+ private void validate(Discount d, MerchantStore s){
+  if(d.getCode()==null||d.getCode().trim().isEmpty()||d.getValue()==null||d.getType()==null) throw new IllegalArgumentException("code, type and value are required");
+  if(d.getType()==DiscountType.PERCENT && (d.getValue().signum()<=0||d.getValue().compareTo(new BigDecimal("100"))>0)) throw new IllegalArgumentException("percent must be > 0 and <= 100");
+  if(d.getType()==DiscountType.AMOUNT && d.getValue().signum()<=0) throw new IllegalArgumentException("amount must be > 0");
+  if(d.getStartDate()==null)d.setStartDate(LocalDate.now()); if(d.getEndDate()!=null&&d.getEndDate().isBefore(d.getStartDate()))throw new IllegalArgumentException("endDate must not precede startDate");
+  if(d.getCategories()!=null) for(String c:d.getCategories()) if(categories.findByCode(s.getId(),c)==null) throw new IllegalArgumentException("unknown category: "+c);
+  d.setCode(d.getCode().trim()); d.setMerchantStore(s); d.setCategories(d.getCategories());
+ }
+ private void unique(Discount d, MerchantStore s){Discount old=repo.findByMerchantStoreIdAndCodeIgnoreCase(s.getId(),d.getCode()); if(old!=null&&!old.getId().equals(d.getId()))throw new DiscountConflictException();}
+ public Discount create(Discount d,MerchantStore s){validate(d,s);unique(d,s);return repo.save(d);}
+ public Discount update(Long id,Discount d,MerchantStore s){Discount old=repo.findByIdAndMerchantStoreId(id,s.getId());if(old==null)throw new IllegalArgumentException("discount not found");d.setId(id);validate(d,s);unique(d,s);return repo.save(d);}
+ public List<Discount> list(MerchantStore s){return repo.findByMerchantStoreId(s.getId());}
+ public void delete(Long id,MerchantStore s){Discount d=repo.findByIdAndMerchantStoreId(id,s.getId());if(d==null)throw new IllegalArgumentException("discount not found");repo.delete(d);}
+ public Discount find(String code,MerchantStore s){return repo.findByMerchantStoreIdAndCodeIgnoreCase(s.getId(),code);}
+ public boolean applies(Discount d,ShoppingCart cart,LocalDate day){if(d==null||!d.isActive()||day.isBefore(d.getStartDate())||(d.getEndDate()!=null&&day.isAfter(d.getEndDate())))return false; BigDecimal subtotal=BigDecimal.ZERO,eligible=BigDecimal.ZERO;for(ShoppingCartItem i:cart.getLineItems()){BigDecimal x=i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity()));subtotal=subtotal.add(x);if(eligible(i,d))eligible=eligible.add(x);}return (d.getMinimumSubtotal()==null||subtotal.compareTo(d.getMinimumSubtotal())>=0)&&eligible.signum()>0;}
+ private boolean eligible(ShoppingCartItem i,Discount d){if(d.getCategories()==null||d.getCategories().isEmpty())return true;if(i.getProduct()==null||i.getProduct().getCategories()==null)return false;for(Category p:i.getProduct().getCategories())for(String wanted:d.getCategories()){Category root=categories.findByCode(d.getMerchantStore().getId(),wanted);if(root!=null&&p.getLineage()!=null&&p.getLineage().startsWith(root.getLineage()))return true;}return false;}
+ public BigDecimal calculate(Discount d,ShoppingCart cart,LocalDate day){if(!applies(d,cart,day))return BigDecimal.ZERO;BigDecimal eligible=BigDecimal.ZERO;for(ShoppingCartItem i:cart.getLineItems())if(eligible(i,d))eligible=eligible.add(i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity())));BigDecimal result=d.getType()==DiscountType.PERCENT?eligible.multiply(d.getValue()).divide(new BigDecimal("100"),8,RoundingMode.HALF_UP):d.getValue().min(eligible);return result.setScale(2,RoundingMode.HALF_UP);}
+ public static class DiscountConflictException extends RuntimeException {}
+}
