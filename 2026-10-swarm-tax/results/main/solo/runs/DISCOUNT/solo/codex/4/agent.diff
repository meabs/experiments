+package com.salesmanager.shop.store.api.v1.discount;
+import java.util.*; import java.util.stream.Collectors;
+import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import javax.inject.Inject;
+import com.salesmanager.core.business.services.discount.DiscountService; import com.salesmanager.core.model.discount.Discount; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.discount.DiscountEntity; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/discounts")
+public class DiscountApi {
+ @Inject private DiscountService service;
+ @PostMapping public ResponseEntity<?> create(@RequestBody DiscountEntity in,@ApiIgnore MerchantStore store){return write(in,null,store,HttpStatus.CREATED);}
+ @GetMapping public List<DiscountEntity> list(@ApiIgnore MerchantStore store){return service.list(store).stream().map(this::out).collect(Collectors.toList());}
+ @PutMapping("/{id}") public ResponseEntity<?> update(@PathVariable Long id,@RequestBody DiscountEntity in,@ApiIgnore MerchantStore store){return write(in,id,store,HttpStatus.OK);}
+ @DeleteMapping("/{id}") public ResponseEntity<?> delete(@PathVariable Long id,@ApiIgnore MerchantStore store){try{service.delete(id,store);return ResponseEntity.noContent().build();}catch(Exception e){return ResponseEntity.badRequest().body(e.getMessage());}}
+ private ResponseEntity<?> write(DiscountEntity in,Long id,MerchantStore s,HttpStatus status){try{Discount d=new Discount();d.setId(id);d.setCode(in.getCode());d.setType(in.getType());d.setValue(in.getValue());d.setMinimumSubtotal(in.getMinimumSubtotal());d.setStartDate(in.getStartDate());d.setEndDate(in.getEndDate());d.setCategories(in.getCategories());d.setActive(in.getActive()==null||in.getActive());return ResponseEntity.status(status).body(out(service.save(d,s)));}catch(IllegalStateException e){return ResponseEntity.status(HttpStatus.CONFLICT).body(e.getMessage());}catch(Exception e){return ResponseEntity.badRequest().body(e.getMessage());}}
+ private DiscountEntity out(Discount d){DiscountEntity x=new DiscountEntity();x.setId(d.getId());x.setCode(d.getCode());x.setType(d.getType());x.setValue(d.getValue());x.setMinimumSubtotal(d.getMinimumSubtotal());x.setStartDate(d.getStartDate());x.setEndDate(d.getEndDate());x.setCategories(d.getCategories());x.setActive(d.isActive());return x;}
+}
