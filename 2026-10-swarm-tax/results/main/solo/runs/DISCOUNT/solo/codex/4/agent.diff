+ public OrderTotal caculateProductPiceVariation(OrderSummary s,ShoppingCartItem item,Product product,Customer customer,MerchantStore store){if(s.getPromoCode()==null||s.getProducts()==null||s.getProducts().isEmpty()||s.getProducts().get(0)!=item)return null;Discount d=discounts.find(s.getPromoCode(),store);if(d==null)return null;java.time.LocalDate n=java.time.LocalDate.now();if(!d.isActive()||n.isBefore(d.getStartDate())||(d.getEndDate()!=null&&n.isAfter(d.getEndDate())))return null;BigDecimal sub=BigDecimal.ZERO;for(ShoppingCartItem i:s.getProducts())sub=sub.add(i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity())));if(d.getMinimumSubtotal()!=null&&sub.compareTo(d.getMinimumSubtotal())<0)return null;BigDecimal value=discounts.amount(d,s.getProducts());if(value.signum()==0)return null;OrderTotal t=new OrderTotal();t.setOrderTotalCode(Constants.OT_DISCOUNT_TITLE);t.setOrderTotalType(OrderTotalType.SUBTOTAL);t.setTitle(Constants.OT_SUBTOTAL_MODULE_CODE);t.setText(d.getCode());t.setValue(value);return t;}}
