+@Service public class DiscountService {
+ @Inject private DiscountRepository repository; @Inject private CategoryRepository categories;
+ public List<Discount> list(MerchantStore s){return repository.findByMerchantStoreId(s.getId());} public Discount find(String c,MerchantStore s){return repository.findByMerchantStoreIdAndCodeIgnoreCase(s.getId(),c).orElse(null);} public Discount get(Long i,MerchantStore s){return repository.findByIdAndMerchantStoreId(i,s.getId()).orElse(null);}
+ public Discount save(Discount d,MerchantStore s)throws ServiceException{validate(d,s);d.setMerchantStore(s);if(d.getId()!=null&&get(d.getId(),s)==null)throw new ServiceException("Discount not found");return repository.save(d);} public void delete(Long i,MerchantStore s)throws ServiceException{Discount d=get(i,s);if(d==null)throw new ServiceException("Discount not found");repository.delete(d);}
+ private void validate(Discount d,MerchantStore s)throws ServiceException{if(d.getCode()==null||d.getCode().trim().isEmpty()||d.getValue()==null||d.getType()==null)throw new ServiceException("Invalid discount");if((d.getType()==DiscountType.PERCENT&&(d.getValue().signum()<=0||d.getValue().compareTo(BigDecimal.valueOf(100))>0))||(d.getType()==DiscountType.AMOUNT&&d.getValue().signum()<=0))throw new ServiceException("Invalid discount value");if(d.getStartDate()==null)d.setStartDate(LocalDate.now());if(d.getEndDate()!=null&&d.getEndDate().isBefore(d.getStartDate()))throw new ServiceException("Invalid dates");if(d.getCategories()!=null)for(String c:d.getCategories())if(categories.findByCode(s.getId(),c)==null)throw new ServiceException("Unknown category");Optional<Discount>x=repository.findByMerchantStoreIdAndCodeIgnoreCase(s.getId(),d.getCode());if(x.isPresent()&&(d.getId()==null||!x.get().getId().equals(d.getId())))throw new IllegalStateException("Duplicate discount code");}
+ private boolean eligible(Product p,Discount d){if(d.getCategories()==null||d.getCategories().isEmpty())return true;return p.getCategories().stream().anyMatch(c->{for(com.salesmanager.core.model.catalog.category.Category x=c;x!=null;x=x.getParent())for(String wanted:d.getCategories())if(wanted.equalsIgnoreCase(x.getCode()))return true;return false;});}
+ public Discount findApplicable(String code,ShoppingCart cart,MerchantStore s){Discount d=find(code,s);if(d==null||!d.isActive())return null;LocalDate n=LocalDate.now();if(n.isBefore(d.getStartDate())||(d.getEndDate()!=null&&n.isAfter(d.getEndDate())))return null;BigDecimal sub=BigDecimal.ZERO,el=BigDecimal.ZERO;for(ShoppingCartItem i:cart.getLineItems()){BigDecimal v=i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity()));sub=sub.add(v);if(eligible(i.getProduct(),d))el=el.add(v);}if(d.getMinimumSubtotal()!=null&&sub.compareTo(d.getMinimumSubtotal())<0||el.signum()==0)return null;return d;}
+ public BigDecimal amount(Discount d,ShoppingCart c){return amount(d,new ArrayList<>(c.getLineItems()));} public BigDecimal amount(Discount d,List<ShoppingCartItem>is){BigDecimal e=BigDecimal.ZERO;for(ShoppingCartItem i:is)if(eligible(i.getProduct(),d))e=e.add(i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity())));BigDecimal a=d.getType()==DiscountType.PERCENT?e.multiply(d.getValue()).divide(BigDecimal.valueOf(100)):d.getValue();return a.min(e).setScale(2,RoundingMode.HALF_UP);} public void reconcile(ShoppingCart c,MerchantStore s){if(c.getPromoCode()!=null&&findApplicable(c.getPromoCode(),c,s)==null)c.setPromoCode(null);}
+}
