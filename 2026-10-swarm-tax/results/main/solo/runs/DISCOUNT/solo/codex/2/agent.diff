+package com.salesmanager.core.business.services.discount;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDate;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+import java.util.Objects;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.salesmanager.core.business.repositories.catalog.category.CategoryRepository;
+import com.salesmanager.core.business.repositories.discount.DiscountRepository;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service("discountService")
+public class DiscountServiceImpl implements DiscountService {
+    private final DiscountRepository repository;
+    private final CategoryRepository categoryRepository;
+
+    @Inject
+    public DiscountServiceImpl(DiscountRepository repository, CategoryRepository categoryRepository) {
+        this.repository = repository;
+        this.categoryRepository = categoryRepository;
+    }
+
+    @Override public List<Discount> list(MerchantStore store) { return repository.findByStore(store.getId()); }
+    @Override public Discount get(Long id, MerchantStore store) { return repository.findByIdAndStore(id, store.getId()); }
+    @Override public Discount find(String code, MerchantStore store) {
+        return code == null ? null : repository.findByStoreAndCode(store.getId(), code.trim());
+    }
+
+    @Override
+    @Transactional
+    public Discount save(Discount discount, MerchantStore store) {
+        validate(discount, store);
+        Discount duplicate = find(discount.getCode(), store);
+        if (duplicate != null && !Objects.equals(duplicate.getId(), discount.getId())) {
+            throw new DiscountConflictException("Discount code already exists");
+        }
+        Discount existing = discount.getId() == null ? null : get(discount.getId(), store);
+        if (discount.getId() != null && existing == null) throw new IllegalArgumentException("Discount not found");
+        discount.setMerchantStore(store);
+        discount.setCode(discount.getCode().trim());
+        if (discount.getStartDate() == null) discount.setStartDate(LocalDate.now());
+        if (discount.getCategories() == null) discount.setCategories(Collections.emptySet());
+        return repository.saveAndFlush(discount);
+    }
+
+    @Override @Transactional public void delete(Long id, MerchantStore store) {
+        Discount d = get(id, store);
+        if (d == null) throw new IllegalArgumentException("Discount not found");
+        repository.delete(d);
+    }
+
+    private void validate(Discount d, MerchantStore store) {
+        if (d == null || d.getCode() == null || d.getCode().trim().isEmpty() || d.getValue() == null || d.getType() == null)
+            throw new IllegalArgumentException("Code, type and value are required");
+        if (d.getType() == DiscountType.PERCENT && (d.getValue().compareTo(BigDecimal.ZERO) <= 0 || d.getValue().compareTo(new BigDecimal("100")) > 0))
+            throw new IllegalArgumentException("Percent must be greater than 0 and at most 100");
+        if (d.getType() == DiscountType.AMOUNT && d.getValue().compareTo(BigDecimal.ZERO) <= 0)
+            throw new IllegalArgumentException("Amount must be greater than 0");
+        if (d.getMinimumSubtotal() != null && d.getMinimumSubtotal().compareTo(BigDecimal.ZERO) < 0)
+            throw new IllegalArgumentException("Minimum subtotal cannot be negative");
+        if (d.getStartDate() == null) d.setStartDate(LocalDate.now());
+        if (d.getEndDate() != null && d.getEndDate().isBefore(d.getStartDate())) throw new IllegalArgumentException("End date is before start date");
+        Set<String> categories = d.getCategories() == null ? Collections.emptySet() : d.getCategories();
+        for (String code : categories) {
+            if (code == null || categoryRepository.findByCode(store.getId(), code) == null) throw new IllegalArgumentException("Unknown category: " + code);
+        }
+    }
+
+    @Override
+    public boolean applies(Discount d, List<ShoppingCartItem> items, MerchantStore store) {
+        if (d == null || !d.isActive() || d.getMerchantStore() == null || !store.getId().equals(d.getMerchantStore().getId())) return false;
+        LocalDate today = LocalDate.now();
+        if (d.getStartDate() == null || today.isBefore(d.getStartDate()) || (d.getEndDate() != null && today.isAfter(d.getEndDate()))) return false;
+        BigDecimal subtotal = subtotal(items);
+        if (d.getMinimumSubtotal() != null && subtotal.compareTo(d.getMinimumSubtotal()) < 0) return false;
+        return eligibleSubtotal(d, items).compareTo(BigDecimal.ZERO) > 0;
+    }
+
+    @Override
+    public BigDecimal calculate(Discount d, List<ShoppingCartItem> items, MerchantStore store) {
+        if (!applies(d, items, store)) return null;
+        BigDecimal eligible = eligibleSubtotal(d, items);
+        BigDecimal result = d.getType() == DiscountType.PERCENT
+                ? eligible.multiply(d.getValue()).divide(new BigDecimal("100"), 8, RoundingMode.HALF_UP)
+                : d.getValue().min(eligible);
+        return result.setScale(2, RoundingMode.HALF_UP);
+    }
+
+    private BigDecimal subtotal(List<ShoppingCartItem> items) {
+        return items.stream().map(i -> i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity()))).reduce(BigDecimal.ZERO, BigDecimal::add);
+    }
+    private BigDecimal eligibleSubtotal(Discount d, List<ShoppingCartItem> items) {
+        return items.stream().filter(i -> eligible(d, i.getProduct())).map(i -> i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity()))).reduce(BigDecimal.ZERO, BigDecimal::add);
+    }
+    private boolean eligible(Discount d, Product product) {
+        if (d.getCategories() == null || d.getCategories().isEmpty()) return true;
+        if (product == null || product.getCategories() == null) return false;
+        return product.getCategories().stream().anyMatch(c -> d.getCategories().stream().anyMatch(code -> categoryOrChild(c, code)));
+    }
+    private boolean categoryOrChild(Category category, String code) {
+        Category current = category;
+        while (current != null) {
+            if (code.equalsIgnoreCase(current.getCode())) return true;
+            current = current.getParent();
+        }
+        return false;
+    }
+}
