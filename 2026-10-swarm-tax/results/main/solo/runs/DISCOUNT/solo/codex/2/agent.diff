+package com.salesmanager.shop.store.api.v1.discount;
+
+import java.util.List;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+
+import com.salesmanager.core.business.services.discount.DiscountConflictException;
+import com.salesmanager.core.business.services.discount.DiscountService;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.discount.PersistableDiscount;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/discounts")
+public class DiscountApi {
+    @Inject private DiscountService discountService;
+
+    @PostMapping
+    public ResponseEntity<PersistableDiscount> create(@RequestBody PersistableDiscount request, @ApiIgnore MerchantStore store) {
+        try { return ResponseEntity.status(HttpStatus.CREATED).body(toDto(discountService.save(toEntity(request, null), store))); }
+        catch (DiscountConflictException e) { return ResponseEntity.status(HttpStatus.CONFLICT).build(); }
+        catch (RuntimeException e) { return ResponseEntity.badRequest().build(); }
+    }
+
+    @GetMapping
+    public ResponseEntity<List<PersistableDiscount>> list(@ApiIgnore MerchantStore store) {
+        return ResponseEntity.ok(discountService.list(store).stream().map(this::toDto).collect(Collectors.toList()));
+    }
+
+    @PutMapping("/{id}")
+    public ResponseEntity<PersistableDiscount> update(@PathVariable Long id, @RequestBody PersistableDiscount request, @ApiIgnore MerchantStore store) {
+        try { return ResponseEntity.ok(toDto(discountService.save(toEntity(request, id), store))); }
+        catch (DiscountConflictException e) { return ResponseEntity.status(HttpStatus.CONFLICT).build(); }
+        catch (RuntimeException e) { return ResponseEntity.badRequest().build(); }
+    }
+
+    @DeleteMapping("/{id}")
+    public ResponseEntity<Void> delete(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        try { discountService.delete(id, store); return ResponseEntity.noContent().build(); }
+        catch (RuntimeException e) { return ResponseEntity.notFound().build(); }
+    }
+
+    private Discount toEntity(PersistableDiscount d, Long id) {
+        Discount result = new Discount(); result.setId(id); result.setCode(d.getCode()); result.setType(d.getType()); result.setValue(d.getValue());
+        result.setMinimumSubtotal(d.getMinimumSubtotal()); result.setStartDate(d.getStartDate()); result.setEndDate(d.getEndDate());
+        result.setCategories(d.getCategories() == null ? null : new java.util.HashSet<>(d.getCategories())); result.setActive(d.getActive() == null || d.getActive()); return result;
+    }
+    private PersistableDiscount toDto(Discount d) {
+        PersistableDiscount r = new PersistableDiscount(); r.setId(d.getId()); r.setCode(d.getCode()); r.setType(d.getType()); r.setValue(d.getValue());
+        r.setMinimumSubtotal(d.getMinimumSubtotal()); r.setStartDate(d.getStartDate()); r.setEndDate(d.getEndDate()); r.setCategories(new java.util.ArrayList<>(d.getCategories())); r.setActive(d.isActive()); return r;
+    }
+}
