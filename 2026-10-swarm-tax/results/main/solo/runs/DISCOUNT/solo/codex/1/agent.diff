+package com.salesmanager.core.business.services.discount;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDate;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.discount.DiscountRepository;
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service("discountService")
+public class DiscountServiceImpl implements DiscountService {
+    private final DiscountRepository repository;
+    @Inject private CategoryService categoryService;
+    @Inject public DiscountServiceImpl(DiscountRepository repository) { this.repository = repository; }
+
+    public Discount create(Discount d, MerchantStore store) throws ServiceException { validate(d, store, null); d.setMerchantStore(store); return repository.saveAndFlush(d); }
+    public Discount update(Long id, Discount d, MerchantStore store) throws ServiceException { validate(d, store, id); Discount old = repository.findByIdAndMerchantStoreId(id, store.getId()); if (old == null) throw new ServiceException("Discount not found"); d.setId(id); d.setMerchantStore(store); return repository.saveAndFlush(d); }
+    public List<Discount> list(MerchantStore store) { return repository.findByMerchantStoreId(store.getId()); }
+    public void delete(Long id, MerchantStore store) throws ServiceException { Discount d = repository.findByIdAndMerchantStoreId(id, store.getId()); if (d == null) throw new ServiceException("Discount not found"); repository.delete(d); }
+    public Discount find(String code, MerchantStore store) { return repository.findByMerchantStoreIdAndCodeIgnoreCase(store.getId(), code); }
+
+    private void validate(Discount d, MerchantStore store, Long id) throws ServiceException {
+        if (d == null || d.getCode() == null || d.getCode().trim().isEmpty() || d.getType() == null || d.getValue() == null || d.getValue().compareTo(BigDecimal.ZERO) <= 0) throw new ServiceException("Invalid discount");
+        if (d.getType() == DiscountType.PERCENT && d.getValue().compareTo(new BigDecimal("100")) > 0) throw new ServiceException("Invalid percentage");
+        if (d.getStartDate() == null) d.setStartDate(LocalDate.now());
+        if (d.getEndDate() != null && d.getEndDate().isBefore(d.getStartDate())) throw new ServiceException("Invalid dates");
+        if (d.getCategories() != null) for (String code : d.getCategories()) if (code == null || categoryService.getByCode(store, code) == null) throw new ServiceException("Unknown category");
+        Discount existing = repository.findByMerchantStoreIdAndCodeIgnoreCase(store.getId(), d.getCode());
+        if (existing != null && !existing.getId().equals(id)) throw new DuplicateDiscountException();
+    }
+
+    public boolean applies(Discount d, ShoppingCart cart) {
+        if (d == null || !d.isActive() || d.getMerchantStore().getId().intValue() != cart.getMerchantStore().getId().intValue()) return false;
+        LocalDate today = LocalDate.now(); if (d.getStartDate() != null && today.isBefore(d.getStartDate()) || d.getEndDate() != null && today.isAfter(d.getEndDate())) return false;
+        BigDecimal subtotal = cart.getLineItems().stream().map(i -> i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity()))).reduce(BigDecimal.ZERO, BigDecimal::add);
+        if (d.getMinimumSubtotal() != null && subtotal.compareTo(d.getMinimumSubtotal()) < 0) return false;
+        return eligibleSubtotal(d, cart).compareTo(BigDecimal.ZERO) > 0;
+    }
+    public BigDecimal calculate(Discount d, ShoppingCart cart) {
+        if (!applies(d, cart)) return BigDecimal.ZERO.setScale(2);
+        BigDecimal eligible = eligibleSubtotal(d, cart);
+        BigDecimal result = d.getType() == DiscountType.PERCENT ? eligible.multiply(d.getValue()).divide(new BigDecimal("100"), 2, RoundingMode.HALF_UP) : d.getValue().min(eligible).setScale(2, RoundingMode.HALF_UP);
+        return result.setScale(2, RoundingMode.HALF_UP);
+    }
+    private BigDecimal eligibleSubtotal(Discount d, ShoppingCart cart) {
+        return cart.getLineItems().stream().filter(i -> eligible(d, i)).map(i -> i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity()))).reduce(BigDecimal.ZERO, BigDecimal::add);
+    }
+    private boolean eligible(Discount d, ShoppingCartItem item) {
+        if (d.getCategories() == null || d.getCategories().isEmpty()) return true;
+        if (item.getProduct() == null || item.getProduct().getCategories() == null) return false;
+        for (Category c : item.getProduct().getCategories()) for (String wanted : d.getCategories()) {
+            try {
+                Category root = categoryService.getByCode(d.getMerchantStore(), wanted);
+                if (root != null && (c.getCode().equalsIgnoreCase(wanted) || c.getLineage() != null && c.getLineage().contains("/" + root.getId() + "/"))) return true;
+            } catch (ServiceException ignored) { return false; }
+        }
+        return false;
+    }
+    public static class DuplicateDiscountException extends ServiceException { public DuplicateDiscountException() { super("Discount code already exists"); } }
+}
