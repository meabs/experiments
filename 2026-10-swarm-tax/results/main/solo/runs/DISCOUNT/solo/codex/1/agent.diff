+public class DiscountApi {
+    @Inject private DiscountService discountService;
+
+    @PostMapping
+    public ResponseEntity<PersistableDiscount> create(@RequestBody PersistableDiscount request, @ApiIgnore MerchantStore store) throws ServiceException {
+        return new ResponseEntity<>(view(discountService.create(model(request), store)), HttpStatus.CREATED);
