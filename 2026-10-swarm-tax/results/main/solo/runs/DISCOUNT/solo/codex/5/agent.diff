+package com.salesmanager.core.business.services.discount;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDate;
+import java.time.ZoneId;
+import java.util.Date;
+import java.util.List;
+import java.util.Optional;
+
+import javax.inject.Inject;
+
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.salesmanager.core.business.repositories.catalog.category.CategoryRepository;
+import com.salesmanager.core.business.repositories.discount.DiscountCodeRepository;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.discount.DiscountCode;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service("discountCodeService")
+public class DiscountCodeServiceImpl implements DiscountCodeService {
+    private final DiscountCodeRepository repository;
+    private final CategoryRepository categoryRepository;
+
+    @Inject
+    public DiscountCodeServiceImpl(DiscountCodeRepository repository, CategoryRepository categoryRepository) {
+        this.repository = repository;
+        this.categoryRepository = categoryRepository;
+    }
+
+    @Override @Transactional
+    public DiscountCode save(DiscountCode discount, MerchantStore store) {
+        discount.setMerchantStore(store);
+        return repository.save(discount);
+    }
+    @Override public List<DiscountCode> list(MerchantStore store) { return repository.findByStore(store.getId()); }
+    @Override public Optional<DiscountCode> find(Long id, MerchantStore store) { return repository.findByIdAndStore(id, store.getId()); }
+    @Override public Optional<DiscountCode> findByCode(String code, MerchantStore store) { return repository.findByStoreAndCode(store.getId(), code); }
+    @Override @Transactional public void delete(Long id, MerchantStore store) { find(id, store).ifPresent(repository::delete); }
+
+    @Override
+    public boolean applies(DiscountCode discount, ShoppingCart cart) {
+        if (discount == null || cart == null || !discount.isActive() || cart.getMerchantStore() == null
+                || !cart.getMerchantStore().getId().equals(discount.getMerchantStore().getId())) return false;
+        LocalDate today = LocalDate.now();
+        if (discount.getStartDate() == null || today.isBefore(toDate(discount.getStartDate()))
+                || (discount.getEndDate() != null && today.isAfter(toDate(discount.getEndDate())))) return false;
+        BigDecimal subtotal = subtotal(cart.getLineItems());
+        if (discount.getMinimumSubtotal() != null && subtotal.compareTo(discount.getMinimumSubtotal()) < 0) return false;
+        return eligibleSubtotal(discount, cart) .compareTo(BigDecimal.ZERO) > 0;
+    }
+
+    @Override
+    public BigDecimal discount(DiscountCode discount, ShoppingCart cart) {
+        if (!applies(discount, cart)) return BigDecimal.ZERO.setScale(2);
+        BigDecimal eligible = eligibleSubtotal(discount, cart);
+        BigDecimal amount = discount.getType() == DiscountType.PERCENT
+                ? eligible.multiply(discount.getValue()).divide(BigDecimal.valueOf(100), 8, RoundingMode.HALF_UP)
+                : discount.getValue();
+        return amount.min(eligible).setScale(2, RoundingMode.HALF_UP);
+    }
+
+    private BigDecimal eligibleSubtotal(DiscountCode discount, ShoppingCart cart) {
+        return cart.getLineItems().stream().filter(i -> eligibleItem(discount, i)).map(this::itemSubtotal)
+                .reduce(BigDecimal.ZERO, BigDecimal::add);
+    }
+    @Override
+    public boolean eligibleItem(DiscountCode discount, ShoppingCartItem item) {
+        if (item.getProduct() == null) return false;
+        if (discount.getCategories() == null || discount.getCategories().isEmpty()) return true;
+        for (Category category : item.getProduct().getCategories()) {
+            Category current = category;
+            while (current != null) {
+                String categoryCode = current.getCode();
+                if (discount.getCategories().stream().anyMatch(c -> c.equalsIgnoreCase(categoryCode))) return true;
+                current = current.getParent();
+            }
+        }
+        return false;
+    }
+    private BigDecimal itemSubtotal(ShoppingCartItem item) {
+        return item.getItemPrice().multiply(BigDecimal.valueOf(item.getQuantity()));
+    }
+    private BigDecimal subtotal(java.util.Set<ShoppingCartItem> items) { return items.stream().map(this::itemSubtotal).reduce(BigDecimal.ZERO, BigDecimal::add); }
+    private LocalDate toDate(Date date) { return date.toInstant().atZone(ZoneId.systemDefault()).toLocalDate(); }
+}
