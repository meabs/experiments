@@ -0,0 +1,56 @@
+package com.salesmanager.shop.store.controller.discount.facade;
+
+import java.time.LocalDate;
+import java.time.ZoneId;
+import java.util.Date;
+import java.util.List;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.business.services.discount.DiscountCodeService;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.discount.DiscountCode;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.discount.PersistableDiscountCode;
+import com.salesmanager.shop.store.api.exception.DiscountConflictException;
+import com.salesmanager.shop.store.api.exception.DiscountValidationException;
+
+@Service
+public class DiscountCodeFacade {
+    @Inject private DiscountCodeService service;
+    @Inject private CategoryService categoryService;
+
+    public PersistableDiscountCode create(PersistableDiscountCode input, MerchantStore store) { return save(input, store, null); }
+    public List<PersistableDiscountCode> list(MerchantStore store) { return service.list(store).stream().map(this::toDto).collect(Collectors.toList()); }
+    public PersistableDiscountCode update(Long id, PersistableDiscountCode input, MerchantStore store) { return save(input, store, id); }
+    public void delete(Long id, MerchantStore store) { service.delete(id, store); }
+
+    private PersistableDiscountCode save(PersistableDiscountCode input, MerchantStore store, Long id) {
+        if (input == null || input.getCode() == null || input.getCode().trim().isEmpty() || input.getValue() == null || input.getType() == null)
+            throw new DiscountValidationException("code, type and value are required");
+        DiscountType type;
+        try { type = DiscountType.valueOf(input.getType().toUpperCase()); } catch (Exception e) { throw new DiscountValidationException("unknown discount type"); }
+        if (input.getValue().signum() <= 0 || (type == DiscountType.PERCENT && input.getValue().compareTo(java.math.BigDecimal.valueOf(100)) > 0))
+            throw new DiscountValidationException("invalid discount value");
+        Date start = parse(input.getStartDate(), "startDate");
+        Date end = parse(input.getEndDate(), "endDate");
+        if (end != null && end.before(start)) throw new DiscountValidationException("endDate must not precede startDate");
+        if (input.getCategories() != null) for (String code : input.getCategories()) {
+            try { Category c = categoryService.getByCode(store, code); if (c == null) throw new Exception(); }
+            catch (Exception e) { throw new DiscountValidationException("unknown category: " + code); }
+        }
+        service.findByCode(input.getCode(), store).ifPresent(existing -> { if (!existing.getId().equals(id)) throw new DiscountConflictException("discount code already exists"); });
+        DiscountCode d = id == null ? new DiscountCode() : service.find(id, store).orElseThrow(() -> new DiscountValidationException("discount not found"));
+        d.setCode(input.getCode().trim()); d.setType(type); d.setValue(input.getValue()); d.setMinimumSubtotal(input.getMinimumSubtotal());
+        d.setStartDate(start); d.setEndDate(end); d.setCategories(input.getCategories()); d.setActive(input.getActive() == null || input.getActive());
+        return toDto(service.save(d, store));
+    }
+    private Date parse(String value, String field) { try { return value == null || value.isBlank() ? (field.equals("startDate") ? date(LocalDate.now()) : null) : date(LocalDate.parse(value)); } catch (Exception e) { throw new DiscountValidationException("invalid " + field); } }
+    private Date date(LocalDate d) { return Date.from(d.atStartOfDay(ZoneId.systemDefault()).toInstant()); }
+    private PersistableDiscountCode toDto(DiscountCode d) { PersistableDiscountCode p = new PersistableDiscountCode(); p.setId(d.getId()); p.setCode(d.getCode()); p.setType(d.getType().name()); p.setValue(d.getValue()); p.setMinimumSubtotal(d.getMinimumSubtotal()); p.setStartDate(d.getStartDate().toInstant().atZone(ZoneId.systemDefault()).toLocalDate().toString()); p.setEndDate(d.getEndDate() == null ? null : d.getEndDate().toInstant().atZone(ZoneId.systemDefault()).toLocalDate().toString()); p.setCategories(d.getCategories()); p.setActive(d.isActive()); return p; }
+}
