+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestMethod;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.stereotype.Controller;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductQuantityPriceTier;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+@Controller
+@RequestMapping("/api/v1")
+public class ProductQuantityPriceTierApi {
+
+    @Inject
+    private ProductService productService;
+
+    @RequestMapping(value = "/private/product/{id}/tiers", method = RequestMethod.GET)
+    @ResponseBody
+    @Transactional(readOnly = true)
+    public List<ProductQuantityPriceTier> get(@PathVariable Long id, @ApiIgnore MerchantStore merchantStore) {
+        Product product = findProduct(id, merchantStore);
+        List<ProductQuantityPriceTier> result = new ArrayList<ProductQuantityPriceTier>();
+        for (com.salesmanager.core.model.catalog.product.ProductQuantityPriceTier tier : product.getQuantityPriceTiers()) {
+            result.add(toApiTier(tier));
+        }
+        return result;
+    }
+
+    @RequestMapping(value = "/private/product/{id}/tiers", method = RequestMethod.PUT)
+    @ResponseStatus(HttpStatus.OK)
+    @ResponseBody
+    @Transactional
+    public List<ProductQuantityPriceTier> replace(@PathVariable Long id,
+            @RequestBody List<ProductQuantityPriceTier> request,
+            @ApiIgnore MerchantStore merchantStore) throws Exception {
+        Product product = findProduct(id, merchantStore);
+        validate(request);
+
+        List<com.salesmanager.core.model.catalog.product.ProductQuantityPriceTier> replacement = new ArrayList<com.salesmanager.core.model.catalog.product.ProductQuantityPriceTier>();
+        for (ProductQuantityPriceTier tier : request) {
+            replacement.add(new com.salesmanager.core.model.catalog.product.ProductQuantityPriceTier(tier.getMinQuantity(), tier.getPrice()));
+        }
+        replacement.sort(Comparator.comparing(com.salesmanager.core.model.catalog.product.ProductQuantityPriceTier::getMinQuantity));
+        product.setQuantityPriceTiers(replacement);
+        productService.update(product);
+        return get(id, merchantStore);
+    }
+
+    private Product findProduct(Long id, MerchantStore merchantStore) {
+        return productService.retrieveById(id, merchantStore)
+                .orElseThrow(() -> new ResourceNotFoundException("Product not found"));
+    }
+
+    private void validate(List<ProductQuantityPriceTier> tiers) {
+        if (tiers == null || tiers.size() > 10) {
+            throw new RestApiException("400", "A maximum of 10 tiers is allowed");
+        }
+
+        Set<Integer> quantities = new HashSet<Integer>();
+        List<ProductQuantityPriceTier> ordered = new ArrayList<ProductQuantityPriceTier>(tiers);
+        for (ProductQuantityPriceTier tier : ordered) {
+            if (tier == null || tier.getMinQuantity() == null || tier.getPrice() == null
+                    || tier.getMinQuantity() < 2 || tier.getPrice().signum() <= 0
+                    || !quantities.add(tier.getMinQuantity())) {
+                throw new RestApiException("400", "Invalid quantity price tier");
+            }
+        }
+        ordered.sort(Comparator.comparing(ProductQuantityPriceTier::getMinQuantity));
+        for (int i = 1; i < ordered.size(); i++) {
+            if (ordered.get(i).getPrice().compareTo(ordered.get(i - 1).getPrice()) >= 0) {
+                throw new RestApiException("400", "Tier prices must decrease as quantity increases");
+            }
+        }
+    }
+
+    private ProductQuantityPriceTier toApiTier(com.salesmanager.core.model.catalog.product.ProductQuantityPriceTier tier) {
+        ProductQuantityPriceTier result = new ProductQuantityPriceTier();
+        result.setMinQuantity(tier.getMinQuantity());
+        result.setPrice(tier.getPrice());
+        return result;
+    }
+}
