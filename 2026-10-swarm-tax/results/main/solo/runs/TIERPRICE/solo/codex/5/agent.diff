@@ -0,0 +1,101 @@
+package com.salesmanager.shop.store.api.v1.product;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductTierData;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.controller.user.facade.UserFacade;
+import com.salesmanager.shop.constants.Constants;
+import springfox.documentation.annotations.ApiIgnore;
+
+@Controller
+@RequestMapping("/api/v1")
+public class ProductTierApi {
+    @Inject private ProductService productService;
+    @Inject private UserFacade userFacade;
+
+    @GetMapping("/private/product/{id}/tiers")
+    @ResponseBody
+    public List<ProductTierData> get(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        authorize();
+        return data(product(id, store).getTiers());
+    }
+
+    @PutMapping("/private/product/{id}/tiers")
+    @ResponseStatus(HttpStatus.OK)
+    @ResponseBody
+    public List<ProductTierData> replace(@PathVariable Long id, @RequestBody List<ProductTierData> request,
+            @ApiIgnore MerchantStore store) {
+        authorize();
+        if (request == null || request.size() > 10) bad("At most 10 tiers are allowed");
+        Product product = product(id, store);
+        Set<Integer> quantities = new HashSet<>();
+        List<ProductTierData> sorted = new ArrayList<>(request);
+        sorted.sort(Comparator.nullsFirst(Comparator.comparing(ProductTierData::getMinQuantity,
+                Comparator.nullsFirst(Comparator.naturalOrder()))));
+        BigDecimal previousPrice = null;
+        for (ProductTierData input : sorted) {
+            if (input == null || input.getMinQuantity() == null || input.getMinQuantity() < 2
+                    || input.getPrice() == null || input.getPrice().compareTo(BigDecimal.ZERO) <= 0
+                    || !quantities.add(input.getMinQuantity())) bad("Invalid product tier");
+            if (previousPrice != null && input.getPrice().compareTo(previousPrice) >= 0)
+                bad("Higher quantities must have lower prices");
+            previousPrice = input.getPrice();
+        }
+        Set<ProductTier> tiers = new java.util.LinkedHashSet<>();
+        for (ProductTierData input : sorted) {
+            ProductTier tier = new ProductTier();
+            tier.setProduct(product);
+            tier.setMinQuantity(input.getMinQuantity());
+            tier.setPrice(input.getPrice());
+            tiers.add(tier);
+        }
+        product.setTiers(tiers);
+        try { productService.saveProduct(product); }
+        catch (Exception e) { throw new RestApiException("Unable to save product tiers"); }
+        return data(product.getTiers());
+    }
+
+    private Product product(Long id, MerchantStore store) {
+        Product product = productService.retrieveById(id, store).orElse(null);
+        if (product == null) throw new ResourceNotFoundException("Product not found");
+        return product;
+    }
+
+    private List<ProductTierData> data(Set<ProductTier> tiers) {
+        return tiers.stream().sorted(Comparator.comparing(ProductTier::getMinQuantity)).map(t -> {
+            ProductTierData d = new ProductTierData(); d.setMinQuantity(t.getMinQuantity()); d.setPrice(t.getPrice()); return d;
+        }).collect(Collectors.toList());
+    }
+
+    private void bad(String message) { throw new RestApiException(message); }
+    private void authorize() {
+        String user = userFacade.authenticatedUser();
+        if (user == null) throw new com.salesmanager.shop.store.api.exception.UnauthorizedException();
+        userFacade.authorizedGroup(user, java.util.stream.Stream.of(Constants.GROUP_SUPERADMIN, Constants.GROUP_ADMIN,
+                Constants.GROUP_ADMIN_CATALOGUE, Constants.GROUP_ADMIN_RETAIL).collect(Collectors.toList()));
+    }
+}
