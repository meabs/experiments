+			}
+			if (previousQuantity != null && previousQuantity.equals(tier.getMinQuantity())) {
+				throw new RestApiException("400", "Duplicate tier quantity");
+			}
+			if (previousPrice != null && tier.getPrice().compareTo(previousPrice) >= 0) {
+				throw new RestApiException("400", "Higher quantity tiers must have lower prices");
+			}
+			previousQuantity = tier.getMinQuantity();
+			previousPrice = tier.getPrice();
+		}
+		product.getPriceTiers().clear();
+		product.getPriceTiers().addAll(sorted);
+		productService.saveProduct(product);
+		return sorted;
