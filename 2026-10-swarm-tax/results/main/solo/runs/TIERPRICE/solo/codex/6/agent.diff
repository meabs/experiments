+@Entity
+@Table(name = "PRODUCT_TIER")
+public class ProductTier extends SalesManagerEntity<Long, ProductTier> implements Serializable {
+    private static final long serialVersionUID = 1L;
+
+    @Id
+    @Column(name = "PRODUCT_TIER_ID", nullable = false, unique = true)
+    @TableGenerator(name = "TABLE_GEN", table = "SM_SEQUENCER", pkColumnName = "SEQ_NAME",
