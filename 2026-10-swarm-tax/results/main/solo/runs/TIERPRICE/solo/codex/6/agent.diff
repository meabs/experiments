 public class ProductApi {
 
+	@ResponseStatus(HttpStatus.OK)
+	@RequestMapping(value = "/private/product/{id}/tiers", method = RequestMethod.GET, produces = APPLICATION_JSON_VALUE)
+	public List<ProductTierRequest> getTiers(@PathVariable Long id, @ApiIgnore MerchantStore merchantStore) {
+		Product product = productService.findOne(id, merchantStore);
+		if (product == null) {
+			throw new ResourceNotFoundException("No product found for id [" + id + "]");
+		}
+		return tierRequests(product.getTiers());
+	}
+
+	@ResponseStatus(HttpStatus.OK)
+	@RequestMapping(value = "/private/product/{id}/tiers", method = RequestMethod.PUT,
+			consumes = APPLICATION_JSON_VALUE, produces = APPLICATION_JSON_VALUE)
+	public List<ProductTierRequest> replaceTiers(@PathVariable Long id,
+			@RequestBody List<@Valid ProductTierRequest> requests, @ApiIgnore MerchantStore merchantStore) {
+		Product product = productService.findOne(id, merchantStore);
+		if (product == null) {
+			throw new ResourceNotFoundException("No product found for id [" + id + "]");
+		}
+		if (requests == null || requests.size() > 10) {
+			throw new ServiceRuntimeException("A product may have at most 10 tiers");
+		}
+		List<ProductTierRequest> sorted = new ArrayList<>(requests);
+		sorted.sort(Comparator.comparing(ProductTierRequest::getMinQuantity));
+		for (int i = 0; i < sorted.size(); i++) {
+			ProductTierRequest current = sorted.get(i);
+			if (current.getMinQuantity() == null || current.getPrice() == null) {
+				throw new ServiceRuntimeException("Tier minQuantity and price are required");
+			}
+			if (i > 0) {
+				ProductTierRequest previous = sorted.get(i - 1);
+				if (current.getMinQuantity().equals(previous.getMinQuantity())) {
+					throw new ServiceRuntimeException("Tier minQuantity values must be unique");
+				}
+				if (current.getPrice().compareTo(previous.getPrice()) >= 0) {
+					throw new ServiceRuntimeException("Higher quantity tiers must have lower prices");
+				}
+			}
+		}
+		List<ProductTier> tiers = new ArrayList<>();
+		for (ProductTierRequest request : sorted) {
+			ProductTier tier = new ProductTier();
+			tier.setProduct(product);
+			tier.setMinQuantity(request.getMinQuantity());
+			tier.setPrice(request.getPrice());
+			tiers.add(tier);
+		}
+		product.getTiers().clear();
+		product.getTiers().addAll(tiers);
+		try {
+			productService.saveProduct(product);
+		} catch (Exception e) {
+			throw new ServiceRuntimeException("Unable to save product tiers", e);
+		}
+		return tierRequests(product.getTiers());
+	}
+
+	private List<ProductTierRequest> tierRequests(List<ProductTier> tiers) {
+		List<ProductTierRequest> result = new ArrayList<>();
+		if (tiers != null) {
+			for (ProductTier tier : tiers) {
+				ProductTierRequest request = new ProductTierRequest();
+				request.setMinQuantity(tier.getMinQuantity());
+				request.setPrice(tier.getPrice());
+				result.add(request);
+			}
+		}
+		result.sort(Comparator.comparing(ProductTierRequest::getMinQuantity));
+		return result;
+	}
+
