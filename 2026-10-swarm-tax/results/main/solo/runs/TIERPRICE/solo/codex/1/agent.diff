@@ -0,0 +1,93 @@
+package com.salesmanager.shop.store.api.v1.product;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestMethod;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.stereotype.Controller;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.core.business.exception.ServiceException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@Controller
+@RequestMapping("/api/v1")
+public class ProductTierApi {
+    private final ProductService productService;
+    public ProductTierApi(ProductService productService) { this.productService = productService; }
+
+    @RequestMapping(value = "/private/product/{id}/tiers", method = RequestMethod.GET)
+    @ResponseBody
+    public List<com.salesmanager.shop.model.catalog.product.ProductTier> get(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        return output(product(id, store));
+    }
+
+    @RequestMapping(value = "/private/product/{id}/tiers", method = RequestMethod.PUT)
+    @ResponseStatus(HttpStatus.OK)
+    @ResponseBody
+    public List<com.salesmanager.shop.model.catalog.product.ProductTier> put(@PathVariable Long id,
+            @RequestBody List<com.salesmanager.shop.model.catalog.product.ProductTier> request,
+            @ApiIgnore MerchantStore store) {
+        if (request == null) bad("Tier list is required");
+        validate(request);
+        Product product = product(id, store);
+        Set<com.salesmanager.core.model.catalog.product.ProductTier> tiers = new java.util.LinkedHashSet<>();
+        for (com.salesmanager.shop.model.catalog.product.ProductTier input : request) {
+            com.salesmanager.core.model.catalog.product.ProductTier tier = new com.salesmanager.core.model.catalog.product.ProductTier();
+            tier.setProduct(product); tier.setMinQuantity(input.getMinQuantity()); tier.setPrice(input.getPrice()); tiers.add(tier);
+        }
+        product.setTiers(tiers);
+        try {
+            productService.update(product);
+        } catch (ServiceException e) {
+            throw new ServiceRuntimeException("Unable to save tiers", e);
+        }
+        return output(product(id, store));
+    }
+
+    private Product product(Long id, MerchantStore store) {
+        Product p = productService.findOne(id, store);
+        if (p == null) throw new ResourceNotFoundException("Product not found");
+        return p;
+    }
+    private void validate(List<com.salesmanager.shop.model.catalog.product.ProductTier> tiers) {
+        if (tiers.size() > 10) bad("At most 10 tiers are allowed");
+        Set<Integer> seen = new HashSet<>(); BigDecimal previous = null;
+        List<com.salesmanager.shop.model.catalog.product.ProductTier> sorted = new ArrayList<>(tiers);
+        sorted.sort((a, b) -> {
+            if (a == null || a.getMinQuantity() == null) return -1;
+            if (b == null || b.getMinQuantity() == null) return 1;
+            return a.getMinQuantity().compareTo(b.getMinQuantity());
+        });
+        for (com.salesmanager.shop.model.catalog.product.ProductTier tier : sorted) {
+            if (tier == null || tier.getMinQuantity() == null || tier.getPrice() == null || tier.getMinQuantity() < 2
+                    || tier.getPrice().compareTo(BigDecimal.ZERO) <= 0 || !seen.add(tier.getMinQuantity())) bad("Invalid tiers");
+            if (previous != null && tier.getPrice().compareTo(previous) >= 0) bad("Tier prices must decrease");
+            previous = tier.getPrice();
+        }
+    }
+    private void bad(String message) { throw new ServiceRuntimeException("400", message); }
+    private List<com.salesmanager.shop.model.catalog.product.ProductTier> output(Product product) {
+        List<com.salesmanager.shop.model.catalog.product.ProductTier> out = new ArrayList<>();
+        for (com.salesmanager.core.model.catalog.product.ProductTier tier : product.getTiers()) {
+            com.salesmanager.shop.model.catalog.product.ProductTier dto = new com.salesmanager.shop.model.catalog.product.ProductTier();
+            dto.setMinQuantity(tier.getMinQuantity()); dto.setPrice(tier.getPrice()); out.add(dto);
+        }
+        out.sort(Comparator.comparing(com.salesmanager.shop.model.catalog.product.ProductTier::getMinQuantity));
+        return out;
+    }
+}
