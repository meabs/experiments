+	private void applyQuantityPrices(final ShoppingCart cart) {
+		for (ShoppingCartItem item : cart.getLineItems()) {
+			if (item.getProduct() == null || item.getProduct().getTiers() == null) continue;
+			BigDecimal ownPrice = item.getFinalPrice() == null ? item.getItemPrice() : item.getFinalPrice().getFinalPrice();
+			if (ownPrice == null) continue;
+			BigDecimal tierPrice = null;
+			for (ProductTier tier : item.getProduct().getTiers()) {
+				if (item.getQuantity() >= tier.getMinQuantity()) tierPrice = tier.getPrice();
+			}
+			item.setItemPrice(tierPrice != null && tierPrice.compareTo(ownPrice) < 0 ? tierPrice : ownPrice);
+		}
+	}
