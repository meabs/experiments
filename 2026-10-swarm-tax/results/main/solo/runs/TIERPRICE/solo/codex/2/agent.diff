+	private void refreshTierPrices(final ShoppingCart cartModel) throws ServiceException {
+		for (ShoppingCartItem item : cartModel.getLineItems()) {
+			if (item.getProduct() == null) {
+				continue;
+			}
+			BigDecimal ownPrice = pricingService.calculateProductPrice(item.getProduct()).getFinalPrice();
+			BigDecimal selectedPrice = ownPrice;
+			if (item.getProduct().getQuantityPriceTiers() != null) {
+				for (com.salesmanager.core.model.catalog.product.ProductQuantityPriceTier tier
+						: item.getProduct().getQuantityPriceTiers()) {
+					if (item.getQuantity() >= tier.getMinQuantity()
+							&& tier.getPrice().compareTo(selectedPrice) < 0) {
+						selectedPrice = tier.getPrice();
+					}
+				}
+			}
+			item.setItemPrice(selectedPrice);
+			item.setSubTotal(selectedPrice.multiply(new BigDecimal(item.getQuantity())));
+		}
+	}
+
 	private void updateCartModel(final ShoppingCart cartModel) throws ServiceException {
 		shoppingCartService.saveOrUpdate(cartModel);
 	}
