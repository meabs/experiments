@@ -0,0 +1,103 @@
+package com.salesmanager.shop.store.api.v1.product;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.stream.Collectors;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.stereotype.Controller;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductQuantityPriceTier;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+@Controller
+@RequestMapping("/api/v1")
+public class ProductTierApi {
+
+    private final ProductService productService;
+
+    public ProductTierApi(ProductService productService) {
+        this.productService = productService;
+    }
+
+    @GetMapping("/private/product/{id}/tiers")
+    @ResponseStatus(HttpStatus.OK)
+    public List<ProductQuantityPriceTier> get(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        return toResponse(product(id, store).getQuantityPriceTiers());
+    }
+
+    @PutMapping("/private/product/{id}/tiers")
+    @ResponseStatus(HttpStatus.OK)
+    public List<ProductQuantityPriceTier> replace(@PathVariable Long id,
+            @RequestBody List<ProductQuantityPriceTier> request, @ApiIgnore MerchantStore store) {
+        Product product = product(id, store);
+        validate(request);
+        List<com.salesmanager.core.model.catalog.product.ProductQuantityPriceTier> tiers = new ArrayList<>();
+        for (ProductQuantityPriceTier input : request) {
+            com.salesmanager.core.model.catalog.product.ProductQuantityPriceTier tier =
+                    new com.salesmanager.core.model.catalog.product.ProductQuantityPriceTier();
+            tier.setProduct(product);
+            tier.setMinQuantity(input.getMinQuantity());
+            tier.setPrice(input.getPrice());
+            tiers.add(tier);
+        }
+        product.getQuantityPriceTiers().clear();
+        product.getQuantityPriceTiers().addAll(tiers);
+        try {
+            productService.saveProduct(product);
+        } catch (Exception e) {
+            throw new RestApiException("Could not save product tiers", e);
+        }
+        return toResponse(product.getQuantityPriceTiers());
+    }
+
+    private Product product(Long id, MerchantStore store) {
+        Product product = productService.findOne(id, store);
+        if (product == null || product.getMerchantStore() == null
+                || !product.getMerchantStore().getId().equals(store.getId())) {
+            throw new ResourceNotFoundException("Product not found");
+        }
+        return product;
+    }
+
+    private void validate(List<ProductQuantityPriceTier> tiers) {
+        if (tiers == null || tiers.size() > 10) bad();
+        List<ProductQuantityPriceTier> sorted = tiers.stream()
+                .sorted(Comparator.comparing(ProductQuantityPriceTier::getMinQuantity,
+                        Comparator.nullsFirst(Comparator.naturalOrder())))
+                .collect(Collectors.toList());
+        Integer previousQuantity = null;
+        BigDecimal previousPrice = null;
+        for (ProductQuantityPriceTier tier : sorted) {
+            if (tier == null || tier.getMinQuantity() == null || tier.getMinQuantity() < 2
+                    || tier.getPrice() == null || tier.getPrice().signum() <= 0) bad();
+            if (previousQuantity != null && previousQuantity.equals(tier.getMinQuantity())) bad();
+            if (previousPrice != null && tier.getPrice().compareTo(previousPrice) >= 0) bad();
+            previousQuantity = tier.getMinQuantity();
+            previousPrice = tier.getPrice();
+        }
+    }
+
+    private void bad() { throw new RestApiException("Invalid product quantity price tiers"); }
+
+    private List<ProductQuantityPriceTier> toResponse(List<com.salesmanager.core.model.catalog.product.ProductQuantityPriceTier> tiers) {
+        return tiers.stream().sorted(Comparator.comparing(com.salesmanager.core.model.catalog.product.ProductQuantityPriceTier::getMinQuantity))
+                .map(tier -> { ProductQuantityPriceTier result = new ProductQuantityPriceTier();
+                    result.setMinQuantity(tier.getMinQuantity()); result.setPrice(tier.getPrice()); return result; })
+                .collect(Collectors.toList());
+    }
+}
