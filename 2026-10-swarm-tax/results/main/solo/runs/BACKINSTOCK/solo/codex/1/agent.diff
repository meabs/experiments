+package com.salesmanager.core.business.services.catalog.product.stockalert;
+
+import java.util.Date;
+import java.util.List;
+import java.util.Optional;
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.stockalert.StockAlertRepository;
+import com.salesmanager.core.business.repositories.catalog.product.stockalert.StockAlertOutboxRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.description.ProductDescription;
+import com.salesmanager.core.model.catalog.product.stockalert.StockAlert;
+import com.salesmanager.core.model.catalog.product.stockalert.StockAlertOutbox;
+import com.salesmanager.core.model.catalog.product.stockalert.StockAlertStatus;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+    @Inject private StockAlertRepository alertRepository;
+    @Inject private StockAlertOutboxRepository outboxRepository;
+
+    @Override @Transactional
+    public StockAlert createOrFind(String sku, String email, Product product, MerchantStore store) throws ServiceException {
+        Optional<StockAlert> existing = alertRepository.findByProductIdAndMerchantStoreIdAndEmailIgnoreCaseAndStatus(
+                product.getId(), store.getId().longValue(), email, StockAlertStatus.PENDING);
+        if (existing.isPresent()) return existing.get();
+        StockAlert alert = new StockAlert();
+        alert.setProduct(product); alert.setMerchantStore(store); alert.setSku(sku); alert.setEmail(email);
+        return alertRepository.saveAndFlush(alert);
+    }
+
+    @Override
+    public Optional<StockAlert> findPending(Product product, String email, MerchantStore store) {
+        return alertRepository.findByProductIdAndMerchantStoreIdAndEmailIgnoreCaseAndStatus(
+                product.getId(), store.getId().longValue(), email, StockAlertStatus.PENDING);
+    }
+
+    @Override @Transactional
+    public void cancel(Product product, String email, MerchantStore store) throws ServiceException {
+        Optional<StockAlert> existing = alertRepository.findByProductIdAndMerchantStoreIdAndEmailIgnoreCaseAndStatus(
+                product.getId(), store.getId().longValue(), email, StockAlertStatus.PENDING);
+        if (!existing.isPresent()) throw new ServiceException("Stock alert not found");
+        alertRepository.delete(existing.get());
+    }
+
+    @Override public List<StockAlert> list(MerchantStore store, StockAlertStatus status) {
+        return status == null ? alertRepository.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId().longValue())
+                : alertRepository.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(store.getId().longValue(), status);
+    }
+    @Override public List<StockAlertOutbox> outbox(MerchantStore store) {
+        return outboxRepository.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId().longValue());
+    }
+
+    @Override @Transactional
+    public void sendForRestock(Product product, MerchantStore store) throws ServiceException {
+        List<StockAlert> alerts = alertRepository.findByProductIdAndMerchantStoreIdAndStatusOrderByCreatedAtAsc(
+                product.getId(), store.getId().longValue(), StockAlertStatus.PENDING);
+        String name = product.getProductDescription() == null ? product.getSku() : product.getProductDescription().getName();
+        for (StockAlert alert : alerts) {
+            Date now = new Date();
+            alert.setStatus(StockAlertStatus.SENT); alert.setSentAt(now);
+            alertRepository.save(alert);
+            StockAlertOutbox message = new StockAlertOutbox();
+            message.setMerchantStore(store); message.setTo(alert.getEmail()); message.setSku(alert.getSku());
+            message.setSubject(name + " is back in stock"); message.setCreatedAt(now);
+            outboxRepository.save(message);
+        }
+    }
+}
