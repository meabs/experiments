+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.List;
+import java.util.regex.Pattern;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import javax.validation.Valid;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.stockalert.StockAlertService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.stockalert.StockAlertStatus;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.catalog.product.stockalert.*;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class StockAlertApi {
+    private static final Pattern EMAIL = Pattern.compile("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$");
+    @Inject private ProductService productService;
+    @Inject private StockAlertService stockAlertService;
+
+    @PostMapping("/products/{sku}/alerts")
+    public ResponseEntity<StockAlertResponse> create(@PathVariable String sku, @Valid @RequestBody StockAlertRequest request,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language) {
+        validateEmail(request == null ? null : request.getEmail());
+        Product product = product(sku, store);
+        if (!hasStock(product, sku)) return ResponseEntity.status(HttpStatus.CONFLICT).build();
+        try {
+            boolean existing = stockAlertService.findPending(product, request.getEmail(), store).isPresent();
+            com.salesmanager.core.model.catalog.product.stockalert.StockAlert alert = stockAlertService.createOrFind(sku, request.getEmail(), product, store);
+            HttpStatus status = existing ? HttpStatus.OK : HttpStatus.CREATED;
+            return new ResponseEntity<>(StockAlertResponse.from(alert), status);
+        } catch (ServiceException e) { throw new RestApiException(e.getMessage()); }
+    }
+
+    @DeleteMapping("/products/{sku}/alerts")
+    @ResponseStatus(HttpStatus.NO_CONTENT)
+    public void cancel(@PathVariable String sku, @RequestParam String email, @ApiIgnore MerchantStore store) {
+        validateEmail(email); Product product = product(sku, store);
+        try { stockAlertService.cancel(product, email, store); }
+        catch (ServiceException e) { throw new ResourceNotFoundException(e.getMessage()); }
+    }
+
+    @GetMapping("/private/stock-alerts")
+    public List<StockAlertResponse> list(@RequestParam(required = false) String status, @ApiIgnore MerchantStore store) {
+        StockAlertStatus parsed = parseStatus(status);
+        return stockAlertService.list(store, parsed).stream().map(StockAlertResponse::from).collect(Collectors.toList());
+    }
+
+    @GetMapping("/private/stock-alerts/outbox")
+    public List<StockAlertOutboxResponse> outbox(@ApiIgnore MerchantStore store) {
+        return stockAlertService.outbox(store).stream().map(StockAlertOutboxResponse::from).collect(Collectors.toList());
+    }
+
+    private Product product(String sku, MerchantStore store) {
+        try { Product p = productService.getBySku(sku, store); if (p == null) throw new ResourceNotFoundException("Product not found"); return p; }
+        catch (ServiceException e) { throw new ResourceNotFoundException("Product with sku [" + sku + "] not found"); }
+    }
+    private boolean hasStock(Product product, String sku) {
+        return product.getAvailabilities() != null && product.getAvailabilities().stream()
+                .filter(a -> a.getProductVariant() == null || sku.equals(a.getSku()))
+                .anyMatch(a -> a.getProductQuantity() != null && a.getProductQuantity() > 0);
+    }
+    private void validateEmail(String email) { if (email == null || !EMAIL.matcher(email).matches()) throw new RestApiException("Invalid email"); }
+    private StockAlertStatus parseStatus(String status) {
+        if (status == null) return null;
+        try { return StockAlertStatus.valueOf(status); } catch (IllegalArgumentException e) { throw new RestApiException("Invalid status"); }
+    }
+}
