+package com.salesmanager.core.business.services.catalog.product.stock;
+
+import java.util.Date;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.stock.StockAlertRepository;
+import com.salesmanager.core.business.repositories.catalog.product.stock.StockAlertOutboxRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.stock.StockAlert;
+import com.salesmanager.core.model.catalog.product.stock.StockAlertOutbox;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+    private static final String PENDING = "PENDING";
+    private static final String SENT = "SENT";
+    @Inject private StockAlertRepository alerts;
+    @Inject private StockAlertOutboxRepository outbox;
+
+    @Override @Transactional
+    public StockAlert request(Product product, MerchantStore store, String email) throws ServiceException {
+        StockAlert existing = alerts.findFirstByProduct_IdAndMerchantStore_IdAndEmailIgnoreCaseAndStatus(product.getId(), store.getId(), email, PENDING);
+        if (existing != null) return existing;
+        StockAlert alert = new StockAlert(); alert.setProduct(product); alert.setMerchantStore(store); alert.setSku(product.getSku()); alert.setEmail(email); alert.setStatus(PENDING);
+        return alerts.save(alert);
+    }
+    @Override public boolean hasPending(Product product, MerchantStore store, String email) {
+        return alerts.findFirstByProduct_IdAndMerchantStore_IdAndEmailIgnoreCaseAndStatus(product.getId(), store.getId(), email, PENDING) != null;
+    }
+    @Override @Transactional
+    public void cancel(Product product, MerchantStore store, String email) throws ServiceException {
+        StockAlert alert = alerts.findFirstByProduct_IdAndMerchantStore_IdAndEmailIgnoreCaseAndStatus(product.getId(), store.getId(), email, PENDING);
+        if (alert == null) throw new ServiceException("Pending stock alert not found");
+        alerts.delete(alert);
+    }
+    @Override public List<StockAlert> list(MerchantStore store, String status) {
+        return status == null ? alerts.findByMerchantStore_CodeOrderByCreatedAtAsc(store.getCode()) : alerts.findByMerchantStore_CodeAndStatusOrderByCreatedAtAsc(store.getCode(), status);
+    }
+    @Override public List<StockAlertOutbox> outbox(MerchantStore store) { return outbox.findByMerchantStore_CodeOrderByCreatedAtAsc(store.getCode()); }
+    @Override @Transactional
+    public void sendForRestock(Product product, MerchantStore store) throws ServiceException {
+        for (StockAlert alert : alerts.findByProduct_IdAndMerchantStore_IdAndStatusOrderByCreatedAtAsc(product.getId(), store.getId(), PENDING)) {
+            alert.setStatus(SENT); alert.setSentAt(new Date()); alerts.save(alert);
+            StockAlertOutbox message = new StockAlertOutbox(); message.setMerchantStore(store); message.setRecipient(alert.getEmail()); message.setSku(alert.getSku());
+            message.setSubject(productName(product) + " is back in stock"); outbox.save(message);
+        }
+    }
+    private String productName(Product product) {
+        String language = product.getMerchantStore().getDefaultLanguage() == null ? null : product.getMerchantStore().getDefaultLanguage().getCode();
+        return product.getDescriptions().stream().filter(d -> d.getLanguage() != null && (language == null || language.equals(d.getLanguage().getCode()))).map(d -> d.getName()).filter(n -> n != null && !n.isEmpty()).findFirst().orElse(product.getSku());
+    }
+}
