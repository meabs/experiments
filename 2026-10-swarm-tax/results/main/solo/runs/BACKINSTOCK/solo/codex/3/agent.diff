+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.*;
+import java.util.regex.Pattern;
+import java.util.stream.Collectors;
+import javax.validation.Valid;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.*;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.*;
+import springfox.documentation.annotations.ApiIgnore;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.stock.StockAlertService;
+import com.salesmanager.core.business.services.catalog.product.availability.ProductAvailabilityService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.stock.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.stock.*;
+import com.salesmanager.shop.store.api.exception.*;
+
+@Controller @RequestMapping("/api/v1")
+public class StockAlertApi {
+    private static final Pattern EMAIL = Pattern.compile("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$");
+    @Autowired private ProductService productService;
+    @Autowired private ProductAvailabilityService availabilityService;
+    @Autowired private StockAlertService alertService;
+
+    @PostMapping("/products/{sku}/alerts")
+    public ResponseEntity<ReadableStockAlert> request(@PathVariable String sku, @Valid @RequestBody StockAlertRequest request, @ApiIgnore MerchantStore store) {
+        String email = request == null ? null : request.getEmail();
+        if (email == null || !EMAIL.matcher(email.trim()).matches()) throw new RestApiException("400", "Invalid email");
+        Product product = product(sku, store);
+        if (inStock(product, store)) throw new StockAlertConflictException("Product is in stock");
+        try {
+            boolean duplicate = alertService.hasPending(product, store, email.trim());
+            StockAlert alert = alertService.request(product, store, email.trim());
+            return ResponseEntity.status(duplicate ? HttpStatus.OK : HttpStatus.CREATED).body(read(alert));
+        } catch (Exception e) { throw new ServiceRuntimeException("Could not create stock alert", e); }
+    }
+    @DeleteMapping("/products/{sku}/alerts")
+    @ResponseStatus(HttpStatus.NO_CONTENT)
+    public void cancel(@PathVariable String sku, @RequestParam String email, @ApiIgnore MerchantStore store) {
+        if (email == null || !EMAIL.matcher(email.trim()).matches()) throw new RestApiException("400", "Invalid email");
+        Product product = product(sku, store);
+        try { alertService.cancel(product, store, email.trim()); } catch (Exception e) { throw new ResourceNotFoundException("Stock alert not found"); }
+    }
+    @GetMapping("/private/stock-alerts")
+    public List<ReadableStockAlert> list(@RequestParam(required=false) String status, @ApiIgnore MerchantStore store) {
+        if (status != null && !"PENDING".equals(status) && !"SENT".equals(status)) throw new RestApiException("400", "Invalid status");
+        return alertService.list(store, status).stream().map(this::read).collect(Collectors.toList());
+    }
+    @GetMapping("/private/stock-alerts/outbox")
+    public List<ReadableStockAlertOutbox> outbox(@ApiIgnore MerchantStore store) {
+        return alertService.outbox(store).stream().map(this::read).collect(Collectors.toList());
+    }
+    private Product product(String sku, MerchantStore store) {
+        try { Product p = productService.getBySku(sku, store); if (p == null) throw new ResourceNotFoundException("Product not found"); return p; }
+        catch (ResourceNotFoundException e) { throw e; } catch (Exception e) { throw new ResourceNotFoundException("Product not found"); }
+    }
+    private boolean inStock(Product product, MerchantStore store) {
+        return availabilityService.getBySku(product.getSku(), store).stream().anyMatch(a -> a.getProduct().getId().equals(product.getId()) && a.getProductQuantity() != null && a.getProductQuantity() > 0);
+    }
+    private ReadableStockAlert read(StockAlert a) { ReadableStockAlert r=new ReadableStockAlert(); r.setId(a.getId()); r.setSku(a.getSku()); r.setEmail(a.getEmail()); r.setStatus(a.getStatus()); r.setCreatedAt(a.getCreatedAt()); r.setSentAt(a.getSentAt()); return r; }
+    private ReadableStockAlertOutbox read(StockAlertOutbox a) { ReadableStockAlertOutbox r=new ReadableStockAlertOutbox(); r.setTo(a.getRecipient()); r.setSku(a.getSku()); r.setSubject(a.getSubject()); r.setCreatedAt(a.getCreatedAt()); return r; }
+}
