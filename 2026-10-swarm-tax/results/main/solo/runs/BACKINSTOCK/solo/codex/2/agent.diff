+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.List;
+import java.util.stream.Collectors;
+import javax.validation.Valid;
+import javax.validation.constraints.Email;
+import javax.validation.constraints.NotBlank;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.*;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.stock.*;
+import com.salesmanager.core.model.catalog.product.stock.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.*;
+import springfox.documentation.annotations.ApiIgnore;
+
+@Controller
+@RequestMapping("/api/v1")
+public class StockAlertApi {
+    @Autowired private StockAlertService service;
+
+    public static class Request { @NotBlank @Email private String email; public String getEmail(){return email;} public void setEmail(String email){this.email=email;} }
+    public static class ShopperResponse { public String sku,email,status; ShopperResponse(StockAlert a){sku=a.getSku();email=a.getEmail();status=a.getStatus();} }
+    public static class AlertResponse { public Long id; public String sku,email,status; public java.util.Date createdAt,sentAt; AlertResponse(StockAlert a){id=a.getId();sku=a.getSku();email=a.getEmail();status=a.getStatus();createdAt=a.getCreatedAt();sentAt=a.getSentAt();} }
+    public static class MessageResponse { public String to,sku,subject; public java.util.Date createdAt; MessageResponse(StockAlertOutbox m){to=m.getToAddress();sku=m.getSku();subject=m.getSubject();createdAt=m.getCreatedAt();} }
+
+    @PostMapping("/products/{sku}/alerts")
+    public ResponseEntity<ShopperResponse> request(@PathVariable String sku, @Valid @RequestBody Request request, @ApiIgnore MerchantStore store) {
+        if (request.email == null || !request.email.matches("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$")) throw new RestApiException("Invalid email");
+        try { StockAlert alert=service.request(sku, request.email, store); return ResponseEntity.status(alert.isExisting() ? HttpStatus.OK : HttpStatus.CREATED).body(new ShopperResponse(alert)); }
+        catch (StockAlertConflictException e) { throw new StockAlertHttpException("409",e.getMessage()); }
+        catch (com.salesmanager.core.business.exception.ServiceException e) { throw new ResourceNotFoundException("Unknown product sku ["+sku+"]"); }
+    }
+    @DeleteMapping("/products/{sku}/alerts")
+    @ResponseStatus(HttpStatus.NO_CONTENT)
+    public void cancel(@PathVariable String sku, @RequestParam String email, @ApiIgnore MerchantStore store) {
+        if (email == null || !email.matches("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$")) throw new RestApiException("Invalid email");
+        try { service.cancel(sku,email,store); } catch (StockAlertNotFoundException e) { throw new ResourceNotFoundException(e.getMessage()); } catch (com.salesmanager.core.business.exception.ServiceException e) { throw new ResourceNotFoundException("Unknown product sku ["+sku+"]"); }
+    }
+    @GetMapping("/private/stock-alerts")
+    public List<AlertResponse> list(@RequestParam(required=false) String status, @ApiIgnore MerchantStore store) {
+        if(status!=null && !status.equals("PENDING") && !status.equals("SENT")) throw new RestApiException("status must be PENDING or SENT");
+        return service.list(store,status).stream().map(AlertResponse::new).collect(Collectors.toList());
+    }
+    @GetMapping("/private/stock-alerts/outbox")
+    public List<MessageResponse> outbox(@ApiIgnore MerchantStore store) { return service.outbox(store).stream().map(MessageResponse::new).collect(Collectors.toList()); }
+}
