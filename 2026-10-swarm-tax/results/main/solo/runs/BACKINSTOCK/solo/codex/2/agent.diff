+package com.salesmanager.core.business.services.catalog.product.stock;
+import java.util.*;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.stock.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.stock.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+    private final StockAlertRepository alerts;
+    private final StockAlertOutboxRepository outbox;
+    private final ProductService products;
+    public StockAlertServiceImpl(StockAlertRepository alerts, StockAlertOutboxRepository outbox, ProductService products) { this.alerts=alerts; this.outbox=outbox; this.products=products; }
+    public StockAlert request(String sku, String email, MerchantStore store) throws ServiceException {
+        Product product;
+        try { product = products.getBySku(sku, store); } catch (Exception e) { throw new ServiceException("Unknown product sku [" + sku + "]", e); }
+        boolean inStock = product.getAvailabilities() != null && product.getAvailabilities().stream().anyMatch(a -> a.getProductVariant() == null && a.getProductQuantity() != null && a.getProductQuantity() > 0);
+        if (inStock) throw new StockAlertConflictException("Product is already in stock");
+        StockAlert existing = alerts.findByProductIdAndEmailIgnoreCaseAndStatus(product.getId(), email, "PENDING");
+        if (existing != null) { existing.setExisting(true); return existing; }
+        StockAlert alert = new StockAlert(); alert.setProduct(product); alert.setMerchantStore(store); alert.setSku(sku); alert.setEmail(email); alert.setStatus("PENDING"); alert.setCreatedAt(new Date());
+        return alerts.save(alert);
+    }
+    public void cancel(String sku, String email, MerchantStore store) throws ServiceException {
+        Product product; try { product=products.getBySku(sku, store); } catch(Exception e) { throw new ServiceException("Unknown product sku ["+sku+"]",e); }
+        StockAlert alert=alerts.findByProductIdAndEmailIgnoreCaseAndStatus(product.getId(), email, "PENDING");
+        if(alert==null) throw new StockAlertNotFoundException("Pending alert not found");
+        alerts.delete(alert);
+    }
+    public List<StockAlert> list(MerchantStore store, String status) { return status == null ? alerts.findByMerchantStore_IdOrderByCreatedAtAsc(store.getId()) : alerts.findByMerchantStore_IdAndStatusOrderByCreatedAtAsc(store.getId(), status); }
+    public List<StockAlertOutbox> outbox(MerchantStore store) { return outbox.findByMerchantStore_IdOrderByCreatedAtAsc(store.getId()); }
+    @Transactional
+    public void restocked(Product product, int oldQuantity, int newQuantity) {
+        if (oldQuantity <= 0 && newQuantity > 0) for (StockAlert alert : alerts.findByProductIdAndStatusOrderByCreatedAtAsc(product.getId(), "PENDING")) {
+            Date now=new Date(); alert.setStatus("SENT"); alert.setSentAt(now); alerts.save(alert);
+            StockAlertOutbox message=new StockAlertOutbox(); message.setMerchantStore(alert.getMerchantStore()); message.setToAddress(alert.getEmail()); message.setSku(alert.getSku());
+            String name=product.getProductDescription()==null ? product.getSku() : product.getProductDescription().getName(); message.setSubject(name+" is back in stock"); message.setCreatedAt(now); outbox.save(message);
+        }
+    }
+}
