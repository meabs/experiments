+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.*;
+import javax.validation.Valid;
+import javax.validation.constraints.Email;
+import javax.validation.constraints.NotBlank;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.stockalert.StockAlertService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.stockalert.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@Controller
+@RequestMapping("/api/v1")
+public class StockAlertApi {
+    @Autowired private ProductService productService;
+    @Autowired private StockAlertService stockAlertService;
+
+    @PostMapping("/products/{sku}/alerts")
+    public ResponseEntity<AlertResponse> request(@PathVariable String sku, @Valid @RequestBody AlertRequest request, @ApiIgnore MerchantStore store) {
+        Product product = product(sku, store);
+        if (inStock(product)) throw new StockAlertConflictException("Product is in stock");
+        boolean existing = stockAlertService.hasPending(product, store, request.email);
+        return ResponseEntity.status(existing ? HttpStatus.OK : HttpStatus.CREATED).body(AlertResponse.of(stockAlertService.request(product, store, request.email)));
+    }
+
+    @DeleteMapping("/products/{sku}/alerts")
+    @ResponseStatus(HttpStatus.NO_CONTENT)
+    public void cancel(@PathVariable String sku, @RequestParam String email, @ApiIgnore MerchantStore store) {
+        Product product = product(sku, store);
+        try { stockAlertService.cancel(product, store, validatedEmail(email)); }
+        catch (NoSuchElementException e) { throw new ResourceNotFoundException("Pending stock alert not found"); }
+    }
+
+    @GetMapping("/private/stock-alerts")
+    @ResponseBody
+    public List<AlertResponse> list(@RequestParam(required = false) String status, @ApiIgnore MerchantStore store) {
+        StockAlertStatus parsed = parseStatus(status);
+        List<AlertResponse> result = new ArrayList<>();
+        for (StockAlert alert : stockAlertService.list(store, parsed)) result.add(AlertResponse.of(alert));
+        return result;
+    }
+
+    @GetMapping("/private/stock-alerts/outbox")
+    @ResponseBody
+    public List<OutboxResponse> outbox(@ApiIgnore MerchantStore store) {
+        List<OutboxResponse> result = new ArrayList<>();
+        for (StockAlertOutbox message : stockAlertService.outbox(store)) result.add(OutboxResponse.of(message));
+        return result;
+    }
+
+    private Product product(String sku, MerchantStore store) {
+        try {
+            Product product = productService.getBySku(sku, store);
+            if (product == null) throw new ResourceNotFoundException("Product with sku [" + sku + "] not found");
+            return product;
+        } catch (com.salesmanager.core.business.exception.ServiceException e) { throw new ResourceNotFoundException("Product with sku [" + sku + "] not found"); }
+    }
+    private boolean inStock(Product product) { for (ProductAvailability a : product.getAvailabilities()) if (a.getProductQuantity() != null && a.getProductQuantity() > 0) return true; return false; }
+    private String validatedEmail(String email) { if (email == null || !email.matches("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$")) throw new RestApiException("Invalid email"); return email; }
+    private StockAlertStatus parseStatus(String status) { if (status == null) return null; try { return StockAlertStatus.valueOf(status); } catch (IllegalArgumentException e) { throw new RestApiException("Invalid status"); } }
+
+    public static class AlertRequest { @NotBlank @Email public String email; }
+    public static class AlertResponse {
+        public Long id; public String sku; public String email; public StockAlertStatus status; public Date createdAt; public Date sentAt;
+        static AlertResponse of(StockAlert a) { AlertResponse r = new AlertResponse(); r.id=a.getId(); r.sku=a.getSku(); r.email=a.getEmail(); r.status=a.getStatus(); r.createdAt=a.getCreatedAt(); r.sentAt=a.getSentAt(); return r; }
+    }
+    public static class OutboxResponse {
+        public String to; public String sku; public String subject; public Date createdAt;
+        static OutboxResponse of(StockAlertOutbox m) { OutboxResponse r=new OutboxResponse(); r.to=m.getToEmail(); r.sku=m.getSku(); r.subject=m.getSubject(); r.createdAt=m.getCreatedAt(); return r; }
+    }
+}
