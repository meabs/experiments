+package com.salesmanager.core.business.services.catalog.product.stockalert;
+
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.stockalert.*;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.stockalert.*;
+import com.salesmanager.core.model.catalog.product.description.ProductDescription;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+    @Inject private StockAlertRepository alertRepository;
+    @Inject private StockAlertOutboxRepository outboxRepository;
+
+    @Override @Transactional
+    public StockAlert request(Product product, MerchantStore store, String email) {
+        StockAlert existing = alertRepository.findByProductIdAndMerchantStoreIdAndEmailIgnoreCaseAndStatus(product.getId(), store.getId().longValue(), email, StockAlertStatus.PENDING);
+        if (existing != null) return existing;
+        StockAlert alert = new StockAlert(); alert.setProduct(product); alert.setMerchantStore(store); alert.setSku(product.getSku()); alert.setEmail(email); alert.setStatus(StockAlertStatus.PENDING);
+        return alertRepository.saveAndFlush(alert);
+    }
+    @Override @Transactional(readOnly = true)
+    public boolean hasPending(Product product, MerchantStore store, String email) {
+        return alertRepository.findByProductIdAndMerchantStoreIdAndEmailIgnoreCaseAndStatus(product.getId(), store.getId().longValue(), email, StockAlertStatus.PENDING) != null;
+    }
+    @Override @Transactional
+    public void cancel(Product product, MerchantStore store, String email) {
+        StockAlert alert = alertRepository.findByProductIdAndMerchantStoreIdAndEmailIgnoreCaseAndStatus(product.getId(), store.getId().longValue(), email, StockAlertStatus.PENDING);
+        if (alert == null) throw new NoSuchElementException("Pending stock alert not found");
+        alertRepository.delete(alert); alertRepository.flush();
+    }
+    @Override @Transactional(readOnly = true)
+    public List<StockAlert> list(MerchantStore store, StockAlertStatus status) {
+        return status == null ? alertRepository.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId().longValue()) : alertRepository.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(store.getId().longValue(), status);
+    }
+    @Override @Transactional(readOnly = true)
+    public List<StockAlertOutbox> outbox(MerchantStore store) { return outboxRepository.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId().longValue()); }
+    @Override @Transactional
+    public void sendPending(Product product, MerchantStore store) {
+        List<StockAlert> alerts = alertRepository.findByProductIdAndMerchantStoreIdAndStatusOrderByCreatedAtAsc(product.getId(), store.getId().longValue(), StockAlertStatus.PENDING);
+        if (alerts.isEmpty()) return;
+        String name = product.getSku();
+        for (ProductDescription description : product.getDescriptions()) { if (description.getName() != null) { name = description.getName(); break; } }
+        Date now = new Date();
+        for (StockAlert alert : alerts) {
+            alert.setStatus(StockAlertStatus.SENT); alert.setSentAt(now);
+            StockAlertOutbox message = new StockAlertOutbox(); message.setMerchantStore(store); message.setToEmail(alert.getEmail()); message.setSku(alert.getSku()); message.setSubject(name + " is back in stock"); message.setCreatedAt(now); outboxRepository.save(message);
+        }
+        alertRepository.saveAll(alerts); alertRepository.flush(); outboxRepository.flush();
+    }
+}
