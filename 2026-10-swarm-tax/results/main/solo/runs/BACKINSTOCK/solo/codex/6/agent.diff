+    public List<StockAlertResponse> list(@RequestParam(required=false) String status, @ApiIgnore MerchantStore store) {
+        StockAlertStatus parsed = null;
+        if (status != null) try { parsed=StockAlertStatus.valueOf(status); } catch (IllegalArgumentException e) { throw new StockAlertBadRequestException("Invalid status"); }
+        return service.list(store, parsed).stream().map(StockAlertResponse::new).collect(Collectors.toList());
+    }
+    @GetMapping("/private/stock-alerts/outbox")
+    public List<StockAlertOutboxResponse> outbox(@ApiIgnore MerchantStore store) { return service.outbox(store).stream().map(StockAlertOutboxResponse::new).collect(Collectors.toList()); }
+    private void validateEmail(String email) { if (email == null || !EMAIL.matcher(email).matches()) throw new StockAlertBadRequestException("Invalid email"); }
+}
