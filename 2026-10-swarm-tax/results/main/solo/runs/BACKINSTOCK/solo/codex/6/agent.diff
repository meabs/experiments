+package com.salesmanager.core.business.services.catalog.product.stockalert;
+
+import java.util.*;
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.exception.StockAlertNotFoundException;
+import com.salesmanager.core.business.exception.StockAlertConflictException;
+import com.salesmanager.core.business.repositories.catalog.product.stockalert.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.stockalert.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.catalog.product.description.ProductDescription;
+
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+    @Inject private StockAlertRepository alerts;
+    @Inject private StockAlertOutboxRepository outbox;
+    @Inject private ProductService products;
+
+    private Product product(String sku, MerchantStore store) {
+        try { return products.getBySku(sku, store); }
+        catch (ServiceException e) { throw new StockAlertNotFoundException("Product not found"); }
+    }
+
+    @Override @Transactional
+    public StockAlert request(String sku, String email, MerchantStore store) throws ServiceException {
+        Product product = product(sku, store);
+        if (product == null) throw new StockAlertNotFoundException("Product not found");
+        int quantity = product.getAvailabilities().stream().mapToInt(a -> a.getProductQuantity()).sum();
+        if (quantity > 0) throw new StockAlertConflictException("Product is in stock");
+        StockAlert existing = alerts.findFirstByProductIdAndEmailIgnoreCaseAndStatus(product.getId(), email, StockAlertStatus.PENDING);
+        if (existing != null) { existing.setExistingRequest(true); return existing; }
+        StockAlert alert = new StockAlert(); alert.setProduct(product); alert.setMerchantStore(store); alert.setEmail(email);
+        return alerts.saveAndFlush(alert);
+    }
+    @Override @Transactional
+    public void cancel(String sku, String email, MerchantStore store) throws ServiceException {
+        Product product = product(sku, store);
+        if (product == null) throw new StockAlertNotFoundException("Product not found");
+        StockAlert alert = alerts.findFirstByProductIdAndEmailIgnoreCaseAndStatus(product.getId(), email, StockAlertStatus.PENDING);
+        if (alert == null) throw new StockAlertNotFoundException("Alert not found");
+        alerts.delete(alert);
+    }
+    public List<StockAlert> list(MerchantStore store, StockAlertStatus status) {
+        return status == null ? alerts.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId()) : alerts.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(store.getId(), status);
+    }
+    public List<StockAlertOutbox> outbox(MerchantStore store) { return outbox.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId()); }
+    @Override @Transactional
+    public void dispatch(ProductAvailability availability) throws ServiceException {
+        if (availability.getProductQuantity() <= 0) return;
+        Product product = availability.getProduct();
+        List<StockAlert> pending = alerts.findByProductIdAndStatusOrderByCreatedAtAsc(product.getId(), StockAlertStatus.PENDING);
+        String name = product.getSku(); ProductDescription description = product.getProductDescription();
+        if (description != null && description.getName() != null) name = description.getName();
+        Date now = new Date();
+        for (StockAlert alert : pending) {
+            alert.setStatus(StockAlertStatus.SENT); alert.setSentAt(now); alerts.save(alert);
+            StockAlertOutbox message = new StockAlertOutbox(); message.setMerchantStore(alert.getMerchantStore()); message.setTo(alert.getEmail()); message.setSku(product.getSku()); message.setSubject(name + " is back in stock"); outbox.save(message);
+        }
+    }
+}
