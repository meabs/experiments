+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.*;
+import java.util.regex.Pattern;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.*;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.stockalert.ProductStockAlertService;
+import com.salesmanager.core.business.services.catalog.product.stockalert.ProductStockAlertServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.stockalert.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.stockalert.*;
+import com.salesmanager.shop.store.api.exception.*;
+import springfox.documentation.annotations.ApiIgnore;
+
+@Controller
+@RequestMapping("/api/v1")
+public class ProductStockAlertApi {
+    private static final Pattern EMAIL = Pattern.compile("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$");
+    @Autowired private ProductService productService;
+    @Autowired private ProductStockAlertService alertService;
+
+    @PostMapping("/products/{sku}/alerts") @ResponseBody public ResponseEntity<StockAlertResponse> request(@PathVariable String sku, @RequestBody StockAlertRequest request, @ApiIgnore MerchantStore store) {
+        validateEmail(request == null ? null : request.getEmail());
+        Product product = product(sku, store);
+        if (product.getAvailabilities() != null && product.getAvailabilities().stream().anyMatch(a -> a.getProductQuantity() != null && a.getProductQuantity() > 0)) throw new StockAlertConflictException("Product is in stock");
+        boolean duplicate = alertService.hasPending(product, store, request.getEmail());
+        ProductStockAlert alert = alertService.request(product, store, request.getEmail());
+        return ResponseEntity.status(duplicate ? HttpStatus.OK : HttpStatus.CREATED).body(response(alert));
+    }
+
+    @DeleteMapping("/products/{sku}/alerts") @ResponseStatus(HttpStatus.NO_CONTENT)
+    public void cancel(@PathVariable String sku, @RequestParam String email, @ApiIgnore MerchantStore store) {
+        validateEmail(email); Product product = product(sku, store);
+        try { alertService.cancel(product, store, email); } catch (NoSuchElementException e) { throw new ResourceNotFoundException(e.getMessage()); }
+    }
+
+    @GetMapping("/private/stock-alerts") @ResponseBody
+    public List<StockAlertResponse> list(@RequestParam(required=false) String status, @ApiIgnore MerchantStore store) {
+        if (status != null && !ProductStockAlertServiceImpl.PENDING.equals(status) && !ProductStockAlertServiceImpl.SENT.equals(status)) throw new RestApiException("Invalid stock alert status");
+        List<StockAlertResponse> result = new ArrayList<>(); for (ProductStockAlert a : alertService.list(store, status)) result.add(response(a)); return result;
+    }
+
+    @GetMapping("/private/stock-alerts/outbox") @ResponseBody
+    public List<StockAlertOutboxResponse> outbox(@ApiIgnore MerchantStore store) {
+        List<StockAlertOutboxResponse> result = new ArrayList<>();
+        for (StockAlertOutboxMessage m : alertService.outbox(store)) { StockAlertOutboxResponse r = new StockAlertOutboxResponse(); r.setTo(m.getRecipient()); r.setSku(m.getProduct().getSku()); r.setSubject(m.getProduct().getProductDescription().getName() + " is back in stock"); r.setCreatedAt(m.getCreatedAt()); result.add(r); } return result;
+    }
+    private Product product(String sku, MerchantStore store) { try { Product p=productService.getBySku(sku, store); if(p==null) throw new ResourceNotFoundException("Product not found"); return p; } catch(com.salesmanager.core.business.exception.ServiceException e) { throw new ServiceRuntimeException("Unable to find product", e); } }
+    private void validateEmail(String email) { if(email==null || !EMAIL.matcher(email).matches()) throw new RestApiException("Invalid email"); }
+    private StockAlertResponse response(ProductStockAlert a) { StockAlertResponse r=new StockAlertResponse(); r.setId(a.getId()); r.setSku(a.getProduct().getSku()); r.setEmail(a.getEmail()); r.setStatus(a.getStatus()); r.setCreatedAt(a.getCreatedAt()); r.setSentAt(a.getSentAt()); return r; }
+}
