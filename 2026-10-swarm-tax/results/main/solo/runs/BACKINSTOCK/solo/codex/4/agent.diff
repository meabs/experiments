+package com.salesmanager.core.business.services.catalog.product.stockalert;
+
+import java.util.*;
+import javax.transaction.Transactional;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.stockalert.*;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.stockalert.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productStockAlertService")
+public class ProductStockAlertServiceImpl implements ProductStockAlertService {
+    public static final String PENDING = "PENDING", SENT = "SENT";
+    private final ProductStockAlertRepository alerts;
+    private final StockAlertOutboxRepository outbox;
+    public ProductStockAlertServiceImpl(ProductStockAlertRepository alerts, StockAlertOutboxRepository outbox) { this.alerts = alerts; this.outbox = outbox; }
+
+    public ProductStockAlert request(Product product, MerchantStore store, String email) {
+        ProductStockAlert existing = alerts.findFirstByProductIdAndMerchantStoreIdAndEmailIgnoreCaseAndStatus(product.getId(), store.getId(), email, PENDING);
+        if (existing != null) return existing;
+        ProductStockAlert alert = new ProductStockAlert(); alert.setProduct(product); alert.setMerchantStore(store); alert.setEmail(email); alert.setStatus(PENDING); alert.setCreatedAt(new Date());
+        return alerts.save(alert);
+    }
+    public boolean hasPending(Product product, MerchantStore store, String email) { return alerts.findFirstByProductIdAndMerchantStoreIdAndEmailIgnoreCaseAndStatus(product.getId(), store.getId(), email, PENDING) != null; }
+    public void cancel(Product product, MerchantStore store, String email) {
+        ProductStockAlert alert = alerts.findFirstByProductIdAndMerchantStoreIdAndEmailIgnoreCaseAndStatus(product.getId(), store.getId(), email, PENDING);
+        if (alert == null) throw new NoSuchElementException("Pending stock alert not found");
+        alerts.delete(alert);
+    }
+    public List<ProductStockAlert> list(MerchantStore store, String status) { return status == null ? alerts.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId()) : alerts.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(store.getId(), status); }
+    public List<StockAlertOutboxMessage> outbox(MerchantStore store) { return outbox.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId()); }
+    @Transactional
+    public void restocked(Product product, MerchantStore store) {
+        Date now = new Date();
+        for (ProductStockAlert alert : alerts.findByProductIdAndMerchantStoreIdAndStatusOrderByCreatedAtAsc(product.getId(), store.getId(), PENDING)) {
+            alert.setStatus(SENT); alert.setSentAt(now); alerts.save(alert);
+            StockAlertOutboxMessage message = new StockAlertOutboxMessage(); message.setProduct(product); message.setMerchantStore(store); message.setRecipient(alert.getEmail()); message.setCreatedAt(now); outbox.save(message);
+        }
+    }
+}
