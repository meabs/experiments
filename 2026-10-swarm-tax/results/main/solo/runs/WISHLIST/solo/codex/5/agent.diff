+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.security.Principal;
+import java.math.BigDecimal;
+import java.util.*;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.*;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.business.services.customer.WishlistService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.WishlistItem;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.model.wishlist.*;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController @RequestMapping("/api/v1/auth/customer/wishlist")
+public class WishlistApi {
+ @Inject private WishlistService wishlistService; @Inject private ProductService productService; @Inject private CustomerService customerService; @Inject private ShoppingCartFacade cartFacade;
+ private Customer customer(Principal p, MerchantStore s){ if(p==null) throw new org.springframework.security.authentication.BadCredentialsException("Customer authentication required"); Customer c=customerService.getByNick(p.getName(),s.getId()); if(c==null) throw new ResourceNotFoundException("Customer not found"); return c; }
+ private Integer store(MerchantStore s){return s.getId();}
+ private Product product(String sku,MerchantStore s){ try { Product p=productService.getBySku(sku,s); if(p==null) throw new ResourceNotFoundException("Product not found"); return p; } catch(Exception e){if(e instanceof ResourceNotFoundException) throw (ResourceNotFoundException)e; throw new ServiceRuntimeException(e);} }
+ private WishlistResponse response(Customer c,MerchantStore s){ WishlistResponse r=new WishlistResponse(); List<WishlistItem> rows=wishlistService.list(c.getId(),store(s)); for(WishlistItem row:rows){ Product p=product(row.getSku(),s); com.salesmanager.shop.model.wishlist.WishlistItem x=new com.salesmanager.shop.model.wishlist.WishlistItem(); x.setSku(row.getSku()); x.setAddedAt(row.getAddedAt()); x.setName(p.getDescriptions().isEmpty()?p.getSku():p.getDescriptions().iterator().next().getName()); BigDecimal price=BigDecimal.ZERO; boolean hasStock=false; boolean enabled=false; for(ProductAvailability a:p.getAvailabilities()){if(a.getProductQuantity()!=null&&a.getProductQuantity()>0){hasStock=true; enabled=enabled||a.getProductStatus();} if(a.defaultPrice()!=null&&a.defaultPrice().getProductPriceAmount()!=null) price=a.defaultPrice().getProductPriceAmount();} x.setPrice(price); x.setAvailable(p.isAvailable()&&hasStock&&enabled); r.getItems().add(x);} r.setCount(r.getItems().size()); return r; }
+ @GetMapping public WishlistResponse get(Principal p,@ApiIgnore MerchantStore s){return response(customer(p,s),s);}
+ @PostMapping public ResponseEntity<WishlistResponse> add(@RequestBody WishlistRequest request,Principal p,@ApiIgnore MerchantStore s){if(request==null||request.getProduct()==null||request.getProduct().isBlank()) throw new WishlistBadRequestException("product is required"); Customer c=customer(p,s); Product prod=product(request.getProduct(),s); WishlistItem old=wishlistService.find(c.getId(),store(s),prod.getSku()); if(old!=null)return ResponseEntity.ok(response(c,s)); if(wishlistService.list(c.getId(),store(s)).size()>=50) throw new WishlistBadRequestException("Wishlist cannot contain more than 50 products"); WishlistItem row=new WishlistItem(); row.setCustomerId(c.getId()); row.setMerchantId(store(s)); row.setProductId(prod.getId()); row.setSku(prod.getSku()); row.setAddedAt(new Date()); wishlistService.save(row); return ResponseEntity.status(HttpStatus.CREATED).body(response(c,s)); }
+ @DeleteMapping("/{sku}") public ResponseEntity<Void> remove(@PathVariable String sku,Principal p,@ApiIgnore MerchantStore s){Customer c=customer(p,s); if(wishlistService.find(c.getId(),store(s),sku)==null)throw new ResourceNotFoundException("Wishlist item not found"); wishlistService.delete(c.getId(),store(s),sku); return ResponseEntity.noContent().build();}
+ @PostMapping("/{sku}/cart/{cartCode}") public ResponseEntity<ReadableShoppingCart> move(@PathVariable String sku,@PathVariable String cartCode,Principal p,@ApiIgnore MerchantStore s,@ApiIgnore Language language){Customer c=customer(p,s); WishlistItem row=wishlistService.find(c.getId(),store(s),sku); if(row==null)throw new ResourceNotFoundException("Wishlist item not found"); Product prod=product(sku,s); boolean available=prod.isAvailable()&&prod.getAvailabilities().stream().anyMatch(a->a.getProductStatus()&&a.getProductQuantity()!=null&&a.getProductQuantity()>0); if(!available)throw new WishlistConflictException("Product is not available"); try {com.salesmanager.core.model.shoppingcart.ShoppingCart cart=cartFacade.getShoppingCartModel(cartCode,s); if(cart==null)throw new ResourceNotFoundException("Cart not found"); int quantity=1; for(com.salesmanager.core.model.shoppingcart.ShoppingCartItem i:cart.getLineItems())if(sku.equals(i.getSku()))quantity=i.getQuantity()+1; PersistableShoppingCartItem item=new PersistableShoppingCartItem(); item.setProduct(sku); item.setQuantity(quantity); ReadableShoppingCart result=cartFacade.modifyCart(cartCode,item,s,language); wishlistService.delete(c.getId(),store(s),sku); return ResponseEntity.ok(result); } catch(ResourceNotFoundException e){throw e;} catch(Exception e){throw new ServiceRuntimeException(e);} }
+}
