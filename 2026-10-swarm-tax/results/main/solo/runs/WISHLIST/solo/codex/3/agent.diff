+package com.salesmanager.core.business.services.wishlist;
+
+import java.util.Date;
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.wishlist.WishlistItemRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.wishlist.WishlistItem;
+
+@Service("wishlistService")
+public class WishlistServiceImpl implements WishlistService {
+    @Inject private WishlistItemRepository repository;
+
+    @Override @Transactional(readOnly = true)
+    public List<WishlistItem> list(Customer customer, MerchantStore store) { return repository.findByCustomerAndStore(customer.getId(), store.getId()); }
+    @Override @Transactional(readOnly = true)
+    public WishlistItem find(Customer customer, MerchantStore store, String sku) { return repository.findByCustomerStoreSku(customer.getId(), store.getId(), sku); }
+    @Override @Transactional
+    public WishlistItem add(Customer customer, Product product) {
+        WishlistItem item = new WishlistItem(); item.setCustomerId(customer.getId()); item.setProduct(product); item.setAddedAt(new Date()); return repository.saveAndFlush(item);
+    }
+    @Override @Transactional
+    public void remove(WishlistItem item) { repository.delete(item); }
+    @Override @Transactional
+    public void removeForProduct(Product product) { repository.deleteAll(repository.findByProductId(product.getId())); }
+    @Override @Transactional(readOnly = true)
+    public List<Object[]> popular(MerchantStore store) { return repository.popular(store.getId()); }
+}
