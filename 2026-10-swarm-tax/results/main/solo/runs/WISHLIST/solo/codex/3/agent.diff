+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.math.BigDecimal;
+import java.security.Principal;
+import java.util.ArrayList;
+import java.util.List;
+
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.pricing.PricingService;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.business.services.shoppingcart.ShoppingCartService;
+import com.salesmanager.core.business.services.wishlist.WishlistService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.FinalPrice;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+import com.salesmanager.core.model.wishlist.WishlistItem;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.model.wishlist.WishlistItemResponse;
+import com.salesmanager.shop.model.wishlist.WishlistRequest;
+import com.salesmanager.shop.model.wishlist.WishlistResponse;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.api.exception.WishlistConflictException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/auth/customer/wishlist")
+public class WishlistApi {
+    @Inject private WishlistService wishlistService;
+    @Inject private ProductService productService;
+    @Inject private CustomerFacade customerFacade;
+    @Inject private PricingService pricingService;
+    @Inject private ShoppingCartService shoppingCartService;
+    @Inject private ShoppingCartFacade shoppingCartFacade;
+
+    @PostMapping
+    public ResponseEntity<WishlistResponse> add(@RequestBody WishlistRequest request, @ApiIgnore MerchantStore store,
+            HttpServletRequest httpRequest) throws Exception {
+        if (request == null || request.getProduct() == null || request.getProduct().trim().isEmpty()) throw new ServiceRuntimeException("400", "product is required");
+        Customer customer = customer(httpRequest, store);
+        WishlistItem existing = wishlistService.find(customer, store, request.getProduct());
+        if (existing != null) return ResponseEntity.ok(response(customer, store));
+        List<WishlistItem> current = wishlistService.list(customer, store);
+        if (current.size() >= 50) throw new ServiceRuntimeException("400", "Wishlist cannot contain more than 50 products");
+        Product product;
+        try {
+            product = productService.getBySku(request.getProduct(), store, store.getDefaultLanguage());
+        } catch (Exception e) {
+            throw new ResourceNotFoundException("Product sku [" + request.getProduct() + "] not found");
+        }
+        if (product == null) throw new ResourceNotFoundException("Product sku [" + request.getProduct() + "] not found");
+        wishlistService.add(customer, product);
+        return new ResponseEntity<>(response(customer, store), HttpStatus.CREATED);
+    }
+
+    @GetMapping
+    public WishlistResponse get(@ApiIgnore MerchantStore store, HttpServletRequest request) throws Exception { return response(customer(request, store), store); }
+
+    @DeleteMapping("/{sku}")
+    public ResponseEntity<Void> remove(@PathVariable String sku, @ApiIgnore MerchantStore store, HttpServletRequest request) throws Exception {
+        WishlistItem item = wishlistService.find(customer(request, store), store, sku);
+        if (item == null) throw new ResourceNotFoundException("Product sku [" + sku + "] is not on the wishlist");
+        wishlistService.remove(item);
+        return ResponseEntity.noContent().build();
+    }
+
+    @PostMapping("/{sku}/cart/{cartCode}")
+    public ResponseEntity<ReadableShoppingCart> move(@PathVariable String sku, @PathVariable String cartCode,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest request) throws Exception {
+        Customer customer = customer(request, store);
+        WishlistItem item = wishlistService.find(customer, store, sku);
+        if (item == null) throw new ResourceNotFoundException("Product sku [" + sku + "] is not on the wishlist");
+        Product product = item.getProduct();
+        if (!available(product)) throw new WishlistConflictException("Product sku [" + sku + "] is not available");
+        ShoppingCart cart = shoppingCartService.getByCode(cartCode, store);
+        if (cart == null) throw new ResourceNotFoundException("Cart code [" + cartCode + "] not found");
+        int quantity = 1;
+        for (ShoppingCartItem cartItem : cart.getLineItems()) if (sku.equals(cartItem.getSku())) quantity = cartItem.getQuantity() + 1;
+        PersistableShoppingCartItem add = new PersistableShoppingCartItem(); add.setProduct(sku); add.setQuantity(quantity);
+        ReadableShoppingCart result = shoppingCartFacade.modifyCart(cartCode, add, store, language == null ? store.getDefaultLanguage() : language);
+        wishlistService.remove(item);
+        return ResponseEntity.ok(result);
+    }
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) throws Exception {
+        Principal principal = request.getUserPrincipal();
+        if (principal == null) throw new com.salesmanager.shop.store.api.exception.UnauthorizedException();
+        Customer customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (customer == null) throw new ResourceNotFoundException("Customer not found");
+        return customer;
+    }
+
+    private WishlistResponse response(Customer customer, MerchantStore store) throws Exception {
+        List<WishlistItemResponse> items = new ArrayList<>();
+        for (WishlistItem item : wishlistService.list(customer, store)) {
+            Product p = item.getProduct();
+            FinalPrice finalPrice = pricingService.calculateProductPrice(p);
+            BigDecimal price = finalPrice == null ? null : finalPrice.getFinalPrice();
+            String name = p.getProductDescription() == null ? null : p.getProductDescription().getName();
+            items.add(new WishlistItemResponse(p.getSku(), name, price, available(p), item.getAddedAt()));
+        }
+        return new WishlistResponse(items);
+    }
+
+    private boolean available(Product product) {
+        if (!product.isAvailable()) return false;
+        for (ProductAvailability availability : product.getAvailabilities()) {
+            if (Boolean.FALSE.equals(availability.getAvailable())) continue;
+            if (availability.getProductQuantity() != null && availability.getProductQuantity() > 0) return true;
+        }
+        return false;
+    }
+}
