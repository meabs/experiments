+package com.salesmanager.core.business.services.customer;
+
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.customer.WishlistItemRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.WishlistItem;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("wishlistService")
+public class WishlistServiceImpl implements WishlistService {
+    private final WishlistItemRepository repository;
+
+    @Inject
+    public WishlistServiceImpl(WishlistItemRepository repository) {
+        this.repository = repository;
+    }
+
+    @Override
+    public List<WishlistItem> list(Customer customer, MerchantStore store) {
+        return repository.findByCustomerAndMerchantStoreOrderByAddedAtDescIdDesc(customer, store);
+    }
+
+    @Override
+    public WishlistItem find(Customer customer, MerchantStore store, Product product) {
+        return repository.findByCustomerAndMerchantStoreAndProduct(customer, store, product);
+    }
+
+    @Override
+    public WishlistItem add(Customer customer, MerchantStore store, Product product) throws ServiceException {
+        WishlistItem item = new WishlistItem();
+        item.setCustomer(customer);
+        item.setMerchantStore(store);
+        item.setProduct(product);
+        repository.saveAndFlush(item);
+        return item;
+    }
+
+    @Override
+    public void remove(Customer customer, MerchantStore store, Product product) throws ServiceException {
+        WishlistItem item = find(customer, store, product);
+        if (item != null) repository.delete(item);
+    }
+
+    @Override
+    public void removeProduct(Product product) throws ServiceException {
+        repository.deleteAll(repository.findByProduct(product));
+    }
+
+    @Override
+    public List<WishlistItem> listForStore(MerchantStore store) {
+        return repository.findByMerchantStore(store);
+    }
+}
