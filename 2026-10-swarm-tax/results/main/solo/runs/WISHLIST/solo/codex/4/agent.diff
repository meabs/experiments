+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.math.BigDecimal;
+import java.security.Principal;
+import java.time.Instant;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.customer.WishlistService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+import com.salesmanager.core.model.catalog.product.description.ProductDescription;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.WishlistItem;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.customer.PopularWishlistProduct;
+import com.salesmanager.shop.model.customer.Wishlist;
+import com.salesmanager.shop.model.customer.WishlistRequest;
+import com.salesmanager.shop.store.api.exception.BadRequestException;
+import com.salesmanager.shop.store.api.exception.ConflictException;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+
+@RestController
+@RequestMapping("/api/v1")
+public class WishlistApi {
+    private static final int MAX_ITEMS = 50;
+
+    @Inject private WishlistService wishlistService;
+    @Inject private ProductService productService;
+    @Inject private CustomerFacade customerFacade;
+    @Inject private ShoppingCartFacade shoppingCartFacade;
+
+    @PostMapping("/auth/customer/wishlist")
+    public ResponseEntity<Wishlist> add(@RequestBody WishlistRequest request, Principal principal,
+            MerchantStore store, Language language) {
+        if (request == null || request.getProduct() == null || request.getProduct().trim().isEmpty())
+            throw new BadRequestException("product is required");
+        Customer customer = customer(principal, store);
+        Product product = product(request.getProduct(), store, language);
+        if (wishlistService.find(customer, store, product) != null)
+            return ResponseEntity.ok(read(customer, store, language));
+        if (wishlistService.list(customer, store).size() >= MAX_ITEMS)
+            throw new BadRequestException("A wishlist can contain at most 50 products");
+        try {
+            wishlistService.add(customer, store, product);
+        } catch (ServiceException e) {
+            throw new ServiceRuntimeException(e);
+        }
+        return ResponseEntity.status(HttpStatus.CREATED).body(read(customer, store, language));
+    }
+
+    @GetMapping("/auth/customer/wishlist")
+    public Wishlist get(Principal principal, MerchantStore store, Language language) {
+        return read(customer(principal, store), store, language);
+    }
+
+    @DeleteMapping("/auth/customer/wishlist/{sku}")
+    public ResponseEntity<Void> remove(@PathVariable String sku, Principal principal,
+            MerchantStore store, Language language) {
+        Customer customer = customer(principal, store);
+        Product product = product(sku, store, language);
+        if (wishlistService.find(customer, store, product) == null)
+            throw new ResourceNotFoundException("Product is not on the wishlist");
+        try {
+            wishlistService.remove(customer, store, product);
+        } catch (ServiceException e) {
+            throw new ServiceRuntimeException(e);
+        }
+        return ResponseEntity.noContent().build();
+    }
+
+    @PostMapping("/auth/customer/wishlist/{sku}/cart/{cartCode}")
+    public ResponseEntity<ReadableShoppingCart> moveToCart(@PathVariable String sku, @PathVariable String cartCode,
+            Principal principal, MerchantStore store, Language language) {
+        Customer customer = customer(principal, store);
+        Product product = product(sku, store, language);
+        if (wishlistService.find(customer, store, product) == null)
+            throw new ResourceNotFoundException("Product is not on the wishlist");
+        if (!available(product))
+            throw new ConflictException("Product is not available or has no stock");
+        try {
+            com.salesmanager.core.model.shoppingcart.ShoppingCart cart = shoppingCartFacade.getShoppingCartModel(cartCode, store);
+            if (cart == null) throw new ResourceNotFoundException("Cart code [" + cartCode + "] not found");
+            int quantity = 1;
+            if (cart.getLineItems() != null) {
+                for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem item : cart.getLineItems()) {
+                    if (item.getProduct() != null && product.getId().equals(item.getProduct().getId())) {
+                        quantity = item.getQuantity() + 1;
+                        break;
+                    }
+                }
+            }
+            PersistableShoppingCartItem cartItem = new PersistableShoppingCartItem();
+            cartItem.setProduct(sku);
+            cartItem.setQuantity(quantity);
+            ReadableShoppingCart result = shoppingCartFacade.modifyCart(cartCode, cartItem, store, language);
+            wishlistService.remove(customer, store, product);
+            return ResponseEntity.ok(result);
+        } catch (ResourceNotFoundException e) {
+            throw e;
+        } catch (ServiceException e) {
+            throw new ResourceNotFoundException("Product with sku " + sku + " does not exist");
+        } catch (Exception e) {
+            throw new ServiceRuntimeException(e);
+        }
+    }
+
+    @GetMapping("/private/wishlists/popular")
+    public List<PopularWishlistProduct> popular(MerchantStore store) {
+        Map<String, Long> counts = new HashMap<>();
+        for (WishlistItem item : wishlistService.listForStore(store)) {
+            if (item.getProduct() != null && item.getProduct().getSku() != null)
+                counts.merge(item.getProduct().getSku(), 1L, Long::sum);
+        }
+        List<PopularWishlistProduct> result = new ArrayList<>();
+        counts.entrySet().stream()
+            .sorted(Map.Entry.<String, Long>comparingByValue().reversed().thenComparing(Map.Entry::getKey))
+            .limit(10)
+            .forEach(e -> result.add(new PopularWishlistProduct(e.getKey(), e.getValue())));
+        return result;
+    }
+
+    private Customer customer(Principal principal, MerchantStore store) {
+        if (principal == null) throw new com.salesmanager.shop.store.api.exception.UnauthorizedException();
+        try {
+            Customer customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+            if (customer == null) throw new ResourceNotFoundException("Customer not found");
+            return customer;
+        } catch (ResourceNotFoundException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new ServiceRuntimeException(e);
+        }
+    }
+
+    private Product product(String sku, MerchantStore store, Language language) {
+        try {
+            Product product = productService.getBySku(sku, store, language);
+            if (product == null) throw new ResourceNotFoundException("Product with sku " + sku + " does not exist");
+            return product;
+        } catch (ResourceNotFoundException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new ServiceRuntimeException(e);
+        }
+    }
+
+    private Wishlist read(Customer customer, MerchantStore store, Language language) {
+        List<com.salesmanager.shop.model.customer.WishlistItem> items = new ArrayList<>();
+        for (WishlistItem source : wishlistService.list(customer, store)) {
+            Product product = source.getProduct();
+            com.salesmanager.shop.model.customer.WishlistItem item = new com.salesmanager.shop.model.customer.WishlistItem();
+            item.setSku(product.getSku());
+            ProductDescription description = product.getProductDescription();
+            item.setName(description == null ? product.getSku() : description.getName());
+            item.setPrice(price(product));
+            item.setAvailable(available(product));
+            Date added = source.getAddedAt();
+            item.setAddedAt(added == null ? null : Instant.ofEpochMilli(added.getTime()).toString());
+            items.add(item);
+        }
+        Wishlist result = new Wishlist();
+        result.setCount(items.size());
+        result.setItems(items);
+        return result;
+    }
+
+    private BigDecimal price(Product product) {
+        for (ProductAvailability availability : product.getAvailabilities()) {
+            ProductPrice price = availability.defaultPrice();
+            Date now = new Date();
+            if (price.getProductPriceSpecialAmount() != null
+                    && (price.getProductPriceSpecialStartDate() == null || !price.getProductPriceSpecialStartDate().after(now))
+                    && (price.getProductPriceSpecialEndDate() == null || !price.getProductPriceSpecialEndDate().before(now)))
+                return price.getProductPriceSpecialAmount();
+            if (price.getProductPriceAmount() != null) return price.getProductPriceAmount();
+        }
+        return BigDecimal.ZERO;
+    }
+
+    private boolean available(Product product) {
+        if (!product.isAvailable() || (product.getDateAvailable() != null && product.getDateAvailable().after(new Date()))) return false;
+        return product.getAvailabilities() != null && product.getAvailabilities().stream()
+            .anyMatch(a -> a.getProductQuantity() != null && a.getProductQuantity() > 0);
+    }
