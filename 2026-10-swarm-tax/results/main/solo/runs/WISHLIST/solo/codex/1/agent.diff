+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.security.Principal;
+import java.util.*;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.*;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.customer.WishlistService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.WishlistItem;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.model.wishlist.*;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class WishlistApi {
+    @Inject private WishlistService wishlistService;
+    @Inject private ProductService productService;
+    @Inject private CustomerFacade customerFacade;
+    @Inject private ShoppingCartFacade shoppingCartFacade;
+
+    private Customer customer(Principal p, MerchantStore s) { try { Customer c=customerFacade.getCustomerByUserName(p.getName(),s); if(c==null) throw new ResourceNotFoundException("Customer not found"); return c; } catch(ResourceNotFoundException e){throw e;} catch(Exception e){throw new ServiceRuntimeException(e);} }
+    private Product product(String sku, MerchantStore s) { try { Product p=productService.getBySku(sku,s); if(p==null) throw new ResourceNotFoundException("Product not found"); return p; } catch(ResourceNotFoundException e){throw e;} catch(Exception e){throw new ResourceNotFoundException("Product ["+sku+"] not found");} }
+    private Wishlist view(Customer c, MerchantStore s) { Wishlist w=new Wishlist(); List<WishlistProduct> out=new ArrayList<>(); for(WishlistItem i:wishlistService.list(c,s)){Product p=i.getProduct(); BigDecimalHolder h=new BigDecimalHolder(p); out.add(new WishlistProduct(p.getSku(),p.getProductDescription()==null?null:p.getProductDescription().getName(),h.price,h.available,i.getAddedAt()));} w.setItems(out); w.setCount(out.size()); return w; }
+    private static class BigDecimalHolder { java.math.BigDecimal price=java.math.BigDecimal.ZERO; boolean available; BigDecimalHolder(Product p){ if(p.getAvailabilities()!=null) for(ProductAvailability a:p.getAvailabilities()){ if(a.defaultPrice()!=null && a.defaultPrice().getProductPriceAmount()!=null) price=a.defaultPrice().getProductPriceAmount(); if(a.getProductQuantity()!=null && a.getProductQuantity()>0 && a.getProductStatus() && Boolean.TRUE.equals(a.getAvailable())) available=true; } available=available&&p.isAvailable(); } }
+
+    @PostMapping("/auth/customer/wishlist") @ResponseStatus(HttpStatus.CREATED)
+    public ResponseEntity<Wishlist> add(@RequestBody WishlistProductRequest req,@RequestParam(value="store",required=false) String ignored,@ApiIgnore MerchantStore store,HttpServletRequest request) { if(req==null||req.getProduct()==null||req.getProduct().trim().isEmpty()) throw new BadWishlistRequest("product is required"); Customer c=customer(request.getUserPrincipal(),store); Product p=product(req.getProduct(),store); WishlistItem old=wishlistService.find(c,p); if(old!=null) return new ResponseEntity<>(view(c,store),HttpStatus.OK); if(wishlistService.list(c,store).size()>=50) throw new BadWishlistRequest("Wishlist limit is 50"); wishlistService.add(c,p); return new ResponseEntity<>(view(c,store),HttpStatus.CREATED); }
+    @GetMapping("/auth/customer/wishlist") public Wishlist get(@ApiIgnore MerchantStore store,HttpServletRequest r){return view(customer(r.getUserPrincipal(),store),store);}
+    @DeleteMapping("/auth/customer/wishlist/{sku}") @ResponseStatus(HttpStatus.NO_CONTENT) public void remove(@PathVariable String sku,@ApiIgnore MerchantStore store,HttpServletRequest r){Customer c=customer(r.getUserPrincipal(),store); WishlistItem i=wishlistService.find(c,product(sku,store)); if(i==null) throw new ResourceNotFoundException("Wishlist item not found"); wishlistService.remove(i);}
+    @PostMapping("/auth/customer/wishlist/{sku}/cart/{cartCode}") public ReadableShoppingCart move(@PathVariable String sku,@PathVariable String cartCode,@ApiIgnore MerchantStore store,@ApiIgnore Language language,HttpServletRequest r) throws Exception { Customer c=customer(r.getUserPrincipal(),store); Product p=product(sku,store); WishlistItem i=wishlistService.find(c,p); if(i==null) throw new ResourceNotFoundException("Wishlist item not found"); BigDecimalHolder h=new BigDecimalHolder(p); if(!h.available) throw new ConflictWishlist("Product is unavailable"); ShoppingCart cart=shoppingCartFacade.getShoppingCartModel(cartCode,store); if(cart==null) throw new ResourceNotFoundException("Cart not found"); int q=1; if(cart.getLineItems()!=null) for(com.salesmanager.core.model.shoppingcart.ShoppingCartItem ci:cart.getLineItems()) if(ci.getProduct().getId().equals(p.getId())) q=ci.getQuantity()+1; PersistableShoppingCartItem item=new PersistableShoppingCartItem(); item.setProduct(sku); item.setQuantity(q); ReadableShoppingCart out=shoppingCartFacade.modifyCart(cartCode,item,store,language); wishlistService.remove(i); return out; }
+    @GetMapping("/private/wishlists/popular") public List<PopularWishlistProduct> popular(@ApiIgnore MerchantStore store){List<PopularWishlistProduct> out=new ArrayList<>(); for(Object[] row:wishlistService.popular(store)){out.add(new PopularWishlistProduct((String)row[0],((Number)row[1]).longValue())); if(out.size()==10) break;} return out;}
+}
