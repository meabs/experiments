+package com.salesmanager.core.business.services.customer;
+
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.customer.WishlistItemRepository;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.WishlistItem;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("wishlistService")
+public class WishlistServiceImpl implements WishlistService {
+    private final WishlistItemRepository repository;
+    @Inject public WishlistServiceImpl(WishlistItemRepository repository) { this.repository = repository; }
+    public List<WishlistItem> list(Customer c, MerchantStore s) { return repository.findForCustomer(c.getId(), s.getId()); }
+    public WishlistItem find(Customer c, Product p) { return repository.findOne(c.getId(), p.getId()); }
+    @Transactional public WishlistItem add(Customer c, Product p) { WishlistItem i = new WishlistItem(); i.setCustomer(c); i.setProduct(p); return repository.saveAndFlush(i); }
+    public void remove(WishlistItem i) { repository.delete(i); }
+    @Transactional public void removeProduct(Long id) { repository.deleteForProduct(id); }
+    public List<Object[]> popular(MerchantStore s) { return repository.popular(s.getId()); }
+}
