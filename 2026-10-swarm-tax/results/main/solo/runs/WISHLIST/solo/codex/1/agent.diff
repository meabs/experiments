+import com.salesmanager.core.model.customer.WishlistItem;
+
+public interface WishlistItemRepository extends JpaRepository<WishlistItem, Long> {
+    @Query("select w from WishlistItem w join fetch w.product p where w.customer.id = :customerId and p.merchantStore.id = :storeId order by w.addedAt desc")
