+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.math.BigDecimal;
+import java.security.Principal;
+import java.util.*;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.*;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.pricing.PricingService;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.customer.WishlistService;
+import com.salesmanager.core.business.services.shoppingcart.ShoppingCartService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.FinalPrice;
+import com.salesmanager.core.model.customer.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.store.api.exception.*;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class WishlistApi {
+    @Inject private WishlistService wishlistService;
+    @Inject private ProductService productService;
+    @Inject private PricingService pricingService;
+    @Inject private CustomerFacade customerFacade;
+    @Inject private ShoppingCartService cartService;
+    @Inject private ShoppingCartFacade cartFacade;
+
+    public static class AddRequest { private String product; public String getProduct(){return product;} public void setProduct(String p){product=p;} }
+    public static class Item { public String sku,name; public BigDecimal price; public boolean available; public Date addedAt; }
+    public static class Result { public int count; public List<Item> items; Result(List<Item> i){items=i;count=i.size();} }
+    public static class Popular { public String sku; public int count; Popular(String s,int c){sku=s;count=c;} }
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal p=request.getUserPrincipal();
+        if(p==null) throw new UnauthorizedException();
+        Customer c=customerFacade.getCustomerByUserName(p.getName(),store);
+        if(c==null) throw new UnauthorizedException();
+        return c;
+    }
+    private Result result(Customer c, MerchantStore s, Language l) {
+        List<Item> out=new ArrayList<>();
+        for(com.salesmanager.core.model.customer.WishlistItem w:wishlistService.list(c,s)) {
+            Product p=w.getProduct(); Item i=new Item(); i.sku=p.getSku(); i.addedAt=w.getAddedAt();
+            i.name=p.getDescriptions().stream().filter(d->l==null || d.getLanguage().getId().equals(l.getId())).map(d->d.getName()).findFirst().orElse("");
+            try { FinalPrice fp=pricingService.calculateProductPrice(p); i.price=fp.getFinalPrice(); } catch(Exception e){i.price=BigDecimal.ZERO;}
+            i.available=p.isAvailable() && p.getAvailabilities()!=null && p.getAvailabilities().stream().anyMatch(a->a.getProductQuantity()!=null && a.getProductQuantity()>0);
+            out.add(i);
+        } return new Result(out);
+    }
+    @PostMapping("/auth/customer/wishlist")
+    public ResponseEntity<Result> add(@RequestBody AddRequest req,@ApiIgnore MerchantStore store,@ApiIgnore Language language,HttpServletRequest request) {
+        if(req==null || req.product==null || req.product.trim().isEmpty()) throw new RestApiException("400","product is required");
+        Customer c=customer(request,store); Product p;
+        try { p=productService.getBySku(req.product,store,language); } catch(Exception e){throw new ResourceNotFoundException("Product not found");}
+        if(p==null) throw new ResourceNotFoundException("Product not found");
+        if(wishlistService.get(c,req.product,store)!=null) return ResponseEntity.ok(result(c,store,language));
+        if(wishlistService.list(c,store).size()>=50) throw new RestApiException("400","Wishlist is full");
+        wishlistService.add(c,p,store); return ResponseEntity.status(HttpStatus.CREATED).body(result(c,store,language));
+    }
+    @GetMapping("/auth/customer/wishlist") public Result get(@ApiIgnore MerchantStore s,@ApiIgnore Language l,HttpServletRequest r){return result(customer(r,s),s,l);}
+    @DeleteMapping("/auth/customer/wishlist/{sku}") public ResponseEntity<Void> remove(@PathVariable String sku,@ApiIgnore MerchantStore s,HttpServletRequest r){WishlistItem w=wishlistService.get(customer(r,s),sku,s);if(w==null)throw new ResourceNotFoundException("Wishlist item not found");wishlistService.remove(w);return ResponseEntity.noContent().build();}
+    @PostMapping("/auth/customer/wishlist/{sku}/cart/{cartCode}") public ResponseEntity<ReadableShoppingCart> move(@PathVariable String sku,@PathVariable String cartCode,@ApiIgnore MerchantStore s,@ApiIgnore Language l,HttpServletRequest r){
+        Customer c=customer(r,s); WishlistItem w=wishlistService.get(c,sku,s); if(w==null)throw new ResourceNotFoundException("Wishlist item not found");
+        try { if(cartService.getByCode(cartCode,s)==null)throw new ResourceNotFoundException("Cart not found"); } catch(com.salesmanager.core.business.exception.ServiceException e){throw new ResourceNotFoundException("Cart not found");} Product p=w.getProduct();
+        if(!p.isAvailable() || p.getAvailabilities()==null || p.getAvailabilities().stream().noneMatch(a->a.getProductQuantity()!=null&&a.getProductQuantity()>0))throw new ConflictException("Product is unavailable");
+        PersistableShoppingCartItem item=new PersistableShoppingCartItem();item.setProduct(sku);item.setQuantity(1);
+        try { ReadableShoppingCart cart=cartFacade.modifyCart(cartCode,item,s,l); wishlistService.remove(w); return ResponseEntity.ok(cart); } catch(ConflictException e){throw e;} catch(Exception e){throw new ConflictException("Product cannot be added to cart");}
+    }
+    @GetMapping("/private/wishlists/popular") public List<Popular> popular(@ApiIgnore MerchantStore s){
+        Map<String,Set<Long>> counts=new HashMap<>(); for(com.salesmanager.core.model.customer.WishlistItem w:wishlistService.store(s)) counts.computeIfAbsent(w.getProduct().getSku(),k->new HashSet<>()).add(w.getCustomer().getId());
+        return counts.entrySet().stream().map(e->new Popular(e.getKey(),e.getValue().size())).sorted(Comparator.comparingInt((Popular x)->x.count).reversed().thenComparing(x->x.sku)).limit(10).collect(Collectors.toList());
+    }
+}
