+package com.salesmanager.core.business.services.customer;
+
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.customer.WishlistItemRepository;
+import com.salesmanager.core.model.customer.*;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("wishlistService")
+public class WishlistServiceImpl implements WishlistService {
+    @Inject private WishlistItemRepository repository;
+    public WishlistItem get(Customer c,String sku,MerchantStore s){return repository.findByCustomerIdAndProductSkuAndStoreId(c.getId(),sku,s.getId());}
+    public List<WishlistItem> list(Customer c,MerchantStore s){return repository.findByCustomerIdAndStoreIdOrderByAddedAtDesc(c.getId(),s.getId());}
+    public WishlistItem add(Customer c,Product p,MerchantStore s){WishlistItem i=new WishlistItem();i.setCustomer(c);i.setProduct(p);i.setStore(s);return repository.saveAndFlush(i);}
+    public void remove(WishlistItem i){repository.delete(i);repository.flush();}
+    @Transactional
+    public void removeProduct(Product p){repository.deleteByProduct(p.getId());}
+    public List<WishlistItem> store(MerchantStore s){return repository.findStore(s.getId());}
+}
