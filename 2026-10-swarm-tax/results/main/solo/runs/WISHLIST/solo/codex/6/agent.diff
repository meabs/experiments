+package com.salesmanager.core.business.repositories.customer;
+
+import java.util.List;
+import org.springframework.data.jpa.repository.*;
+import org.springframework.data.repository.query.Param;
+import com.salesmanager.core.model.customer.WishlistItem;
+
+public interface WishlistItemRepository extends JpaRepository<WishlistItem, Long> {
+    WishlistItem findByCustomerIdAndProductSkuAndStoreId(Long customer, String sku, Integer store);
+    List<WishlistItem> findByCustomerIdAndStoreIdOrderByAddedAtDesc(Long customer, Integer store);
+    @Query("select w from WishlistItem w where w.store.id=:store order by w.product.sku") List<WishlistItem> findStore(@Param("store") Integer store);
+    long countByCustomerIdAndStoreId(Long customer, Integer store);
+    @Modifying @Query("delete from WishlistItem w where w.product.id=:product") void deleteByProduct(@Param("product") Long product);
+}
