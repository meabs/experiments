+package com.salesmanager.core.business.services.customer;
+
+import java.util.Date;
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.customer.WishlistRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.wishlist.WishlistItem;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("wishlistService")
+public class WishlistServiceImpl implements WishlistService {
+    private static final int MAX_ITEMS = 50;
+    private final WishlistRepository repository;
+
+    @Inject
+    public WishlistServiceImpl(WishlistRepository repository) { this.repository = repository; }
+
+    @Override @Transactional(readOnly = true)
+    public List<WishlistItem> list(Customer customer, MerchantStore store) { return repository.findByCustomerAndStore(customer.getId(), store.getId()); }
+
+    @Override @Transactional(readOnly = true)
+    public WishlistItem find(Customer customer, MerchantStore store, String sku) { return repository.findByCustomerIdAndProductSkuAndMerchantStoreId(customer.getId(), sku, store.getId()); }
+
+    @Override @Transactional
+    public WishlistItem add(Customer customer, MerchantStore store, Product product) throws ServiceException {
+        WishlistItem existing = find(customer, store, product.getSku());
+        if (existing != null) return existing;
+        if (repository.countByCustomerIdAndMerchantStoreId(customer.getId(), store.getId()) >= MAX_ITEMS)
+            throw new ServiceException("Wishlist cannot contain more than 50 products");
+        WishlistItem item = new WishlistItem();
+        item.setCustomer(customer); item.setMerchantStore(store); item.setProduct(product); item.setAddedAt(new Date());
+        return repository.save(item);
+    }
+
+    @Override @Transactional
+    public void remove(Customer customer, MerchantStore store, String sku) { repository.deleteByCustomerIdAndProductSkuAndMerchantStoreId(customer.getId(), sku, store.getId()); }
+
+    @Override @Transactional
+    public void removeProduct(Product product) { repository.deleteByProductId(product.getId()); }
+
+    @Override @Transactional(readOnly = true)
+    public List<Object[]> popular(MerchantStore store) { return repository.popular(store.getId()); }
+}
