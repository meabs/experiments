+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.math.BigDecimal;
+import java.security.Principal;
+import java.util.ArrayList;
+import java.util.List;
+
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.pricing.PricingService;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.customer.WishlistService;
+import com.salesmanager.core.business.services.shoppingcart.ShoppingCartService;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.FinalPrice;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.shop.model.customer.PopularWishlistProduct;
+import com.salesmanager.shop.model.customer.Wishlist;
+import com.salesmanager.shop.model.customer.WishlistItem;
+import com.salesmanager.shop.model.customer.WishlistProductRequest;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ConflictException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class WishlistApi {
+    @Inject private WishlistService wishlistService;
+    @Inject private ProductService productService;
+    @Inject private PricingService pricingService;
+    @Inject private CustomerFacade customerFacade;
+    @Inject private ShoppingCartService shoppingCartService;
+    @Inject private ShoppingCartFacade cartFacade;
+
+    @GetMapping("/auth/customer/wishlist")
+    public Wishlist get(@ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest request) throws Exception {
+        return toWishlist(customer(request, store), store, language);
+    }
+
+    @PostMapping("/auth/customer/wishlist")
+    public ResponseEntity<Wishlist> add(@RequestBody WishlistProductRequest body, @ApiIgnore MerchantStore store,
+            @ApiIgnore Language language, HttpServletRequest request) throws Exception {
+        if (body == null || body.getProduct() == null || body.getProduct().trim().isEmpty())
+            throw new ServiceRuntimeException("400", "product is required");
+        Customer customer = customer(request, store);
+        Product product = productService.getBySku(body.getProduct(), store, language);
+        if (product == null) throw new ResourceNotFoundException("Product [" + body.getProduct() + "] not found");
+        boolean exists = wishlistService.find(customer, store, product.getSku()) != null;
+        try {
+            wishlistService.add(customer, store, product);
+        } catch (ServiceException e) {
+            throw new ServiceRuntimeException("400", e.getMessage());
+        }
+        return ResponseEntity.status(exists ? HttpStatus.OK : HttpStatus.CREATED).body(toWishlist(customer, store, language));
+    }
+
+    @DeleteMapping("/auth/customer/wishlist/{sku}")
+    public ResponseEntity<Void> remove(@PathVariable String sku, @ApiIgnore MerchantStore store, HttpServletRequest request) throws Exception {
+        Customer customer = customer(request, store);
+        if (wishlistService.find(customer, store, sku) == null) throw new ResourceNotFoundException("Wishlist item not found");
+        wishlistService.remove(customer, store, sku);
+        return ResponseEntity.noContent().build();
+    }
+
+    @PostMapping("/auth/customer/wishlist/{sku}/cart/{cartCode}")
+    public ReadableShoppingCart move(@PathVariable String sku, @PathVariable String cartCode, @ApiIgnore MerchantStore store,
+            @ApiIgnore Language language, HttpServletRequest request) throws Exception {
+        Customer customer = customer(request, store);
+        if (wishlistService.find(customer, store, sku) == null) throw new ResourceNotFoundException("Wishlist item not found");
+        ShoppingCart cart = shoppingCartService.getByCode(cartCode, store);
+        if (cart == null) throw new ResourceNotFoundException("Cart not found");
+        Product product = productService.getBySku(sku, store, language);
+        if (product == null) throw new ResourceNotFoundException("Product not found");
+        if (!isAvailable(product)) throw new ConflictException("Product is not available");
+        int quantity = 1;
+        if (cart.getLineItems() != null) for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem item : cart.getLineItems())
+            if (sku.equals(item.getSku())) quantity = item.getQuantity() + 1;
+        PersistableShoppingCartItem item = new PersistableShoppingCartItem(); item.setProduct(sku); item.setQuantity(quantity);
+        ReadableShoppingCart result = cartFacade.modifyCart(cartCode, item, store, language);
+        wishlistService.remove(customer, store, sku);
+        return result;
+    }
+
+    @GetMapping("/private/wishlists/popular")
+    public List<PopularWishlistProduct> popular(@ApiIgnore MerchantStore store) throws Exception {
+        List<PopularWishlistProduct> result = new ArrayList<>();
+        for (Object[] row : wishlistService.popular(store)) { result.add(new PopularWishlistProduct((String) row[0], ((Number) row[1]).longValue())); if (result.size() == 10) break; }
+        return result;
+    }
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal principal = request.getUserPrincipal();
+        return customerFacade.getCustomerByUserName(principal.getName(), store);
+    }
+
+    private Wishlist toWishlist(Customer customer, MerchantStore store, Language language) throws Exception {
+        Wishlist result = new Wishlist(); List<WishlistItem> items = new ArrayList<>();
+        for (com.salesmanager.core.model.customer.wishlist.WishlistItem entity : wishlistService.list(customer, store)) {
+            Product product = entity.getProduct(); FinalPrice finalPrice;
+            try { finalPrice = pricingService.calculateProductPrice(product); } catch (Exception e) { finalPrice = new FinalPrice(); }
+            BigDecimal price = finalPrice.getFinalPrice();
+            String name = product.getProductDescription() == null ? product.getSku() : product.getProductDescription().getName();
+            items.add(new WishlistItem(product.getSku(), name, price, isAvailable(product), entity.getAddedAt()));
+        }
+        result.setItems(items); result.setCount(items.size()); return result;
+    }
+
+    private boolean isAvailable(Product product) {
+        if (!product.isAvailable() || product.getDateAvailable() == null || product.getDateAvailable().after(new java.util.Date())
+                || product.getAvailabilities() == null || product.getAvailabilities().isEmpty()) return false;
+        for (ProductAvailability availability : product.getAvailabilities())
+            if (availability.getProductQuantity() == null || availability.getProductQuantity() <= 0 || Boolean.FALSE.equals(availability.getAvailable())) return false;
+        return true;
+    }
+}
