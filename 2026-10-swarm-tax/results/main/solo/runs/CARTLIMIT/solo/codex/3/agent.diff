@@ -0,0 +1,94 @@
+package com.salesmanager.shop.store.controller.shoppingCart;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.system.MerchantConfigurationService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+import com.salesmanager.core.model.system.MerchantConfiguration;
+import com.salesmanager.core.model.system.MerchantConfigurationType;
+import com.salesmanager.shop.model.shoppingcart.CartLimitWarning;
+import com.salesmanager.shop.model.shoppingcart.CartRules;
+import com.salesmanager.shop.model.shoppingcart.ProductLimits;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+@Service
+public class CartLimitService {
+    private static final String RULES_KEY = "CART_LIMIT_RULES";
+    private final ObjectMapper mapper = new ObjectMapper();
+    @Inject private ProductService productService;
+    @Inject private MerchantConfigurationService configurationService;
+
+    public Product requireProduct(Long id, MerchantStore store) {
+        Product p = productService.getById(id);
+        if (p == null || p.getMerchantStore() == null || !store.getId().equals(p.getMerchantStore().getId()))
+            throw new RestApiException("404", "Product not found");
+        return p;
+    }
+
+    public void setLimits(Product p, ProductLimits l) {
+        validate(l.getMinPerCart(), l.getMaxPerCart(), l.getPackSize());
+        p.setMinPerCart(l.getMinPerCart()); p.setMaxPerCart(l.getMaxPerCart()); p.setPackSize(l.getPackSize());
+        try { productService.update(p); } catch (Exception e) { throw new RestApiException("500", "Unable to save product limits", e); }
+    }
+
+    public CartRules getRules(MerchantStore store) {
+        try {
+            MerchantConfiguration c = configurationService.getMerchantConfiguration(RULES_KEY, store);
+            return c == null || c.getValue() == null ? new CartRules() : mapper.readValue(c.getValue(), CartRules.class);
+        } catch (Exception e) { throw new RestApiException("500", "Unable to read cart rules", e); }
+    }
+
+    public void setRules(MerchantStore store, CartRules rules) {
+        validatePositive(rules.getMaxLines()); validatePositive(rules.getMaxUnits());
+        try {
+            MerchantConfiguration c = configurationService.getMerchantConfiguration(RULES_KEY, store);
+            if (c == null) { c = new MerchantConfiguration(); c.setMerchantStore(store); c.setKey(RULES_KEY); c.setMerchantConfigurationType(MerchantConfigurationType.SHOP); }
+            c.setValue(mapper.writeValueAsString(rules)); c.setActive(true); configurationService.saveOrUpdate(c);
+        } catch (RestApiException e) { throw e; } catch (Exception e) { throw new RestApiException("500", "Unable to save cart rules", e); }
+    }
+
+    public void validateChange(ShoppingCart cart, List<ShoppingCartItem> proposed, MerchantStore store, boolean checkCaps) {
+        CartRules rules = getRules(store);
+        int lines = 0, units = 0;
+        for (ShoppingCartItem i : proposed) {
+            if (i.getQuantity() > 0) { lines++; units += i.getQuantity(); }
+            ShoppingCartItem old = null;
+            if (cart.getLineItems() != null) for (ShoppingCartItem candidate : cart.getLineItems()) if (candidate.getProduct().getId().equals(i.getProduct().getId())) { old = candidate; break; }
+            if (old == null || old.getQuantity().intValue() != i.getQuantity()) validateProduct(i.getProduct(), i.getQuantity());
+        }
+        if (checkCaps && rules.getMaxLines() != null && lines > rules.getMaxLines()) fail("MAX_LINES");
+        if (checkCaps && rules.getMaxUnits() != null && units > rules.getMaxUnits()) fail("MAX_UNITS");
+    }
+
+    public List<CartLimitWarning> warnings(ShoppingCart cart, MerchantStore store) {
+        List<CartLimitWarning> out = new ArrayList<>(); CartRules rules = getRules(store);
+        int lines = 0, units = 0;
+        Set<ShoppingCartItem> items = cart.getLineItems();
+        if (items != null) for (ShoppingCartItem i : items) if (i.getQuantity() > 0) {
+            lines++; units += i.getQuantity(); Product p = i.getProduct();
+            if (p.getMinPerCart() != null && i.getQuantity() < p.getMinPerCart()) out.add(new CartLimitWarning(p.getSku(), "MIN_PER_CART"));
+            if (p.getMaxPerCart() != null && i.getQuantity() > p.getMaxPerCart()) out.add(new CartLimitWarning(p.getSku(), "MAX_PER_CART"));
+            if (p.getPackSize() != null && i.getQuantity() % p.getPackSize() != 0) out.add(new CartLimitWarning(p.getSku(), "PACK_SIZE"));
+        }
+        if (rules.getMaxLines() != null && lines > rules.getMaxLines()) out.add(new CartLimitWarning(null, "MAX_LINES"));
+        if (rules.getMaxUnits() != null && units > rules.getMaxUnits()) out.add(new CartLimitWarning(null, "MAX_UNITS"));
+        return out;
+    }
+
+    private void validateProduct(Product p, int q) { if (q == 0) return; if (p.getMinPerCart()!=null && q<p.getMinPerCart()) fail("MIN_PER_CART"); if (p.getMaxPerCart()!=null && q>p.getMaxPerCart()) fail("MAX_PER_CART"); if (p.getPackSize()!=null && q%p.getPackSize()!=0) fail("PACK_SIZE"); }
+    private void validate(Integer min, Integer max, Integer pack) { validatePositive(min); validatePositive(max); validatePositive(pack); if (min != null && max != null && min > max) bad(); if (max != null && pack != null && max < pack) bad(); }
+    private void validatePositive(Integer v) { if (v != null && v < 1) bad(); }
+    private void bad() { throw new RestApiException("400", "Invalid cart limits"); }
+    private void fail(String code) { throw new RestApiException(code, "Cart limit violated: " + code); }
+}
