@@ -0,0 +1,76 @@
+package com.salesmanager.shop.store.controller.shoppingCart;
+
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.CartLimitWarning;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+@Service
+public class CartLimitService {
+    @Inject private ProductService productService;
+
+    public void validate(ShoppingCart cart, List<PersistableShoppingCartItem> changes,
+                         MerchantStore store, boolean additionsAreIncremental) {
+        Map<String,Integer> old = new HashMap<>();
+        for (ShoppingCartItem i : safe(cart.getLineItems())) old.put(i.getSku(), i.getQuantity());
+        Map<String,Integer> next = new HashMap<>(old);
+        Map<String,Product> products = new HashMap<>();
+        boolean newLine = false, addsUnits = false;
+        for (PersistableShoppingCartItem c : changes) {
+            Product p = product(c.getProduct(), store);
+            products.put(c.getProduct(), p);
+            int before = next.getOrDefault(c.getProduct(), 0);
+            int after = additionsAreIncremental ? before + c.getQuantity() : c.getQuantity();
+            if (after == 0) next.remove(c.getProduct()); else next.put(c.getProduct(), after);
+            if (before == 0 && after > 0) newLine = true;
+            if (after > before) addsUnits = true;
+            if (after > 0 && (after != before || additionsAreIncremental)) checkProduct(p, after);
+        }
+        if (newLine && store.getMaxLines() != null && next.size() > store.getMaxLines()) fail("MAX_LINES");
+        int units = next.values().stream().mapToInt(Integer::intValue).sum();
+        int oldUnits = old.values().stream().mapToInt(Integer::intValue).sum();
+        if (addsUnits && store.getMaxUnits() != null && units > store.getMaxUnits() && units > oldUnits) fail("MAX_UNITS");
+    }
+
+    private Product product(String sku, MerchantStore store) {
+        try { Product p = productService.getBySku(sku, store, store.getDefaultLanguage());
+            if (p == null) throw new Exception(); return p;
+        } catch (Exception e) { throw new RestApiException("400", "Unknown product " + sku); }
+    }
+    private void checkProduct(Product p, int q) {
+        if (p.getMinPerCart() != null && q < p.getMinPerCart()) fail("MIN_PER_CART");
+        if (p.getMaxPerCart() != null && q > p.getMaxPerCart()) fail("MAX_PER_CART");
+        if (p.getPackSize() != null && q % p.getPackSize() != 0) fail("PACK_SIZE");
+    }
+    private void fail(String code) { throw new RestApiException(code, "Cart limit violated: " + code); }
+    private Set<ShoppingCartItem> safe(Set<ShoppingCartItem> items) { return items == null ? Set.of() : items; }
+
+    public List<CartLimitWarning> warnings(ShoppingCart cart, MerchantStore store) {
+        List<CartLimitWarning> result = new ArrayList<>();
+        Set<ShoppingCartItem> items = safe(cart.getLineItems());
+        if (store.getMaxLines() != null && items.size() > store.getMaxLines()) result.add(new CartLimitWarning(null, "MAX_LINES"));
+        int units = 0;
+        for (ShoppingCartItem i : items) {
+            units += i.getQuantity(); Product p = product(i.getSku(), store);
+            if (p.getMinPerCart() != null && i.getQuantity() < p.getMinPerCart()) result.add(new CartLimitWarning(i.getSku(), "MIN_PER_CART"));
+            if (p.getMaxPerCart() != null && i.getQuantity() > p.getMaxPerCart()) result.add(new CartLimitWarning(i.getSku(), "MAX_PER_CART"));
+            if (p.getPackSize() != null && i.getQuantity() % p.getPackSize() != 0) result.add(new CartLimitWarning(i.getSku(), "PACK_SIZE"));
+        }
+        if (store.getMaxUnits() != null && units > store.getMaxUnits()) result.add(new CartLimitWarning(null, "MAX_UNITS"));
+        return result;
+    }
+    public void decorate(com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart cart, ShoppingCart model, MerchantStore store) {
+        cart.setLimitWarnings(warnings(model, store));
+    }
+}
