+package com.salesmanager.shop.store.api.v1.shoppingCart;
+
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.shoppingcart.CartRules;
+import com.salesmanager.shop.model.shoppingcart.ProductCartLimits;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private")
+public class CartLimitsApi {
+    @Inject private ProductService productService;
+    @Inject private MerchantStoreService merchantStoreService;
+
+    @PutMapping("/product/{id}/limits")
+    public ProductCartLimits putProduct(@PathVariable Long id, @RequestBody ProductCartLimits body,
+                                        @ApiIgnore MerchantStore store) {
+        Product p = product(id, store);
+        if (p == null || p.getMerchantStore() == null || !p.getMerchantStore().getId().equals(store.getId())) throw new ResourceNotFoundException("Product not found");
+        validateProduct(body);
+        p.setMinPerCart(body.getMinPerCart()); p.setMaxPerCart(body.getMaxPerCart()); p.setPackSize(body.getPackSize());
+        try { productService.update(p); } catch (Exception e) { throw new RestApiException("400", e.getMessage()); }
+        return body;
+    }
+    @GetMapping("/product/{id}/limits")
+    public ProductCartLimits getProduct(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        Product p = product(id, store);
+        if (p == null || p.getMerchantStore() == null || !p.getMerchantStore().getId().equals(store.getId())) throw new ResourceNotFoundException("Product not found");
+        ProductCartLimits out = new ProductCartLimits(); out.setMinPerCart(p.getMinPerCart()); out.setMaxPerCart(p.getMaxPerCart()); out.setPackSize(p.getPackSize()); return out;
+    }
+    @PutMapping("/cart-rules")
+    public CartRules putRules(@RequestBody CartRules body, @ApiIgnore MerchantStore store) {
+        validatePositive(body.getMaxLines()); validatePositive(body.getMaxUnits());
+        store.setMaxLines(body.getMaxLines()); store.setMaxUnits(body.getMaxUnits());
+        try { merchantStoreService.saveOrUpdate(store); } catch (Exception e) { throw new RestApiException("400", e.getMessage()); }
+        return body;
+    }
+    @GetMapping("/cart-rules")
+    public CartRules getRules(@ApiIgnore MerchantStore store) { CartRules out = new CartRules(); out.setMaxLines(store.getMaxLines()); out.setMaxUnits(store.getMaxUnits()); return out; }
+    private void validateProduct(ProductCartLimits b) {
+        validatePositive(b.getMinPerCart()); validatePositive(b.getMaxPerCart()); validatePositive(b.getPackSize());
+        if (b.getMinPerCart() != null && b.getMaxPerCart() != null && b.getMinPerCart() > b.getMaxPerCart()) bad();
+        if (b.getMaxPerCart() != null && b.getPackSize() != null && b.getMaxPerCart() < b.getPackSize()) bad();
+    }
+    private Product product(Long id, MerchantStore store) {
+        try { return productService.findOne(id, store); }
+        catch (Exception e) { return null; }
+    }
+    private void validatePositive(Integer value) { if (value != null && value < 1) bad(); }
+    private void bad() { throw new RestApiException("400", "Invalid cart limit"); }
+}
