+package com.salesmanager.shop.store.api.v1.cart;
+
+import javax.inject.Inject;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductLimits;
+import com.salesmanager.shop.model.shoppingcart.CartRules;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class CartLimitsApi {
+    @Inject private ProductService productService;
+    @Inject private MerchantStoreService storeService;
+
+    @PutMapping("/private/product/{id}/limits")
+    public ResponseEntity<ProductLimits> putProductLimits(@PathVariable Long id, @RequestBody ProductLimits request,
+            @ApiIgnore MerchantStore store) throws Exception {
+        Product product = productService.findOne(id, store);
+        if (product == null || product.getMerchantStore() == null || !product.getMerchantStore().getId().equals(store.getId())) throw new ResourceNotFoundException("Product not found");
+        validate(request.getMinPerCart(), request.getMaxPerCart(), request.getPackSize());
+        product.setMinPerCart(request.getMinPerCart()); product.setMaxPerCart(request.getMaxPerCart()); product.setPackSize(request.getPackSize());
+        productService.update(product);
+        return ResponseEntity.ok(read(product));
+    }
+    @GetMapping("/private/product/{id}/limits")
+    public ResponseEntity<ProductLimits> getProductLimits(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        Product product = productService.findOne(id, store);
+        if (product == null || product.getMerchantStore() == null || !product.getMerchantStore().getId().equals(store.getId())) throw new ResourceNotFoundException("Product not found");
+        return ResponseEntity.ok(read(product));
+    }
+    @PutMapping("/private/cart-rules")
+    public ResponseEntity<CartRules> putCartRules(@RequestBody CartRules request, @ApiIgnore MerchantStore store) throws Exception {
+        validatePositive(request.getMaxLines()); validatePositive(request.getMaxUnits());
+        store.setMaxCartLines(request.getMaxLines()); store.setMaxCartUnits(request.getMaxUnits()); storeService.saveOrUpdate(store);
+        return ResponseEntity.ok(read(store));
+    }
+    @GetMapping("/private/cart-rules")
+    public ResponseEntity<CartRules> getCartRules(@ApiIgnore MerchantStore store) { return ResponseEntity.ok(read(store)); }
+    private ProductLimits read(Product p) { ProductLimits r = new ProductLimits(); r.setMinPerCart(p.getMinPerCart()); r.setMaxPerCart(p.getMaxPerCart()); r.setPackSize(p.getPackSize()); return r; }
+    private CartRules read(MerchantStore s) { CartRules r = new CartRules(); r.setMaxLines(s.getMaxCartLines()); r.setMaxUnits(s.getMaxCartUnits()); return r; }
+    private void validate(Integer min, Integer max, Integer pack) {
+        validatePositive(min); validatePositive(max); validatePositive(pack);
+        if (min != null && max != null && min > max) bad();
+        if (max != null && pack != null && max < pack) bad();
+    }
+    private void validatePositive(Integer v) { if (v != null && v < 1) bad(); }
+    private void bad() { throw new RestApiException("400", "Cart limits must be whole positive numbers and satisfy their ordering constraints"); }
+}
