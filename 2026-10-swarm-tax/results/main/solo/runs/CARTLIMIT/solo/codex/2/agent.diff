+package com.salesmanager.shop.store.controller.shoppingCart;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.LimitWarning;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+@Service
+public class CartLimitService {
+    public void validateProduct(Product p, int quantity) {
+        if (quantity == 0) return;
+        if (quantity < 0) fail("MIN_PER_CART", "Quantity must not be negative");
+        if (p.getMinPerCart() != null && quantity < p.getMinPerCart()) fail("MIN_PER_CART", "Minimum quantity is " + p.getMinPerCart());
+        if (p.getMaxPerCart() != null && quantity > p.getMaxPerCart()) fail("MAX_PER_CART", "Maximum quantity is " + p.getMaxPerCart());
+        if (p.getPackSize() != null && quantity % p.getPackSize() != 0) fail("PACK_SIZE", "Quantity must be a multiple of " + p.getPackSize());
+    }
+
+    public void validateCaps(MerchantStore store, Set<ShoppingCartItem> items, boolean addingLine, boolean addingUnits) {
+        int lines = items == null ? 0 : items.size();
+        int units = items == null ? 0 : items.stream().mapToInt(i -> i.getQuantity() == null ? 0 : i.getQuantity()).sum();
+        if (addingLine && store.getMaxCartLines() != null && lines > store.getMaxCartLines()) fail("MAX_LINES", "Maximum cart lines is " + store.getMaxCartLines());
+        if (addingUnits && store.getMaxCartUnits() != null && units > store.getMaxCartUnits()) fail("MAX_UNITS", "Maximum cart units is " + store.getMaxCartUnits());
+    }
+    public void validateCapsValues(MerchantStore store, int lines, int units, boolean addingLine, boolean addingUnits) {
+        if (addingLine && store.getMaxCartLines() != null && lines > store.getMaxCartLines()) fail("MAX_LINES", "Maximum cart lines is " + store.getMaxCartLines());
+        if (addingUnits && store.getMaxCartUnits() != null && units > store.getMaxCartUnits()) fail("MAX_UNITS", "Maximum cart units is " + store.getMaxCartUnits());
+    }
+
+    public List<LimitWarning> warnings(ShoppingCart cart, MerchantStore store) {
+        List<LimitWarning> result = new ArrayList<>();
+        Set<ShoppingCartItem> items = cart.getLineItems();
+        if (store.getMaxCartLines() != null && items != null && items.size() > store.getMaxCartLines()) result.add(new LimitWarning(null, "MAX_LINES"));
+        int units = items == null ? 0 : items.stream().mapToInt(i -> i.getQuantity() == null ? 0 : i.getQuantity()).sum();
+        if (store.getMaxCartUnits() != null && units > store.getMaxCartUnits()) result.add(new LimitWarning(null, "MAX_UNITS"));
+        if (items != null) for (ShoppingCartItem item : items) {
+            Product p = item.getProduct(); int q = item.getQuantity(); String sku = p.getSku();
+            if (q > 0 && p.getMinPerCart() != null && q < p.getMinPerCart()) result.add(new LimitWarning(sku, "MIN_PER_CART"));
+            if (q > 0 && p.getMaxPerCart() != null && q > p.getMaxPerCart()) result.add(new LimitWarning(sku, "MAX_PER_CART"));
+            if (q > 0 && p.getPackSize() != null && q % p.getPackSize() != 0) result.add(new LimitWarning(sku, "PACK_SIZE"));
+        }
+        return result;
+    }
+    private void fail(String code, String message) { throw new RestApiException(code, message); }
+}
