+package com.salesmanager.shop.store.api.v1.shoppingCart;
+
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.shoppingcart.CartRules;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/cart-rules")
+public class CartRulesApi {
+    @Inject private MerchantStoreService merchantStoreService;
+
+    @PutMapping
+    @ResponseStatus(HttpStatus.OK)
+    public CartRules set(@RequestBody CartRules request, @ApiIgnore MerchantStore store) {
+        if (request == null || invalid(request.getMaxLines()) || invalid(request.getMaxUnits()))
+            throw new RestApiException("400", "Invalid cart rules");
+        store.setMaxCartLines(request.getMaxLines()); store.setMaxCartUnits(request.getMaxUnits());
+        try { merchantStoreService.saveOrUpdate(store); } catch (Exception e) { throw new RestApiException("400", e.getMessage(), e); }
+        return rules(store);
+    }
+    @GetMapping
+    public CartRules get(@ApiIgnore MerchantStore store) { return rules(store); }
+    private CartRules rules(MerchantStore s) { CartRules r = new CartRules(); r.setMaxLines(s.getMaxCartLines()); r.setMaxUnits(s.getMaxCartUnits()); return r; }
+    private boolean invalid(Integer v) { return v != null && v < 1; }
+}
