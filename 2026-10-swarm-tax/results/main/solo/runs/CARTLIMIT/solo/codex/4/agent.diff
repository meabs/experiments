+package com.salesmanager.shop.store.api.v1.cart;
+
+import javax.inject.Inject;
+
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private")
+public class CartLimitsApi {
+    @Inject private ProductService productService;
+    @Inject private MerchantStoreService merchantStoreService;
+
+    public static class ProductLimits {
+        private Integer minPerCart, maxPerCart, packSize;
+        public Integer getMinPerCart() { return minPerCart; }
+        public void setMinPerCart(Integer v) { minPerCart = v; }
+        public Integer getMaxPerCart() { return maxPerCart; }
+        public void setMaxPerCart(Integer v) { maxPerCart = v; }
+        public Integer getPackSize() { return packSize; }
+        public void setPackSize(Integer v) { packSize = v; }
+    }
+    public static class CartRules {
+        private Integer maxLines, maxUnits;
+        public Integer getMaxLines() { return maxLines; }
+        public void setMaxLines(Integer v) { maxLines = v; }
+        public Integer getMaxUnits() { return maxUnits; }
+        public void setMaxUnits(Integer v) { maxUnits = v; }
+    }
+
+    @PutMapping("/product/{id}/limits")
+    public ProductLimits putProduct(@PathVariable Long id, @RequestBody ProductLimits request,
+            @ApiIgnore MerchantStore store) throws ServiceException {
+        Product p = productService.findOne(id, store);
+        if (p == null) throw new ResourceNotFoundException("Product not found");
+        validateProduct(request);
+        p.setMinPerCart(request.getMinPerCart()); p.setMaxPerCart(request.getMaxPerCart()); p.setPackSize(request.getPackSize());
+        productService.saveProduct(p);
+        return productLimits(p);
+    }
+
+    @GetMapping("/product/{id}/limits")
+    public ProductLimits getProduct(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        Product p = productService.findOne(id, store);
+        if (p == null) throw new ResourceNotFoundException("Product not found");
+        return productLimits(p);
+    }
+
+    @PutMapping("/cart-rules")
+    public CartRules putRules(@RequestBody CartRules request, @ApiIgnore MerchantStore store) throws ServiceException {
+        validatePositive(request.getMaxLines(), "maxLines"); validatePositive(request.getMaxUnits(), "maxUnits");
+        store.setMaxLines(request.getMaxLines()); store.setMaxUnits(request.getMaxUnits());
+        merchantStoreService.saveOrUpdate(store);
+        return rules(store);
+    }
+
+    @GetMapping("/cart-rules")
+    public CartRules getRules(@ApiIgnore MerchantStore store) { return rules(store); }
+
+    private static void validateProduct(ProductLimits r) {
+        validatePositive(r.getMinPerCart(), "minPerCart"); validatePositive(r.getMaxPerCart(), "maxPerCart"); validatePositive(r.getPackSize(), "packSize");
+        if (r.getMinPerCart() != null && r.getMaxPerCart() != null && r.getMinPerCart() > r.getMaxPerCart()) bad("minPerCart may not exceed maxPerCart");
+        if (r.getMaxPerCart() != null && r.getPackSize() != null && r.getMaxPerCart() < r.getPackSize()) bad("maxPerCart may not be less than packSize");
+    }
+    private static void validatePositive(Integer v, String name) { if (v != null && v < 1) bad(name + " must be at least 1"); }
+    private static void bad(String message) { throw new RestApiException("400", message); }
+    private static ProductLimits productLimits(Product p) { ProductLimits r = new ProductLimits(); r.setMinPerCart(p.getMinPerCart()); r.setMaxPerCart(p.getMaxPerCart()); r.setPackSize(p.getPackSize()); return r; }
+    private static CartRules rules(MerchantStore s) { CartRules r = new CartRules(); r.setMaxLines(s.getMaxLines()); r.setMaxUnits(s.getMaxUnits()); return r; }
+}
