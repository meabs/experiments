+	private void validateCartChange(ShoppingCart cart, List<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> changes,
+			MerchantStore store) {
+		Map<String, Integer> quantities = new HashMap<>();
+		Map<String, Product> products = new HashMap<>();
+		if (cart.getLineItems() != null) for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : cart.getLineItems()) {
+			quantities.put(i.getSku(), i.getQuantity()); products.put(i.getSku(), i.getProduct());
+		}
+		boolean addsLine = false, addsUnits = false;
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : changes) {
+			int old = quantities.getOrDefault(i.getSku(), 0), now = i.getQuantity();
+			if (now > 0 && old == 0) addsLine = true;
+			if (now > old) addsUnits = true;
+			if (now > 0) {
+				Product p = i.getProduct();
+				if (p.getMinPerCart() != null && now < p.getMinPerCart()) limit("MIN_PER_CART", p.getSku());
+				if (p.getMaxPerCart() != null && now > p.getMaxPerCart()) limit("MAX_PER_CART", p.getSku());
+				if (p.getPackSize() != null && now % p.getPackSize() != 0) limit("PACK_SIZE", p.getSku());
+				products.put(i.getSku(), p);
+			}
+			quantities.put(i.getSku(), now);
+		}
+		int lines = 0, units = 0;
+		for (Integer q : quantities.values()) if (q != null && q > 0) { lines++; units += q; }
+		if (addsLine && store.getMaxLines() != null && lines > store.getMaxLines()) limit("MAX_LINES", null);
+		if (addsUnits && store.getMaxUnits() != null && units > store.getMaxUnits()) limit("MAX_UNITS", null);
+	}
+
+	private static void limit(String rule, String sku) { throw new RestApiException(rule, "Cart limit " + rule + (sku == null ? "" : " for " + sku)); }
+
 	private String uniqueShoppingCartCode() {
 		return UUID.randomUUID().toString().replaceAll("-", "");
 	}
