+package com.salesmanager.shop.store.controller.shoppingCart.facade;
+
+import java.util.*;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.LimitWarning;
+import com.salesmanager.shop.store.api.exception.CartLimitException;
+
+public final class CartLimitValidator {
+    private CartLimitValidator() { }
+    public static void checkProduct(Product p, int quantity) {
+        if (quantity == 0) return;
+        if (p.getMinPerCart() != null && quantity < p.getMinPerCart()) fail("MIN_PER_CART", "Minimum quantity not met");
+        if (p.getMaxPerCart() != null && quantity > p.getMaxPerCart()) fail("MAX_PER_CART", "Maximum quantity exceeded");
+        if (p.getPackSize() != null && quantity % p.getPackSize() != 0) fail("PACK_SIZE", "Quantity must be a multiple of pack size");
+    }
+    public static void checkChange(ShoppingCart cart, Product changed, int quantity, MerchantStore store) {
+        Map<Long,Integer> proposed = quantities(cart);
+        int oldLines = proposed.size(), oldUnits = proposed.values().stream().mapToInt(Integer::intValue).sum();
+        if (quantity == 0) proposed.remove(changed.getId()); else proposed.put(changed.getId(), quantity);
+        checkProduct(changed, quantity);
+        int lines = proposed.size(), units = proposed.values().stream().mapToInt(Integer::intValue).sum();
+        if (store.getMaxLines() != null && lines > oldLines && lines > store.getMaxLines()) fail("MAX_LINES", "Maximum cart lines exceeded");
+        if (store.getMaxUnits() != null && units > oldUnits && units > store.getMaxUnits()) fail("MAX_UNITS", "Maximum cart units exceeded");
+    }
+    public static void checkMulti(ShoppingCart cart, List<ShoppingCartItem> changes, MerchantStore store) {
+        Map<Long,Integer> proposed = quantities(cart);
+        int oldLines=proposed.size(), oldUnits=proposed.values().stream().mapToInt(Integer::intValue).sum();
+        for (ShoppingCartItem i : changes) { checkProduct(i.getProduct(), i.getQuantity()); if (i.getQuantity()==0) proposed.remove(i.getProduct().getId()); else proposed.put(i.getProduct().getId(), i.getQuantity()); }
+        int lines=proposed.size(), units=proposed.values().stream().mapToInt(Integer::intValue).sum();
+        if (store.getMaxLines()!=null && lines>oldLines && lines>store.getMaxLines()) fail("MAX_LINES", "Maximum cart lines exceeded");
+        if (store.getMaxUnits()!=null && units>oldUnits && units>store.getMaxUnits()) fail("MAX_UNITS", "Maximum cart units exceeded");
+    }
+    public static List<LimitWarning> warnings(ShoppingCart cart, MerchantStore store) {
+        List<LimitWarning> out=new ArrayList<>(); int units=0;
+        if (cart.getLineItems()!=null) for (ShoppingCartItem i:cart.getLineItems()) { units+=i.getQuantity(); Product p=i.getProduct(); if (p==null) continue;
+            if (p.getMinPerCart()!=null && i.getQuantity()<p.getMinPerCart()) out.add(new LimitWarning(p.getSku(),"MIN_PER_CART"));
+            if (p.getMaxPerCart()!=null && i.getQuantity()>p.getMaxPerCart()) out.add(new LimitWarning(p.getSku(),"MAX_PER_CART"));
+            if (p.getPackSize()!=null && i.getQuantity()%p.getPackSize()!=0) out.add(new LimitWarning(p.getSku(),"PACK_SIZE")); }
+        int lines=cart.getLineItems()==null?0:(int)cart.getLineItems().stream().map(i -> i.getProduct().getId()).distinct().count();
+        if (store.getMaxLines()!=null && lines>store.getMaxLines()) out.add(new LimitWarning(null,"MAX_LINES"));
+        if (store.getMaxUnits()!=null && units>store.getMaxUnits()) out.add(new LimitWarning(null,"MAX_UNITS")); return out;
+    }
+    private static Map<Long,Integer> quantities(ShoppingCart c) { Map<Long,Integer> m=new HashMap<>(); if(c.getLineItems()!=null) for(ShoppingCartItem i:c.getLineItems()) m.put(i.getProduct().getId(),i.getQuantity()); return m; }
+    private static void fail(String code,String message) { throw new CartLimitException(code,message); }
+}
