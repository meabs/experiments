+package com.salesmanager.shop.store.api.v1.cart;
+
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private")
+public class CartLimitsApi {
+    @Inject private ProductService productService;
+    @Inject private MerchantStoreService merchantStoreService;
+
+    @PutMapping("/product/{id}/limits")
+    public ProductLimits setProduct(@PathVariable Long id, @RequestBody ProductLimits request,
+            @ApiIgnore MerchantStore store) {
+        Product product = productService.getById(id);
+        if (product == null || product.getMerchantStore() == null || !product.getMerchantStore().getId().equals(store.getId()))
+            throw new ResourceNotFoundException("Product not found");
+        validateProduct(request);
+        product.setMinPerCart(request.minPerCart); product.setMaxPerCart(request.maxPerCart); product.setPackSize(request.packSize);
+        try { productService.saveProduct(product); } catch (Exception e) { throw new RestApiException("500", e.getMessage(), e); }
+        return ProductLimits.from(product);
+    }
+    @GetMapping("/product/{id}/limits")
+    public ProductLimits getProduct(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        Product product = productService.getById(id);
+        if (product == null || product.getMerchantStore() == null || !product.getMerchantStore().getId().equals(store.getId()))
+            throw new ResourceNotFoundException("Product not found");
+        return ProductLimits.from(product);
+    }
+    @PutMapping("/cart-rules")
+    public CartRules setCart(@RequestBody CartRules request, @ApiIgnore MerchantStore store) {
+        validatePositive(request.maxLines, "maxLines"); validatePositive(request.maxUnits, "maxUnits");
+        store.setMaxLines(request.maxLines); store.setMaxUnits(request.maxUnits);
+        try { merchantStoreService.saveOrUpdate(store); } catch (Exception e) { throw new RestApiException("500", e.getMessage(), e); }
+        return CartRules.from(store);
+    }
+    @GetMapping("/cart-rules")
+    public CartRules getCart(@ApiIgnore MerchantStore store) { return CartRules.from(store); }
+    private static void validateProduct(ProductLimits r) {
+        validatePositive(r.minPerCart, "minPerCart"); validatePositive(r.maxPerCart, "maxPerCart"); validatePositive(r.packSize, "packSize");
+        if (r.minPerCart != null && r.maxPerCart != null && r.minPerCart > r.maxPerCart) bad("minPerCart may not exceed maxPerCart");
+        if (r.maxPerCart != null && r.packSize != null && r.maxPerCart < r.packSize) bad("maxPerCart may not be less than packSize");
+    }
+    private static void validatePositive(Integer n, String name) { if (n != null && n < 1) bad(name + " must be at least 1"); }
+    private static void bad(String message) { throw new RestApiException("400", message); }
+    public static class ProductLimits {
+        public Integer minPerCart, maxPerCart, packSize;
+        public static ProductLimits from(Product p) { ProductLimits r = new ProductLimits(); r.minPerCart=p.getMinPerCart(); r.maxPerCart=p.getMaxPerCart(); r.packSize=p.getPackSize(); return r; }
+    }
+    public static class CartRules {
+        public Integer maxLines, maxUnits;
+        public static CartRules from(MerchantStore s) { CartRules r=new CartRules(); r.maxLines=s.getMaxLines(); r.maxUnits=s.getMaxUnits(); return r; }
+    }
+}
