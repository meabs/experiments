+	private boolean isEligible(Discount discount, OrderSummary summary, ShoppingCartItem item, Product product) {
+		LocalDate today = LocalDate.now();
+		if (!discount.isActive() || discount.getStartDate() != null && today.isBefore(discount.getStartDate())
+				|| discount.getEndDate() != null && today.isAfter(discount.getEndDate())) return false;
+		BigDecimal subtotal = BigDecimal.ZERO;
+		for (ShoppingCartItem i : summary.getProducts()) {
+			BigDecimal price = i.getItemPrice();
+			if (price == null && i.getProduct() != null) {
+				try { price = pricingService.calculateProductPrice(i.getProduct()).getFinalPrice(); } catch (Exception ignored) { }
+			}
+			if (price != null) subtotal = subtotal.add(price.multiply(BigDecimal.valueOf(i.getQuantity())));
+		}
+		if (discount.getMinimumSubtotal() != null && subtotal.compareTo(discount.getMinimumSubtotal()) < 0) return false;
+		return isItemEligible(discount, product);
+	}
+
+	private boolean isItemEligible(Discount discount, Product product) {
+		if (discount.getCategoryIds() == null || discount.getCategoryIds().isEmpty()) return true;
+		Set<Long> ids = new HashSet<>();
+		for (Category c : product.getCategories()) while (c != null) { ids.add(c.getId()); c = c.getParent(); }
+		return discount.getCategoryIds().stream().anyMatch(ids::contains);
+	}
+
+	private boolean isFirstEligible(OrderSummary summary, Discount discount, ShoppingCartItem item) {
+		for (ShoppingCartItem candidate : summary.getProducts()) {
+			if (candidate.getProduct() != null && isItemEligible(discount, candidate.getProduct())) {
+				return candidate == item || candidate.getId() != null && candidate.getId().equals(item.getId());
+			}
+		}
+		return false;
+	}
+
