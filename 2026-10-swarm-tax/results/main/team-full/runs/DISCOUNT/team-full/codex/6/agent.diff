+package com.salesmanager.shop.store.api.v1.discount;
+import java.math.BigDecimal; import java.time.LocalDate; import java.util.*; import java.util.stream.Collectors; import javax.inject.Inject; import javax.validation.Valid;
+import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.business.services.catalog.category.CategoryService; import com.salesmanager.core.business.services.catalog.discount.DiscountService; import com.salesmanager.core.model.catalog.discount.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.constants.Constants; import com.salesmanager.shop.model.catalog.discount.PersistableDiscount; import com.salesmanager.shop.store.api.exception.*; import com.salesmanager.shop.store.controller.user.facade.UserFacade; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/discounts") public class DiscountApi {
+ @Inject private DiscountService service; @Inject private CategoryService categoryService; @Inject private UserFacade userFacade;
+ private void auth(){String u=userFacade.authenticatedUser(); if(u==null) throw new UnauthorizedException(); userFacade.authorizedGroup(u,Arrays.asList(Constants.GROUP_SUPERADMIN,Constants.GROUP_ADMIN,Constants.GROUP_ADMIN_RETAIL));}
+ private Discount map(PersistableDiscount p, MerchantStore s, Discount d){ if(p.getCode()==null||p.getCode().trim().isEmpty()||p.getType()==null||p.getValue()==null) throw new ConstraintException("code, type and value are required"); BigDecimal v=p.getValue(); if(v.signum()<0 || (p.getType()==DiscountType.PERCENT && v.compareTo(new BigDecimal("100"))>0)) throw new ConstraintException("invalid value"); if(p.getMinimumSubtotal()!=null&&p.getMinimumSubtotal().signum()<0) throw new ConstraintException("invalid minimumSubtotal"); if(p.getStartDate()!=null&&p.getEndDate()!=null&&p.getEndDate().isBefore(p.getStartDate())) throw new ConstraintException("invalid dates"); if(p.getCategoryIds()!=null) for(Long id:p.getCategoryIds()) if(categoryService.getById(id,s.getId())==null) throw new ConstraintException("category does not exist"); d.setMerchantStore(s); d.setCode(p.getCode().trim()); d.setType(p.getType()); d.setValue(v); d.setMinimumSubtotal(p.getMinimumSubtotal()); d.setStartDate(p.getStartDate()==null?LocalDate.now():p.getStartDate()); d.setEndDate(p.getEndDate()); d.setCategoryIds(p.getCategoryIds()); d.setActive(p.getActive()==null?true:p.getActive()); return d; }
+ private PersistableDiscount out(Discount d){PersistableDiscount p=new PersistableDiscount();p.setId(d.getId());p.setCode(d.getCode());p.setType(d.getType());p.setValue(d.getValue());p.setMinimumSubtotal(d.getMinimumSubtotal());p.setStartDate(d.getStartDate());p.setEndDate(d.getEndDate());p.setCategoryIds(d.getCategoryIds());p.setActive(d.isActive());return p;}
+ @GetMapping public List<PersistableDiscount> list(@ApiIgnore MerchantStore s){auth();return service.list(s.getId()).stream().map(this::out).collect(Collectors.toList());}
+ @GetMapping("/{id}") public PersistableDiscount get(@PathVariable Long id,@ApiIgnore MerchantStore s){auth();Discount d=service.get(id,s.getId());if(d==null)throw new ResourceNotFoundException("Discount not found");return out(d);}
+ @PostMapping @ResponseStatus(HttpStatus.CREATED) public PersistableDiscount create(@Valid @RequestBody PersistableDiscount p,@ApiIgnore MerchantStore s){auth();if(service.exists(s.getId(),p.getCode(),null))throw new org.springframework.web.server.ResponseStatusException(HttpStatus.CONFLICT,"Code already exists");return out(service.save(map(p,s,new Discount())));}
+ @PutMapping("/{id}") public PersistableDiscount update(@PathVariable Long id,@Valid @RequestBody PersistableDiscount p,@ApiIgnore MerchantStore s){auth();Discount d=service.get(id,s.getId());if(d==null)throw new ResourceNotFoundException("Discount not found");if(service.exists(s.getId(),p.getCode(),id))throw new org.springframework.web.server.ResponseStatusException(HttpStatus.CONFLICT,"Code already exists");return out(service.save(map(p,s,d)));}
+ @DeleteMapping("/{id}") @ResponseStatus(HttpStatus.NO_CONTENT) public void delete(@PathVariable Long id,@ApiIgnore MerchantStore s){auth();if(service.get(id,s.getId())==null)throw new ResourceNotFoundException("Discount not found");service.delete(id,s.getId());}
+}
