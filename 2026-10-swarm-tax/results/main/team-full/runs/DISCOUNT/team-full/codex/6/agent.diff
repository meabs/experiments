+@Service("discountService") public class DiscountServiceImpl implements DiscountService {
+ @Inject private DiscountRepository repo;
+ public Discount save(Discount d){return repo.save(d);} public List<Discount> list(Integer s){return repo.findByMerchantStoreIdOrderByIdDesc(s);}
+ public Discount get(Long id,Integer s){return repo.findByIdAndMerchantStoreId(id,s).orElse(null);} public Discount getByCode(Integer s,String c){return repo.findByMerchantStoreIdAndCodeIgnoreCase(s,c).orElse(null);} public void delete(Long id,Integer s){repo.findByIdAndMerchantStoreId(id,s).ifPresent(repo::delete);}
+ public boolean exists(Integer s,String c,Long except){return repo.findByMerchantStoreIdAndCodeIgnoreCase(s,c).filter(x->except==null||!x.getId().equals(except)).isPresent();}
+}
