+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.api.exception.DiscountConflictException;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/discounts")
+public class DiscountAdministrationApi {
+    @Inject private DiscountService discountService;
+
+    @GetMapping(produces = MediaType.APPLICATION_JSON_VALUE)
+    @ApiImplicitParams(@ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT"))
+    public List<Discount> list(@ApiIgnore MerchantStore store) { return discountService.listByStore(store); }
+
+    @GetMapping(value = "/{id}", produces = MediaType.APPLICATION_JSON_VALUE)
+    public Discount get(@PathVariable Long id, @ApiIgnore MerchantStore store) { return require(id, store); }
+
+    @PostMapping(consumes = MediaType.APPLICATION_JSON_VALUE, produces = MediaType.APPLICATION_JSON_VALUE)
+    @ResponseStatus(HttpStatus.CREATED)
+    public Discount create(@RequestBody Discount discount, @ApiIgnore MerchantStore store) { return save(discount, store); }
+
+    @PutMapping(value = "/{id}", consumes = MediaType.APPLICATION_JSON_VALUE, produces = MediaType.APPLICATION_JSON_VALUE)
+    public Discount update(@PathVariable Long id, @RequestBody Discount discount, @ApiIgnore MerchantStore store) {
+        require(id, store); discount.setId(id); return save(discount, store);
+    }
+
+    @DeleteMapping("/{id}")
+    @ResponseStatus(HttpStatus.NO_CONTENT)
+    public void delete(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        Discount found = require(id, store);
+        try { discountService.delete(found); } catch (ServiceException e) { throw new ServiceRuntimeException(e.getMessage()); }
+    }
+    private Discount save(Discount d, MerchantStore store) { d.setStore(store); try { discountService.saveOrUpdate(d); return d; } catch (ServiceException e) { if (e.getMessage() != null && e.getMessage().toLowerCase().contains("already exists")) throw new DiscountConflictException(e.getMessage()); throw new ServiceRuntimeException("400", e.getMessage(), new IllegalArgumentException(e.getMessage())); } }
+    private Discount require(Long id, MerchantStore store) { Discount d = discountService.getById(store, id); if (d == null) throw new ResourceNotFoundException("Discount not found"); return d; }
+}
