+package com.salesmanager.core.business.services.discount;
+
+import java.math.BigDecimal;
+import java.util.Date;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.category.CategoryRepository;
+import com.salesmanager.core.business.repositories.discount.DiscountRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("discountService")
+public class DiscountServiceImpl extends SalesManagerEntityServiceImpl<Long, Discount> implements DiscountService {
+    private final DiscountRepository repository;
+    private final CategoryRepository categoryRepository;
+    @Inject
+    public DiscountServiceImpl(DiscountRepository repository, CategoryRepository categoryRepository) {
+        super(repository); this.repository = repository; this.categoryRepository = categoryRepository;
+    }
+    public Discount getByCode(MerchantStore store, String code) { return store == null || code == null ? null : repository.findByStoreAndCode(store.getId(), code.trim()); }
+    public Discount getById(MerchantStore store, Long id) { return store == null || id == null ? null : repository.findByIdAndStore(id, store.getId()); }
+    public List<Discount> listByStore(MerchantStore store) { return store == null ? java.util.Collections.<Discount>emptyList() : repository.findByStore(store.getId()); }
+    public Discount findByCode(MerchantStore store, String code) { return getByCode(store, code); }
+    public Discount findById(MerchantStore store, Long id) { return getById(store, id); }
+    public void saveOrUpdate(Discount discount) throws ServiceException {
+        validate(discount);
+        Discount existing = getByCode(discount.getStore(), discount.getCode());
+        if (existing != null && !existing.getId().equals(discount.getId())) throw new ServiceException("Discount code already exists");
+        discount.setCode(discount.getCode().trim());
+        if (discount.getId() == null) create(discount); else update(discount);
+    }
+    private void validate(Discount d) throws ServiceException {
+        if (d == null || d.getStore() == null || d.getCode() == null || d.getCode().trim().isEmpty() || d.getType() == null || d.getValue() == null) throw new ServiceException("Required discount fields are missing");
+        if (d.getValue().compareTo(BigDecimal.ZERO) < 0 || (d.getType() == DiscountType.PERCENT && d.getValue().compareTo(new BigDecimal("100")) > 0)) throw new ServiceException("Invalid discount value");
+        if (d.getMinimumSubtotal() != null && d.getMinimumSubtotal().compareTo(BigDecimal.ZERO) < 0) throw new ServiceException("Invalid minimum subtotal");
+        Date start = d.getStartDate(), end = d.getEndDate(); if (start != null && end != null && end.before(start)) throw new ServiceException("Invalid discount dates");
+        List<String> cats = d.getCategories(); Set<String> unique = new HashSet<>();
+        if (cats != null) for (int i = 0; i < cats.size(); i++) { String code = cats.get(i); if (code == null || code.trim().isEmpty() || !unique.add(code.trim().toLowerCase())) throw new ServiceException("Invalid discount category"); code = code.trim(); cats.set(i, code); if (categoryRepository.findByCodeIgnoreCase(d.getStore().getCode(), code) == null) throw new ServiceException("Unknown category: " + code); }
+    }
+}
