+package com.salesmanager.shop.store.api.v1.discount;
+
+import java.util.List;
+import java.util.stream.Collectors;
+import javax.validation.Valid;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.business.services.discount.DiscountCodeService;
+import com.salesmanager.core.model.discount.DiscountCode;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.discount.PersistableDiscountCode;
+import com.salesmanager.shop.model.discount.ReadableDiscountCode;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/discounts")
+public class DiscountCodeApi {
+ private final DiscountCodeService service; private final CategoryService categoryService;
+ public DiscountCodeApi(DiscountCodeService s, CategoryService c){service=s;categoryService=c;}
+ @PostMapping public ResponseEntity<ReadableDiscountCode> create(@ApiIgnore MerchantStore store,@Valid @RequestBody PersistableDiscountCode input) throws com.salesmanager.core.business.exception.ServiceException{
+   validate(input,store); if(service.exists(input.getCode().trim(),store)) return ResponseEntity.status(HttpStatus.CONFLICT).build();
+   DiscountCode d=toModel(input,store); d=service.saveOrUpdate(d); return ResponseEntity.status(HttpStatus.CREATED).body(toDto(d));
+ }
+ @GetMapping public List<ReadableDiscountCode> list(@ApiIgnore MerchantStore store) throws com.salesmanager.core.business.exception.ServiceException{return service.listByStore(store).stream().map(this::toDto).collect(Collectors.toList());}
+ @PutMapping("/{id}") public ResponseEntity<ReadableDiscountCode> update(@PathVariable Long id,@ApiIgnore MerchantStore store,@Valid @RequestBody PersistableDiscountCode input) throws com.salesmanager.core.business.exception.ServiceException{
+   validate(input,store); DiscountCode d=service.getById(id,store); if(d==null) throw new ResourceNotFoundException("Discount code not found ["+id+"]");
+   DiscountCode duplicate=service.listByStore(store).stream().filter(x->x.getId()!=null&&!x.getId().equals(id)&&x.getCode().equalsIgnoreCase(input.getCode().trim())).findFirst().orElse(null);
+   if(duplicate!=null)return ResponseEntity.status(HttpStatus.CONFLICT).build(); d=toModel(input,store); d.setId(id); d=service.saveOrUpdate(d); return ResponseEntity.ok(toDto(d));
+ }
+ @DeleteMapping("/{id}") public ResponseEntity<Void> delete(@PathVariable Long id,@ApiIgnore MerchantStore store) throws com.salesmanager.core.business.exception.ServiceException{DiscountCode d=service.getById(id,store);if(d==null)throw new ResourceNotFoundException("Discount code not found ["+id+"]");service.delete(d);return ResponseEntity.noContent().build();}
+ private void validate(PersistableDiscountCode i,MerchantStore s){
+   if(i==null||i.getCode()==null||i.getCode().trim().isEmpty()||i.getType()==null||i.getValue()==null) throw new RestApiException("code, type and value are required");
+   DiscountType t;try{t=DiscountType.valueOf(i.getType().toUpperCase());}catch(Exception e){throw new RestApiException("type must be PERCENT or AMOUNT");}
+   if(i.getValue().signum()<=0||(t==DiscountType.PERCENT&&i.getValue().compareTo(java.math.BigDecimal.valueOf(100))>0))throw new RestApiException("invalid discount value");
+   if(i.getStartDate()!=null&&i.getEndDate()!=null&&i.getEndDate().isBefore(i.getStartDate()))throw new RestApiException("endDate must not precede startDate");
+   if(i.getMinimumSubtotal()!=null&&i.getMinimumSubtotal().signum()<0) throw new RestApiException("minimumSubtotal must not be negative");
+   if(i.getCategoryIds()!=null) try { for(Long id:i.getCategoryIds()) if(id==null||categoryService.getById(s,id)==null) throw new RestApiException("unknown category"); } catch(com.salesmanager.core.business.exception.ServiceException e){throw new RestApiException("unable to validate category",e);}
+   if(i.getCategories()!=null) try { for(String c:i.getCategories()) if(c==null||categoryService.getByCode(s,c)==null) throw new RestApiException("unknown category"); } catch(com.salesmanager.core.business.exception.ServiceException e){throw new RestApiException("unable to validate category",e);}
+ }
+ private DiscountCode toModel(PersistableDiscountCode i,MerchantStore s){DiscountCode d=new DiscountCode();d.setCode(i.getCode().trim());d.setType(DiscountType.valueOf(i.getType().toUpperCase()));d.setValue(i.getValue());d.setMinimumSubtotal(i.getMinimumSubtotal());d.setActive(i.isActive());d.setStartDate(i.getStartDate()==null?java.time.LocalDate.now():i.getStartDate());d.setEndDate(i.getEndDate());d.setCategoryIds(i.getCategoryIds());d.setCategoryCodes(i.getCategories());d.setMerchantStore(s);return d;}
+ private ReadableDiscountCode toDto(DiscountCode d){ReadableDiscountCode r=new ReadableDiscountCode();r.setId(d.getId());r.setCode(d.getCode());r.setType(d.getType().name());r.setValue(d.getValue());r.setMinimumSubtotal(d.getMinimumSubtotal());r.setActive(d.isActive());r.setStartDate(d.getStartDate());r.setEndDate(d.getEndDate());r.setCategoryIds(d.getCategoryIds());r.setCategories(d.getCategoryCodes());return r;}
+}
