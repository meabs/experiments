+@Component public class PromoCodeCalculatorModule implements OrderTotalPostProcessorModule {
+ @Inject private DiscountCodeService service; private String name,code; public String getName(){return name;} public void setName(String v){name=v;} public String getCode(){return code;} public void setCode(String v){code=v;}
+ public OrderTotal caculateProductPiceVariation(OrderSummary s,ShoppingCartItem item,Product product,Customer customer,MerchantStore store)throws Exception{
+  if(s==null||StringUtils.isBlank(s.getPromoCode())||item==null||product==null)return null; DiscountCode d=service.getByCode(s.getPromoCode().trim(),store); if(d==null||!d.isActive()||d.getValue()==null||d.getType()==null)return null; LocalDate now=LocalDate.now(); if(d.getStartDate()!=null&&now.isBefore(d.getStartDate())||d.getEndDate()!=null&&now.isAfter(d.getEndDate()))return null;
+  BigDecimal cart=BigDecimal.ZERO,eligible=BigDecimal.ZERO; ShoppingCartItem first=null; for(ShoppingCartItem i:s.getProducts()){BigDecimal line=i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity()));cart=cart.add(line);if(eligible(i.getProduct(),d)){eligible=eligible.add(line);if(first==null)first=i;}}
+  if(d.getMinimumSubtotal()!=null&&cart.compareTo(d.getMinimumSubtotal())<0||first==null||!eligible(item.getProduct(),d))return null;
+  if(d.getType()==DiscountType.AMOUNT && !sameItem(item, first))return null;
+  BigDecimal itemBase=item.getItemPrice().multiply(BigDecimal.valueOf(item.getQuantity())); BigDecimal reduction=d.getType()==DiscountType.PERCENT?itemBase.multiply(d.getValue()).divide(BigDecimal.valueOf(100),8,RoundingMode.HALF_UP):d.getValue(); reduction=reduction.min(itemBase).min(eligible).setScale(2,RoundingMode.HALF_UP); if(reduction.signum()<=0)return null;
+  OrderTotal t=new OrderTotal();t.setOrderTotalCode(Constants.OT_DISCOUNT_TITLE);t.setOrderTotalType(OrderTotalType.SUBTOTAL);t.setTitle(Constants.OT_DISCOUNT_TITLE);t.setText(s.getPromoCode());t.setValue(reduction);return t;
+ }
+ private boolean sameItem(ShoppingCartItem left, ShoppingCartItem right){
+  if(left.getId()!=null&&right.getId()!=null)return left.getId().equals(right.getId());
+  return Objects.equals(left.getSku(),right.getSku())&&Objects.equals(left.getVariant(),right.getVariant())&&Objects.equals(left.getProductId(),right.getProductId());
+ }
+ private boolean eligible(Product p,DiscountCode d){boolean unrestricted=(d.getCategoryIds()==null||d.getCategoryIds().isEmpty())&&(d.getCategoryCodes()==null||d.getCategoryCodes().isEmpty());if(unrestricted)return true;Set<Long> ids=new HashSet<>();Set<String> codes=new HashSet<>();if(p.getCategories()!=null)for(Category c:p.getCategories())while(c!=null){if(c.getId()!=null)ids.add(c.getId());if(c.getCode()!=null)codes.add(c.getCode().toLowerCase());c=c.getParent();}for(Long id:d.getCategoryIds())if(ids.contains(id))return true;for(String code:d.getCategoryCodes())if(code!=null&&codes.contains(code.toLowerCase()))return true;return false;}
 }
