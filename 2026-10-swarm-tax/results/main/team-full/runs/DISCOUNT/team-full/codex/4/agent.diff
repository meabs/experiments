+@Service("discountCodeService")
+public class DiscountCodeServiceImpl extends SalesManagerEntityServiceImpl<Long,DiscountCode> implements DiscountCodeService {
+ private final DiscountCodeRepository repository;
+ @Inject public DiscountCodeServiceImpl(DiscountCodeRepository repository){super(repository);this.repository=repository;}
+ public List<DiscountCode> listByStore(MerchantStore s)throws ServiceException{return repository.findByStore(s.getId());}
+ public DiscountCode getById(Long id,MerchantStore s)throws ServiceException{return repository.findByIdAndStore(id,s.getId());}
+ public boolean exists(String c,MerchantStore s)throws ServiceException{return repository.findByStoreAndCode(s.getId(),c)!=null;}
+ public DiscountCode getByCode(String c,MerchantStore s)throws ServiceException{return repository.findByStoreAndCode(s.getId(),c);}
+ public DiscountCode saveOrUpdate(DiscountCode c)throws ServiceException{return repository.saveAndFlush(c);}
+}
