+package com.salesmanager.shop.store.api.v1.discount;
+import java.math.BigDecimal; import java.util.List; import java.util.stream.Collectors;
+import javax.inject.Inject; import javax.validation.Valid;
+import org.springframework.http.HttpStatus; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.discount.DiscountService;
+import com.salesmanager.core.model.catalog.category.Category; import com.salesmanager.core.model.discount.Discount; import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.constants.Constants; import com.salesmanager.shop.model.discount.PersistableDiscount; import com.salesmanager.shop.model.discount.ReadableDiscount; import com.salesmanager.shop.model.entity.Entity; import com.salesmanager.shop.store.api.exception.RestApiException; import com.salesmanager.shop.store.api.exception.UnauthorizedException; import com.salesmanager.shop.store.controller.user.facade.UserFacade; import com.salesmanager.shop.mapper.discount.DiscountMapper;
+import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/discounts")
+public class DiscountApi {
+ @Inject private DiscountService service; @Inject private CategoryService categoryService; @Inject private DiscountMapper mapper; @Inject private UserFacade userFacade;
+ private void auth(){String u=userFacade.authenticatedUser(); if(u==null) throw new UnauthorizedException(); userFacade.authorizedGroup(u, java.util.Arrays.asList(Constants.GROUP_SUPERADMIN,Constants.GROUP_ADMIN,Constants.GROUP_ADMIN_CATALOGUE,Constants.GROUP_ADMIN_RETAIL));}
+ private void validate(PersistableDiscount p, MerchantStore s, Long id){if(p.getValue()==null||p.getValue().compareTo(BigDecimal.ZERO)<=0) throw new RestApiException("400","Discount value must be positive"); if(p.getType()==null) throw new RestApiException("400","Discount type is required"); if(p.getType().name().equals("PERCENT")&&p.getValue().compareTo(new BigDecimal("100"))>0) throw new RestApiException("400","Percentage cannot exceed 100"); if(p.getMinimumSubtotal()!=null&&p.getMinimumSubtotal().signum()<0) throw new RestApiException("400","Minimum subtotal cannot be negative"); if(p.getStartDate()!=null&&p.getEndDate()!=null&&p.getStartDate().after(p.getEndDate())) throw new RestApiException("400","Invalid date range"); Discount existing=service.getByCode(p.getCode(),s); if(existing!=null&&(id==null||!existing.getId().equals(id))) throw new DiscountConflictException("Discount code already exists"); if(p.getCategoryCodes()!=null) for(String code:p.getCategoryCodes()){try {Category c=categoryService.getByCode(s,code);if(c==null)throw new RestApiException("400","Unknown category: "+code);} catch(ServiceException e){throw new RestApiException("400","Unable to validate category");}}}
+ @PostMapping @ResponseStatus(HttpStatus.CREATED) public Entity create(@ApiIgnore MerchantStore s,@Valid @RequestBody PersistableDiscount p){auth();validate(p,s,null);Discount d=mapper.toEntity(p,new Discount());d.setMerchantStore(s);return new Entity(service.saveOrUpdate(d).getId());}
+ @GetMapping public List<ReadableDiscount> list(@ApiIgnore MerchantStore s){auth();return service.listByStore(s).stream().map(mapper::toDto).collect(Collectors.toList());}
+ @PutMapping("/{id}") public ReadableDiscount update(@ApiIgnore MerchantStore s,@PathVariable Long id,@Valid @RequestBody PersistableDiscount p){auth();Discount d=service.getById(id,s);if(d==null)throw new RestApiException("404","Discount not found");validate(p,s,id);return mapper.toDto(service.saveOrUpdate(mapper.toEntity(p,d)));}
+ @DeleteMapping("/{id}") @ResponseStatus(HttpStatus.NO_CONTENT) public void delete(@ApiIgnore MerchantStore s,@PathVariable Long id){auth();Discount d=service.getById(id,s);if(d==null)throw new RestApiException("404","Discount not found");try {service.delete(d);} catch(ServiceException e){throw new RestApiException("400","Unable to delete discount");}}
+}
