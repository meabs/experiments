+public class DiscountServiceImpl extends SalesManagerEntityServiceImpl<Long,Discount> implements DiscountService {
+ private final DiscountRepository repository;
+ @Inject public DiscountServiceImpl(DiscountRepository repository){super(repository);this.repository=repository;}
+ public List<Discount> listByStore(MerchantStore s){return repository.findByStore(s.getId());}
+ public Discount getById(Long id,MerchantStore s){return repository.findByStoreAndId(s.getId(),id);}
