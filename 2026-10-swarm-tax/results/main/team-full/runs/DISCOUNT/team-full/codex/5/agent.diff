+@Component public class PromoCodeCalculatorModule implements OrderTotalPostProcessorModule {
+ @Autowired private DiscountService discountService; @Autowired private ProductService productService; private String name,code;
+ public String getName(){return name;} public void setName(String n){name=n;} public String getCode(){return code;} public void setCode(String c){code=c;}
+ public OrderTotal caculateProductPiceVariation(OrderSummary summary,ShoppingCartItem item,Product product,Customer customer,MerchantStore store)throws Exception{
+  Validate.notNull(summary,"OrderTotalSummary must not be null"); Validate.notNull(store,"MerchantStore must not be null");
+  if(StringUtils.isBlank(summary.getPromoCode())||product==null||item==null)return null; Discount d=discountService.getByCode(summary.getPromoCode(),store); Date now=new Date();
+  if(d==null||!d.isActive()||(d.getStartDate()!=null&&now.before(d.getStartDate()))||(d.getEndDate()!=null&&now.after(d.getEndDate()))||!eligible(d,product))return null;
+  BigDecimal eligible=BigDecimal.ZERO; for(ShoppingCartItem x:summary.getProducts()){ Product xp=x.getProduct(); if(xp==null && x.getSku()!=null) xp=productService.getBySku(x.getSku(),store); if(xp!=null&&eligible(d,xp))eligible=eligible.add(x.getItemPrice().multiply(BigDecimal.valueOf(x.getQuantity()))); }
+  if(d.getMinimumSubtotal()!=null&&eligible.compareTo(d.getMinimumSubtotal())<0)return null; BigDecimal line=item.getItemPrice().multiply(BigDecimal.valueOf(item.getQuantity()));
+  BigDecimal reduction=d.getType()==DiscountType.PERCENT?line.multiply(d.getValue()).divide(new BigDecimal("100"),2,RoundingMode.HALF_UP):(eligible.signum()==0?BigDecimal.ZERO:d.getValue().multiply(line).divide(eligible,2,RoundingMode.HALF_UP)); reduction=reduction.max(BigDecimal.ZERO).min(line).setScale(2,RoundingMode.HALF_UP); if(reduction.signum()==0)return null;
+  OrderTotal total=new OrderTotal(); total.setOrderTotalCode("discount"); total.setOrderTotalType(OrderTotalType.SUBTOTAL); total.setTitle(Constants.OT_SUBTOTAL_MODULE_CODE); total.setText(d.getCode()); total.setValue(reduction); return total;
+ }
+ private boolean eligible(Discount d,Product p){if(d.getCategoryCodes()==null||d.getCategoryCodes().isEmpty())return true;if(p.getCategories()==null)return false;for(Category c:p.getCategories())for(Category x=c;x!=null;x=x.getParent())for(String code:d.getCategoryCodes())if(code!=null&&code.equalsIgnoreCase(x.getCode()))return true;return false;}
 }
