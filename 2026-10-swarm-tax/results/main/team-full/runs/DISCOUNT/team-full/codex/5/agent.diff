+@Component public class DiscountMapper {
+ public Discount toEntity(PersistableDiscount p, Discount d){d.setCode(p.getCode().trim());d.setType(p.getType());d.setValue(p.getValue());d.setMinimumSubtotal(p.getMinimumSubtotal());d.setStartDate(p.getStartDate());d.setEndDate(p.getEndDate());d.setCategoryCodes(p.getCategoryCodes());d.setActive(p.isActive());return d;}
+ public ReadableDiscount toDto(Discount d){ReadableDiscount p=new ReadableDiscount();p.setId(d.getId());p.setCode(d.getCode());p.setType(d.getType());p.setValue(d.getValue());p.setMinimumSubtotal(d.getMinimumSubtotal());p.setStartDate(d.getStartDate());p.setEndDate(d.getEndDate());p.setCategoryCodes(d.getCategoryCodes());p.setActive(d.isActive());return p;}
+}
