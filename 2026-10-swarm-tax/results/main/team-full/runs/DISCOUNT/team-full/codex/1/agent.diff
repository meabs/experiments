+import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.category.Category; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.discount.Discount; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.order.*; import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+@Component public class PromoCodeCalculatorModule implements OrderTotalPostProcessorModule {
+ @Autowired private DiscountService discountService; private String name,code;
+ public String getName(){return name;} public void setName(String x){name=x;} public String getCode(){return code;} public void setCode(String x){code=x;}
+ public OrderTotal caculateProductPiceVariation(OrderSummary s,ShoppingCartItem i,Product p,Customer c,MerchantStore store)throws Exception{
+  if(StringUtils.isBlank(s.getPromoCode())||p==null)return null; Discount d=discountService.getByCode(s.getPromoCode(),store); if(d==null||!d.isActive()||!dates(d)||!category(d,p))return null;
+  if(i.getItemPrice()==null)return null;
+  BigDecimal line=i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity())), r; String t=StringUtils.defaultString(d.getType()).toUpperCase();
+  if(t.startsWith("PERCENT"))r=line.multiply(d.getValue()).divide(BigDecimal.valueOf(100),2,RoundingMode.HALF_UP); else {
+   if(s.getProducts()==null||s.getProducts().isEmpty()||s.getProducts().stream().filter(x->x.getItemPrice()!=null&&category(d,x.getProduct())).findFirst().orElse(null)!=i)return null;
+   BigDecimal eligible=s.getProducts().stream().filter(x->x.getItemPrice()!=null&&category(d,x.getProduct())).map(x->x.getItemPrice().multiply(BigDecimal.valueOf(x.getQuantity()))).reduce(BigDecimal.ZERO,BigDecimal::add);
+   r=d.getValue().min(eligible).setScale(2,RoundingMode.HALF_UP);
+  }
+  if(r.signum()<=0)return null; OrderTotal o=new OrderTotal(); o.setOrderTotalCode(Constants.OT_DISCOUNT_TITLE);o.setOrderTotalType(OrderTotalType.SUBTOTAL);o.setTitle(Constants.OT_SUBTOTAL_MODULE_CODE);o.setText(d.getCode());o.setValue(r);return o;
+ }
+ private boolean dates(Discount d){try{LocalDateTime n=LocalDateTime.now(); LocalDateTime start=parseDate(d.getStartDate(),false), end=parseDate(d.getEndDate(),true); return (start==null||!n.isBefore(start))&&(end==null||!n.isAfter(end));}catch(DateTimeParseException e){return false;}}
+ private LocalDateTime parseDate(String value,boolean end){if(StringUtils.isBlank(value))return null; try{return LocalDateTime.parse(value);}catch(DateTimeParseException e){return end?LocalDate.parse(value).atTime(23,59,59,999999999):LocalDate.parse(value).atStartOfDay();}}
+ private boolean category(Discount d,Product p){if(StringUtils.isBlank(d.getCategory()))return true;if(p==null||p.getCategories()==null)return false;for(Category c:p.getCategories())for(Category x=c;x!=null;x=x.getParent())if(d.getCategory().equalsIgnoreCase(x.getCode())||d.getCategory().equals(String.valueOf(x.getId())))return true;return false;}
 }
