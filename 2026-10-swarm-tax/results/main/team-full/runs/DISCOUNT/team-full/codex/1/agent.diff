+package com.salesmanager.shop.store.facade.discount;
+import java.time.*; import java.time.format.DateTimeParseException; import java.util.*; import java.util.stream.Collectors;
+import org.springframework.stereotype.Service; import javax.inject.Inject;
+import com.salesmanager.core.business.services.discount.DiscountService; import com.salesmanager.core.model.discount.Discount; import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.discount.*; import com.salesmanager.shop.model.entity.ReadableEntityList; import com.salesmanager.shop.store.api.exception.*;
+@Service
+public class DiscountFacadeImpl implements com.salesmanager.shop.store.controller.discount.facade.DiscountFacade {
+ private final DiscountService service;
+ @Inject public DiscountFacadeImpl(DiscountService service){this.service=service;}
+ public ReadableDiscount create(PersistableDiscount d,MerchantStore s){ validate(d,s); if(service.getByCode(d.getCode().trim(),s)!=null) throw new DiscountConflictException("Discount code already exists"); Discount x=toEntity(d,s); return read(service.saveOrUpdate(x)); }
+ public ReadableDiscount update(Long id,PersistableDiscount d,MerchantStore s){ validate(d,s); Discount x=service.getById(id,s); if(x==null) throw new ResourceNotFoundException("Discount not found"); Discount duplicate=service.getByCode(d.getCode().trim(),s); if(duplicate!=null&&!id.equals(duplicate.getId())) throw new DiscountConflictException("Discount code already exists"); x=toEntity(d,s); x.setId(id); return read(service.saveOrUpdate(x)); }
+ public ReadableDiscount get(Long id,MerchantStore s){Discount x=service.getById(id,s);if(x==null)throw new ResourceNotFoundException("Discount not found");return read(x);}
+ public ReadableEntityList<ReadableDiscount> list(MerchantStore s){List<ReadableDiscount> a=service.listByStore(s).stream().map(this::read).collect(Collectors.toList());ReadableEntityList<ReadableDiscount> r=new ReadableEntityList<>();r.setItems(a);r.setNumber(a.size());r.setRecordsTotal(a.size());r.setTotalPages(1);return r;}
+ public void delete(Long id,MerchantStore s){Discount x=service.getById(id,s);if(x==null)throw new ResourceNotFoundException("Discount not found");service.deleteDiscount(x);}
+ private void validate(PersistableDiscount d,MerchantStore s){if(s==null||s.getCode()==null)throw new RestApiException("Store is required");if(d==null||d.getCode()==null||d.getCode().trim().isEmpty()||d.getType()==null||d.getValue()==null)throw new RestApiException("code, type and value are required");String t=d.getType().toUpperCase(Locale.ROOT);if(!t.equals("PERCENTAGE")&&!t.equals("PERCENT")&&!t.equals("FIXED")&&!t.equals("AMOUNT"))throw new RestApiException("Invalid discount type");if(d.getValue().signum()<0||(t.startsWith("PERCENT")&&d.getValue().compareTo(java.math.BigDecimal.valueOf(100))>0))throw new RestApiException("Invalid discount value");LocalDateTime start=parse(d.getStartDate()),end=parse(d.getEndDate());if(start!=null&&end!=null&&end.isBefore(start))throw new RestApiException("endDate must not precede startDate");}
+ private LocalDateTime parse(String v){if(v==null||v.trim().isEmpty())return null;try{return LocalDateTime.parse(v);}catch(DateTimeParseException e){try{return LocalDate.parse(v).atStartOfDay();}catch(Exception x){throw new RestApiException("Invalid date");}}}
+ private Discount toEntity(PersistableDiscount d,MerchantStore s){Discount x=new Discount();x.setCode(d.getCode().trim());x.setType(d.getType().toUpperCase(Locale.ROOT));x.setValue(d.getValue());x.setStartDate(d.getStartDate());x.setEndDate(d.getEndDate());x.setCategory(d.getCategory());x.setActive(d.getActive()==null||d.getActive());x.setMerchantStore(s);return x;}
+ private ReadableDiscount read(Discount x){ReadableDiscount r=new ReadableDiscount();r.setId(x.getId());r.setCode(x.getCode());r.setType(x.getType());r.setValue(x.getValue());r.setStartDate(x.getStartDate());r.setEndDate(x.getEndDate());r.setCategory(x.getCategory());r.setActive(x.isActive());return r;}
+}
