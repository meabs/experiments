+package com.salesmanager.shop.store.api.v1.discount;
+import javax.validation.Valid; import org.springframework.beans.factory.annotation.Autowired; import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import springfox.documentation.annotations.ApiIgnore;
+import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.discount.*; import com.salesmanager.shop.model.entity.ReadableEntityList; import com.salesmanager.shop.store.controller.discount.facade.DiscountFacade; import com.salesmanager.shop.store.api.exception.DiscountConflictException;
+@RestController @RequestMapping("/api/v1/private/discounts")
+public class DiscountApi {
+ @Autowired private DiscountFacade facade;
+ @PostMapping public ResponseEntity<ReadableDiscount> create(@Valid @RequestBody PersistableDiscount d,@ApiIgnore MerchantStore s){return ResponseEntity.status(HttpStatus.CREATED).body(facade.create(d,s));}
+ @GetMapping public ReadableEntityList<ReadableDiscount> list(@ApiIgnore MerchantStore s){return facade.list(s);}
+ @GetMapping("/{id}") public ReadableDiscount get(@PathVariable Long id,@ApiIgnore MerchantStore s){return facade.get(id,s);}
+ @PutMapping("/{id}") public ReadableDiscount update(@PathVariable Long id,@Valid @RequestBody PersistableDiscount d,@ApiIgnore MerchantStore s){return facade.update(id,d,s);}
+ @DeleteMapping("/{id}") @ResponseStatus(HttpStatus.NO_CONTENT) public void delete(@PathVariable Long id,@ApiIgnore MerchantStore s){facade.delete(id,s);}
+ @ExceptionHandler(DiscountConflictException.class) public ResponseEntity<String> conflict(DiscountConflictException e){return ResponseEntity.status(HttpStatus.CONFLICT).body(e.getMessage());}
+}
