+package com.salesmanager.shop.store.api.v1.discount;
+import java.util.*; import javax.persistence.EntityManager; import javax.persistence.PersistenceContext; import javax.validation.Valid;
+import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import org.springframework.beans.factory.annotation.Autowired;
+import com.salesmanager.core.business.services.discount.DiscountService; import com.salesmanager.core.business.services.discount.DiscountConflictException; import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.model.catalog.category.Category; import com.salesmanager.core.model.discount.Discount; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.discount.*; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/discounts")
+public class DiscountsApi {
+ @Autowired private DiscountService service; @PersistenceContext private EntityManager entityManager;
+ @PostMapping public ResponseEntity<ReadableDiscount> create(@ApiIgnore MerchantStore store,@Valid @RequestBody PersistableDiscount dto) throws ServiceException {Discount d=toModel(dto,store); Discount saved=service.saveOrUpdate(d); return new ResponseEntity<ReadableDiscount>(toDto(saved),HttpStatus.CREATED);}
+ @GetMapping public List<ReadableDiscount> list(@ApiIgnore MerchantStore store) throws ServiceException {List<ReadableDiscount> out=new ArrayList<ReadableDiscount>(); for(Discount d:service.listByStore(store))out.add(toDto(d)); return out;}
+ @GetMapping("/{id}") public ResponseEntity<ReadableDiscount> get(@ApiIgnore MerchantStore store,@PathVariable Long id) throws ServiceException {Discount d=service.getById(id,store); return d==null?ResponseEntity.notFound().build():ResponseEntity.ok(toDto(d));}
+ @PutMapping("/{id}") public ResponseEntity<ReadableDiscount> update(@ApiIgnore MerchantStore store,@PathVariable Long id,@Valid @RequestBody PersistableDiscount dto) throws ServiceException {Discount old=service.getById(id,store); if(old==null)return ResponseEntity.notFound().build(); Discount d=toModel(dto,store); d.setId(id); Discount saved=service.saveOrUpdate(d); return ResponseEntity.ok(toDto(saved));}
