+package com.salesmanager.core.model.discount;
+
+import java.math.BigDecimal;
+import java.util.Date;
+import java.util.HashSet;
+import java.util.Set;
+import javax.persistence.*;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.generic.SalesManagerEntity;
+
+/** A merchant-owned promotion which can be applied by cart calculation. */
+@Entity
+@Table(name = "DISCOUNT", uniqueConstraints = @UniqueConstraint(columnNames = {"MERCHANT_ID", "DISCOUNT_CODE"}))
+public class Discount extends SalesManagerEntity<Long, Discount> {
+    private static final long serialVersionUID = 1L;
+    @Id @Column(name="DISCOUNT_ID")
+    @TableGenerator(name="TABLE_GEN", table="SM_SEQUENCER", pkColumnName="SEQ_NAME", valueColumnName="SEQ_COUNT", pkColumnValue="DISCOUNT_SEQ_NEXT_VAL")
+    @GeneratedValue(strategy=GenerationType.TABLE, generator="TABLE_GEN")
+    private Long id;
+    @Column(name="DISCOUNT_CODE", nullable=false, length=100) private String code;
+    @Column(name="DISCOUNT_TYPE", nullable=false, length=20) private String type;
+    @Column(name="DISCOUNT_VALUE", nullable=false, precision=19, scale=4) private BigDecimal value;
+    @Temporal(TemporalType.TIMESTAMP) @Column(name="START_DATE") private Date startDate;
+    @Temporal(TemporalType.TIMESTAMP) @Column(name="END_DATE") private Date endDate;
+    @Column(name="MINIMUM_AMOUNT", precision=19, scale=4) private BigDecimal minimumAmount;
+    @Column(name="ACTIVE", nullable=false) private boolean active = true;
+    @ManyToOne(fetch=FetchType.LAZY, optional=false) @JoinColumn(name="MERCHANT_ID", nullable=false) private MerchantStore merchantStore;
+    @ManyToMany(fetch=FetchType.LAZY)
+    @JoinTable(name="DISCOUNT_CATEGORY", joinColumns=@JoinColumn(name="DISCOUNT_ID"), inverseJoinColumns=@JoinColumn(name="CATEGORY_ID"))
+    private Set<Category> categories = new HashSet<Category>();
+    public Long getId(){return id;} public void setId(Long id){this.id=id;}
+    public String getCode(){return code;} public void setCode(String v){code=v;}
+    public String getType(){return type;} public void setType(String v){type=v;}
+    public BigDecimal getValue(){return value;} public void setValue(BigDecimal v){value=v;}
+    public Date getStartDate(){return startDate;} public void setStartDate(Date v){startDate=v;}
+    public Date getEndDate(){return endDate;} public void setEndDate(Date v){endDate=v;}
+    public BigDecimal getMinimumAmount(){return minimumAmount;} public void setMinimumAmount(BigDecimal v){minimumAmount=v;}
+    public boolean isActive(){return active;} public void setActive(boolean v){active=v;}
+    public MerchantStore getMerchantStore(){return merchantStore;} public void setMerchantStore(MerchantStore v){merchantStore=v;}
+    public Set<Category> getCategories(){return categories;} public void setCategories(Set<Category> v){categories=v;}
+}
