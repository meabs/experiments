+package com.salesmanager.core.business.services.discount;
+import java.math.BigDecimal; import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.business.repositories.discount.DiscountRepository; import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl; import com.salesmanager.core.model.discount.Discount; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("discountService")
+public class DiscountServiceImpl extends SalesManagerEntityServiceImpl<Long, Discount> implements DiscountService {
+ private final DiscountRepository repository;
+ @Inject public DiscountServiceImpl(DiscountRepository r){super(r); repository=r;}
+ public List<Discount> listByStore(MerchantStore s){return repository.findByMerchantStoreId(s.getId());}
+ public Discount getById(Long id, MerchantStore s){return repository.findByIdAndMerchantStoreId(id,s.getId());}
+ public Discount getByCode(String c, MerchantStore s){return repository.findByMerchantStoreIdAndCodeIgnoreCase(s.getId(),c);}
+ public Discount saveOrUpdate(Discount d) throws ServiceException { validate(d); Discount same=repository.findByMerchantStoreIdAndCodeIgnoreCase(d.getMerchantStore().getId(),d.getCode()); if(same!=null && (d.getId()==null || !same.getId().equals(d.getId()))) throw new DiscountConflictException("Discount code already exists"); return saveAndFlush(d); }
+ private void validate(Discount d){ if(d.getCode()==null||d.getCode().trim().isEmpty()) throw new IllegalArgumentException("code is required"); if(d.getType()==null||!(d.getType().equalsIgnoreCase("PERCENTAGE")||d.getType().equalsIgnoreCase("FIXED"))) throw new IllegalArgumentException("type must be PERCENTAGE or FIXED"); if(d.getValue()==null||d.getValue().compareTo(BigDecimal.ZERO)<=0) throw new IllegalArgumentException("value must be positive"); if(d.getType().equalsIgnoreCase("PERCENTAGE")&&d.getValue().compareTo(new BigDecimal("100"))>0) throw new IllegalArgumentException("percentage cannot exceed 100"); if(d.getMinimumAmount()!=null&&d.getMinimumAmount().compareTo(BigDecimal.ZERO)<0) throw new IllegalArgumentException("minimumAmount cannot be negative"); if(d.getStartDate()!=null&&d.getEndDate()!=null&&d.getEndDate().before(d.getStartDate())) throw new IllegalArgumentException("endDate must not precede startDate"); }
+ public List<Discount> findApplicable(MerchantStore s, BigDecimal subtotal, Date at){List<Discount> out=new ArrayList<Discount>(); Date now=at==null?new Date():at; for(Discount d:repository.findByMerchantStoreIdAndActiveTrue(s.getId())) if((d.getStartDate()==null||!now.before(d.getStartDate()))&&(d.getEndDate()==null||!now.after(d.getEndDate()))&&(subtotal==null||d.getMinimumAmount()==null||subtotal.compareTo(d.getMinimumAmount())>=0)) out.add(d); return out;}
+}
