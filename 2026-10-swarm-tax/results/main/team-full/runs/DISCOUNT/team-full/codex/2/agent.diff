+				com.salesmanager.core.model.catalog.category.Category c = pc;
+				while (c != null) {
+					if (c.getId() != null && c.getId().equals(target.getId())) return true;
+					c = c.getParent();
+				}
+			}
+		}
+		return false;
+	}
