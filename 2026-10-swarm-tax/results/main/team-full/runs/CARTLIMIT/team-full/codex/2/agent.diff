+package com.salesmanager.shop.store.api.v1.cart;
+
+import java.util.Optional;
+
+import javax.inject.Inject;
+
+import org.springframework.http.MediaType;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.cart.CartRules;
+import com.salesmanager.shop.model.cart.ProductLimits;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Administration endpoints for cart limits. */
+@RestController
+@RequestMapping(value = "/api/v1", produces = MediaType.APPLICATION_JSON_VALUE)
+public class CartRulesApi {
+  @Inject private ProductService productService;
+  @Inject private MerchantStoreService merchantStoreService;
+
+  @PutMapping("/private/product/{id}/limits")
+  public ProductLimits updateProductLimits(@PathVariable Long id, @RequestBody ProductLimits request,
+      @ApiIgnore MerchantStore store) {
+    if (request == null) throw new RestApiException("400", "Request body is required", new IllegalArgumentException("request"));
+    Product product = productService.retrieveById(id, store).orElseThrow(() ->
+        new ResourceNotFoundException("Product not found"));
+    validateProduct(request);
+    product.setMinPerCart(request.getMinPerCart());
+    product.setMaxPerCart(request.getMaxPerCart());
+    product.setPackSize(request.getPackSize());
+    try { productService.update(product); } catch (ServiceException e) { throw new RestApiException("500", e.getMessage(), e); }
+    return toLimits(product);
+  }
+
+  @GetMapping("/private/product/{id}/limits")
+  public ProductLimits getProductLimits(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+    Product product = productService.retrieveById(id, store).orElseThrow(() ->
+        new ResourceNotFoundException("Product not found"));
+    return toLimits(product);
+  }
+
+  @PutMapping("/private/cart-rules")
+  public CartRules updateCartRules(@RequestBody CartRules request, @ApiIgnore MerchantStore store) {
+    if (request == null) throw new RestApiException("400", "Request body is required", new IllegalArgumentException("request"));
+    validatePositive(request.getMaxLines(), "maxLines");
+    validatePositive(request.getMaxUnits(), "maxUnits");
+    store.setMaxLines(request.getMaxLines());
+    store.setMaxUnits(request.getMaxUnits());
+    try { merchantStoreService.update(store); } catch (ServiceException e) { throw new RestApiException("500", e.getMessage(), e); }
+    return request;
+  }
+
+  @GetMapping("/private/cart-rules")
+  public CartRules getCartRules(@ApiIgnore MerchantStore store) {
+    CartRules result = new CartRules();
+    result.setMaxLines(store.getMaxLines());
+    result.setMaxUnits(store.getMaxUnits());
+    return result;
+  }
+
+  private ProductLimits toLimits(Product p) {
+    ProductLimits result = new ProductLimits();
+    result.setMinPerCart(p.getMinPerCart()); result.setMaxPerCart(p.getMaxPerCart()); result.setPackSize(p.getPackSize());
+    return result;
+  }
+  private void validateProduct(ProductLimits r) {
+    validatePositive(r.getMinPerCart(), "minPerCart"); validatePositive(r.getMaxPerCart(), "maxPerCart"); validatePositive(r.getPackSize(), "packSize");
+    if (r.getMinPerCart() != null && r.getMaxPerCart() != null && r.getMinPerCart() > r.getMaxPerCart()) bad("minPerCart must be less than or equal to maxPerCart");
+    if (r.getMaxPerCart() != null && r.getPackSize() != null && r.getMaxPerCart() < r.getPackSize()) bad("maxPerCart must be greater than or equal to packSize");
+  }
+  private void validatePositive(Integer v, String name) { if (v != null && v < 1) bad(name + " must be at least 1"); }
+  private void bad(String message) { throw new RestApiException("400", message, new IllegalArgumentException(message)); }
+}
