+	/** Validate the complete proposed state before any existing entity is mutated. Reflection keeps this
+	 * module compatible with installations where the optional limit columns have not yet been migrated. */
+	private void validateCartLimits(ShoppingCart cart, MerchantStore store,
+			List<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> changes, boolean adding) {
+		java.util.Map<String,Integer> quantities = new java.util.HashMap<>();
+		if (cart.getLineItems() != null) for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : cart.getLineItems())
+			quantities.put(lineKey(i), i.getQuantity());
+		int oldLines = quantities.size(), oldUnits = quantities.values().stream().mapToInt(Integer::intValue).sum();
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : changes) {
+			if (i.getQuantity() == null || i.getQuantity() < 0) continue;
+			String key = lineKey(i);
+			if (i.getQuantity() == 0) quantities.remove(key);
+			else if (adding && quantities.containsKey(key)) quantities.put(key, quantities.get(key) + i.getQuantity());
+			else quantities.put(key, i.getQuantity());
+			if (i.getQuantity() > 0) validateProductLimit(i.getProduct(), quantities.get(key));
+		}
+		int lines = quantities.size(), units = quantities.values().stream().mapToInt(Integer::intValue).sum();
+		Integer maxLines = limit(store, "getMaxLines");
+		Integer maxUnits = limit(store, "getMaxUnits");
+		if (maxLines != null && maxLines > 0 && lines > maxLines && lines > oldLines)
+			limitError("MAX_LINES", "Cart cannot contain more than " + maxLines + " lines");
+		if (maxUnits != null && maxUnits > 0 && units > maxUnits && units > oldUnits)
+			limitError("MAX_UNITS", "Cart cannot contain more than " + maxUnits + " units");
+	}
+	private String lineKey(com.salesmanager.core.model.shoppingcart.ShoppingCartItem i) {
+		java.util.List<Long> attrs = new java.util.ArrayList<>();
+		if (i.getAttributes() != null) for (com.salesmanager.core.model.shoppingcart.ShoppingCartAttributeItem a : i.getAttributes()) attrs.add(a.getProductAttributeId());
+		java.util.Collections.sort(attrs);
+		return i.getSku() + "|" + attrs.toString();
+	}
+
+	private void validateProductLimit(Product product, int quantity) {
+		Integer min = limit(product, "getMinPerCart"), max = limit(product, "getMaxPerCart"), pack = limit(product, "getPackSize");
+		if (min != null && min > 0 && quantity < min) limitError("MIN_PER_CART", "Minimum quantity is " + min);
+		if (max != null && max > 0 && quantity > max) limitError("MAX_PER_CART", "Maximum quantity is " + max);
+		if (pack != null && pack > 1 && quantity % pack != 0) limitError("PACK_SIZE", "Quantity must be a multiple of " + pack);
+	}
+
+	private Integer limit(Object target, String getter) {
+		if (target == null) return null;
+		try { Object v = target.getClass().getMethod(getter).invoke(target); return v == null ? null : ((Number)v).intValue(); }
+		catch (Exception e) { return null; }
+	}
+	private void limitError(String code, String message) { throw new ServiceRuntimeException(code, message, new IllegalArgumentException(message)); }
+
 	private String uniqueShoppingCartCode() {
 		return UUID.randomUUID().toString().replaceAll("-", "");
 	}
