+package com.salesmanager.shop.store.api.v1.limits;
+
+import static org.springframework.http.MediaType.APPLICATION_JSON_VALUE;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductLimits;
+import com.salesmanager.shop.model.store.CartRules;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Administrative endpoints for configuring cart purchase limits. */
+@RestController
+@RequestMapping(value = "/api/v1")
+public class PurchaseLimitsApi {
+
+    @Inject
+    private ProductService productService;
+
+    @Inject
+    private MerchantStoreService merchantStoreService;
+
+    @GetMapping(value = "/private/product/{id}/limits", produces = APPLICATION_JSON_VALUE)
+    public ProductLimits getProductLimits(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        Product product = productService.findOne(id, store);
+        if (product == null) {
+            throw new ResourceNotFoundException("Product not found");
+        }
+        return toLimits(product);
+    }
+
+    @PutMapping(value = "/private/product/{id}/limits", consumes = APPLICATION_JSON_VALUE, produces = APPLICATION_JSON_VALUE)
+    @ResponseStatus(HttpStatus.OK)
+    public ProductLimits putProductLimits(@PathVariable Long id, @RequestBody ProductLimits limits,
+            @ApiIgnore MerchantStore store) {
+        Product product = productService.findOne(id, store);
+        if (product == null) {
+            throw new ResourceNotFoundException("Product not found");
+        }
+        validate(limits.getMinPerCart(), limits.getMaxPerCart(), limits.getPackSize());
+        product.setMinPerCart(limits.getMinPerCart());
+        product.setMaxPerCart(limits.getMaxPerCart());
+        product.setPackSize(limits.getPackSize());
+        try {
+            productService.update(product);
+        } catch (ServiceException e) {
+            throw new RestApiException("500", "Unable to save product limits", e);
+        }
+        return toLimits(product);
+    }
+
+    @GetMapping(value = "/private/cart-rules", produces = APPLICATION_JSON_VALUE)
+    public CartRules getCartRules(@ApiIgnore MerchantStore store) {
+        return toRules(store);
+    }
+
+    @PutMapping(value = "/private/cart-rules", consumes = APPLICATION_JSON_VALUE, produces = APPLICATION_JSON_VALUE)
+    @ResponseStatus(HttpStatus.OK)
+    public CartRules putCartRules(@RequestBody CartRules rules, @ApiIgnore MerchantStore store) {
+        validate(rules.getMaxLines(), rules.getMaxUnits());
+        store.setMaxLines(rules.getMaxLines());
+        store.setMaxUnits(rules.getMaxUnits());
+        try {
+            merchantStoreService.saveOrUpdate(store);
+        } catch (ServiceException e) {
+            throw new RestApiException("500", "Unable to save cart rules", e);
+        }
+        return toRules(store);
+    }
+
+    private ProductLimits toLimits(Product product) {
+        ProductLimits result = new ProductLimits();
+        result.setMinPerCart(product.getMinPerCart());
+        result.setMaxPerCart(product.getMaxPerCart());
+        result.setPackSize(product.getPackSize());
+        return result;
+    }
+
+    private CartRules toRules(MerchantStore store) {
+        CartRules result = new CartRules();
+        result.setMaxLines(store.getMaxLines());
+        result.setMaxUnits(store.getMaxUnits());
+        return result;
+    }
+
+    private void validate(Integer... values) {
+        for (Integer value : values) {
+            if (value != null && value < 1) {
+                throw bad("Limit values must be whole numbers greater than or equal to 1");
+            }
+        }
+        // Product form is the only form with three values; this also permits all-null clearing.
+        if (values.length == 3 && values[0] != null && values[1] != null && values[0] > values[1]) {
+            throw bad("minPerCart must be less than or equal to maxPerCart");
+        }
+        if (values.length == 3 && values[2] != null && values[1] != null && values[1] < values[2]) {
+            throw bad("maxPerCart must be greater than or equal to packSize");
+        }
+    }
+
+    private RestApiException bad(String message) {
+        return new RestApiException("400", message, new IllegalArgumentException(message));
+    }
+}
