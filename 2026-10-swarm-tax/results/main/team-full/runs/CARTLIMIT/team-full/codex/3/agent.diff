+@RestController
+@RequestMapping("/api/v1/private")
+public class CartRulesApi {
+  @Inject private PurchaseLimitService limits;
+  @Inject private MerchantStoreService stores;
+  @Inject private AuthorizationUtils authorization;
+  private void auth(MerchantStore store) { if (store == null) throw new NotFound(); String user = authorization.authenticatedUser(); if (user == null) throw new BadRequest("Authentication required"); authorization.authorizeUser(user, Stream.of(Constants.GROUP_SUPERADMIN, Constants.GROUP_ADMIN, Constants.GROUP_ADMIN_RETAIL).collect(java.util.stream.Collectors.toList()), store); }
+  @GetMapping("/cart-rules") public CartRules get(@ApiIgnore MerchantStore store) {
+    auth(store);
+    if (store == null) throw new NotFound();
+    return dto(store);
+  }
+  @PutMapping("/cart-rules") public CartRules put(@RequestBody CartRules in, @ApiIgnore MerchantStore store) {
+    auth(store);
+    try { return dto(limits.setCartRules(store, in.getMaxLines(), in.getMaxUnits())); }
+    catch (ServiceException e) { throw new BadRequest(e.getMessage()); }
+  }
+  private CartRules dto(MerchantStore s) { CartRules d = new CartRules(); d.setMaxLines(s.getMaxLines()); d.setMaxUnits(s.getMaxUnits()); return d; }
