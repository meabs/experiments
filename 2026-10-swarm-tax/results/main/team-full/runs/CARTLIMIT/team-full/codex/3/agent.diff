+package com.salesmanager.core.business.services.catalog.product;
+
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("purchaseLimitService")
+public class PurchaseLimitServiceImpl implements PurchaseLimitService {
+  @Inject private ProductService productService;
+  @Inject private com.salesmanager.core.business.services.merchant.MerchantStoreService merchantStoreService;
+
+  @Override public Product getProductLimits(Long id, MerchantStore store) {
+    return store == null ? null : productService.findOne(id, store);
+  }
+  @Override public Product setProductLimits(Long id, MerchantStore store, Integer min, Integer max, Integer pack) throws ServiceException {
+    validate(min, max, pack);
+    Product p = getProductLimits(id, store);
+    if (p == null) return null;
+    p.setMinPerCart(min); p.setMaxPerCart(max); p.setPackSize(pack);
+    productService.update(p);
+    return p;
+  }
+  @Override public MerchantStore getCartRules(MerchantStore store) { return store; }
+  @Override public MerchantStore setCartRules(MerchantStore store, Integer lines, Integer units) throws ServiceException {
+    if (lines != null && lines < 1 || units != null && units < 1) throw new ServiceException("Cart limits must be whole numbers >= 1");
+    if (store == null) return null;
+    store.setMaxLines(lines); store.setMaxUnits(units); merchantStoreService.update(store); return store;
+  }
+  private void validate(Integer min, Integer max, Integer pack) throws ServiceException {
+    if (min != null && min < 1 || max != null && max < 1 || pack != null && pack < 1) throw new ServiceException("Limits must be whole numbers >= 1");
+    if (min != null && max != null && min > max) throw new ServiceException("minPerCart must not exceed maxPerCart");
+    if (max != null && pack != null && max < pack) throw new ServiceException("maxPerCart must be at least packSize");
+  }
+}
