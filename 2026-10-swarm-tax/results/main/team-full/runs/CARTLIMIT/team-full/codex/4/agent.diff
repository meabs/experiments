+package com.salesmanager.shop.store.api.v1.product;
+
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductLimits;
+import com.salesmanager.shop.model.store.CartRules;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Administrative APIs for cart constraints. */
+@Controller
+@RequestMapping("/api/v1")
+public class CartLimitsApi {
+    @Inject private ProductService productService;
+    @Inject private MerchantStoreService merchantStoreService;
+
+    @GetMapping("/private/product/{id}/limits")
+    @ResponseBody
+    public ResponseEntity<ProductLimits> getProductLimits(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        Product p = productService.findOne(id, store);
+        if (p == null || p.getMerchantStore() == null || !store.getId().equals(p.getMerchantStore().getId()))
+            throw new ResourceNotFoundException("Product not found");
+        return ResponseEntity.ok(toLimits(p));
+    }
+
+    @PutMapping("/private/product/{id}/limits")
+    @ResponseBody
+    public ResponseEntity<ProductLimits> putProductLimits(@PathVariable Long id, @RequestBody ProductLimits body,
+            @ApiIgnore MerchantStore store) {
+        Product p = productService.findOne(id, store);
+        if (p == null || p.getMerchantStore() == null || !store.getId().equals(p.getMerchantStore().getId()))
+            throw new ResourceNotFoundException("Product not found");
+        if (body == null || !valid(body.getMinPerCart(), body.getMaxPerCart(), body.getPackSize())) return ResponseEntity.badRequest().build();
+        p.setMinPerCart(body.getMinPerCart()); p.setMaxPerCart(body.getMaxPerCart()); p.setPackSize(body.getPackSize());
+        try { productService.saveProduct(p); } catch (Exception e) { return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).build(); }
+        return ResponseEntity.ok(toLimits(p));
+    }
+
+    @GetMapping("/private/cart-rules")
+    @ResponseBody
+    public ResponseEntity<CartRules> getCartRules(@ApiIgnore MerchantStore store) { return ResponseEntity.ok(toRules(store)); }
+
+    @PutMapping("/private/cart-rules")
+    @ResponseBody
+    public ResponseEntity<CartRules> putCartRules(@RequestBody CartRules body, @ApiIgnore MerchantStore store) {
+        if (body == null || !valid(body.getMaxLines(), body.getMaxUnits())) return ResponseEntity.badRequest().build();
+        store.setCartMaxLines(body.getMaxLines()); store.setCartMaxUnits(body.getMaxUnits());
+        try { merchantStoreService.saveOrUpdate(store); } catch (Exception e) { return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).build(); }
+        return ResponseEntity.ok(toRules(store));
+    }
+    private boolean valid(Integer... values) {
+        for (Integer v : values) if (v != null && v < 1) return false;
+        Integer min = values.length > 0 ? values[0] : null;
+        Integer max = values.length > 1 ? values[1] : null;
+        Integer pack = values.length > 2 ? values[2] : null;
+        return (min == null || max == null || min <= max) && (max == null || pack == null || max >= pack);
+    }
+    private ProductLimits toLimits(Product p) { ProductLimits x = new ProductLimits(); x.setMinPerCart(p.getMinPerCart()); x.setMaxPerCart(p.getMaxPerCart()); x.setPackSize(p.getPackSize()); return x; }
+    private CartRules toRules(MerchantStore s) { CartRules x = new CartRules(); x.setMaxLines(s.getCartMaxLines()); x.setMaxUnits(s.getCartMaxUnits()); return x; }
+}
