+package com.salesmanager.shop.store.api.v1.cart;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.cart.PurchaseLimitService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.cart.CartRules;
+import com.salesmanager.shop.model.cart.PersistableProductLimits;
+import com.salesmanager.shop.model.cart.ReadableProductLimits;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private")
+public class CartRulesApi {
+    @Inject private PurchaseLimitService purchaseLimitService;
+
+    @PutMapping("/product/{id}/limits")
+    @ResponseStatus(HttpStatus.OK)
+    public ReadableProductLimits putProductLimits(@PathVariable Long id,
+            @RequestBody PersistableProductLimits request, @ApiIgnore MerchantStore store) {
+        validateProduct(request);
+        Product existing = purchaseLimitService.getProduct(id, store);
+        if (existing == null) throw new ResourceNotFoundException("Product not found");
+        try {
+            Product saved = purchaseLimitService.saveProductLimits(id, store, request.getMinPerCart(),
+                    request.getMaxPerCart(), request.getPackSize());
+            return new ReadableProductLimits(saved.getMinQuantity(), saved.getMaxQuantity(), saved.getPackSize());
+        } catch (ServiceException e) { throw new RestApiException(e); }
+    }
+
+    @GetMapping("/product/{id}/limits")
+    public ReadableProductLimits getProductLimits(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        Product product = purchaseLimitService.getProduct(id, store);
+        if (product == null) throw new ResourceNotFoundException("Product not found");
+        return new ReadableProductLimits(product.getMinQuantity(), product.getMaxQuantity(), product.getPackSize());
+    }
+
+    @PutMapping("/cart-rules")
+    @ResponseStatus(HttpStatus.OK)
+    public CartRules putCartRules(@RequestBody CartRules request, @ApiIgnore MerchantStore store) {
+        if (request == null) throw new RestApiException("400", "Request body is required");
+        if ((request.getMaxLines() != null && request.getMaxLines() < 1) || (request.getMaxUnits() != null && request.getMaxUnits() < 1))
+            throw new RestApiException("400", "cart limits must be whole numbers >= 1");
+        try { purchaseLimitService.saveCartRules(store, request.getMaxLines(), request.getMaxUnits()); }
+        catch (ServiceException e) { throw new RestApiException(e); }
+        return request;
+    }
+
+    @GetMapping("/cart-rules")
+    public CartRules getCartRules(@ApiIgnore MerchantStore store) {
+        try { Integer[] values = purchaseLimitService.getCartRules(store); CartRules result = new CartRules(); result.setMaxLines(values[0]); result.setMaxUnits(values[1]); return result; }
+        catch (ServiceException e) { throw new RestApiException(e); }
+    }
+
+    private void validateProduct(PersistableProductLimits request) {
+        if (request == null) throw new RestApiException("400", "Request body is required");
+        if (request.getMinPerCart() == null && request.getMaxPerCart() == null && request.getPackSize() == null) return;
+        if ((request.getMinPerCart() != null && request.getMinPerCart() < 1)
+                || (request.getMaxPerCart() != null && request.getMaxPerCart() < 1)
+                || (request.getPackSize() != null && request.getPackSize() < 1))
+            throw new RestApiException("400", "limits must be whole numbers >= 1");
+        if (request.getMinPerCart() != null && request.getMaxPerCart() != null
+                && request.getMinPerCart() > request.getMaxPerCart())
+            throw new RestApiException("400", "minPerCart must be <= maxPerCart");
+        if (request.getMaxPerCart() != null && request.getPackSize() != null
+                && request.getMaxPerCart() < request.getPackSize())
+            throw new RestApiException("400", "maxPerCart must be >= packSize");
+    }
+}
