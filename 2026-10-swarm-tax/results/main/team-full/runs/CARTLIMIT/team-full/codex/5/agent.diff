+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+/** Read/write access to purchase limits used by both administration and cart code. */
+public interface PurchaseLimitService {
+    Product getProduct(Long productId, MerchantStore store);
+    Product saveProductLimits(Long productId, MerchantStore store, Integer minQuantity,
+                              Integer maxQuantity, Integer packSize) throws ServiceException;
