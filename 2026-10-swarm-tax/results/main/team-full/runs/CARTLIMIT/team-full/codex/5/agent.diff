@@ -0,0 +1,87 @@
+package com.salesmanager.core.business.services.cart;
+
+import java.util.Optional;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.system.MerchantConfigurationService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.system.MerchantConfiguration;
+import com.salesmanager.core.model.system.MerchantConfigurationType;
+
+@Service("purchaseLimitService")
+public class PurchaseLimitServiceImpl implements PurchaseLimitService {
+    public static final String CART_RULES_KEY = "CART_PURCHASE_RULES";
+    private final ProductService productService;
+    private final MerchantConfigurationService configurationService;
+    private final ObjectMapper objectMapper = new ObjectMapper();
+
+    @Inject
+    public PurchaseLimitServiceImpl(ProductService productService,
+                                    MerchantConfigurationService configurationService) {
+        this.productService = productService;
+        this.configurationService = configurationService;
+    }
+
+    @Override
+    public Product getProduct(Long productId, MerchantStore store) {
+        if (productId == null || store == null) return null;
+        Optional<Product> product = productService.retrieveById(productId, store);
+        return product.orElse(null);
+    }
+
+    @Override
+    public Product saveProductLimits(Long productId, MerchantStore store, Integer minQuantity,
+                                     Integer maxQuantity, Integer packSize) throws ServiceException {
+        Product product = getProduct(productId, store);
+        if (product == null) return null;
+        product.setMinQuantity(minQuantity);
+        product.setMaxQuantity(maxQuantity);
+        product.setPackSize(packSize);
+        productService.update(product);
+        return product;
+    }
+
+    @Override
+    public Integer[] getCartRules(MerchantStore store) throws ServiceException {
+        MerchantConfiguration configuration = configurationService.getMerchantConfiguration(CART_RULES_KEY, store);
+        if (configuration == null || configuration.getValue() == null) return new Integer[] { null, null };
+        try {
+            CartRulesValue value = objectMapper.readValue(configuration.getValue(), CartRulesValue.class);
+            return new Integer[] { value.maxLines, value.maxUnits };
+        } catch (Exception e) {
+            throw new ServiceException("Cannot parse cart purchase rules", e);
+        }
+    }
+
+    @Override
+    public void saveCartRules(MerchantStore store, Integer maxLines, Integer maxUnits) throws ServiceException {
+        MerchantConfiguration configuration = configurationService.getMerchantConfiguration(CART_RULES_KEY, store);
+        if (configuration == null) {
+            configuration = new MerchantConfiguration();
+            configuration.setMerchantStore(store);
+            configuration.setKey(CART_RULES_KEY);
+            configuration.setMerchantConfigurationType(MerchantConfigurationType.CONFIG);
+        }
+        CartRulesValue value = new CartRulesValue();
+        value.maxLines = maxLines;
+        value.maxUnits = maxUnits;
+        try {
+            configuration.setValue(objectMapper.writeValueAsString(value));
+        } catch (Exception e) {
+            throw new ServiceException("Cannot serialize cart purchase rules", e);
+        }
+        configurationService.saveOrUpdate(configuration);
+    }
+
+    public static class CartRulesValue {
+        public Integer maxLines;
+        public Integer maxUnits;
+    }
+}
