+	private List<LimitWarning> limitWarnings(ShoppingCart cart, MerchantStore store) {
+		List<LimitWarning> warnings = new ArrayList<LimitWarning>();
+		Set<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> items = cart.getLineItems();
+		if (items == null) return warnings;
+		Integer maxLines = number(store, "getMaxLines");
+		Integer maxUnits = number(store, "getMaxUnits");
+		if (maxLines != null && items.size() > maxLines) warnings.add(new LimitWarning(null, "MAX_LINES"));
+		int units = 0; for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : items) units += i.getQuantity();
+		if (maxUnits != null && units > maxUnits) warnings.add(new LimitWarning(null, "MAX_UNITS"));
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : items) {
+			Object p = i.getProduct(); String sku = i.getSku();
+			Integer min = number(p, "getMinPerCart"), max = number(p, "getMaxPerCart"), pack = number(p, "getPackSize");
+			if (min != null && i.getQuantity() < min) warnings.add(new LimitWarning(sku, "MIN_PER_CART"));
+			if (max != null && i.getQuantity() > max) warnings.add(new LimitWarning(sku, "MAX_PER_CART"));
+			if (pack != null && pack > 1 && i.getQuantity() % pack != 0) warnings.add(new LimitWarning(sku, "PACK_SIZE"));
+		}
+		return warnings;
+	}
+
+	private Integer number(Object target, String method) {
+		if (target == null) return null;
+		try { Object value = target.getClass().getMethod(method).invoke(target); return value == null ? null : ((Number)value).intValue(); }
+		catch (Exception e) { return null; }
+	}
 	
 
 
diff --git a/sm-shop/src/main/java/com/salesmanager/shop/store/api/v1/cart/CartRulesApi.java b/sm-shop/src/main/java/com/salesmanager/shop/store/api/v1/cart/CartRulesApi.java
new file mode 100644
index 0000000..ce1cb5a
--- /dev/null
+++ b/sm-shop/src/main/java/com/salesmanager/shop/store/api/v1/cart/CartRulesApi.java
@@ -0,0 +1,138 @@
+package com.salesmanager.shop.store.api.v1.cart;
+
+import javax.inject.Inject;
+
+import org.springframework.http.MediaType;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.cart.CartRules;
+import com.salesmanager.shop.model.cart.ProductLimits;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import io.swagger.annotations.Api;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Administrative endpoints for cart limits. */
+@RestController
+@RequestMapping("/api/v1")
+@Api(tags = { "Cart rules" })
+public class CartRulesApi {
+
+    @Inject
+    private ProductService productService;
+
+    @Inject
+    private MerchantStoreService merchantStoreService;
+
+    @GetMapping(value = "/private/product/{id}/limits", produces = MediaType.APPLICATION_JSON_VALUE)
+    @ResponseBody
+    public ProductLimits getProductLimits(@PathVariable Long id, @ApiIgnore MerchantStore merchantStore) {
+        Product product = productService.findOne(id, merchantStore);
+        if (product == null) {
+            throw new ResourceNotFoundException("Product with id [" + id + "] not found for store");
+        }
+        return productLimits(product);
+    }
+
+    @PutMapping(value = "/private/product/{id}/limits", consumes = MediaType.APPLICATION_JSON_VALUE,
+            produces = MediaType.APPLICATION_JSON_VALUE)
+    @ResponseBody
+    public ProductLimits putProductLimits(@PathVariable Long id, @RequestBody ProductLimits limits,
+            @ApiIgnore MerchantStore merchantStore) {
+        validateProductLimits(limits);
+        Product product = productService.findOne(id, merchantStore);
+        if (product == null) {
+            throw new ResourceNotFoundException("Product with id [" + id + "] not found for store");
+        }
+        product.setMinPerCart(limits.getMinPerCart());
+        product.setMaxPerCart(limits.getMaxPerCart());
+        product.setPackSize(limits.getPackSize());
+        try {
+            productService.saveProduct(product);
+        } catch (ServiceException e) {
+            throw new RestApiException("Unable to save product limits", e);
+        }
+        return productLimits(product);
+    }
+
+    @GetMapping(value = "/private/cart-rules", produces = MediaType.APPLICATION_JSON_VALUE)
+    @ResponseBody
+    public CartRules getCartRules(@ApiIgnore MerchantStore merchantStore) {
+        return cartRules(merchantStore);
+    }
+
+    @PutMapping(value = "/private/cart-rules", consumes = MediaType.APPLICATION_JSON_VALUE,
+            produces = MediaType.APPLICATION_JSON_VALUE)
+    @ResponseBody
+    public CartRules putCartRules(@RequestBody CartRules rules, @ApiIgnore MerchantStore merchantStore) {
+        validateCartRules(rules);
+        merchantStore.setMaxLines(rules.getMaxLines());
+        merchantStore.setMaxUnits(rules.getMaxUnits());
+        try {
+            merchantStoreService.saveOrUpdate(merchantStore);
+        } catch (ServiceException e) {
+            throw new RestApiException("Unable to save cart rules", e);
+        }
+        return cartRules(merchantStore);
+    }
+
+    private ProductLimits productLimits(Product product) {
+        ProductLimits result = new ProductLimits();
+        result.setMinPerCart(product.getMinPerCart());
+        result.setMaxPerCart(product.getMaxPerCart());
+        result.setPackSize(product.getPackSize());
+        return result;
+    }
+
+    private CartRules cartRules(MerchantStore store) {
+        CartRules result = new CartRules();
+        result.setMaxLines(store.getMaxLines());
+        result.setMaxUnits(store.getMaxUnits());
+        return result;
+    }
+
+    private void validateProductLimits(ProductLimits limits) {
+        if (limits == null) throw bad("Request body is required");
+        if (positive(limits.getMinPerCart()) || positive(limits.getMaxPerCart()) || positive(limits.getPackSize())) {
+            throw bad("Cart limits must be whole numbers greater than or equal to 1");
+        }
+        if (limits.getMinPerCart() != null && limits.getMaxPerCart() != null
+                && limits.getMinPerCart() > limits.getMaxPerCart()) {
+            throw bad("minPerCart must be less than or equal to maxPerCart");
+        }
+        if (limits.getMaxPerCart() != null && limits.getPackSize() != null
+                && limits.getMaxPerCart() < limits.getPackSize()) {
+            throw bad("maxPerCart must be greater than or equal to packSize");
+        }
+        if (limits.getMaxPerCart() != null && limits.getPackSize() != null
+                && limits.getMaxPerCart() % limits.getPackSize() != 0) {
+            throw bad("maxPerCart must be divisible by packSize");
+        }
+        if (limits.getMinPerCart() != null && limits.getPackSize() != null
+                && limits.getMinPerCart() % limits.getPackSize() != 0) {
+            throw bad("minPerCart must be divisible by packSize");
+        }
+    }
+
+    private void validateCartRules(CartRules rules) {
+        if (rules == null) throw bad("Request body is required");
+        if (positive(rules.getMaxLines()) || positive(rules.getMaxUnits())) {
+            throw bad("Cart caps must be whole numbers greater than or equal to 1");
+        }
+    }
+
+    private boolean positive(Integer value) { return value != null && value < 1; }
+    private RestApiException bad(String message) { return new RestApiException("400", message); }
+}
