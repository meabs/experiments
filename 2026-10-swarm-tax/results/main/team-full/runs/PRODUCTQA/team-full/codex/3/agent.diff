+package com.salesmanager.core.business.services.catalog.product.question;
+
+import java.util.Date;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long, ProductQuestion> implements ProductQuestionService {
+    private static final int MAX_PENDING = 3;
+    private static final int MAX_TEXT = 2000;
+    private static final int MIN_QUESTION_TEXT = 10;
+    private final ProductQuestionRepository repository;
+    private final ProductService productService;
+
+    @Inject
+    public ProductQuestionServiceImpl(ProductQuestionRepository repository, ProductService productService) {
+        super(repository);
+        this.repository = repository;
+        this.productService = productService;
+    }
+
+    @Override
+    public ProductQuestion ask(String sku, MerchantStore store, Customer customer, String text) throws ServiceException {
+        if (store == null || customer == null) throw new IllegalArgumentException("store and customer are required");
+        if (sku == null || sku.trim().isEmpty()) throw new IllegalArgumentException("sku is required");
+        String clean = text == null ? null : text.trim();
+        if (clean == null || clean.length() < MIN_QUESTION_TEXT || clean.length() > MAX_TEXT) throw new IllegalArgumentException("question must be between " + MIN_QUESTION_TEXT + " and " + MAX_TEXT + " characters");
+        if (countPending(customer) >= MAX_PENDING) throw new IllegalStateException("customer may have at most 3 pending questions");
+        Product product;
+        try {
+            product = productService.getBySku(sku.trim(), store);
+        } catch (ServiceException e) {
+            throw new IllegalArgumentException("product sku was not found", e);
+        }
+        if (product == null) throw new IllegalArgumentException("product sku was not found");
+        ProductQuestion question = new ProductQuestion();
+        question.setProduct(product); question.setSku(sku.trim()); question.setMerchantStore(store); question.setCustomer(customer);
+        question.setText(clean); question.setStatus(ProductQuestionStatus.PENDING); question.setAskedAt(new Date());
+        return saveAndFlush(question);
+    }
+
+    @Override
+    public ProductQuestion answer(Long questionId, String answer) throws ServiceException {
+        return answer(questionId, answer, null);
+    }
+    @Override
+    public ProductQuestion answer(Long questionId, String answer, MerchantStore store) throws ServiceException {
+        ProductQuestion question = require(questionId, store);
+        if (question.getStatus() == ProductQuestionStatus.REJECTED) throw new IllegalStateException("rejected questions cannot be answered");
+        String clean = answer == null ? null : answer.trim();
+        if (clean == null || clean.isEmpty() || clean.length() > MAX_TEXT) throw new IllegalArgumentException("answer must be between 1 and " + MAX_TEXT + " characters");
+        question.setAnswer(clean); question.setAnsweredAt(new Date()); question.setStatus(ProductQuestionStatus.PUBLISHED);
+        return saveAndFlush(question);
+    }
+
+    @Override
+    public ProductQuestion reject(Long questionId) throws ServiceException {
+        return reject(questionId, null);
+    }
+    @Override
+    public ProductQuestion reject(Long questionId, MerchantStore store) throws ServiceException {
+        ProductQuestion question = require(questionId, store);
+        if (question.getStatus() != ProductQuestionStatus.PENDING) throw new IllegalStateException("only pending questions can be rejected");
+        question.setStatus(ProductQuestionStatus.REJECTED); question.setAnsweredAt(new Date());
+        return saveAndFlush(question);
+    }
+
+    private ProductQuestion require(Long id, MerchantStore store) {
+        if (id == null) throw new IllegalArgumentException("question id is required");
+        ProductQuestion q = repository.findById(id).orElse(null);
+        if (q == null) throw new IllegalArgumentException("question was not found");
+        if (store != null && (q.getMerchantStore() == null || q.getMerchantStore().getId() == null ||
+                !q.getMerchantStore().getId().equals(store.getId())))
+            throw new IllegalArgumentException("question was not found");
+        return q;
+    }
+    public List<ProductQuestion> getByCustomer(Customer customer) { return repository.findByCustomerIdOrderByAskedAtDescIdDesc(customer.getId()); }
+    public List<ProductQuestion> getByCustomer(Customer customer, ProductQuestionStatus status) { return repository.findByCustomerIdAndStatusOrderByAskedAtDescIdDesc(customer.getId(), status); }
+    public List<ProductQuestion> getByStore(MerchantStore store) { return repository.findByMerchantStoreIdOrderByAskedAtDescIdDesc(store.getId()); }
+    public List<ProductQuestion> getByStore(MerchantStore store, ProductQuestionStatus status) { return repository.findByMerchantStoreIdAndStatusOrderByAskedAtDescIdDesc(store.getId(), status); }
+    @Override
+    public List<ProductQuestion> list(MerchantStore store, ProductQuestionStatus status) {
+        if (store == null || status == null) throw new IllegalArgumentException("store and status are required");
+        return getByStore(store, status);
+    }
+    public List<ProductQuestion> getPublishedByProduct(String sku, MerchantStore store) throws ServiceException {
+        if (sku == null || sku.trim().isEmpty() || store == null) throw new IllegalArgumentException("sku and store are required");
+        Product p;
+        try {
+            p = productService.getBySku(sku.trim(), store);
+        } catch (ServiceException e) {
+            throw new IllegalArgumentException("product sku was not found", e);
+        }
+        if (p == null) throw new IllegalArgumentException("product sku was not found");
+        return repository.findByProductIdAndStatusOrderByAnsweredAtDescIdDesc(p.getId(), ProductQuestionStatus.PUBLISHED);
+    }
+    public long countPending(Customer customer) { return repository.countByCustomerIdAndStatus(customer.getId(), ProductQuestionStatus.PENDING); }
+}
