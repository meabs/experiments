+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Product questions.  Ordering is intentionally left to ProductQuestionService. */
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+    @Inject private ProductQuestionService questionService;
+    @Inject private CustomerService customerService;
+    @Inject private ProductService productService;
+
+    @PostMapping("/auth/products/{sku}/questions")
+    @ResponseStatus(HttpStatus.CREATED)
+    public QuestionView ask(@PathVariable String sku, @RequestBody QuestionRequest request,
+            @ApiIgnore MerchantStore store, HttpServletRequest servletRequest) {
+        Customer customer = customer(servletRequest, store);
+        if (request == null || blank(request.value())) throw new RestApiException("400", "question text is required");
+        try { return QuestionView.full(questionService.ask(sku == null ? null : sku.trim(), store, customer, request.value())); }
+        catch (IllegalArgumentException e) {
+            if (e.getMessage() != null && e.getMessage().toLowerCase().contains("sku"))
+                throw new ResourceNotFoundException(e.getMessage());
+            throw new RestApiException("400", e.getMessage());
+        }
+        catch (IllegalStateException e) { throw new RestApiException("400", e.getMessage()); }
+        catch (Exception e) {
+            if (e.getMessage() != null && e.getMessage().toLowerCase().contains("sku"))
+                throw new ResourceNotFoundException(e.getMessage());
+            throw new RestApiException("Unable to save question", e);
+        }
+    }
+
+    @GetMapping("/auth/customer/questions")
+    public List<QuestionView> mine(@RequestParam(required = false) String status,
+            @ApiIgnore MerchantStore store, HttpServletRequest request) {
+        Customer customer = customer(request, store);
+        ProductQuestionStatus state = parseStatus(status);
+        List<ProductQuestion> questions = state == null ? questionService.getByCustomer(customer)
+                : questionService.getByCustomer(customer, state);
+        return full(questions);
+    }
+
+    @GetMapping("/products/{sku}/questions")
+    public QuestionCollection published(@PathVariable String sku, @ApiIgnore MerchantStore store) {
+        try {
+            String cleanSku = sku == null ? null : sku.trim();
+            Product product = productService.getBySku(cleanSku, store);
+            if (product == null) throw new ResourceNotFoundException("product sku was not found");
+            List<ProductQuestion> questions = questionService.getPublishedByProduct(cleanSku, store);
+            List<PublicQuestionView> items = new ArrayList<>();
+            for (ProductQuestion q : questions) items.add(PublicQuestionView.of(q));
+            return new QuestionCollection(items.size(), items);
+        } catch (ResourceNotFoundException e) { throw e;
+        } catch (IllegalArgumentException e) { throw new ResourceNotFoundException(e.getMessage()); }
+        catch (Exception e) { throw new RestApiException("Unable to read questions", e); }
+    }
+
+    @GetMapping("/private/questions")
+    public List<QuestionView> admin(@RequestParam(required = false) String status,
+            @ApiIgnore MerchantStore store) {
+        ProductQuestionStatus state = blank(status) ? ProductQuestionStatus.PENDING : parseStatus(status);
+        // The service API is customer-oriented; an unfiltered admin listing is supplied by
+        // findAll on the generic entity service.  Keep filtering in this layer.
+        List<ProductQuestion> source = questionService.getByStore(store, state);
+        List<QuestionView> result = new ArrayList<>();
+        for (ProductQuestion q : source) {
+            boolean sameStore = store == null || q.getMerchantStore() == null ||
+                    (q.getMerchantStore().getCode() != null && q.getMerchantStore().getCode().equals(store.getCode()));
+            if (sameStore && q.getStatus() == state) result.add(QuestionView.full(q));
+        }
+        result.sort(Comparator.comparing(QuestionView::getAskedAt, Comparator.nullsLast(Comparator.naturalOrder()))
+                .thenComparing(QuestionView::getId, Comparator.nullsLast(Comparator.naturalOrder())));
+        return result;
+    }
+
+    @PutMapping("/private/questions/{id}/answer")
+    public QuestionView answer(@PathVariable Long id, @RequestBody AnswerRequest request, @ApiIgnore MerchantStore store) {
+        if (request == null || blank(request.getAnswer())) throw new RestApiException("400", "answer is required");
+        try { return QuestionView.full(questionService.answer(id, request.getAnswer(), store)); }
+        catch (IllegalArgumentException e) {
+            if (e.getMessage() != null && (e.getMessage().contains("not found") || e.getMessage().contains("id is required"))) throw new ResourceNotFoundException(e.getMessage());
+            throw new RestApiException("400", e.getMessage());
+        }
+        catch (IllegalStateException e) { throw new RestApiException("409", e.getMessage()); }
+        catch (Exception e) { throw new RestApiException("Unable to answer question", e); }
+    }
+
+    @PutMapping("/private/questions/{id}/reject")
+    public QuestionView reject(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        try { return QuestionView.full(questionService.reject(id, store)); }
+        catch (IllegalArgumentException e) { throw new ResourceNotFoundException(e.getMessage()); }
+        catch (IllegalStateException e) { throw new RestApiException("409", e.getMessage()); }
+        catch (Exception e) { throw new RestApiException("Unable to reject question", e); }
+    }
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal p = request == null ? null : request.getUserPrincipal();
+        if (p == null) throw new RestApiException("401", "authentication required");
+        Customer c = customerService.getByNick(p.getName(), store == null ? "DEFAULT" : store.getCode());
+        if (c == null) throw new ResourceNotFoundException("customer was not found");
+        return c;
+    }
+    private static boolean blank(String s) { return s == null || s.trim().isEmpty(); }
+    private static ProductQuestionStatus parseStatus(String value) {
+        if (blank(value)) return null;
+        try { return ProductQuestionStatus.valueOf(value.trim().toUpperCase()); }
+        catch (Exception e) { throw new RestApiException("400", "invalid question status"); }
+    }
+    private static List<QuestionView> full(List<ProductQuestion> source) {
+        if (source == null) return Collections.emptyList();
+        List<QuestionView> result = new ArrayList<>(); for (ProductQuestion q : source) result.add(QuestionView.full(q)); return result;
+    }
+
+    public static class QuestionRequest { private String text; public String getText(){return text;} public void setText(String text){this.text=text;} String value(){return text;} }
+    public static class AnswerRequest { private String answer; public String getAnswer(){return answer;} public void setAnswer(String answer){this.answer=answer;} }
+    public static class QuestionCollection { private final int count; private final List<PublicQuestionView> items; public QuestionCollection(int count,List<PublicQuestionView> items){this.count=count;this.items=items;} public int getCount(){return count;} public List<PublicQuestionView> getItems(){return items;} }
+    public static class PublicQuestionView { private Long id; private String text; private String answer; private String askedBy; private Date answeredAt; static PublicQuestionView of(ProductQuestion q){PublicQuestionView v=new PublicQuestionView();v.id=q.getId();v.text=q.getText();v.answer=q.getAnswer();v.askedBy=q.getCustomer()!=null&&q.getCustomer().getBilling()!=null?q.getCustomer().getBilling().getFirstName():null;v.answeredAt=q.getAnsweredAt();return v;} public Long getId(){return id;} public String getText(){return text;} public String getAnswer(){return answer;} public String getAskedBy(){return askedBy;} public Date getAnsweredAt(){return answeredAt;} }
+    public static class QuestionView {
+        private Long id; private String sku; private String text; private String answer; private String status; private Date askedAt; private Date answeredAt; private String askedBy;
