+package com.salesmanager.core.model.catalog.product.question;
+
+import java.util.Date;
+import javax.persistence.*;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.common.audit.*;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.generic.SalesManagerEntity;
+
+@Entity
+@EntityListeners(AuditListener.class)
+@Table(name = "PRODUCT_QUESTION")
+public class ProductQuestion extends SalesManagerEntity<Long, ProductQuestion> implements Auditable {
+    private static final long serialVersionUID = 1L;
+    @Id @Column(name = "PRODUCT_QUESTION_ID", nullable = false, unique = true)
+    @TableGenerator(name = "TABLE_GEN", table = "SM_SEQUENCER", pkColumnName = "SEQ_NAME", valueColumnName = "SEQ_COUNT", pkColumnValue = "PRODUCT_QUESTION_SEQ_NEXT_VAL")
+    @GeneratedValue(strategy = GenerationType.TABLE, generator = "TABLE_GEN") private Long id;
+    @Embedded private AuditSection audit = new AuditSection();
+    @ManyToOne @JoinColumn(name = "PRODUCT_ID", nullable = false) private Product product;
+    @ManyToOne @JoinColumn(name = "CUSTOMERS_ID", nullable = false) private Customer customer;
+    @Column(name = "QUESTION", nullable = false, length = 4000) private String question;
+    @Column(name = "ANSWER", length = 4000) private String answer;
+    @Enumerated(EnumType.STRING) @Column(name = "STATUS", nullable = false, length = 20)
+    private ProductQuestionStatus status = ProductQuestionStatus.PENDING;
+    @Temporal(TemporalType.TIMESTAMP) @Column(name = "ANSWERED_AT") private Date answeredAt;
+    public Long getId() { return id; } public void setId(Long id) { this.id = id; }
+    public Product getProduct() { return product; } public void setProduct(Product product) { this.product = product; }
+    public Customer getCustomer() { return customer; } public void setCustomer(Customer customer) { this.customer = customer; }
+    public String getQuestion() { return question; } public void setQuestion(String question) { this.question = question; }
+    public String getQuestionText() { return question; } public void setQuestionText(String text) { this.question = text; }
+    public String getText() { return question; } public void setText(String text) { this.question = text; }
+    public String getAnswer() { return answer; } public void setAnswer(String answer) { this.answer = answer; }
+    public ProductQuestionStatus getStatus() { return status; } public void setStatus(ProductQuestionStatus status) { this.status = status; }
+    public Date getCreatedAt() { return audit.getDateCreated(); } public Date getUpdatedAt() { return audit.getDateModified(); }
+    public Date getAnsweredAt() { return answeredAt; } public void setAnsweredAt(Date answeredAt) { this.answeredAt = answeredAt; }
+    public Date getDateCreated() { return audit.getDateCreated(); } public Date getDateModified() { return audit.getDateModified(); }
+    @Override public AuditSection getAuditSection() { return audit; }
+    @Override public void setAuditSection(AuditSection audit) { this.audit = audit; }
+}
