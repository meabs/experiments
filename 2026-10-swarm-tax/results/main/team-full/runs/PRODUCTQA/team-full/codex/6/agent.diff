+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.ArrayList;
+import java.util.List;
+import javax.inject.Inject;
+import javax.validation.Valid;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.catalog.product.ProductQuestionAnswerRequest;
+import com.salesmanager.shop.model.catalog.product.ProductQuestionRequest;
+import com.salesmanager.shop.model.catalog.product.PublicProductQuestion;
+import com.salesmanager.shop.model.catalog.product.ProductQuestionList;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestion;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.api.exception.OperationNotAllowedException;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Customer, public and moderation endpoints for product questions. */
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+    @Inject private ProductQuestionService questionService;
+    @Inject private ProductService productService;
+    @Inject private CustomerFacade customerFacade;
+
+    @PostMapping("/auth/products/{sku}/questions")
+    @ResponseStatus(HttpStatus.CREATED)
+    public ReadableProductQuestion ask(@PathVariable String sku,
+            @Valid @RequestBody ProductQuestionRequest request,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language, Principal principal) {
+        Product product = product(sku, store, language);
+        Customer customer = customer(principal, store);
+        long pending = questionService.getByCustomer(customer, store).stream().filter(q -> q.getStatus() == ProductQuestionStatus.PENDING).count();
+        if (pending >= 3) {
+            throw new OperationNotAllowedException("A maximum of 3 pending questions is allowed");
+        }
+        ProductQuestion question = new ProductQuestion();
+        question.setProduct(product); question.setCustomer(customer);
+        question.setQuestion(trim(request.getQuestion())); question.setStatus(ProductQuestionStatus.PENDING);
+        try { questionService.create(question); } catch (Exception e) { throw new RestApiException("Unable to create question", e); }
+        return populate(question);
+    }
+
+    @GetMapping("/auth/customer/questions")
+    public List<ReadableProductQuestion> customerQuestions(Principal principal, @ApiIgnore MerchantStore store) {
+        Customer customer = customer(principal, store);
+        List<ReadableProductQuestion> result = new ArrayList<ReadableProductQuestion>();
+        for (ProductQuestion q : questionService.getByCustomer(customer, store)) result.add(populate(q));
+        return result;
+    }
+
+    @GetMapping("/products/{sku}/questions")
+    public ProductQuestionList published(@PathVariable String sku,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language) {
+        Product product = product(sku, store, language);
+        List<PublicProductQuestion> result = new ArrayList<PublicProductQuestion>();
+        for (ProductQuestion q : questionService.getPublishedByProduct(product.getId())) result.add(populatePublic(q));
+        return new ProductQuestionList(result.size(), result);
+    }
+
+    @GetMapping("/private/questions")
+    public List<ReadableProductQuestion> moderate(@RequestParam(required = false) String status,
+            @ApiIgnore MerchantStore store) {
+        ProductQuestionStatus parsed = parseStatus(status);
+        List<ReadableProductQuestion> result = new ArrayList<ReadableProductQuestion>();
+        for (ProductQuestion q : questionService.getByStoreAndStatus(store.getId(), parsed)) result.add(populate(q));
+        return result;
+    }
+
+    @PutMapping("/private/questions/{id}/answer")
+    public ReadableProductQuestion answer(@PathVariable Long id,
+            @Valid @RequestBody ProductQuestionAnswerRequest request, @ApiIgnore MerchantStore store) {
+        ProductQuestion q = find(id, store);
+        if (q.getStatus() == ProductQuestionStatus.REJECTED) throw new RestApiException("409", "Question is rejected");
+        q.setAnswer(trim(request.getAnswer())); q.setStatus(ProductQuestionStatus.PUBLISHED); q.setAnsweredAt(new java.util.Date());
+        save(q); return populate(q);
+    }
+
+    @PutMapping("/private/questions/{id}/reject")
+    public ReadableProductQuestion reject(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        ProductQuestion q = find(id, store);
+        if (q.getStatus() != ProductQuestionStatus.PENDING) throw new RestApiException("409", "Question is no longer pending");
+        q.setStatus(ProductQuestionStatus.REJECTED); save(q); return populate(q);
+    }
+
+    private Product product(String sku, MerchantStore store, Language language) {
+        try { Product p = productService.getBySku(sku, store, language); if (p == null) throw new ResourceNotFoundException("Product [" + sku + "] not found"); return p; }
+        catch (ResourceNotFoundException e) { throw e; } catch (Exception e) { throw new ResourceNotFoundException("Product [" + sku + "] not found"); }
+    }
+    private Customer customer(Principal principal, MerchantStore store) {
+        if (principal == null) throw new RestApiException("401", "Authentication is required");
+        Customer c = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (c == null) throw new ResourceNotFoundException("Customer not found"); return c;
+    }
+    private ProductQuestion find(Long id, MerchantStore store) {
+        ProductQuestion q = questionService.getByIdAndStore(id, store.getId());
+        if (q == null) throw new ResourceNotFoundException("Question [" + id + "] not found"); return q;
+    }
+    private void save(ProductQuestion q) { try { questionService.update(q); } catch (Exception e) { throw new RestApiException("Unable to update question", e); } }
+    private ProductQuestionStatus parseStatus(String value) {
+        if (value == null || value.trim().isEmpty()) return ProductQuestionStatus.PENDING;
+        try { return ProductQuestionStatus.valueOf(value.trim().toUpperCase()); }
+        catch (IllegalArgumentException e) { throw new RestApiException("400", "Invalid question status"); }
+    }
+    private String trim(String value) { return value == null ? null : value.trim(); }
+    private ReadableProductQuestion populate(ProductQuestion q) {
+        ReadableProductQuestion r = new ReadableProductQuestion(); r.setId(q.getId()); r.setText(q.getQuestion()); r.setAnswer(q.getAnswer());
+        r.setStatus(q.getStatus() == null ? null : q.getStatus().name()); r.setAskedAt(q.getCreatedAt()); r.setAnsweredAt(q.getAnsweredAt());
+        if (q.getProduct() != null) r.setSku(q.getProduct().getSku());
+        if (q.getCustomer() != null) r.setAskedBy(q.getCustomer().getBilling() == null ? q.getCustomer().getNick() : q.getCustomer().getBilling().getFirstName());
+        return r;
+    }
+    private PublicProductQuestion populatePublic(ProductQuestion q) {
