+package com.salesmanager.core.business.repositories.catalog.product.question;
+
+import java.util.List;
+import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Query;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+
+public interface ProductQuestionRepository extends JpaRepository<ProductQuestion, Long> {
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch p.merchantStore s join fetch q.customer c where c.id = ?1 and s.id = ?2 order by q.audit.dateCreated desc")
+    List<ProductQuestion> findByCustomer(Long customerId, Integer storeId);
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch p.merchantStore s join fetch q.customer c where s.id = ?1 and q.status = ?2 order by q.audit.dateCreated asc")
+    List<ProductQuestion> findByStoreAndStatus(Integer storeId, ProductQuestionStatus status);
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch p.merchantStore s join fetch q.customer c where p.id = ?1 and q.status = ?2 and q.answer is not null order by q.audit.dateCreated desc")
+    List<ProductQuestion> findPublishedByProduct(Long productId, ProductQuestionStatus status);
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch p.merchantStore s join fetch q.customer c where q.id = ?1 and s.id = ?2")
+    ProductQuestion findByIdAndStore(Long id, Integer storeId);
+    @Query("select count(q) from ProductQuestion q where q.product.merchantStore.id = ?1 and q.status = ?2")
+    long countByStoreAndStatus(Integer storeId, ProductQuestionStatus status);
+}
