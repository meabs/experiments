+package com.salesmanager.core.business.services.catalog.product.question;
+
+import java.util.List;
+import javax.inject.Inject;
+import org.apache.commons.lang3.Validate;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long, ProductQuestion> implements ProductQuestionService {
+    private final ProductQuestionRepository repository;
+    @Inject public ProductQuestionServiceImpl(ProductQuestionRepository repository) { super(repository); this.repository = repository; }
+    @Override public void create(ProductQuestion question) throws ServiceException { validate(question); if (question.getStatus() == null) question.setStatus(ProductQuestionStatus.PENDING); super.create(question); }
+    @Override public void update(ProductQuestion question) throws ServiceException { validate(question); super.update(question); }
+    private void validate(ProductQuestion q) { Validate.notNull(q, "ProductQuestion cannot be null"); Validate.notNull(q.getProduct(), "ProductQuestion.product cannot be null"); Validate.notNull(q.getCustomer(), "ProductQuestion.customer cannot be null"); Validate.notBlank(q.getQuestion(), "ProductQuestion.question cannot be blank"); }
+    public List<ProductQuestion> getByCustomer(Long id, Integer storeId) { return repository.findByCustomer(id, storeId); }
+    public List<ProductQuestion> getByStoreAndStatus(Integer id, ProductQuestionStatus status) { return repository.findByStoreAndStatus(id, status); }
+    public List<ProductQuestion> getPublishedByProduct(Long id) { return repository.findPublishedByProduct(id, ProductQuestionStatus.PUBLISHED); }
+    public ProductQuestion getByIdAndStore(Long id, Integer storeId) { return repository.findByIdAndStore(id, storeId); }
+    public long countByStoreAndStatus(Integer id, ProductQuestionStatus status) { return repository.countByStoreAndStatus(id, status); }
+}
