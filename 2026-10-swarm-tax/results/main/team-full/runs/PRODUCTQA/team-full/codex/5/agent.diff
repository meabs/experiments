+package com.salesmanager.core.business.services.catalog.product.question;
+
+import java.util.List;
+import java.util.Date;
+import java.util.Comparator;
+import javax.inject.Inject;
+import org.apache.commons.lang3.Validate;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long, ProductQuestion>
+        implements ProductQuestionService {
+    private final ProductQuestionRepository repository;
+
+    @Inject
+    public ProductQuestionServiceImpl(ProductQuestionRepository repository) {
+        super(repository);
+        this.repository = repository;
+    }
+
+    @Override public List<ProductQuestion> getByCustomer(Customer customer) {
+        Validate.notNull(customer, "Customer cannot be null");
+        return repository.findByCustomerIdOrderByCreatedDateDesc(customer.getId());
+    }
+    @Override public List<ProductQuestion> getByCustomer(Customer customer, ProductQuestionStatus status) {
+        Validate.notNull(customer, "Customer cannot be null"); Validate.notNull(status, "Status cannot be null");
+        return repository.findByCustomerIdAndStatusOrderByCreatedDateDesc(customer.getId(), status);
+    }
+    @Override public List<ProductQuestion> getByProduct(Product product) {
+        Validate.notNull(product, "Product cannot be null");
+        return repository.findByProductIdOrderByCreatedDateDesc(product.getId());
+    }
+    @Override public List<ProductQuestion> getByProduct(Product product, ProductQuestionStatus status) {
+        Validate.notNull(product, "Product cannot be null");
+        Validate.notNull(status, "Status cannot be null");
+        return repository.findByProductIdAndStatusOrderByCreatedDateDesc(product.getId(), status);
+    }
+    @Override public List<ProductQuestion> getByStore(MerchantStore store) {
+        Validate.notNull(store, "MerchantStore cannot be null");
+        List<ProductQuestion> result = repository.findByMerchantStoreIdOrderByCreatedDateDesc(store.getId());
+        result.sort(Comparator.comparing(ProductQuestion::getAskedAt, Comparator.nullsLast(Comparator.naturalOrder())));
+        return result;
+    }
+    @Override public List<ProductQuestion> getByStore(MerchantStore store, ProductQuestionStatus status) {
+        Validate.notNull(store, "MerchantStore cannot be null");
+        Validate.notNull(status, "Status cannot be null");
+        List<ProductQuestion> result = repository.findByMerchantStoreIdAndStatusOrderByCreatedDateDesc(store.getId(), status);
+        result.sort(Comparator.comparing(ProductQuestion::getAskedAt, Comparator.nullsLast(Comparator.naturalOrder())));
+        return result;
+    }
+    @Override public List<ProductQuestion> getByStatus(ProductQuestionStatus status) {
+        Validate.notNull(status, "Status cannot be null");
+        return repository.findByStatusOrderByCreatedDateDesc(status);
+    }
+    @Override public List<ProductQuestion> getPublicByProduct(Product product) {
+        List<ProductQuestion> result = getByProduct(product, ProductQuestionStatus.PUBLISHED);
+        result.sort(Comparator.comparing(ProductQuestion::getAnsweredAt,
+                Comparator.nullsLast(Comparator.reverseOrder())));
+        return result;
+    }
+
+    @Override public void create(ProductQuestion question) throws ServiceException { saveOrUpdate(question); }
+    @Override public void update(ProductQuestion question) throws ServiceException { saveOrUpdate(question); }
+    private void saveOrUpdate(ProductQuestion question) throws ServiceException {
+        Validate.notNull(question, "ProductQuestion cannot be null");
+        Validate.notNull(question.getProduct(), "ProductQuestion.product cannot be null");
+        Validate.notNull(question.getMerchantStore(), "ProductQuestion.merchantStore cannot be null");
+        Validate.notBlank(question.getQuestion(), "ProductQuestion.question cannot be empty");
+        question.setQuestion(question.getQuestion().trim());
+        Validate.isTrue(question.getQuestion().length() >= 10 && question.getQuestion().length() <= 500,
+                "ProductQuestion.question must be between 10 and 500 characters");
+        if (question.getAnswer() != null) {
+            question.setAnswer(question.getAnswer().trim());
+            Validate.isTrue(question.getAnswer().length() >= 1 && question.getAnswer().length() <= 2000,
+                    "ProductQuestion.answer must be between 1 and 2000 characters");
+        }
+        if (question.getSku() == null) question.setSku(question.getProduct().getSku());
+        if (question.getStatus() == null) question.setStatus(ProductQuestionStatus.PENDING);
+        if (question.getCreatedDate() == null) question.setCreatedDate(new Date());
+        if (question.getAskedAt() == null) question.setAskedAt(question.getCreatedDate());
+        question.setUpdatedDate(new Date());
+        if (question.getStatus() == ProductQuestionStatus.PUBLISHED && question.getAnsweredAt() == null)
+            question.setAnsweredAt(new Date());
+        if (question.getStatus() == ProductQuestionStatus.REJECTED) question.setAnsweredAt(null);
+        super.save(question);
+    }
+}
