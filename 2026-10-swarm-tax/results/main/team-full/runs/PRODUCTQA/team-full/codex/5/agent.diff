+/** A customer question (and optional merchant answer) for a product. */
+@Entity
+@Table(name = "PRODUCT_QUESTION")
+public class ProductQuestion extends SalesManagerEntity<Long, ProductQuestion> {
+    private static final long serialVersionUID = 1L;
+
+    @Id
+    @Column(name = "PRODUCT_QUESTION_ID", nullable = false, unique = true)
+    @TableGenerator(name = "TABLE_GEN", table = "SM_SEQUENCER", pkColumnName = "SEQ_NAME",
+            valueColumnName = "SEQ_COUNT", pkColumnValue = "PRODUCT_QUESTION_SEQ_NEXT_VAL")
+    @GeneratedValue(strategy = GenerationType.TABLE, generator = "TABLE_GEN")
+    private Long id;
+
+    @JsonIgnore
+    @ManyToOne
+    @JoinColumn(name = "PRODUCT_ID", nullable = false)
+    private Product product;
+
+    @ManyToOne
+    @JoinColumn(name = "MERCHANT_ID", nullable = false)
+    private MerchantStore merchantStore;
+
+    @JsonIgnore
+    @ManyToOne
+    @JoinColumn(name = "CUSTOMER_ID")
+    private Customer customer;
+
+    @Column(name = "SKU", nullable = false)
+    private String sku;
+
+    @Column(name = "QUESTION", nullable = false, length = 500)
+    private String question;
+
+    @Column(name = "ANSWER", length = 2000)
+    private String answer;
+
+    @Enumerated(EnumType.STRING)
+    @Column(name = "STATUS", nullable = false)
+    private ProductQuestionStatus status = ProductQuestionStatus.PENDING;
+
+    @Temporal(TemporalType.TIMESTAMP)
+    @Column(name = "CREATED_DATE", nullable = false)
+    private Date createdDate = new Date();
+
+    @Temporal(TemporalType.TIMESTAMP)
+    @Column(name = "UPDATED_DATE")
+    private Date updatedDate;
+
+    @Temporal(TemporalType.TIMESTAMP)
+    @Column(name = "ASKED_AT", nullable = false)
+    private Date askedAt = new Date();
+
+    @Temporal(TemporalType.TIMESTAMP)
+    @Column(name = "ANSWERED_AT")
+    private Date answeredAt;
+
+    public Long getId() { return id; }
+    public void setId(Long id) { this.id = id; }
+    public Product getProduct() { return product; }
+    public void setProduct(Product product) { this.product = product; }
+    public MerchantStore getMerchantStore() { return merchantStore; }
+    public void setMerchantStore(MerchantStore merchantStore) { this.merchantStore = merchantStore; }
+    public Customer getCustomer() { return customer; }
+    public void setCustomer(Customer customer) { this.customer = customer; }
+    public String getSku() { return sku; }
+    public void setSku(String sku) { this.sku = sku; }
+    public String getQuestion() { return question; }
+    public void setQuestion(String question) { this.question = question; }
+    public String getAnswer() { return answer; }
+    public void setAnswer(String answer) { this.answer = answer; }
+    public ProductQuestionStatus getStatus() { return status; }
+    public void setStatus(ProductQuestionStatus status) { this.status = status; }
+    public Date getCreatedDate() { return createdDate; }
+    public void setCreatedDate(Date createdDate) { this.createdDate = createdDate; }
+    public Date getUpdatedDate() { return updatedDate; }
+    public void setUpdatedDate(Date updatedDate) { this.updatedDate = updatedDate; }
+    public Date getAskedAt() { return askedAt; }
+    public void setAskedAt(Date askedAt) { this.askedAt = askedAt; }
+    public Date getAnsweredAt() { return answeredAt; }
+    public void setAnsweredAt(Date answeredAt) { this.answeredAt = answeredAt; }
+}
