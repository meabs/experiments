+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import java.util.Date;
+
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.ConflictException;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.api.exception.UnauthorizedException;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** REST resources for customer product questions and merchant moderation. */
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+    @Inject private ProductQuestionService questionService;
+    @Inject private ProductService productService;
+    @Inject private CustomerService customerService;
+
+    @PostMapping("/auth/products/{sku}/questions")
+    @ResponseStatus(HttpStatus.CREATED)
+    public Map<String, Object> create(@PathVariable String sku, @RequestBody QuestionRequest body,
+            @ApiIgnore MerchantStore store, HttpServletRequest request) throws Exception {
+        String text = validText(body == null ? null : body.text);
+        Product product = product(sku, store);
+        Principal principal = request.getUserPrincipal();
+        if (principal == null) throw new UnauthorizedException();
+        Customer customer = customerService.getByNick(principal.getName(), store.getId());
+        if (customer == null) throw new ResourceNotFoundException("Customer not found");
+        if (questionService.getByCustomer(customer, ProductQuestionStatus.PENDING).size() >= 3)
+            throw new RestApiException("400", "A customer may have at most 3 pending questions");
+        ProductQuestion q = new ProductQuestion();
+        q.setProduct(product); q.setMerchantStore(store); q.setCustomer(customer);
+        q.setSku(product.getSku()); q.setQuestion(text); q.setStatus(ProductQuestionStatus.PENDING);
+        questionService.create(q);
+        return representation(q);
+    }
+
+    @GetMapping("/auth/customer/questions")
+    public List<Map<String, Object>> mine(@ApiIgnore MerchantStore store, HttpServletRequest request) {
+        Principal p = request.getUserPrincipal();
+        if (p == null) throw new UnauthorizedException();
+        Customer c = customerService.getByNick(p.getName(), store.getId());
+        if (c == null) throw new ResourceNotFoundException("Customer not found");
+        return representations(questionService.getByCustomer(c));
+    }
+
+    @GetMapping("/products/{sku}/questions")
+    public Object publicQuestions(@PathVariable String sku, @ApiIgnore MerchantStore store) {
+        List<Map<String, Object>> items = publicRepresentations(questionService.getPublicByProduct(product(sku, store)));
+        Map<String, Object> wrapper = new LinkedHashMap<>(); wrapper.put("count", items.size()); wrapper.put("items", items); return wrapper;
+    }
+
+    @GetMapping("/private/questions")
+    public List<Map<String, Object>> adminQuestions(@RequestParam(required = false) String status,
+            @ApiIgnore MerchantStore store, HttpServletRequest request) {
+        if (request.getUserPrincipal() == null) throw new UnauthorizedException();
+        ProductQuestionStatus s = StringUtils.isBlank(status) ? ProductQuestionStatus.PENDING : parseStatus(status);
+        List<ProductQuestion> result = s == null ? questionService.getByStore(store) : questionService.getByStore(store, s);
+        return representations(result);
+    }
+
+    @PutMapping("/private/questions/{id}/answer")
+    public Map<String, Object> answer(@PathVariable Long id, @RequestBody AnswerRequest body,
+            @ApiIgnore MerchantStore store, HttpServletRequest request) throws Exception {
+        if (request.getUserPrincipal() == null) throw new UnauthorizedException();
+        ProductQuestion q = question(id, store);
+        if (q.getStatus() == ProductQuestionStatus.REJECTED) throw new ConflictException("Rejected question cannot be answered");
+        q.setAnswer(validAnswer(body == null ? null : body.answer));
+        q.setStatus(ProductQuestionStatus.PUBLISHED);
+        q.setAnsweredAt(new Date());
+        questionService.update(q);
+        return representation(q);
+    }
+
+    @PutMapping("/private/questions/{id}/reject")
+    public Map<String, Object> reject(@PathVariable Long id, @ApiIgnore MerchantStore store, HttpServletRequest request) throws Exception {
+        if (request.getUserPrincipal() == null) throw new UnauthorizedException();
+        ProductQuestion q = question(id, store);
+        q.setStatus(ProductQuestionStatus.REJECTED);
+        questionService.update(q);
+        return representation(q);
+    }
+
+    private Product product(String sku, MerchantStore store) {
+        if (StringUtils.isBlank(sku)) throw new ResourceNotFoundException("Product not found");
+        try {
+            Product p = productService.getBySku(sku.trim(), store);
+            if (p == null) throw new ResourceNotFoundException("Product with sku " + sku + " not found");
+            return p;
+        } catch (ResourceNotFoundException e) { throw e; }
+        catch (Exception e) { throw new ResourceNotFoundException("Product with sku " + sku + " not found"); }
+    }
+
+    private ProductQuestion question(Long id, MerchantStore store) {
+        ProductQuestion q;
+        try { q = questionService.getById(id); }
+        catch (RuntimeException e) { throw new ResourceNotFoundException("Question with id " + id + " not found"); }
+        if (q == null || (store != null && q.getMerchantStore() != null && !store.getId().equals(q.getMerchantStore().getId())))
+            throw new ResourceNotFoundException("Question with id " + id + " not found");
+        return q;
+    }
