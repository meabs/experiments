+package com.salesmanager.core.business.services.catalog.product.question;
+import java.util.List;
+import javax.inject.Inject;
+import org.apache.commons.lang3.Validate;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long, ProductQuestion> implements ProductQuestionService {
+ private final ProductQuestionRepository repository;
+ @Inject public ProductQuestionServiceImpl(ProductQuestionRepository repository) { super(repository); this.repository=repository; }
+ @Override public ProductQuestion saveOrUpdate(ProductQuestion q) { Validate.notNull(q,"ProductQuestion cannot be null"); Validate.notNull(q.getProduct(),"ProductQuestion.product cannot be null"); Validate.notNull(q.getMerchantStore(),"ProductQuestion.merchantStore cannot be null"); if(q.getStatus()==null)q.setStatus(ProductQuestionStatus.PENDING); if(q.getAskedAt()==null)q.setAskedAt(new java.util.Date()); return repository.saveAndFlush(q); }
+ @Override public List<ProductQuestion> getBySku(String sku, MerchantStore s) { Validate.notBlank(sku,"sku cannot be blank"); Validate.notNull(s,"MerchantStore cannot be null"); return repository.findBySkuAndStore(sku,s.getCode()); }
+ @Override public List<ProductQuestion> getByStore(MerchantStore s) { Validate.notNull(s,"MerchantStore cannot be null"); return repository.findByMerchantStore_CodeOrderByAskedAtAsc(s.getCode()); }
+ @Override public List<ProductQuestion> getByStatus(ProductQuestionStatus st) { Validate.notNull(st,"status cannot be null"); return repository.findByStatusOrderByAskedAtAsc(st); }
+ @Override public List<ProductQuestion> getByCustomer(Long id) { Validate.notNull(id,"customerId cannot be null"); return repository.findByCustomer_IdOrderByAskedAtAsc(id); }
+ @Override public long countByStatus(ProductQuestionStatus st) { Validate.notNull(st,"status cannot be null"); return repository.countByStatus(st); }
+ @Override public List<ProductQuestion> getPending() { return getByStatus(ProductQuestionStatus.PENDING); }
+}
