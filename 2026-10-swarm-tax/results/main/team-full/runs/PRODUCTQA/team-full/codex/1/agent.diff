+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.Date;
+import java.util.List;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+import javax.validation.Valid;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.model.catalog.product.ProductQuestionAnswerRequest;
+import com.salesmanager.shop.model.catalog.product.ProductQuestionRequest;
+import com.salesmanager.shop.model.catalog.product.ProductQuestionResponse;
+import com.salesmanager.shop.model.catalog.product.ProductQuestionPublicResponse;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.api.exception.UnauthorizedException;
+import com.salesmanager.shop.store.controller.user.facade.UserFacade;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Customer, public and store-administration product-question resources. */
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+    @Inject private ProductQuestionService questionService;
+    @Inject private ProductService productService;
+    @Inject private CustomerService customerService;
+    @Inject private UserFacade userFacade;
+
+    @PostMapping("/auth/products/{sku}/questions")
+    @ResponseStatus(HttpStatus.CREATED)
+    public ProductQuestionResponse ask(@PathVariable String sku, @Valid @RequestBody ProductQuestionRequest body,
+            @ApiIgnore MerchantStore store) {
+        Customer customer = customer(store);
+        Product product = product(sku, store);
+        long pending = questionService.getByCustomer(customer.getId()).stream()
+                .filter(q -> q.getStatus() == ProductQuestionStatus.PENDING).count();
+        if (pending >= 3) throw new RestApiException("409", "Maximum of 3 pending questions reached");
+        ProductQuestion q = new ProductQuestion(); q.setProduct(product); q.setMerchantStore(store);
+        q.setCustomer(customer); q.setText(body.getText()); q.setStatus(ProductQuestionStatus.PENDING);
+        return map(questionService.saveOrUpdate(q));
+    }
+
+    @GetMapping("/auth/customer/questions")
+    public List<ProductQuestionResponse> mine(@ApiIgnore MerchantStore store) {
+        return questionService.getByCustomer(customer(store).getId()).stream().filter(q -> sameStore(q, store))
+                .sorted(Comparator.comparing(ProductQuestion::getAskedAt, Comparator.nullsLast(Comparator.reverseOrder())))
+                .map(this::map).collect(Collectors.toList());
+    }
+
+    @GetMapping("/products/{sku}/questions")
+    public PublicQuestionList publicQuestions(@PathVariable String sku, @ApiIgnore MerchantStore store) {
+        product(sku, store);
+        List<ProductQuestionPublicResponse> items = questionService.getBySku(sku, store).stream()
+                .filter(q -> q.getStatus() == ProductQuestionStatus.PUBLISHED)
+                .sorted(Comparator.comparing(ProductQuestion::getAnsweredAt, Comparator.nullsLast(Comparator.reverseOrder())))
+                .map(this::mapPublic).collect(Collectors.toList());
+        return new PublicQuestionList(items);
+    }
+
+    @GetMapping("/private/questions")
+    public List<ProductQuestionResponse> adminQuestions(@RequestParam(required = false) String status,
+            @ApiIgnore MerchantStore store) {
+        authorize(store);
+        List<ProductQuestion> qs = status == null ? questionService.getByStore(store)
+                : questionService.getByStatus(parseStatus(status)).stream().filter(q -> sameStore(q, store)).collect(Collectors.toList());
+        qs.sort(Comparator.comparing(ProductQuestion::getAskedAt, Comparator.nullsLast(Comparator.naturalOrder())));
+        return qs.stream().map(this::map).collect(Collectors.toList());
+    }
+
+    @PutMapping("/private/questions/{id}/answer")
+    public ProductQuestionResponse answer(@PathVariable Long id, @Valid @RequestBody ProductQuestionAnswerRequest body,
+            @ApiIgnore MerchantStore store) {
+        ProductQuestion q = adminQuestion(id, store);
+        if (q.getStatus() == ProductQuestionStatus.REJECTED) throw new RestApiException("409", "Rejected question cannot be answered");
+        q.setAnswer(body.getAnswer()); q.setStatus(ProductQuestionStatus.PUBLISHED); q.setAnsweredAt(new Date());
+        return map(questionService.saveOrUpdate(q));
+    }
+
+    @PutMapping("/private/questions/{id}/reject")
+    public ProductQuestionResponse reject(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        ProductQuestion q = adminQuestion(id, store);
+        if (q.getStatus() == ProductQuestionStatus.PUBLISHED) throw new RestApiException("409", "Published question cannot be rejected");
+        q.setStatus(ProductQuestionStatus.REJECTED); return map(questionService.saveOrUpdate(q));
+    }
+
+    private ProductQuestion adminQuestion(Long id, MerchantStore store) {
+        authorize(store); ProductQuestion q = questionService.getById(id);
+        if (q == null || !sameStore(q, store)) throw new ResourceNotFoundException("Question [" + id + "] not found");
+        return q;
+    }
+    private Product product(String sku, MerchantStore store) {
+        try { Product p = productService.getBySku(sku, store); if (p == null) throw new Exception(); return p; }
+        catch (Exception e) { throw new ResourceNotFoundException("Product [" + sku + "] not found"); }
