+package com.salesmanager.core.business.repositories.catalog.product.question;
+
+import java.util.List;
+
+import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Query;
+
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+
+public interface ProductQuestionRepository extends JpaRepository<ProductQuestion, Long> {
+    List<ProductQuestion> findByProduct_SkuAndMerchantStore_CodeOrderByAskedAtAsc(String sku, String storeCode);
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch q.merchantStore s left join fetch q.customer c where s.code = ?1 order by q.askedAt asc")
+    List<ProductQuestion> findByMerchantStore_CodeOrderByAskedAtAsc(String storeCode);
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch q.merchantStore s left join fetch q.customer c where q.status = ?1 order by q.askedAt asc")
+    List<ProductQuestion> findByStatusOrderByAskedAtAsc(ProductQuestionStatus status);
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch q.merchantStore s left join fetch q.customer c where c.id = ?1 order by q.askedAt asc")
+    List<ProductQuestion> findByCustomer_IdOrderByAskedAtAsc(Long customerId);
+    long countByStatus(ProductQuestionStatus status);
+
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch q.merchantStore s left join fetch q.customer c where p.sku = ?1 and s.code = ?2 order by q.askedAt asc")
+    List<ProductQuestion> findBySkuAndStore(String sku, String storeCode);
+}
