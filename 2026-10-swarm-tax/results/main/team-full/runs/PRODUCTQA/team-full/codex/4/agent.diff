+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.PersistableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestionList;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestionPublic;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestionPublicList;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Customer, public and moderation endpoints for product questions. */
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+    @Inject private ProductQuestionService questionService;
+    @Inject private ProductService productService;
+    @Inject private CustomerFacade customerFacade;
+
+    @PostMapping("/auth/products/{sku}/questions")
+    @ResponseStatus(HttpStatus.CREATED)
+    public ReadableProductQuestion ask(@PathVariable String sku, @Valid @RequestBody PersistableProductQuestion body,
+            @ApiIgnore MerchantStore store, Principal principal) throws ServiceException {
+        Customer customer = customer(principal, store);
+        Product product = product(sku, store);
+        long pending = questionService.getByCustomer(customer).stream()
+                .filter(existing -> existing.getStatus() == ProductQuestionStatus.PENDING).count();
+        if (pending >= 3)
+            throw new RestApiException("400", "A customer may have at most 3 pending questions");
+        String text = body.getText() == null ? null : body.getText().trim();
+        if (text == null || text.length() < 10 || text.length() > 500)
+            throw new RestApiException("400", "Question text must be between 10 and 500 characters");
+        ProductQuestion q = new ProductQuestion();
+        q.setProduct(product); q.setSku(sku); q.setCustomer(customer); q.setText(text);
+        questionService.create(q);
+        return map(q);
+    }
+
+    @GetMapping("/auth/customer/questions")
+    public List<ReadableProductQuestion> customerQuestions(@ApiIgnore MerchantStore store, Principal principal) {
+        return questionService.getByCustomer(customer(principal, store)).stream().map(this::map).collect(Collectors.toList());
+    }
+
+    @GetMapping("/products/{sku}/questions")
+    public ReadableProductQuestionPublicList productQuestions(@PathVariable String sku, @ApiIgnore MerchantStore store) throws ServiceException {
+        Product product = product(sku, store);
+        List<ReadableProductQuestionPublic> items = questionService.getPublishedByProduct(product).stream().map(this::mapPublic).collect(Collectors.toList());
+        return new ReadableProductQuestionPublicList(items.size(), items);
+    }
