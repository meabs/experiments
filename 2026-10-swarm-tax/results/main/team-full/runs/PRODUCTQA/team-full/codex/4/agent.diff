+package com.salesmanager.core.business.services.catalog.product.question;
+
+import java.util.Date;
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.apache.commons.lang3.Validate;
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long, ProductQuestion>
+        implements ProductQuestionService {
+    private final ProductQuestionRepository repository;
+
+    @Inject
+    public ProductQuestionServiceImpl(ProductQuestionRepository repository) {
+        super(repository);
+        this.repository = repository;
+    }
+
+    @Override
+    public List<ProductQuestion> getByCustomer(Customer customer) {
+        Validate.notNull(customer, "Customer cannot be null");
+        return repository.findByCustomerId(customer.getId());
+    }
+
+    @Override
+    public List<ProductQuestion> getPublishedByProduct(Product product) {
+        Validate.notNull(product, "Product cannot be null");
+        return repository.findPublishedByProductId(product.getId());
+    }
+
+    @Override
+    public List<ProductQuestion> getByStoreAndStatus(Integer storeId, ProductQuestionStatus status) {
+        Validate.notNull(storeId, "Store cannot be null");
+        Validate.notNull(status, "Status cannot be null");
+        return repository.findByStoreAndStatus(storeId, status);
+    }
+
+    @Override public long countPending(Integer storeId) { return repository.countPendingByStore(storeId); }
+    @Override public ProductQuestion getQuestion(Long id) { return repository.findQuestionById(id); }
+
+    @Override
+    public void create(ProductQuestion question) throws ServiceException {
+        validate(question);
+        if (question.getAskedAt() == null) question.setAskedAt(new Date());
+        question.setStatus(ProductQuestionStatus.PENDING);
+        super.create(question);
+    }
+
+    @Override
+    public void publish(ProductQuestion question, String answer) throws ServiceException {
+        Validate.notNull(question, "Question cannot be null");
+        Validate.notEmpty(answer, "Answer cannot be empty");
+        if (question.getStatus() == ProductQuestionStatus.REJECTED)
+            throw new IllegalStateException("Rejected questions cannot be answered");
+        question.setAnswer(answer);
+        question.setAnsweredAt(new Date());
+        question.setStatus(ProductQuestionStatus.PUBLISHED);
+        super.update(question);
+    }
+
+    @Override
+    public void reject(ProductQuestion question) throws ServiceException {
+        Validate.notNull(question, "Question cannot be null");
+        if (question.getStatus() == ProductQuestionStatus.REJECTED)
+            throw new IllegalStateException("Question is already rejected");
+        question.setStatus(ProductQuestionStatus.REJECTED);
+        super.update(question);
+    }
+
+    private void validate(ProductQuestion question) {
+        Validate.notNull(question, "ProductQuestion cannot be null");
+        Validate.notNull(question.getProduct(), "ProductQuestion.product cannot be null");
+        Validate.notEmpty(question.getText(), "ProductQuestion.text cannot be empty");
+    }
+}
