+package com.salesmanager.core.business.repositories.catalog.product.question;
+
+import java.util.List;
+
+import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Query;
+import org.springframework.data.repository.query.Param;
+
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+
+public interface ProductQuestionRepository extends JpaRepository<ProductQuestion, Long> {
+    @Query("select q from ProductQuestion q where q.customer.id = :customerId order by q.askedAt desc")
+    List<ProductQuestion> findByCustomerId(@Param("customerId") Long customerId);
+
+    @Query("select q from ProductQuestion q where q.product.id = :productId and q.status = com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus.PUBLISHED order by q.answeredAt desc")
+    List<ProductQuestion> findPublishedByProductId(@Param("productId") Long productId);
+
+    @Query("select q from ProductQuestion q where q.product.merchantStore.id = :storeId and q.status = :status order by q.askedAt asc")
+    List<ProductQuestion> findByStoreAndStatus(@Param("storeId") Integer storeId, @Param("status") ProductQuestionStatus status);
+
+    @Query("select count(q) from ProductQuestion q where q.product.merchantStore.id = :storeId and q.status = com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus.PENDING")
+    long countPendingByStore(@Param("storeId") Integer storeId);
+
+    /** Explicitly named lookup used by moderation workflows. */
+    @Query("select q from ProductQuestion q join fetch q.product p where q.id = :id")
+    ProductQuestion findQuestionById(@Param("id") Long id);
+}
