+package com.salesmanager.shop.model.catalog.product;
+
+import java.util.Date;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+
+/** Stable, public representation of a product question. */
+public class ReadableProductQuestion {
+    private Long id;
+    private String sku;
+    private String question;
+    private String answer;
+    private String status;
+    private Date askedAt;
+    private Date answeredAt;
+
+    public ReadableProductQuestion() { }
+    public ReadableProductQuestion(ProductQuestion source) {
+        id = source.getId(); sku = source.getSku(); question = source.getQuestion(); answer = source.getAnswer();
+        status = source.getStatus() == null ? null : source.getStatus().name();
+        askedAt = source.getAskedDate(); answeredAt = source.getAnsweredDate();
+    }
+    public Long getId() { return id; }
+    public String getSku() { return sku; }
+    public String getQuestion() { return question; }
+    public String getAnswer() { return answer; }
+    public String getStatus() { return status; }
+    public Date getAskedAt() { return askedAt; }
+    public Date getAnsweredAt() { return answeredAt; }
+}
