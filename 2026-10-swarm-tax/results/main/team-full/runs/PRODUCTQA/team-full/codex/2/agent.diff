+package com.salesmanager.core.business.services.catalog.product.question;
+
+import java.util.Date;
+import java.util.List;
+import java.util.Optional;
+import javax.inject.Inject;
+import org.apache.commons.lang3.Validate;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long, ProductQuestion> implements ProductQuestionService {
+    private final ProductQuestionRepository repository;
+    @Inject
+    public ProductQuestionServiceImpl(ProductQuestionRepository repository) { super(repository); this.repository = repository; }
+
+    /** Return null for an unknown id instead of exposing a lazy getOne proxy. */
+    @Override
+    public ProductQuestion getById(Long id) {
+        if (id == null) return null;
+        Optional<ProductQuestion> question = repository.findById(id);
+        return question.orElse(null);
+    }
+
+    @Override public List<ProductQuestion> getByCustomer(Customer customer) { Validate.notNull(customer); return repository.findByCustomerNewest(customer.getId()); }
+    @Override public List<ProductQuestion> getByProductPublishedAnswered(Product product) { Validate.notNull(product); return repository.findByProductPublishedAnsweredNewest(product.getId(), ProductQuestionStatus.PUBLISHED); }
+    @Override public List<ProductQuestion> getByStoreAndStatus(MerchantStore store, ProductQuestionStatus status) { Validate.notNull(store); Validate.notNull(status); return repository.findByStoreAndStatusOldest(store.getId(), status); }
+    @Override public List<ProductQuestion> findByCustomer(Customer customer) { return getByCustomer(customer); }
+    @Override public List<ProductQuestion> findByProductPublishedAnswered(Product product) { return getByProductPublishedAnswered(product); }
+    @Override public List<ProductQuestion> findByStoreAndStatus(MerchantStore store, ProductQuestionStatus status) { return getByStoreAndStatus(store, status); }
+
+    @Override public void create(ProductQuestion question) throws ServiceException { persist(question, true); }
+    @Override public void update(ProductQuestion question) throws ServiceException { persist(question, false); }
+
+    private void persist(ProductQuestion question, boolean create) throws ServiceException {
+        Validate.notNull(question, "ProductQuestion cannot be null");
+        Validate.notNull(question.getProduct(), "ProductQuestion.product cannot be null");
+        Validate.notEmpty(question.getQuestion(), "ProductQuestion.question cannot be empty");
+        if (question.getSku() == null) question.setSku(question.getProduct().getSku());
+        if (question.getAskedDate() == null) question.setAskedDate(new Date());
+        if (question.getStatus() == null) question.setStatus(ProductQuestionStatus.PENDING);
+        if (question.getAnswer() != null && question.getAnsweredDate() == null) question.setAnsweredDate(new Date());
+        if (question.getAnswer() == null) question.setAnsweredDate(null);
+        super.save(question);
+    }
+}
