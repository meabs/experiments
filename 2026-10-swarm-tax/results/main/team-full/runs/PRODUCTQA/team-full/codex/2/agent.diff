+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.List;
+import java.util.Locale;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import javax.validation.Valid;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.catalog.product.PersistableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestion;
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.UnauthorizedException;
+import com.salesmanager.shop.store.controller.user.facade.UserFacade;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Customer and merchant endpoints for product questions. */
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+    @Inject private ProductQuestionService questionService;
+    @Inject private ProductService productService;
+    @Inject private CustomerService customerService;
+    @Inject private UserFacade userFacade;
+
+    @PostMapping("/auth/products/{sku}/questions")
+    public ResponseEntity<?> ask(@PathVariable String sku, @Valid @RequestBody PersistableProductQuestion body,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest request) throws Exception {
+        Customer customer = currentCustomer(request, store);
+        Product product = productService.getBySku(sku, store, language);
+        if (product == null) return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+        String text = trim(body.getQuestion());
+        if (text == null || text.length() < 10 || text.length() > 500) return ResponseEntity.badRequest().build();
+        for (ProductQuestion old : questionService.getByCustomer(customer)) {
+            if (old.getProduct() != null && product.getId().equals(old.getProduct().getId()) && text.equals(old.getQuestion()))
+                return ResponseEntity.status(HttpStatus.CONFLICT).build();
+        }
+        ProductQuestion q = new ProductQuestion(); q.setProduct(product); q.setCustomer(customer); q.setQuestion(text);
+        questionService.create(q);
+        return ResponseEntity.status(HttpStatus.CREATED).body(new ReadableProductQuestion(q));
+    }
+
+    @GetMapping("/auth/customer/questions")
+    public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store, HttpServletRequest request) throws Exception {
+        Customer customer = currentCustomer(request, store);
+        return questionService.getByCustomer(customer).stream().map(ReadableProductQuestion::new).collect(Collectors.toList());
+    }
+
+    @GetMapping("/products/{sku}/questions")
+    public ResponseEntity<?> product(@PathVariable String sku, @ApiIgnore MerchantStore store, @ApiIgnore Language language) throws Exception {
+        Product product = productService.getBySku(sku, store, language);
+        if (product == null) return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+        return ResponseEntity.ok(questionService.getByProductPublishedAnswered(product).stream().map(ReadableProductQuestion::new).collect(Collectors.toList()));
+    }
+
+    @GetMapping("/private/questions")
+    public List<ReadableProductQuestion> adminList(@RequestParam(value = "status", required = false) String status,
+            @ApiIgnore MerchantStore store) {
+        requireAdmin();
+        ProductQuestionStatus s = parseStatus(status);
+        return questionService.getByStoreAndStatus(store, s).stream().map(ReadableProductQuestion::new).collect(Collectors.toList());
+    }
+
+    @PutMapping("/private/questions/{id}")
+    public ResponseEntity<?> adminUpdate(@PathVariable Long id, @Valid @RequestBody PersistableProductQuestion body,
+            @ApiIgnore MerchantStore store) throws Exception {
+        requireAdmin();
+        ProductQuestion q = questionService.getById(id);
+        if (q == null || q.getProduct() == null || q.getProduct().getMerchantStore() == null ||
+                !q.getProduct().getMerchantStore().getId().equals(store.getId())) return ResponseEntity.notFound().build();
+        if (body.getAnswer() != null) {
+            String answer = trim(body.getAnswer());
+            if (answer != null && answer.length() > 4000) return ResponseEntity.badRequest().build();
+            q.setAnswer(answer);
+        }
+        if (body.getStatus() != null) {
+            try { q.setStatus(ProductQuestionStatus.valueOf(body.getStatus().trim().toUpperCase(Locale.ROOT))); }
+            catch (IllegalArgumentException e) { return ResponseEntity.badRequest().build(); }
+        }
+        questionService.update(q);
+        return ResponseEntity.ok(new ReadableProductQuestion(q));
+    }
+
+    private Customer currentCustomer(HttpServletRequest request, MerchantStore store) {
+        Principal p = request.getUserPrincipal();
+        if (p == null) throw new UnauthorizedException();
+        Customer c = customerService.getByNick(p.getName(), store.getId());
+        if (c == null) throw new ResourceNotFoundException("Customer not found");
+        return c;
+    }
+    private void requireAdmin() {
+        String user = userFacade.authenticatedUser();
+        if (user == null) throw new UnauthorizedException();
+        userFacade.authorizedGroup(user, java.util.Arrays.asList(Constants.GROUP_SUPERADMIN,
+                Constants.GROUP_ADMIN, Constants.GROUP_ADMIN_RETAIL));
+    }
+    private ProductQuestionStatus parseStatus(String value) {
+        if (value == null || value.trim().isEmpty()) return ProductQuestionStatus.PENDING;
+        try { return ProductQuestionStatus.valueOf(value.trim().toUpperCase(Locale.ROOT)); }
+        catch (IllegalArgumentException e) { throw new IllegalArgumentException("Invalid question status"); }
+    }
+    private String trim(String value) { if (value == null) return null; String t = value.trim(); return t.isEmpty() ? null : t; }
+}
