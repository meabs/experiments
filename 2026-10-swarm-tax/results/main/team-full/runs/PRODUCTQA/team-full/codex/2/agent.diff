+package com.salesmanager.core.business.repositories.catalog.product.question;
+
+import java.util.List;
+import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Query;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+
+public interface ProductQuestionRepository extends JpaRepository<ProductQuestion, Long> {
+    @Query("select q from ProductQuestion q join fetch q.product p left join fetch q.customer c where c.id = ?1 order by q.askedDate desc")
+    List<ProductQuestion> findByCustomerNewest(Long customerId);
+
+    @Query("select q from ProductQuestion q join fetch q.product p where p.id = ?1 and q.status = ?2 and q.answer is not null order by q.answeredDate desc")
+    List<ProductQuestion> findByProductPublishedAnsweredNewest(Long productId, ProductQuestionStatus status);
+
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch p.merchantStore s where s.id = ?1 and q.status = ?2 order by q.askedDate asc")
+    List<ProductQuestion> findByStoreAndStatusOldest(Integer storeId, ProductQuestionStatus status);
+
+    List<ProductQuestion> findByCustomerIdOrderByAskedDateDesc(Long customerId);
+    List<ProductQuestion> findByProductIdAndStatusAndAnswerIsNotNullOrderByAnsweredDateDesc(Long productId, ProductQuestionStatus status);
+}
