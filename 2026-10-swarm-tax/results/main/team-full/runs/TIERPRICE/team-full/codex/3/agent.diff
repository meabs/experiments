+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.ArrayList;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.stereotype.Controller;
+import com.salesmanager.core.business.services.catalog.product.ProductPriceTierService;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductPriceTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.price.PersistableProductPriceTier;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@Controller
+@RequestMapping("/api/v1/private/product/{id}/tiers")
+public class ProductPriceTierApi {
+    @Inject private ProductPriceTierService tierService;
+    @Inject private ProductService productService;
+
+    private void ensureProduct(Long id, MerchantStore store) {
+        Product product = productService.findOne(id, store);
+        if (product == null) throw new ResourceNotFoundException("Product not found");
+    }
+
+    @PutMapping
+    @ResponseStatus(HttpStatus.OK)
+    public @ResponseBody List<PersistableProductPriceTier> replace(@PathVariable Long id,
+            @RequestBody List<PersistableProductPriceTier> request, @ApiIgnore MerchantStore store) {
+        ensureProduct(id, store);
+        List<ProductPriceTier> tiers = new ArrayList<>();
+        if (request == null) throw new RestApiException("400", "Tier request body must be a JSON array");
+        for (PersistableProductPriceTier dto : request) {
+            if (dto == null) throw new RestApiException("400", "Tier entries must not be null");
+            ProductPriceTier tier = new ProductPriceTier(); tier.setMinQuantity(dto.getMinQuantity()); tier.setPrice(dto.getPrice()); tiers.add(tier);
+        }
+        try {
+            return toDto(tierService.replace(id, store, tiers));
+        } catch (IllegalArgumentException e) {
+            throw new RestApiException("400", e.getMessage());
+        }
+    }
+
+    @GetMapping
+    public @ResponseBody List<PersistableProductPriceTier> get(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        ensureProduct(id, store);
+        return toDto(tierService.get(id, store));
+    }
+
+    private List<PersistableProductPriceTier> toDto(List<ProductPriceTier> tiers) {
+        List<PersistableProductPriceTier> result = new ArrayList<>();
+        for (ProductPriceTier tier : tiers) { PersistableProductPriceTier dto = new PersistableProductPriceTier(); dto.setMinQuantity(tier.getMinQuantity()); dto.setPrice(tier.getPrice()); result.add(dto); }
+        return result;
+    }
+}
