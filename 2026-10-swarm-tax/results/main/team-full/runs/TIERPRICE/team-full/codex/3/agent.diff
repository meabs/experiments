+package com.salesmanager.core.business.services.catalog.product;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.ProductPriceTierRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductPriceTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productPriceTierService")
+public class ProductPriceTierServiceImpl implements ProductPriceTierService {
+    private final ProductPriceTierRepository repository;
+    private final ProductService productService;
+    @Inject public ProductPriceTierServiceImpl(ProductPriceTierRepository repository, ProductService productService) {
+        this.repository = repository; this.productService = productService;
+    }
+    private Product product(Long id, MerchantStore store) {
+        Product p = productService.findOne(id, store);
+        if (p == null) throw new IllegalArgumentException("Product not found");
+        return p;
+    }
+    @Override public List<ProductPriceTier> get(Long id, MerchantStore store) {
+        product(id, store);
+        return repository.findByProductIdOrderByMinQuantityAsc(id);
+    }
+    @Override @Transactional
+    public List<ProductPriceTier> replace(Long id, MerchantStore store, List<ProductPriceTier> tiers) {
+        Product p = product(id, store);
+        if (tiers != null && tiers.size() > 10) throw new IllegalArgumentException("A product may have at most 10 tiers");
+        List<ProductPriceTier> sorted = tiers == null ? new ArrayList<>() : new ArrayList<>(tiers);
+        sorted.sort(Comparator.comparing(ProductPriceTier::getMinQuantity, Comparator.nullsFirst(Integer::compareTo)));
+        Set<Integer> mins = new HashSet<>();
+        BigDecimal previous = null;
+        for (ProductPriceTier tier : sorted) {
+            if (tier.getMinQuantity() == null || tier.getMinQuantity() < 2 || !mins.add(tier.getMinQuantity())) throw new IllegalArgumentException("Minimum quantities must be unique whole numbers of at least 2");
+            if (tier.getPrice() == null || tier.getPrice().signum() <= 0) throw new IllegalArgumentException("Prices must be positive");
+            if (previous != null && tier.getPrice().compareTo(previous) >= 0) throw new IllegalArgumentException("Prices must decrease as quantity increases");
+            previous = tier.getPrice();
+        }
+        repository.deleteByProductId(id);
+        for (ProductPriceTier tier : sorted) { tier.setId(null); tier.setProduct(p); }
+        return repository.saveAll(sorted);
+    }
+}
