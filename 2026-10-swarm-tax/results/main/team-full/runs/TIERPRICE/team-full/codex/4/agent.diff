+package com.salesmanager.core.model.catalog.product.tier;
+
+import java.math.BigDecimal;
+import javax.persistence.*;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.generic.SalesManagerEntity;
+
+/** A quantity break price for a product. */
+@Entity
+@Table(name = "PRODUCT_TIER", uniqueConstraints = @UniqueConstraint(columnNames = {"PRODUCT_ID", "MIN_QUANTITY"}))
+public class ProductTier extends SalesManagerEntity<Long, ProductTier> {
+    private static final long serialVersionUID = 1L;
+
+    @Id
+    @Column(name = "PRODUCT_TIER_ID", nullable = false)
+    @TableGenerator(name = "TABLE_GEN", table = "SM_SEQUENCER", pkColumnName = "SEQ_NAME", valueColumnName = "SEQ_COUNT", pkColumnValue = "PRODUCT_TIER_SEQ_NEXT_VAL")
+    @GeneratedValue(strategy = GenerationType.TABLE, generator = "TABLE_GEN")
+    private Long id;
+
+    @ManyToOne(fetch = FetchType.LAZY, optional = false)
+    @JoinColumn(name = "PRODUCT_ID", nullable = false)
+    private Product product;
+
+    @Column(name = "MIN_QUANTITY", nullable = false)
+    private Integer minQuantity;
+
+    @Column(name = "PRICE", nullable = false, precision = 19, scale = 6)
+    private BigDecimal price;
+
+    @Override public Long getId() { return id; }
+    @Override public void setId(Long id) { this.id = id; }
+    public Product getProduct() { return product; }
+    public void setProduct(Product product) { this.product = product; }
+    public Integer getMinQuantity() { return minQuantity; }
+    public void setMinQuantity(Integer minQuantity) { this.minQuantity = minQuantity; }
+    public BigDecimal getPrice() { return price; }
+    public void setPrice(BigDecimal price) { this.price = price; }
+}
