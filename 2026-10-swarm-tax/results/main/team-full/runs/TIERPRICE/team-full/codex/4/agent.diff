+    /** Apply the best tier belonging to this line's product only. */
+    private void applyQuantityTierPrice(final ShoppingCartItem item) {
+        if (item == null || item.getProduct() == null || item.getItemPrice() == null
+                || item.getQuantity() == null || item.getQuantity() < 1) {
+            return;
+        }
+        // FinalPrice is refreshed by ShoppingCartService and preserves the
+        // product's own final/special price across repeated calculations.
+        BigDecimal productPrice = item.getFinalPrice() != null
+                && item.getFinalPrice().getFinalPrice() != null
+                ? item.getFinalPrice().getFinalPrice() : item.getItemPrice();
+        item.setItemPrice(productPrice);
+        // Product tiers are lazy and cart products can be detached by the time
+        // calculation runs. Query through the tier service instead of walking
+        // Product.tiers directly; this also guarantees current persisted data.
+        List<ProductTier> tiers = productTierService.findByProduct(item.getProduct());
+        if (CollectionUtils.isEmpty(tiers)) {
+            return;
+        }
+        ProductTier reached = null;
+        for (ProductTier tier : tiers) {
+            if (tier == null || tier.getMinQuantity() == null || tier.getPrice() == null
+                    || tier.getMinQuantity() < 1 || tier.getMinQuantity() > item.getQuantity()) {
+                continue;
+            }
+            if (reached == null || tier.getMinQuantity() > reached.getMinQuantity()) {
+                reached = tier;
+            }
+        }
+        // The product's own final/special price wins if it is cheaper.
+        if (reached != null && reached.getPrice().compareTo(productPrice) < 0) {
+            item.setItemPrice(reached.getPrice());
+        }
+    }
+
 
