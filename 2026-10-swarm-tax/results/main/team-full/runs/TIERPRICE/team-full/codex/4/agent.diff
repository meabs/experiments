+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import javax.inject.Inject;
+import javax.validation.Valid;
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.tier.ProductTierService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.tier.ProductTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.tier.ProductTierDTO;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Quantity-break pricing administration. */
+@Controller
+@RequestMapping("/api/v1/private/product/{id}/tiers")
+public class ProductTierApi {
+    @Inject private ProductService productService;
+    @Inject private ProductTierService tierService;
+
+    @GetMapping
+    @ResponseBody
+    public List<ProductTierDTO> get(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        Product product = product(id, store);
+        List<ProductTierDTO> result = new ArrayList<ProductTierDTO>();
+        for (ProductTier tier : tierService.findByProduct(product)) result.add(dto(tier));
+        return result;
+    }
+
+    @PutMapping
+    @ResponseStatus(HttpStatus.OK)
+    public void put(@PathVariable Long id, @Valid @RequestBody List<ProductTierDTO> request,
+                    @ApiIgnore MerchantStore store) {
+        Product product = product(id, store);
+        if (request == null || request.size() > 10) throw new RestApiException("400", "At most 10 tiers are allowed");
+        List<ProductTierDTO> sorted = new ArrayList<ProductTierDTO>(request);
+        sorted.sort(Comparator.comparing(ProductTierDTO::getMinQuantity, Comparator.nullsFirst(Integer::compareTo)));
+        Set<Integer> quantities = new HashSet<Integer>();
+        for (int i = 0; i < sorted.size(); i++) {
+            ProductTierDTO tier = sorted.get(i);
+            if (tier == null || tier.getMinQuantity() == null || tier.getPrice() == null
+                    || tier.getMinQuantity() < 2 || tier.getPrice().signum() <= 0
+                    || !quantities.add(tier.getMinQuantity())
+                    || (i > 0 && tier.getPrice().compareTo(sorted.get(i - 1).getPrice()) >= 0))
+                throw new RestApiException("400", "Invalid tier definitions");
+        }
+        List<ProductTier> entities = new ArrayList<ProductTier>();
+        for (ProductTierDTO dto : sorted) {
+            ProductTier tier = new ProductTier(); tier.setMinQuantity(dto.getMinQuantity()); tier.setPrice(dto.getPrice()); entities.add(tier);
+        }
+        tierService.replace(product, entities);
+    }
+
+    private Product product(Long id, MerchantStore store) {
+        return productService.retrieveById(id, store).orElseThrow(() -> new ResourceNotFoundException("Product not found"));
+    }
+    private ProductTierDTO dto(ProductTier tier) {
+        ProductTierDTO dto = new ProductTierDTO(); dto.setMinQuantity(tier.getMinQuantity()); dto.setPrice(tier.getPrice()); return dto;
+    }
+}
