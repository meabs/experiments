+package com.salesmanager.core.business.services.catalog.product.tier;
+
+import java.util.ArrayList;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.catalog.product.tier.ProductTierRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.tier.ProductTier;
+
+@Service("productTierService")
+public class ProductTierServiceImpl implements ProductTierService {
+    @Inject private ProductTierRepository repository;
+    @Override @Transactional(readOnly = true)
+    public List<ProductTier> findByProduct(Product product) {
+        return repository.findByProductIdOrderByMinQuantityAsc(product.getId());
+    }
+    @Override @Transactional
+    public void replace(Product product, List<ProductTier> tiers) {
+        repository.deleteByProductId(product.getId());
+        List<ProductTier> copy = new ArrayList<ProductTier>(tiers);
+        for (ProductTier tier : copy) tier.setProduct(product);
+        repository.saveAll(copy);
+    }
+}
