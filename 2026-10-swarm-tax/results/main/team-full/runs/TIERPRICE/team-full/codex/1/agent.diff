+	/** Replace all wholesale quantity breaks for a product. */
+	@ResponseStatus(HttpStatus.OK)
+	@RequestMapping(value = "/private/product/{id}/tiers", method = RequestMethod.PUT)
+	public void replaceTiers(@PathVariable Long id, @RequestBody List<ProductPriceTierEntity> request,
+			@ApiIgnore MerchantStore merchantStore, HttpServletResponse response) throws IOException {
+		Product product = findProductOwnedByStore(id, merchantStore);
+		if (product == null) {
+			response.sendError(404, "Product not found");
+			return;
+		}
+		if (request == null || request.size() > 10) {
+			response.sendError(400, "At most 10 tiers are allowed");
+			return;
+		}
+		Set<Integer> quantities = new HashSet<Integer>();
+		Integer previousQuantity = null;
+		BigDecimal previousPrice = null;
+		List<ProductPriceTierEntity> sorted = new ArrayList<ProductPriceTierEntity>(request);
+		sorted.sort((a, b) -> {
+			if (a == null) return b == null ? 0 : -1;
+			if (b == null) return 1;
+			if (a.getMinQuantity() == null) return b.getMinQuantity() == null ? 0 : -1;
+			if (b.getMinQuantity() == null) return 1;
+			return a.getMinQuantity().compareTo(b.getMinQuantity());
+		});
+		for (ProductPriceTierEntity tier : sorted) {
+			if (tier == null || tier.getMinQuantity() == null || tier.getMinQuantity() < 2 ||
+					tier.getPrice() == null || tier.getPrice().signum() <= 0 ||
+					!quantities.add(tier.getMinQuantity())) {
+				response.sendError(400, "Invalid tier"); return;
+			}
+			if (previousQuantity != null && tier.getMinQuantity() <= previousQuantity) {
+				response.sendError(400, "Quantities must increase"); return;
+			}
+			if (previousPrice != null && tier.getPrice().compareTo(previousPrice) >= 0) {
+				response.sendError(400, "Prices must strictly decrease"); return;
+			}
+			previousQuantity = tier.getMinQuantity(); previousPrice = tier.getPrice();
+		}
+		List<ProductPriceTier> tiers = new ArrayList<ProductPriceTier>();
+		for (ProductPriceTierEntity dto : sorted) {
+			ProductPriceTier tier = new ProductPriceTier();
+			tier.setMinQuantity(dto.getMinQuantity()); tier.setPrice(dto.getPrice());
+			tier.setProduct(product);
+			tiers.add(tier);
+		}
+		productPriceTierService.replace(id, tiers);
+	}
+
