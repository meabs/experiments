+	@Override
+	public void recalculatePrices(ShoppingCart cart) throws ServiceException {
+		if (cart == null || cart.getLineItems() == null) {
+			return;
+		}
+		for (ShoppingCartItem item : cart.getLineItems()) {
+			if (item.getProduct() == null) {
+				continue;
+			}
+			List<ProductAttribute> attributes = new ArrayList<>();
+			if (item.getAttributes() != null) {
+				for (ShoppingCartAttributeItem attribute : item.getAttributes()) {
+					if (attribute.getProductAttribute() != null) {
+						attributes.add(attribute.getProductAttribute());
+					}
+				}
+			}
+			FinalPrice price = applyQuantityTier(item.getProduct(), item.getQuantity(),
+					pricingService.calculateProductPrice(item.getProduct(), attributes));
+			item.setFinalPrice(price);
+			item.setItemPrice(price.getFinalPrice());
+			item.setSubTotal(item.getItemPrice().multiply(new BigDecimal(item.getQuantity())));
+		}
+	}
