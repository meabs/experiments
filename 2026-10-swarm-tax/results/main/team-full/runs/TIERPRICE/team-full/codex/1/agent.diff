+	/**
+	 * Select a tier from this product only.  The catalogue price (including an
+	 * active special and attribute charges) remains the floor: a tier is used
+	 * only when it is cheaper than that price.
+	 */
+	private FinalPrice applyQuantityTier(Product product, int quantity, FinalPrice basePrice) {
+		ProductPriceTier tier = null;
+		if (product.getPriceTiers() != null) {
+			for (ProductPriceTier candidate : product.getPriceTiers()) {
+				Integer minimum = candidate.getMinQuantity();
+				if (minimum != null && minimum > 0 && minimum <= quantity
+						&& (tier == null || minimum > tier.getMinQuantity())) {
+					tier = candidate;
+				}
+			}
+		}
+		if (tier != null && tier.getPrice() != null
+				&& (basePrice.getFinalPrice() == null || tier.getPrice().compareTo(basePrice.getFinalPrice()) < 0)) {
+			basePrice.setFinalPrice(tier.getPrice());
+		}
+		return basePrice;
+	}
