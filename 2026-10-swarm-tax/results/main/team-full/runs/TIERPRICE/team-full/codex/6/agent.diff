+	private void applyQuantityTiers(final ShoppingCart cart) throws ServiceException {
+		for (ShoppingCartItem item : cart.getLineItems()) {
+			if (item.getItemPrice() == null || item.getProduct() == null
+					|| item.getProduct().getPriceTiers() == null) {
+				continue;
+			}
+			BigDecimal base = item.getFinalPrice() != null && item.getFinalPrice().getFinalPrice() != null
+					? item.getFinalPrice().getFinalPrice()
+					: pricingService.calculateProductPrice(item.getProduct()).getFinalPrice();
+			BigDecimal effective = base;
+			int selectedMinQuantity = Integer.MIN_VALUE;
+			int quantity = item.getQuantity() == null ? 0 : item.getQuantity();
+			for (ProductTier tier : item.getProduct().getPriceTiers()) {
+				if (tier != null && tier.getMinQuantity() != null && tier.getPrice() != null
+						&& tier.getMinQuantity() <= quantity && tier.getMinQuantity() > selectedMinQuantity) {
+					selectedMinQuantity = tier.getMinQuantity();
+					effective = tier.getPrice().compareTo(base) < 0 ? tier.getPrice() : base;
+				}
+			}
+			item.setItemPrice(effective);
+			item.setSubTotal(effective.multiply(BigDecimal.valueOf(quantity)));
+		}
+	}
+
 }
