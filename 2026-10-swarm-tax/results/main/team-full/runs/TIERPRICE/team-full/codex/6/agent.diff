+
+	private List<com.salesmanager.shop.model.catalog.product.ProductTier> toTierDtos(Product product) {
+		List<com.salesmanager.shop.model.catalog.product.ProductTier> result = new ArrayList<>();
+		if (product.getPriceTiers() != null) {
+			for (ProductTier tier : product.getPriceTiers()) {
+				com.salesmanager.shop.model.catalog.product.ProductTier dto = new com.salesmanager.shop.model.catalog.product.ProductTier();
+				dto.setMinQuantity(tier.getMinQuantity());
+				dto.setPrice(tier.getPrice());
+				result.add(dto);
+			}
+			result.sort(java.util.Comparator.comparing(com.salesmanager.shop.model.catalog.product.ProductTier::getMinQuantity));
+		}
+		return result;
+	}
