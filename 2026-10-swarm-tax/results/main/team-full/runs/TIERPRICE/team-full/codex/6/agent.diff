 public class ProductApi {
 
+	/** Replace all wholesale quantity tiers for a product. */
+	@ResponseStatus(HttpStatus.OK)
+	@org.springframework.transaction.annotation.Transactional
+	@RequestMapping(value = "/private/product/{id}/tiers", method = RequestMethod.PUT,
+			produces = APPLICATION_JSON_VALUE)
+	public @ResponseBody List<com.salesmanager.shop.model.catalog.product.ProductTier> putTiers(
+			@PathVariable Long id, @RequestBody List<com.salesmanager.shop.model.catalog.product.ProductTier> tiers,
+			@ApiIgnore MerchantStore merchantStore) {
+		Product product = productService.retrieveById(id, merchantStore).orElseThrow(
+				() -> new ResourceNotFoundException("Product not found"));
+		if (tiers == null || tiers.size() > 10) {
+			throw new RestApiException("400", "At most 10 price tiers are allowed");
+		}
+		// Input order is not significant. Validate and persist in canonical quantity order.
+		List<com.salesmanager.shop.model.catalog.product.ProductTier> orderedTiers = new ArrayList<>(tiers);
+		orderedTiers.sort(java.util.Comparator.nullsFirst(java.util.Comparator.comparing(
+				com.salesmanager.shop.model.catalog.product.ProductTier::getMinQuantity,
+				java.util.Comparator.nullsFirst(Integer::compareTo))));
+		Integer previousQuantity = null;
+		java.math.BigDecimal previousPrice = null;
+		for (com.salesmanager.shop.model.catalog.product.ProductTier tier : orderedTiers) {
+			if (tier == null || tier.getMinQuantity() == null || tier.getMinQuantity() < 2
+					|| tier.getPrice() == null || tier.getPrice().signum() <= 0) {
+				throw new RestApiException("400", "Each tier requires minQuantity >= 2 and a positive price");
+			}
+			// The API is ordered by increasing quantity; reject duplicates and non-decreasing prices.
+			if (previousQuantity != null && tier.getMinQuantity() <= previousQuantity) {
+				throw new RestApiException("400", "Tier quantities must be strictly increasing");
+			}
+			if (previousPrice != null && tier.getPrice().compareTo(previousPrice) >= 0) {
+				throw new RestApiException("400", "Tier prices must strictly decrease as quantity increases");
+			}
+			previousQuantity = tier.getMinQuantity();
+			previousPrice = tier.getPrice();
+		}
+		if (product.getPriceTiers() == null) {
+			product.setPriceTiers(new java.util.LinkedHashSet<ProductTier>());
+		} else {
+			product.getPriceTiers().clear();
+		}
+		for (com.salesmanager.shop.model.catalog.product.ProductTier tier : orderedTiers) {
+			ProductTier modelTier = new ProductTier();
+			modelTier.setProduct(product);
+			modelTier.setMinQuantity(tier.getMinQuantity());
+			modelTier.setPrice(tier.getPrice());
+			product.getPriceTiers().add(modelTier);
+		}
+		try {
+			productService.update(product);
+		} catch (Exception e) {
+			throw new RestApiException("500", "Unable to save price tiers", e);
+		}
+		return toTierDtos(product);
+	}
+
