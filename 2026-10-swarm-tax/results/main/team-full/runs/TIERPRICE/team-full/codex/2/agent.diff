+	/** Replace all wholesale quantity tiers for a product. */
+	@PutMapping(value = "/private/product/{id}/tiers", consumes = APPLICATION_JSON_VALUE, produces = APPLICATION_JSON_VALUE)
+	@Transactional
+	public ResponseEntity<?> replaceQuantityTiers(@PathVariable Long id,
+			@RequestBody List<ProductQuantityTierEntity> request,
+			@ApiIgnore MerchantStore merchantStore) {
+		Product product = productService.retrieveById(id, merchantStore).orElse(null);
+		if (product == null) {
+			return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+		}
+		if (request == null || request.size() > 10) {
+			return ResponseEntity.badRequest().build();
+		}
+		List<ProductQuantityTierEntity> sorted = new ArrayList<ProductQuantityTierEntity>(request);
+		sorted.sort(Comparator.comparing(t -> t == null ? null : t.getMinQuantity(),
+				Comparator.nullsFirst(Integer::compareTo)));
+		Set<Integer> quantities = new HashSet<Integer>();
+		BigDecimal previousPrice = null;
+		for (ProductQuantityTierEntity tier : sorted) {
+			if (tier == null || tier.getMinQuantity() == null || tier.getMinQuantity() < 2
+					|| tier.getPrice() == null || tier.getPrice().compareTo(BigDecimal.ZERO) <= 0
+					|| !quantities.add(tier.getMinQuantity())) {
+				return ResponseEntity.badRequest().build();
+			}
+			if (previousPrice != null && previousPrice.compareTo(tier.getPrice()) <= 0) {
+				return ResponseEntity.badRequest().build();
+			}
+			previousPrice = tier.getPrice();
+		}
+		// Validation is complete before either delete or insert, so an invalid request
+		// leaves the existing tiers untouched.
+		productQuantityTierRepository.deleteByProduct(product);
+		for (ProductQuantityTierEntity tier : sorted) {
+			ProductQuantityTier entity = new ProductQuantityTier();
+			entity.setProduct(product);
+			entity.setMinQuantity(tier.getMinQuantity());
+			entity.setPrice(tier.getPrice());
+			productQuantityTierRepository.save(entity);
+		}
+		return ResponseEntity.ok(toQuantityTierEntities(product));
+	}
+
+	@GetMapping(value = "/private/product/{id}/tiers", produces = APPLICATION_JSON_VALUE)
+	public ResponseEntity<List<ProductQuantityTierEntity>> getQuantityTiers(@PathVariable Long id,
+			@ApiIgnore MerchantStore merchantStore) {
+		Product product = productService.retrieveById(id, merchantStore).orElse(null);
+		if (product == null) {
+			return ResponseEntity.notFound().build();
+		}
+		return ResponseEntity.ok(toQuantityTierEntities(product));
+	}
+
+	private List<ProductQuantityTierEntity> toQuantityTierEntities(Product product) {
+		List<ProductQuantityTier> tiers = productQuantityTierRepository.findByProductOrderByMinQuantityAsc(product);
+		List<ProductQuantityTierEntity> result = new ArrayList<ProductQuantityTierEntity>();
+		for (ProductQuantityTier tier : tiers) {
+			ProductQuantityTierEntity dto = new ProductQuantityTierEntity();
+			dto.setMinQuantity(tier.getMinQuantity());
+			dto.setPrice(tier.getPrice());
+			result.add(dto);
+		}
+		return result;
+	}
