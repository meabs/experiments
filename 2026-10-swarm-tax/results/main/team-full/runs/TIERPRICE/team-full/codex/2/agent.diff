+	/**
+	 * Apply the best tier for each line immediately before the order calculator
+	 * runs.  Cart item prices are transient, while the subtotal may have been
+	 * persisted by an earlier request, so doing this at the calculation boundary
+	 * also prevents stale subtotals from leaking into a response.
+	 */
+	private void applyQuantityPrices(final ShoppingCart cartModel) {
+		for (ShoppingCartItem item : cartModel.getLineItems()) {
+			if (item == null || item.getProduct() == null || item.getItemPrice() == null
+					|| item.getQuantity() == null || item.getQuantity() < 1) {
+				continue;
+			}
+			BigDecimal baseline = item.getFinalPrice() == null ? item.getItemPrice()
+					: item.getFinalPrice().getFinalPrice();
+			if (baseline == null) {
+				baseline = item.getItemPrice();
+			}
+			Set<ProductQuantityTier> tiers = item.getProduct().getQuantityTiers();
+			if (tiers == null || tiers.isEmpty()) {
+				item.setItemPrice(baseline);
+				continue;
+			}
+			// finalPrice is the freshly calculated product/attribute price.  Use it
+			// as the baseline so changing quantity back down cannot retain an older
+			// tier price from a previous calculation.
+			ProductQuantityTier selected = null;
+			for (ProductQuantityTier tier : tiers) {
+				if (tier == null || tier.getMinQuantity() == null || tier.getPrice() == null
+						|| tier.getMinQuantity() < 1 || tier.getMinQuantity() > item.getQuantity()) {
+					continue;
+				}
+				if (selected == null || tier.getMinQuantity() > selected.getMinQuantity()) {
+					selected = tier;
+				}
+			}
+			// A special/attribute price remains authoritative when it is cheaper.
+			if (selected != null && selected.getPrice().compareTo(baseline) < 0) {
+				item.setItemPrice(selected.getPrice());
+			} else {
+				item.setItemPrice(baseline);
+			}
+		}
+	}
+
 }
