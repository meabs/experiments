+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.math.BigDecimal;
+import java.security.Principal;
+import java.util.*;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import javax.validation.Valid;
+import org.springframework.http.*;
+import org.springframework.web.bind.annotation.*;
+import org.springframework.web.server.ResponseStatusException;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.variant.ProductVariantService;
+import com.salesmanager.core.business.services.customer.CustomerWishlistService;
+import com.salesmanager.core.business.services.shoppingcart.ShoppingCartService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.CustomerWishlistItem;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.customer.PersistableWishlistItem;
+import com.salesmanager.shop.model.customer.ReadableWishlist;
+import com.salesmanager.shop.model.customer.ReadableWishlistItem;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/auth/customer/wishlist")
+public class CustomerWishlistApi {
+ @Inject private CustomerWishlistService wishlistService;
+ @Inject private ProductService productService;
+ @Inject private ProductVariantService productVariantService;
+ @Inject private ShoppingCartService shoppingCartService;
+ @Inject private CustomerFacade customerFacade;
+ @Inject private ShoppingCartFacade cartFacade;
+ private Customer customer(HttpServletRequest request, MerchantStore store) {
+   Principal p=request.getUserPrincipal(); if(p==null) throw new ResponseStatusException(HttpStatus.UNAUTHORIZED,"Authentication required");
+   Customer c=customerFacade.getCustomerByUserName(p.getName(),store); if(c==null) throw new ResponseStatusException(HttpStatus.UNAUTHORIZED,"Customer not found"); return c;
+ }
+ @PostMapping public ResponseEntity<ReadableWishlistItem> add(@Valid @RequestBody PersistableWishlistItem body, HttpServletRequest request, @ApiIgnore MerchantStore store, @ApiIgnore Language language) {
+   if(body==null || body.getProduct()==null || body.getProduct().trim().isEmpty()) throw new ResponseStatusException(HttpStatus.BAD_REQUEST,"product is required");
+   Customer c=customer(request,store); Product p;
+   try { p=productService.getBySku(body.getProduct(),store); } catch(Exception e) {
+     try { p=productVariantService.getBySku(body.getProduct(),store).map(v -> v.getProduct()).orElse(null); }
+     catch(Exception ignored) { p=null; }
+   }
+   try { java.util.Optional<com.salesmanager.core.model.catalog.product.variant.ProductVariant> variant=productVariantService.getBySku(body.getProduct(),store); if (variant.isPresent()) p=variant.get().getProduct(); } catch(Exception ignored) { }
+   if(p==null) throw new ResponseStatusException(HttpStatus.NOT_FOUND,"Unknown SKU");
+   boolean duplicate=wishlistService.find(c,body.getProduct())!=null;
+   try { CustomerWishlistItem item=wishlistService.add(c,p,body.getProduct()); return ResponseEntity.status(duplicate?HttpStatus.OK:HttpStatus.CREATED).body(read(item, body.getProduct())); }
+   catch(ServiceException e) { throw new ResponseStatusException(HttpStatus.BAD_REQUEST,e.getMessage()); }
+ }
+ @GetMapping public ReadableWishlist get(HttpServletRequest request,@ApiIgnore MerchantStore store,@ApiIgnore Language language) { Customer c=customer(request,store); ReadableWishlist out=new ReadableWishlist(); List<ReadableWishlistItem> items=new ArrayList<>(); for(CustomerWishlistItem i:wishlistService.list(c)) items.add(read(i,null)); out.setItems(items); out.setCount(items.size()); return out; }
+ @DeleteMapping("/{sku}") @ResponseStatus(HttpStatus.NO_CONTENT) public void remove(@PathVariable String sku,HttpServletRequest request,@ApiIgnore MerchantStore store) { Customer c=customer(request,store); try { wishlistService.remove(c,sku); } catch(ServiceException e) { throw new ResponseStatusException(HttpStatus.NOT_FOUND,"Wishlist item not found"); } }
+ @PostMapping("/{sku}/cart/{cartCode}") @Transactional public ResponseEntity<?> move(@PathVariable String sku,@PathVariable String cartCode,HttpServletRequest request,@ApiIgnore MerchantStore store,@ApiIgnore Language language) {
+   Customer c=customer(request,store); CustomerWishlistItem wi=wishlistService.find(c,sku); if(wi==null) throw new ResponseStatusException(HttpStatus.NOT_FOUND,"Wishlist item not found"); Product p=wi.getProduct(); if(!available(p)) throw new ResponseStatusException(HttpStatus.CONFLICT,"Product unavailable");
+   com.salesmanager.core.model.shoppingcart.ShoppingCart existing; try { existing=shoppingCartService.getByCode(cartCode,store); } catch(Exception e) { throw new ResponseStatusException(HttpStatus.NOT_FOUND,"Cart not found"); }
+   if(existing==null || existing.getCustomerId()==null || !c.getId().equals(existing.getCustomerId())) throw new ResponseStatusException(HttpStatus.NOT_FOUND,"Cart not found");
+   try { PersistableShoppingCartItem item=new PersistableShoppingCartItem(); item.setProduct(sku); item.setQuantity(1); Object cart=cartFacade.modifyCart(cartCode,item,store,language); wishlistService.remove(c,sku); return ResponseEntity.ok(cart); }
+   catch(ResponseStatusException e) { throw e; }
+   catch(Exception e) { throw new ResponseStatusException(HttpStatus.INTERNAL_SERVER_ERROR,"Unable to update cart",e); }
+   finally { /* removal is deliberately performed only after a successful cart operation below */ }
+ }
+   private boolean available(Product p) { if(!p.isAvailable()) return false; if(p.getProductVirtual()) return true; for(ProductAvailability a:p.getAvailabilities()) if(a.getProductQuantity()!=null && a.getProductQuantity()>0) return true; return false; }
+   private ReadableWishlistItem read(CustomerWishlistItem item,String requestedSku) { Product p=item.getProduct(); ReadableWishlistItem x=new ReadableWishlistItem(); x.setSku(requestedSku!=null?requestedSku:item.getSku()!=null?item.getSku():p.getSku()); x.setName(p.getProductDescription()!=null?p.getProductDescription().getName():p.getSku()); x.setAvailable(available(p)); x.setAddedAt(item.getAddedAt()); for(ProductAvailability a:p.getAvailabilities()) { if(a.defaultPrice()!=null) { x.setPrice(a.defaultPrice().getProductPriceAmount()); break; } } return x; }
+}
