+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import javax.inject.Inject;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.RestController;
+import com.salesmanager.core.business.services.customer.CustomerWishlistService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.UnauthorizedException;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Merchant-facing wishlist analytics. */
+@RestController
+@RequestMapping("/api/v1/private/wishlists")
+public class WishlistReportApi {
+    @Inject private CustomerWishlistService wishlistService;
+
+    @GetMapping("/popular")
+    public List<Map<String, Object>> popular(@RequestParam("store") String storeCode,
+            @ApiIgnore MerchantStore merchantStore) {
+        // The store resolver populates merchantStore only after authenticating
+        // the private request. Do not let a caller use the query parameter to
+        // read another merchant's report.
+        if (merchantStore == null || merchantStore.getCode() == null
+                || !merchantStore.getCode().equals(storeCode)) {
+            throw new UnauthorizedException("Not authorized for store " + storeCode);
+        }
+        List<Map<String, Object>> result = new ArrayList<>();
+        List<Object[]> rows = wishlistService.popular(merchantStore.getCode());
+        for (int i = 0; i < rows.size() && i < 10; i++) {
+            Object[] row = rows.get(i);
+            Map<String, Object> item = new LinkedHashMap<>();
+            item.put("sku", row[0]);
+            item.put("count", ((Number) row[1]).longValue());
+            result.add(item);
+        }
+        return result;
+    }
+}
