+package com.salesmanager.core.business.events;
+
+import com.salesmanager.core.model.catalog.product.Product;
+
+/** Published immediately before a product is removed from the catalogue. */
+public final class ProductDeletedEvent {
+
+    private final Long productId;
+    private final String sku;
+    private final Integer merchantStoreId;
+
+    public ProductDeletedEvent(Product product) {
+        this.productId = product == null ? null : product.getId();
+        this.sku = product == null ? null : product.getSku();
+        this.merchantStoreId = product == null || product.getMerchantStore() == null
+                ? null : product.getMerchantStore().getId();
+    }
+
+    public Long getProductId() { return productId; }
+    public String getSku() { return sku; }
+    public Integer getMerchantStoreId() { return merchantStoreId; }
+}
