+package com.salesmanager.core.business.services.customer;
+
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.dao.DataIntegrityViolationException;
+import org.springframework.stereotype.Service;
+import org.springframework.context.event.EventListener;
+import com.salesmanager.core.business.events.ProductDeletedEvent;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.customer.CustomerWishlistRepository;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.CustomerWishlistItem;
+import com.salesmanager.core.model.catalog.product.Product;
+
+@Service("customerWishlistService")
+public class CustomerWishlistServiceImpl implements CustomerWishlistService {
+    private final CustomerWishlistRepository repository;
+    @Inject public CustomerWishlistServiceImpl(CustomerWishlistRepository repository) { this.repository = repository; }
+    public List<CustomerWishlistItem> list(Customer customer) { return repository.findByCustomer(customer.getId()); }
+    public CustomerWishlistItem find(Customer customer, String sku) { return repository.findByCustomerAndSku(customer.getId(), sku); }
+    public synchronized CustomerWishlistItem add(Customer customer, Product product, String sku) throws ServiceException {
+        if (find(customer, sku) != null) return find(customer, sku);
+        if (repository.countByCustomerId(customer.getId()) >= 50) throw new ServiceException("Wishlist limit is 50 items");
+        CustomerWishlistItem item = new CustomerWishlistItem(); item.setCustomer(customer); item.setProduct(product); item.setSku(sku);
+        try { return repository.saveAndFlush(item); } catch (DataIntegrityViolationException e) { return find(customer, product.getSku()); }
+    }
+    public void remove(Customer customer, String sku) throws ServiceException { CustomerWishlistItem item=find(customer,sku); if(item==null) throw new ServiceException("Wishlist item not found"); repository.delete(item); }
+    public void remove(Product product) throws ServiceException { repository.deleteByProductId(product.getId()); }
+    public List<Object[]> popular(String storeCode) { return repository.findPopularByStore(storeCode); }
+
+    @EventListener
+    public void productDeleted(ProductDeletedEvent event) {
+        if (event.getProductId() != null) repository.deleteByProductId(event.getProductId());
+    }
+}
