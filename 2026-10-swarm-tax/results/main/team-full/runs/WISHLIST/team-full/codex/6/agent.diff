+package com.salesmanager.core.business.services.customer;
+
+import java.util.List;
+import javax.inject.Inject;
+import org.apache.commons.lang3.Validate;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.customer.WishlistRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.Wishlist;
+
+@Service("wishlistService")
+public class WishlistServiceImpl extends SalesManagerEntityServiceImpl<Long, Wishlist> implements WishlistService {
+    private final WishlistRepository wishlistRepository;
+    @Inject
+    public WishlistServiceImpl(WishlistRepository repository) { super(repository); this.wishlistRepository = repository; }
+
+    @Override @Transactional
+    public Wishlist add(Customer customer, Product product) throws ServiceException {
+        Validate.notNull(customer, "Customer cannot be null");
+        Validate.notNull(product, "Product cannot be null");
+        Wishlist existing = wishlistRepository.findByCustomerIdAndProductId(customer.getId(), product.getId());
+        if (existing != null) return existing;
+        if (wishlistRepository.countByCustomerId(customer.getId()) >= MAX_ITEMS)
+            throw new ServiceException("A wishlist cannot contain more than " + MAX_ITEMS + " products");
+        Wishlist item = new Wishlist(); item.setCustomer(customer); item.setProduct(product);
+        create(item); return item;
+    }
+    @Override @Transactional public void remove(Customer c, Product p) throws ServiceException {
+        Wishlist item = getByCustomerAndProduct(c, p); if (item != null) delete(item);
+    }
+    @Override public List<Wishlist> getByCustomer(Customer c) { return wishlistRepository.findByCustomerIdOrderByDateAddedDesc(c.getId()); }
+    @Override public Wishlist getByCustomerAndProduct(Customer c, Product p) { return wishlistRepository.findByCustomerIdAndProductId(c.getId(), p.getId()); }
+    @Override @Transactional public void deleteByProduct(Product p) throws ServiceException { wishlistRepository.deleteByProductId(p.getId()); }
+    @Override public List<Object[]> popular() { return wishlistRepository.countByProduct(); }
+}
