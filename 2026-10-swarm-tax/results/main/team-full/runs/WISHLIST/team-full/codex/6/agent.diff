+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.security.Principal;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.LinkedHashMap;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import javax.validation.Valid;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+import org.springframework.web.bind.annotation.RequestParam;
+import springfox.documentation.annotations.ApiIgnore;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.customer.WishlistService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.Wishlist;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.customer.PersistableWishlist;
+import com.salesmanager.shop.model.customer.ReadableWishlistItem;
+import com.salesmanager.shop.model.customer.ReadableWishlist;
+import com.salesmanager.shop.model.catalog.product.ReadableProduct;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.product.facade.ProductFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+import io.swagger.annotations.Api;
+
+@RestController
+@RequestMapping("/api/v1")
+@Api(tags = { "Wishlist api" })
+public class WishlistApi {
+    @Inject private WishlistService wishlistService;
+    @Inject private ProductService productService;
+    @Inject private CustomerFacade customerFacade;
+    @Inject private ProductFacade productFacade;
+    @Inject private ShoppingCartFacade shoppingCartFacade;
+
+    private Customer customer(Principal p, MerchantStore store) {
+        if (p == null) throw new ResourceNotFoundException("Authenticated customer is required");
+        Customer c = customerFacade.getCustomerByUserName(p.getName(), store);
+        if (c == null) throw new ResourceNotFoundException("Customer not found");
+        return c;
+    }
+    private ReadableWishlistItem view(Wishlist w, MerchantStore store, Language language) {
+        Product p = w.getProduct(); ReadableWishlistItem r = new ReadableWishlistItem();
+        r.setId(w.getId()); r.setProductId(p.getId()); r.setSku(p.getSku()); r.setAvailable(p.isAvailable()); r.setDateAdded(w.getDateAdded());
+        try { ReadableProduct rp = productFacade.getProduct(store, p.getSku(), language); if (rp != null) { r.setName(rp.getDescription() == null ? null : rp.getDescription().getName()); r.setPrice(rp.getFinalPrice()); } }
+        catch (Exception ignored) { /* product remains representable if pricing is unavailable */ }
+        return r;
+    }
+
+    @PostMapping("/auth/customer/wishlist")
+    public ResponseEntity<ReadableWishlistItem> add(@Valid @RequestBody PersistableWishlist request, HttpServletRequest http,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language) {
+        try {
+            Customer c = customer(http.getUserPrincipal(), store); Product p = productService.getBySku(request.getProduct(), store);
+            if (p == null) throw new ResourceNotFoundException("Product not found");
+            boolean exists = wishlistService.getByCustomerAndProduct(c,p) != null;
+            return new ResponseEntity<>(view(wishlistService.add(c, p), store, language), exists ? HttpStatus.OK : HttpStatus.CREATED);
+        } catch (ServiceException e) { throw new ServiceRuntimeException(e); }
+    }
+    @GetMapping("/auth/customer/wishlist")
+    public ReadableWishlist list(HttpServletRequest http, @ApiIgnore MerchantStore store, @ApiIgnore Language language) {
+        Customer c = customer(http.getUserPrincipal(), store);
+        return new ReadableWishlist(wishlistService.getByCustomer(c).stream().map(w -> view(w, store, language)).collect(Collectors.toList()));
+    }
+    @DeleteMapping("/auth/customer/wishlist/{sku}")
+    public ResponseEntity<Void> remove(@PathVariable String sku, HttpServletRequest http, @ApiIgnore MerchantStore store) {
+        try { Customer c = customer(http.getUserPrincipal(), store); Product p = productService.getBySku(sku, store); if (p == null) throw new ResourceNotFoundException("Product not found"); wishlistService.remove(c, p); return ResponseEntity.noContent().build(); }
+        catch (ServiceException e) { throw new ServiceRuntimeException(e); }
+    }
+
+    @PostMapping("/auth/customer/wishlist/{sku}/cart/{cartCode}")
+    public ResponseEntity<ReadableShoppingCart> moveToCart(@PathVariable String sku, @PathVariable String cartCode, @Valid @RequestBody(required = false) PersistableWishlist request,
+            HttpServletRequest http, @ApiIgnore MerchantStore store, @ApiIgnore Language language) {
+        try {
+            Customer c = customer(http.getUserPrincipal(), store); Product p = productService.getBySku(sku, store);
+            if (p == null || wishlistService.getByCustomerAndProduct(c, p) == null) throw new ResourceNotFoundException("Wishlist item not found");
+            PersistableShoppingCartItem item = new PersistableShoppingCartItem(); item.setProduct(sku); item.setQuantity(1);
+            ReadableShoppingCart cart = shoppingCartFacade.modifyCart(cartCode, item, store, language);
+            wishlistService.remove(c, p);
+            return ResponseEntity.ok(cart);
+        } catch (ResourceNotFoundException e) { throw e; }
+        catch (ServiceException e) { throw new ServiceRuntimeException(e); }
+        catch (Exception e) { throw new ServiceRuntimeException(e); }
+    }
+
+    @GetMapping("/private/wishlists/popular")
+    public List<Map<String,Object>> popular(@RequestParam String store, @ApiIgnore Language language) {
+        List<Map<String,Object>> result = new ArrayList<>();
+        for (Object[] row : wishlistService.popular()) {
+            Product p = productService.getById((Long) row[0]);
+            if (p == null || p.getMerchantStore() == null || !store.equals(p.getMerchantStore().getCode())) continue;
+            Map<String,Object> item = new LinkedHashMap<>(); item.put("sku", p.getSku()); item.put("count", ((Number)row[1]).longValue());
+            try { ReadableProduct rp = productFacade.getProduct(p.getMerchantStore(), p.getSku(), language); item.put("name", rp == null || rp.getDescription()==null ? null : rp.getDescription().getName()); item.put("price", rp == null ? null : rp.getFinalPrice()); item.put("available", p.isAvailable()); }
+            catch (Exception e) { item.put("name", null); item.put("price", null); item.put("available", p.isAvailable()); }
+            result.add(item); if (result.size() == 10) break;
+        }
+        return result;
+    }
+}
