+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal principal = request.getUserPrincipal();
+        if (principal == null) throw new ResourceNotFoundException("Authenticated customer not found");
+        Customer customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (customer == null) throw new ResourceNotFoundException("Customer not found");
+        return customer;
+    }
+
+    private Product product(String sku, MerchantStore store, Language language) throws Exception {
+        Product product = productService.getBySku(sku, store, language);
+        if (product == null) throw new ResourceNotFoundException("Product " + sku + " does not exist");
+        return product;
+    }
+
+    private ReadableWishlistItem item(Wishlist entry, Language language) { return item(entry.getProduct(), entry.getAddedAt(), language); }
+    private ReadableWishlistItem item(Product product, java.util.Date addedAt, Language language) {
+        ReadableWishlistItem dto = new ReadableWishlistItem();
+        dto.setSku(product.getSku()); dto.setAvailable(product.isAvailable()); dto.setAddedAt(addedAt);
+        if (language != null) {
+            try { dto.setName(productService.getProductDescription(product, language).getName()); } catch (Exception ignored) { }
+        }
+        ProductAvailability availability = product.getAvailabilities() == null ? null : product.getAvailabilities().stream()
+                .sorted(java.util.Comparator.comparing(a -> a.getId() == null ? Long.MAX_VALUE : a.getId())).findFirst().orElse(null);
+        if (availability != null) {
+            dto.setStock(availability.getProductQuantity());
+            if (availability.defaultPrice() != null) dto.setPrice(availability.defaultPrice().getProductPriceAmount());
+        }
+        return dto;
+    }
