+/** Customer wishlist and the read-only administrative popularity view. */
+@RestController
+@RequestMapping("/api/v1")
+public class WishlistApi {
+    @Inject private WishlistService wishlistService;
+    @Inject private ProductService productService;
+    @Inject private CustomerFacade customerFacade;
+    @Inject private ShoppingCartFacade shoppingCartFacade;
+    @Inject private UserFacade userFacade;
+
+    @PostMapping("/auth/customer/wishlist")
+    public ResponseEntity<ReadableWishlistItem> add(@org.springframework.web.bind.annotation.RequestBody PersistableWishlistItem body,
+            @ApiIgnore MerchantStore store,
+            @ApiIgnore Language language, HttpServletRequest request) throws Exception {
+        if (body == null || body.getProduct() == null || body.getProduct().trim().isEmpty()) throw new BadRequestException("product is required");
+        Customer customer = customer(request, store);
+        Product product = product(body.getProduct(), store, language);
+        boolean exists = wishlistService.getByCustomer(customer, store).stream().anyMatch(w -> w.getProduct().getId().equals(product.getId()));
+        try {
+            ReadableWishlistItem result = item(wishlistService.add(customer, product, store), language);
+            return ResponseEntity.status(exists ? HttpStatus.OK : HttpStatus.CREATED).body(result);
+        } catch (com.salesmanager.core.business.exception.ServiceException e) {
+            throw new BadRequestException(e.getMessage());
+        }
+    }
+
+    @GetMapping("/auth/customer/wishlist")
+    public ReadableWishlist list(@ApiIgnore MerchantStore store, @ApiIgnore Language language,
+            HttpServletRequest request) {
+        Customer customer = customer(request, store);
+        List<ReadableWishlistItem> result = new ArrayList<>();
+        for (Wishlist entry : wishlistService.getByCustomer(customer, store)) result.add(item(entry, language));
+        return new ReadableWishlist(result);
+    }
+
+    @DeleteMapping("/auth/customer/wishlist/{sku}")
+    @ResponseStatus(HttpStatus.NO_CONTENT)
