+            HttpServletRequest request) throws Exception {
+        Customer customer = customer(request, store); Product target = product(sku, store, language);
+        if (wishlistService.getByCustomer(customer, store).stream().noneMatch(w -> w.getProduct().getId().equals(target.getId())))
+            throw new ResourceNotFoundException("Wishlist item " + sku + " does not exist");
+        try { wishlistService.remove(customer, target, store); }
+        catch (com.salesmanager.core.business.exception.ServiceException e) { throw new BadRequestException(e.getMessage()); }
+    }
+
+    @PostMapping("/auth/customer/wishlist/{sku}/cart/{cartCode}")
