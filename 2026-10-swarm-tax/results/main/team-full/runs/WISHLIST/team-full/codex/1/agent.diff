+        Product product = product(sku, store, language);
+        if (wishlistService.getByCustomer(customer, store).stream().noneMatch(w -> w.getProduct().getId().equals(product.getId())))
+            throw new ResourceNotFoundException("Wishlist item " + sku + " does not exist");
+        ProductAvailability availability = product.getAvailabilities() == null || product.getAvailabilities().isEmpty() ? null : product.getAvailabilities().iterator().next();
+        if (!product.isAvailable() || (availability != null && (availability.getAvailable() != null && !availability.getAvailable() || availability.getProductQuantity() == null || availability.getProductQuantity() < 1)))
+            throw new ConflictException("Product is unavailable or out of stock");
+        PersistableShoppingCartItem input = new PersistableShoppingCartItem();
+        input.setProduct(sku); input.setQuantity(1);
+        com.salesmanager.core.model.shoppingcart.ShoppingCart existing = shoppingCartFacade.getShoppingCartModel(cartCode, store);
+        if (existing == null || existing.getCustomerId() == null || !existing.getCustomerId().equals(customer.getId()))
+            throw new ResourceNotFoundException("Cart " + cartCode + " does not exist");
+        ReadableShoppingCart cart = shoppingCartFacade.modifyCart(cartCode, input, store, language);
+        wishlistService.remove(customer, product, store);
+        return cart;
+    }
