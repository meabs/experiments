+package com.salesmanager.shop.model.customer;
+import javax.validation.constraints.AssertTrue;
+public class PersistableWishlistItem {
+    private String sku; private Long productId; private String product;
+    public String getSku(){return sku;} public void setSku(String sku){this.sku=sku;}
+    public Long getProductId(){return productId;} public void setProductId(Long productId){this.productId=productId;}
+    public String getProduct(){return product;} public void setProduct(String product){this.product=product; if(this.sku==null)this.sku=product;}
+    @AssertTrue(message="sku or productId is required") public boolean isProductSpecified(){return (sku!=null&&!sku.trim().isEmpty())||productId!=null;}
+}
