+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.security.Principal;
+import java.util.List;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import javax.validation.Valid;
+import org.springframework.http.*;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.price.ProductPriceService;
+import com.salesmanager.core.business.services.shoppingcart.ShoppingCartService;
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.business.services.customer.WishlistService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.WishlistItem;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.customer.*;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.core.model.reference.language.Language;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/auth/customer/wishlist")
+public class CustomerWishlistApi {
+    private static final int MAX_ITEMS=50;
+    @Inject private WishlistService wishlistService;
+    @Inject private CustomerService customerService;
+    @Inject private ProductService productService;
+    @Inject private ProductPriceService productPriceService;
+    @Inject private ShoppingCartService shoppingCartService;
+    @Inject private ShoppingCartFacade shoppingCartFacade;
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal p=request.getUserPrincipal();
+        if(p==null) throw new org.springframework.security.access.AccessDeniedException("Authentication required");
+        Customer c=customerService.getByNick(p.getName());
+        if(c==null || c.getMerchantStore()==null || store==null || !store.getId().equals(c.getMerchantStore().getId())) throw new ResourceNotFoundException("Customer not found");
+        return c;
+    }
+    private Product product(PersistableWishlistItem in, MerchantStore store) {
+        try {
+            Product p=in.getProductId()!=null ? productService.retrieveById(in.getProductId(),store).orElse(null) : productService.getBySku(in.getSku(),store);
+            if(p==null) throw new ResourceNotFoundException("Product not found"); return p;
+        } catch(Exception e) { if(e instanceof ResourceNotFoundException) throw (ResourceNotFoundException)e; throw new ResourceNotFoundException("Product not found"); }
+    }
+    private ReadableWishlistItem dto(WishlistItem i){ReadableWishlistItem d=new ReadableWishlistItem(i.getId(),i.getProduct().getId(),i.getProduct().getSku(),i.getCreatedAt()); if(i.getProduct().getDescriptions()!=null&&!i.getProduct().getDescriptions().isEmpty()) d.setName(i.getProduct().getDescriptions().iterator().next().getName()); d.setAvailable(i.getProduct().isAvailable()); try { if(i.getProduct().getMerchantStore()!=null&&!productPriceService.findByProductSku(i.getProduct().getSku(),i.getProduct().getMerchantStore()).isEmpty()) d.setPrice(productPriceService.findByProductSku(i.getProduct().getSku(),i.getProduct().getMerchantStore()).get(0).getProductPriceAmount()); } catch(Exception ignored) {} return d;}
+    @GetMapping public java.util.Map<String,Object> list(HttpServletRequest req,@ApiIgnore MerchantStore store){List<ReadableWishlistItem> items=wishlistService.list(customer(req,store)).stream().map(this::dto).collect(Collectors.toList()); java.util.Map<String,Object> out=new java.util.LinkedHashMap<>(); out.put("count",items.size()); out.put("items",items); return out;}
+    @PostMapping public ResponseEntity<ReadableWishlistItem> add(@Valid @RequestBody PersistableWishlistItem in,HttpServletRequest req,@ApiIgnore MerchantStore store){Customer c=customer(req,store); Product p=product(in,store); WishlistItem old=wishlistService.find(c,p); if(old!=null)return ResponseEntity.ok(dto(old)); if(wishlistService.count(c)>=MAX_ITEMS)return ResponseEntity.badRequest().build(); return ResponseEntity.status(HttpStatus.CREATED).body(dto(wishlistService.add(c,p)));}
+    @DeleteMapping("/{sku}") public ResponseEntity<Void> remove(@PathVariable String sku,HttpServletRequest req,@ApiIgnore MerchantStore store){PersistableWishlistItem in=new PersistableWishlistItem();in.setSku(sku);wishlistService.remove(customer(req,store),product(in,store)); return ResponseEntity.noContent().build();}
+    @PostMapping("/{sku}/cart/{cartCode}") public ResponseEntity<?> move(@PathVariable String sku,@PathVariable String cartCode,HttpServletRequest req,@ApiIgnore MerchantStore store,@ApiIgnore Language language){Customer c=customer(req,store);PersistableWishlistItem in=new PersistableWishlistItem();in.setSku(sku);Product p=product(in,store); WishlistItem i=wishlistService.find(c,p); if(i==null)return ResponseEntity.notFound().build(); try {com.salesmanager.core.model.shoppingcart.ShoppingCart owned=shoppingCartService.getShoppingCart(c,store); if(owned==null||!cartCode.equals(owned.getShoppingCartCode()))return ResponseEntity.notFound().build(); PersistableShoppingCartItem cartItem=new PersistableShoppingCartItem();cartItem.setProduct(p.getSku());cartItem.setQuantity(1); ReadableShoppingCart cart=shoppingCartFacade.modifyCart(cartCode,cartItem,store,language); wishlistService.remove(c,p); return ResponseEntity.ok(cart);} catch(Exception e){return ResponseEntity.status(HttpStatus.CONFLICT).build();}}
+}
