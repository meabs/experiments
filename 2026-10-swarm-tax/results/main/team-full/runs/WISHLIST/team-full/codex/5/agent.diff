+package com.salesmanager.core.business.services.customer;
+import java.util.List;
+import java.util.ArrayList;
+import java.util.Map;
+import java.util.LinkedHashMap;
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+import org.springframework.data.domain.PageRequest;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.customer.WishlistRepository;
+import com.salesmanager.core.model.customer.*;
+import com.salesmanager.core.model.catalog.product.Product;
+@Service("wishlistService") @Transactional
+public class WishlistServiceImpl implements WishlistService {
+    private final WishlistRepository repository;
+    @Inject public WishlistServiceImpl(WishlistRepository repository) { this.repository = repository; }
+    public List<WishlistItem> list(Customer c) { return repository.findByCustomerIdOrderByCreatedAtDesc(c.getId()); }
+    public WishlistItem find(Customer c, Product p) { return repository.findByCustomerIdAndProductId(c.getId(), p.getId()); }
+    public WishlistItem add(Customer c, Product p) { WishlistItem old=find(c,p); if(old!=null)return old; WishlistItem i=new WishlistItem(); i.setCustomer(c); i.setProduct(p); return repository.save(i); }
+    public void remove(Customer c, Product p) { repository.deleteByCustomerIdAndProductId(c.getId(), p.getId()); }
+    public void removeProduct(Product p) { repository.deleteByProductId(p.getId()); }
+    public long count(Customer c) { return repository.countByCustomerId(c.getId()); }
+    public List<Map<String, Object>> popular(String storeCode) {
+        List<Object[]> rows = repository.findPopularByStore(storeCode, PageRequest.of(0, 10));
+        List<Map<String, Object>> result = new ArrayList<Map<String, Object>>(rows.size());
+        for (Object[] row : rows) {
+            Map<String, Object> item = new LinkedHashMap<String, Object>();
+            item.put("sku", row[0]);
+            item.put("count", ((Number) row[1]).longValue());
+            result.add(item);
+        }
+        return result;
+    }
+}
