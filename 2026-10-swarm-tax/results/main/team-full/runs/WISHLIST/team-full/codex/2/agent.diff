+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.security.Principal;
+import java.util.List;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.*;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.price.ProductPriceService;
+import org.springframework.dao.DataIntegrityViolationException;
+import com.salesmanager.core.business.services.customer.WishlistService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.WishlistItem;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.customer.ReadableWishlistItem;
+import com.salesmanager.shop.model.customer.ReadableWishlist;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.store.api.exception.*;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/auth/customer/wishlist")
+public class WishlistApi {
+ @Inject private WishlistService wishlistService;
+ @Inject private ProductService productService;
+ @Inject private ProductPriceService productPriceService;
+ @Inject private CustomerFacade customerFacade;
+ @Inject private ShoppingCartFacade shoppingCartFacade;
+ private Customer customer(HttpServletRequest request, MerchantStore store){
+  Principal p=request.getUserPrincipal(); if(p==null) throw new UnauthorizedException();
+  Customer c=customerFacade.getCustomerByUserName(p.getName(),store); if(c==null) throw new UnauthorizedException(); return c;
+ }
+ private Product product(String sku, MerchantStore store){
+  try { Product p=productService.getBySku(sku,store); if(p==null) throw new ResourceNotFoundException("SKU ["+sku+"] not found"); return p; }
+  catch(ResourceNotFoundException e){throw e;} catch(Exception e){throw new ResourceNotFoundException("SKU ["+sku+"] not found");}
+ }
+ @PostMapping
+ public ResponseEntity<ReadableWishlist> add(@RequestBody(required=false) PersistableWishlistItem body,@ApiIgnore MerchantStore store,HttpServletRequest request){
+  Customer c=customer(request,store); if(body==null || body.getSku()==null || body.getSku().trim().isEmpty()) throw new org.springframework.web.server.ResponseStatusException(HttpStatus.BAD_REQUEST,"sku is required");
+  Product p=product(body.getSku(),store); boolean duplicate=wishlistService.list(c,store).stream().anyMatch(i->i.getProduct().getId().equals(p.getId()));
+  try{wishlistService.add(c,store,p);}catch(DataIntegrityViolationException race){ /* unique key winner */ }
+  catch(IllegalStateException e){throw new WishlistConflictException(e.getMessage());}
+  return ResponseEntity.status(duplicate?HttpStatus.OK:HttpStatus.CREATED).body(new ReadableWishlist(wishlistService.list(c,store).stream().map(this::dto).collect(Collectors.toList())));
+ }
+ @GetMapping public ReadableWishlist list(@ApiIgnore MerchantStore store,HttpServletRequest request){
+  return new ReadableWishlist(wishlistService.list(customer(request,store),store).stream().map(this::dto).collect(Collectors.toList()));
+ }
+ @DeleteMapping("/{sku}") @ResponseStatus(HttpStatus.NO_CONTENT)
+ public void remove(@PathVariable String sku,@ApiIgnore MerchantStore store,HttpServletRequest request){wishlistService.remove(customer(request,store),store,product(sku,store));}
+ @PostMapping("/{sku}/cart/{cartCode}")
+ public ReadableShoppingCart move(@PathVariable String sku,@PathVariable String cartCode,@ApiIgnore MerchantStore store,@ApiIgnore Language language,HttpServletRequest request){
+  Customer c=customer(request,store); Product p=product(sku,store);
+  if(wishlistService.list(c,store).stream().noneMatch(i->i.getProduct().getId().equals(p.getId()))) throw new ResourceNotFoundException("SKU is not in wishlist");
+  if(!p.isAvailable() || p.getAvailabilities()==null || p.getAvailabilities().stream().allMatch(a->a.getProductQuantity()==null || a.getProductQuantity()<=0)) throw new WishlistConflictException("Product is unavailable or out of stock");
+  PersistableShoppingCartItem item=new PersistableShoppingCartItem(); item.setProduct(sku); item.setQuantity(1);
+  try { ReadableShoppingCart result=shoppingCartFacade.modifyCart(cartCode,item,store,language); wishlistService.remove(c,store,p); return result; }
+  catch(WishlistConflictException e){throw e;} catch(Exception e){String m=String.valueOf(e.getMessage()).toLowerCase(); if(m.contains("stock")||m.contains("quantity")||m.contains("available")) throw new WishlistConflictException("Product is unavailable or out of stock"); throw new ServiceRuntimeException(e);}
+ }
+ private ReadableWishlistItem dto(WishlistItem i){Product p=i.getProduct();String name=p.getProductDescription()==null?null:p.getProductDescription().getName(); Object price=null; try { java.util.List<com.salesmanager.core.model.catalog.product.price.ProductPrice> ps=productPriceService.findByProductSku(p.getSku(),p.getMerchantStore()); if(ps!=null&&!ps.isEmpty()) price=ps.get(0).getProductPriceAmount(); } catch(Exception ignored) {} if(price==null) price=java.math.BigDecimal.ZERO; return new ReadableWishlistItem(p.getSku(),name,price,p.isAvailable(),i.getAddedAt());}
+ public static class PersistableWishlistItem { private String sku; public String getSku(){return sku;} public void setSku(String s){sku=s;} }
+}
