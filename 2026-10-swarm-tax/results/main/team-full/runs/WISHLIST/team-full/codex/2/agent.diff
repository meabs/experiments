+import com.salesmanager.core.model.customer.WishlistItem;
+public interface WishlistRepository extends JpaRepository<WishlistItem,Long> {
+
+	/** Product popularity for a store, counting each customer at most once. */
+	@Query("select wi.product.sku, count(distinct wi.customer.id) "
+			+ "from WishlistItem wi where wi.merchantStore.id = ?1 "
+			+ "group by wi.product.sku order by count(distinct wi.customer.id) desc, wi.product.sku asc")
+	List<Object[]> findPopularByMerchantStoreId(Integer storeId);
+ List<WishlistItem> findByCustomerIdAndMerchantStoreIdOrderByAddedAtDesc(Long customerId, Integer storeId);
+ WishlistItem findByCustomerIdAndMerchantStoreIdAndProductId(Long customerId, Integer storeId, Long productId);
+ void deleteByCustomerIdAndMerchantStoreIdAndProductId(Long customerId, Integer storeId, Long productId);
+ long countByCustomerIdAndMerchantStoreId(Long customerId, Integer storeId);
+ void deleteByProductId(Long productId);
+}
