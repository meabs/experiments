+package com.salesmanager.core.business.services.customer;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.customer.WishlistRepository;
+import com.salesmanager.core.model.customer.*;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("wishlistService")
+public class WishlistServiceImpl implements WishlistService {
+ @Inject private WishlistRepository repository;
+ @Transactional(readOnly=true) public List<WishlistItem> list(Customer c, MerchantStore s){return repository.findByCustomerIdAndMerchantStoreIdOrderByAddedAtDesc(c.getId(),s.getId());}
+ @Transactional(readOnly=true) public List<Object[]> popular(MerchantStore s){return repository.findPopularByMerchantStoreId(s.getId());}
+ @Transactional public WishlistItem add(Customer c, MerchantStore s, Product p){
+  WishlistItem existing=repository.findByCustomerIdAndMerchantStoreIdAndProductId(c.getId(),s.getId(),p.getId());
+  if(existing!=null)return existing;
+  if(repository.countByCustomerIdAndMerchantStoreId(c.getId(),s.getId())>=50) throw new IllegalStateException("Wishlist limit is 50");
+  WishlistItem i=new WishlistItem(); i.setCustomer(c);i.setMerchantStore(s);i.setProduct(p);return repository.saveAndFlush(i);
+ }
+ @Transactional public void remove(Customer c, MerchantStore s, Product p){repository.deleteByCustomerIdAndMerchantStoreIdAndProductId(c.getId(),s.getId(),p.getId());}
+ @Transactional public void removeProduct(Product p){repository.deleteByProductId(p.getId());}
+}
