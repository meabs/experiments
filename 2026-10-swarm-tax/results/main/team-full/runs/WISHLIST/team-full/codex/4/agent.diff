+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import javax.inject.Inject;
+
+import org.springframework.http.MediaType;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.customer.WishlistService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Store administration reporting for customer wishlists. */
+@RestController
+@RequestMapping("/api/v1")
+public class WishlistAdminApi {
+
+    @Inject
+    private WishlistService wishlistService;
+
+    /** Returns the ten most-wishlisted SKUs for the current store. */
+    @GetMapping(value = "/private/wishlists/popular", produces = MediaType.APPLICATION_JSON_VALUE)
+    @ApiImplicitParams({
+        @ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT")
+    })
+    public List<Map<String, Object>> popular(@ApiIgnore MerchantStore merchantStore) throws ServiceException {
+        List<Map<String, Object>> result = new ArrayList<>();
+        for (Object[] row : wishlistService.popular(merchantStore)) {
+            Map<String, Object> item = new LinkedHashMap<>();
+            item.put("sku", row[0]);
+            item.put("count", ((Number) row[1]).longValue());
+            result.add(item);
+        }
+        return result;
+    }
+}
