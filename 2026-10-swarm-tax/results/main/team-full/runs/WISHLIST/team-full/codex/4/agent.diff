+package com.salesmanager.shop.store.api.v1.customer;
+import java.security.Principal; import java.util.*; import javax.inject.Inject; import javax.servlet.http.HttpServletRequest; import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.services.catalog.inventory.ProductInventoryService; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.customer.*; import com.salesmanager.core.business.services.shoppingcart.ShoppingCartService; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.inventory.ProductInventory; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.customer.WishlistEntry; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.reference.language.Language; import com.salesmanager.core.model.shoppingcart.*; import com.salesmanager.shop.model.customer.WishlistItem; import com.salesmanager.shop.model.customer.WishlistRequest; import com.salesmanager.shop.model.customer.WishlistResponse; import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart; import com.salesmanager.shop.store.api.exception.*; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/auth/customer/wishlist") public class CustomerWishlistApi {
+ @Inject private WishlistService wishlist; @Inject private CustomerService customers; @Inject private ProductService products; @Inject private ProductInventoryService inventory; @Inject private ShoppingCartService carts; @Inject private com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade cartFacade;
+ private Customer customer(HttpServletRequest r,MerchantStore s){Principal p=r.getUserPrincipal();if(p==null)throw new UnauthorizedException();try{Customer c=customers.getByNick(p.getName(),s.getCode());if(c==null)throw new UnauthorizedException();return c;}catch(UnauthorizedException e){throw e;}catch(Exception e){throw new UnauthorizedException();}}
+ @GetMapping public WishlistResponse get(@ApiIgnore MerchantStore s,@ApiIgnore Language l,HttpServletRequest r){Customer c=customer(r,s);WishlistResponse o=new WishlistResponse();try{for(WishlistEntry e:wishlist.get(c.getId(),s)){Product p=products.getBySku(e.getSku(),s,l);if(p==null)continue;WishlistItem i=new WishlistItem();i.setSku(e.getSku());i.setName(p.getProductDescription()==null?null:p.getProductDescription().getName());ProductInventory v=inventory.inventory(p);i.setPrice(v==null||v.getPrice()==null?null:v.getPrice().getFinalPrice());i.setAvailable(p.isAvailable()&&v!=null&&v.getQuantity()>0);i.setAddedAt(e.getAddedAt());o.getItems().add(i);}o.setCount(o.getItems().size());return o;}catch(Exception e){throw new ServiceRuntimeException(e.getMessage(),e);}}
+ @PostMapping public ResponseEntity<WishlistResponse> add(@RequestBody WishlistRequest b,@ApiIgnore MerchantStore s,@ApiIgnore Language l,HttpServletRequest r){Customer c=customer(r,s);if(b==null||b.getProduct()==null||b.getProduct().trim().isEmpty())throw new ServiceRuntimeException("product is required");try{if(products.getBySku(b.getProduct(),s,l)==null)throw new ResourceNotFoundException("Unknown sku");WishlistEntry old=wishlist.find(c.getId(),b.getProduct(),s);wishlist.add(c.getId(),b.getProduct(),s);return new ResponseEntity<>(get(s,l,r),old==null?HttpStatus.CREATED:HttpStatus.OK);}catch(ResourceNotFoundException e){throw e;}catch(Exception e){throw new ServiceRuntimeException(e.getMessage(),e);}}
+ @DeleteMapping("/{sku}") public ResponseEntity<Void> remove(@PathVariable String sku,@ApiIgnore MerchantStore s,HttpServletRequest r){Customer c=customer(r,s);try{wishlist.remove(c.getId(),sku,s);return ResponseEntity.noContent().build();}catch(IllegalStateException e){throw new ResourceNotFoundException("Wishlist entry not found");}}
+ @Transactional @PostMapping("/{sku}/cart/{cartCode}") public ResponseEntity<ReadableShoppingCart> move(@PathVariable String sku,@PathVariable String cartCode,@ApiIgnore MerchantStore s,@ApiIgnore Language l,HttpServletRequest r){Customer c=customer(r,s);try{if(wishlist.find(c.getId(),sku,s)==null)throw new ResourceNotFoundException("Wishlist entry not found");Product p=products.getBySku(sku,s,l);if(p==null)throw new ResourceNotFoundException("Unknown sku");ProductInventory v=inventory.inventory(p);if(!p.isAvailable()||v==null||v.getQuantity()<=0)throw new ConflictException("Product unavailable");ShoppingCart cart=carts.getByCode(cartCode,s);if(cart==null||cart.getCustomerId()==null||!c.getId().equals(cart.getCustomerId()))throw new ResourceNotFoundException("Cart not found");ShoppingCartItem found=null;for(ShoppingCartItem i:cart.getLineItems())if(sku.equals(i.getSku()))found=i;if(found==null){found=carts.populateShoppingCartItem(p,s);found.setShoppingCart(cart);cart.getLineItems().add(found);}else found.setQuantity(found.getQuantity()+1);carts.saveOrUpdate(cart);wishlist.remove(c.getId(),sku,s);return ResponseEntity.ok(cartFacade.readableCart(cart,s,l));}catch(ResourceNotFoundException|ConflictException e){throw e;}catch(com.salesmanager.core.business.exception.ServiceException e){throw new ServiceRuntimeException(e.getMessage(),e);}}
+}
