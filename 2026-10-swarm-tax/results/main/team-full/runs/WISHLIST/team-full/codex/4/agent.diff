+package com.salesmanager.core.business.services.customer;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.customer.WishlistRepository;
+import com.salesmanager.core.model.customer.WishlistEntry;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import org.springframework.data.domain.Pageable;
+@Service("wishlistService")
+public class WishlistServiceImpl implements WishlistService {
+ @Inject private WishlistRepository repository;
+ public List<WishlistEntry> get(Long id, MerchantStore s){return repository.findByCustomerAndStore(id,s.getId());}
+ public WishlistEntry find(Long id,String sku,MerchantStore s){return repository.findByCustomerIdAndMerchantStore_IdAndSku(id,s.getId(),sku);}
+ @Transactional public WishlistEntry add(Long id,String sku,MerchantStore s) { WishlistEntry w=find(id,sku,s); if(w!=null)return w; if(repository.countByCustomerIdAndMerchantStore_Id(id,s.getId())>=50) throw new IllegalStateException("Wishlist limit exceeded"); w=new WishlistEntry();w.setCustomerId(id);w.setMerchantStore(s);w.setSku(sku);w.setAddedAt(new Date());return repository.save(w); }
+ @Transactional public void remove(Long id,String sku,MerchantStore s) { WishlistEntry w=find(id,sku,s);if(w==null)throw new IllegalStateException("Wishlist entry not found");repository.delete(w); }
+ @Transactional public void purge(String sku,MerchantStore s) {repository.deleteBySkuAndStore(sku,s.getId());}
+ public List<Object[]> popular(MerchantStore s) { List<Object[]> all=repository.findPopularByStore(s.getId()); return all.size() <= 10 ? all : all.subList(0, 10); }
+}
