+package com.salesmanager.core.business.services.catalog.product.stockalert;
+import java.util.*;
+import java.util.regex.Pattern;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.beans.factory.annotation.Autowired;
+import com.salesmanager.core.business.repositories.catalog.product.stockalert.*;
+import com.salesmanager.core.model.catalog.product.stockalert.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service
+public class StockAlertService {
+ private static final Pattern EMAIL=Pattern.compile("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$");
+ @Autowired private StockAlertRepository alerts; @Autowired private StockAlertOutboxRepository outbox;
+ @Transactional public StockAlert subscribe(MerchantStore store,String sku,String email){
+  if(store==null||sku==null||sku.trim().isEmpty()||email==null||!EMAIL.matcher(email.trim()).matches()) throw new IllegalArgumentException("A valid email and sku are required");
+  String normalized=email.trim().toLowerCase(Locale.ROOT), key=sku.trim();
+  Optional<StockAlert> old=alerts.findByMerchantStoreIdAndSkuIgnoreCaseAndEmailIgnoreCase(store.getId(),key,normalized);
+  if(old.isPresent()){ StockAlert a=old.get(); if(a.getStatus()==StockAlertStatus.ACTIVE){return a;} a.setStatus(StockAlertStatus.ACTIVE);a.setCancelledAt(null);a.setNotifiedAt(null); return alerts.save(a); }
+  StockAlert a=new StockAlert(); a.setMerchantStore(store);a.setSku(key);a.setEmail(normalized);return alerts.save(a);
+ }
+ @Transactional public boolean cancel(MerchantStore store,Long id){ return cancel(store,null,id); }
+ @Transactional public boolean cancel(MerchantStore store,String sku,Long id){ Optional<StockAlert> o=alerts.findById(id); if(!o.isPresent()||!o.get().getMerchantStore().getId().equals(store.getId())||(sku!=null&&!o.get().getSku().equalsIgnoreCase(sku))) return false; StockAlert a=o.get();a.setStatus(StockAlertStatus.CANCELLED);a.setCancelledAt(new Date());alerts.save(a);return true; }
+ @Transactional public boolean cancel(MerchantStore store,String sku,String email){ Optional<StockAlert> o=alerts.findByMerchantStoreIdAndSkuIgnoreCaseAndEmailIgnoreCase(store.getId(),sku,email); if(!o.isPresent()) return false; StockAlert a=o.get(); a.setStatus(StockAlertStatus.CANCELLED); a.setCancelledAt(new Date()); alerts.save(a); return true; }
+ public List<StockAlert> list(MerchantStore s,String status){ StockAlertStatus st=status==null?StockAlertStatus.ACTIVE:StockAlertStatus.valueOf(status.toUpperCase(Locale.ROOT)); return alerts.findByMerchantStoreIdAndStatus(s.getId(),st); }
+ @Transactional public int restocked(MerchantStore store,String sku){ List<StockAlert> all=alerts.findByMerchantStoreIdAndSkuIgnoreCaseAndStatus(store.getId(),sku,StockAlertStatus.ACTIVE); for(StockAlert a:all){StockAlertOutbox o=new StockAlertOutbox();o.setMerchantStore(store);o.setSku(a.getSku());o.setEmail(a.getEmail());outbox.save(o);a.setStatus(StockAlertStatus.NOTIFIED);a.setNotifiedAt(new Date());alerts.save(a);} return all.size(); }
+ public List<StockAlertOutbox> outbox(MerchantStore s,String status){ StockAlertOutbox.OutboxStatus st=status==null?StockAlertOutbox.OutboxStatus.PENDING:StockAlertOutbox.OutboxStatus.valueOf(status.toUpperCase(Locale.ROOT)); return outbox.findByMerchantStoreIdAndStatus(s.getId(),st); }
+ @Transactional public StockAlertOutbox markSent(MerchantStore s,Long id){ StockAlertOutbox o=outbox.findById(id).orElseThrow(()->new NoSuchElementException("outbox"));if(!o.getMerchantStore().getId().equals(s.getId())) throw new NoSuchElementException("outbox");o.setStatus(StockAlertOutbox.OutboxStatus.SENT);o.setSentAt(new Date());return outbox.save(o); }
+ @Transactional public void deleteForProduct(MerchantStore s,String sku){alerts.deleteByMerchantStoreIdAndSkuIgnoreCase(s.getId(),sku);outbox.deleteByMerchantStoreIdAndSkuIgnoreCase(s.getId(),sku);}
+}
