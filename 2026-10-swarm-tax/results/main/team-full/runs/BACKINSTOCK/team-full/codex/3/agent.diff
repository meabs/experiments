+package com.salesmanager.core.business.services.catalog.product.stock;
+
+import java.util.*;
+import java.util.regex.Pattern;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import javax.inject.Inject;
+import com.salesmanager.core.business.repositories.catalog.product.stock.*;
+import com.salesmanager.core.model.catalog.product.stock.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+ private static final Pattern EMAIL=Pattern.compile("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$");
+ @Inject StockAlertRepository alerts; @Inject StockAlertOutboxRepository outbox;
+ private void valid(String sku,String email){if(sku==null||sku.trim().isEmpty()) throw new IllegalArgumentException("sku is required"); if(email==null||!EMAIL.matcher(email.trim()).matches()) throw new IllegalArgumentException("invalid email");}
+ @Transactional public StockAlert subscribe(String sku,String email,MerchantStore store){valid(sku,email); if(store==null) throw new IllegalArgumentException("store is required"); sku=sku.trim(); email=email.trim().toLowerCase(Locale.ROOT); Optional<StockAlert> old=alerts.findByMerchantStoreIdAndSkuIgnoreCaseAndEmailIgnoreCaseAndStatus(store.getId(),sku,email,StockAlertStatus.PENDING); if(old.isPresent()) return old.get(); StockAlert a=new StockAlert();a.setSku(sku);a.setEmail(email);a.setMerchantStore(store);return alerts.save(a);}
+ @Transactional public boolean cancel(String sku,String email,MerchantStore store){valid(sku,email); List<StockAlert> all=alerts.findByMerchantStoreIdAndSkuIgnoreCaseAndStatus(store.getId(),sku,StockAlertStatus.PENDING); boolean found=false; for(StockAlert a:all) if(a.getEmail().equalsIgnoreCase(email.trim())){a.setStatus(StockAlertStatus.CANCELLED);alerts.save(a);found=true;} return found;}
+ @Transactional public void markRestocked(String sku,MerchantStore store,String productName){if(store==null||sku==null)return; List<StockAlert> all=alerts.findByMerchantStoreIdAndSkuIgnoreCaseAndStatusOrderByCreatedAtAsc(store.getId(),sku,StockAlertStatus.PENDING); for(StockAlert a:all){a.setStatus(StockAlertStatus.SENT);a.setSentAt(new Date());alerts.save(a);StockAlertOutbox o=new StockAlertOutbox();o.setAlertId(a.getId());o.setSku(a.getSku());o.setEmail(a.getEmail());o.setMerchantStore(store);o.setSubject("Back in stock: "+(productName==null?sku:productName));outbox.save(o);}}
+ public List<StockAlert> alerts(MerchantStore s,StockAlertStatus st){return st==null?alerts.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(s.getId(),StockAlertStatus.PENDING):alerts.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(s.getId(),st);}
+ public List<StockAlertOutbox> outbox(MerchantStore s,StockAlertOutboxStatus st){return outbox.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(s.getId(),st==null?StockAlertOutboxStatus.PENDING:st);}
+ @Transactional public void deleteForProduct(String sku,MerchantStore store){alerts.deleteByMerchantStoreIdAndSkuIgnoreCase(store.getId(),sku);outbox.deleteByMerchantStoreIdAndSkuIgnoreCase(store.getId(),sku);}
+}
