+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.http.*;
+import org.springframework.web.bind.annotation.*;
+import springfox.documentation.annotations.ApiIgnore;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.stock.StockAlertService;
+import com.salesmanager.core.business.services.catalog.product.availability.ProductAvailabilityService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.stock.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+@RestController
+@RequestMapping("/api/v1")
+public class StockAlertApi {
+ @Inject StockAlertService service; @Inject ProductService products; @Inject ProductAvailabilityService availability;
+ @PostMapping("/products/{sku}/alerts")
+ public ResponseEntity<Map<String,Object>> subscribe(@PathVariable String sku,@RequestParam String email,@ApiIgnore MerchantStore store){
+   if(store==null) throw new RestApiException("store is required"); Product p;
+   try { p=products.getBySku(sku,store); } catch(Exception e){throw new ResourceNotFoundException("Product not found");}
+   if(p==null) throw new ResourceNotFoundException("Product not found");
+   // Catalog availability is not inventory.  A product may be marked available while
+   // its store-specific quantity is zero (and vice versa); use the persisted
+   // availability rows, including the variant row when SKU identifies a variant.
+   boolean inStock = false;
+   try {
+     List<ProductAvailability> rows = availability.getBySku(sku, store);
+     for (ProductAvailability row : rows) {
+       if ((row.getAvailable() == null || Boolean.TRUE.equals(row.getAvailable())) && row.getProductStatus()
+           && row.getProductQuantity() != null && row.getProductQuantity() > 0) {
+         inStock = true;
+         break;
+       }
+     }
+   } catch (RuntimeException ignored) {
+     // Product existence has already been established; an unavailable inventory
+     // lookup is treated as out of stock so customers can register an alert.
+   }
+   if(inStock){Map<String,Object> e=new HashMap<>();e.put("error","product is in stock");return ResponseEntity.status(HttpStatus.CONFLICT).body(e);}
+   StockAlert a; try {a=service.subscribe(sku,email,store);} catch(IllegalArgumentException e){throw new RestApiException("400",e.getMessage());}
+   Map<String,Object> body=new LinkedHashMap<>();body.put("id",a.getId());body.put("sku",a.getSku());body.put("email",a.getEmail());body.put("status",a.getStatus());body.put("createdAt",a.getCreatedAt()); return ResponseEntity.status(HttpStatus.CREATED).body(body);
+ }
+ @DeleteMapping("/products/{sku}/alerts")
+ public ResponseEntity<Void> cancel(@PathVariable String sku,@RequestParam String email,@ApiIgnore MerchantStore store){
+   if(store==null) throw new RestApiException("store is required"); try {if(!service.cancel(sku,email,store)) return ResponseEntity.notFound().build();}catch(IllegalArgumentException e){throw new RestApiException("400",e.getMessage());} return ResponseEntity.noContent().build();
+ }
+ @GetMapping("/private/stock-alerts")
+ public List<StockAlert> alerts(@ApiIgnore MerchantStore store,@RequestParam(required=false) StockAlertStatus status){if(store==null)throw new RestApiException("store is required");return service.alerts(store,status);}
+ @GetMapping("/private/stock-alerts/outbox")
+ public List<StockAlertOutbox> outbox(@ApiIgnore MerchantStore store,@RequestParam(required=false) StockAlertOutboxStatus status){if(store==null)throw new RestApiException("store is required");return service.outbox(store,status);}
+}
