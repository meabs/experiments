+ @GetMapping("/private/stock-alerts") public List<ReadableStockAlert> alerts(@RequestParam(required=false) String status,@ApiIgnore MerchantStore s){if(status!=null&&!status.matches("PENDING|SENT"))throw new RestApiException("400","Invalid status");List<ReadableStockAlert> r=new ArrayList<>();for(StockAlert a:service.list(s))if(status==null||status.equals(a.getStatus()))r.add(map(a));r.sort(Comparator.comparing(ReadableStockAlert::getCreatedAt));return r;}
+ @GetMapping("/private/stock-alerts/outbox") public List<ReadableStockAlertOutbox> outbox(@ApiIgnore MerchantStore s){List<ReadableStockAlertOutbox> r=new ArrayList<>();for(StockAlertOutbox o:service.outbox(s)){ReadableStockAlertOutbox x=new ReadableStockAlertOutbox();x.setId(o.getId());x.setTo(o.getTo());x.setSku(o.getSku());x.setSubject(o.getSubject());x.setStatus(o.getStatus());x.setStore(o.getStore());x.setCreatedAt(o.getCreatedAt());r.add(x);}r.sort(Comparator.comparing(ReadableStockAlertOutbox::getCreatedAt));return r;}
+ private ReadableStockAlert map(StockAlert a){ReadableStockAlert r=new ReadableStockAlert();r.setId(a.getId());r.setSku(a.getSku());r.setEmail(a.getEmail());r.setStatus(a.getStatus());r.setCreatedAt(a.getCreatedAt());r.setSentAt(a.getSentAt());return r;}
+}
