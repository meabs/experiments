+package com.salesmanager.core.business.services.catalog.alert;
+import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.catalog.alert.*; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.model.catalog.alert.*; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.availability.ProductAvailability; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+ @Inject StockAlertRepository alerts; @Inject StockAlertOutboxRepository outbox; @Inject ProductService products;
+ @Transactional public StockAlert subscribe(String sku,String email,MerchantStore store) {
+  if(email==null||!email.matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$")) throw new IllegalArgumentException("Invalid email");
+  Product p; try { p=products.getBySku(sku,store); } catch(Exception e) { throw new IllegalArgumentException("Product not found",e); } if(p==null) throw new IllegalArgumentException("Product not found");
+  if (p.getMerchantStore()==null || !store.getId().equals(p.getMerchantStore().getId())) throw new IllegalArgumentException("Product not found");
+  boolean inStock=p.getAvailabilities()!=null && p.getAvailabilities().stream().anyMatch(a->a.getMerchantStore()!=null && store.getId().equals(a.getMerchantStore().getId()) && a.getProductQuantity()!=null&&a.getProductQuantity()>0);
+  if(inStock) throw new IllegalStateException("Product is in stock");
+  String normalized=email.trim().toLowerCase(Locale.ROOT); StockAlert found=alerts.findByMerchantStoreIdAndSkuAndEmailIgnoreCase(store.getId(),sku,normalized); if(found!=null)return found;
+  StockAlert a=new StockAlert();a.setMerchantStore(store);a.setProduct(p);a.setSku(sku);a.setEmail(normalized);return alerts.save(a);
+ }
+ @Transactional public boolean unsubscribe(String sku,String email,MerchantStore store){
+  if(email==null||email.trim().isEmpty()) throw new IllegalArgumentException("Email is required");
+  try { if(products.getBySku(sku,store)==null) throw new NoSuchElementException("Product not found"); } catch(com.salesmanager.core.business.exception.ServiceException e){throw new NoSuchElementException("Product not found");}
+  StockAlert a=alerts.findByMerchantStoreIdAndSkuAndEmailIgnoreCase(store.getId(),sku,email.trim()); if(a==null)return false; alerts.delete(a); return true; }
+ public List<StockAlert> list(MerchantStore s){return alerts.findByMerchantStoreId(s.getId());}
+ public List<StockAlertOutbox> outbox(MerchantStore s){return outbox.findByStore(s.getCode());}
+ @Transactional public void onRestock(String sku,MerchantStore store){ for(StockAlert a:new ArrayList<>(alerts.findByMerchantStoreId(store.getId()))){if(sku.equalsIgnoreCase(a.getSku())&&"PENDING".equals(a.getStatus())){StockAlertOutbox o=new StockAlertOutbox();o.setSku(a.getSku());o.setEmail(a.getEmail());o.setSubject("Product " + a.getSku() + " is back in stock");o.setStore(store.getCode());outbox.save(o);a.setStatus("SENT");a.setSentAt(new Date());alerts.save(a);}} }
+ @Transactional public void deleteForProduct(Long id){alerts.deleteByProductId(id);}
+}
