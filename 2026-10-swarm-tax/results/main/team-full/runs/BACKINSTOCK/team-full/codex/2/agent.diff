+package com.salesmanager.core.business.services.stock;
+import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional; import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.business.repositories.stock.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.stock.*;
+@Service("stockAlertService") public class StockAlertServiceImpl implements StockAlertService { @Inject private StockAlertRepository alerts; @Inject private StockAlertOutboxRepository outbox;
+ @Transactional public StockAlert subscribe(String sku,String email,MerchantStore store)throws ServiceException { if(sku==null||email==null||!email.matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$")) throw new IllegalArgumentException("Invalid email"); String e=email.trim(); Optional<StockAlert> old=alerts.findBySkuAndEmailLowerAndMerchantStoreCodeAndStatus(sku,e.toLowerCase(Locale.ROOT),store.getCode(),StockAlertStatus.PENDING); if(old.isPresent()) return old.get(); StockAlert a=new StockAlert(); a.setSku(sku); a.setEmail(e); a.setMerchantStore(store); return alerts.save(a); }
+ @Transactional public void cancel(String sku,String email,MerchantStore store)throws ServiceException { alerts.findBySkuAndEmailLowerAndMerchantStoreCodeAndStatus(sku,email.trim().toLowerCase(Locale.ROOT),store.getCode(),StockAlertStatus.PENDING).ifPresent(a->{a.setStatus(StockAlertStatus.CANCELLED);a.setCancelledAt(new Date());alerts.save(a);}); }
+ public List<StockAlert> list(MerchantStore s){return alerts.findByMerchantStoreCode(s.getCode());}
+ public List<StockAlertOutbox> outbox(MerchantStore store){List<StockAlertOutbox> result=new ArrayList<>(); for(StockAlertOutbox item:outbox.findByAlertMerchantStoreCode(store.getCode())) if(item.getStatus()==StockAlertStatus.PENDING) result.add(item); return result;}
+ @Transactional public void inventoryAvailable(String sku,MerchantStore store){ for(StockAlert a:alerts.findBySkuAndMerchantStoreCodeAndStatus(sku,store.getCode(),StockAlertStatus.PENDING)){ a.setStatus(StockAlertStatus.SENT);a.setSentAt(new Date());alerts.save(a); StockAlertOutbox o=new StockAlertOutbox();o.setAlert(a);o.setStatus(StockAlertStatus.PENDING);outbox.save(o); } }
+ public void deleteForProduct(String sku,MerchantStore store){outbox.deleteByAlertSkuAndAlertMerchantStoreCode(sku,store.getCode()); alerts.deleteBySkuAndMerchantStoreCode(sku,store.getCode());}
+}
