+package com.salesmanager.core.business.services.stockalert;
+import java.util.*; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional; import org.springframework.beans.factory.annotation.Autowired; import com.salesmanager.core.business.repositories.stockalert.*; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.stockalert.*;
+@Service("stockAlertService") public class StockAlertServiceImpl implements StockAlertService {
+ @Autowired private StockAlertRepository alerts; @Autowired private StockAlertOutboxRepository outbox;
+ public StockAlert subscribe(String sku,String store,String email){Optional<StockAlert> old=alerts.findBySkuAndStoreCodeAndEmail(sku,store,email);if(old.isPresent())return old.get();StockAlert a=new StockAlert();a.setSku(sku);a.setStoreCode(store);a.setEmail(email);return alerts.save(a);}
+ public void unsubscribe(String sku,String store,String email){alerts.findBySkuAndStoreCodeAndEmail(sku,store,email).ifPresent(alerts::delete);}
+ public List<StockAlert> list(String store,String status){return status==null?alerts.findByStoreCodeOrderByCreatedAtAsc(store):alerts.findByStoreCodeAndStatusOrderByCreatedAtAsc(store,status);}
+ public List<StockAlertOutbox> outbox(String store){return outbox.findByStoreCodeOrderByCreatedAtAsc(store);}
+ @Transactional public void restocked(String sku,String store,Product product){List<StockAlert> pending=alerts.findBySkuAndStoreCodeAndStatusOrderByCreatedAtAsc(sku,store,"PENDING");Date now=new Date();String name=sku;if(product!=null&&product.getDescriptions()!=null&&!product.getDescriptions().isEmpty())name=product.getDescriptions().iterator().next().getName();for(StockAlert a:pending){a.setStatus("SENT");a.setSentAt(now);alerts.save(a);StockAlertOutbox m=new StockAlertOutbox();m.setSku(sku);m.setStoreCode(store);m.setEmail(a.getEmail());m.setProductName(name);m.setMessage("Back in stock: "+name);m.setCreatedAt(now);outbox.save(m);}}
+ @Transactional public void delete(String sku,String store){alerts.deleteAll(alerts.findByStoreCodeOrderByCreatedAtAsc(store).stream().filter(a->sku.equals(a.getSku())).collect(java.util.stream.Collectors.toList()));}
+}
