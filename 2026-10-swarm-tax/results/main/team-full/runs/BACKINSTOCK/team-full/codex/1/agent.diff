+import java.util.*; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.stockalert.*;
+public interface StockAlertService { StockAlert subscribe(String sku,String store,String email); void unsubscribe(String sku,String store,String email); List<StockAlert> list(String store,String status); List<StockAlertOutbox> outbox(String store); void restocked(String sku,String store,Product product); void delete(String sku,String store); }
diff --git a/sm-core/src/main/java/com/salesmanager/core/business/services/stockalert/StockAlertServiceImpl.java b/sm-core/src/main/java/com/salesmanager/core/business/services/stockalert/StockAlertServiceImpl.java
