+package com.salesmanager.core.model.stockalert;
+
+import java.io.Serializable;
+import java.util.Date;
+import javax.persistence.*;
+
+@Entity
+@Table(name="STOCK_ALERT", uniqueConstraints=@UniqueConstraint(columnNames={"SKU","STORE_CODE","EMAIL"}), indexes=@Index(name="STOCK_ALERT_STATUS_IDX", columnList="STORE_CODE,STATUS,CREATED_AT"))
+public class StockAlert implements Serializable {
+  private static final long serialVersionUID=1L;
+  @Id @GeneratedValue(strategy=GenerationType.AUTO) private Long id;
+  @Column(nullable=false) private String sku;
+  @Column(name="STORE_CODE",nullable=false) private String storeCode;
+  @Column(nullable=false) private String email;
+  @Column(nullable=false) private String status="PENDING";
+  @Temporal(TemporalType.TIMESTAMP) @Column(name="CREATED_AT",nullable=false) private Date createdAt=new Date();
+  @Temporal(TemporalType.TIMESTAMP) @Column(name="SENT_AT") private Date sentAt;
+  public Long getId(){return id;} public void setId(Long v){id=v;}
+  public String getSku(){return sku;} public void setSku(String v){sku=v;}
+  public String getStoreCode(){return storeCode;} public void setStoreCode(String v){storeCode=v;}
+  public String getEmail(){return email;} public void setEmail(String v){email=v;}
+  public String getStatus(){return status;} public void setStatus(String v){status=v;}
+  public Date getCreatedAt(){return createdAt;} public void setCreatedAt(Date v){createdAt=v;}
+  public Date getSentAt(){return sentAt;} public void setSentAt(Date v){sentAt=v;}
+}
