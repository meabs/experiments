+package com.salesmanager.shop.store.api.v1.stockalert;
+import java.util.List; import javax.validation.Valid; import javax.validation.constraints.Email; import javax.validation.constraints.NotBlank; import org.springframework.beans.factory.annotation.Autowired; import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.stockalert.StockAlertService; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.stockalert.*; import com.salesmanager.shop.store.api.exception.ResourceNotFoundException; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class StockAlertApi {
+ @Autowired private StockAlertService service; @Autowired private ProductService products;
+ public static class Request { @NotBlank @Email private String email; public String getEmail(){return email;} public void setEmail(String v){email=v;} }
+ private String code(String requested,MerchantStore merchant){if(merchant==null || (requested!=null&&!requested.equals(merchant.getCode()))) throw new ResourceNotFoundException("Store not found"); return merchant.getCode();}
+ private void product(String sku,MerchantStore merchant){try{if(products.getBySku(sku,merchant)==null)throw new ResourceNotFoundException("Product not found");}catch(ServiceException e){throw new ResourceNotFoundException("Product not found");}}
+ @PostMapping("/products/{sku}/alerts") public ResponseEntity<StockAlert> subscribe(@PathVariable String sku,@RequestParam String store,@Valid @RequestBody Request request,@ApiIgnore MerchantStore merchant){String c=code(store,merchant);product(sku,merchant);return new ResponseEntity<>(service.subscribe(sku,c,request.email.trim().toLowerCase()),HttpStatus.CREATED);}
+ @DeleteMapping("/products/{sku}/alerts") @ResponseStatus(HttpStatus.NO_CONTENT) public void unsubscribe(@PathVariable String sku,@RequestParam String store,@Valid @RequestBody Request request,@ApiIgnore MerchantStore merchant){String c=code(store,merchant);product(sku,merchant);service.unsubscribe(sku,c,request.email.trim().toLowerCase());}
+ @GetMapping("/private/stock-alerts") public List<StockAlert> alerts(@RequestParam(value="store",required=false) String store,@RequestParam(value="status",required=false) String status,@ApiIgnore MerchantStore merchant){return service.list(code(store,merchant),status);}
+ @GetMapping("/private/stock-alerts/outbox") public List<StockAlertOutbox> outbox(@RequestParam(value="store",required=false) String store,@ApiIgnore MerchantStore merchant){return service.outbox(code(store,merchant));}
+}
