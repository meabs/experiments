+package com.salesmanager.shop.store.api.v1.product;
+import java.util.*; import javax.validation.Valid; import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.business.services.catalog.product.alert.StockAlertService; import com.salesmanager.core.model.catalog.product.alert.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.catalog.product.alert.StockAlertRequest; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class StockAlertApi {
+ private final StockAlertService service; public StockAlertApi(StockAlertService s){service=s;}
+ @PostMapping("/products/{sku}/alerts") public ResponseEntity<StockAlert> subscribe(@PathVariable String sku,@Valid @RequestBody StockAlertRequest request,@ApiIgnore MerchantStore store){ if(sku==null||sku.trim().isEmpty()||request.getEmail()==null||!request.getEmail().matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$")) return ResponseEntity.badRequest().build(); StockAlert a=service.subscribe(sku.trim(),request.getEmail().trim().toLowerCase(),store); return ResponseEntity.status(HttpStatus.CREATED).body(a); }
+ @DeleteMapping("/products/{sku}/alerts") @ResponseStatus(HttpStatus.NO_CONTENT) public void unsubscribe(@PathVariable String sku,@RequestParam String email,@ApiIgnore MerchantStore store){service.unsubscribe(sku,email,store);}
+ @GetMapping("/private/stock-alerts") public List<StockAlert> alerts(@RequestParam(required=false) String status,@ApiIgnore MerchantStore store){return service.list(store,status);}
+ @GetMapping("/private/stock-alerts/outbox") public List<StockAlertOutbox> outbox(@ApiIgnore MerchantStore store){return service.outbox(store);}
+}
