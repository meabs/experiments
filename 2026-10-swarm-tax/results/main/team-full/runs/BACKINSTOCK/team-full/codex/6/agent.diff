+package com.salesmanager.core.business.services.catalog.product.alert;
+import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional; import com.salesmanager.core.business.repositories.catalog.product.alert.*; import com.salesmanager.core.model.catalog.product.alert.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("stockAlertService") public class StockAlertServiceImpl implements StockAlertService {
+ @Inject private StockAlertRepository alerts; @Inject private StockAlertOutboxRepository outbox;
+ @Transactional public StockAlert subscribe(String sku,String email,MerchantStore store){ Optional<StockAlert> old=alerts.findByMerchantStoreIdAndSkuAndEmail(store.getId(),sku,email); if(old.isPresent()) return old.get(); StockAlert a=new StockAlert(); a.setMerchantStore(store); a.setSku(sku); a.setEmail(email); return alerts.save(a); }
+ @Transactional public void unsubscribe(String sku,String email,MerchantStore store){ alerts.findByMerchantStoreIdAndSkuAndEmail(store.getId(),sku,email).ifPresent(alerts::delete); }
+ public List<StockAlert> list(MerchantStore store,String status){ return status==null?alerts.findByMerchantStoreId(store.getId()):alerts.findByMerchantStoreIdAndStatus(store.getId(),status.toUpperCase()); }
+ public List<StockAlertOutbox> outbox(MerchantStore store){return outbox.findByMerchantStoreId(store.getId());}
+ @Transactional public void onRestock(String sku,MerchantStore store,String productName){ for(StockAlert a:alerts.findByMerchantStoreIdAndSkuAndStatus(store.getId(),sku,"PENDING")){ a.setStatus("SENT"); a.setSentAt(new Date()); alerts.save(a); if(!outbox.existsByAlertId(a.getId())){StockAlertOutbox m=new StockAlertOutbox();m.setAlert(a);m.setMerchantStore(store);m.setRecipient(a.getEmail());m.setSubject("Back in stock: "+(productName==null?sku:productName));outbox.save(m);}} }
+ @Transactional public void delete(String sku,MerchantStore store){ for(StockAlert a:alerts.findByMerchantStoreIdAndSku(store.getId(),sku)) outbox.deleteByAlertId(a.getId()); alerts.deleteByMerchantStoreIdAndSku(store.getId(),sku); }
+}
