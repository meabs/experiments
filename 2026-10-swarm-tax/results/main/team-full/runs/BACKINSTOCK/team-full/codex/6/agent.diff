+public interface StockAlertService { StockAlert subscribe(String sku,String email,MerchantStore store); void unsubscribe(String sku,String email,MerchantStore store); List<StockAlert> list(MerchantStore store,String status); List<StockAlertOutbox> outbox(MerchantStore store); void onRestock(String sku,MerchantStore store,String productName); void delete(String sku,MerchantStore store); }
