+package com.salesmanager.shop.store.api.v1;
+
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductLimits;
+import com.salesmanager.shop.model.store.CartRules;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.api.exception.InvalidCartRuleException;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Private administration endpoints for purchase limits. */
+@RestController
+@RequestMapping("/api/v1/private")
+public class CartLimitsApi {
+ @Inject private ProductService productService;
+ @Inject private MerchantStoreService merchantStoreService;
+ private static void valid(Integer a,String n){ if(a!=null && a<1) throw new InvalidCartRuleException("Invalid "+n); }
+ private static void valid(ProductLimits x){valid(x.getMinPerCart(),"minPerCart");valid(x.getMaxPerCart(),"maxPerCart");valid(x.getPackSize(),"packSize");if(x.getMinPerCart()!=null&&x.getMaxPerCart()!=null&&x.getMinPerCart()>x.getMaxPerCart())throw new InvalidCartRuleException("minPerCart may not exceed maxPerCart");if(x.getMaxPerCart()!=null&&x.getPackSize()!=null&&x.getMaxPerCart()<x.getPackSize())throw new InvalidCartRuleException("maxPerCart may not be less than packSize");}
+ private Product product(Long id, MerchantStore s){Product p=productService.findOne(id,s);if(p==null||p.getMerchantStore()==null||!p.getMerchantStore().getId().equals(s.getId()))throw new ResourceNotFoundException("Product not found");return p;}
+ @GetMapping("/product/{id}/limits") public ProductLimits get(@PathVariable Long id,@ApiIgnore MerchantStore s){Product p=product(id,s);ProductLimits x=new ProductLimits();x.setMinPerCart(p.getMinPerCart());x.setMaxPerCart(p.getMaxPerCart());x.setPackSize(p.getPackSize());return x;}
+ @PutMapping("/product/{id}/limits") public ProductLimits put(@PathVariable Long id,@RequestBody ProductLimits x,@ApiIgnore MerchantStore s){valid(x);Product p=product(id,s);p.setMinPerCart(x.getMinPerCart());p.setMaxPerCart(x.getMaxPerCart());p.setPackSize(x.getPackSize());try{productService.saveProduct(p);}catch(Exception e){throw new ServiceRuntimeException(e);}return x;}
+ @GetMapping("/cart-rules") public CartRules getRules(@ApiIgnore MerchantStore s){CartRules x=new CartRules();x.setMaxLines(s.getCartMaxLines());x.setMaxUnits(s.getCartMaxUnits());return x;}
+ @PutMapping("/cart-rules") public CartRules putRules(@RequestBody CartRules x,@ApiIgnore MerchantStore s){valid(x.getMaxLines(),"maxLines");valid(x.getMaxUnits(),"maxUnits");s.setCartMaxLines(x.getMaxLines());s.setCartMaxUnits(x.getMaxUnits());try{merchantStoreService.saveOrUpdate(s);}catch(Exception e){throw new ServiceRuntimeException(e);}return x;}
+}
