+package com.salesmanager.shop.store.api.v1.cart;
+
+import javax.inject.Inject;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.cart.CartRules;
+import com.salesmanager.shop.model.cart.ProductLimits;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private")
+public class CartLimitsApi {
+  @Inject private ProductService products;
+  @Inject private MerchantStoreService stores;
+
+  @GetMapping("/product/{id}/limits")
+  public ProductLimits productGet(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+    Product p = products.findOne(id, store);
+    if (p == null) throw new ResourceNotFoundException("404", "Product not found");
+    return productLimits(p);
+  }
+  @PutMapping("/product/{id}/limits")
+  public ProductLimits productPut(@PathVariable Long id, @RequestBody ProductLimits in, @ApiIgnore MerchantStore store) {
+    Product p = products.findOne(id, store);
+    if (p == null) throw new ResourceNotFoundException("404", "Product not found");
+    validate(in.getMinPerCart(), in.getMaxPerCart(), in.getPackSize());
+    p.setMinPerCart(in.getMinPerCart()); p.setMaxPerCart(in.getMaxPerCart()); p.setPackSize(in.getPackSize());
+    try { products.saveProduct(p); } catch (Exception e) { throw new ServiceRuntimeException("400", "Unable to save limits", e); }
+    return productLimits(p);
+  }
+  @GetMapping("/cart-rules") public CartRules rulesGet(@ApiIgnore MerchantStore store) { return rules(store); }
+  @PutMapping("/cart-rules") public CartRules rulesPut(@RequestBody CartRules in, @ApiIgnore MerchantStore store) {
+    validatePositive(in.getMaxLines()); validatePositive(in.getMaxUnits());
+    store.setMaxLines(in.getMaxLines()); store.setMaxUnits(in.getMaxUnits());
+    try { stores.saveOrUpdate(store); } catch (Exception e) { throw new ServiceRuntimeException("400", "Unable to save cart rules", e); }
+    return rules(store);
+  }
+  private static ProductLimits productLimits(Product p) { ProductLimits x=new ProductLimits(); x.setMinPerCart(p.getMinPerCart()); x.setMaxPerCart(p.getMaxPerCart()); x.setPackSize(p.getPackSize()); return x; }
+  private static CartRules rules(MerchantStore s) { CartRules x=new CartRules(); x.setMaxLines(s.getMaxLines()); x.setMaxUnits(s.getMaxUnits()); return x; }
+  private static void validate(Integer min,Integer max,Integer pack) { validatePositive(min); validatePositive(max); validatePositive(pack); if(min!=null&&max!=null&&min>max) bad(); if(max!=null&&pack!=null&&max<pack) bad(); }
+  private static void validatePositive(Integer x) { if(x!=null&&x<1) bad(); }
+  private static void bad() { throw new ServiceRuntimeException("400", "Invalid cart limits", new IllegalArgumentException("Invalid cart limits")); }
+}
