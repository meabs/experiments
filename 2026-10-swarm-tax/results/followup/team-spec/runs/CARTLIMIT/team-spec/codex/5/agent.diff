+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private")
+public class CartRulesApi {
+ @Inject private ProductService products;
+ @Inject private MerchantStoreService stores;
+ private void valid(Integer a,Integer b,Integer c) {
+  if ((a!=null&&a<1)||(b!=null&&b<1)||(c!=null&&c<1)||(a!=null&&b!=null&&a>b)||(b!=null&&c!=null&&b<c)) throw new RestApiException("INVALID_LIMIT","Invalid cart limit");
+ }
+ private Product product(Long id, MerchantStore store) {
+  Product p=products.findOne(id,store); if(p==null || p.getMerchantStore()==null || !p.getMerchantStore().getId().equals(store.getId())) throw new ResourceNotFoundException("Product not found"); return p;
+ }
+ @PutMapping("/product/{id}/limits") public ProductLimits putProduct(@PathVariable Long id,@RequestBody ProductLimits in,@ApiIgnore MerchantStore ms) throws Exception {
+  if(in==null) throw new RestApiException("INVALID_LIMIT","Request body is required"); if(ms==null) throw new ResourceNotFoundException("Store not found"); valid(in.getMinPerCart(),in.getMaxPerCart(),in.getPackSize()); Product p=product(id,ms); p.setMinPerCart(in.getMinPerCart());p.setMaxPerCart(in.getMaxPerCart());p.setPackSize(in.getPackSize());products.saveProduct(p); return in;
+ }
+ @GetMapping("/product/{id}/limits") public ProductLimits getProduct(@PathVariable Long id,@ApiIgnore MerchantStore ms) { if(ms==null) throw new ResourceNotFoundException("Store not found"); Product p=product(id,ms); ProductLimits out=new ProductLimits();out.setMinPerCart(p.getMinPerCart());out.setMaxPerCart(p.getMaxPerCart());out.setPackSize(p.getPackSize());return out; }
+ @PutMapping("/cart-rules") public CartRules putRules(@RequestBody CartRules in,@ApiIgnore MerchantStore ms) throws Exception { if(in==null) throw new RestApiException("INVALID_LIMIT","Request body is required"); if((in.getMaxLines()!=null&&in.getMaxLines()<1)||(in.getMaxUnits()!=null&&in.getMaxUnits()<1)) throw new RestApiException("INVALID_LIMIT","Invalid cart cap"); if(ms==null)throw new ResourceNotFoundException("Store not found");ms.setMaxLines(in.getMaxLines());ms.setMaxUnits(in.getMaxUnits());stores.saveOrUpdate(ms);return in; }
+ @GetMapping("/cart-rules") public CartRules getRules(@ApiIgnore MerchantStore ms){if(ms==null)throw new ResourceNotFoundException("Store not found");CartRules r=new CartRules();r.setMaxLines(ms.getMaxLines());r.setMaxUnits(ms.getMaxUnits());return r;}
+}
