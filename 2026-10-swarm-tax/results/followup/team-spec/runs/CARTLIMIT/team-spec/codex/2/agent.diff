+package com.salesmanager.shop.store.api.v1.product;
+
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private")
+public class PurchaseLimitsApi {
+  @Inject private ProductService products;
+  @Inject private MerchantStoreService stores;
+  public static class Limits { public Integer minPerCart,maxPerCart,packSize; public Integer getMinPerCart(){return minPerCart;} public void setMinPerCart(Integer v){minPerCart=v;} public Integer getMaxPerCart(){return maxPerCart;} public void setMaxPerCart(Integer v){maxPerCart=v;} public Integer getPackSize(){return packSize;} public void setPackSize(Integer v){packSize=v;} }
+  public static class CartRules { public Integer maxLines,maxUnits; public Integer getMaxLines(){return maxLines;} public void setMaxLines(Integer v){maxLines=v;} public Integer getMaxUnits(){return maxUnits;} public void setMaxUnits(Integer v){maxUnits=v;} }
+  private Limits limits(Product p){ Limits x=new Limits(); x.minPerCart=p.getMinPerCart();x.maxPerCart=p.getMaxPerCart();x.packSize=p.getPackSize();return x; }
+  private void valid(Integer a,Integer b,Integer c){ if((a!=null&&a<1)||(b!=null&&b<1)||(c!=null&&c<1)||(a!=null&&b!=null&&a>b)||(b!=null&&c!=null&&b<c)) throw new IllegalArgumentException("Invalid purchase limits"); }
+  @GetMapping("/product/{id}/limits") public Limits get(@PathVariable Long id,@ApiIgnore MerchantStore store) throws Exception { Product p=products.findOne(id,store); if(p==null) throw new ResourceNotFoundException("Product not found"); return limits(p); }
+  @PutMapping("/product/{id}/limits") public ResponseEntity<?> put(@PathVariable Long id,@RequestBody Limits x,@ApiIgnore MerchantStore store) throws Exception { try { valid(x.minPerCart,x.maxPerCart,x.packSize); Product p=products.findOne(id,store); if(p==null) throw new ResourceNotFoundException("Product not found"); p.setMinPerCart(x.minPerCart);p.setMaxPerCart(x.maxPerCart);p.setPackSize(x.packSize);products.saveProduct(p);return ResponseEntity.ok(limits(p)); } catch(IllegalArgumentException e){return ResponseEntity.badRequest().body(e.getMessage());} }
+  @GetMapping("/cart-rules") public CartRules rules(@ApiIgnore MerchantStore store){ CartRules x=new CartRules();x.maxLines=store.getMaxLines();x.maxUnits=store.getMaxUnits();return x; }
+  @PutMapping("/cart-rules") public ResponseEntity<?> putRules(@RequestBody CartRules x,@ApiIgnore MerchantStore store){ if((x.maxLines!=null&&x.maxLines<1)||(x.maxUnits!=null&&x.maxUnits<1)) return ResponseEntity.status(HttpStatus.BAD_REQUEST).body("Invalid cart rules"); store.setMaxLines(x.maxLines);store.setMaxUnits(x.maxUnits);try { stores.saveOrUpdate(store); } catch(Exception e) { return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).build(); } return ResponseEntity.ok(rules(store)); }
+}
