+			Product p = i.getProduct(); int q = i.getQuantity(); Integer old = quantities.get(p.getId());
+			if (q > 0) {
+				if (p.getMinPerCart() != null && q < p.getMinPerCart()) reject("MIN_PER_CART", p.getSku());
+				if (p.getMaxPerCart() != null && q > p.getMaxPerCart()) reject("MAX_PER_CART", p.getSku());
+				if (p.getPackSize() != null && q % p.getPackSize() != 0) reject("PACK_SIZE", p.getSku());
+			}
+			if (old == null && q > 0) addsLine = true;
+			if (old != null && q > old) addsUnits = true;
+			if (old == null && q > 0) addsUnits = true;
+			if (q == 0) quantities.remove(p.getId()); else quantities.put(p.getId(), q);
+		}
