+	/** Validates the complete prospective cart before any entity is mutated. */
+	private void validateChange(ShoppingCart cart, List<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> changes,
+			MerchantStore store) {
+		java.util.Map<Long, Integer> quantities = new java.util.HashMap<Long, Integer>();
