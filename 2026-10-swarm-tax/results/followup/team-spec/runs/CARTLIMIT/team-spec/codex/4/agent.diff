+package com.salesmanager.shop.store.api.v1.limits;
+
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.limits.CartRules;
+import com.salesmanager.shop.model.limits.ProductLimits;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private")
+public class PurchaseLimitsApi {
+    @Inject private ProductService productService;
+    @Inject private MerchantStoreService merchantStoreService;
+
+    @PutMapping("/product/{id}/limits")
+    public ProductLimits setProductLimits(@PathVariable Long id, @RequestBody ProductLimits request,
+            @ApiIgnore MerchantStore store) {
+        Product p = productService.findOne(id, store);
+        if (p == null || p.getMerchantStore() == null || !p.getMerchantStore().getId().equals(store.getId()))
+            throw new ResourceNotFoundException("Product not found");
+        validate(request.getMinPerCart(), request.getMaxPerCart(), request.getPackSize());
+        p.setMinPerCart(request.getMinPerCart()); p.setMaxPerCart(request.getMaxPerCart()); p.setPackSize(request.getPackSize());
+        try { productService.saveProduct(p); } catch (Exception e) { throw new RestApiException("500", "Unable to save product limits", e); }
+        return request;
+    }
+    @GetMapping("/product/{id}/limits")
+    public ProductLimits getProductLimits(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        Product p = productService.findOne(id, store);
+        if (p == null || p.getMerchantStore() == null || !p.getMerchantStore().getId().equals(store.getId())) throw new ResourceNotFoundException("Product not found");
+        ProductLimits r = new ProductLimits(); r.setMinPerCart(p.getMinPerCart()); r.setMaxPerCart(p.getMaxPerCart()); r.setPackSize(p.getPackSize()); return r;
+    }
+    @PutMapping("/cart-rules")
+    public CartRules setCartRules(@RequestBody CartRules request, @ApiIgnore MerchantStore store) {
+        validatePositive(request.getMaxLines()); validatePositive(request.getMaxUnits());
+        store.setMaxLines(request.getMaxLines()); store.setMaxUnits(request.getMaxUnits());
+        try { merchantStoreService.saveOrUpdate(store); } catch (Exception e) { throw new RestApiException("500", "Unable to save cart rules", e); }
+        return request;
+    }
+    @GetMapping("/cart-rules")
+    public CartRules getCartRules(@ApiIgnore MerchantStore store) { CartRules r = new CartRules(); r.setMaxLines(store.getMaxLines()); r.setMaxUnits(store.getMaxUnits()); return r; }
+    private void validate(Integer min, Integer max, Integer pack) { validatePositive(min); validatePositive(max); validatePositive(pack); if (min != null && max != null && min > max) throw new RestApiException("400", "minPerCart may not exceed maxPerCart"); if (max != null && pack != null && max < pack) throw new RestApiException("400", "maxPerCart may not be less than packSize"); }
+    private void validatePositive(Integer n) { if (n != null && n < 1) throw new RestApiException("400", "Limits must be at least 1"); }
+}
