@@ -0,0 +1,65 @@
+package com.salesmanager.shop.store.api.v1.cart;
+
+import java.util.Arrays;
+import javax.inject.Inject;
+import org.springframework.http.MediaType;
+import org.springframework.web.bind.annotation.*;
+import springfox.documentation.annotations.ApiIgnore;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.cart.LimitRules;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.api.exception.UnauthorizedException;
+import com.salesmanager.shop.store.controller.user.facade.UserFacade;
+
+@RestController
+@RequestMapping("/api/v1/private")
+public class CartRulesApi {
+    @Inject private ProductService productService;
+    @Inject private MerchantStoreService merchantStoreService;
+    @Inject private UserFacade userFacade;
+
+    @GetMapping(value="/product/{id}/limits", produces=MediaType.APPLICATION_JSON_VALUE)
+    public LimitRules productLimits(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        protect();
+        Product p = productService.findOne(id, store);
+        if (p == null || p.getMerchantStore() == null || !p.getMerchantStore().getId().equals(store.getId())) throw new ResourceNotFoundException("Product not found");
+        return productRules(p);
+    }
+    @PutMapping(value="/product/{id}/limits", produces=MediaType.APPLICATION_JSON_VALUE)
+    public LimitRules setProductLimits(@PathVariable Long id, @RequestBody LimitRules request, @ApiIgnore MerchantStore store) throws Exception {
+        protect();
+        Product p = productService.findOne(id, store);
+        if (p == null || p.getMerchantStore() == null || !p.getMerchantStore().getId().equals(store.getId())) throw new ResourceNotFoundException("Product not found");
+        validateProduct(request);
+        p.setMinPerCart(request.getMinPerCart()); p.setMaxPerCart(request.getMaxPerCart()); p.setPackSize(request.getPackSize());
+        productService.saveProduct(p);
+        return productRules(p);
+    }
+    @GetMapping(value="/cart-rules", produces=MediaType.APPLICATION_JSON_VALUE)
+    public LimitRules cartRules(@ApiIgnore MerchantStore store) { protect(); return storeRules(store); }
+    @PutMapping(value="/cart-rules", produces=MediaType.APPLICATION_JSON_VALUE)
+    public LimitRules setCartRules(@RequestBody LimitRules request, @ApiIgnore MerchantStore store) throws Exception {
+        protect();
+        validatePositive(request.getMaxLines(), "maxLines"); validatePositive(request.getMaxUnits(), "maxUnits");
+        store.setMaxLines(request.getMaxLines()); store.setMaxUnits(request.getMaxUnits()); merchantStoreService.saveOrUpdate(store);
+        return storeRules(store);
+    }
+    private LimitRules productRules(Product p) { LimitRules r=new LimitRules(); r.setMinPerCart(p.getMinPerCart()); r.setMaxPerCart(p.getMaxPerCart()); r.setPackSize(p.getPackSize()); return r; }
+    private LimitRules storeRules(MerchantStore s) { LimitRules r=new LimitRules(); r.setMaxLines(s.getMaxLines()); r.setMaxUnits(s.getMaxUnits()); return r; }
+    private void validateProduct(LimitRules r) {
+        validatePositive(r.getMinPerCart(), "minPerCart"); validatePositive(r.getMaxPerCart(), "maxPerCart"); validatePositive(r.getPackSize(), "packSize");
+        if (r.getMinPerCart()!=null && r.getMaxPerCart()!=null && r.getMinPerCart()>r.getMaxPerCart()) bad("minPerCart");
+        if (r.getMaxPerCart()!=null && r.getPackSize()!=null && r.getMaxPerCart()<r.getPackSize()) bad("maxPerCart");
+    }
+    private void validatePositive(Integer value, String name) { if (value != null && value < 1) bad(name); }
+    private void bad(String field) { throw new RestApiException("400", "Invalid " + field); }
+    private void protect() {
+        String user = userFacade.authenticatedUser();
+        if (user == null) throw new UnauthorizedException();
+        userFacade.authorizedGroup(user, Arrays.asList("SUPERADMIN", "ADMIN_RETAILER"));
+    }
+}
