+	private void validateProductQuantity(Product p, int q) {
+		if (q == 0) return;
+		if (q < 0) throw new RestApiException("MIN_PER_CART", "Quantity cannot be negative");
+		if (p.getMinPerCart()!=null && q < p.getMinPerCart()) throw new RestApiException("MIN_PER_CART", "Minimum quantity is " + p.getMinPerCart());
+		if (p.getMaxPerCart()!=null && q > p.getMaxPerCart()) throw new RestApiException("MAX_PER_CART", "Maximum quantity is " + p.getMaxPerCart());
+		if (p.getPackSize()!=null && q % p.getPackSize()!=0) throw new RestApiException("PACK_SIZE", "Quantity must be a multiple of " + p.getPackSize());
+	}
