+	/** Validate a prospective cart before touching any persistent line (also makes multi updates atomic). */
+	private void validateChange(ShoppingCart cart, com.salesmanager.core.model.shoppingcart.ShoppingCartItem changed,
+			int requested, MerchantStore store, boolean increment) {
+		int originalQuantity = changed.getQuantity();
+		if (increment && cart.getLineItems() != null) for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem line : cart.getLineItems())
+			if (line.getProduct().getId().equals(changed.getProduct().getId())) { requested += line.getQuantity(); changed.setQuantity(requested); break; }
+		List<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> proposed = new ArrayList<com.salesmanager.core.model.shoppingcart.ShoppingCartItem>();
+		if (cart.getLineItems() != null) proposed.addAll(cart.getLineItems());
+		boolean found = false;
+		for (int i=0; i<proposed.size(); i++) {
+			com.salesmanager.core.model.shoppingcart.ShoppingCartItem line = proposed.get(i);
+			if (line.getProduct().getId().equals(changed.getProduct().getId())) { found = true; proposed.set(i, changed); break; }
+		}
+		if (!found && requested > 0) proposed.add(changed);
+		validateProductQuantity(changed.getProduct(), requested);
+		validateStoreCaps(cart, proposed, store);
+		changed.setQuantity(originalQuantity);
+	}
