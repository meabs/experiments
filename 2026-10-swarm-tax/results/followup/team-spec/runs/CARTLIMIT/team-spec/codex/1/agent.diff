+	private void validateMultiChange(ShoppingCart cart, List<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> changes, MerchantStore store) {
+		List<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> proposed = new ArrayList<com.salesmanager.core.model.shoppingcart.ShoppingCartItem>();
+		if (cart.getLineItems() != null) proposed.addAll(cart.getLineItems());
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem change : changes) {
+			validateProductQuantity(change.getProduct(), change.getQuantity());
+			int index = -1;
+			for (int i=0;i<proposed.size();i++) if (proposed.get(i).getProduct().getId().equals(change.getProduct().getId())) { index=i; break; }
+			if (change.getQuantity()==0) { if(index>=0) proposed.remove(index); }
+			else if(index>=0) proposed.set(index, change); else proposed.add(change);
+		}
+		validateStoreCaps(cart, proposed, store);
+	}
