@@ -0,0 +1,40 @@
+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.*;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductQuestionRequest;
+import com.salesmanager.shop.model.catalog.product.ProductQuestionAnswerRequest;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestionList;
+import com.salesmanager.shop.store.api.exception.*;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController @RequestMapping("/api/v1")
+public class ProductQuestionApi {
+ @Inject private ProductQuestionService questions; @Inject private ProductService products; @Inject private CustomerService customers;
+ private String trim(String s,int min,int max){if(s==null) throw new ServiceRuntimeException("400","Value is required"); String x=s.trim(); if(x.length()<min||x.length()>max) throw new ServiceRuntimeException("400","Invalid length"); return x;}
+ private Product product(String sku,MerchantStore store){try {Product p=products.getBySku(sku,store); if(p==null)throw new ResourceNotFoundException("Product not found"); return p;} catch(Exception e){if(e instanceof ResourceNotFoundException)throw (ResourceNotFoundException)e; throw new ResourceNotFoundException("Product not found");}}
+ private Customer customer(HttpServletRequest req,MerchantStore store){Principal p=req.getUserPrincipal(); if(p==null)throw new UnauthorizedException(); Customer c=customers.getByNick(p.getName(),store.getId()); if(c==null)throw new UnauthorizedException(); return c;}
+ private ReadableProductQuestion dto(ProductQuestion q,boolean admin){ReadableProductQuestion d=new ReadableProductQuestion(); d.setId(q.getId());d.setSku(q.getProduct().getSku());d.setText(q.getText());d.setStatus(q.getStatus().name());d.setAnswer(q.getAnswer());d.setAskedAt(q.getAskedAt());d.setAnsweredAt(q.getAnsweredAt()); if(q.getCustomer()!=null&&q.getCustomer().getBilling()!=null)d.setAskedBy(q.getCustomer().getBilling().getFirstName()); return d;}
+ @PostMapping("/auth/products/{sku}/questions") @ResponseStatus(HttpStatus.CREATED)
+ public ReadableProductQuestion ask(@PathVariable String sku,@RequestBody ProductQuestionRequest body,@ApiIgnore MerchantStore store,HttpServletRequest req){Customer c=customer(req,store); Product p=product(sku,store);if(questions.pendingCount(c)>=3)throw new ServiceRuntimeException("400","Too many pending questions"); ProductQuestion q=new ProductQuestion();q.setProduct(p);q.setMerchantStore(store);q.setCustomer(c);q.setText(trim(body==null?null:body.getText(),10,500));q.setAskedAt(new Date());try{questions.create(q);}catch(Exception e){throw new ServiceRuntimeException(e);}return dto(q,true);}
+ @GetMapping("/auth/customer/questions") public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store,HttpServletRequest req){Customer c=customer(req,store);List<ReadableProductQuestion> out=new ArrayList<>();for(ProductQuestion q:questions.byCustomer(c))out.add(dto(q,true));return out;}
+ @GetMapping("/products/{sku}/questions") public ReadableProductQuestionList published(@PathVariable String sku,@ApiIgnore MerchantStore store){Product p=product(sku,store);List<ReadableProductQuestion> out=new ArrayList<>();for(ProductQuestion q:questions.published(p)){ReadableProductQuestion d=dto(q,false);d.setSku(null);d.setStatus(null);d.setText(null);d.setAskedAt(null);out.add(d);}return new ReadableProductQuestionList(out);}
+ @GetMapping("/private/questions") public List<ReadableProductQuestion> adminList(@RequestParam(defaultValue="PENDING") String status,@ApiIgnore MerchantStore store){ProductQuestionStatus s;try{s=ProductQuestionStatus.valueOf(status);}catch(Exception e){throw new ServiceRuntimeException("400","Invalid status");}List<ReadableProductQuestion> out=new ArrayList<>();for(ProductQuestion q:questions.byStore(store,s))out.add(dto(q,true));return out;}
+ @PutMapping("/private/questions/{id}/answer") public ReadableProductQuestion answer(@PathVariable Long id,@RequestBody ProductQuestionAnswerRequest body,@ApiIgnore MerchantStore store){ProductQuestion q=get(id,store);if(q.getStatus()==ProductQuestionStatus.REJECTED)throw new ConflictException("Rejected question cannot be answered");q.setAnswer(trim(body==null?null:body.getAnswer(),1,2000));q.setStatus(ProductQuestionStatus.PUBLISHED);q.setAnsweredAt(new Date());save(q);return dto(q,true);}
+ @PutMapping("/private/questions/{id}/reject") public ReadableProductQuestion reject(@PathVariable Long id,@ApiIgnore MerchantStore store){ProductQuestion q=get(id,store);q.setStatus(ProductQuestionStatus.REJECTED);save(q);return dto(q,true);}
+ private ProductQuestion get(Long id,MerchantStore store){ProductQuestion q=questions.getById(id);if(q==null||q.getMerchantStore()==null||!q.getMerchantStore().getId().equals(store.getId()))throw new ResourceNotFoundException("Question not found");return q;}
+ private void save(ProductQuestion q){try{questions.update(q);}catch(Exception e){throw new ServiceRuntimeException(e);}}
+}
