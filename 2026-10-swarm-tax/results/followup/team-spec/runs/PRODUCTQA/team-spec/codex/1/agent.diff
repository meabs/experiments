+package com.salesmanager.core.business.services.catalog.product;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.ProductQuestionRepository;
+import com.salesmanager.core.model.catalog.product.*;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("productQuestionService") public class ProductQuestionServiceImpl implements ProductQuestionService {
+ @Inject private ProductQuestionRepository repo;
+ public ProductQuestion ask(ProductQuestion q) throws ServiceException { if(q.getText()==null || q.getText().trim().length()<10 || q.getText().trim().length()>500) throw new ServiceException("Question text must be between 10 and 500 characters"); if(repo.countByCustomerAndStatus(q.getCustomer(),ProductQuestionStatus.PENDING)>=3) throw new ServiceException("Customer has too many pending questions"); q.setText(q.getText().trim()); q.setAskedAt(new Date()); q.setStatus(ProductQuestionStatus.PENDING); return repo.save(q); }
+ public List<ProductQuestion> listByCustomer(Customer c){return repo.findByCustomerOrderByAskedAtDesc(c);}
+ public List<ProductQuestion> listByStore(MerchantStore s,ProductQuestionStatus st){return repo.findByMerchantStoreAndStatusOrderByAskedAtAsc(s,st);}
+ public List<ProductQuestion> listPublished(Product p){return repo.findByProductAndStatusOrderByAnsweredAtDesc(p,ProductQuestionStatus.PUBLISHED);}
+ public ProductQuestion get(Long id){return repo.findById(id).orElse(null);}
+ public ProductQuestion answer(ProductQuestion q,String a)throws ServiceException {if(q.getStatus()==ProductQuestionStatus.REJECTED) throw new ServiceException("Rejected question cannot be answered"); if(a==null||a.trim().length()<1||a.trim().length()>2000) throw new ServiceException("Answer must be between 1 and 2000 characters"); q.setAnswer(a.trim());q.setAnsweredAt(new Date());q.setStatus(ProductQuestionStatus.PUBLISHED);return repo.save(q);}
+ public ProductQuestion reject(ProductQuestion q)throws ServiceException {q.setStatus(ProductQuestionStatus.REJECTED);return repo.save(q);}
+ public void deleteByProduct(Product p){repo.deleteByProduct(p);}
+}
