+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.*;
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.model.catalog.product.*;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductQuestionRequest;
+import com.salesmanager.shop.model.catalog.product.ProductAnswerRequest;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestionList;
+import com.salesmanager.shop.store.api.exception.*;
+import com.salesmanager.shop.store.api.exception.ConstraintException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController @RequestMapping("/api/v1")
+public class ProductQuestionApi {
+ @Inject private ProductQuestionService questions;
+ @Inject private ProductService products;
+ @Inject private CustomerService customers;
+ private Customer customer(Principal p){if(p==null) throw new UnauthorizedException(); Customer c=customers.getByNick(p.getName()); if(c==null) throw new UnauthorizedException(); return c;}
+ private Product product(String sku, MerchantStore store) {
+  try { Product p=products.getBySku(sku,store); if(p==null) throw new ResourceNotFoundException("Product not found"); return p; }
+  catch(ResourceNotFoundException e){throw e;} catch(Exception e){throw new ResourceNotFoundException("Product not found");}
+ }
+ private ReadableProductQuestion dto(ProductQuestion q){return new ReadableProductQuestion(q);}
+ @PostMapping("/auth/products/{sku}/questions") @ResponseStatus(HttpStatus.CREATED)
+ public ReadableProductQuestion ask(@PathVariable String sku,@RequestBody ProductQuestionRequest body,@ApiIgnore MerchantStore store,Principal principal) {
+  Customer c=customer(principal);
+  try { Product p=product(sku,store); ProductQuestion q=new ProductQuestion();q.setProduct(p);q.setMerchantStore(store);q.setCustomer(c);q.setText(body==null?null:body.getText());return dto(questions.ask(q)); }
+  catch(ResourceNotFoundException e){throw e;} catch(Exception e){throw new ConstraintException(e.getMessage());}
+ }
+ @GetMapping("/auth/customer/questions") public List<ReadableProductQuestion> mine(Principal p){List<ReadableProductQuestion> out=new ArrayList<>();for(ProductQuestion q:questions.listByCustomer(customer(p)))out.add(dto(q));return out;}
+ @GetMapping("/products/{sku}/questions") public ReadableProductQuestionList published(@PathVariable String sku,@ApiIgnore MerchantStore store){Product p=product(sku,store);List<ReadableProductQuestion> out=new ArrayList<>();for(ProductQuestion q:questions.listPublished(p))out.add(dto(q));return new ReadableProductQuestionList(out);}
+ @GetMapping("/private/questions") public List<ReadableProductQuestion> admin(@RequestParam(defaultValue="PENDING") String status,@ApiIgnore MerchantStore store){final ProductQuestionStatus s;try{s=ProductQuestionStatus.valueOf(status.toUpperCase());}catch(Exception e){throw new ConstraintException("Invalid question status");}List<ReadableProductQuestion> out=new ArrayList<>();for(ProductQuestion q:questions.listByStore(store,s))out.add(dto(q));return out;}
+ @PutMapping("/private/questions/{id}/answer") public ReadableProductQuestion answer(@PathVariable Long id,@RequestBody ProductAnswerRequest body,@ApiIgnore MerchantStore store){ProductQuestion q=questions.get(id);if(q==null||q.getMerchantStore().getId()!=store.getId())throw new ResourceNotFoundException("Question not found");if(q.getStatus()==ProductQuestionStatus.REJECTED)throw new ProductQuestionConflictException("Rejected question cannot be answered");try{return dto(questions.answer(q,body==null?null:body.getAnswer()));}catch(Exception e){throw new ConstraintException(e.getMessage());}}
+ @PutMapping("/private/questions/{id}/reject") public ReadableProductQuestion reject(@PathVariable Long id,@ApiIgnore MerchantStore store){ProductQuestion q=questions.get(id);if(q==null||q.getMerchantStore().getId()!=store.getId())throw new ResourceNotFoundException("Question not found");try{return dto(questions.reject(q));}catch(Exception e){throw new ConstraintException(e.getMessage());}}
+}
