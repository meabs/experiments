+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal; import java.util.*; import javax.inject.Inject; import javax.validation.Valid;
+import org.springframework.http.HttpStatus; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService; import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.ProductQuestion; import com.salesmanager.core.model.catalog.product.ProductQuestionStatus; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.catalog.product.*; import com.salesmanager.shop.store.api.exception.*; import springfox.documentation.annotations.ApiIgnore;
+
+@RestController @RequestMapping("/api/v1") public class ProductQuestionApi {
+ @Inject ProductService products; @Inject ProductQuestionService questions; @Inject CustomerService customers;
+ private ReadableProductQuestion read(ProductQuestion q){ ReadableProductQuestion r=new ReadableProductQuestion(); r.setId(q.getId()); r.setSku(q.getProduct().getSku()); r.setText(q.getText()); r.setAnswer(q.getAnswer()); r.setStatus(q.getStatus().name()); r.setAskedAt(q.getAskedAt()); r.setAnsweredAt(q.getAnsweredAt()); Customer c=q.getCustomer(); r.setAskedBy(c!=null&&c.getBilling()!=null?c.getBilling().getFirstName():null); return r; }
+ private Customer customer(Principal p, MerchantStore s){ if(p==null) throw new UnauthorizedException(); Customer c=customers.getByNick(p.getName(),s.getCode()); if(c==null) throw new UnauthorizedException(); return c; }
+ @PostMapping("/auth/products/{sku}/questions") @ResponseStatus(HttpStatus.CREATED) public ReadableProductQuestion ask(@PathVariable String sku,@Valid @RequestBody PersistableProductQuestion body,Principal p,@ApiIgnore MerchantStore store){ Customer c=customer(p,store); Product product; try{product=products.getBySku(sku,store);}catch(Exception e){throw new ResourceNotFoundException("Product not found");} if(product==null)throw new ResourceNotFoundException("Product not found"); if(questions.countPending(c.getId())>=3)throw new ServiceRuntimeException("400","At most 3 pending questions are allowed"); String text=body.getText()==null?null:body.getText().trim(); if(text==null||text.length()<10||text.length()>500)throw new ServiceRuntimeException("400","Question must be 10 to 500 characters"); ProductQuestion q=new ProductQuestion();q.setProduct(product);q.setCustomer(c);q.setText(text);q.setAskedAt(new Date());q.setStatus(ProductQuestionStatus.PENDING);questions.create(q);return read(q); }
+ @GetMapping("/auth/customer/questions") public List<ReadableProductQuestion> mine(Principal p,@ApiIgnore MerchantStore store){Customer c=customer(p,store);List<ReadableProductQuestion> out=new ArrayList<>();for(ProductQuestion q:questions.getByCustomer(c.getId()))out.add(read(q));return out;}
+ @GetMapping("/products/{sku}/questions") public Map<String,Object> published(@PathVariable String sku,@ApiIgnore MerchantStore store){Product p;try{p=products.getBySku(sku,store);}catch(Exception e){throw new ResourceNotFoundException("Product not found");}if(p==null)throw new ResourceNotFoundException("Product not found");List<Map<String,Object>> items=new ArrayList<>();for(ProductQuestion q:questions.getPublished(p)){Map<String,Object> m=new LinkedHashMap<>();m.put("id",q.getId());m.put("text",q.getText());m.put("answer",q.getAnswer());m.put("askedBy",q.getCustomer()!=null&&q.getCustomer().getBilling()!=null?q.getCustomer().getBilling().getFirstName():null);m.put("answeredAt",q.getAnsweredAt());items.add(m);}Map<String,Object> result=new LinkedHashMap<>();result.put("count",items.size());result.put("items",items);return result;}
+ @GetMapping("/private/questions") public List<ReadableProductQuestion> adminList(@RequestParam(defaultValue="PENDING") String status,@ApiIgnore MerchantStore store){ProductQuestionStatus st;try{st=ProductQuestionStatus.valueOf(status);}catch(Exception e){throw new ServiceRuntimeException("400","Invalid status");}List<ReadableProductQuestion> out=new ArrayList<>();for(ProductQuestion q:questions.getByStore(store.getCode(),st))out.add(read(q));return out;}
+ @PutMapping("/private/questions/{id}/answer") public ReadableProductQuestion answer(@PathVariable Long id,@Valid @RequestBody PersistableProductQuestion body,@ApiIgnore MerchantStore store){ProductQuestion q=questions.getById(id);if(q==null||q.getProduct().getMerchantStore()==null||!store.getCode().equals(q.getProduct().getMerchantStore().getCode()))throw new ResourceNotFoundException("Question not found");if(q.getStatus()==ProductQuestionStatus.REJECTED)throw new ServiceRuntimeException("409","Rejected question cannot be answered");String a=body.getAnswer()==null?null:body.getAnswer().trim();if(a==null||a.length()<1||a.length()>2000)throw new ServiceRuntimeException("400","Answer must be 1 to 2000 characters");q.setAnswer(a);q.setStatus(ProductQuestionStatus.PUBLISHED);q.setAnsweredAt(new Date());questions.update(q);return read(q);}
+ @PutMapping("/private/questions/{id}/reject") public ReadableProductQuestion reject(@PathVariable Long id,@ApiIgnore MerchantStore store){ProductQuestion q=questions.getById(id);if(q==null||q.getProduct().getMerchantStore()==null||!store.getCode().equals(q.getProduct().getMerchantStore().getCode()))throw new ResourceNotFoundException("Question not found");q.setStatus(ProductQuestionStatus.REJECTED);questions.update(q);return read(q);}
+}
