+package com.salesmanager.core.business.services.catalog.product;
+import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.ProductQuestionRepository;
+import com.salesmanager.core.model.catalog.product.*; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("productQuestionService") public class ProductQuestionServiceImpl implements ProductQuestionService {
+ @Inject private ProductQuestionRepository repo;
+ public ProductQuestion ask(Product p, Customer c, MerchantStore s, String text) { if(repo.countByCustomerIdAndStatus(c.getId(),ProductQuestionStatus.PENDING)>=3) throw new IllegalArgumentException("pending question limit"); ProductQuestion q=new ProductQuestion(); q.setProduct(p);q.setCustomer(c);q.setMerchantStore(s);q.setText(text.trim());q.setAskedAt(new Date());q.setStatus(ProductQuestionStatus.PENDING);return repo.saveAndFlush(q); }
+ public List<ProductQuestion> byCustomer(Customer c){return repo.findByCustomerIdOrderByAskedAtDesc(c.getId());} public List<ProductQuestion> published(Product p){return repo.findByProductIdAndStatusOrderByAnsweredAtDesc(p.getId(),ProductQuestionStatus.PUBLISHED);} public List<ProductQuestion> byStore(MerchantStore s,ProductQuestionStatus st){return repo.findByMerchantStoreIdAndStatusOrderByAskedAtAsc(s.getId(),st);} public ProductQuestion get(Long id){return repo.findById(id).orElse(null);}
+ public ProductQuestion answer(Long id,String answer, MerchantStore store){ProductQuestion q=repo.findByIdAndMerchantStoreId(id, store.getId());if(q==null) return null;if(q.getStatus()==ProductQuestionStatus.REJECTED) throw new IllegalStateException("rejected");q.setAnswer(answer.trim());q.setStatus(ProductQuestionStatus.PUBLISHED);q.setAnsweredAt(new Date());return repo.saveAndFlush(q);} public ProductQuestion reject(Long id, MerchantStore store){ProductQuestion q=repo.findByIdAndMerchantStoreId(id, store.getId());if(q==null)return null;q.setStatus(ProductQuestionStatus.REJECTED);return repo.saveAndFlush(q);}
+}
