diff --git a/sm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/ProductQuestionServiceImpl.java b/sm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/ProductQuestionServiceImpl.java
