+package com.salesmanager.shop.store.api.v1.product;
+import java.security.Principal; import java.util.*; import javax.inject.Inject; import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.HttpStatus; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.*; import com.salesmanager.core.business.services.customer.CustomerService; import com.salesmanager.core.model.catalog.product.*; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.catalog.product.*; import com.salesmanager.shop.store.api.exception.*; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class ProductQuestionApi {
+ @Inject private ProductQuestionService service; @Inject private ProductService products; @Inject private CustomerService customers;
+ private ReadableProductQuestion dto(ProductQuestion q, boolean full){ReadableProductQuestion d=new ReadableProductQuestion();d.setId(q.getId());d.setSku(q.getProduct().getSku());d.setText(q.getText());d.setStatus(q.getStatus().name());d.setAnswer(q.getAnswer());d.setAskedAt(q.getAskedAt());d.setAnsweredAt(q.getAnsweredAt());d.setAskedBy(q.getCustomer().getBilling()==null?null:q.getCustomer().getBilling().getFirstName()); if(!full){d.setStatus(null);d.setAskedAt(null);d.setSku(null);} return d;}
+ private Customer auth(HttpServletRequest r, MerchantStore s){Principal p=r.getUserPrincipal();if(p==null)throw new UnauthorizedException();Customer c=customers.getByNick(p.getName(),s.getId());if(c==null)throw new ResourceNotFoundException("Customer not found");return c;}
+ @PostMapping("/auth/products/{sku}/questions") @ResponseStatus(HttpStatus.CREATED) public ReadableProductQuestion ask(@PathVariable String sku,@RequestBody ProductQuestionRequest req,@ApiIgnore MerchantStore store,HttpServletRequest request){String t=req.getText()==null?null:req.getText().trim();if(t==null||t.length()<10||t.length()>500)throw new BadQuestionException();Customer customer=auth(request,store);try{com.salesmanager.core.model.catalog.product.Product p=products.getBySku(sku,store);if(p==null)throw new ResourceNotFoundException("Product not found");ProductQuestion q=service.ask(p,customer,store,t);return dto(q,true);}catch(BadQuestionException e){throw e;}catch(ResourceNotFoundException e){throw e;}catch(IllegalArgumentException e){throw new BadQuestionException();}catch(Exception e){throw new ResourceNotFoundException("Product not found");}}
+ @GetMapping("/auth/customer/questions") public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store,HttpServletRequest request){List<ReadableProductQuestion> out=new ArrayList<>();for(ProductQuestion q:service.byCustomer(auth(request,store)))out.add(dto(q,true));return out;}
+ @GetMapping("/products/{sku}/questions") public ReadableProductQuestionList published(@PathVariable String sku,@ApiIgnore MerchantStore store){try{com.salesmanager.core.model.catalog.product.Product p=products.getBySku(sku,store);if(p==null)throw new ResourceNotFoundException("Product not found");List<ReadableProductQuestion> out=new ArrayList<>();for(ProductQuestion q:service.published(p))out.add(dto(q,false));return new ReadableProductQuestionList(out);}catch(ResourceNotFoundException e){throw e;}catch(Exception e){throw new ResourceNotFoundException("Product not found");}}
+ @GetMapping("/private/questions") public List<ReadableProductQuestion> admin(@RequestParam(defaultValue="PENDING") String status,@ApiIgnore MerchantStore store){ProductQuestionStatus s;try{s=ProductQuestionStatus.valueOf(status);}catch(Exception e){throw new BadQuestionException();}List<ReadableProductQuestion> out=new ArrayList<>();for(ProductQuestion q:service.byStore(store,s))out.add(dto(q,true));return out;}
+ @PutMapping("/private/questions/{id}/answer") public ReadableProductQuestion answer(@PathVariable Long id,@RequestBody ProductQuestionRequest req,@ApiIgnore MerchantStore store){String a=req.getAnswer()==null?null:req.getAnswer().trim();if(a==null||a.length()<1||a.length()>2000)throw new BadQuestionException();try{ProductQuestion q=service.answer(id,a,store);if(q==null)throw new ResourceNotFoundException("Question not found");return dto(q,true);}catch(IllegalStateException e){throw new QuestionConflictException();}}
+ @PutMapping("/private/questions/{id}/reject") public ReadableProductQuestion reject(@PathVariable Long id,@ApiIgnore MerchantStore store){ProductQuestion q=service.reject(id,store);if(q==null)throw new ResourceNotFoundException("Question not found");return dto(q,true);}
+}
