@@ -0,0 +1,19 @@
+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal; import java.util.*; import javax.inject.Inject; import javax.servlet.http.HttpServletRequest; import org.springframework.http.HttpStatus; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.*; import com.salesmanager.core.model.catalog.product.*; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.catalog.product.*; import com.salesmanager.shop.store.api.exception.*; import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade; import springfox.documentation.annotations.ApiIgnore;
+
+@RestController @RequestMapping("/api/v1") public class ProductQuestionApi {
+ @Inject ProductQuestionService service; @Inject ProductService products; @Inject CustomerFacade customers;
+ private com.salesmanager.core.model.catalog.product.Product product(String sku, MerchantStore store){ com.salesmanager.core.model.catalog.product.Product p; try {p=products.getBySku(sku,store);}catch(Exception e){p=null;} if(p==null) throw new ResourceNotFoundException("Product not found"); return p; }
+ private Customer customer(HttpServletRequest req, MerchantStore store){ Principal p=req.getUserPrincipal(); if(p==null) throw new UnauthorizedException(); Customer c=customers.getCustomerByUserName(p.getName(),store); if(c==null) throw new ResourceNotFoundException("Customer not found"); return c; }
+ private String clean(String s,int min,int max){if(s==null) throw new ServiceRuntimeException("400","Invalid text"); s=s.trim(); if(s.length()<min||s.length()>max) throw new ServiceRuntimeException("400","Invalid text length"); return s;}
+ private ProductQuestionResponse full(ProductQuestion q){ProductQuestionResponse r=new ProductQuestionResponse();r.setId(q.getId());r.setSku(q.getProduct().getSku());r.setText(q.getText());r.setStatus(q.getStatus().name());r.setAnswer(q.getAnswer());r.setAskedAt(q.getAskedAt());r.setAnsweredAt(q.getAnsweredAt());r.setAskedBy(q.getCustomer().getBilling()==null?null:q.getCustomer().getBilling().getFirstName());return r;}
+ @PostMapping("/auth/products/{sku}/questions") @ResponseStatus(HttpStatus.CREATED) public ProductQuestionResponse ask(@PathVariable String sku,@RequestBody ProductQuestionRequest body,@ApiIgnore MerchantStore store,HttpServletRequest req){Customer c=customer(req,store); com.salesmanager.core.model.catalog.product.Product p=product(sku,store); if(service.pending(c)>=3) throw new ServiceRuntimeException("400","Too many pending questions"); ProductQuestion q=new ProductQuestion();q.setProduct(p);q.setCustomer(c);q.setText(clean(body.getText(),10,500));q.setAskedAt(new Date());q.setStatus(ProductQuestionStatus.PENDING);return full(service.ask(q));}
+ @GetMapping("/auth/customer/questions") public List<ProductQuestionResponse> mine(@ApiIgnore MerchantStore store,HttpServletRequest req){List<ProductQuestionResponse> out=new ArrayList<>();for(ProductQuestion q:service.byCustomer(customer(req,store)))out.add(full(q));return out;}
+ @GetMapping("/products/{sku}/questions") public ProductQuestionList published(@PathVariable String sku,@ApiIgnore MerchantStore store){List<PublicProductQuestion> out=new ArrayList<>();for(ProductQuestion q:service.publicByProduct(product(sku,store))){PublicProductQuestion r=new PublicProductQuestion();r.setId(q.getId());r.setText(q.getText());r.setAnswer(q.getAnswer());r.setAnsweredAt(q.getAnsweredAt());r.setAskedBy(q.getCustomer().getBilling()==null?null:q.getCustomer().getBilling().getFirstName());out.add(r);}return new ProductQuestionList(out);}
+ @GetMapping("/private/questions") public List<ProductQuestionResponse> admin(@RequestParam(defaultValue="PENDING") String status,@ApiIgnore MerchantStore store){ProductQuestionStatus st;try{st=ProductQuestionStatus.valueOf(status);}catch(Exception e){throw new ServiceRuntimeException("400","Invalid status");}List<ProductQuestionResponse> out=new ArrayList<>();for(ProductQuestion q:service.byStore(store,st))out.add(full(q));return out;}
+ private ProductQuestion owned(Long id,MerchantStore store){ProductQuestion q=service.find(id).orElseThrow(()->new ResourceNotFoundException("Question not found"));if(q.getProduct().getMerchantStore().getId().longValue()!=store.getId().longValue())throw new ResourceNotFoundException("Question not found");return q;}
+ @PutMapping("/private/questions/{id}/answer") public ProductQuestionResponse answer(@PathVariable Long id,@RequestBody ProductQuestionRequest body,@ApiIgnore MerchantStore store){ProductQuestion q=owned(id,store);if(q.getStatus()==ProductQuestionStatus.REJECTED)throw new ConflictException("Rejected question cannot be answered");q.setAnswer(clean(body.getAnswer(),1,2000));q.setStatus(ProductQuestionStatus.PUBLISHED);q.setAnsweredAt(new Date());try{service.update(q);}catch(Exception e){throw new ServiceRuntimeException(e);}return full(q);}
+ @PutMapping("/private/questions/{id}/reject") public ProductQuestionResponse reject(@PathVariable Long id,@ApiIgnore MerchantStore store){ProductQuestion q=owned(id,store);q.setStatus(ProductQuestionStatus.REJECTED);try{service.update(q);}catch(Exception e){throw new ServiceRuntimeException(e);}return full(q);}
+}
