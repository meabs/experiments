+package com.salesmanager.shop.store.api.v1.product;
+import java.security.Principal; import java.util.*; import javax.inject.Inject; import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.HttpStatus; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductQuestionService; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.customer.CustomerService; import com.salesmanager.core.model.catalog.product.ProductQuestion; import com.salesmanager.core.model.catalog.product.ProductQuestionStatus; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.catalog.product.PersistableProductQuestion; import com.salesmanager.shop.model.catalog.product.ReadableProductQuestion; import com.salesmanager.shop.model.catalog.product.ReadableProductQuestionList; import com.salesmanager.shop.store.api.exception.*; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class ProductQuestionApi {
+ @Inject private ProductQuestionService questions; @Inject private ProductService products; @Inject private CustomerService customers;
+ private String trim(String s,int min,int max){if(s==null)throw new ServiceRuntimeException("400","Text is required");s=s.trim();if(s.length()<min||s.length()>max)throw new ServiceRuntimeException("400","Invalid length");return s;}
+ private Customer customer(HttpServletRequest r){Principal p=r.getUserPrincipal();if(p==null)throw new UnauthorizedException("Customer authentication required");Customer c=customers.getByNick(p.getName());if(c==null)throw new UnauthorizedException("Customer authentication required");return c;}
+ private com.salesmanager.core.model.catalog.product.Product product(String sku,MerchantStore store){try{com.salesmanager.core.model.catalog.product.Product p=products.getBySku(sku,store);if(p==null)throw new ResourceNotFoundException("Unknown sku");return p;}catch(ResourceNotFoundException e){throw e;}catch(Exception e){throw new ResourceNotFoundException("Unknown sku");}}
+ private ReadableProductQuestion dto(ProductQuestion q,boolean publicOnly){ReadableProductQuestion d=new ReadableProductQuestion();d.setId(q.getId());d.setSku(q.getProduct().getSku());d.setText(q.getText());d.setStatus(q.getStatus().name());d.setAnswer(q.getAnswer());d.setAskedAt(q.getAskedAt());d.setAnsweredAt(q.getAnsweredAt());String n=null;if(q.getCustomer().getBilling()!=null)n=q.getCustomer().getBilling().getFirstName();d.setAskedBy(n);return d;}
+ @PostMapping("/auth/products/{sku}/questions") @ResponseStatus(HttpStatus.CREATED) public ReadableProductQuestion ask(@PathVariable String sku,@RequestBody PersistableProductQuestion body,@ApiIgnore MerchantStore store,HttpServletRequest request){Customer c=customer(request);if(questions.pendingCount(c)>=3)throw new ServiceRuntimeException("400","Too many pending questions");com.salesmanager.core.model.catalog.product.Product p=product(sku,store);return dto(questions.ask(p,c,trim(body.getText(),10,500)),false);}
+ @GetMapping("/auth/customer/questions") public List<ReadableProductQuestion> mine(HttpServletRequest request){List<ReadableProductQuestion> out=new ArrayList<>();for(ProductQuestion q:questions.byCustomer(customer(request)))out.add(dto(q,false));return out;}
+ @GetMapping("/products/{sku}/questions") public ReadableProductQuestionList published(@PathVariable String sku,@ApiIgnore MerchantStore store){com.salesmanager.core.model.catalog.product.Product p=product(sku,store);List<ReadableProductQuestion> out=new ArrayList<>();for(ProductQuestion q:questions.published(p)){ReadableProductQuestion d=dto(q,true);d.setSku(null);d.setStatus(null);d.setAskedAt(null);out.add(d);}return new ReadableProductQuestionList(out);}
+ @GetMapping("/private/questions") public List<ReadableProductQuestion> admin(@RequestParam(defaultValue="PENDING") String status,@ApiIgnore MerchantStore store){ProductQuestionStatus st;try{st=ProductQuestionStatus.valueOf(status);}catch(Exception e){throw new ServiceRuntimeException("400","Invalid status");}List<ReadableProductQuestion> out=new ArrayList<>();for(ProductQuestion q:questions.byStore(store,st))out.add(dto(q,false));return out;}
+ @PutMapping("/private/questions/{id}/answer") public ReadableProductQuestion answer(@PathVariable Long id,@RequestBody PersistableProductQuestion body,@ApiIgnore MerchantStore store){ProductQuestion q=questions.find(id);if(q==null||q.getProduct().getMerchantStore().getId().intValue()!=store.getId().intValue())throw new ResourceNotFoundException("Unknown question");if(q.getStatus()==ProductQuestionStatus.REJECTED)throw new ServiceRuntimeException("409","Rejected question cannot be answered");q.setAnswer(trim(body.getAnswer(),1,2000));q.setStatus(ProductQuestionStatus.PUBLISHED);q.setAnsweredAt(new Date());questions.persist(q);return dto(q,false);}
+ @PutMapping("/private/questions/{id}/reject") public ReadableProductQuestion reject(@PathVariable Long id,@ApiIgnore MerchantStore store){ProductQuestion q=questions.find(id);if(q==null||q.getProduct().getMerchantStore().getId().intValue()!=store.getId().intValue())throw new ResourceNotFoundException("Unknown question");q.setStatus(ProductQuestionStatus.REJECTED);questions.persist(q);return dto(q,false);}
+}
