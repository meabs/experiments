+package com.salesmanager.core.business.services.catalog.product;
+import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service; import com.salesmanager.core.business.repositories.catalog.product.ProductQuestionRepository; import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl; import com.salesmanager.core.model.catalog.product.*; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("productQuestionService") public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long,ProductQuestion> implements ProductQuestionService {
+ private final ProductQuestionRepository repo; @Inject public ProductQuestionServiceImpl(ProductQuestionRepository r){super(r);repo=r;}
+ public ProductQuestion ask(Product p,Customer c,String text){ProductQuestion q=new ProductQuestion();q.setProduct(p);q.setCustomer(c);q.setText(text);q.setAskedAt(new Date());return repo.saveAndFlush(q);}
+ public List<ProductQuestion> byCustomer(Customer c){return repo.findByCustomerIdOrderByAskedAtDesc(c.getId());}
+ public List<ProductQuestion> published(Product p){return repo.findByProductIdAndStatusOrderByAnsweredAtDesc(p.getId(),ProductQuestionStatus.PUBLISHED);}
+ public List<ProductQuestion> byStore(MerchantStore s,ProductQuestionStatus st){return repo.findByProductMerchantStoreIdAndStatusOrderByAskedAtAsc(s.getId(),st);}
+ public long pendingCount(Customer c){return repo.countByCustomerIdAndStatus(c.getId(),ProductQuestionStatus.PENDING);}
+ public ProductQuestion find(Long id){return repo.findWithAssociations(id);} public ProductQuestion persist(ProductQuestion q){return repo.saveAndFlush(q);}
+}
