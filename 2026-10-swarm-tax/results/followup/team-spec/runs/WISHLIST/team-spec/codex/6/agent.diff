+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.pricing.PricingService;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.business.services.wishlist.WishlistService;
+import com.salesmanager.core.business.services.shoppingcart.ShoppingCartService;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.description.ProductDescription;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+
+@RestController
+@RequestMapping("/api/v1")
+public class WishlistApi {
+ @Inject private WishlistService wishlistService; @Inject private ProductService productService;
+ @Inject private CustomerFacade customerFacade; @Inject private CustomerService customerService;
+ @Inject private PricingService pricingService; @Inject private ShoppingCartFacade shoppingCartFacade;
+ @Inject private ShoppingCartService shoppingCartService;
+
+ private Customer customer(HttpServletRequest r, MerchantStore s){Principal p=r.getUserPrincipal(); if(p==null)throw new ResourceNotFoundException("Customer authentication required"); Customer c=customerFacade.getCustomerByUserName(p.getName(),s); if(c==null)throw new ResourceNotFoundException("Customer not found"); return c;}
+ private Product product(String sku,MerchantStore s){try{return productService.getBySku(sku,s,s.getDefaultLanguage());}catch(Exception e){return null;}}
+ private WishlistResponse response(Customer c,MerchantStore s,Language l){List<com.salesmanager.core.model.wishlist.WishlistItem> rows=wishlistService.list(c.getId(),s.getId()); WishlistResponse out=new WishlistResponse();for(com.salesmanager.core.model.wishlist.WishlistItem row:rows){Product p=product(row.getSku(),s);if(p!=null)out.items.add(item(p,row.getAddedAt(),l));}out.count=out.items.size();return out;}
+ private boolean available(Product p){
+  if(!p.isAvailable() || p.getAvailabilities()==null || p.getAvailabilities().isEmpty()) return false;
+  for(ProductAvailability a:p.getAvailabilities()) if(a.getProductQuantity()!=null && a.getProductQuantity()>0) return true;
+  return false;
+ }
+ private WishlistItemResponse item(Product p,Date added,Language l){WishlistItemResponse x=new WishlistItemResponse();x.sku=p.getSku();ProductDescription d=productService.getProductDescription(p,l);x.name=d==null?p.getSku():d.getName();try{x.price=pricingService.calculateProductPrice(p).getFinalPrice();}catch(Exception e){}x.available=available(p);x.addedAt=added;return x;}
+
+ @PostMapping("/auth/customer/wishlist") public ResponseEntity<WishlistResponse> add(@Valid @RequestBody WishlistRequest req,MerchantStore s,Language l,HttpServletRequest r){if(req==null||req.product==null||req.product.trim().isEmpty())return ResponseEntity.badRequest().build();Product p=product(req.product,s);if(p==null)return ResponseEntity.notFound().build();try{boolean created=wishlistService.add(customer(r,s).getId(),s.getId(),p.getId(),p.getSku());return new ResponseEntity<>(response(customer(r,s),s,l),created?HttpStatus.CREATED:HttpStatus.OK);}catch(ServiceException e){return ResponseEntity.badRequest().build();}}
+ @GetMapping("/auth/customer/wishlist") public WishlistResponse get(MerchantStore s,Language l,HttpServletRequest r){return response(customer(r,s),s,l);}
+ @DeleteMapping("/auth/customer/wishlist/{sku}") public ResponseEntity<Void> remove(@PathVariable String sku,MerchantStore s,HttpServletRequest r){if(!wishlistService.remove(customer(r,s).getId(),s.getId(),sku))return ResponseEntity.notFound().build();return ResponseEntity.noContent().build();}
+ @PostMapping("/auth/customer/wishlist/{sku}/cart/{cartCode}") @Transactional public ResponseEntity<?> move(@PathVariable String sku,@PathVariable String cartCode,MerchantStore s,Language l,HttpServletRequest r){Customer c=customer(r,s);if(wishlistService.find(c.getId(),s.getId(),sku)==null)return ResponseEntity.notFound().build();Product p=product(sku,s);if(p==null)return ResponseEntity.notFound().build();if(!available(p))return ResponseEntity.status(HttpStatus.CONFLICT).build();try{ShoppingCart cart=shoppingCartService.getByCode(cartCode,s);if(cart==null)return ResponseEntity.notFound().build();ShoppingCartItem found=null;for(ShoppingCartItem ci:cart.getLineItems())if(sku.equals(ci.getSku())){found=ci;break;}if(found!=null)found.setQuantity(found.getQuantity()+1);else{found=shoppingCartService.populateShoppingCartItem(p,s);found.setShoppingCart(cart);cart.getLineItems().add(found);}shoppingCartService.saveOrUpdate(cart);ReadableShoppingCart result=shoppingCartFacade.readableCart(cart,s,l);if(!wishlistService.remove(c.getId(),s.getId(),sku))throw new IllegalStateException("Wishlist item disappeared during cart move");return ResponseEntity.ok(result);}catch(ServiceException e){throw new ServiceRuntimeException(e);}}
+ @GetMapping("/private/wishlists/popular") public List<PopularResponse> popular(MerchantStore s){List<PopularResponse> out=new ArrayList<>();for(Object[] x:wishlistService.popular(s.getId()))out.add(new PopularResponse((String)x[0],((Number)x[1]).intValue()));return out;}
+ public static class WishlistRequest {public String product; public String getProduct(){return product;} public void setProduct(String v){product=v;}}
+ public static class WishlistResponse {public int count;public List<WishlistItemResponse> items=new ArrayList<>();public int getCount(){return count;}public List<WishlistItemResponse> getItems(){return items;}}
+ public static class WishlistItemResponse {public String sku,name;public BigDecimal price;public boolean available;public Date addedAt;public String getSku(){return sku;}public String getName(){return name;}public BigDecimal getPrice(){return price;}public boolean isAvailable(){return available;}public Date getAddedAt(){return addedAt;}}
+ public static class PopularResponse {public String sku;public int count;public PopularResponse(String s,int c){sku=s;count=c;}public String getSku(){return sku;}public int getCount(){return count;}}
+}
