+package com.salesmanager.core.business.services.wishlist;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.wishlist.WishlistRepository;
+import com.salesmanager.core.model.wishlist.WishlistItem;
+@Service("wishlistService")
+public class WishlistServiceImpl implements WishlistService {
+ @Inject private WishlistRepository repository;
+ public List<WishlistItem> list(Long c,Integer s){return repository.findByCustomerIdAndMerchantIdOrderByAddedAtDesc(c,s);}
+ public WishlistItem find(Long c,Integer s,String sku){return repository.findByCustomerIdAndMerchantIdAndSku(c,s,sku);}
+ @Transactional public boolean add(Long c,Integer s,Long p,String sku) throws ServiceException {
+   if(find(c,s,sku)!=null)return false;
+   if(repository.countByCustomerIdAndMerchantId(c,s)>=50) throw new ServiceException("Wishlist limit is 50");
+   WishlistItem i=new WishlistItem(); i.setCustomerId(c);i.setMerchantId(s);i.setProductId(p);i.setSku(sku);i.setAddedAt(new Date());repository.saveAndFlush(i);return true;
+ }
+ @Transactional public boolean remove(Long c,Integer s,String sku){WishlistItem i=find(c,s,sku);if(i==null)return false;repository.delete(i);return true;}
+ @Transactional public void removeProduct(Long p){repository.deleteByProductId(p);}
+ public List<Object[]> popular(Integer s){List<Object[]> all=repository.popular(s);return all.size()>10?all.subList(0,10):all;}
+}
