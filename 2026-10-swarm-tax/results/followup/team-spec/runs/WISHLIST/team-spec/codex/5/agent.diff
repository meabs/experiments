+package com.salesmanager.shop.store.api.v1.customer;
+import java.security.Principal; import java.math.BigDecimal; import java.util.*; import javax.inject.Inject; import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.*; import org.springframework.stereotype.Controller; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.customer.WishlistService; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.customer.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.customer.ReadableWishlist; import com.salesmanager.shop.model.customer.WishlistProduct; import com.salesmanager.shop.model.customer.WishlistRequest; import com.salesmanager.shop.model.shoppingcart.*; import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade; import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade; import com.salesmanager.shop.store.api.exception.*;
+@Controller @RequestMapping("/api/v1") public class WishlistApi {
+ @Inject WishlistService wishlist; @Inject ProductService products; @Inject CustomerFacade customers; @Inject ShoppingCartFacade carts;
+ private Customer customer(HttpServletRequest r,MerchantStore s){Principal p=r.getUserPrincipal(); if(p==null) throw new ResourceNotFoundException("Customer not found"); Customer c=customers.getCustomerByUserName(p.getName(),s); if(c==null) throw new ResourceNotFoundException("Customer not found"); return c;}
+ private ReadableWishlist view(Customer c,MerchantStore s){ReadableWishlist out=new ReadableWishlist(); List<WishlistProduct> a=new ArrayList<>(); for(WishlistItem w:wishlist.list(c,s)){Product p=w.getProduct(); BigDecimal price=BigDecimal.ZERO; boolean avail=p.isAvailable(); if(p.getAvailabilities()!=null&&!p.getAvailabilities().isEmpty()){com.salesmanager.core.model.catalog.product.availability.ProductAvailability av=p.getAvailabilities().iterator().next(); avail=avail&&av.getProductQuantity()!=null&&av.getProductQuantity()>0; if(av.defaultPrice()!=null) price=av.defaultPrice().getProductPriceAmount();} String n=p.getProductDescription()==null?null:p.getProductDescription().getName(); a.add(new WishlistProduct(p.getSku(),n,price,avail,w.getAddedAt()));} out.setItems(a);out.setCount(a.size());return out;}
+ @PostMapping("/auth/customer/wishlist") public ResponseEntity<ReadableWishlist> add(@RequestBody WishlistRequest req,@RequestAttribute MerchantStore store,HttpServletRequest r){ if(req==null||req.getProduct()==null||req.getProduct().trim().isEmpty()) throw new IllegalArgumentException("product is required"); Customer c=customer(r,store); Product p; try{p=products.getBySku(req.getProduct(),store);}catch(Exception e){throw new ResourceNotFoundException("Product not found");} if(p==null) throw new ResourceNotFoundException("Product not found"); if(wishlist.find(c,store,req.getProduct())!=null)return new ResponseEntity<>(view(c,store),HttpStatus.OK); if(wishlist.list(c,store).size()>=50)throw new IllegalArgumentException("Wishlist limit exceeded"); wishlist.add(c,store,p);return new ResponseEntity<>(view(c,store),HttpStatus.CREATED); }
+ @GetMapping("/auth/customer/wishlist") public ReadableWishlist get(@RequestAttribute MerchantStore store,HttpServletRequest r){return view(customer(r,store),store);}
+ @DeleteMapping("/auth/customer/wishlist/{sku}") public ResponseEntity<Void> remove(@PathVariable String sku,@RequestAttribute MerchantStore store,HttpServletRequest r){Customer c=customer(r,store);if(wishlist.find(c,store,sku)==null)throw new ResourceNotFoundException("Wishlist item not found");wishlist.remove(c,store,sku);return ResponseEntity.noContent().build();}
+ @PostMapping("/auth/customer/wishlist/{sku}/cart/{cartCode}") public ReadableShoppingCart cart(@PathVariable String sku,@PathVariable String cartCode,@RequestAttribute MerchantStore store,@RequestAttribute Language language,HttpServletRequest r){Customer c=customer(r,store);WishlistItem w=wishlist.find(c,store,sku);if(w==null)throw new ResourceNotFoundException("Wishlist item not found"); Product p=w.getProduct();if(!p.isAvailable()||p.getAvailabilities()==null||p.getAvailabilities().isEmpty()||p.getAvailabilities().iterator().next().getProductQuantity()==null||p.getAvailabilities().iterator().next().getProductQuantity()<=0)throw new OperationNotAllowedException("Product unavailable"); try{if(carts.getShoppingCartModel(cartCode,store)==null)throw new ResourceNotFoundException("Cart not found"); PersistableShoppingCartItem i=new PersistableShoppingCartItem();i.setProduct(sku);i.setQuantity(1);ReadableShoppingCart result=carts.modifyCart(cartCode,i,store,language);wishlist.remove(c,store,sku);return result;}catch(ResourceNotFoundException e){throw e;}catch(Exception e){throw new ServiceRuntimeException(e);}}
+ @GetMapping("/private/wishlists/popular") public List<Map<String,Object>> popular(@RequestAttribute MerchantStore store){List<Map<String,Object>> out=new ArrayList<>();for(Object[] x:wishlist.popular(store)){Map<String,Object> m=new LinkedHashMap<>();m.put("sku",x[0]);m.put("count",((Number)x[1]).longValue());out.add(m);if(out.size()==10)break;}out.sort((a,b)->{int c=Long.compare((Long)b.get("count"),(Long)a.get("count"));return c!=0?c:((String)a.get("sku")).compareTo((String)b.get("sku"));});return out;}
+}
