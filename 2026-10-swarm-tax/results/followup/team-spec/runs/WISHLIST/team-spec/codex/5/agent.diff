+package com.salesmanager.core.business.services.customer;
+import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.customer.WishlistItemRepository; import com.salesmanager.core.model.customer.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.catalog.product.Product;
+@Service("wishlistService") public class WishlistServiceImpl implements WishlistService {
+ @Inject WishlistItemRepository repo;
+ public List<WishlistItem> list(Customer c,MerchantStore s){return repo.findByCustomerIdAndMerchantStoreIdOrderByAddedAtDesc(c.getId(),s.getId());}
+ public WishlistItem find(Customer c,MerchantStore s,String sku){return repo.findByCustomerIdAndMerchantStoreIdAndProductSku(c.getId(),s.getId(),sku);}
+ @Transactional
+ public WishlistItem add(Customer c,MerchantStore s,Product p){WishlistItem existing=repo.findByCustomerIdAndMerchantStoreIdAndProductSku(c.getId(),s.getId(),p.getSku()); if(existing!=null)return existing; if(repo.countByCustomerIdAndMerchantStoreId(c.getId(),s.getId())>=50) throw new IllegalStateException("Wishlist limit exceeded"); WishlistItem w=new WishlistItem();w.setCustomer(c);w.setMerchantStore(s);w.setProduct(p);w.setAddedAt(new Date());return repo.save(w);}
+ public void remove(Customer c,MerchantStore s,String sku){repo.deleteByCustomerIdAndMerchantStoreIdAndProductSku(c.getId(),s.getId(),sku);}
+ public void removeProduct(Long id){repo.deleteByProductId(id);} public List<Object[]> popular(MerchantStore s){List<Object[]> result=repo.popular(s.getId()); result.sort((a,b)->{int c=Long.compare(((Number)b[1]).longValue(),((Number)a[1]).longValue()); return c!=0?c:String.valueOf(a[0]).compareTo(String.valueOf(b[0]));}); return result;}
+}
