+package com.salesmanager.shop.store.api.v1.customer;
+import java.math.BigDecimal; import java.security.Principal; import java.util.*; import javax.inject.Inject; import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.*; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.model.customer.Wishlist;
+import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.customer.WishlistService; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.reference.language.Language; import com.salesmanager.shop.model.customer.PersistableWishlist; import com.salesmanager.shop.model.customer.ReadableWishlist; import com.salesmanager.shop.model.customer.WishlistItem; import com.salesmanager.shop.model.customer.WishlistProduct; import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem; import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart; import com.salesmanager.shop.store.api.exception.*; import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade; import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class WishlistApi {
+ @Inject private WishlistService service; @Inject private ProductService products; @Inject private CustomerFacade customers; @Inject private ShoppingCartFacade carts;
+ private Customer customer(HttpServletRequest r,MerchantStore s){Principal p=r.getUserPrincipal(); if(p==null)throw new UnauthorizedException(); Customer c=customers.getCustomerByUserName(p.getName(),s); if(c==null)throw new UnauthorizedException(); return c;}
+ private Product product(String sku,MerchantStore s){if(sku==null||sku.trim().isEmpty())throw new ConstraintException("product is required"); try{Product p=products.getBySku(sku,s);if(p==null)throw new ResourceNotFoundException("Product not found");return p;}catch(ServiceException e){throw new ResourceNotFoundException("Product not found");}}
+ private boolean available(Product p){if(!p.isAvailable()||p.getAvailabilities()==null)return false;return p.getAvailabilities().stream().anyMatch(a->Boolean.TRUE.equals(a.getAvailable())&&a.getProductStatus()&&a.getProductQuantity()!=null&&a.getProductQuantity()>0);}
+ private ReadableWishlist dto(Customer c){ReadableWishlist w=new ReadableWishlist(); List<WishlistItem> out=new ArrayList<>(); for(Wishlist x:service.list(c)){Product p=x.getProduct();String name=p.getSku();if(p.getDescriptions()!=null&&!p.getDescriptions().isEmpty())name=p.getDescriptions().iterator().next().getName();BigDecimal price=null;if(p.getAvailabilities()!=null)for(com.salesmanager.core.model.catalog.product.availability.ProductAvailability a:p.getAvailabilities())if(a.defaultPrice()!=null&&a.defaultPrice().getProductPriceAmount()!=null){price=a.defaultPrice().getProductPriceAmount();break;}out.add(new WishlistItem(p.getSku(),name,price,available(p),x.getAddedAt()));}w.setItems(out);w.setCount(out.size());return w;}
+ @GetMapping("/auth/customer/wishlist") public ReadableWishlist list(@ApiIgnore MerchantStore s,HttpServletRequest r){return dto(customer(r,s));}
+ @PostMapping("/auth/customer/wishlist") public ResponseEntity<ReadableWishlist> add(@RequestBody PersistableWishlist in,@ApiIgnore MerchantStore s,HttpServletRequest r){Customer c=customer(r,s);Product p=product(in==null?null:in.getProduct(),s);boolean exists=service.find(c,p)!=null;try{service.add(c,p,s);}catch(ServiceException e){throw new ConstraintException(e.getMessage());}return new ResponseEntity<>(dto(c),exists?HttpStatus.OK:HttpStatus.CREATED);}
+ @DeleteMapping("/auth/customer/wishlist/{sku}") @ResponseStatus(HttpStatus.NO_CONTENT) public void remove(@PathVariable String sku,@ApiIgnore MerchantStore s,HttpServletRequest r){Customer c=customer(r,s);Product p=product(sku,s);if(service.find(c,p)==null)throw new ResourceNotFoundException("Wishlist item not found");service.remove(c,p);}
+ @PostMapping("/auth/customer/wishlist/{sku}/cart/{code}") public ReadableShoppingCart move(@PathVariable String sku,@PathVariable String code,@ApiIgnore MerchantStore s,@ApiIgnore Language l,HttpServletRequest r){Customer c=customer(r,s);Product p=product(sku,s);if(service.find(c,p)==null)throw new ResourceNotFoundException("Wishlist item not found");if(!available(p))throw new org.springframework.web.server.ResponseStatusException(HttpStatus.CONFLICT);PersistableShoppingCartItem i=new PersistableShoppingCartItem();i.setProduct(sku);i.setQuantity(1);try{ReadableShoppingCart out=carts.modifyCart(code,i,s,l);service.remove(c,p);return out;}catch(ResourceNotFoundException e){throw e;}catch(ServiceRuntimeException e){throw e;}catch(Exception e){throw new ServiceRuntimeException(e);}}
+ @GetMapping("/private/wishlists/popular") public List<WishlistProduct> popular(@ApiIgnore MerchantStore s){List<WishlistProduct> out=new ArrayList<>();for(Object[] x:service.popular(s))out.add(new WishlistProduct((String)x[0],((Number)x[1]).longValue()));return out;}
+}
