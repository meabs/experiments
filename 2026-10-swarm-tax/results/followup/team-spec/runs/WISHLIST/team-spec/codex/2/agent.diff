+package com.salesmanager.core.business.services.customer;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.customer.WishlistRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("wishlistService") public class WishlistServiceImpl implements WishlistService {
+ @Inject private WishlistRepository repo;
+ public List<Wishlist> list(Customer c){return repo.findByCustomerIdOrderByAddedAtDesc(c.getId());}
+ public Wishlist find(Customer c,Product p){return repo.findByCustomerIdAndProductId(c.getId(),p.getId());}
+ @Transactional public Wishlist add(Customer c,Product p,MerchantStore s)throws ServiceException { Wishlist old=find(c,p); if(old!=null)return old; if(list(c).size()>=50) throw new ServiceException("Wishlist limit reached"); Wishlist w=new Wishlist();w.setCustomer(c);w.setProduct(p);w.setMerchantStore(s); return repo.save(w); }
+ @Transactional public void remove(Customer c,Product p){repo.deleteByCustomerIdAndProductId(c.getId(),p.getId());}
+ @Transactional public void removeProduct(Product p){repo.deleteByProductId(p.getId());}
+ public List<Object[]> popular(MerchantStore s){List<Object[]> all=repo.popular(s.getId());return all.subList(0,Math.min(10,all.size()));}
+}
