+package com.salesmanager.shop.store.api.v1.customer;
+import java.security.Principal; import java.util.*; import javax.inject.Inject; import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.*; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.customer.WishlistService; import com.salesmanager.core.business.services.shoppingcart.ShoppingCartService; import com.salesmanager.core.model.catalog.product.*; import com.salesmanager.core.model.customer.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.reference.language.Language; import com.salesmanager.shop.model.shoppingcart.*; import com.salesmanager.shop.model.wishlist.*; import com.salesmanager.shop.store.api.exception.*; import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade; import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class WishlistApi {
+ @Inject WishlistService wishlist; @Inject CustomerFacade customers; @Inject ProductService products; @Inject ShoppingCartFacade carts;
+ private Customer customer(HttpServletRequest r,MerchantStore s){ Principal p=r.getUserPrincipal(); if(p==null) throw new UnauthorizedException(); Customer c=customers.getCustomerByUserName(p.getName(),s); if(c==null)throw new ResourceNotFoundException("Customer not found"); return c; }
+ private Product product(String sku,MerchantStore s){if(sku==null||sku.trim().isEmpty()) throw new ServiceRuntimeException("400","Product is required",new IllegalArgumentException("product")); try {Product p=products.getBySku(sku,s);if(p==null)throw new ResourceNotFoundException("Product not found");return p;}catch(Exception e){if(e instanceof ResourceNotFoundException)throw (ResourceNotFoundException)e;throw new ResourceNotFoundException("Product not found");}}
+ private ReadableWishlist readable(Customer c,MerchantStore s){ReadableWishlist out=new ReadableWishlist();try{for(WishlistItem w:wishlist.get(c,s)){Product p=w.getProduct();WishlistProduct x=new WishlistProduct();x.setSku(p.getSku());x.setName(p.getProductDescription()==null?null:p.getProductDescription().getName());x.setAddedAt(w.getAddedAt());x.setAvailable(p.isAvailable()&&p.getAvailabilities().stream().anyMatch(a->a.getProductQuantity()!=null&&a.getProductQuantity()>0)); if(!p.getAvailabilities().isEmpty())x.setPrice(p.getAvailabilities().iterator().next().defaultPrice().getProductPriceAmount());out.getItems().add(x);}out.setCount(out.getItems().size());return out;}catch(Exception e){throw new ServiceRuntimeException(e);}}
+ @PostMapping("/auth/customer/wishlist") public ResponseEntity<ReadableWishlist> add(@RequestBody WishlistRequest req,@ApiIgnore MerchantStore s,HttpServletRequest r){Customer c=customer(r,s);Product p=product(req==null?null:req.getProduct(),s);try{boolean exists=wishlist.get(c,s).stream().anyMatch(w->w.getProduct().getId().equals(p.getId()));wishlist.add(c,p,s);return new ResponseEntity<>(readable(c,s),exists?HttpStatus.OK:HttpStatus.CREATED);}catch(Exception e){if(e.getMessage()!=null&&e.getMessage().contains("limit"))throw new ServiceRuntimeException("400","Wishlist limit reached",new IllegalArgumentException(e.getMessage()));throw new ServiceRuntimeException("500","Unable to update wishlist",e);}}
+ @GetMapping("/auth/customer/wishlist") public ReadableWishlist get(@ApiIgnore MerchantStore s,HttpServletRequest r){return readable(customer(r,s),s);}
+ @DeleteMapping("/auth/customer/wishlist/{sku}") @ResponseStatus(HttpStatus.NO_CONTENT) public void remove(@PathVariable String sku,@ApiIgnore MerchantStore s,HttpServletRequest r){Customer c=customer(r,s);Product p=product(sku,s);try{if(wishlist.get(c,s).stream().noneMatch(w->w.getProduct().getId().equals(p.getId())))throw new ResourceNotFoundException("Wishlist item not found");wishlist.remove(c,p);}catch(ServiceException e){throw new ServiceRuntimeException(e);}}
+ @PostMapping("/auth/customer/wishlist/{sku}/cart/{code}") public ResponseEntity<ReadableShoppingCart> move(@PathVariable String sku,@PathVariable String code,@ApiIgnore MerchantStore s,@ApiIgnore Language l,HttpServletRequest r){Customer c=customer(r,s);Product p=product(sku,s);try{if(wishlist.get(c,s).stream().noneMatch(w->w.getProduct().getId().equals(p.getId())))throw new ResourceNotFoundException("Wishlist item not found");if(!p.isAvailable()||p.getAvailabilities().stream().noneMatch(a->a.getProductQuantity()!=null&&a.getProductQuantity()>0))throw new ServiceRuntimeException("409","Product unavailable",new IllegalStateException("out of stock"));if(carts.getByCode(code,s,l)==null)throw new ResourceNotFoundException("Cart not found");PersistableShoppingCartItem item=new PersistableShoppingCartItem();item.setProduct(sku);item.setQuantity(1);ReadableShoppingCart cart=carts.modifyCart(code,item,s,l);wishlist.remove(c,p);return ResponseEntity.ok(cart);}catch(ResourceNotFoundException e){throw e;}catch(ServiceRuntimeException e){throw e;}catch(Exception e){throw new ServiceRuntimeException("500","Unable to move wishlist item",e);}}
+ @GetMapping("/private/wishlists/popular") public List<PopularWishlistProduct> popular(@ApiIgnore MerchantStore s){try{List<PopularWishlistProduct> out=new ArrayList<>();for(Object[] row:wishlist.popular(s)){Product p=products.getById((Long)row[0]);if(p!=null)out.add(new PopularWishlistProduct(p.getSku(),((Number)row[1]).longValue()));}Collections.sort(out,(a,b)->{int c=Long.compare(b.getCount(),a.getCount());return c!=0?c:a.getSku().compareTo(b.getSku());});return out.size()>10?out.subList(0,10):out;}catch(Exception e){throw new ServiceRuntimeException(e);}}
+}
