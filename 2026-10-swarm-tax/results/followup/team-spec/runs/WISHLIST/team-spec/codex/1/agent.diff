+package com.salesmanager.core.business.services.customer;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.customer.WishlistRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("wishlistService")
+public class WishlistServiceImpl implements WishlistService {
+ private final WishlistRepository repo;
+ @Inject public WishlistServiceImpl(WishlistRepository r){repo=r;}
+ @Transactional(readOnly=true) public List<WishlistItem> get(Customer c, MerchantStore s)throws ServiceException{return repo.findForCustomer(c.getId(),s.getId());}
+ @Transactional public WishlistItem add(Customer c, Product p, MerchantStore s)throws ServiceException { WishlistItem old=repo.findByCustomerIdAndProductId(c.getId(),p.getId()); if(old!=null)return old; if(repo.countByCustomerIdAndMerchantStoreId(c.getId(),s.getId())>=50) throw new ServiceException("Wishlist limit reached"); WishlistItem w=new WishlistItem();w.setCustomer(c);w.setProduct(p);w.setMerchantStore(s);return repo.save(w); }
+ @Transactional public void remove(Customer c, Product p)throws ServiceException {WishlistItem w=repo.findByCustomerIdAndProductId(c.getId(),p.getId());if(w!=null)repo.delete(w);}
+ @Transactional public void removeProduct(Product p)throws ServiceException {repo.deleteByProduct(p.getId());}
+ @Transactional(readOnly=true) public List<Object[]> popular(MerchantStore s)throws ServiceException{return repo.popular(s.getId());}
+}
