+package com.salesmanager.shop.store.controller.wishlist.facade;
+import java.math.BigDecimal; import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.services.wishlist.WishlistService; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.catalog.pricing.PricingService; import com.salesmanager.core.model.catalog.product.*; import com.salesmanager.core.model.catalog.product.availability.ProductAvailability; import com.salesmanager.core.model.catalog.product.price.FinalPrice; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.reference.language.Language; import com.salesmanager.core.model.wishlist.WishlistItem; import com.salesmanager.shop.model.shoppingcart.*; import com.salesmanager.shop.model.wishlist.*; import com.salesmanager.shop.store.api.exception.*; import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade; import com.salesmanager.shop.utils.DateUtil;
+@Service public class WishlistFacadeImpl implements WishlistFacade {
+ @Inject WishlistService service; @Inject ProductService products; @Inject PricingService pricing; @Inject ShoppingCartFacade carts;
+ private Product product(String sku,MerchantStore s) { try {Product p=products.getBySku(sku,s); if(p==null)throw new ResourceNotFoundException("Product not found"); return p;}catch(ResourceNotFoundException e){throw e;}catch(Exception e){throw new ResourceNotFoundException("Product not found");} }
+ private ReadableWishlist read(Customer c,MerchantStore s,Language l){ReadableWishlist out=new ReadableWishlist(); for(WishlistItem w:service.list(c,s)){Product p=w.getProduct(); WishlistProduct x=new WishlistProduct();x.setSku(p.getSku());x.setName(p.getProductDescription()==null?null:p.getProductDescription().getName()); try {FinalPrice fp=pricing.calculateProductPrice(p);x.setPrice(fp==null?null:fp.getFinalPrice());}catch(Exception e){x.setPrice(BigDecimal.ZERO);} boolean stock=false; if(p.getAvailabilities()!=null)for(ProductAvailability a:p.getAvailabilities())if(a.getProductQuantity()!=null&&a.getProductQuantity().doubleValue()>0)stock=true; x.setAvailable(p.isAvailable()&&stock);x.setAddedAt(w.getAddedAt());out.getItems().add(x);}out.setCount(out.getItems().size());return out;}
+ public ReadableWishlist get(Customer c,MerchantStore s,Language l){return read(c,s,l);}
+ public ReadableWishlist add(Customer c,String sku,MerchantStore s,Language l){if(sku==null||sku.trim().isEmpty())throw new BadRequestException("product is required");Product p=product(sku,s);if(service.find(c,p,s)==null&&service.count(c,s)>=50)throw new BadRequestException("Wishlist limit exceeded");service.add(c,p,s);return read(c,s,l);}
+ public void remove(Customer c,String sku,MerchantStore s,Language l){Product p=product(sku,s);if(service.find(c,p,s)==null)throw new ResourceNotFoundException("Wishlist item not found");service.remove(c,p,s);}
+ @Transactional public ReadableShoppingCart move(Customer c,String sku,String code,MerchantStore s,Language l)throws Exception {Product p=product(sku,s);if(service.find(c,p,s)==null)throw new ResourceNotFoundException("Wishlist item not found");boolean stock=false;if(p.getAvailabilities()!=null)for(ProductAvailability a:p.getAvailabilities())if(a.getProductQuantity()!=null&&a.getProductQuantity().doubleValue()>0)stock=true;if(!p.isAvailable()||!stock||!DateUtil.dateBeforeEqualsDate(p.getDateAvailable(),new Date()))throw new ConflictException("Product unavailable");PersistableShoppingCartItem i=new PersistableShoppingCartItem();i.setProduct(sku);i.setQuantity(1);ReadableShoppingCart result=carts.modifyCart(code,i,s,l);if(result==null)throw new ResourceNotFoundException("Cart not found");service.remove(c,p,s);return result;}
+ public List<PopularWishlistProduct> popular(MerchantStore s){List<PopularWishlistProduct> out=new ArrayList<>();for(Object[] r:service.popular(s)) {if(out.size()>=10)break;out.add(new PopularWishlistProduct((String)r[0],((Number)r[1]).longValue()));}return out;}
+}
