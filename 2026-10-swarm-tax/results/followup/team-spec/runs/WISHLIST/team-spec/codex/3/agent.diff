+package com.salesmanager.core.business.services.wishlist;
+import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.wishlist.WishlistItemRepository; import com.salesmanager.core.model.wishlist.WishlistItem; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("wishlistService") public class WishlistServiceImpl implements WishlistService {
+ @Inject private WishlistItemRepository repo;
+ public List<WishlistItem> list(Customer c,MerchantStore s){return repo.findByCustomerIdAndMerchantStoreIdOrderByAddedAtDesc(c.getId(),s.getId());}
+ public WishlistItem find(Customer c,Product p,MerchantStore s){return repo.findByCustomerIdAndProductIdAndMerchantStoreId(c.getId(),p.getId(),s.getId());}
+ @Transactional public boolean add(Customer c,Product p,MerchantStore s){if(find(c,p,s)!=null)return false; WishlistItem w=new WishlistItem();w.setCustomer(c);w.setProduct(p);w.setMerchantStore(s);repo.saveAndFlush(w);return true;}
+ @Transactional public void remove(Customer c,Product p,MerchantStore s){repo.deleteByCustomerIdAndProductIdAndMerchantStoreId(c.getId(),p.getId(),s.getId());}
+ @Transactional public void removeProduct(Product p){repo.deleteByProductId(p.getId());}
+ public List<Object[]> popular(MerchantStore s){return repo.popular(s.getId());} public long count(Customer c,MerchantStore s){return repo.countByCustomerIdAndMerchantStoreId(c.getId(),s.getId());}
+}
