+package com.salesmanager.shop.store.api.v1.customer;
+import java.security.Principal; import javax.inject.Inject; import javax.servlet.http.HttpServletRequest; import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.reference.language.Language; import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart; import com.salesmanager.shop.model.wishlist.*; import com.salesmanager.shop.store.api.exception.ResourceNotFoundException; import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade; import com.salesmanager.shop.store.controller.wishlist.facade.WishlistFacade; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class WishlistApi {
+ @Inject WishlistFacade facade; @Inject CustomerFacade customers;
+ private Customer customer(HttpServletRequest r,MerchantStore s){Principal p=r.getUserPrincipal();if(p==null)throw new ResourceNotFoundException("Customer not found");Customer c=customers.getCustomerByUserName(p.getName(),s);if(c==null)throw new ResourceNotFoundException("Customer not found");return c;}
+ @PostMapping("/auth/customer/wishlist") public ResponseEntity<ReadableWishlist> add(@RequestBody PersistableWishlistItem item,@ApiIgnore MerchantStore s,@ApiIgnore Language l,HttpServletRequest r){Customer c=customer(r,s);boolean exists=false;ReadableWishlist before=facade.get(c,s,l);if(item!=null&&item.getProduct()!=null)for(WishlistProduct x:before.getItems())if(item.getProduct().equals(x.getSku()))exists=true;return new ResponseEntity<>(facade.add(c,item==null?null:item.getProduct(),s,l),exists?HttpStatus.OK:HttpStatus.CREATED);}
+ @GetMapping("/auth/customer/wishlist") public ReadableWishlist get(@ApiIgnore MerchantStore s,@ApiIgnore Language l,HttpServletRequest r){return facade.get(customer(r,s),s,l);}
+ @DeleteMapping("/auth/customer/wishlist/{sku}") @ResponseStatus(HttpStatus.NO_CONTENT) public void remove(@PathVariable String sku,@ApiIgnore MerchantStore s,@ApiIgnore Language l,HttpServletRequest r){facade.remove(customer(r,s),sku,s,l);}
+ @PostMapping("/auth/customer/wishlist/{sku}/cart/{cartCode}") public ReadableShoppingCart move(@PathVariable String sku,@PathVariable String cartCode,@ApiIgnore MerchantStore s,@ApiIgnore Language l,HttpServletRequest r)throws Exception{return facade.move(customer(r,s),sku,cartCode,s,l);}
+ @GetMapping("/private/wishlists/popular") public java.util.List<PopularWishlistProduct> popular(@ApiIgnore MerchantStore s){return facade.popular(s);}
+}
