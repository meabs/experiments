+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.math.BigDecimal; import java.security.Principal; import java.util.*; import javax.inject.Inject; import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.*; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.pricing.PricingService; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.customer.*; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.availability.ProductAvailability; import com.salesmanager.core.model.customer.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem; import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart; import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade; import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade; import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+
+@RestController @RequestMapping("/api/v1") public class WishlistApi {
+ @Inject private WishlistService wishlist; @Inject private ProductService products; @Inject private CustomerFacade customers; @Inject private ShoppingCartFacade carts; @Inject private PricingService pricing;
+ private Customer customer(Principal p,MerchantStore s){if(p==null) throw new org.springframework.web.server.ResponseStatusException(HttpStatus.UNAUTHORIZED); Customer c=customers.getCustomerByUserName(p.getName(),s); if(c==null)throw new ResourceNotFoundException("Customer not found"); return c;}
+ private Product product(String sku,MerchantStore s){try{Product p=products.getBySku(sku,s);if(p==null)throw new ResourceNotFoundException("Product not found");return p;}catch(ResourceNotFoundException e){throw e;}catch(Exception e){throw new ResourceNotFoundException("Product not found");}}
+ private boolean available(Product p){if(!p.isAvailable()||p.getDateAvailable()==null||p.getDateAvailable().after(new Date())||p.getAvailabilities()==null||p.getAvailabilities().isEmpty())return false;for(ProductAvailability x:p.getAvailabilities())if(x.getProductQuantity()!=null&&x.getProductQuantity()>0)return true;return false;}
+ private Map<String,Object> body(WishlistItem w,MerchantStore s){Product p=w.getProduct();Map<String,Object> m=new LinkedHashMap<>();m.put("sku",p.getSku());m.put("name",p.getDescriptions().isEmpty()?null:p.getDescriptions().iterator().next().getName());try{m.put("price",pricing.calculateProductPrice(p).getFinalPrice());}catch(Exception e){m.put("price",BigDecimal.ZERO);}m.put("available",available(p));m.put("addedAt",w.getAddedAt());return m;}
+ private Map<String,Object> list(Customer c,MerchantStore s){List<Map<String,Object>> out=new ArrayList<>();for(WishlistItem w:wishlist.list(c,s))out.add(body(w,s));Map<String,Object> r=new LinkedHashMap<>();r.put("count",out.size());r.put("items",out);return r;}
+ @PostMapping("/auth/customer/wishlist") public ResponseEntity<?> add(@RequestBody(required=false) Map<String,String> req,Principal p,MerchantStore merchantStore){if(req==null||req.get("product")==null||req.get("product").trim().isEmpty())throw new org.springframework.web.server.ResponseStatusException(HttpStatus.BAD_REQUEST);Customer c=customer(p,merchantStore);Product prod=product(req.get("product"),merchantStore);boolean exists=wishlist.find(c,merchantStore,prod)!=null;try{wishlist.add(c,merchantStore,prod);}catch(IllegalStateException e){throw new org.springframework.web.server.ResponseStatusException(HttpStatus.BAD_REQUEST,e.getMessage());}return ResponseEntity.status(exists?HttpStatus.OK:HttpStatus.CREATED).body(list(c,merchantStore));}
+ @GetMapping("/auth/customer/wishlist") public Map<String,Object> get(Principal p,MerchantStore merchantStore){return list(customer(p,merchantStore),merchantStore);}
+ @DeleteMapping("/auth/customer/wishlist/{sku}") public ResponseEntity<Void> remove(@PathVariable String sku,Principal p,MerchantStore merchantStore){Customer c=customer(p,merchantStore);Product prod=product(sku,merchantStore);if(wishlist.find(c,merchantStore,prod)==null)throw new ResourceNotFoundException("Wishlist item not found");wishlist.remove(c,merchantStore,prod);return ResponseEntity.noContent().build();}
+ @PostMapping("/auth/customer/wishlist/{sku}/cart/{cartCode}") public ReadableShoppingCart move(@PathVariable String sku,@PathVariable String cartCode,Principal p,MerchantStore merchantStore,Language language){Customer c=customer(p,merchantStore);Product prod=product(sku,merchantStore);if(wishlist.find(c,merchantStore,prod)==null)throw new ResourceNotFoundException("Wishlist item not found");if(!available(prod))throw new org.springframework.web.server.ResponseStatusException(HttpStatus.CONFLICT);PersistableShoppingCartItem item=new PersistableShoppingCartItem();item.setProduct(sku);item.setQuantity(1);try{com.salesmanager.core.model.shoppingcart.ShoppingCart existing=carts.getShoppingCartModel(cartCode,merchantStore);if(existing==null)throw new ResourceNotFoundException("Cart not found");if(existing.getLineItems()!=null)for(com.salesmanager.core.model.shoppingcart.ShoppingCartItem line:existing.getLineItems())if(line.getProduct()!=null&&prod.getId().equals(line.getProduct().getId())){item.setQuantity(line.getQuantity()+1);break;}ReadableShoppingCart result=carts.modifyCart(cartCode,item,merchantStore,language);if(result==null)throw new ResourceNotFoundException("Cart not found");wishlist.remove(c,merchantStore,prod);return result;}catch(ResourceNotFoundException e){throw e;}catch(Exception e){throw new ResourceNotFoundException("Cart not found");}}
+}
