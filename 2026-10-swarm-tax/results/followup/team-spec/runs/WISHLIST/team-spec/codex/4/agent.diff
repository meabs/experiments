+package com.salesmanager.core.business.services.customer;
+import java.util.*; import javax.inject.Inject; import javax.transaction.Transactional; import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.customer.WishlistRepository; import com.salesmanager.core.model.customer.*; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("wishlistService") public class WishlistServiceImpl implements WishlistService {
+ @Inject private WishlistRepository repo;
+ public List<WishlistItem> list(Customer c,MerchantStore s){return repo.findByCustomerIdAndStoreIdOrderByAddedAtDesc(c.getId(),s.getId());}
+ public WishlistItem find(Customer c,MerchantStore s,Product p){return repo.findByCustomerIdAndStoreIdAndProductId(c.getId(),s.getId(),p.getId()).orElse(null);}
+ @Transactional public WishlistItem add(Customer c,MerchantStore s,Product p){WishlistItem x=find(c,s,p); if(x!=null)return x; if(repo.countByCustomerIdAndStoreId(c.getId(),s.getId())>=50) throw new IllegalStateException("Wishlist limit"); x=new WishlistItem();x.setCustomer(c);x.setStore(s);x.setProduct(p);x.setAddedAt(new Date());return repo.save(x);}
+ @Transactional public void remove(Customer c,MerchantStore s,Product p){WishlistItem x=find(c,s,p);if(x!=null)repo.delete(x);}
+ @Transactional public void removeProduct(Product p){repo.deleteByProductId(p.getId());}
+ public List<Object[]> popular(MerchantStore s){return repo.popular(s.getId());}
+}
