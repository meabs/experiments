+@RestController @RequestMapping("/api/v1/private/wishlists") public class WishlistAdminApi {
+ @Inject private WishlistService service;
+ @GetMapping("/popular") public List<Map<String,Object>> popular(MerchantStore store){List<Map<String,Object>> out=new ArrayList<>();int n=0;for(Object[] row:service.popular(store)){if(n++>=10)break;Map<String,Object> x=new LinkedHashMap<>();x.put("sku",row[0]);x.put("count",((Number)row[1]).longValue());out.add(x);}return out;}
+}
