+package com.salesmanager.core.business.repositories.customer;
+import java.util.*;
+import org.springframework.data.jpa.repository.*;
+import com.salesmanager.core.model.customer.WishlistItem;
+public interface WishlistRepository extends JpaRepository<WishlistItem,Long> {
+ List<WishlistItem> findByCustomerIdAndStoreIdOrderByAddedAtDesc(Long customerId, Integer storeId);
+ Optional<WishlistItem> findByCustomerIdAndStoreIdAndProductId(Long c,Integer s,Long p);
+ long countByCustomerIdAndStoreId(Long c,Integer s);
+ @Modifying @Query("delete from WishlistItem w where w.product.id=?1") void deleteByProductId(Long id);
+ @Query("select w.product.sku, count(distinct w.customer.id) from WishlistItem w where w.store.id=?1 group by w.product.sku order by count(distinct w.customer.id) desc, w.product.sku asc") List<Object[]> popular(Integer storeId);
+}
