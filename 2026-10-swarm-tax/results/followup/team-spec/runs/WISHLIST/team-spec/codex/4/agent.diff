+import java.util.*;
+import com.salesmanager.core.model.customer.*; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.merchant.MerchantStore;
+public interface WishlistService { List<WishlistItem> list(Customer c, MerchantStore s); WishlistItem add(Customer c, MerchantStore s, Product p); void remove(Customer c, MerchantStore s, Product p); WishlistItem find(Customer c, MerchantStore s, Product p); void removeProduct(Product p); List<Object[]> popular(MerchantStore s); }
diff --git a/sm-core/src/main/java/com/salesmanager/core/business/services/customer/WishlistServiceImpl.java b/sm-core/src/main/java/com/salesmanager/core/business/services/customer/WishlistServiceImpl.java
