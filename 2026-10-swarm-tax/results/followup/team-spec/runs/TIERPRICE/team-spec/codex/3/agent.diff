+package com.salesmanager.shop.store.api.v1.product;
+
+import java.math.BigDecimal;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.http.*;
+import org.springframework.web.bind.annotation.*;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductTierData;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class ProductTierApi {
+    @Inject private ProductService productService;
+
+    @GetMapping(value="/private/product/{id}/tiers", produces=MediaType.APPLICATION_JSON_VALUE)
+    @Transactional(readOnly = true)
+    public List<ProductTierData> get(@PathVariable Long id, @ApiIgnore MerchantStore store) throws Exception {
+        Product p = product(id, store);
+        List<ProductTier> tiers = new ArrayList<ProductTier>(p.getTiers());
+        tiers.sort(Comparator.comparing(ProductTier::getMinQuantity));
+        List<ProductTierData> result = new ArrayList<>();
+        for (ProductTier tier : tiers) { ProductTierData d = new ProductTierData(); d.setMinQuantity(tier.getMinQuantity()); d.setPrice(tier.getPrice()); result.add(d); }
+        return result;
+    }
+
+    @PutMapping(value="/private/product/{id}/tiers", produces=MediaType.APPLICATION_JSON_VALUE)
+    @Transactional
+    public List<ProductTierData> replace(@PathVariable Long id, @RequestBody List<ProductTierData> request, @ApiIgnore MerchantStore store) throws Exception {
+        Product p = product(id, store);
+        validate(request);
+        Set<ProductTier> tiers = new HashSet<ProductTier>();
+        for (ProductTierData d : request) { ProductTier t = new ProductTier(); t.setProduct(p); t.setMinQuantity(d.getMinQuantity()); t.setPrice(d.getPrice()); tiers.add(t); }
+        p.setTiers(tiers);
+        productService.update(p);
+        return get(id, store);
+    }
+
+    private Product product(Long id, MerchantStore store) {
+        Product p = productService.retrieveById(id, store).orElse(null);
+        if (p == null) throw new ResourceNotFoundException("Product not found");
+        return p;
+    }
+    private void validate(List<ProductTierData> tiers) {
+        if (tiers == null || tiers.size() > 10) throw new ServiceRuntimeException("400", "Invalid tiers");
+        Set<Integer> seen = new HashSet<Integer>();
+        List<ProductTierData> sorted = new ArrayList<ProductTierData>(tiers);
+        for (ProductTierData d : sorted) {
+            if (d == null || d.getMinQuantity() == null || d.getPrice() == null || d.getMinQuantity() < 2 || d.getPrice().compareTo(BigDecimal.ZERO) <= 0 || !seen.add(d.getMinQuantity())) throw new ServiceRuntimeException("400", "Invalid tier");
+        }
+        sorted.sort(Comparator.comparing(ProductTierData::getMinQuantity));
+        for (int i=1; i<sorted.size(); i++) if (sorted.get(i).getPrice().compareTo(sorted.get(i-1).getPrice()) >= 0) throw new ServiceRuntimeException("400", "Tier prices must decrease");
+    }
+}
