+	private BigDecimal tierPrice(Product product, Integer quantity, BigDecimal ownPrice) {
+		if (ownPrice == null || quantity == null || product.getPriceTiers() == null) return ownPrice;
+		BigDecimal selected = null;
+		for (ProductPriceTier tier : product.getPriceTiers()) {
+			if (tier.getMinQuantity() != null && tier.getMinQuantity() <= quantity) selected = tier.getPrice();
+		}
+		return selected != null && selected.compareTo(ownPrice) < 0 ? selected : ownPrice;
+	}
