+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletResponse;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.http.MediaType;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductPriceTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class ProductPriceTierApi {
+ @Inject private ProductService productService;
+
+ @GetMapping(value="/private/product/{id}/tiers", produces=MediaType.APPLICATION_JSON_VALUE)
+ public List<com.salesmanager.shop.model.catalog.product.ProductPriceTier> get(@PathVariable Long id, @ApiIgnore MerchantStore store, HttpServletResponse response) throws Exception {
+   Product p=productService.findOne(id,store); if(p==null){response.sendError(404); return null;}
+   List<com.salesmanager.shop.model.catalog.product.ProductPriceTier> out=new ArrayList<>();
+   for(ProductPriceTier t:p.getPriceTiers()){com.salesmanager.shop.model.catalog.product.ProductPriceTier d=new com.salesmanager.shop.model.catalog.product.ProductPriceTier(); d.setMinQuantity(t.getMinQuantity()); d.setPrice(t.getPrice()); out.add(d);}
+   out.sort(Comparator.comparing(com.salesmanager.shop.model.catalog.product.ProductPriceTier::getMinQuantity)); return out;
+ }
+
+ @PutMapping(value="/private/product/{id}/tiers", produces=MediaType.APPLICATION_JSON_VALUE)
+ @Transactional
+ public List<com.salesmanager.shop.model.catalog.product.ProductPriceTier> put(@PathVariable Long id, @RequestBody List<com.salesmanager.shop.model.catalog.product.ProductPriceTier> body, @ApiIgnore MerchantStore store, HttpServletResponse response) throws Exception {
+   Product p=productService.findOne(id,store); if(p==null){response.sendError(404); return null;}
+   if(body==null || body.size()>10){response.sendError(400,"At most 10 tiers"); return null;}
+   Set<Integer> seen=new HashSet<>(); List<com.salesmanager.shop.model.catalog.product.ProductPriceTier> sorted=new ArrayList<>(body);
+   for(com.salesmanager.shop.model.catalog.product.ProductPriceTier d: sorted){if(d==null||d.getMinQuantity()==null||d.getPrice()==null||d.getMinQuantity()<2||d.getPrice().signum()<=0||!seen.add(d.getMinQuantity())){response.sendError(400,"Invalid tier"); return null;}}
+   sorted.sort(Comparator.comparing(com.salesmanager.shop.model.catalog.product.ProductPriceTier::getMinQuantity));
+   for(int i=1;i<sorted.size();i++) if(sorted.get(i).getPrice().compareTo(sorted.get(i-1).getPrice())>=0){response.sendError(400,"Higher quantities must cost less"); return null;}
+   p.getPriceTiers().clear(); for(com.salesmanager.shop.model.catalog.product.ProductPriceTier d:sorted){ProductPriceTier t=new ProductPriceTier(d.getMinQuantity(),d.getPrice()); t.setProduct(p); p.getPriceTiers().add(t);} productService.update(p);
+   return get(id,store,response);
+ }
+}
