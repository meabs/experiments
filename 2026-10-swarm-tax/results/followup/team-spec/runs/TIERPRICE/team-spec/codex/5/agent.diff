+	/** Select the highest reached break, while never charging more than the product price. */
+	private BigDecimal tierPrice(Product product, Integer quantity, BigDecimal ownPrice) {
+		if (product.getPriceTiers() == null || quantity == null || ownPrice == null) return ownPrice;
+		BigDecimal selected = ownPrice;
+		for (ProductPriceTier tier : product.getPriceTiers()) {
+			if (tier.getMinQuantity() != null && tier.getPrice() != null
+					&& quantity >= tier.getMinQuantity() && tier.getPrice().compareTo(selected) < 0) {
+				selected = tier.getPrice();
+			}
+		}
+		return selected;
+	}
