+package com.salesmanager.shop.store.api.v1.product;
+
+import java.math.BigDecimal;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductPriceTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductPriceTierEntity;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@Controller
+@RequestMapping("/api/v1")
+public class ProductTierApi {
+    @Inject private ProductService productService;
+
+    @RequestMapping(value="/private/product/{id}/tiers", method=RequestMethod.GET)
+    @ResponseStatus(HttpStatus.OK)
+    @ResponseBody
+    public List<ProductPriceTierEntity> get(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        return map(product(id, store).getOrderedPriceTiers());
+    }
+
+    @RequestMapping(value="/private/product/{id}/tiers", method=RequestMethod.PUT)
+    @ResponseStatus(HttpStatus.OK)
+    @ResponseBody
+    public List<ProductPriceTierEntity> put(@PathVariable Long id, @RequestBody List<ProductPriceTierEntity> input,
+                                            @ApiIgnore MerchantStore store) {
+        if (input == null || input.size() > 10) throw new RestApiException("Invalid product price tiers");
+        Set<Integer> seen = new HashSet<Integer>();
+        Product product = product(id, store);
+        // Reject null list elements before sorting; otherwise the comparator
+        // dereferences the element and the malformed request becomes a 500.
+        for (ProductPriceTierEntity tier : input) {
+            if (tier == null) throw new RestApiException("Invalid product price tiers");
+        }
+        List<ProductPriceTierEntity> sorted = new ArrayList<ProductPriceTierEntity>(input);
+        sorted.sort(Comparator.comparing(ProductPriceTierEntity::getMinQuantity,
+                Comparator.nullsFirst(Integer::compareTo)));
+        BigDecimal prior = null;
+        for (ProductPriceTierEntity tier : sorted) {
+            if (tier.getMinQuantity() == null || tier.getPrice() == null ||
+                    tier.getMinQuantity() < 2 || tier.getPrice().compareTo(BigDecimal.ZERO) <= 0 ||
+                    !seen.add(tier.getMinQuantity())) throw new RestApiException("Invalid product price tiers");
+            if (prior != null && tier.getPrice().compareTo(prior) >= 0) throw new RestApiException("Tier prices must decrease");
+            prior = tier.getPrice();
+        }
+        Set<ProductPriceTier> replacement = new HashSet<ProductPriceTier>();
+        for (ProductPriceTierEntity tier : sorted) {
+            ProductPriceTier model = new ProductPriceTier(); model.setProduct(product);
+            model.setMinQuantity(tier.getMinQuantity()); model.setPrice(tier.getPrice()); replacement.add(model);
+        }
+        product.setPriceTiers(replacement);
+        try { productService.update(product); } catch (ServiceException e) { throw new RestApiException("Unable to save product tiers", e); }
+        return map(product.getOrderedPriceTiers());
+    }
+    private Product product(Long id, MerchantStore store) {
+        Product p = productService.findOne(id, store);
+        if (p == null) throw new ResourceNotFoundException("Product not found");
+        return p;
+    }
+    private List<ProductPriceTierEntity> map(List<ProductPriceTier> tiers) {
+        List<ProductPriceTierEntity> out = new ArrayList<ProductPriceTierEntity>();
+        for (ProductPriceTier t : tiers) { ProductPriceTierEntity e = new ProductPriceTierEntity(); e.setMinQuantity(t.getMinQuantity()); e.setPrice(t.getPrice()); out.add(e); }
+        return out;
+    }
+}
