+	private void repriceTiers(final ShoppingCart cart) throws ServiceException {
+		for (ShoppingCartItem item : cart.getLineItems()) {
+			if (item.getProduct() == null || item.getQuantity() == null) continue;
+			FinalPrice effective = pricingService.calculateProductPrice(item.getProduct());
+			BigDecimal unit = effective.getFinalPrice();
+			for (ProductPriceTier tier : item.getProduct().getOrderedPriceTiers()) {
+				if (item.getQuantity() >= tier.getMinQuantity() && tier.getPrice().compareTo(unit) < 0) unit = tier.getPrice();
+			}
+			item.setItemPrice(unit);
+			item.setFinalPrice(effective);
+			item.setSubTotal(unit.multiply(BigDecimal.valueOf(item.getQuantity())));
+		}
+	}
+
 }
