+	@GetMapping(value = "/private/product/{id}/tiers", produces = APPLICATION_JSON_VALUE)
+	public ResponseEntity<List<ProductQuantityTierRequest>> getTiers(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+		Product product = productService.findOne(id, store);
+		if (product == null) return ResponseEntity.notFound().build();
+		List<ProductQuantityTierRequest> result = new ArrayList<>();
+		for (ProductQuantityTier tier : product.getQuantityTiers()) {
+			ProductQuantityTierRequest dto = new ProductQuantityTierRequest(); dto.setMinQuantity(tier.getMinQuantity()); dto.setPrice(tier.getPrice()); result.add(dto);
+		}
+		Collections.sort(result, Comparator.comparing(ProductQuantityTierRequest::getMinQuantity));
+		return ResponseEntity.ok(result);
+	}
+
+	@org.springframework.web.bind.annotation.PutMapping(value = "/private/product/{id}/tiers", consumes = APPLICATION_JSON_VALUE, produces = APPLICATION_JSON_VALUE)
+	public ResponseEntity<List<ProductQuantityTierRequest>> putTiers(@PathVariable Long id, @RequestBody List<ProductQuantityTierRequest> tiers, @ApiIgnore MerchantStore store) throws Exception {
+		Product product = productService.findOne(id, store);
+		if (product == null) return ResponseEntity.notFound().build();
+		if (tiers == null || tiers.size() > 10) return ResponseEntity.badRequest().build();
+		List<ProductQuantityTierRequest> sorted = new ArrayList<>(tiers);
+		sorted.sort(Comparator.nullsFirst(Comparator.comparing(ProductQuantityTierRequest::getMinQuantity, Comparator.nullsFirst(Comparator.naturalOrder()))));
+		Set<Integer> seen = new HashSet<>(); BigDecimal previous = null;
+		for (ProductQuantityTierRequest tier : sorted) {
+			if (tier == null || tier.getMinQuantity() == null || tier.getPrice() == null || tier.getMinQuantity() < 2 || tier.getPrice().compareTo(BigDecimal.ZERO) <= 0 || !seen.add(tier.getMinQuantity())) return ResponseEntity.badRequest().build();
+			if (previous != null && tier.getPrice().compareTo(previous) >= 0) return ResponseEntity.badRequest().build();
+			previous = tier.getPrice();
+		}
+		Set<ProductQuantityTier> replacement = new HashSet<>();
+		for (ProductQuantityTierRequest tier : sorted) replacement.add(new ProductQuantityTier(tier.getMinQuantity(), tier.getPrice()));
+		product.setQuantityTiers(replacement);
+		productService.update(product);
+		return ResponseEntity.ok(sorted);
+	}
