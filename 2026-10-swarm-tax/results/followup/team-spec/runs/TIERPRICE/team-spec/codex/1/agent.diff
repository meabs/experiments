+	private void repriceTiers(ShoppingCart cart) {
+		for (ShoppingCartItem item : cart.getLineItems()) {
+			if (item.getProduct() == null || item.getQuantity() == null) continue;
+			BigDecimal basePrice = item.getBaseItemPrice() != null ? item.getBaseItemPrice() : item.getItemPrice();
+			if (basePrice == null) continue;
+			BigDecimal tierPrice = null;
+			int reachedMin = -1;
+			for (ProductQuantityTier tier : item.getProduct().getQuantityTiers()) {
+				if (item.getQuantity() >= tier.getMinQuantity() && tier.getMinQuantity() > reachedMin) { reachedMin = tier.getMinQuantity(); tierPrice = tier.getPrice(); }
+			}
+			item.setItemPrice(tierPrice != null && tierPrice.compareTo(basePrice) < 0 ? tierPrice : basePrice);
+			item.setSubTotal(item.getItemPrice().multiply(BigDecimal.valueOf(item.getQuantity())));
+		}
+	}
+
