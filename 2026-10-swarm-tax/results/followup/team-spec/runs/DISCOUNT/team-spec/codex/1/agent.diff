+package com.salesmanager.core.business.services.discount;
+import java.util.List; import javax.inject.Inject; import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.business.repositories.discount.DiscountRepository;
+import com.salesmanager.core.model.discount.Discount; import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+@Service("discountService") public class DiscountServiceImpl implements DiscountService {
+ @Inject private DiscountRepository repo;
+ public Discount save(Discount d)throws ServiceException{return repo.saveAndFlush(d);} public void delete(Discount d)throws ServiceException{repo.delete(d);}
+ public List<Discount> list(MerchantStore s){return repo.findByMerchantStoreId(s.getId());}
+ public Discount getByCode(MerchantStore s,String c){return repo.findByMerchantStoreIdAndCodeIgnoreCase(s.getId(),c);}
+ public Discount getById(MerchantStore s,Long id){return repo.findByIdAndMerchantStoreId(id,s.getId());}
+ public java.math.BigDecimal calculate(Discount d, ShoppingCart cart){
+  if(d==null||cart==null||!d.isActive()||d.getStartDate()==null||java.time.LocalDate.now().isBefore(d.getStartDate())||(d.getEndDate()!=null&&java.time.LocalDate.now().isAfter(d.getEndDate()))) return null;
+  java.math.BigDecimal subtotal=java.math.BigDecimal.ZERO, eligible=java.math.BigDecimal.ZERO;
+  for(com.salesmanager.core.model.shoppingcart.ShoppingCartItem i:cart.getLineItems()){java.math.BigDecimal line=i.getItemPrice().multiply(java.math.BigDecimal.valueOf(i.getQuantity()));subtotal=subtotal.add(line); boolean ok=d.getCategories()==null||d.getCategories().isEmpty(); if(!ok&&i.getProduct()!=null&&i.getProduct().getCategories()!=null) for(com.salesmanager.core.model.catalog.category.Category c:i.getProduct().getCategories()) for(String code:d.getCategories()) if(code.equalsIgnoreCase(c.getCode())||(c.getLineage()!=null&&c.getLineage().contains("/"+code+"/"))) ok=true; if(ok)eligible=eligible.add(line);}
+  if(d.getMinimumSubtotal()!=null&&subtotal.compareTo(d.getMinimumSubtotal())<0||eligible.signum()==0)return null; java.math.BigDecimal amount=d.getType()==com.salesmanager.core.model.discount.DiscountType.PERCENT?eligible.multiply(d.getValue()).divide(java.math.BigDecimal.valueOf(100)):d.getValue(); if(amount.compareTo(eligible)>0)amount=eligible; return amount.setScale(2,java.math.RoundingMode.HALF_UP);
+ }
+}
