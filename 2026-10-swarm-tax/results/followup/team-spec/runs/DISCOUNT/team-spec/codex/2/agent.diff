@@ -0,0 +1,15 @@
+package com.salesmanager.shop.store.api.v1.discount;
+import java.time.LocalDate; import java.util.List; import java.util.stream.Collectors; import javax.inject.Inject;
+import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.business.services.discount.DiscountCodeService; import com.salesmanager.core.business.services.catalog.category.CategoryService; import com.salesmanager.core.model.discount.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.discount.PersistableDiscountCode; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/discounts") public class DiscountApi {
+ @Inject private DiscountCodeService service;
+ @Inject private CategoryService categoryService;
+ @PostMapping public ResponseEntity<PersistableDiscountCode> create(@RequestBody PersistableDiscountCode in,@ApiIgnore MerchantStore store){return save(in,null,store,HttpStatus.CREATED);}
+ @GetMapping public List<PersistableDiscountCode> list(@ApiIgnore MerchantStore store){return service.list(store).stream().map(this::out).collect(Collectors.toList());}
+ @PutMapping("/{id}") public ResponseEntity<PersistableDiscountCode> update(@PathVariable Long id,@RequestBody PersistableDiscountCode in,@ApiIgnore MerchantStore store){return save(in,id,store,HttpStatus.OK);}
+ @DeleteMapping("/{id}") public ResponseEntity<Void> delete(@PathVariable Long id,@ApiIgnore MerchantStore store){DiscountCode d=find(id,store); if(d==null)return new ResponseEntity<Void>(HttpStatus.NOT_FOUND); service.delete(d); return new ResponseEntity<Void>(HttpStatus.NO_CONTENT);}
+ private ResponseEntity<PersistableDiscountCode> save(PersistableDiscountCode in,Long id,MerchantStore store,HttpStatus status){if(in.getCode()==null||in.getCode().trim().isEmpty()||in.getType()==null||in.getValue()==null||in.getValue().signum()<=0||(in.getType()==DiscountType.PERCENT&&in.getValue().compareTo(java.math.BigDecimal.ONE.movePointRight(2))>0)||(in.getStartDate()!=null&&in.getEndDate()!=null&&in.getEndDate().isBefore(in.getStartDate()))) throw new org.springframework.web.server.ResponseStatusException(HttpStatus.BAD_REQUEST,"Invalid discount"); DiscountCode old=service.find(store,in.getCode()); if(old!=null&&(id==null||!id.equals(old.getId()))) throw new org.springframework.web.server.ResponseStatusException(HttpStatus.CONFLICT,"Code already exists"); DiscountCode d=id==null?new DiscountCode():find(id,store); if(d==null&&id!=null)throw new org.springframework.web.server.ResponseStatusException(HttpStatus.NOT_FOUND); d.setMerchantStore(store); d.setCode(in.getCode()); d.setType(in.getType()); d.setValue(in.getValue()); d.setMinimumSubtotal(in.getMinimumSubtotal()); d.setStartDate(in.getStartDate()==null?LocalDate.now():in.getStartDate()); d.setEndDate(in.getEndDate()); d.setCategories(in.getCategories()); d.setActive(in.getActive()==null||in.getActive()); return new ResponseEntity<PersistableDiscountCode>(out(service.save(d)),status);}
+ private DiscountCode find(Long id,MerchantStore s){return service.list(s).stream().filter(x->id.equals(x.getId())).findFirst().orElse(null);}
+ private boolean validCategories(PersistableDiscountCode in, MerchantStore s){return in.getCategories()==null || in.getCategories().stream().allMatch(c->categoryService.getByCode(s,c)!=null);}
+ private PersistableDiscountCode out(DiscountCode d){PersistableDiscountCode o=new PersistableDiscountCode();o.setId(d.getId());o.setCode(d.getCode());o.setType(d.getType());o.setValue(d.getValue());o.setMinimumSubtotal(d.getMinimumSubtotal());o.setStartDate(d.getStartDate());o.setEndDate(d.getEndDate());o.setCategories(d.getCategories());o.setActive(d.isActive());return o;}
+}
