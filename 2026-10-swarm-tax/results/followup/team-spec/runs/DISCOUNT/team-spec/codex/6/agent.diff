+package com.salesmanager.core.business.services.discount;
+import java.math.*; import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional; import com.salesmanager.core.business.repositories.discount.DiscountRepository; import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.model.discount.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.business.services.catalog.category.CategoryService;
+@Service("discountService") public class DiscountServiceImpl implements DiscountService {
+ @Inject private DiscountRepository repo; @Inject private CategoryService categoryService;
+ private void checkCategories(Discount d, MerchantStore s) throws ServiceException { if(d.getCategories()!=null) for(String code:d.getCategories()){boolean found=false; for(com.salesmanager.core.model.catalog.category.Category c:categoryService.listByStore(s)) if(c.getCode().equalsIgnoreCase(code)){found=true;break;} if(!found) throw new ServiceException("Unknown category");} }
+ private void validate(Discount d,MerchantStore s)throws ServiceException { if(d==null||d.getCode()==null||d.getCode().trim().isEmpty()||d.getType()==null||d.getValue()==null||d.getValue().compareTo(BigDecimal.ZERO)<=0) throw new ServiceException("Invalid discount"); if(d.getType()==DiscountType.PERCENT&&d.getValue().compareTo(new BigDecimal("100"))>0) throw new ServiceException("Invalid percent"); if(d.getStartDate()==null)d.setStartDate(new Date()); if(d.getEndDate()!=null&&d.getEndDate().before(d.getStartDate()))throw new ServiceException("Invalid dates"); Discount old=repo.findByStoreAndCode(s.getId(),d.getCode()); if(old!=null&&(d.getId()==null||!old.getId().equals(d.getId())))throw new ServiceException("Duplicate discount"); d.setMerchantStore(s); }
+ @Transactional public Discount create(Discount d,MerchantStore s)throws ServiceException{validate(d,s);return repo.save(d);} @Transactional public Discount update(Long id,Discount d,MerchantStore s)throws ServiceException{d.setId(id);validate(d,s);return repo.save(d);} public List<Discount> list(MerchantStore s){return repo.findByStore(s.getId());} public Discount find(String c,MerchantStore s){return c==null?null:repo.findByStoreAndCode(s.getId(),c);} public Discount find(Long id,MerchantStore s){return repo.findByIdAndStore(id,s.getId());} @Transactional public void delete(Long id,MerchantStore s)throws ServiceException{Discount d=find(id,s);if(d==null)throw new ServiceException("Not found");repo.delete(d);}
+ public boolean applies(Discount d,MerchantStore s,BigDecimal subtotal,Set<String> cats){if(d==null||d.getMerchantStore()==null||!d.getMerchantStore().getId().equals(s.getId())||!d.isActive())return false;Calendar today=Calendar.getInstance();today.set(Calendar.HOUR_OF_DAY,0);today.set(Calendar.MINUTE,0);today.set(Calendar.SECOND,0);today.set(Calendar.MILLISECOND,0);Date n=today.getTime();if(d.getStartDate()!=null&&n.before(d.getStartDate())||d.getEndDate()!=null&&n.after(d.getEndDate()))return false;if(d.getMinimumSubtotal()!=null&&subtotal.compareTo(d.getMinimumSubtotal())<0)return false;if(d.getCategories()==null||d.getCategories().isEmpty())return true;if(cats==null)return false;for(String c:cats)for(String wanted:d.getCategories()){String lc=c.toLowerCase(),lw=wanted.toLowerCase();if(lc.equals(lw)||lc.contains("/"+lw+"/"))return true;}return false;}
+ public BigDecimal discount(Discount d,BigDecimal eligible){BigDecimal x=d.getType()==DiscountType.PERCENT?eligible.multiply(d.getValue()).divide(new BigDecimal("100"),8,RoundingMode.HALF_UP):d.getValue().min(eligible);return x.setScale(2,RoundingMode.HALF_UP);}
+}
