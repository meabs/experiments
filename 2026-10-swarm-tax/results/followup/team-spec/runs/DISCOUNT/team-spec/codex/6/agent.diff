+@RestController @RequestMapping("/api/v1/private/discounts") public class DiscountApi {
+ @Inject private DiscountService service;
+ @PostMapping public ResponseEntity<?> create(@RequestBody Discount d,@ApiIgnore MerchantStore store){try{return new ResponseEntity<>(service.create(d,store),HttpStatus.CREATED);}catch(Exception e){return ResponseEntity.status(e.getMessage()!=null&&e.getMessage().contains("Duplicate")?409:400).build();}}
+ @GetMapping public List<Discount> list(@ApiIgnore MerchantStore store){return service.list(store);}
