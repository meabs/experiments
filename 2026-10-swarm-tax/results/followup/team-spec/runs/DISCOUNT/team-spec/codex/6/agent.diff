+ @DeleteMapping("/{id}") public ResponseEntity<?> delete(@PathVariable Long id,@ApiIgnore MerchantStore store){try{service.delete(id,store);return ResponseEntity.noContent().build();}catch(Exception e){return ResponseEntity.notFound().build();}}
+}
