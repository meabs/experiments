@@ -0,0 +1,33 @@
+package com.salesmanager.shop.store.api.v1.discount;
+
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.discount.DiscountCodeService;
+import com.salesmanager.core.model.discount.DiscountCode;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/discounts")
+public class DiscountApi {
+  @Inject private DiscountCodeService service;
+  private ServiceRuntimeException invalid(Exception e) { String m=e.getMessage()==null?"Invalid discount":e.getMessage(); return new ServiceRuntimeException(m.toLowerCase().contains("duplicate") ? "409" : "400", m, e); }
+  @PostMapping @ResponseStatus(HttpStatus.CREATED)
+  public DiscountCode create(@RequestBody DiscountCode code, @ApiIgnore MerchantStore store, @ApiIgnore Language language) {
+    try { return service.save(code, store); } catch (ServiceException e) { throw invalid(e); }
+  }
+  @GetMapping public List<DiscountCode> list(@ApiIgnore MerchantStore store, @ApiIgnore Language language) { return service.listByStore(store); }
+  @PutMapping("/{id}") public DiscountCode update(@PathVariable Long id, @RequestBody DiscountCode code, @ApiIgnore MerchantStore store, @ApiIgnore Language language) {
+    code.setId(id); try { if (service.getById(id) == null) throw new ServiceRuntimeException("404", "Discount not found"); return service.save(code, store); } catch (ServiceException e) { throw invalid(e); }
+  }
+  @DeleteMapping("/{id}") @ResponseStatus(HttpStatus.NO_CONTENT)
+  public void delete(@PathVariable Long id, @ApiIgnore MerchantStore store, @ApiIgnore Language language) {
+    DiscountCode code=service.getById(id); if(code==null || code.getMerchantStore()==null || !store.getId().equals(code.getMerchantStore().getId())) throw new ServiceRuntimeException("404", "Discount not found");
+    try { service.delete(code); } catch(ServiceException e) { throw new ServiceRuntimeException(e); }
+  }
+}
