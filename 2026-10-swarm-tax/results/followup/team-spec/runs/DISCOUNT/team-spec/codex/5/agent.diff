+package com.salesmanager.core.business.services.discount;
+import java.math.BigDecimal; import java.time.LocalDate; import java.util.List; import javax.inject.Inject;
+import org.springframework.stereotype.Service; import com.salesmanager.core.business.repositories.discount.DiscountRepository; import com.salesmanager.core.model.discount.*; import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart; import com.salesmanager.core.model.shoppingcart.ShoppingCartItem; import com.salesmanager.core.model.catalog.category.Category;
+@Service("discountService") public class DiscountServiceImpl implements DiscountService {
+ @Inject private DiscountRepository repo; @Inject private CategoryService categoryService;
+ private void check(Discount d, MerchantStore s, Long id){
+  if(d.getCode()==null||d.getCode().trim().isEmpty()||d.getValue()==null||d.getType()==null) throw new IllegalArgumentException("code, type and value are required");
+  if(d.getType()==DiscountType.PERCENT && (d.getValue().compareTo(BigDecimal.ZERO)<=0||d.getValue().compareTo(new BigDecimal("100"))>0)) throw new IllegalArgumentException("invalid percent");
+  if(d.getType()==DiscountType.AMOUNT && d.getValue().compareTo(BigDecimal.ZERO)<=0) throw new IllegalArgumentException("invalid amount");
+  if(d.getStartDate()==null)d.setStartDate(LocalDate.now()); if(d.getEndDate()!=null&&d.getEndDate().isBefore(d.getStartDate()))throw new IllegalArgumentException("endDate before startDate");
+  if(d.getMinimumSubtotal()!=null&&d.getMinimumSubtotal().compareTo(BigDecimal.ZERO)<0)throw new IllegalArgumentException("invalid minimumSubtotal");
+  if(d.getCategories()!=null) for(String c:d.getCategories()) try { if(c==null||categoryService.getByCode(s,c)==null) throw new IllegalArgumentException("unknown category"); } catch(com.salesmanager.core.business.exception.ServiceException e) { throw new IllegalArgumentException("unknown category"); }
+  Discount existing=repo.findByCode(s.getId(),d.getCode().trim()); if(existing!=null&&!existing.getId().equals(id))throw new DuplicateDiscountException();
+  d.setCode(d.getCode().trim()); d.setMerchantStore(s);
+ }
+ public Discount create(Discount d,MerchantStore s){check(d,s,null); return repo.saveAndFlush(d);}
+ public Discount update(Discount d,MerchantStore s){check(d,s,d.getId()); Discount old=get(d.getId(),s); if(old==null) return null; d.setMerchantStore(s); return repo.saveAndFlush(d);}
+ public List<Discount> list(MerchantStore s){return repo.findByStore(s.getId());} public Discount get(Long id,MerchantStore s){return repo.findByIdAndStore(s.getId(),id);} public Discount find(String c,MerchantStore s){return c==null?null:repo.findByCode(s.getId(),c);}
+ public void delete(Long id,MerchantStore s){Discount d=get(id,s);if(d!=null)repo.delete(d);}
+ public boolean valid(Discount d,LocalDate today){return d!=null&&d.isActive()&&!today.isBefore(d.getStartDate())&&(d.getEndDate()==null||!today.isAfter(d.getEndDate()));}
+ public boolean eligible(Discount d, ShoppingCartItem i) { if (i==null || i.getProduct()==null) return false; if (d.getCategories()==null||d.getCategories().isEmpty()) return true; if(i.getProduct().getCategories()==null)return false; for(Category c:i.getProduct().getCategories()) for(String code:d.getCategories()) { try { Category root=categoryService.getByCode(i.getProduct().getMerchantStore(),code); if(root!=null && (root.getId().equals(c.getId()) || (c.getLineage()!=null&&c.getLineage().contains("/"+root.getId()+"/")))) return true; } catch(Exception e){} } return false; }
+ public BigDecimal eligibleSubtotal(Discount d,List<ShoppingCartItem> items) { BigDecimal n=BigDecimal.ZERO; if(items!=null)for(ShoppingCartItem i:items)if(eligible(d,i)&&i.getItemPrice()!=null)n=n.add(i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity()))); return n; }
+ public boolean applies(Discount d,ShoppingCart cart) { if(!valid(d,LocalDate.now())||cart==null||cart.getLineItems()==null)return false; BigDecimal total=BigDecimal.ZERO; for(ShoppingCartItem i:cart.getLineItems())if(i.getItemPrice()!=null)total=total.add(i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity()))); if(d.getMinimumSubtotal()!=null&&total.compareTo(d.getMinimumSubtotal())<0)return false; return eligibleSubtotal(d,new java.util.ArrayList<>(cart.getLineItems())).compareTo(BigDecimal.ZERO)>0; }
+ public static class DuplicateDiscountException extends RuntimeException {private static final long serialVersionUID=1L;}
+}
