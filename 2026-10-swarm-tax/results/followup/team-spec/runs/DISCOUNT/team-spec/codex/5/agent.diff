+package com.salesmanager.shop.store.api.v1.discount;
+import java.util.List; import java.util.stream.Collectors; import javax.inject.Inject;
+import org.springframework.http.*; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.discount.DiscountService; import com.salesmanager.core.business.services.discount.DiscountServiceImpl.DuplicateDiscountException; import com.salesmanager.core.model.discount.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.discount.PersistableDiscount; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/discounts") public class DiscountApi {
+ @Inject private DiscountService service;
+ private Discount to(PersistableDiscount p,MerchantStore s){Discount d=new Discount();d.setId(p.getId());d.setCode(p.getCode());try{d.setType(DiscountType.valueOf(p.getType()));}catch(Exception e){throw new IllegalArgumentException("unknown type");}d.setValue(p.getValue());d.setMinimumSubtotal(p.getMinimumSubtotal());d.setStartDate(p.getStartDate());d.setEndDate(p.getEndDate());d.setActive(p.getActive()==null||p.getActive());d.setCategories(p.getCategories());d.setMerchantStore(s);return d;}
+ private PersistableDiscount from(Discount d){PersistableDiscount p=new PersistableDiscount();p.setId(d.getId());p.setCode(d.getCode());p.setType(d.getType().name());p.setValue(d.getValue());p.setMinimumSubtotal(d.getMinimumSubtotal());p.setStartDate(d.getStartDate());p.setEndDate(d.getEndDate());p.setActive(d.isActive());p.setCategories(d.getCategories());return p;}
+ @PostMapping public ResponseEntity<?> create(@RequestBody PersistableDiscount p,@ApiIgnore MerchantStore s){try{return ResponseEntity.status(201).body(from(service.create(to(p,s),s)));}catch(DuplicateDiscountException e){return ResponseEntity.status(409).build();}catch(RuntimeException e){return ResponseEntity.badRequest().body(e.getMessage());}}
+ @GetMapping public List<PersistableDiscount> list(@ApiIgnore MerchantStore s){return service.list(s).stream().map(this::from).collect(Collectors.toList());}
+ @PutMapping("/{id}") public ResponseEntity<?> update(@PathVariable Long id,@RequestBody PersistableDiscount p,@ApiIgnore MerchantStore s){try{p.setId(id);Discount d=service.update(to(p,s),s);return d==null?ResponseEntity.notFound().build():ResponseEntity.ok(from(d));}catch(DuplicateDiscountException e){return ResponseEntity.status(409).build();}catch(RuntimeException e){return ResponseEntity.badRequest().body(e.getMessage());}}
+ @DeleteMapping("/{id}") public ResponseEntity<?> delete(@PathVariable Long id,@ApiIgnore MerchantStore s){if(service.get(id,s)==null)return ResponseEntity.notFound().build();service.delete(id,s);return ResponseEntity.noContent().build();}
+}
