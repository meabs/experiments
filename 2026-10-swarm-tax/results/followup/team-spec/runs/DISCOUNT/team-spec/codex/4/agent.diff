+package com.salesmanager.shop.store.api.v1.discount;
+import java.time.LocalDate; import java.util.ArrayList; import java.util.List; import javax.inject.Inject;
+import org.springframework.http.HttpStatus; import org.springframework.http.ResponseEntity; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.discount.DiscountCodeService; import com.salesmanager.core.model.discount.DiscountCode; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.discount.DiscountCodeRequest; import com.salesmanager.shop.model.discount.DiscountCodeResponse; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/discounts") public class DiscountCodeApi {
+ @Inject private DiscountCodeService service;
+ @GetMapping public List<DiscountCodeResponse> list(@ApiIgnore MerchantStore store){List<DiscountCodeResponse> out=new ArrayList<>(); for(DiscountCode c:service.listByStore(store))out.add(toResponse(c)); return out;}
+ @PostMapping public ResponseEntity<?> create(@RequestBody DiscountCodeRequest r,@ApiIgnore MerchantStore store){try{validate(r); if(service.getByCode(store,r.getCode())!=null)return ResponseEntity.status(HttpStatus.CONFLICT).build(); DiscountCode c=from(r,store); service.create(c); return ResponseEntity.status(HttpStatus.CREATED).body(toResponse(c));}catch(IllegalArgumentException e){return ResponseEntity.badRequest().body(e.getMessage());}catch(Exception e){return ResponseEntity.badRequest().body(e.getMessage());}}
+ @PutMapping("/{id}") public ResponseEntity<?> update(@PathVariable Long id,@RequestBody DiscountCodeRequest r,@ApiIgnore MerchantStore store){try{validate(r); DiscountCode c=service.getById(store,id); if(c==null)return ResponseEntity.notFound().build(); DiscountCode same=service.getByCode(store,r.getCode()); if(same!=null&&!id.equals(same.getId()))return ResponseEntity.status(HttpStatus.CONFLICT).build(); copy(r,c,store); service.update(c); return ResponseEntity.ok(toResponse(c));}catch(Exception e){return ResponseEntity.badRequest().body(e.getMessage());}}
+ @DeleteMapping("/{id}") public ResponseEntity<?> delete(@PathVariable Long id,@ApiIgnore MerchantStore store){DiscountCode c=service.getById(store,id);if(c==null)return ResponseEntity.notFound().build();try{service.delete(c);return ResponseEntity.noContent().build();}catch(Exception e){return ResponseEntity.badRequest().build();}}
+ private void validate(DiscountCodeRequest r){if(r==null||r.getCode()==null||r.getCode().trim().isEmpty()||r.getType()==null||r.getValue()==null)throw new IllegalArgumentException("code, type and value are required");if(r.getValue().signum()<=0||(r.getType()==com.salesmanager.core.model.discount.DiscountType.PERCENT&&r.getValue().compareTo(java.math.BigDecimal.valueOf(100))>0))throw new IllegalArgumentException("invalid value");if(r.getStartDate()!=null&&r.getEndDate()!=null&&r.getEndDate().isBefore(r.getStartDate()))throw new IllegalArgumentException("endDate before startDate");if(r.getMinimumSubtotal()!=null&&r.getMinimumSubtotal().signum()<0)throw new IllegalArgumentException("invalid minimumSubtotal");}
+ private DiscountCode from(DiscountCodeRequest r,MerchantStore s){DiscountCode c=new DiscountCode();copy(r,c,s);return c;}
+ private void copy(DiscountCodeRequest r,DiscountCode c,MerchantStore s){c.setMerchantStore(s);c.setCode(r.getCode().trim());c.setType(r.getType());c.setValue(r.getValue());c.setMinimumSubtotal(r.getMinimumSubtotal());c.setStartDate(r.getStartDate()==null?LocalDate.now():r.getStartDate());c.setEndDate(r.getEndDate());c.setCategories(r.getCategories());c.setActive(r.getActive()==null||r.getActive());}
+ private DiscountCodeResponse toResponse(DiscountCode c){DiscountCodeResponse r=new DiscountCodeResponse();r.setId(c.getId());r.setCode(c.getCode());r.setType(c.getType());r.setValue(c.getValue());r.setMinimumSubtotal(c.getMinimumSubtotal());r.setStartDate(c.getStartDate());r.setEndDate(c.getEndDate());r.setCategories(c.getCategories());r.setActive(c.isActive());return r;}
+}
