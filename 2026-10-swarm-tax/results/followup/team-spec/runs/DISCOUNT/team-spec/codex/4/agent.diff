+	private void applyDiscount(ShoppingCart cart, MerchantStore store, OrderTotalSummary summary) throws ServiceException {
+		if (cart.getPromoCode() == null) return;
+		DiscountCode code = discountCodeService.getByCode(store, cart.getPromoCode());
+		BigDecimal eligible = BigDecimal.ZERO;
+		for (ShoppingCartItem item : cart.getLineItems()) {
+			if (!eligible(code, item)) continue;
+			com.salesmanager.core.model.catalog.product.price.FinalPrice p = pricingService.calculateProductPrice(item.getProduct());
+			eligible = eligible.add(p.getFinalPrice().multiply(BigDecimal.valueOf(item.getQuantity())));
+		}
+		BigDecimal subtotal = summary.getSubTotal() == null ? BigDecimal.ZERO : summary.getSubTotal();
+		if (!discountCodeService.applies(code, subtotal, eligible.signum() > 0, LocalDate.now())) { cart.setPromoCode(null); cart.setPromoAdded(null); return; }
+		BigDecimal discount = code.getType() == DiscountType.PERCENT ? eligible.multiply(code.getValue()).divide(BigDecimal.valueOf(100), 2, RoundingMode.HALF_UP) : code.getValue().min(eligible).setScale(2, RoundingMode.HALF_UP);
+		OrderTotal total = new OrderTotal(); total.setOrderTotalCode(com.salesmanager.core.business.constants.Constants.OT_DISCOUNT_TITLE); total.setOrderTotalType(OrderTotalType.SUBTOTAL); total.setText(code.getCode()); total.setValue(discount); summary.getTotals().add(total); summary.setTotal(summary.getTotal().subtract(discount));
+	}
+	private boolean eligible(DiscountCode code, ShoppingCartItem item) {
+		if (code == null || code.getCategories() == null || code.getCategories().isEmpty()) return true;
+		for (Category c : item.getProduct().getCategories()) for (String wanted : code.getCategories()) if (wanted.equalsIgnoreCase(c.getCode()) || (c.getLineage()!=null && c.getLineage().contains("/"+wanted+"/"))) return true;
+		return false;
+	}
+
