+  @ElementCollection @CollectionTable(name="DISCOUNT_CODE_CATEGORY", joinColumns=@JoinColumn(name="DISCOUNT_ID")) @Column(name="CATEGORY_CODE") private List<String> categories = new ArrayList<String>();
