+@Service("discountCodeService") public class DiscountCodeServiceImpl extends SalesManagerEntityServiceImpl<Long,DiscountCode> implements DiscountCodeService {
+ private final DiscountCodeRepository repo; @Inject public DiscountCodeServiceImpl(DiscountCodeRepository r){super(r);repo=r;}
+ public List<DiscountCode> listByStore(MerchantStore s){return repo.findByMerchantStoreId(s.getId());}
+ public DiscountCode getByCode(MerchantStore s,String c){return c==null?null:repo.findByMerchantStoreIdAndCodeKey(s.getId(),c.trim().toLowerCase(java.util.Locale.ROOT));}
+ public DiscountCode getById(MerchantStore s,Long id){return repo.findByIdAndMerchantStoreId(id,s.getId());}
+ public boolean applies(DiscountCode c,BigDecimal subtotal,boolean eligible,LocalDate date){return c!=null&&c.isActive()&&date!=null&&(c.getStartDate()==null||!date.isBefore(c.getStartDate()))&&(c.getEndDate()==null||!date.isAfter(c.getEndDate()))&&(c.getMinimumSubtotal()==null||subtotal.compareTo(c.getMinimumSubtotal())>=0)&&eligible;}
+}
