+ public Date getCreatedAt(){return createdAt;} public Date getSentAt(){return sentAt;} public void setSentAt(Date d){sentAt=d;}
+ public boolean isNewlyCreated(){return newlyCreated;} public void setNewlyCreated(boolean b){newlyCreated=b;}
+}
