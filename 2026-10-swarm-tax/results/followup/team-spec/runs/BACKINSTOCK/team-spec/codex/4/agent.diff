+public interface StockAlertService { StockAlert request(Product p,MerchantStore s,String email); void cancel(Product p,MerchantStore s,String email); List<StockAlert> list(MerchantStore s,String status); List<StockAlertOutbox> outbox(MerchantStore s); void restocked(Product p,MerchantStore s); }
