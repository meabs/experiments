+package com.salesmanager.shop.store.api.v1.product;
+import java.util.*; import javax.inject.Inject; import javax.validation.Valid; import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.catalog.product.stock.StockAlertService; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.stock.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.catalog.product.stock.*; import com.salesmanager.shop.store.api.exception.UnauthorizedException; import com.salesmanager.shop.store.controller.user.facade.UserFacade; import com.salesmanager.shop.utils.AuthorizationUtils; import com.salesmanager.shop.constants.Constants; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class StockAlertApi {
+ @Inject StockAlertService service; @Inject ProductService products; @Inject UserFacade users; @Inject AuthorizationUtils authorization;
+ private Product product(String sku,MerchantStore s){try {Product p=products.getBySku(sku,s); if(p==null) throw new org.springframework.web.server.ResponseStatusException(HttpStatus.NOT_FOUND); return p;} catch(com.salesmanager.core.business.exception.ServiceException e){throw new org.springframework.web.server.ResponseStatusException(HttpStatus.NOT_FOUND);}}
+ @PostMapping("/products/{sku}/alerts") public ResponseEntity<ReadableStockAlert> add(@PathVariable String sku,@Valid @RequestBody StockAlertRequest req,@ApiIgnore MerchantStore store){Product p=product(sku,store); try {StockAlert a=service.request(p,store,req.getEmail()); ReadableStockAlert r=read(a); return ResponseEntity.status(a.isNewlyCreated()?HttpStatus.CREATED:HttpStatus.OK).body(r);}catch(IllegalStateException e){throw new org.springframework.web.server.ResponseStatusException(HttpStatus.CONFLICT);}}
+ @DeleteMapping("/products/{sku}/alerts") public ResponseEntity<Void> cancel(@PathVariable String sku,@RequestParam String email,@ApiIgnore MerchantStore store){if(email==null||!email.matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"))throw new org.springframework.web.server.ResponseStatusException(HttpStatus.BAD_REQUEST);try{service.cancel(product(sku,store),store,email);}catch(IllegalArgumentException e){throw new org.springframework.web.server.ResponseStatusException(HttpStatus.NOT_FOUND);}return ResponseEntity.noContent().build();}
+ @GetMapping("/private/stock-alerts") public List<ReadableStockAlert> list(@RequestParam(required=false) String status,@ApiIgnore MerchantStore store){if(status!=null&&!status.matches("PENDING|SENT"))throw new org.springframework.web.server.ResponseStatusException(HttpStatus.BAD_REQUEST);auth(store);List<ReadableStockAlert> out=new ArrayList<>();for(StockAlert a:service.list(store,status))out.add(read(a));return out;}
+ @GetMapping("/private/stock-alerts/outbox") public List<ReadableStockAlertOutbox> outbox(@ApiIgnore MerchantStore store){auth(store);List<ReadableStockAlertOutbox> out=new ArrayList<>();for(StockAlertOutbox a:service.outbox(store)){ReadableStockAlertOutbox r=new ReadableStockAlertOutbox();r.to=a.getTo();r.sku=a.getSku();r.subject=a.getSubject();r.createdAt=a.getCreatedAt();out.add(r);}return out;}
+ private void auth(MerchantStore store){String u=authorization.authenticatedUser();authorization.authorizeUser(u,Arrays.asList(Constants.GROUP_SUPERADMIN,Constants.GROUP_ADMIN,Constants.GROUP_ADMIN_RETAIL),store);}
+ private ReadableStockAlert read(StockAlert a){ReadableStockAlert r=new ReadableStockAlert();r.id=a.getId();r.sku=a.getProduct().getSku();r.email=a.getEmail();r.status=a.getStatus();r.createdAt=a.getCreatedAt();r.sentAt=a.getSentAt();return r;}
+}
