+package com.salesmanager.core.business.services.catalog.product.stock;
+import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service; import com.salesmanager.core.business.repositories.catalog.product.stock.*; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.stock.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.business.exception.*;
+@Service("stockAlertService") public class StockAlertServiceImpl implements StockAlertService {
+ @Inject StockAlertRepository alerts; @Inject StockAlertOutboxRepository outbox;
+ public StockAlert request(Product p,MerchantStore s,String email){ if(p.getAvailabilities()==null||p.getAvailabilities().stream().filter(a->a.getMerchantStore()!=null&&a.getMerchantStore().getId().equals(s.getId())).anyMatch(a->a.getProductQuantity()!=null&&a.getProductQuantity()>0)) throw new IllegalStateException("Product is in stock"); return alerts.findByProductIdAndMerchantStoreIdAndEmailIgnoreCaseAndStatus(p.getId(),s.getId(),email,"PENDING").orElseGet(()->{StockAlert a=new StockAlert();a.setProduct(p);a.setMerchantStore(s);a.setEmail(email);a.setNewlyCreated(true);return alerts.save(a);}); }
+ public void cancel(Product p,MerchantStore s,String email){ StockAlert a=alerts.findByProductIdAndMerchantStoreIdAndEmailIgnoreCaseAndStatus(p.getId(),s.getId(),email,"PENDING").orElseThrow(()->new IllegalArgumentException("Alert not found")); alerts.delete(a); }
+ public List<StockAlert> list(MerchantStore s,String status){return status==null?alerts.findByMerchantStoreIdOrderByCreatedAtAsc(s.getId()):alerts.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(s.getId(),status);}
+ public List<StockAlertOutbox> outbox(MerchantStore s){return outbox.findByMerchantStoreIdOrderByCreatedAtAsc(s.getId());}
+ public void restocked(Product p,MerchantStore s){for(StockAlert a:alerts.findByProductIdAndMerchantStoreIdAndStatus(p.getId(),s.getId(),"PENDING")){a.setStatus("SENT");a.setSentAt(new Date());alerts.save(a);StockAlertOutbox o=new StockAlertOutbox();o.setMerchantStore(s);o.setTo(a.getEmail());o.setSku(p.getSku());String n=p.getDescriptions().isEmpty()?p.getSku():p.getDescriptions().iterator().next().getName();o.setSubject(n+" is back in stock");outbox.save(o);}}
+}
