+package com.salesmanager.shop.store.api.v1.product;
+import java.util.*; import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.business.services.catalog.product.alert.StockAlertService; import com.salesmanager.core.model.catalog.product.alert.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.catalog.product.alert.*; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class StockAlertApi {
+ private final StockAlertService service; public StockAlertApi(StockAlertService s){service=s;}
+ @PostMapping("/products/{sku}/alerts") public ResponseEntity<ReadableStockAlert> request(@PathVariable String sku,@RequestBody StockAlertRequest req,@ApiIgnore MerchantStore store){if(req==null)throw new IllegalArgumentException("Invalid request");boolean duplicate=false;for(StockAlert x:service.list(store,"PENDING"))if(x.getSku().equals(sku)&&req.getEmail()!=null&&x.getEmail().equalsIgnoreCase(req.getEmail()))duplicate=true;StockAlert a=service.request(sku,req.getEmail(),store); return ResponseEntity.status(duplicate?HttpStatus.OK:HttpStatus.CREATED).body(alert(a));}
+ @DeleteMapping("/products/{sku}/alerts") public ResponseEntity<Void> cancel(@PathVariable String sku,@RequestParam String email,@ApiIgnore MerchantStore store){service.cancel(sku,email,store);return ResponseEntity.noContent().build();}
+ @GetMapping("/private/stock-alerts") public List<ReadableStockAlert> list(@RequestParam(required=false) String status,@ApiIgnore MerchantStore store){List<ReadableStockAlert> r=new ArrayList<>();for(StockAlert a:service.list(store,status))r.add(alert(a));return r;}
+ @GetMapping("/private/stock-alerts/outbox") public List<ReadableStockAlertOutbox> outbox(@ApiIgnore MerchantStore store){List<ReadableStockAlertOutbox> r=new ArrayList<>();for(StockAlertOutbox o:service.outbox(store)){ReadableStockAlertOutbox x=new ReadableStockAlertOutbox();x.to=o.getRecipient();x.sku=o.getSku();x.subject=o.getSubject();x.createdAt=o.getCreatedAt();r.add(x);}return r;}
+ private ReadableStockAlert alert(StockAlert a){ReadableStockAlert r=new ReadableStockAlert();r.id=a.getId();r.sku=a.getSku();r.email=a.getEmail();r.status=a.getStatus();r.createdAt=a.getCreatedAt();r.sentAt=a.getSentAt();return r;}
+ @ExceptionHandler(IllegalArgumentException.class) @ResponseStatus(HttpStatus.BAD_REQUEST) public void bad(){ }
+ @ExceptionHandler(IllegalStateException.class) @ResponseStatus(HttpStatus.CONFLICT) public void conflict(){ }
+ @ExceptionHandler(NoSuchElementException.class) @ResponseStatus(HttpStatus.NOT_FOUND) public void missing(){ }
+}
