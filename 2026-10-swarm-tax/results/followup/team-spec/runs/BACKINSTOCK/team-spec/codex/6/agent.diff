+package com.salesmanager.core.business.services.catalog.product.alert;
+import java.util.*; import java.util.regex.Pattern; import javax.inject.Inject; import javax.transaction.Transactional; import org.springframework.stereotype.Service; import com.salesmanager.core.business.repositories.catalog.product.alert.*; import com.salesmanager.core.model.catalog.product.alert.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.model.catalog.product.Product;
+@Service("stockAlertService") public class StockAlertServiceImpl implements StockAlertService {
+ @Inject StockAlertRepository alerts; @Inject StockAlertOutboxRepository outbox; @Inject ProductService products;
+ private static final Pattern EMAIL=Pattern.compile("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$");
+ private Product product(String sku,MerchantStore s){ try { Product p=products.getBySku(sku,s); if(p==null) throw new RuntimeException("not found"); return p;} catch(Exception e){throw new NoSuchElementException("Unknown sku");} }
+ public StockAlert request(String sku,String email,MerchantStore s){ if(email==null||!EMAIL.matcher(email).matches()) throw new IllegalArgumentException("Invalid email"); Product p=product(sku,s); boolean stocked=p.getAvailabilities()!=null&&p.getAvailabilities().stream().anyMatch(a->a.getProductQuantity()!=null&&a.getProductQuantity()>0); if(stocked) throw new IllegalStateException("Product is in stock"); for(StockAlert a:alerts.findByMerchantStoreIdAndSkuAndStatusOrderByCreatedAtAsc(s.getId(),sku,"PENDING")) if(a.getEmail().equalsIgnoreCase(email)) return a; StockAlert a=new StockAlert(); a.setSku(sku);a.setEmail(email);a.setMerchantStore(s); return alerts.save(a); }
+ public void cancel(String sku,String email,MerchantStore s){ if(email==null||!EMAIL.matcher(email).matches()) throw new IllegalArgumentException("Invalid email"); for(StockAlert a:alerts.findByMerchantStoreIdAndSkuAndStatusOrderByCreatedAtAsc(s.getId(),sku,"PENDING")) if(a.getEmail().equalsIgnoreCase(email)){alerts.delete(a);return;} throw new NoSuchElementException("Alert not found"); }
+ public List<StockAlert> list(MerchantStore s,String status){if(status!=null&&!status.matches("PENDING|SENT")) throw new IllegalArgumentException("Invalid status"); return status==null?alerts.findByMerchantStoreIdOrderByCreatedAtAsc(s.getId()):alerts.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(s.getId(),status);}
+ public List<StockAlertOutbox> outbox(MerchantStore s){return outbox.findByMerchantStoreIdOrderByCreatedAtAsc(s.getId());}
+ @Transactional public void dispatch(String sku,MerchantStore s,String name){for(StockAlert a:alerts.findByMerchantStoreIdAndSkuAndStatusOrderByCreatedAtAsc(s.getId(),sku,"PENDING")){a.setStatus("SENT");a.setSentAt(new Date());alerts.save(a);StockAlertOutbox o=new StockAlertOutbox();o.setMerchantStore(s);o.setSku(sku);o.setRecipient(a.getEmail());o.setSubject(name+" is back in stock");outbox.save(o);}}
+ public void deleteForSku(String sku,MerchantStore s){for(StockAlert a:alerts.findByMerchantStoreIdAndSkuAndStatusOrderByCreatedAtAsc(s.getId(),sku,"PENDING")) alerts.delete(a); for(StockAlert a:alerts.findByMerchantStoreIdAndSkuAndStatusOrderByCreatedAtAsc(s.getId(),sku,"SENT")) alerts.delete(a);}
+}
