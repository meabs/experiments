+package com.salesmanager.shop.store.api.v1.product;
+import java.util.*; import javax.validation.Valid; import org.springframework.beans.factory.annotation.Autowired; import org.springframework.http.HttpStatus; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.catalog.product.stock.StockAlertService; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.stock.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.catalog.product.stock.*; import com.salesmanager.shop.store.api.exception.*; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class StockAlertApi { @Autowired StockAlertService service; @Autowired ProductService products;
+ private Product product(String sku,MerchantStore s){try{Product p=products.getBySku(sku,s);if(p==null)throw new ResourceNotFoundException("Product not found");return p;}catch(Exception e){if(e instanceof ServiceRuntimeException)throw (ServiceRuntimeException)e;throw new ResourceNotFoundException("Product not found");}}
+ @PostMapping("/products/{sku}/alerts") public org.springframework.http.ResponseEntity<ReadableStockAlert> ask(@PathVariable String sku,@Valid @RequestBody PersistableStockAlert body,@ApiIgnore MerchantStore store){Product p=product(sku,store);if(p.getAvailabilities()!=null&&p.getAvailabilities().stream().anyMatch(a->a.getProductQuantity()!=null&&a.getProductQuantity()>0))throw new ServiceRuntimeException("409","Product is in stock");StockAlert existing=service.pending(p,store,body.getEmail());ReadableStockAlert result=map(service.request(p,store,body.getEmail()));return org.springframework.http.ResponseEntity.status(existing==null?HttpStatus.CREATED:HttpStatus.OK).body(result);}
+ @DeleteMapping("/products/{sku}/alerts") @ResponseStatus(HttpStatus.NO_CONTENT) public void cancel(@PathVariable String sku,@RequestParam String email,@ApiIgnore MerchantStore store){if(email==null||!email.matches("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"))throw new ServiceRuntimeException("400","Invalid email");try{service.cancel(product(sku,store),store,email);}catch(NoSuchElementException e){throw new ResourceNotFoundException("Alert not found");}}
+ @GetMapping("/private/stock-alerts") public List<ReadableStockAlert> list(@RequestParam(required=false) String status,@ApiIgnore MerchantStore store){StockAlertStatus st=null;if(status!=null)try{st=StockAlertStatus.valueOf(status);}catch(Exception e){throw new ServiceRuntimeException("400","Invalid status");}List<ReadableStockAlert> out=new ArrayList<>();for(StockAlert a:service.list(store,st))out.add(map(a));return out;}
+ @GetMapping("/private/stock-alerts/outbox") public List<ReadableStockAlertOutbox> outbox(@ApiIgnore MerchantStore store){List<ReadableStockAlertOutbox> out=new ArrayList<>();for(StockAlertOutbox m:service.outbox(store)){ReadableStockAlertOutbox x=new ReadableStockAlertOutbox();x.setTo(m.getToEmail());x.setSku(m.getSku());x.setSubject(m.getSubject());x.setCreatedAt(m.getCreatedAt());out.add(x);}return out;}
+ private ReadableStockAlert map(StockAlert a){ReadableStockAlert x=new ReadableStockAlert();x.setId(a.getId());x.setSku(a.getProduct().getSku());x.setEmail(a.getEmail());x.setStatus(a.getStatus().name());x.setCreatedAt(a.getCreatedAt());x.setSentAt(a.getSentAt());return x;}
+}
