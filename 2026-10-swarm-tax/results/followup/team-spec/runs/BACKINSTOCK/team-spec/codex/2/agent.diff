+package com.salesmanager.core.business.services.catalog.product.stock;
+import java.util.*; import org.springframework.beans.factory.annotation.Autowired; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional; import com.salesmanager.core.business.repositories.catalog.product.stock.*; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.stock.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service public class StockAlertServiceImpl implements StockAlertService { @Autowired StockAlertRepository alerts; @Autowired StockAlertOutboxRepository outbox;
+ public StockAlert pending(Product p,MerchantStore s,String email){return alerts.pending(s.getId(),p.getId(),email).orElse(null);}
+ public StockAlert request(Product p,MerchantStore s,String email){Optional<StockAlert> old=alerts.pending(s.getId(),p.getId(),email); if(old.isPresent()) return old.get(); StockAlert a=new StockAlert();a.setProduct(p);a.setMerchantStore(s);a.setEmail(email);return alerts.save(a);}
+ public void cancel(Product p,MerchantStore s,String email){StockAlert a=alerts.pending(s.getId(),p.getId(),email).orElseThrow(NoSuchElementException::new);alerts.delete(a);}
+ public List<StockAlert> list(MerchantStore s,StockAlertStatus st){return st==null?alerts.findByMerchantStoreIdOrderByCreatedAtAsc(s.getId()):alerts.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(s.getId(),st);}
+ public List<StockAlertOutbox> outbox(MerchantStore s){return outbox.findByMerchantStoreIdOrderByCreatedAtAsc(s.getId());}
+ @Transactional public void dispatch(Product p,MerchantStore s){for(StockAlert a:alerts.findByProductIdAndStatusOrderByCreatedAtAsc(p.getId(),StockAlertStatus.PENDING)){a.setStatus(StockAlertStatus.SENT);a.setSentAt(new Date());alerts.save(a);StockAlertOutbox m=new StockAlertOutbox();m.setMerchantStore(s);m.setToEmail(a.getEmail());m.setSku(p.getSku());m.setSubject(productName(p)+" is back in stock");outbox.save(m);}}
+ private String productName(Product p){try{return p.getDescriptions().iterator().next().getName();}catch(Exception e){return p.getSku();}}
+ public void deleteForProduct(Product p){alerts.deleteByProductId(p.getId());}
+}
