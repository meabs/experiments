+ public String getEmail(){return email;} public void setEmail(String v){email=v;}
+ public StockAlertStatus getStatus(){return status;} public void setStatus(StockAlertStatus v){status=v;}
+ public Date getCreatedAt(){return createdAt;} public Date getSentAt(){return sentAt;} public void setSentAt(Date v){sentAt=v;}
+ public MerchantStore getMerchantStore(){return merchantStore;} public void setMerchantStore(MerchantStore v){merchantStore=v;}
+}
