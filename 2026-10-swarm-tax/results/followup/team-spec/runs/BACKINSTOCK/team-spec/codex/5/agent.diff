+public interface StockAlertService { boolean pending(String sku,String email,MerchantStore store); StockAlert ask(String sku,String email,MerchantStore store); void cancel(String sku,String email,MerchantStore store); List<StockAlert> list(MerchantStore store,StockAlertStatus status); List<StockAlertOutbox> outbox(MerchantStore store); void restocked(String sku,MerchantStore store,String subject); void delete(String sku,MerchantStore store); }
