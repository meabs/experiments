+package com.salesmanager.core.business.services.catalog.product.stock;
+import java.util.*; import java.util.regex.Pattern; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional; import com.salesmanager.core.business.repositories.catalog.product.stock.*; import com.salesmanager.core.model.catalog.product.stock.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service public class StockAlertServiceImpl implements StockAlertService {
+ private final StockAlertRepository alerts; private final StockAlertOutboxRepository outbox; private static final Pattern EMAIL=Pattern.compile("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$");
+ public StockAlertServiceImpl(StockAlertRepository a,StockAlertOutboxRepository o){alerts=a;outbox=o;}
+ public boolean pending(String sku,String email,MerchantStore s){return alerts.pending(s.getId(),sku,email).isPresent();}
+ public StockAlert ask(String sku,String email,MerchantStore s){ if(email==null||!EMAIL.matcher(email).matches()) throw new IllegalArgumentException("Invalid email"); Optional<StockAlert> old=alerts.pending(s.getId(),sku,email); if(old.isPresent()) return old.get(); StockAlert a=new StockAlert();a.setSku(sku);a.setEmail(email);a.setMerchantStore(s);return alerts.save(a); }
+ public void cancel(String sku,String email,MerchantStore s){ StockAlert a=alerts.pending(s.getId(),sku,email).orElseThrow(NoSuchElementException::new); alerts.delete(a); }
+ public List<StockAlert> list(MerchantStore s,StockAlertStatus st){return st==null?alerts.list(s.getId()):alerts.list(s.getId(),st);} public List<StockAlertOutbox> outbox(MerchantStore s){return outbox.list(s.getId());}
+ @Transactional public void restocked(String sku,MerchantStore s,String subject){for(StockAlert a:alerts.pendingForSku(s.getId(),sku)){a.setStatus(StockAlertStatus.SENT);a.setSentAt(new Date());alerts.save(a);StockAlertOutbox o=new StockAlertOutbox();o.setMerchantStore(s);o.setSku(sku);o.setToEmail(a.getEmail());o.setSubject(subject);outbox.save(o);}}
+ @Transactional public void delete(String sku,MerchantStore s){alerts.deleteForSku(s.getId(),sku);}
+}
