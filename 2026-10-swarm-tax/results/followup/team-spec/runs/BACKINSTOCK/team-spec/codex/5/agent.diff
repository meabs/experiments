+package com.salesmanager.shop.store.api.v1.product;
+import java.util.*; import javax.validation.Valid; import org.springframework.beans.factory.annotation.Autowired; import org.springframework.http.*; import org.springframework.stereotype.Controller; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.catalog.product.stock.StockAlertService; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.availability.ProductAvailability; import com.salesmanager.core.model.catalog.product.stock.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.reference.language.Language; import com.salesmanager.shop.model.catalog.product.stock.StockAlertRequest; import com.salesmanager.shop.store.api.exception.*; import springfox.documentation.annotations.ApiIgnore;
+@Controller @RequestMapping("/api/v1") public class StockAlertApi {
+ @Autowired private StockAlertService service; @Autowired private ProductService products;
+ @PostMapping("/products/{sku}/alerts") public ResponseEntity<Map<String,Object>> ask(@PathVariable String sku,@Valid @RequestBody StockAlertRequest req,@ApiIgnore MerchantStore store,@ApiIgnore Language lang){ Product p=find(sku,store); int q=0; for(ProductAvailability a:p.getAvailabilities()) q=Math.max(q,a.getProductQuantity()==null?0:a.getProductQuantity()); if(q>0) throw new StockAlertConflictException("Product is in stock"); boolean duplicate=service.pending(sku,req.getEmail(),store); try {StockAlert a=service.ask(sku,req.getEmail(),store);return ResponseEntity.status(duplicate?HttpStatus.OK:HttpStatus.CREATED).body(view(a));}catch(IllegalArgumentException e){throw new StockAlertBadRequestException("Invalid email");} }
+ @DeleteMapping("/products/{sku}/alerts") @ResponseStatus(HttpStatus.NO_CONTENT) public void cancel(@PathVariable String sku,@RequestParam String email,@ApiIgnore MerchantStore store){find(sku,store);try{service.cancel(sku,email,store);}catch(Exception e){throw new ResourceNotFoundException("Alert not found");}}
+ @GetMapping("/private/stock-alerts") public List<Map<String,Object>> list(@RequestParam(required=false) String status,@ApiIgnore MerchantStore store){StockAlertStatus st=null;if(status!=null)try{st=StockAlertStatus.valueOf(status);}catch(Exception e){throw new StockAlertBadRequestException("Invalid status");}List<Map<String,Object>> r=new ArrayList<>();for(StockAlert a:service.list(store,st)){Map<String,Object> m=view(a);m.put("id",a.getId());m.put("createdAt",a.getCreatedAt());m.put("sentAt",a.getSentAt());r.add(m);}return r;}
+ @GetMapping("/private/stock-alerts/outbox") public List<Map<String,Object>> outbox(@ApiIgnore MerchantStore store){List<Map<String,Object>> r=new ArrayList<>();for(StockAlertOutbox o:service.outbox(store)){Map<String,Object> m=new LinkedHashMap<>();m.put("to",o.getToEmail());m.put("sku",o.getSku());m.put("subject",o.getSubject());m.put("createdAt",o.getCreatedAt());r.add(m);}return r;}
+ private Product find(String sku,MerchantStore s){try{Product p=products.getBySku(sku,s);if(p==null)throw new ResourceNotFoundException("Product not found");return p;}catch(Exception e){if(e instanceof ResourceNotFoundException)throw (ResourceNotFoundException)e;throw new ResourceNotFoundException("Product not found");}}
+ private Map<String,Object> view(StockAlert a){Map<String,Object> m=new LinkedHashMap<>();m.put("sku",a.getSku());m.put("email",a.getEmail());m.put("status",a.getStatus());return m;}
+}
