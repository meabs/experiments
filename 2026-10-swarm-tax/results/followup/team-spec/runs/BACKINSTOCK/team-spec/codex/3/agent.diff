+package com.salesmanager.core.business.services.catalog.product.stockalert;
+import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional; import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.business.repositories.catalog.product.stockalert.*; import com.salesmanager.core.model.catalog.product.stockalert.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("stockAlertService") public class StockAlertServiceImpl implements StockAlertService { @Inject private StockAlertRepository alerts; @Inject private StockAlertOutboxRepository outbox;
+ public StockAlert request(String sku,String email,MerchantStore store)throws ServiceException { Optional<StockAlert> old=alerts.findFirstByMerchantStoreIdAndSkuAndEmailIgnoreCaseAndStatus(store.getId(),sku,email,"PENDING"); if(old.isPresent())return old.get(); StockAlert a=new StockAlert();a.setMerchantStore(store);a.setSku(sku);a.setEmail(email);return alerts.save(a); }
+ public void cancel(String sku,String email,MerchantStore store)throws ServiceException { StockAlert a=alerts.findFirstByMerchantStoreIdAndSkuAndEmailIgnoreCaseAndStatus(store.getId(),sku,email,"PENDING").orElseThrow(()->new ServiceException("Alert not found")); alerts.delete(a); }
+ public List<StockAlert> list(MerchantStore s,String status){return status==null?alerts.findByMerchantStoreIdOrderByCreatedAtAsc(s.getId()):alerts.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(s.getId(),status);}
+ public List<StockAlertOutbox> outbox(MerchantStore s){return outbox.findByMerchantStoreIdOrderByCreatedAtAsc(s.getId());}
+ @Transactional public void restocked(String sku,String subject,MerchantStore store)throws ServiceException { for(StockAlert a:alerts.findByMerchantStoreIdAndSkuAndStatusOrderByCreatedAtAsc(store.getId(),sku,"PENDING")){a.setStatus("SENT");a.setSentAt(new Date());alerts.save(a);StockAlertOutbox o=new StockAlertOutbox();o.setMerchantStore(store);o.setSku(sku);o.setToEmail(a.getEmail());o.setSubject(subject);outbox.save(o);} }
+ public void delete(String sku,MerchantStore store){alerts.deleteAll(alerts.findBySkuAndMerchantStoreId(sku,store.getId()));}
+}
