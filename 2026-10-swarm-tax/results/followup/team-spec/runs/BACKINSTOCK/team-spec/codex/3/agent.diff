+package com.salesmanager.shop.store.api.v1.product;
+import java.util.*; import javax.validation.Valid; import javax.validation.constraints.Email; import javax.validation.constraints.NotBlank; import org.springframework.beans.factory.annotation.Autowired; import org.springframework.http.*; import org.springframework.stereotype.Controller; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.catalog.product.stockalert.StockAlertService; import com.salesmanager.core.business.services.catalog.product.availability.ProductAvailabilityService; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.stockalert.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.store.api.exception.ResourceNotFoundException; import com.salesmanager.shop.store.api.exception.RestApiException; import springfox.documentation.annotations.ApiIgnore;
+@ResponseStatus(HttpStatus.CONFLICT) class StockAlertConflictException extends RuntimeException { StockAlertConflictException(String m){super(m);} }
+@Controller @RequestMapping("/api/v1") public class StockAlertApi {
+ @Autowired private StockAlertService service; @Autowired private ProductService products; @Autowired private ProductAvailabilityService availability;
+ public static class Request { @NotBlank @Email public String email; }
+ private Product product(String sku,MerchantStore store){try { Product p=products.getBySku(sku,store); if(p==null)throw new ResourceNotFoundException("Product not found"); return p;}catch(Exception e){if(e instanceof ResourceNotFoundException)throw (ResourceNotFoundException)e; throw new ResourceNotFoundException("Product not found");}}
+ private Map<String,Object> view(StockAlert a){Map<String,Object> m=new LinkedHashMap<>();m.put("id",a.getId());m.put("sku",a.getSku());m.put("email",a.getEmail());m.put("status",a.getStatus());m.put("createdAt",a.getCreatedAt());m.put("sentAt",a.getSentAt());return m;}
+ @PostMapping("/products/{sku}/alerts") public ResponseEntity<Object> request(@PathVariable String sku,@Valid @RequestBody Request req,@ApiIgnore MerchantStore store){Product p=product(sku,store); if(p.getAvailabilities()==null||p.getAvailabilities().stream().anyMatch(a->a.getProductQuantity()!=null&&a.getProductQuantity()>0)) throw new StockAlertConflictException("Product is in stock"); try{boolean existing=service.list(store,"PENDING").stream().anyMatch(a->sku.equals(a.getSku())&&req.email.equalsIgnoreCase(a.getEmail())); return ResponseEntity.status(existing?HttpStatus.OK:HttpStatus.CREATED).body(view(service.request(sku,req.email,store)));}catch(Exception e){throw new RestApiException("400",e.getMessage());}}
+ @DeleteMapping("/products/{sku}/alerts") @ResponseStatus(HttpStatus.NO_CONTENT) public void cancel(@PathVariable String sku,@RequestParam String email,@ApiIgnore MerchantStore store){try{service.cancel(sku,email,store);}catch(Exception e){throw new ResourceNotFoundException("Alert not found");}}
+ @GetMapping("/private/stock-alerts") public List<Map<String,Object>> list(@RequestParam(required=false) String status,@ApiIgnore MerchantStore store){if(status!=null&&!status.equals("PENDING")&&!status.equals("SENT"))throw new RestApiException("400","Invalid status");List<Map<String,Object>> r=new ArrayList<>();for(StockAlert a:service.list(store,status))r.add(view(a));return r;}
+ @GetMapping("/private/stock-alerts/outbox") public List<Map<String,Object>> outbox(@ApiIgnore MerchantStore store){List<Map<String,Object>> r=new ArrayList<>();for(StockAlertOutbox o:service.outbox(store)){Map<String,Object> m=new LinkedHashMap<>();m.put("to",o.getToEmail());m.put("sku",o.getSku());m.put("subject",o.getSubject());m.put("createdAt",o.getCreatedAt());r.add(m);}return r;}
+}
