+package com.salesmanager.core.model.catalog.product.alert;
+
+import java.util.Date;
+import javax.persistence.*;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Entity
+@Table(name="STOCK_ALERT", indexes={@Index(name="STOCK_ALERT_LOOKUP", columnList="PRODUCT_ID,MERCHANT_ID,EMAIL,STATUS")})
+public class StockAlert {
+ @Id @GeneratedValue(strategy=GenerationType.AUTO) private Long id;
+ @ManyToOne(fetch=FetchType.LAZY, optional=false) @JoinColumn(name="PRODUCT_ID") private Product product;
+ @ManyToOne(fetch=FetchType.LAZY, optional=false) @JoinColumn(name="MERCHANT_ID") private MerchantStore merchantStore;
+ @Column(nullable=false) private String sku;
+ @Column(nullable=false) private String email;
+ @Enumerated(EnumType.STRING) @Column(nullable=false) private StockAlertStatus status=StockAlertStatus.PENDING;
+ @Temporal(TemporalType.TIMESTAMP) @Column(nullable=false) private Date createdAt=new Date();
+ @Temporal(TemporalType.TIMESTAMP) private Date sentAt;
+ public Long getId(){return id;} public void setId(Long v){id=v;}
+ public Product getProduct(){return product;} public void setProduct(Product v){product=v;}
+ public MerchantStore getMerchantStore(){return merchantStore;} public void setMerchantStore(MerchantStore v){merchantStore=v;}
+ public String getSku(){return sku;} public void setSku(String v){sku=v;}
+ public String getEmail(){return email;} public void setEmail(String v){email=v;}
+ public StockAlertStatus getStatus(){return status;} public void setStatus(StockAlertStatus v){status=v;}
+ public Date getCreatedAt(){return createdAt;} public void setCreatedAt(Date v){createdAt=v;}
+ public Date getSentAt(){return sentAt;} public void setSentAt(Date v){sentAt=v;}
+}
