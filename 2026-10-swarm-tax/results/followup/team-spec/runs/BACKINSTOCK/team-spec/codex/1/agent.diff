diff --git a/sm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/alert/StockAlertServiceImpl.java b/sm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/alert/StockAlertServiceImpl.java
