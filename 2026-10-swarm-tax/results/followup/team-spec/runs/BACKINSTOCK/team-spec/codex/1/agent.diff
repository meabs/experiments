+package com.salesmanager.shop.store.api.v1.product;
+import java.util.*; import org.springframework.beans.factory.annotation.Autowired; import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import javax.validation.Valid; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.catalog.product.alert.StockAlertService; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.alert.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.stockalert.*; import com.salesmanager.shop.store.api.exception.*; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class StockAlertApi {
+ @Autowired private ProductService products; @Autowired private StockAlertService service;
+ private Product product(String sku,MerchantStore s){try{Product p=products.getBySku(sku,s); if(p==null) throw new ResourceNotFoundException("Product not found"); return p;}catch(ResourceNotFoundException e){throw e;}catch(Exception e){throw new ResourceNotFoundException("Product not found");}}
+ @PostMapping("/products/{sku}/alerts") public ResponseEntity<ReadableStockAlert> request(@PathVariable String sku,@Valid @RequestBody PersistableStockAlert body,@ApiIgnore MerchantStore store){Product p=product(sku,store);try{boolean duplicate=service.hasPending(p,store,body.getEmail());StockAlert a=service.request(p,store,body.getEmail());return ResponseEntity.status(duplicate?HttpStatus.OK:HttpStatus.CREATED).body(read(a));}catch(IllegalStateException e){throw new ConflictException(e.getMessage());}}
+ @DeleteMapping("/products/{sku}/alerts") public ResponseEntity<Void> cancel(@PathVariable String sku,@RequestParam String email,@ApiIgnore MerchantStore store){try{service.cancel(product(sku,store),store,email);return ResponseEntity.noContent().build();}catch(NoSuchElementException e){throw new ResourceNotFoundException("Alert not found");}}
+ @GetMapping("/private/stock-alerts") public List<ReadableStockAlert> list(@RequestParam(required=false) String status,@ApiIgnore MerchantStore store){StockAlertStatus st=null;if(status!=null)try{st=StockAlertStatus.valueOf(status);}catch(Exception e){throw new RestApiException("Invalid status");}List<ReadableStockAlert> r=new ArrayList<>();for(StockAlert a:service.list(store,st))r.add(read(a));return r;}
+ @GetMapping("/private/stock-alerts/outbox") public List<ReadableStockAlertOutbox> outbox(@ApiIgnore MerchantStore store){List<ReadableStockAlertOutbox> r=new ArrayList<>();for(StockAlertOutboxMessage m:service.outbox(store)){ReadableStockAlertOutbox x=new ReadableStockAlertOutbox();x.setTo(m.getTo());x.setSku(m.getSku());x.setSubject(m.getSubject());x.setCreatedAt(m.getCreatedAt());r.add(x);}return r;}
+ private ReadableStockAlert read(StockAlert a){ReadableStockAlert r=new ReadableStockAlert();r.setId(a.getId());r.setSku(a.getSku());r.setEmail(a.getEmail());r.setStatus(a.getStatus().name());r.setCreatedAt(a.getCreatedAt());r.setSentAt(a.getSentAt());return r;}
+}
