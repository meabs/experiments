+package com.salesmanager.core.business.services.catalog.product.alert;
+import java.util.*; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional; import org.springframework.beans.factory.annotation.Autowired;
+import com.salesmanager.core.business.repositories.catalog.product.alert.*; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.alert.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service
+public class StockAlertServiceImpl implements StockAlertService {
+ @Autowired private StockAlertRepository alerts; @Autowired private StockAlertOutboxRepository outbox;
+ private void check(Product p, MerchantStore s){if(p==null || p.getMerchantStore()==null || !p.getMerchantStore().getId().equals(s.getId())) throw new IllegalArgumentException("Product not found");}
+ public boolean hasPending(Product p, MerchantStore s, String email){check(p,s); return alerts.findFirstByProductIdAndMerchantStoreIdAndEmailIgnoreCaseAndStatus(p.getId(),s.getId(),email,StockAlertStatus.PENDING).isPresent();}
+ public StockAlert request(Product p, MerchantStore s,String email){check(p,s); if(p.getAvailabilities()==null || p.getAvailabilities().stream().noneMatch(a->a.getProductQuantity()!=null&&a.getProductQuantity()>0)) { Optional<StockAlert> old=alerts.findFirstByProductIdAndMerchantStoreIdAndEmailIgnoreCaseAndStatus(p.getId(),s.getId(),email,StockAlertStatus.PENDING); if(old.isPresent()) return old.get(); StockAlert a=new StockAlert(); a.setProduct(p);a.setMerchantStore(s);a.setSku(p.getSku());a.setEmail(email); return alerts.save(a);} throw new IllegalStateException("Product is in stock"); }
+ @Transactional public void cancel(Product p,MerchantStore s,String email){check(p,s); StockAlert a=alerts.findFirstByProductIdAndMerchantStoreIdAndEmailIgnoreCaseAndStatus(p.getId(),s.getId(),email,StockAlertStatus.PENDING).orElseThrow(()->new NoSuchElementException("Alert not found")); alerts.delete(a);}
+ public List<StockAlert> list(MerchantStore s,StockAlertStatus status){return status==null?alerts.findByMerchantStoreIdOrderByCreatedAtAsc(s.getId()):alerts.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(s.getId(),status);}
+ public List<StockAlertOutboxMessage> outbox(MerchantStore s){return outbox.findByMerchantStoreIdOrderByCreatedAtAsc(s.getId());}
+ @Transactional public void restocked(Product p,MerchantStore s){check(p,s); for(StockAlert a:alerts.findByProductIdAndMerchantStoreIdAndStatusOrderByCreatedAtAsc(p.getId(),s.getId(),StockAlertStatus.PENDING)){a.setStatus(StockAlertStatus.SENT);a.setSentAt(new Date());alerts.save(a);StockAlertOutboxMessage m=new StockAlertOutboxMessage();m.setMerchantStore(s);m.setToEmail(a.getEmail());m.setSku(a.getSku());String n=p.getProductDescription()==null?p.getSku():p.getProductDescription().getName();m.setSubject(n+" is back in stock");outbox.save(m);}}
+ @Transactional public void deleteForProduct(Product p){if(p!=null&&p.getId()!=null){alerts.deleteByProductId(p.getId());}}
+}
