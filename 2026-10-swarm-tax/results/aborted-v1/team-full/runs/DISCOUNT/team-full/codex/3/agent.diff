+package com.salesmanager.core.business.services.order.discount;
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.util.List;
+import java.util.Set;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.order.discount.DiscountRepository;
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.discount.Discount;
+import com.salesmanager.core.model.order.discount.DiscountType;
+@Service("discountService")
+public class DiscountServiceImpl extends SalesManagerEntityServiceImpl<Long,Discount> implements DiscountService {
+ private final DiscountRepository repository; @Inject private CategoryService categoryService;
+ @Inject public DiscountServiceImpl(DiscountRepository r){super(r);repository=r;}
+ public Discount getByCode(MerchantStore s,String c){return s==null||c==null?null:repository.findByStoreAndCode(s.getId(),c).orElse(null);}
+ public Discount getApplicable(MerchantStore s,String c){Discount d=s==null||c==null?null:repository.findApplicable(s.getId(),c).orElse(null); if(d==null)return null; LocalDate n=LocalDate.now(); return (d.isActive()&&!n.isBefore(d.getStartDate())&&(d.getEndDate()==null||!n.isAfter(d.getEndDate())))?d:null;}
+ public List<Discount> listByStore(MerchantStore s){return repository.findByMerchantStoreId(s.getId());}
+ public void validate(Discount d,MerchantStore s)throws ServiceException {if(s==null||d==null||d.getCode()==null||d.getCode().trim().isEmpty())throw new ServiceException("Discount code is required"); if(d.getType()==null||d.getValue()==null||d.getValue().compareTo(BigDecimal.ZERO)<=0)throw new ServiceException("Discount type and positive value are required"); if(d.getType()==DiscountType.PERCENT&&d.getValue().compareTo(new BigDecimal("100"))>0)throw new ServiceException("Percentage cannot exceed 100"); if(d.getStartDate()==null)d.setStartDate(LocalDate.now()); if(d.getEndDate()!=null&&d.getEndDate().isBefore(d.getStartDate()))throw new ServiceException("End date must not precede start date"); if(d.getMinimumSubtotal()!=null&&d.getMinimumSubtotal().compareTo(BigDecimal.ZERO)<0)throw new ServiceException("Minimum subtotal must be non-negative"); Discount existing=getByCode(s,d.getCode()); if(existing!=null&&!existing.getId().equals(d.getId()))throw new ServiceException("Discount code already exists"); if(d.getCategoryCodes()!=null)for(String c:d.getCategoryCodes())if(categoryService.getByCode(s,c)==null)throw new ServiceException("Unknown category: "+c); }
+ public void saveOrUpdate(Discount d,MerchantStore s)throws ServiceException{validate(d,s);d.setMerchantStore(s);if(d.getCode()!=null)d.setCode(d.getCode().trim());if(d.getId()==null)create(d);else update(d);}
+ public boolean isApplicable(Discount d,BigDecimal subtotal,Set<String> categories){if(d==null||!d.isActive()||subtotal==null)return false;LocalDate n=LocalDate.now();if(n.isBefore(d.getStartDate())||(d.getEndDate()!=null&&n.isAfter(d.getEndDate())))return false;if(d.getMinimumSubtotal()!=null&&subtotal.compareTo(d.getMinimumSubtotal())<0)return false;return d.getCategoryCodes()==null||d.getCategoryCodes().isEmpty()||(categories!=null&&categories.stream().anyMatch(c->d.getCategoryCodes().stream().anyMatch(x->x.equalsIgnoreCase(c))));}
+ public BigDecimal calculateDiscount(Discount d,BigDecimal subtotal){if(d==null||subtotal==null||d.getValue()==null)return BigDecimal.ZERO;BigDecimal amount=d.getType()==DiscountType.PERCENT?subtotal.multiply(d.getValue()).divide(new BigDecimal("100")):d.getValue();return amount.compareTo(subtotal)>0?subtotal:amount;}
+}
