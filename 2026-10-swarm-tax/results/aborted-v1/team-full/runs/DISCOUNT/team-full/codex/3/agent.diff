+    @Autowired private DiscountService discountService;
+    private String name;
+    private String code;
+    @Override public String getName() { return name; }
+    @Override public void setName(String name) { this.name = name; }
+    @Override public String getCode() { return code; }
+    @Override public void setCode(String code) { this.code = code; }
 
+    @Override
+    public OrderTotal caculateProductPiceVariation(OrderSummary summary, ShoppingCartItem item,
+            Product product, Customer customer, MerchantStore store) throws Exception {
+        Validate.notNull(summary, "OrderTotalSummary must not be null");
+        Validate.notNull(store, "MerchantStore must not be null");
+        if (StringUtils.isBlank(summary.getPromoCode()) || product == null) return null;
+        Discount discount = discountService.getApplicable(store, summary.getPromoCode());
+        if (discount == null || !eligible(discount, product) || belowMinimum(discount, summary)) return null;
+        BigDecimal itemValue = item.getItemPrice().multiply(BigDecimal.valueOf(item.getQuantity()));
+        BigDecimal reduction;
+        if (discount.getType() == DiscountType.PERCENT) {
+            reduction = itemValue.multiply(discount.getValue()).divide(BigDecimal.valueOf(100), 2, RoundingMode.HALF_UP);
+        } else {
+            BigDecimal priorEligible = BigDecimal.ZERO;
+            for (ShoppingCartItem candidate : summary.getProducts()) {
+                if (candidate == item) break;
+                if (eligible(discount, candidate.getProduct()))
+                    priorEligible = priorEligible.add(candidate.getItemPrice().multiply(BigDecimal.valueOf(candidate.getQuantity())));
+            }
+            BigDecimal remaining = discount.getValue().subtract(priorEligible);
+            if (remaining.signum() <= 0) return null;
+            reduction = remaining.min(itemValue).setScale(2, RoundingMode.HALF_UP);
+        }
+        if (reduction.signum() <= 0) return null;
+        OrderTotal total = new OrderTotal();
+        total.setOrderTotalCode(Constants.OT_DISCOUNT_TITLE);
+        total.setOrderTotalType(OrderTotalType.SUBTOTAL);
+        total.setTitle(Constants.OT_SUBTOTAL_MODULE_CODE);
+        total.setText(summary.getPromoCode());
+        total.setValue(reduction.setScale(2, RoundingMode.HALF_UP));
+        return total;
+    }
+    private boolean belowMinimum(Discount d, OrderSummary summary) {
+        if (d.getMinimumSubtotal() == null) return false;
+        BigDecimal subtotal = BigDecimal.ZERO;
+        for (ShoppingCartItem i : summary.getProducts()) subtotal = subtotal.add(i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity())));
+        return subtotal.compareTo(d.getMinimumSubtotal()) < 0;
+    }
+    private boolean eligible(Discount d, Product p) {
+        if (d.getCategoryCodes() == null || d.getCategoryCodes().isEmpty()) return true;
+        if (p.getCategories() == null) return false;
+        for (Category c : p.getCategories()) {
+            Set<Category> seen = new HashSet<>();
+            while (c != null && seen.add(c)) {
+                if (d.getCategoryCodes().contains(c.getCode())) return true;
+                c = c.getParent();
+            }
+        }
+        return false;
+    }
 }
