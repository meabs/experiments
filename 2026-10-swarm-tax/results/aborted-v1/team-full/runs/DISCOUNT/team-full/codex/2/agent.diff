+package com.salesmanager.core.business.services.discount;
+import java.math.*; import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.business.repositories.discount.DiscountRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl; import com.salesmanager.core.model.discount.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("discountService") public class DiscountServiceImpl extends SalesManagerEntityServiceImpl<Long,Discount> implements DiscountService {
+ private final DiscountRepository repo; @Inject public DiscountServiceImpl(DiscountRepository repo){super(repo);this.repo=repo;}
+ public List<Discount> listByStore(MerchantStore s){return repo.findByStore(s.getId());}
+ public Discount getByCode(String c,MerchantStore s){
+  if(c==null||s==null)return null;
+  for(Discount d:listByStore(s)) if(d.getCode()!=null&&d.getCode().equalsIgnoreCase(c)) return d;
+  return null;
+ }
+ public Discount saveOrUpdate(Discount d)throws ServiceException{return saveAndFlush(d);}
+ public BigDecimal calculate(Discount d,BigDecimal subtotal){if(d==null||subtotal==null)return BigDecimal.ZERO; BigDecimal x=d.getType()==DiscountType.PERCENT?subtotal.multiply(d.getValue()).divide(new BigDecimal("100"),2,RoundingMode.HALF_UP):d.getValue(); return x.min(subtotal).max(BigDecimal.ZERO);}
+}
