+import org.springframework.data.jpa.repository.Query;
+import com.salesmanager.core.model.discount.Discount;
+public interface DiscountRepository extends JpaRepository<Discount,Long> {
+ @Query("select d from Discount d where d.merchantStore.id=?1 order by d.id") List<Discount> findByStore(Integer storeId);
+ @Query("select d from Discount d where d.merchantStore.id=?1 and lower(d.code)=lower(?2)") Discount findByStoreAndCode(Integer storeId,String code);
