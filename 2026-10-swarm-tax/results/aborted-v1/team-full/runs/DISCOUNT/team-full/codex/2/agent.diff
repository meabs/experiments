+package com.salesmanager.shop.store.api.v1.discount;
+import java.math.BigDecimal; import java.text.*; import java.util.*; import javax.inject.Inject;
+import org.springframework.http.*; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.business.services.catalog.category.CategoryService; import com.salesmanager.core.business.services.discount.DiscountService;
+import com.salesmanager.core.model.catalog.category.Category; import com.salesmanager.core.model.discount.*; import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.discount.DiscountEntity; import com.salesmanager.shop.store.api.exception.*; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/discounts") public class DiscountApi {
+ private final DiscountService service; private final CategoryService categories; private final SimpleDateFormat dates=new SimpleDateFormat("yyyy-MM-dd");
+ @Inject public DiscountApi(DiscountService s,CategoryService c){service=s;categories=c;dates.setLenient(false);}
+ @GetMapping public List<DiscountEntity> list(@ApiIgnore MerchantStore s)throws ServiceException{List<DiscountEntity> o=new ArrayList<>();for(Discount d:service.listByStore(s))o.add(toDto(d));return o;}
+ @PostMapping public ResponseEntity<DiscountEntity> create(@RequestBody DiscountEntity x,@ApiIgnore MerchantStore s)throws ServiceException{return ResponseEntity.status(HttpStatus.CREATED).body(toDto(service.saveOrUpdate(from(x,s,null))));}
+ @PutMapping("/{id}") public DiscountEntity update(@PathVariable Long id,@RequestBody DiscountEntity x,@ApiIgnore MerchantStore s)throws ServiceException{Discount d=service.getById(id);if(d==null||d.getMerchantStore()==null||!s.getId().equals(d.getMerchantStore().getId()))throw new ResourceNotFoundException("Discount id ["+id+"] not found");return toDto(service.saveOrUpdate(from(x,s,id)));}
+ @DeleteMapping("/{id}") @ResponseStatus(HttpStatus.NO_CONTENT) public void delete(@PathVariable Long id,@ApiIgnore MerchantStore s)throws ServiceException{Discount d=service.getById(id);if(d==null||d.getMerchantStore()==null||!s.getId().equals(d.getMerchantStore().getId()))throw new ResourceNotFoundException("Discount id ["+id+"] not found");service.delete(d);}
+ private Discount from(DiscountEntity x,MerchantStore s,Long id)throws ServiceException{if(x==null||blank(x.getCode())||x.getValue()==null||blank(x.getType()))throw new RestApiException("400","code, value and type are required");if(x.getMinimumSubtotal()!=null&&x.getMinimumSubtotal().signum()<0)throw new RestApiException("400","minimumSubtotal must be nonnegative");DiscountType t;try{t=DiscountType.valueOf(x.getType().toUpperCase(Locale.ROOT));}catch(Exception e){throw new RestApiException("400","type must be PERCENT or AMOUNT");}if(t==DiscountType.PERCENT&&(x.getValue().signum()<=0||x.getValue().compareTo(new BigDecimal("100"))>0)||t==DiscountType.AMOUNT&&x.getValue().signum()<=0)throw new RestApiException("400","invalid discount value");Discount clash=service.getByCode(x.getCode(),s);if(clash!=null&&!clash.getId().equals(id))throw new ConflictException("Discount code already exists");Discount d=id==null?new Discount():service.getById(id);d.setId(id);d.setMerchantStore(s);d.setCode(x.getCode().trim());d.setValue(x.getValue());d.setMinimumSubtotal(x.getMinimumSubtotal());d.setType(t);d.setActive(x.getActive()==null||x.getActive());try{d.setStartDate(blank(x.getStartDate())?dates.parse(dates.format(new Date())):dates.parse(x.getStartDate()));d.setEndDate(blank(x.getEndDate())?null:dates.parse(x.getEndDate()));}catch(ParseException e){throw new RestApiException("400","dates must use yyyy-MM-dd");}if(d.getEndDate()!=null&&d.getEndDate().before(d.getStartDate()))throw new RestApiException("400","endDate must not precede startDate");if(x.getCategoryId()!=null){Category c=categories.getById(s,x.getCategoryId());if(c==null)throw new ResourceNotFoundException("Category not found");d.setCategory(c);}else d.setCategory(null);return d;}
