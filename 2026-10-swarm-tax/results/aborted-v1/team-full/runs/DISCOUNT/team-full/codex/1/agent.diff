+package com.salesmanager.shop.store.facade.discount;
+import java.math.BigDecimal; import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.services.discount.DiscountService; import com.salesmanager.core.model.discount.Discount; import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.discount.*; import com.salesmanager.shop.store.api.exception.OperationNotAllowedException; import com.salesmanager.shop.store.api.exception.ResourceNotFoundException; import com.salesmanager.shop.store.api.exception.DiscountConflictException; import com.salesmanager.shop.store.controller.discount.facade.DiscountFacade;
+@Service("discountFacade") public class DiscountFacadeImpl implements DiscountFacade {
+ @Inject private DiscountService service;
+ private ReadableDiscount out(Discount d){ if(d==null)return null; ReadableDiscount r=new ReadableDiscount(); r.setId(d.getId());r.setCode(d.getCode());r.setType(d.getType());r.setValue(d.getValue());r.setStartDate(d.getStartDate());r.setEndDate(d.getEndDate());r.setMinimumSubtotal(d.getMinimumSubtotal());r.setCategories(d.getCategories());r.setActive(d.getActive()); if(d.getMerchantStore()!=null)r.setStore(d.getMerchantStore().getCode()); return r; }
+ private void validate(PersistableDiscount p){ if(p.getCode()==null||p.getCode().trim().isEmpty()||p.getType()==null||p.getValue()==null||p.getValue().compareTo(BigDecimal.ZERO)<=0) throw new OperationNotAllowedException("Invalid discount code, type or value"); if(p.getType()==com.salesmanager.core.model.discount.DiscountType.PERCENT&&p.getValue().compareTo(new BigDecimal("100"))>0) throw new OperationNotAllowedException("Percent value must be <= 100"); if(p.getEndDate()!=null&&p.getStartDate()!=null&&p.getEndDate().before(p.getStartDate())) throw new OperationNotAllowedException("Invalid discount dates"); if(p.getCategories()!=null&&p.getCategories().stream().anyMatch(x->x==null||x.trim().isEmpty())) throw new OperationNotAllowedException("Invalid category"); }
+ private Discount in(MerchantStore s,PersistableDiscount p){ validate(p); Discount d=new Discount(); d.setId(p.getId());d.setCode(p.getCode().trim());d.setType(p.getType());d.setValue(p.getValue());d.setStartDate(p.getStartDate()==null?new Date():p.getStartDate());d.setEndDate(p.getEndDate());d.setMinimumSubtotal(p.getMinimumSubtotal());d.setCategories(p.getCategories());d.setActive(p.getActive()==null?true:p.getActive()); return d; }
+ public ReadableDiscount save(MerchantStore s,PersistableDiscount p){ if(p.getId()!=null&&service.get(s,p.getId())==null) throw new ResourceNotFoundException("Discount not found"); Discount existing=service.findByCode(s,p.getCode()); if(existing!=null&&(p.getId()==null||!existing.getId().equals(p.getId()))) throw new DiscountConflictException("Discount code already exists"); Discount d=in(s,p); return out(service.save(s,d)); }
+ public List<ReadableDiscount> list(MerchantStore s){List<ReadableDiscount> r=new ArrayList<>();for(Discount d:service.list(s))r.add(out(d));return r;}
+ public ReadableDiscount get(MerchantStore s,Long id){ReadableDiscount r=out(service.get(s,id));if(r==null)throw new ResourceNotFoundException("Discount not found");return r;}
+ public void delete(MerchantStore s,Long id){if(service.get(s,id)==null)throw new ResourceNotFoundException("Discount not found");service.delete(s,id);}
+}
