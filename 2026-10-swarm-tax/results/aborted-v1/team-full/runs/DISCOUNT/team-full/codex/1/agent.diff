+
+	private boolean sameItem(ShoppingCartItem a, ShoppingCartItem b) {
+		if (a == b) return true;
+		return a != null && b != null && a.getSku() != null && a.getSku().equals(b.getSku());
+	}
+
+	private boolean eligibleProduct(Product p, List<String> categories) {
+		if (categories == null || categories.isEmpty()) return true;
+		if (p.getCategories() == null) return false;
+		for (com.salesmanager.core.model.catalog.category.Category c : p.getCategories()) {
+			for (com.salesmanager.core.model.catalog.category.Category current = c; current != null; current = current.getParent()) {
+				for (String category : categories) if (category.equalsIgnoreCase(current.getCode())) return true;
+			}
+		}
+		return false;
+	}
