+				boolean match = false;
+				if (item.getProduct().getCategories() != null) for (com.salesmanager.core.model.catalog.category.Category c : item.getProduct().getCategories())
+					for (com.salesmanager.core.model.catalog.category.Category p = c; p != null; p = p.getParent())
+						for (String code : discount.getCategories()) if (code.equalsIgnoreCase(p.getCode())) match = true;
+				if (!match) continue;
+			}
+			// Use the same current catalog price as the order-total processor; persisted
+			// cart prices may be stale after an admin price change.
+			BigDecimal currentPrice = pricingService.calculateProductPrice(item.getProduct()).getFinalPrice();
