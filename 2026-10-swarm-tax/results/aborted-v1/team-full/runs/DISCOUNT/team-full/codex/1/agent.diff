+package com.salesmanager.core.model.discount;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.List;
+import javax.persistence.*;
+import com.salesmanager.core.model.generic.SalesManagerEntity;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Entity
+@Table(name="DISCOUNT", uniqueConstraints=@UniqueConstraint(columnNames={"MERCHANT_ID","CODE"}))
+public class Discount extends SalesManagerEntity<Long, Discount> {
+  @Id @GeneratedValue(strategy=GenerationType.TABLE, generator="TABLE_GEN")
+  @TableGenerator(name="TABLE_GEN", table="SM_SEQUENCER", pkColumnName="SEQ_NAME", valueColumnName="SEQ_COUNT", pkColumnValue="DISCOUNT_SEQ_NEXT_VAL")
+  @Column(name="DISCOUNT_ID") private Long id;
+  @ManyToOne(fetch=FetchType.LAZY, optional=false) @JoinColumn(name="MERCHANT_ID", nullable=false) private MerchantStore merchantStore;
+  @Column(name="CODE", nullable=false, length=100) private String code;
+  @Enumerated(EnumType.STRING) @Column(name="TYPE", nullable=false, length=10) private DiscountType type;
+  @Column(name="VALUE", nullable=false, precision=19, scale=4) private BigDecimal value;
+  @Temporal(TemporalType.DATE) @Column(name="START_DATE", nullable=false) private Date startDate;
+  @Temporal(TemporalType.DATE) @Column(name="END_DATE") private Date endDate;
+  @Column(name="MINIMUM_SUBTOTAL", precision=19, scale=4) private BigDecimal minimumSubtotal;
+  @ElementCollection @CollectionTable(name="DISCOUNT_CATEGORY", joinColumns=@JoinColumn(name="DISCOUNT_ID")) @Column(name="CATEGORY") private List<String> categories = new ArrayList<String>();
+  @Column(name="ACTIVE", nullable=false) private Boolean active = true;
+  public Long getId(){return id;} public void setId(Long v){id=v;}
+  public MerchantStore getMerchantStore(){return merchantStore;} public void setMerchantStore(MerchantStore v){merchantStore=v;}
+  public String getCode(){return code;} public void setCode(String v){code=v;}
+  public DiscountType getType(){return type;} public void setType(DiscountType v){type=v;}
+  public BigDecimal getValue(){return value;} public void setValue(BigDecimal v){value=v;}
+  public Date getStartDate(){return startDate;} public void setStartDate(Date v){startDate=v;}
+  public Date getEndDate(){return endDate;} public void setEndDate(Date v){endDate=v;}
+  public BigDecimal getMinimumSubtotal(){return minimumSubtotal;} public void setMinimumSubtotal(BigDecimal v){minimumSubtotal=v;}
+  public List<String> getCategories(){return categories;} public void setCategories(List<String> v){categories=v == null ? new ArrayList<String>() : v;}
+  public Boolean getActive(){return active;} public void setActive(Boolean v){active=v;}
+}
