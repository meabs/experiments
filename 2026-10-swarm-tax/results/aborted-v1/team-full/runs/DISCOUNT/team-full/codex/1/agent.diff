+package com.salesmanager.core.business.services.discount;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.discount.DiscountRepository;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("discountService")
+public class DiscountServiceImpl implements DiscountService {
+ @Inject private DiscountRepository repository;
+ public Discount save(MerchantStore store, Discount d){ d.setMerchantStore(store); return repository.save(d); }
+ public List<Discount> list(MerchantStore store){ return repository.findByMerchantStoreIdOrderByIdAsc(store.getId()); }
+ public Discount get(MerchantStore store, Long id){ return repository.findByIdAndMerchantStoreId(id,store.getId()); }
+ public void delete(MerchantStore store, Long id){ Discount d=get(store,id); if(d!=null) repository.delete(d); }
+ public Discount findByCode(MerchantStore store,String code){ return repository.findByMerchantStoreIdAndCodeIgnoreCase(store.getId(),code); }
+}
