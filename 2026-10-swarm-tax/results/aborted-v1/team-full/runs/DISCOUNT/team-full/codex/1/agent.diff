+ @PutMapping("/{id}") public ReadableDiscount update(@PathVariable Long id,@Valid @RequestBody PersistableDiscount d,@ApiIgnore MerchantStore s){auth();d.setId(id);return facade.save(s,d);}
+ @DeleteMapping("/{id}") @ResponseStatus(HttpStatus.NO_CONTENT) public void delete(@PathVariable Long id,@ApiIgnore MerchantStore s){auth();facade.delete(s,id);}
+}
