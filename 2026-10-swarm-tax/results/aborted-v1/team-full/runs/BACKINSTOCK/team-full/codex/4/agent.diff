+package com.salesmanager.core.business.services.catalog.product.inventory;
+import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional; import com.salesmanager.core.business.repositories.catalog.product.inventory.*; import com.salesmanager.core.model.catalog.product.inventory.*;
+@Service public class StockAlertServiceImpl implements StockAlertService {
+ private final StockAlertRepository alerts; private final StockAlertOutboxRepository outbox;
+ @Inject public StockAlertServiceImpl(StockAlertRepository a,com.salesmanager.core.business.repositories.catalog.product.inventory.StockAlertOutboxRepository o){alerts=a;outbox=o;}
+ @Transactional public StockAlert subscribe(Integer store,String sku,String email){ if(store==null||sku==null||sku.trim().isEmpty()||email==null||email.trim().isEmpty()) throw new IllegalArgumentException("store, sku and email are required"); StockAlert old=alerts.findDuplicate(store,sku.trim(),email.trim()); if(old!=null)return old; StockAlert a=new StockAlert();a.setStoreId(store);a.setSku(sku.trim());a.setEmail(email.trim());return alerts.save(a); }
+ @Transactional public boolean cancel(Integer store,String sku,String email){if(store==null||sku==null||sku.trim().isEmpty()||email==null||email.trim().isEmpty()) throw new IllegalArgumentException("store, sku and email are required"); StockAlert a=alerts.findDuplicate(store,sku.trim(),email.trim());if(a==null)return false;alerts.delete(a);return true;}
+ public List<StockAlert> alerts(Integer store,String sku){return sku==null||sku.trim().isEmpty()?alerts.findForStore(store):alerts.findForProduct(store,sku.trim());}
+ public List<StockAlertOutbox> outbox(Integer store,String status){return status==null?outbox.findForStore(store):outbox.findByStatus(store,status);}
+ @Transactional public void restock(Integer store,String sku,String productName){for(StockAlert a:alerts.findForProduct(store,sku)){StockAlertOutbox o=new StockAlertOutbox();o.setStoreId(store);o.setSku(a.getSku());o.setEmail(a.getEmail());o.setProductName(productName);o.setStatus("PENDING");outbox.save(o);alerts.delete(a);}}
+ @Transactional public void removeForProduct(Integer store,String sku){if(store!=null&&sku!=null&&!sku.trim().isEmpty()) alerts.deleteAll(alerts.findForProduct(store,sku.trim()));}
+}
