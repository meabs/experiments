+package com.salesmanager.shop.store.api.v1.inventory;
+import java.util.*; import javax.inject.Inject; import javax.validation.Valid; import springfox.documentation.annotations.ApiIgnore; import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.business.services.catalog.product.inventory.StockAlertService; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.model.catalog.product.inventory.*; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.store.model.inventory.*;
+@RestController @RequestMapping("/api/v1") public class StockAlertApi {
+ private final StockAlertService service; private final ProductService products; @Inject public StockAlertApi(StockAlertService s,ProductService p){service=s;products=p;}
+ @PostMapping("/products/{sku}/alerts") public ResponseEntity<StockAlertResponse> subscribe(@PathVariable String sku,@Valid @RequestBody StockAlertRequest req,@ApiIgnore MerchantStore store){
+  if(store==null||sku==null||sku.trim().isEmpty()||req==null||req.getEmail()==null||req.getEmail().trim().isEmpty()||!req.getEmail().trim().matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$")) return ResponseEntity.badRequest().build();
+  final Product p; try { p=products.getBySku(sku.trim(),store); } catch(Exception e) { return ResponseEntity.notFound().build(); }
+  if(p==null)return ResponseEntity.notFound().build();
+  try { StockAlert a=service.subscribe(store.getId(),sku,req.getEmail()); return ResponseEntity.status(HttpStatus.CREATED).body(new StockAlertResponse(a.getId(),a.getSku(),a.getEmail(),null,null,a.getCreatedAt())); } catch(IllegalArgumentException e) { return ResponseEntity.badRequest().build(); }
+ }
+ @DeleteMapping("/products/{sku}/alerts") public ResponseEntity<Void> cancel(@PathVariable String sku,@RequestParam(required=false) String email,@ApiIgnore MerchantStore store){ if(store==null||sku==null||sku.trim().isEmpty()||email==null||email.trim().isEmpty())return ResponseEntity.badRequest().build(); return service.cancel(store.getId(),sku.trim(),email.trim())?ResponseEntity.noContent().build():ResponseEntity.notFound().build(); }
+ @GetMapping("/private/stock-alerts") public ResponseEntity<List<StockAlertResponse>> alerts(@ApiIgnore MerchantStore store,@RequestParam(required=false) String sku){if(store==null)return ResponseEntity.badRequest().build(); if(sku!=null&&sku.trim().isEmpty())return ResponseEntity.badRequest().build(); List<StockAlert> a=service.alerts(store.getId(),sku); List<StockAlertResponse> r=new ArrayList<>();for(StockAlert x:a)r.add(new StockAlertResponse(x.getId(),x.getSku(),x.getEmail(),null,null,x.getCreatedAt()));return ResponseEntity.ok(r);}
+ @GetMapping("/private/stock-alerts/outbox") public ResponseEntity<List<StockAlertResponse>> outbox(@ApiIgnore MerchantStore store,@RequestParam(required=false) String status){if(store==null)return ResponseEntity.badRequest().build();if(status!=null&&status.trim().isEmpty())return ResponseEntity.badRequest().build();List<StockAlertResponse> r=new ArrayList<>();for(StockAlertOutbox x:service.outbox(store.getId(),status))r.add(new StockAlertResponse(x.getId(),x.getSku(),x.getEmail(),x.getStatus(),x.getProductName(),x.getCreatedAt()));return ResponseEntity.ok(r);}
+}
