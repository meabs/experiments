+@RestController @RequestMapping("/api/v1")
+public class StockAlertApi {
+ @Autowired private StockAlertService service;
+ @PostMapping("/products/{sku}/alerts") @ResponseStatus(HttpStatus.CREATED) public StockAlert subscribe(@PathVariable String sku,@Valid @RequestBody StockAlertRequest request,@ApiIgnore MerchantStore store){return service.subscribe(sku,request.getEmail(),store);}
+ @DeleteMapping("/products/{sku}/alerts") @ResponseStatus(HttpStatus.NO_CONTENT) public void unsubscribe(@PathVariable String sku,@RequestParam(value="email",required=false) String email,@Valid @RequestBody(required=false) StockAlertRequest request,@ApiIgnore MerchantStore store){ if(email==null && request!=null) email=request.getEmail(); service.unsubscribe(sku,email,store);}
+ @GetMapping("/private/stock-alerts") public List<StockAlert> alerts(@RequestParam(value="status",defaultValue="PENDING") String status,@ApiIgnore MerchantStore store){ final StockAlertStatus parsed; try { parsed=StockAlertStatus.valueOf(status.toUpperCase(Locale.ROOT)); } catch(Exception e){ throw new RestApiException("Invalid stock alert status: "+status); } if(parsed==StockAlertStatus.CANCELLED) throw new RestApiException("Invalid stock alert status: "+status); return service.alerts(store,parsed);}
+ @GetMapping("/private/stock-alerts/outbox") public List<StockAlertOutbox> outbox(@ApiIgnore MerchantStore store){return service.outbox(store);}
+}
