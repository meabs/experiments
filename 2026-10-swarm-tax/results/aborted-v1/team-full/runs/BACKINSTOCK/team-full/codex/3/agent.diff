+package com.salesmanager.core.business.services.catalog.product;
+
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import java.util.List;
+import com.salesmanager.core.model.catalog.product.*;
+
+/** Completes pending back-in-stock alerts for one store and SKU. */
+public interface StockAlertService {
+    void sendRestockAlerts(ProductAvailability availability, MerchantStore store);
+    StockAlert subscribe(String sku,String email,MerchantStore store);
+    boolean unsubscribe(String sku,String email,MerchantStore store);
+    List<StockAlert> pending(MerchantStore store);
+    List<StockAlert> alerts(MerchantStore store, StockAlertStatus status);
+    List<StockAlertOutbox> outbox(MerchantStore store);
+    List<StockAlertOutbox> notifyRestocked(String sku,MerchantStore store);
+    void deleteForSku(String sku,MerchantStore store);
+}
