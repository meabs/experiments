+package com.salesmanager.core.business.services.catalog.product;
+import java.util.*; import java.util.regex.Pattern; import javax.transaction.Transactional; import org.springframework.stereotype.Service; import org.springframework.beans.factory.annotation.Autowired;
+import com.salesmanager.core.business.repositories.catalog.product.*; import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.model.catalog.product.*; import com.salesmanager.core.model.catalog.product.description.ProductDescription; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+ private static final Pattern EMAIL=Pattern.compile("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$");
+ @Autowired private StockAlertRepository alerts; @Autowired private StockAlertOutboxRepository outbox; @Autowired private ProductService products;
+ @Override public void sendRestockAlerts(com.salesmanager.core.model.catalog.product.availability.ProductAvailability availability,MerchantStore store){
+  if(availability==null || availability.getProductQuantity() <= 0) return; String sku=availability.getSku(); if((sku==null||sku.isEmpty())&&availability.getProduct()!=null) sku=availability.getProduct().getSku(); if(sku!=null) notifyRestocked(sku,store);
+ }
+ @Override @Transactional public StockAlert subscribe(String sku,String email,MerchantStore store){
+  if(store==null||sku==null||sku.trim().isEmpty()||email==null||!EMAIL.matcher(email.trim()).matches()) throw new IllegalArgumentException("A valid sku and email are required");
+  if(!products.exists(sku,store)) throw new IllegalArgumentException("Product not found");
+  Optional<StockAlert> existing=alerts.findFirstByMerchantStoreIdAndSkuIgnoreCaseAndEmailIgnoreCaseAndStatus(store.getId(),sku.trim(),email.trim(),StockAlertStatus.PENDING); if(existing.isPresent()) return existing.get();
+  StockAlert a=new StockAlert(); a.setSku(sku.trim()); a.setEmail(email.trim().toLowerCase(Locale.ROOT)); a.setMerchantStore(store); return alerts.save(a);
+ }
+ @Override @Transactional public boolean unsubscribe(String sku,String email,MerchantStore store){ if(store==null||sku==null||sku.trim().isEmpty()||email==null||!EMAIL.matcher(email.trim()).matches()) return false; Optional<StockAlert> a=alerts.findFirstByMerchantStoreIdAndSkuIgnoreCaseAndEmailIgnoreCaseAndStatus(store.getId(),sku.trim(),email.trim(),StockAlertStatus.PENDING); if(!a.isPresent()) return false; a.get().setStatus(StockAlertStatus.CANCELLED); alerts.save(a.get()); return true; }
+ public List<StockAlert> pending(MerchantStore s){return alerts.findByMerchantStoreIdAndStatus(s.getId(),StockAlertStatus.PENDING);}
+ public List<StockAlert> alerts(MerchantStore s,StockAlertStatus status){return alerts.findByMerchantStoreIdAndStatus(s.getId(),status);}
+ public List<StockAlertOutbox> outbox(MerchantStore s){return outbox.findByMerchantStoreIdOrderByCreatedAtAsc(s.getId());}
+ @Override @Transactional public List<StockAlertOutbox> notifyRestocked(String sku,MerchantStore store){ List<StockAlertOutbox> result=new ArrayList<>(); for(StockAlert a:alerts.findByMerchantStoreIdAndStatus(store.getId(),StockAlertStatus.PENDING)){if(!a.getSku().equalsIgnoreCase(sku)) continue; StockAlertOutbox o=new StockAlertOutbox(); o.setSku(a.getSku()); o.setEmail(a.getEmail()); o.setMerchantStore(store); o.setSubject("Back in stock: "+a.getSku()); result.add(outbox.save(o)); a.setStatus(StockAlertStatus.SENT); a.setSentAt(new Date()); alerts.save(a);} return result; }
+ @Override @Transactional public void deleteForSku(String sku,MerchantStore store){alerts.deleteByMerchantStoreIdAndSkuIgnoreCase(store.getId(),sku);}
+}
