+package com.salesmanager.core.business.services.catalog.product;
+import java.util.*; import org.springframework.beans.factory.annotation.Autowired; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional; import com.salesmanager.core.business.repositories.catalog.product.*; import com.salesmanager.core.model.catalog.product.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("stockAlertService") @Transactional
+public class StockAlertServiceImpl implements StockAlertService {
+ @Autowired private StockAlertRepository alerts; @Autowired private StockAlertOutboxRepository outbox;
+ private Integer id(MerchantStore s){return s.getId().intValue();}
+ public StockAlert subscribe(String sku,String email,MerchantStore store){String e=email.trim().toLowerCase(Locale.ENGLISH); Optional<StockAlert> old=alerts.findByMerchantStoreIdAndSkuAndEmailIgnoreCase(id(store),sku,e); if(old.isPresent()){StockAlert a=old.get(); a.setStatus("PENDING"); return alerts.save(a);} StockAlert a=new StockAlert();a.setMerchantStore(store);a.setSku(sku);a.setEmail(e);return alerts.save(a);}
+ public boolean unsubscribe(String sku,String email,MerchantStore store){Optional<StockAlert> a=alerts.findByMerchantStoreIdAndSkuAndEmailIgnoreCase(id(store),sku,email.trim().toLowerCase(Locale.ENGLISH)); if(!a.isPresent()) return false; alerts.delete(a.get()); return true;}
+ public void stockBecameAvailable(String sku,MerchantStore store){for(StockAlert a:alerts.findByMerchantStoreIdAndSkuAndStatus(id(store),sku,"PENDING")){StockAlertOutbox o=new StockAlertOutbox();o.setMerchantStore(store);o.setSku(sku);o.setEmail(a.getEmail());o.setSubject("Product back in stock: "+sku);outbox.save(o);a.setStatus("SENT");a.setNotifiedAt(new Date());alerts.save(a);}}
+ public List<StockAlert> alerts(MerchantStore s,String status){return status==null?alerts.findByMerchantStoreIdOrderByCreatedAtAsc(id(s)):alerts.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(id(s),status);}
+ public List<StockAlertOutbox> outbox(MerchantStore s,String status){return status==null?outbox.findByMerchantStoreIdOrderByCreatedAtAsc(id(s)):outbox.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(id(s),status);}
+}
