+package com.salesmanager.core.business.services.catalog.product;
+import java.util.*; import com.salesmanager.core.model.catalog.product.*; import com.salesmanager.core.model.merchant.MerchantStore;
+ public interface StockAlertService { StockAlert subscribe(String sku,String email,MerchantStore store); boolean unsubscribe(String sku,String email,MerchantStore store); void stockBecameAvailable(String sku,MerchantStore store); default void dispatchForRestock(String sku,MerchantStore store){stockBecameAvailable(sku,store);} List<StockAlert> alerts(MerchantStore store,String status); List<StockAlertOutbox> outbox(MerchantStore store,String status); }
