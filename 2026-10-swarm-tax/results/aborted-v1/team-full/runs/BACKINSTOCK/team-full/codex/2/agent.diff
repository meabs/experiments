+package com.salesmanager.shop.store.api.v1.product;
+import java.util.*; import javax.validation.Valid; import javax.validation.constraints.Email; import javax.validation.constraints.NotBlank;
+import org.springframework.beans.factory.annotation.Autowired; import org.springframework.http.HttpStatus; import org.springframework.web.bind.annotation.*; import org.springframework.web.server.ResponseStatusException; import springfox.documentation.annotations.ApiIgnore;
+import com.salesmanager.core.business.services.catalog.product.*; import com.salesmanager.core.model.catalog.product.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+@RestController @RequestMapping("/api/v1")
+public class StockAlertApi {
+ @Autowired private StockAlertService service; @Autowired private ProductService products;
+ private void validateStatus(String s){if(s!=null && !(s.equals("PENDING")||s.equals("SENT")||s.equals("FAILED"))) throw new ResponseStatusException(HttpStatus.BAD_REQUEST,"Unknown status");}
+ public static class Request { @NotBlank @Email public String email; }
+ private Product exists(String sku,MerchantStore store){try {Product p=products.getBySku(sku,store); if(p==null) throw new ResourceNotFoundException("Product with sku ["+sku+"] not found"); return p;} catch(ResourceNotFoundException e){throw e;} catch(Exception e){throw new ResourceNotFoundException("Product with sku ["+sku+"] not found");}}
+ @PostMapping("/products/{sku}/alerts") @ResponseStatus(HttpStatus.CREATED)
+ public Map<String,Object> subscribe(@PathVariable String sku,@Valid @RequestBody Request request,@ApiIgnore MerchantStore store){if(store==null) throw new ResourceNotFoundException("Store not found"); Product p=exists(sku,store); if(p.getAvailabilities()!=null && p.getAvailabilities().stream().anyMatch(a->a.getProductQuantity()!=null && a.getProductQuantity()>0)) throw new ResponseStatusException(HttpStatus.CONFLICT,"Product is in stock"); StockAlert a=service.subscribe(sku,request.email,store); Map<String,Object> r=new LinkedHashMap<>();r.put("id",a.getId());r.put("sku",a.getSku());r.put("email",a.getEmail());r.put("status",a.getStatus());return r;}
+ @DeleteMapping("/products/{sku}/alerts") @ResponseStatus(HttpStatus.NO_CONTENT)
+ public void unsubscribe(@PathVariable String sku,@RequestParam String email,@ApiIgnore MerchantStore store){if(!service.unsubscribe(sku,email,store)) throw new ResourceNotFoundException("Stock alert not found");}
+ @GetMapping("/private/stock-alerts") public List<Map<String,Object>> alerts(@RequestParam(required=false) String status,@ApiIgnore MerchantStore store){validateStatus(status);List<Map<String,Object>> r=new ArrayList<>();for(StockAlert a:service.alerts(store,status)){Map<String,Object> m=new LinkedHashMap<>();m.put("id",a.getId());m.put("sku",a.getSku());m.put("email",a.getEmail());m.put("status",a.getStatus());m.put("createdAt",a.getCreatedAt());m.put("notifiedAt",a.getNotifiedAt());r.add(m);}return r;}
+ @GetMapping("/private/stock-alerts/outbox") public List<Map<String,Object>> outbox(@RequestParam(required=false) String status,@ApiIgnore MerchantStore store){validateStatus(status);List<Map<String,Object>> r=new ArrayList<>();for(StockAlertOutbox a:service.outbox(store,status)){Map<String,Object> m=new LinkedHashMap<>();m.put("to",a.getEmail());m.put("email",a.getEmail());m.put("subject",a.getSubject());m.put("createdAt",a.getCreatedAt());m.put("status",a.getStatus());r.add(m);}return r;}
+}
