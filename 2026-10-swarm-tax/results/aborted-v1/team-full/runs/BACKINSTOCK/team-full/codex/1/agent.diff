+ @GetMapping("/private/stock-alerts/outbox") public List<ReadableStockAlertOutbox> outbox(@ApiIgnore MerchantStore store){List<ReadableStockAlertOutbox> r=new ArrayList<>();for(StockAlertOutbox a:service.outbox(store)){ReadableStockAlertOutbox x=new ReadableStockAlertOutbox();x.setTo(a.getTo());x.setSku(a.getSku());x.setSubject(a.getSubject());x.setCreatedAt(a.getCreatedAt());r.add(x);}return r;}
+ private ReadableStockAlert read(StockAlert a){ReadableStockAlert r=new ReadableStockAlert();r.setId(a.getId());r.setSku(a.getSku());r.setEmail(a.getEmail());r.setStatus(a.getStatus());r.setCreatedAt(a.getCreatedAt());r.setSentAt(a.getSentAt());return r;}
+}
