+package com.salesmanager.core.business.services.catalog.product.alert;
+import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service; import com.salesmanager.core.business.repositories.catalog.product.alert.*; import com.salesmanager.core.model.catalog.product.*; import com.salesmanager.core.model.catalog.product.alert.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("stockAlertService") public class StockAlertServiceImpl implements StockAlertService {
+ @Inject private StockAlertRepository alerts; @Inject private StockAlertOutboxRepository outbox;
+ public StockAlert subscribe(String sku,String email,MerchantStore store,Product product){ Optional<StockAlert> old=alerts.findDuplicate(store.getId().intValue(),sku,email,StockAlertStatus.PENDING); if(old.isPresent()) return old.get(); StockAlert a=new StockAlert(); a.setSku(sku);a.setEmail(email);a.setMerchantStore(store);a.setProduct(product); return alerts.save(a); }
+ public boolean duplicate(String sku,String email,MerchantStore store){return alerts.findDuplicate(store.getId().intValue(),sku,email,StockAlertStatus.PENDING).isPresent();}
+ public boolean inStock(String sku,Product product){if(product==null || sku==null)return false; return product.getAvailabilities()!=null && product.getAvailabilities().stream().anyMatch(a -> ((a.getSku()!=null && sku.equalsIgnoreCase(a.getSku())) || (a.getSku()==null && product.getSku()!=null && sku.equalsIgnoreCase(product.getSku()))) && a.getProductQuantity()!=null && a.getProductQuantity()>0);}
+ public boolean cancel(String sku,String email,MerchantStore store){ Optional<StockAlert> a=alerts.findDuplicate(store.getId().intValue(),sku,email,StockAlertStatus.PENDING); if(!a.isPresent()) return false; a.get().setStatus(StockAlertStatus.CANCELLED); alerts.save(a.get()); return true; }
+ public List<StockAlert> list(MerchantStore s,StockAlertStatus status){return status==null?alerts.findByMerchantStoreIdOrderByCreatedAtAsc(s.getId().intValue()):alerts.findByStoreAndStatus(s.getId().intValue(),status);} public List<StockAlertOutbox> outbox(MerchantStore s){return outbox.findByMerchantStoreIdOrderByCreatedAtAsc(s.getId().intValue());}
+ public void restocked(Product p,String sku,MerchantStore s){ if(p==null)return; for(StockAlert a:alerts.findByProductAndSku(p.getId(),sku,s.getId().intValue())) if(a.getStatus()==StockAlertStatus.PENDING){a.setStatus(StockAlertStatus.SENT);a.setSentAt(new Date());alerts.save(a);StockAlertOutbox o=new StockAlertOutbox();o.setMerchantStore(s);o.setTo(a.getEmail());o.setSku(a.getSku());String n=p.getProductDescription()==null?"Product":p.getProductDescription().getName();o.setSubject(n+" is back in stock");outbox.save(o);} }
+}
