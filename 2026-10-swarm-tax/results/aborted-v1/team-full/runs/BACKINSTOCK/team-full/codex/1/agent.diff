+ @Autowired private StockAlertService service; @Autowired private ProductService products;
+ @PostMapping("/products/{sku}/alerts") public ResponseEntity<ReadableStockAlert> subscribe(@PathVariable String sku,@Valid @RequestBody PersistableStockAlert req,@ApiIgnore MerchantStore store){ Product p; try {p=products.getBySku(sku,store);} catch(Exception e){return ResponseEntity.notFound().build();} if(p==null)return ResponseEntity.notFound().build(); String email=req.getEmail().trim(); if(service.inStock(sku,p))return ResponseEntity.status(HttpStatus.CONFLICT).build(); if(service.duplicate(sku,email,store))return ResponseEntity.ok(read(service.subscribe(sku,email,store,p))); return ResponseEntity.status(HttpStatus.CREATED).body(read(service.subscribe(sku,email,store,p))); }
