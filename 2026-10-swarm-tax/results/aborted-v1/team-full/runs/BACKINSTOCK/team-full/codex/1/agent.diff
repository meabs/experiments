+public interface StockAlertService { StockAlert subscribe(String sku,String email,MerchantStore store,Product product); boolean duplicate(String sku,String email,MerchantStore store); boolean inStock(String sku,Product product); boolean cancel(String sku,String email,MerchantStore store); List<StockAlert> list(MerchantStore store,StockAlertStatus status); List<StockAlertOutbox> outbox(MerchantStore store); void restocked(Product product,String sku, MerchantStore store); }
