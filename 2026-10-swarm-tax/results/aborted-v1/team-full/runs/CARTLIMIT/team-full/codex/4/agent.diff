+package com.salesmanager.shop.store.api.v1.product;
+
+import javax.validation.Valid;
+
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.limits.CartRules;
+import com.salesmanager.shop.model.catalog.product.limits.ProductLimits;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import io.swagger.annotations.Api;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Private administration endpoints for purchase limits and cart rules. */
+@RestController
+@RequestMapping("/api/v1/private")
+@Api(tags = { "Product purchase rules" })
+public class ProductPurchaseRulesApi {
+    @Autowired private ProductService productService;
+    @Autowired private MerchantStoreService merchantStoreService;
+
+    @GetMapping("/product/{productId}/limits")
+    @ResponseBody
+    public ProductLimits getLimits(@PathVariable Long productId, @ApiIgnore MerchantStore store) {
+        return toLimits(product(productId, store));
+    }
+
+    @PutMapping("/product/{productId}/limits")
+    @ResponseStatus(HttpStatus.OK)
+    public ProductLimits updateLimits(@PathVariable Long productId, @Valid @RequestBody ProductLimits request,
+                                      @ApiIgnore MerchantStore store) {
+        Product product = product(productId, store);
+        validateLimits(request);
+        product.setMinPerCart(request.getMinPerCart());
+        product.setMaxPerCart(request.getMaxPerCart());
+        product.setPackSize(request.getPackSize());
+        try { productService.saveProduct(product); }
+        catch (ServiceException e) { throw new RestApiException("Unable to save product limits", e); }
+        return toLimits(product);
+    }
+
+    @GetMapping("/cart-rules")
+    @ResponseBody
+    public CartRules getCartRules(@ApiIgnore MerchantStore store) {
+        return toRules(store);
+    }
+
+    @PutMapping("/cart-rules")
+    @ResponseStatus(HttpStatus.OK)
+    public CartRules updateCartRules(@Valid @RequestBody CartRules request,
+                                     @ApiIgnore MerchantStore store) {
+        validateRules(request);
+        store.setMaxLines(request.getMaxLines());
+        store.setMaxUnits(request.getMaxUnits());
+        try { merchantStoreService.saveOrUpdate(store); }
+        catch (ServiceException e) { throw new RestApiException("Unable to save cart rules", e); }
+        return toRules(store);
+    }
+
+    private Product product(Long id, MerchantStore store) {
+        Product product = productService.findOne(id, store);
+        if (product == null) throw new ResourceNotFoundException("Product not found");
+        return product;
+    }
+
+    private void validateLimits(ProductLimits value) {
+        if (value.getMinPerCart() != null && value.getMaxPerCart() != null && value.getMinPerCart() > value.getMaxPerCart())
+            throw new RestApiException("minPerCart must be less than or equal to maxPerCart");
+        if (value.getMaxPerCart() != null && value.getPackSize() != null && value.getMaxPerCart() < value.getPackSize())
+            throw new RestApiException("maxPerCart must be greater than or equal to packSize");
+    }
+    private void validateRules(CartRules value) { /* @Min handles positivity; null means unset. */ }
+    private ProductLimits toLimits(Product p) {
+        ProductLimits result = new ProductLimits(); result.setMinPerCart(p.getMinPerCart()); result.setMaxPerCart(p.getMaxPerCart()); result.setPackSize(p.getPackSize()); return result;
+    }
+    private CartRules toRules(MerchantStore s) {
+        CartRules result = new CartRules(); result.setMaxLines(s.getMaxLines()); result.setMaxUnits(s.getMaxUnits()); return result;
+    }
+}
