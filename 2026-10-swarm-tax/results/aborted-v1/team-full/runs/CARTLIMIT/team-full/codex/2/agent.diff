@@ -0,0 +1,70 @@
+package com.salesmanager.shop.store.api.v1.product;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseBody;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.PurchaseLimits;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Private administration endpoints for per-product purchase constraints. */
+@Controller
+@RequestMapping("/api/v1/private/product")
+public class ProductLimitsAdminApi {
+    @Inject private ProductService productService;
+
+    @GetMapping("/{id}/limits")
+    @ResponseBody
+    public PurchaseLimits get(@PathVariable Long id, @ApiIgnore MerchantStore merchantStore) {
+        Product product = find(id, merchantStore);
+        return limits(product);
+    }
+
+    @PutMapping("/{id}/limits")
+    public ResponseEntity<?> put(@PathVariable Long id, @RequestBody PurchaseLimits incoming,
+                                 @ApiIgnore MerchantStore merchantStore) {
+        if (merchantStore == null) return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+        Product product = productService.retrieveById(id, merchantStore).orElse(null);
+        if (product == null) return ResponseEntity.notFound().build();
+        if (!valid(incoming)) return ResponseEntity.badRequest().build();
+        product.setMinPerCart(incoming.getMinPerCart());
+        product.setMaxPerCart(incoming.getMaxPerCart());
+        product.setPackSize(incoming.getPackSize());
+        try {
+            productService.saveProduct(product);
+            return ResponseEntity.ok(limits(product));
+        } catch (Exception e) {
+            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).build();
+        }
+    }
+
+    private Product find(Long id, MerchantStore store) {
+        if (store == null) throw new ResourceNotFoundException("Store not found");
+        return productService.retrieveById(id, store)
+                .orElseThrow(() -> new ResourceNotFoundException("Product not found"));
+    }
+    private PurchaseLimits limits(Product product) {
+        PurchaseLimits result = new PurchaseLimits();
+        result.setMinPerCart(product.getMinPerCart()); result.setMaxPerCart(product.getMaxPerCart());
+        result.setPackSize(product.getPackSize());
+        return result;
+    }
+    private boolean valid(PurchaseLimits r) {
+        if (r == null || !positive(r.getMinPerCart()) || !positive(r.getMaxPerCart()) || !positive(r.getPackSize())) return false;
+        if (r.getMinPerCart() != null && r.getMaxPerCart() != null && r.getMinPerCart() > r.getMaxPerCart()) return false;
+        return r.getMaxPerCart() == null || r.getPackSize() == null || r.getMaxPerCart() >= r.getPackSize();
+    }
+    private boolean positive(Integer n) { return n == null || n.intValue() > 0; }
+}
