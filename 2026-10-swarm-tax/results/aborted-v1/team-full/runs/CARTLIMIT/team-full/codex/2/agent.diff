+package com.salesmanager.shop.store.api.v1.cart;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseBody;
+
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.cart.CartRules;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Private administration endpoints for cart-wide purchase rules. */
+@Controller
+@RequestMapping("/api/v1/private/cart-rules")
+public class CartRulesAdminApi {
+    @Inject private MerchantStoreService merchantStoreService;
+
+    @GetMapping
+    @ResponseBody
+    public CartRules get(@ApiIgnore MerchantStore merchantStore) {
+        if (merchantStore == null) throw new ResourceNotFoundException("Store not found");
+        return rules(merchantStore);
+    }
+
+    @PutMapping
+    public ResponseEntity<?> put(@RequestBody CartRules incoming, @ApiIgnore MerchantStore merchantStore) {
+        if (merchantStore == null) return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+        if (!valid(incoming)) return ResponseEntity.badRequest().build();
+        merchantStore.setMaxLines(incoming.getMaxLines());
+        merchantStore.setMaxUnits(incoming.getMaxUnits());
+        try {
+            merchantStoreService.saveOrUpdate(merchantStore);
+            return ResponseEntity.ok(rules(merchantStore));
+        } catch (Exception e) {
+            return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).build();
+        }
+    }
+
+    private CartRules rules(MerchantStore store) {
+        CartRules result = new CartRules();
+        result.setMaxLines(store.getMaxLines()); result.setMaxUnits(store.getMaxUnits());
+        return result;
+    }
+    private boolean valid(CartRules r) {
+        return r != null && positive(r.getMaxLines()) && positive(r.getMaxUnits());
+    }
+    private boolean positive(Integer n) { return n == null || n.intValue() > 0; }
+}
