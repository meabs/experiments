+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.Optional;
+
+import javax.inject.Inject;
+
+import org.springframework.http.MediaType;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductLimits;
+import com.salesmanager.shop.model.store.CartRules;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Administration endpoints for cart quantity limits. */
+@RestController
+@RequestMapping(value = "/api/v1", produces = MediaType.APPLICATION_JSON_VALUE)
+public class ProductLimitsApi {
+
+    @Inject private ProductService productService;
+    @Inject private MerchantStoreService merchantStoreService;
+
+    @GetMapping("/private/product/{id}/limits")
+    public ProductLimits getProductLimits(@PathVariable Long id, @ApiIgnore MerchantStore merchantStore) {
+        Product product = product(id, merchantStore);
+        return limits(product);
+    }
+
+    @PutMapping("/private/product/{id}/limits")
+    public ProductLimits putProductLimits(@PathVariable Long id, @RequestBody ProductLimits request,
+            @ApiIgnore MerchantStore merchantStore) {
+        Product product = product(id, merchantStore);
+        validate(request.getMinPerCart(), request.getMaxPerCart(), request.getPackSize());
+        product.setMinPerCart(request.getMinPerCart());
+        product.setMaxPerCart(request.getMaxPerCart());
+        product.setPackSize(request.getPackSize());
+        try {
+            productService.saveProduct(product);
+        } catch (ServiceException e) {
+            throw new RestApiException("Unable to save product limits", e);
+        }
+        return limits(product);
+    }
+
+    @GetMapping("/private/cart-rules")
+    public CartRules getCartRules(@ApiIgnore MerchantStore merchantStore) {
+        return rules(store(merchantStore));
+    }
+
+    @PutMapping("/private/cart-rules")
+    public CartRules putCartRules(@RequestBody CartRules request, @ApiIgnore MerchantStore merchantStore) {
+        MerchantStore store = store(merchantStore);
+        validate(request.getMaxLines(), request.getMaxUnits());
+        store.setMaxLines(request.getMaxLines());
+        store.setMaxUnits(request.getMaxUnits());
+        try {
+            merchantStoreService.saveOrUpdate(store);
+        } catch (ServiceException e) {
+            throw new RestApiException("Unable to save cart rules", e);
+        }
+        return rules(store);
+    }
+
+    private Product product(Long id, MerchantStore store) {
+        store(store);
+        Optional<Product> found = productService.retrieveById(id, store);
+        if (!found.isPresent()) throw new ResourceNotFoundException("Product not found");
+        return found.get();
+    }
+
+    private MerchantStore store(MerchantStore store) {
+        if (store == null || store.getId() == null) throw new ResourceNotFoundException("Store not found");
+        return store;
+    }
+
+    private ProductLimits limits(Product p) {
+        ProductLimits result = new ProductLimits();
+        result.setMinPerCart(p.getMinPerCart()); result.setMaxPerCart(p.getMaxPerCart()); result.setPackSize(p.getPackSize());
+        return result;
+    }
+    private CartRules rules(MerchantStore s) {
+        CartRules result = new CartRules();
+        result.setMaxLines(s.getMaxLines()); result.setMaxUnits(s.getMaxUnits());
+        return result;
+    }
+    private void validate(Integer... values) {
+        for (Integer value : values) if (value != null && value < 1) throw new RestApiException("Cart limits must be whole numbers >= 1");
+        if (values.length == 3 && values[0] != null && values[1] != null && values[0] > values[1])
+            throw new RestApiException("minPerCart must be less than or equal to maxPerCart");
+    }
+}
