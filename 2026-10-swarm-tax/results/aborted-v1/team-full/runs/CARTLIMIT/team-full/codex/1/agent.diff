+	/* Limits are deliberately checked before any cart item is changed or deleted.  The
+	 * reflective access keeps this facade binary compatible with stores/products created
+	 * by older installations (where the optional limit properties do not exist). */
+	private static Number limit(Object target, String name) {
+		if (target == null) return null;
+		try {
+			Method m = target.getClass().getMethod("get" + Character.toUpperCase(name.charAt(0)) + name.substring(1));
+			Object value = m.invoke(target);
+			return value instanceof Number ? (Number)value : null;
+		} catch (Exception ignored) { return null; }
+	}
+
+	private static Number productLimit(Product product, String name) {
+		Number n = limit(product, name);
+		if (n != null) return n;
+		try {
+			Method m = product.getClass().getMethod("getProductLimits");
+			return limit(m.invoke(product), name);
+		} catch (Exception ignored) { return null; }
+	}
+
+	private void reject(String code, String sku, String rule) {
+		throw new CartLimitException(code, "Cart limit " + rule + " exceeded" + (sku == null ? "" : " for " + sku));
+	}
+
+	private void validateCartChange(ShoppingCart cart, com.salesmanager.core.model.shoppingcart.ShoppingCartItem proposed,
