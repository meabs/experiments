+		List<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> values = new ArrayList<com.salesmanager.core.model.shoppingcart.ShoppingCartItem>();
+		if (cart.getLineItems() != null) values.addAll(cart.getLineItems());
+		String sku = proposed.getSku();
+		com.salesmanager.core.model.shoppingcart.ShoppingCartItem existing = values.stream().filter(i -> sku.equals(i.getSku())).findFirst().orElse(null);
+		int oldUnits = values.stream().mapToInt(i -> i.getQuantity() == null ? 0 : i.getQuantity()).sum();
+		int oldLines = values.size();
+		int oldQuantity = existing == null || existing.getQuantity() == null ? 0 : existing.getQuantity();
+		int resultingQuantity = adding ? oldQuantity + quantity : quantity;
+		validatePerItem(proposed, resultingQuantity);
+		int delta = resultingQuantity - oldQuantity;
+		checkGlobal(store, oldLines, oldUnits, existing == null && resultingQuantity > 0, delta > 0, delta);
+	}
+
+	private void validatePerItem(com.salesmanager.core.model.shoppingcart.ShoppingCartItem item, int quantity) {
+		if (quantity < 0) reject("INVALID_QUANTITY", item.getSku(), "INVALID_QUANTITY");
+		if (quantity == 0) return; // zero is the documented removal operation
