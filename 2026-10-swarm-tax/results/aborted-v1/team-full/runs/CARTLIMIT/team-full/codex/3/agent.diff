+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.Optional;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.product.ProductLimits;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/product/{id}/limits")
+public class ProductLimitsApi {
+    @Inject private ProductService productService;
+
+    @GetMapping
+    public ProductLimits get(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        return toDto(product(id, store));
+    }
+
+    @PutMapping
+    @ResponseStatus(HttpStatus.OK)
+    public ProductLimits update(@PathVariable Long id, @RequestBody ProductLimits limits,
+                                @ApiIgnore MerchantStore store) {
+        validate(limits);
+        Product product = product(id, store);
+        product.setMinPerCart(limits.getMinPerCart());
+        product.setMaxPerCart(limits.getMaxPerCart());
+        product.setPackSize(limits.getPackSize());
+        try { productService.saveProduct(product); }
+        catch (ServiceException e) { throw new RestApiException(e); }
+        return toDto(product);
+    }
+
+    private Product product(Long id, MerchantStore store) {
+        return Optional.ofNullable(store).flatMap(s -> productService.retrieveById(id, s))
+            .orElseThrow(() -> new ResourceNotFoundException("Product id [" + id + "] is not found"));
+    }
+    private ProductLimits toDto(Product p) {
+        ProductLimits d = new ProductLimits(); d.setMinPerCart(p.getMinPerCart());
+        d.setMaxPerCart(p.getMaxPerCart()); d.setPackSize(p.getPackSize()); return d;
+    }
+    private void validate(ProductLimits d) {
+        if (d == null || invalid(d.getMinPerCart()) || invalid(d.getMaxPerCart()) || invalid(d.getPackSize())
+                || (d.getMinPerCart() != null && d.getMaxPerCart() != null && d.getMinPerCart() > d.getMaxPerCart()))
+            throw new RestApiException("Invalid product limits");
+    }
+    private boolean invalid(Integer value) { return value != null && value < 1; }
+}
