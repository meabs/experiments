+	/** Validate before any entity is changed, preserving atomicity for multi updates. */
+	private void validateCartChange(ShoppingCart cart, com.salesmanager.core.model.shoppingcart.ShoppingCartItem changed,
+			int quantity, boolean additive) {
+		if (quantity == 0) return;
+		Product p = changed.getProduct();
+		if (quantity < 0) throw new ServiceRuntimeException("MIN_PER_CART", "Quantity must be zero or positive");
+		int resulting = quantity;
+		if (additive && cart.getLineItems() != null) for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : cart.getLineItems())
+			if (i.getSku().equals(changed.getSku())) resulting += Math.max(0, i.getQuantity());
+		if (p.getMinPerCart() != null && resulting < p.getMinPerCart())
+			throw new ServiceRuntimeException("MIN_PER_CART", "Quantity for " + p.getSku() + " is below the minimum");
+		if (p.getMaxPerCart() != null && resulting > p.getMaxPerCart())
+			throw new ServiceRuntimeException("MAX_PER_CART", "Quantity for " + p.getSku() + " exceeds the maximum");
+		if (p.getPackSize() != null && p.getPackSize() > 1 && resulting % p.getPackSize() != 0)
+			throw new ServiceRuntimeException("PACK_SIZE", "Quantity for " + p.getSku() + " must be a multiple of " + p.getPackSize());
+		if (cart.getLineItems() != null) {
+			int lines = cart.getLineItems().size();
+			int units = 0;
+			boolean existing = false;
+			for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : cart.getLineItems()) {
+				if (i.getSku().equals(changed.getSku())) { existing = true; units += (additive ? Math.max(0, i.getQuantity()) + quantity : quantity); }
+				else units += Math.max(0, i.getQuantity());
+			}
+			if (!existing) lines++;
+			Integer maxLines = cart.getMerchantStore().getMaxLines();
+			Integer maxUnits = cart.getMerchantStore().getMaxUnits();
+			if (!existing && quantity > 0 && maxLines != null && maxLines >= 0 && lines > maxLines) throw new ServiceRuntimeException("MAX_LINES", "Cart line limit exceeded");
+			if (maxUnits != null && maxUnits >= 0 && units + (!existing ? quantity : 0) > maxUnits) throw new ServiceRuntimeException("MAX_UNITS", "Cart unit limit exceeded");
+		} else {
+			Integer maxLines = cart.getMerchantStore().getMaxLines();
+			Integer maxUnits = cart.getMerchantStore().getMaxUnits();
+			if (quantity > 0 && maxLines != null && maxLines == 0) throw new ServiceRuntimeException("MAX_LINES", "Cart line limit exceeded");
+			if (maxUnits != null && maxUnits >= 0 && quantity > maxUnits) throw new ServiceRuntimeException("MAX_UNITS", "Cart unit limit exceeded");
+		}
