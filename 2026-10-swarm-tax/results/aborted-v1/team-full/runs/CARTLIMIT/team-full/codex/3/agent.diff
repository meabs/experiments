+	private void validateMultiCartChange(ShoppingCart cart, List<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> incoming,
+			MerchantStore store) {
+		List<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> proposed = new ArrayList<>();
+		if (cart.getLineItems() != null) proposed.addAll(cart.getLineItems());
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : incoming) {
+			int q = i.getQuantity();
+			if (q < 0) throw new ServiceRuntimeException("MIN_PER_CART", "Quantity must be zero or positive");
+			int match = -1;
+			for (int n = 0; n < proposed.size(); n++) if (proposed.get(n).getSku().equals(i.getSku())) { match = n; break; }
+			if (q == 0) { if (match >= 0) proposed.remove(match); }
+			else if (match >= 0) proposed.set(match, i); else proposed.add(i);
+		}
+		int units = 0;
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : proposed) {
+			int q = i.getQuantity(); units += q; Product p = i.getProduct();
+			if (p.getMinPerCart()!=null && q < p.getMinPerCart()) throw new ServiceRuntimeException("MIN_PER_CART", "Quantity for " + p.getSku() + " is below the minimum");
+			if (p.getMaxPerCart()!=null && q > p.getMaxPerCart()) throw new ServiceRuntimeException("MAX_PER_CART", "Quantity for " + p.getSku() + " exceeds the maximum");
+			if (p.getPackSize()!=null && p.getPackSize()>1 && q % p.getPackSize()!=0) throw new ServiceRuntimeException("PACK_SIZE", "Invalid pack size");
+		}
