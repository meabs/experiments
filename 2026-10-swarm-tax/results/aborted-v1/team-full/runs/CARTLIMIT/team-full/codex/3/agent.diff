+package com.salesmanager.shop.store.api.v1.store;
+
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.store.CartRules;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/cart-rules")
+public class CartRulesApi {
+    @Inject private MerchantStoreService merchantStoreService;
+    @GetMapping public CartRules get(@ApiIgnore MerchantStore store) { return dto(store); }
+    @PutMapping @ResponseStatus(HttpStatus.OK)
+    public CartRules update(@RequestBody CartRules rules, @ApiIgnore MerchantStore store) {
+        if (rules == null || invalid(rules.getMaxLines()) || invalid(rules.getMaxUnits()))
+            throw new RestApiException("Invalid cart rules");
+        store.setMaxLines(rules.getMaxLines()); store.setMaxUnits(rules.getMaxUnits());
+        try { merchantStoreService.saveOrUpdate(store); } catch (ServiceException e) { throw new RestApiException(e); }
+        return dto(store);
+    }
+    private CartRules dto(MerchantStore store) { CartRules d = new CartRules(); d.setMaxLines(store.getMaxLines()); d.setMaxUnits(store.getMaxUnits()); return d; }
+    private boolean invalid(Integer value) { return value != null && value < 1; }
+}
