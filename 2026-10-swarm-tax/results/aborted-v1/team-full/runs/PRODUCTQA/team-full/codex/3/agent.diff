+package com.salesmanager.shop.model.catalog.product;
+
+import java.util.Date;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+
+/** Public representation of a product question. */
+public class ReadableProductQuestion {
+    private Long id;
+    private String sku;
+    private String text;
+    private String answer;
+    private String status;
+    private Date askedAt;
+    private Date answeredAt;
+    private String askedBy;
+    public static ReadableProductQuestion from(ProductQuestion q) {
+        ReadableProductQuestion r = new ReadableProductQuestion();
+        r.id=q.getId(); r.sku=q.getSku(); r.text=q.getText(); r.answer=q.getAnswer();
+        r.status=q.getStatus()==null?null:q.getStatus().name(); r.askedAt=q.getAskedAt(); r.answeredAt=q.getAnsweredAt(); r.askedBy=q.getAskedBy();
+        return r;
+    }
+    public Long getId(){return id;} public void setId(Long v){id=v;}
+    public String getSku(){return sku;} public void setSku(String v){sku=v;}
+    public String getText(){return text;} public void setText(String v){text=v;}
+    public String getAnswer(){return answer;} public void setAnswer(String v){answer=v;}
+    public String getStatus(){return status;} public void setStatus(String v){status=v;}
+    public Date getAskedAt(){return askedAt;} public void setAskedAt(Date v){askedAt=v;}
+    public Date getAnsweredAt(){return answeredAt;} public void setAnsweredAt(Date v){answeredAt=v;}
+    public String getAskedBy(){return askedBy;} public void setAskedBy(String v){askedBy=v;}
+}
