+package com.salesmanager.core.business.services.catalog.product.question;
+
+import java.util.Date;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long, ProductQuestion>
+        implements ProductQuestionService {
+    private final ProductQuestionRepository repository;
+
+    @Inject
+    public ProductQuestionServiceImpl(ProductQuestionRepository repository) {
+        super(repository);
+        this.repository = repository;
+    }
+
+    @Override
+    public ProductQuestion ask(ProductQuestion question) {
+        if (question == null || question.getCustomer() == null || question.getProduct() == null)
+            throw new IllegalArgumentException("Question, customer and product are required");
+        String text = question.getText() == null ? null : question.getText().trim();
+        if (text == null || text.length() == 0 || text.length() > 2000)
+            throw new IllegalArgumentException("Question text must be between 1 and 2000 characters");
+        if (repository.countByCustomerIdAndStatus(question.getCustomer().getId(), ProductQuestionStatus.PENDING) >= 3)
+            throw new IllegalStateException("A customer may have at most three pending questions");
+        question.setText(text);
+        Product product = question.getProduct();
+        question.setSku(product.getSku());
+        if (question.getMerchantStore() == null) question.setMerchantStore(product.getMerchantStore());
+        question.setStatus(ProductQuestionStatus.PENDING);
+        question.setAskedAt(new Date());
+        if (question.getCustomer().getBilling() != null)
+            question.setAskedBy(question.getCustomer().getBilling().getFirstName());
+        try { save(question); } catch (Exception e) { throw new IllegalStateException("Unable to save question", e); }
+        return question;
+    }
+
+    @Override
+    public ProductQuestion answer(Long id, String answer, MerchantStore store) {
+        ProductQuestion question = requireOwned(id, store);
+        if (question.getStatus() == ProductQuestionStatus.REJECTED)
+            throw new IllegalStateException("Rejected questions cannot be answered");
+        String value = answer == null ? null : answer.trim();
+        if (value == null || value.length() == 0 || value.length() > 2000)
+            throw new IllegalArgumentException("Answer must be between 1 and 2000 characters");
+        question.setAnswer(value);
+        question.setAnsweredAt(new Date());
+        question.setStatus(ProductQuestionStatus.PUBLISHED);
+        try { update(question); } catch (Exception e) { throw new IllegalStateException("Unable to answer question", e); }
+        return question;
+    }
+
+    @Override
+    public ProductQuestion reject(Long id, MerchantStore store) {
+        ProductQuestion question = requireOwned(id, store);
+        question.setStatus(ProductQuestionStatus.REJECTED);
+        try { update(question); } catch (Exception e) { throw new IllegalStateException("Unable to reject question", e); }
+        return question;
+    }
+
+    private ProductQuestion requireOwned(Long id, MerchantStore store) {
+        ProductQuestion q = repository.findOne(id);
+        if (q == null) throw new IllegalArgumentException("Question not found");
+        if (store == null || q.getMerchantStore() == null || !store.getId().equals(q.getMerchantStore().getId()))
+            throw new SecurityException("Question does not belong to store");
+        return q;
+    }
+
+    public List<ProductQuestion> getByCustomer(Customer customer) { return repository.findByCustomer(customer.getId()); }
+    public List<ProductQuestion> getPublishedByProduct(Product product) { return repository.findByProductAndStatus(product.getId(), ProductQuestionStatus.PUBLISHED); }
+    public List<ProductQuestion> getByStore(MerchantStore store, ProductQuestionStatus status) { return repository.findByStoreAndStatus(store.getId(), status); }
+}
