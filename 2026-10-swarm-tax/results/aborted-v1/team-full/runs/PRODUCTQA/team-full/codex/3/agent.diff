+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.ArrayList;
+import java.util.List;
+import javax.inject.Inject;
+import javax.validation.Valid;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.model.catalog.product.PersistableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestionList;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.user.facade.UserFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+    @Inject private ProductQuestionService questionService;
+    @Inject private ProductService productService;
+    @Inject private CustomerFacade customerFacade;
+    @Inject private UserFacade userFacade;
+
+    @PostMapping("/auth/products/{sku}/questions")
+    @ResponseStatus(HttpStatus.CREATED)
+    public ReadableProductQuestion ask(@PathVariable String sku, @Valid @RequestBody PersistableProductQuestion body,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language, Principal principal) throws com.salesmanager.core.business.exception.ServiceException {
+        requireCustomer(principal);
+        Product product = productService.getBySku(sku.trim(), store, language);
+        if (product == null) throw new ResourceNotFoundException("Product " + sku + " does not exist");
+        Customer customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (customer == null) throw new ResourceNotFoundException("Customer does not exist");
+        String text = body.getText() == null ? null : body.getText().trim();
+        if (text == null || text.length() == 0) throw new ServiceRuntimeException("400", "Question text is required");
+        ProductQuestion q = new ProductQuestion(); q.setProduct(product); q.setSku(product.getSku());
+        q.setMerchantStore(store); q.setCustomer(customer); q.setText(text); q.setAskedBy(principal.getName());
+        return ReadableProductQuestion.from(questionService.ask(q));
+    }
+
+    @GetMapping("/products/{sku}/questions")
+    public ReadableProductQuestionList published(@PathVariable String sku, @ApiIgnore MerchantStore store,
+            @ApiIgnore Language language) throws com.salesmanager.core.business.exception.ServiceException {
+        Product product = productService.getBySku(sku.trim(), store, language);
+        if (product == null) throw new ResourceNotFoundException("Product " + sku + " does not exist");
+        return new ReadableProductQuestionList(map(questionService.getPublishedByProduct(product)));
+    }
+
+    @GetMapping("/auth/customer/questions")
+    public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store, @ApiIgnore Language language,
+            Principal principal) {
+        requireCustomer(principal);
+        Customer c = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (c == null) throw new ResourceNotFoundException("Customer does not exist");
+        return map(questionService.getByCustomer(c));
+    }
+
+    @GetMapping("/private/questions")
+    public List<ReadableProductQuestion> all(@RequestParam(required=false) String status, @ApiIgnore MerchantStore store) {
+        requireAdmin();
+        ProductQuestionStatus s = parseStatus(status);
+        return map(questionService.getByStore(store, s));
+    }
+
+    @PutMapping("/private/questions/{id}/answer")
+    public ReadableProductQuestion answer(@PathVariable Long id, @Valid @RequestBody PersistableProductQuestion body,
+            @ApiIgnore MerchantStore store) {
+        requireAdmin();
+        ProductQuestion existing = findQuestion(id);
+        if (existing == null || existing.getMerchantStore() == null || store == null ||
+                !store.getCode().equals(existing.getMerchantStore().getCode())) throw new ResourceNotFoundException("Question " + id + " does not exist");
+        String answer = body.getAnswer() == null ? "" : body.getAnswer().trim();
+        if (answer.length() == 0) throw new ServiceRuntimeException("400", "Answer is required");
+        ProductQuestion result;
+        try { result = questionService.answer(id, answer, store); }
+        catch (IllegalStateException e) { throw new ServiceRuntimeException("409", e.getMessage()); }
+        return ReadableProductQuestion.from(result);
+    }
+
+    @PutMapping("/private/questions/{id}/reject")
+    public ReadableProductQuestion reject(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        requireAdmin();
+        ProductQuestion existing = findQuestion(id);
