+package com.salesmanager.core.business.services.catalog.product.question;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.*;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long, ProductQuestion> implements ProductQuestionService {
+    private final ProductQuestionRepository repository;
+    @Inject public ProductQuestionServiceImpl(ProductQuestionRepository repository) { super(repository); this.repository = repository; }
+    public ProductQuestion ask(ProductQuestion q) { validate(q); q.setStatus(ProductQuestionStatus.PENDING); if (q.getAskedAt() == null) q.setAskedAt(new Date()); if (repository.countByCustomerIdAndStatus(q.getCustomer().getId(), ProductQuestionStatus.PENDING) >= 3) throw new IllegalStateException("A customer may have at most 3 pending product questions"); return repository.saveAndFlush(q); }
+    public ProductQuestion createQuestion(ProductQuestion q) { return ask(q); }
+    private void validate(ProductQuestion q) { if (q == null || q.getProduct() == null || q.getCustomer() == null || q.getMerchantStore() == null || q.getText() == null || q.getText().trim().isEmpty()) throw new IllegalArgumentException("Question, product, customer and store are required"); if (q.getProduct().getMerchantStore() != null && !Objects.equals(q.getProduct().getMerchantStore().getId(), q.getMerchantStore().getId())) throw new IllegalArgumentException("Product does not belong to store"); }
+    private ProductQuestion scoped(Long id, MerchantStore store) { ProductQuestion q = getById(id); if (q == null || !Objects.equals(q.getMerchantStore().getId(), store.getId())) throw new IllegalArgumentException("Question is not in store"); return q; }
+    public ProductQuestion publish(Long id, MerchantStore store, String answer) { ProductQuestion q = scoped(id, store); if (q.getStatus() != ProductQuestionStatus.PENDING) throw new IllegalStateException("Only pending questions can be published"); if (answer == null || answer.trim().isEmpty()) throw new IllegalArgumentException("Answer is required"); q.setAnswer(answer); q.setAnsweredAt(new Date()); q.setStatus(ProductQuestionStatus.PUBLISHED); return repository.saveAndFlush(q); }
+    public ProductQuestion reject(Long id, MerchantStore store) { ProductQuestion q = scoped(id, store); if (q.getStatus() != ProductQuestionStatus.PENDING) throw new IllegalStateException("Only pending questions can be rejected"); q.setStatus(ProductQuestionStatus.REJECTED); q.setAnsweredAt(new Date()); return repository.saveAndFlush(q); }
+    public List<ProductQuestion> getByProduct(Product p) { return repository.findByProductIdOrderByAskedAtDesc(p.getId()); }
+    public List<ProductQuestion> getByProduct(Product p, MerchantStore s) { return repository.findByProductIdAndMerchantStoreIdOrderByAskedAtDesc(p.getId(), s.getId()); }
+    public List<ProductQuestion> getByStore(MerchantStore s) { return repository.findByMerchantStoreIdOrderByAskedAtDesc(s.getId()); }
+    public List<ProductQuestion> getByCustomer(Customer c) { return repository.findByCustomerIdOrderByAskedAtDesc(c.getId()); }
+}
