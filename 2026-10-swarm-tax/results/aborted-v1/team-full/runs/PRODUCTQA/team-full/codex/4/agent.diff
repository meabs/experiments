+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.ArrayList;
+import java.util.List;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import javax.validation.Valid;
+
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.catalog.product.*;
+import com.salesmanager.shop.populator.catalog.ReadableProductQuestionPopulator;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.UnauthorizedException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.api.exception.QuestionConflictException;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Customer, public and store-admin product question endpoints. */
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+    @Inject private ProductQuestionService questionService;
+    @Inject private ProductService productService;
+    @Inject private CustomerFacade customerFacade;
+
+    @PostMapping("/auth/products/{sku}/questions")
+    @ResponseStatus(HttpStatus.CREATED)
+    public ReadableProductQuestion ask(@PathVariable String sku,
+            @Valid @RequestBody PersistableProductQuestion payload,
+            @ApiIgnore MerchantStore store, HttpServletRequest request) throws Exception {
+        Product product = productService.getBySku(sku, store);
+        if (product == null) throw new ResourceNotFoundException("Product [" + sku + "] not found");
+        Principal principal = request.getUserPrincipal();
+        if (principal == null) throw new UnauthorizedException();
+        Customer customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (customer == null) throw new ResourceNotFoundException("Customer not found");
+        if (customer.getMerchantStore() != null && !customer.getMerchantStore().getId().equals(store.getId()))
+            throw new ResourceNotFoundException("Customer not found");
+        ProductQuestion q = new ProductQuestion();
+        q.setProduct(product); q.setMerchantStore(store); q.setCustomer(customer);
+        q.setText(StringUtils.trimToEmpty(payload.getText()));
+        try { return read(questionService.ask(q), store); }
+        catch (IllegalArgumentException | IllegalStateException e) { throw new RestApiException("400", e.getMessage()); }
+    }
+
+    @GetMapping("/auth/customer/questions")
+    public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store, HttpServletRequest request) {
+        Principal principal = request.getUserPrincipal();
+        if (principal == null) throw new UnauthorizedException();
+        Customer customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (customer == null) throw new ResourceNotFoundException("Customer not found");
+        List<ReadableProductQuestion> out = new ArrayList<>();
+        for (ProductQuestion q : questionService.getByCustomer(customer)) out.add(read(q, store));
+        return out;
+    }
+
+    @GetMapping("/products/{sku}/questions")
+    public ReadableProductQuestionList product(@PathVariable String sku, @ApiIgnore MerchantStore store) throws Exception {
+        Product product = productService.getBySku(sku, store);
+        if (product == null) throw new ResourceNotFoundException("Product [" + sku + "] not found");
+        List<ReadableProductQuestion> out = new ArrayList<>();
+        for (ProductQuestion q : questionService.getByProduct(product, store))
