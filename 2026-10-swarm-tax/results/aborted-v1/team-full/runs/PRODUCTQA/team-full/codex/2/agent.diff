+        Customer customer = customerService.getByNick(principal.getName(), store.getId());
+        if (customer == null) throw new ResourceNotFoundException("Customer not found");
+        ProductQuestion q = new ProductQuestion(); q.setProduct(product); q.setCustomer(customer); q.setText(body.getText());
+        try { questionService.create(q); } catch (Exception e) { throw new ServiceRuntimeException("400", e.getMessage()); }
