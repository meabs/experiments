+package com.salesmanager.core.business.services.catalog.product.question;
+
+import java.util.Date;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long, ProductQuestion>
+        implements ProductQuestionService {
+    private static final int MIN_TEXT_LENGTH = 10;
+    private static final int MAX_TEXT_LENGTH = 500;
+    private final ProductQuestionRepository repository;
+
+    @Inject
+    public ProductQuestionServiceImpl(ProductQuestionRepository repository) {
+        super(repository);
+        this.repository = repository;
+    }
+    public List<ProductQuestion> getByCustomer(Customer c) { return repository.findByCustomerId(c.getId()); }
+    @Override public ProductQuestion getById(Long id) { return repository.findById(id).orElse(null); }
+    public List<ProductQuestion> getByProduct(Product p) { return repository.findByProductId(p.getId()); }
+    public List<ProductQuestion> getByProduct(Product p, ProductQuestionStatus s) { return repository.findByProductIdAndStatus(p.getId(), s); }
+    public List<ProductQuestion> getByStore(MerchantStore s) { return repository.findByProductMerchantStoreId(s.getId()); }
+    public List<ProductQuestion> getByStore(MerchantStore s, ProductQuestionStatus status) { return repository.findByProductMerchantStoreIdAndStatus(s.getId(), status); }
+    public long countPending(Customer c, Product p) { return repository.countByCustomerIdAndProductIdAndStatus(c.getId(), p.getId(), ProductQuestionStatus.PENDING); }
+    public long countPending(Customer c) { return repository.countByCustomerIdAndStatus(c.getId(), ProductQuestionStatus.PENDING); }
+
+    @Override public void create(ProductQuestion q) throws ServiceException { validate(q, true); super.create(q); }
+    @Override public void update(ProductQuestion q) throws ServiceException { validate(q, false); super.update(q); }
+    private void validate(ProductQuestion q, boolean fresh) throws ServiceException {
+        if (q == null || q.getProduct() == null || q.getCustomer() == null) throw new ServiceException(ServiceException.EXCEPTION_VALIDATION, "Question, product and customer are required");
+        if (q.getText() == null || q.getText().trim().length() < MIN_TEXT_LENGTH || q.getText().trim().length() > MAX_TEXT_LENGTH) throw new ServiceException(ServiceException.EXCEPTION_VALIDATION, "Question text must be between 10 and 500 characters");
+        q.setText(q.getText().trim());
+        if (q.getStatus() == null) q.setStatus(ProductQuestionStatus.PENDING);
+        if (q.getAnswer() != null) { q.setAnswer(q.getAnswer().trim()); if (q.getAnswer().isEmpty()) q.setAnswer(null); }
+        if (fresh && q.getStatus() == ProductQuestionStatus.PENDING && repository.countByCustomerIdAndStatus(q.getCustomer().getId(), ProductQuestionStatus.PENDING) >= 3) throw new ServiceException(ServiceException.EXCEPTION_VALIDATION, "A customer may have at most 3 pending questions");
+        if (q.getAskedAt() == null) q.setAskedAt(new Date());
+        if (q.getStatus() == ProductQuestionStatus.PUBLISHED && (q.getAnswer() == null || q.getAnswer().length() < 1 || q.getAnswer().length() > 2000)) throw new ServiceException(ServiceException.EXCEPTION_VALIDATION, "Answer must be between 1 and 2000 characters");
+        if (q.getStatus() == ProductQuestionStatus.REJECTED) q.setAnsweredAt(null); else if (q.getAnswer() != null && q.getAnsweredAt() == null) q.setAnsweredAt(new Date());
+    }
+}
