+    @PostMapping("/auth/products/{sku}/questions")
+    @ResponseStatus(HttpStatus.CREATED)
+    public ReadableProductQuestion ask(@PathVariable String sku, @Valid @RequestBody ProductQuestionRequest body,
+            @ApiIgnore MerchantStore store, HttpServletRequest request) {
+        Principal principal = request.getUserPrincipal();
+        if (principal == null) throw new ServiceRuntimeException("Authentication is required");
+        Product product;
+        try { product = productService.getBySku(sku, store); } catch (Exception e) { throw new ResourceNotFoundException("Product not found"); }
