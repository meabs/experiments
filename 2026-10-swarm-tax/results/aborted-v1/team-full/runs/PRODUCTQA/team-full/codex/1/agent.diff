+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.List;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import javax.validation.Valid;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.question.PersistableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.question.ReadableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.question.ReadableProductQuestionList;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+    @Inject private ProductQuestionService questionService;
+    @Inject private ProductService productService;
+    @Inject private CustomerService customerService;
+
+    @PostMapping("/auth/products/{sku}/questions")
+    @ResponseStatus(HttpStatus.CREATED)
+    public ReadableProductQuestion ask(@PathVariable String sku, @Valid @RequestBody PersistableProductQuestion body,
+            @ApiIgnore MerchantStore store, HttpServletRequest request) {
+        Customer c = customer(request, store); Product p = product(sku, store);
+        String text = body == null || body.getQuestion() == null ? null : body.getQuestion().trim();
+        if (text == null || text.length() < 10 || text.length() > 500) throw bad("Question must be between 10 and 500 characters");
+        ProductQuestion q = new ProductQuestion(); q.setCustomer(c); q.setProduct(p); q.setText(text);
+        try { return new ReadableProductQuestion(questionService.ask(q)); }
+        catch (ServiceException e) { throw bad(e.getMessage()); }
+    }
+
+    @GetMapping("/auth/customer/questions")
+    public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store, HttpServletRequest request) {
+        Customer c=customer(request,store);
+        return questionService.listByCustomer(c.getId()).stream().map(ReadableProductQuestion::new).collect(Collectors.toList());
+    }
+
+    @GetMapping("/products/{sku}/questions")
+    public ReadableProductQuestionList published(@PathVariable String sku, @ApiIgnore MerchantStore store) {
+        Product p=product(sku,store);
+        return new ReadableProductQuestionList(questionService.listPublishedByProduct(p.getId()).stream().map(ReadableProductQuestion::new).collect(Collectors.toList()));
+    }
+
+    @GetMapping("/private/questions")
+    public List<ReadableProductQuestion> admin(@RequestParam(defaultValue="PENDING") String status, @ApiIgnore MerchantStore store) {
+        ProductQuestionStatus s;
+        try { s=ProductQuestionStatus.valueOf(status.toUpperCase()); } catch (Exception e) { throw bad("Invalid question status"); }
+        return questionService.listByStore(store.getId(),s).stream().map(ReadableProductQuestion::new).collect(Collectors.toList());
+    }
+
+    @PutMapping("/private/questions/{id}/answer")
+    public ReadableProductQuestion answer(@PathVariable Long id, @Valid @RequestBody PersistableProductQuestion body,
+            @ApiIgnore MerchantStore store) {
+        String answer=body==null||body.getAnswer()==null?null:body.getAnswer().trim();
+        if(answer==null||answer.length()<1||answer.length()>2000) throw bad("Answer must be between 1 and 2000 characters");
+        verifyStore(id, store);
+        try { return new ReadableProductQuestion(questionService.answer(id,answer)); }
+        catch(ServiceException e){ throw conflictOrNotFound(e); }
+    }
+
+    @PutMapping("/private/questions/{id}/reject")
+    public ReadableProductQuestion reject(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        verifyStore(id, store);
+        try { return new ReadableProductQuestion(questionService.reject(id)); }
+        catch(ServiceException e){ throw conflictOrNotFound(e); }
+    }
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal p=request.getUserPrincipal(); if(p==null) throw new RestApiException("Authentication required");
+        Customer c=customerService.getByNick(p.getName(),store.getId()); if(c==null) throw new ResourceNotFoundException("Customer not found"); return c;
+    }
+    private Product product(String sku, MerchantStore store) {
+        try { Product p=productService.getBySku(sku,store); if(p==null) throw new ResourceNotFoundException("Product not found"); return p; }
+        catch(ServiceException e){ throw new ResourceNotFoundException("Product not found"); }
+    }
+    /** Admin mutations must never operate on a question belonging to another store. */
+    private void verifyStore(Long id, MerchantStore store) {
+        ProductQuestion q = questionService.getWithProductCustomerStore(id);
+        if (q == null || q.getProduct() == null || q.getProduct().getMerchantStore() == null
+                || store == null || !store.getId().equals(q.getProduct().getMerchantStore().getId())) {
+            throw new ResourceNotFoundException("Product question not found");
+        }
+    }
+    private RestApiException bad(String m){ return new RestApiException("400",m); }
+    private RuntimeException conflictOrNotFound(ServiceException e){
+        String m=e.getMessage()==null?"Question operation failed":e.getMessage();
+        if(m.toLowerCase().contains("not found")) return new ResourceNotFoundException(m);
+        return new QuestionConflictException(m);
+    }
+    @ResponseStatus(HttpStatus.CONFLICT)
+    static class QuestionConflictException extends RuntimeException { QuestionConflictException(String m){super(m);} }
+}
