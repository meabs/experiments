+package com.salesmanager.core.business.repositories.catalog.product.question;
+
+import java.util.List;
+import java.util.Optional;
+import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Query;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+
+public interface ProductQuestionRepository extends JpaRepository<ProductQuestion, Long> {
+    List<ProductQuestion> findByCustomerIdOrderByAskedAtDesc(Long customerId);
+    List<ProductQuestion> findByProductIdAndStatusOrderByAnsweredAtDesc(Long productId, ProductQuestionStatus status);
+    List<ProductQuestion> findByProductIdAndStatusOrderByAnsweredAtAsc(Long productId, ProductQuestionStatus status);
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch q.customer c join fetch p.merchantStore where q.id = ?1")
+    Optional<ProductQuestion> findByIdWithProductCustomerStore(Long id);
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch q.customer c where p.merchantStore.id = ?1 and q.status = ?2 order by q.askedAt asc")
+    List<ProductQuestion> findByStoreAndStatus(Integer storeId, ProductQuestionStatus status);
+    long countByCustomerIdAndStatus(Long customerId, ProductQuestionStatus status);
+}
