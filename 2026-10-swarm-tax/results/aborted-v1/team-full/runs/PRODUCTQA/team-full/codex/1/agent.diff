+package com.salesmanager.core.business.services.catalog.product.question;
+import java.util.Date; import java.util.List; import javax.inject.Inject; import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository; import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl; import com.salesmanager.core.model.catalog.product.question.ProductQuestion; import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+@Service("productQuestionService") public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long, ProductQuestion> implements ProductQuestionService {
+ private final ProductQuestionRepository repository; @Inject public ProductQuestionServiceImpl(ProductQuestionRepository repository){super(repository);this.repository=repository;}
+ public ProductQuestion ask(ProductQuestion q)throws ServiceException{return createQuestion(q);} public ProductQuestion createQuestion(ProductQuestion q)throws ServiceException{if(q==null||q.getCustomer()==null||q.getProduct()==null)throw new ServiceException("Product and customer are required");String t=q.getText()==null?null:q.getText().trim();if(t==null||t.length()==0)throw new ServiceException("Question text is required");if(repository.countByCustomerIdAndStatus(q.getCustomer().getId(),ProductQuestionStatus.PENDING)>=3)throw new ServiceException("A customer may have at most three pending questions");q.setText(t);q.setStatus(ProductQuestionStatus.PENDING);if(q.getAskedAt()==null)q.setAskedAt(new Date());repository.save(q);return q;}
+ public ProductQuestion answer(Long id,String a)throws ServiceException{return answerInternal(id,null,a);} public ProductQuestion answer(Long id,Integer storeId,String a)throws ServiceException{return answerInternal(id,storeId,a);}
+ private ProductQuestion answerInternal(Long id,Integer storeId,String a)throws ServiceException{ProductQuestion q=requiredWithStore(id,storeId);if(q.getStatus()==ProductQuestionStatus.REJECTED)throw new ServiceException("Rejected questions cannot be answered");if(q.getStatus()!=ProductQuestionStatus.PENDING&&q.getStatus()!=ProductQuestionStatus.PUBLISHED)throw new ServiceException("Question cannot be answered in its current state");if(a==null||a.trim().length()==0)throw new ServiceException("Answer is required");q.setAnswer(a.trim());q.setAnsweredAt(new Date());q.setStatus(ProductQuestionStatus.PUBLISHED);return repository.save(q);}
+ public ProductQuestion reject(Long id)throws ServiceException{return rejectInternal(id,null);} public ProductQuestion reject(Long id,Integer storeId)throws ServiceException{return rejectInternal(id,storeId);}
+ private ProductQuestion rejectInternal(Long id,Integer storeId)throws ServiceException{ProductQuestion q=requiredWithStore(id,storeId);if(q.getStatus()==ProductQuestionStatus.REJECTED)return q;q.setStatus(ProductQuestionStatus.REJECTED);return repository.save(q);} private ProductQuestion required(Long id)throws ServiceException{return repository.findById(id).orElseThrow(()->new ServiceException("Product question not found: "+id));}
+ private ProductQuestion requiredWithStore(Long id,Integer storeId)throws ServiceException{ProductQuestion q=repository.findByIdWithProductCustomerStore(id).orElseThrow(()->new ServiceException("Product question not found: "+id));if(storeId!=null&&(q.getProduct().getMerchantStore()==null||!storeId.equals(q.getProduct().getMerchantStore().getId())))throw new ServiceException("Product question does not belong to this store");return q;}
+ public List<ProductQuestion> listByCustomer(Long id){return repository.findByCustomerIdOrderByAskedAtDesc(id);} public List<ProductQuestion> listPublishedByProduct(Long id){return repository.findByProductIdAndStatusOrderByAnsweredAtDesc(id,ProductQuestionStatus.PUBLISHED);} public List<ProductQuestion> listByStore(Integer id,ProductQuestionStatus s){return repository.findByStoreAndStatus(id,s);} public ProductQuestion getWithProductCustomerStore(Long id){return repository.findByIdWithProductCustomerStore(id).orElse(null);}
+}
