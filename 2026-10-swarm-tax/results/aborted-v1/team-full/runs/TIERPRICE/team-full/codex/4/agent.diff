+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestMethod;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductPriceTier;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+@Controller
+@RequestMapping("/api/v1")
+public class ProductPriceTierApi {
+    @Autowired private ProductService productService;
+
+    @RequestMapping(value = "/private/product/{id}/tiers", method = RequestMethod.GET)
+    public @ResponseBody List<ProductPriceTier> get(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        Product product = product(id, store);
+        return product.getPriceTiers().stream().sorted(Comparator.comparing(com.salesmanager.core.model.catalog.product.ProductPriceTier::getMinQuantity))
+                .map(this::read).collect(Collectors.toList());
+    }
+
+    @ResponseStatus(HttpStatus.OK)
+    @RequestMapping(value = "/private/product/{id}/tiers", method = RequestMethod.PUT)
+    public @ResponseBody List<ProductPriceTier> put(@PathVariable Long id, @RequestBody List<ProductPriceTier> request,
+            @ApiIgnore MerchantStore store) {
+        Product product = product(id, store);
+        List<ProductPriceTier> input = request == null ? new ArrayList<ProductPriceTier>() : request;
+        validate(input);
+        Set<com.salesmanager.core.model.catalog.product.ProductPriceTier> replacement = new HashSet<com.salesmanager.core.model.catalog.product.ProductPriceTier>();
+        for (ProductPriceTier dto : input) {
+            com.salesmanager.core.model.catalog.product.ProductPriceTier tier = new com.salesmanager.core.model.catalog.product.ProductPriceTier();
+            tier.setProduct(product); tier.setMinQuantity(dto.getMinQuantity()); tier.setPrice(dto.getPrice());
+            replacement.add(tier);
+        }
+        product.getPriceTiers().clear();
+        product.getPriceTiers().addAll(replacement);
+        try { productService.saveProduct(product); }
+        catch (Exception e) { throw new RestApiException("Unable to save product price tiers", e); }
+        return get(id, store);
+    }
+
+    private Product product(Long id, MerchantStore store) {
+        Product product = productService.findOne(id, store);
+        if (product == null) throw new ResourceNotFoundException("Product not found");
+        return product;
+    }
+
+    private void validate(List<ProductPriceTier> tiers) {
+        if (tiers.size() > 10) throw new RestApiException("A maximum of 10 price tiers is allowed");
+        Set<Integer> quantities = new HashSet<Integer>();
+        List<ProductPriceTier> sorted = new ArrayList<ProductPriceTier>(tiers);
+        sorted.sort(Comparator.nullsFirst(Comparator.comparing(ProductPriceTier::getMinQuantity, Comparator.nullsFirst(Integer::compareTo))));
+        for (ProductPriceTier tier : sorted) {
+            if (tier == null || tier.getMinQuantity() == null || tier.getPrice() == null)
+                throw new RestApiException("minQuantity and price are required");
+            if (tier.getMinQuantity() < 2) throw new RestApiException("minQuantity must be at least 2");
+            if (tier.getPrice().signum() <= 0) throw new RestApiException("price must be greater than zero");
+            if (!quantities.add(tier.getMinQuantity())) throw new RestApiException("Duplicate minQuantity");
+        }
+        for (int i = 1; i < sorted.size(); i++)
+            if (sorted.get(i).getPrice().compareTo(sorted.get(i - 1).getPrice()) >= 0)
+                throw new RestApiException("Prices must strictly decrease as minQuantity increases");
+    }
+    private ProductPriceTier read(com.salesmanager.core.model.catalog.product.ProductPriceTier tier) {
+        ProductPriceTier dto = new ProductPriceTier(); dto.setMinQuantity(tier.getMinQuantity()); dto.setPrice(tier.getPrice()); return dto;
+    }
+}
