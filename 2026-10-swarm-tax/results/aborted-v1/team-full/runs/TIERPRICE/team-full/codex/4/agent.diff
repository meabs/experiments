+	@Override
+	public void refreshShoppingCartItem(final ShoppingCartItem item, final MerchantStore store) throws ServiceException {
+		Validate.notNull(item, "ShoppingCartItem must not be null");
+		Validate.notNull(item.getProduct(), "ShoppingCartItem.product must not be null");
+		try {
+			List<ProductAttribute> attributes = new ArrayList<ProductAttribute>();
+			Set<ShoppingCartAttributeItem> selected = item.getAttributes();
+			if (selected != null) {
+				for (ShoppingCartAttributeItem attribute : selected) {
+					ProductAttribute productAttribute = attribute.getProductAttribute();
+					if (productAttribute == null) {
+						productAttribute = productAttributeService.getById(attribute.getProductAttributeId());
+					}
+					if (productAttribute != null) {
+						attributes.add(productAttribute);
+					}
+				}
+			}
+			FinalPrice price = pricingService.calculateProductPrice(item.getProduct(), attributes);
+			price = applyQuantityTier(item.getProduct(), item.getQuantity(), price);
+			item.setFinalPrice(price);
+			item.setItemPrice(price.getFinalPrice());
+			item.setSubTotal(price.getFinalPrice().multiply(BigDecimal.valueOf(item.getQuantity())));
+		} catch (Exception e) {
+			throw new ServiceException(e);
+		}
+	}
+
+	/**
+	 * Select the deepest reached break and only use it when it improves the
+	 * currently applicable base/special price. Tiers are unit prices, not line
+	 * prices.
+	 */
+	private FinalPrice applyQuantityTier(Product product, Integer quantity, FinalPrice price) {
+		if (product == null || quantity == null || price == null || price.getFinalPrice() == null
+				|| CollectionUtils.isEmpty(product.getPriceTiers())) {
+			return price;
+		}
+		ProductPriceTier selected = null;
+		for (ProductPriceTier tier : product.getPriceTiers()) {
+			if (tier != null && tier.getMinQuantity() != null && tier.getPrice() != null
+					&& tier.getMinQuantity() <= quantity
+					&& (selected == null || tier.getMinQuantity() > selected.getMinQuantity())) {
+				selected = tier;
+			}
+		}
+		if (selected != null && selected.getPrice().compareTo(price.getFinalPrice()) < 0) {
+			// Keep the base/special values for display, while making the effective
+			// price consistently visible through FinalPrice as well.
+			price.setFinalPrice(selected.getPrice());
+			price.setDiscountedPrice(selected.getPrice());
+			price.setDiscounted(true);
+		}
+		return price;
+	}
+
