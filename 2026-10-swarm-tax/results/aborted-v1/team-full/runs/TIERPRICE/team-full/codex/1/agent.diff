+	@Override
+	public void refreshCartPrices(final ShoppingCart shoppingCart) throws ServiceException {
+		if (shoppingCart == null || shoppingCart.getLineItems() == null) return;
+		for (ShoppingCartItem item : shoppingCart.getLineItems()) {
+			if (item.getProduct() == null || item.isObsolete()) continue;
+			List<ProductAttribute> attributes = new ArrayList<ProductAttribute>();
+			if (item.getAttributes() != null) {
+				for (ShoppingCartAttributeItem attribute : item.getAttributes()) {
+					if (attribute.getProductAttribute() != null) attributes.add(attribute.getProductAttribute());
+				}
+			}
+			FinalPrice base = pricingService.calculateProductPrice(item.getProduct(), attributes);
+			item.setFinalPrice(base);
+			item.setItemPrice(tierPrice(item.getProduct(), item.getQuantity(), base.getFinalPrice()));
+			item.setSubTotal(item.getItemPrice().multiply(BigDecimal.valueOf(item.getQuantity())));
+		}
+	}
+
+	/** Select the highest reached tier and never charge more than base final/special price. */
+	private BigDecimal tierPrice(Product product, int quantity, BigDecimal basePrice) {
+		BigDecimal selected = basePrice;
+		if (basePrice == null || product == null || product.getTiers() == null) return selected;
+		for (ProductTier tier : product.getTiers()) {
+			if (tier != null && tier.getMinQuantity() != null && tier.getPrice() != null
+					&& tier.getMinQuantity() <= quantity && tier.getPrice().compareTo(selected) < 0) {
+				selected = tier.getPrice();
+			}
+		}
+		return selected;
+	}
+
