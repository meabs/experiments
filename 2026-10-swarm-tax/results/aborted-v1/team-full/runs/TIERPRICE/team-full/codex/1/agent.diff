+/** A wholesale price applicable when at least minQuantity units are purchased. */
+@Entity
+@Table(name = "PRODUCT_TIER", uniqueConstraints = @UniqueConstraint(columnNames = {"PRODUCT_ID", "MIN_QUANTITY"}))
+public class ProductTier implements Serializable {
+    private static final long serialVersionUID = 1L;
+
+    @Id
+    @Column(name = "PRODUCT_TIER_ID", nullable = false, unique = true)
+    @TableGenerator(name = "TABLE_GEN", table = "SM_SEQUENCER", pkColumnName = "SEQ_NAME",
+            valueColumnName = "SEQ_COUNT", pkColumnValue = "PRODUCT_TIER_SEQ_NEXT_VAL")
+    @GeneratedValue(strategy = GenerationType.TABLE, generator = "TABLE_GEN")
+    private Long id;
+
+    @JsonIgnore
+    @ManyToOne(fetch = FetchType.LAZY, optional = false)
+    @JoinColumn(name = "PRODUCT_ID", nullable = false)
+    private Product product;
+
+    @Column(name = "MIN_QUANTITY", nullable = false)
+    private Integer minQuantity;
+
+    @Column(name = "PRICE", nullable = false, precision = 19, scale = 4)
+    private BigDecimal price;
+
+    public Long getId() { return id; }
