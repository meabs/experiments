+package com.salesmanager.core.business.services.catalog.product.price;
+import java.util.*;
+import java.math.BigDecimal;
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.price.ProductPriceTierRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.price.ProductPriceTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("productPriceTierService")
+public class ProductPriceTierServiceImpl implements ProductPriceTierService {
+ private final ProductPriceTierRepository repository;
+ @Inject public ProductPriceTierServiceImpl(ProductPriceTierRepository repository){this.repository=repository;}
+ public List<ProductPriceTier> findByProduct(Long id, MerchantStore store){return repository.findByProduct(id,store.getCode());}
+ @Transactional
+ public List<ProductPriceTier> replace(Product product,List<ProductPriceTier> tiers)throws ServiceException{
+  if(tiers!=null) tiers.sort(Comparator.comparing(ProductPriceTier::getMinQuantity, Comparator.nullsFirst(Integer::compareTo)));
+  validate(tiers);
+  repository.deleteAll(repository.findByProduct(product.getId(),product.getMerchantStore().getCode()));
+  for(ProductPriceTier t:tiers)t.setProduct(product);
+  return repository.saveAll(tiers);
+ }
+ private void validate(List<ProductPriceTier> tiers)throws ServiceException{
+  if(tiers==null||tiers.size()>10)throw new ServiceException("Invalid price tiers");
+  Set<Integer> seen=new HashSet<Integer>(); BigDecimal previous=null;
+  for(ProductPriceTier t:tiers){
+   if(t==null||t.getMinQuantity()==null||t.getMinQuantity()<2||t.getPrice()==null||t.getPrice().compareTo(BigDecimal.ZERO)<=0||!seen.add(t.getMinQuantity())) throw new ServiceException("Invalid price tiers");
+   if(previous!=null&&t.getPrice().compareTo(previous)>=0)throw new ServiceException("Tier prices must decrease");
+   previous=t.getPrice();
+  }
+ }
+}
