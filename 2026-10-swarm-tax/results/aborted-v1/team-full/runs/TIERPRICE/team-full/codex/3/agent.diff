+package com.salesmanager.shop.store.api.v1.product;
+import java.util.*;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.price.ProductPriceTierService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.price.ProductPriceTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.PersistableProductPriceTier;
+import com.salesmanager.shop.model.catalog.product.ReadableProductPriceTier;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import springfox.documentation.annotations.ApiIgnore;
+@RestController
+@RequestMapping("/api/v1/private/product/{productId}/tiers")
+public class ProductPriceTierApi {
+ @Autowired private ProductService productService; @Autowired private ProductPriceTierService tierService;
+ @GetMapping public List<ReadableProductPriceTier> get(@PathVariable Long productId,@ApiIgnore MerchantStore store){
+  Product p=productService.findOne(productId,store); if(p==null)throw new ResourceNotFoundException("Product not found");
+  List<ReadableProductPriceTier> out=new ArrayList<>(); for(ProductPriceTier t:tierService.findByProduct(productId,store))out.add(new ReadableProductPriceTier(t.getMinQuantity(),t.getPrice())); return out;
+ }
+ @PutMapping @ResponseStatus(HttpStatus.OK)
+ public List<ReadableProductPriceTier> put(@PathVariable Long productId,@RequestBody List<PersistableProductPriceTier> input,@ApiIgnore MerchantStore store){
+  Product p=productService.findOne(productId,store); if(p==null)throw new ResourceNotFoundException("Product not found");
+  List<ProductPriceTier> tiers=new ArrayList<>(); if(input!=null)for(PersistableProductPriceTier x:input){ProductPriceTier t=new ProductPriceTier(); t.setMinQuantity(x==null?null:x.getMinQuantity()); t.setPrice(x==null?null:x.getPrice()); tiers.add(t);}
+  try { tierService.replace(p,tiers); } catch(Exception e){ throw new ServiceRuntimeException("400",e.getMessage()); }
+  return get(productId,store);
+ }
+}
