+package com.salesmanager.core.business.services.catalog.product;
+
+import java.util.List;
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.ProductPriceTierRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductPriceTier;
+
+@Service("productPriceTierService")
+public class ProductPriceTierServiceImpl implements ProductPriceTierService {
+    private final ProductPriceTierRepository repository;
+    @Inject public ProductPriceTierServiceImpl(ProductPriceTierRepository repository) { this.repository = repository; }
+    public List<ProductPriceTier> findByProductId(Long productId) { return repository.findByProductId(productId); }
+    @Transactional
+    public void replace(Long productId, List<ProductPriceTier> tiers) {
+        repository.deleteByProductId(productId);
+        Product product = new Product(); product.setId(productId);
+        for (ProductPriceTier tier : tiers) tier.setProduct(product);
+        repository.saveAll(tiers);
+    }
+}
