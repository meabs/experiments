+package com.salesmanager.shop.store.api.v1.product;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import javax.inject.Inject;
+
+import org.springframework.http.MediaType;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.product.ProductPriceTierService;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductPriceTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductPriceTierEntity;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Admin quantity-break prices. */
+@RestController
+@RequestMapping("/api/v1")
+public class ProductPriceTierApi {
+    @Inject private ProductService productService;
+    @Inject private ProductPriceTierService tierService;
+
+    @GetMapping(value = "/private/product/{id}/tiers", produces = MediaType.APPLICATION_JSON_VALUE)
+    public List<ProductPriceTierEntity> get(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        verifyProduct(id, store);
+        return toDto(tierService.findByProductId(id));
+    }
+
+    @PutMapping(value = "/private/product/{id}/tiers", produces = MediaType.APPLICATION_JSON_VALUE)
+    public List<ProductPriceTierEntity> replace(@PathVariable Long id, @RequestBody List<ProductPriceTierEntity> body,
+            @ApiIgnore MerchantStore store) {
+        verifyProduct(id, store);
+        if (body == null || body.size() > 10) throw bad("At most 10 price tiers are allowed");
+        for (ProductPriceTierEntity dto : body) {
+            if (dto == null) throw bad("Invalid price tier");
+        }
+        List<ProductPriceTierEntity> sorted = new ArrayList<ProductPriceTierEntity>(body);
+        sorted.sort(Comparator.comparing(ProductPriceTierEntity::getMinQuantity, Comparator.nullsFirst(Integer::compareTo)));
+        Set<Integer> quantities = new HashSet<Integer>();
+        BigDecimal previous = null;
+        List<ProductPriceTier> tiers = new ArrayList<ProductPriceTier>();
+        for (ProductPriceTierEntity dto : sorted) {
+            if (dto == null || dto.getMinQuantity() == null || dto.getMinQuantity() < 2 ||
+                    dto.getPrice() == null || dto.getPrice().compareTo(BigDecimal.ZERO) <= 0 ||
+                    !quantities.add(dto.getMinQuantity())) throw bad("Invalid price tier");
+            if (previous != null && dto.getPrice().compareTo(previous) >= 0)
+                throw bad("Prices must strictly decrease as quantity increases");
+            previous = dto.getPrice();
+            ProductPriceTier tier = new ProductPriceTier();
+            tier.setMinQuantity(dto.getMinQuantity()); tier.setPrice(dto.getPrice()); tiers.add(tier);
+        }
+        tierService.replace(id, tiers);
+        return toDto(tiers);
+    }
+
+    private Product verifyProduct(Long id, MerchantStore store) {
+        Product product = productService.findOne(id, store);
+        if (product == null) throw new ResourceNotFoundException("Product not found");
+        return product;
+    }
+    private RestApiException bad(String message) { return new RestApiException("400", message); }
+    private List<ProductPriceTierEntity> toDto(List<ProductPriceTier> tiers) {
+        List<ProductPriceTierEntity> result = new ArrayList<ProductPriceTierEntity>();
+        for (ProductPriceTier tier : tiers) {
+            ProductPriceTierEntity dto = new ProductPriceTierEntity(); dto.setMinQuantity(tier.getMinQuantity()); dto.setPrice(tier.getPrice()); result.add(dto);
+        }
+        return result;
+    }
+}
