+	/** Apply the best quantity break to each line before totals, taxes and promotions are calculated. */
+	private void applyQuantityTierPrices(final ShoppingCart cartModel) throws ServiceException {
+		if (cartModel.getLineItems() == null) return;
+		for (ShoppingCartItem item : cartModel.getLineItems()) {
+			if (item.getProduct() == null || item.getQuantity() == null) continue;
+			// Rebuild the effective catalogue price each time: this prevents a prior
+			// quantity break from becoming the baseline when quantity is reduced.
+			List<ProductAttribute> attributes = new ArrayList<>();
+			if (item.getAttributes() != null) {
+				for (com.salesmanager.core.model.shoppingcart.ShoppingCartAttributeItem a : item.getAttributes()) {
+					if (a.getProductAttribute() != null) attributes.add(a.getProductAttribute());
+				}
+			}
+			FinalPrice effective = pricingService.calculateProductPrice(item.getProduct(), attributes);
+			if (effective == null || effective.getFinalPrice() == null) continue;
+			item.setFinalPrice(effective);
+			BigDecimal unitPrice = effective.getFinalPrice();
+			List<ProductPriceTier> tiers;
+			if (item.getProduct().getId() == null) {
+				tiers = new ArrayList<>(item.getProduct().getPriceTiers());
+			} else {
+				tiers = productPriceTierService.findByProductId(item.getProduct().getId());
+			}
+			if (tiers == null) tiers = new ArrayList<>();
+			for (ProductPriceTier tier : tiers) {
+				if (tier.getMinQuantity() != null && tier.getPrice() != null
+						&& tier.getMinQuantity() <= item.getQuantity()
+						&& tier.getPrice().compareTo(unitPrice) < 0) {
+					unitPrice = tier.getPrice();
+				}
+			}
+			item.setItemPrice(unitPrice);
+			item.setSubTotal(unitPrice.multiply(BigDecimal.valueOf(item.getQuantity())));
+		}
+	}
+
 }
