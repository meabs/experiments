+@Entity
+@Table(name = "CUSTOMER_WISHLIST_ITEM", uniqueConstraints = @UniqueConstraint(columnNames = {"CUSTOMER_ID", "PRODUCT_ID"}), indexes = @Index(name = "WISHLIST_CUSTOMER_IDX", columnList = "CUSTOMER_ID"))
+public class CustomerWishlistItem extends SalesManagerEntity<Long, CustomerWishlistItem> {
+    private static final long serialVersionUID = 1L;
+    @Id @GeneratedValue(strategy = GenerationType.TABLE, generator = "TABLE_GEN")
+    @TableGenerator(name = "TABLE_GEN", table = "SM_SEQUENCER", pkColumnName = "SEQ_NAME", valueColumnName = "SEQ_COUNT", pkColumnValue = "CUSTOMER_WISHLIST_SEQ_NEXT_VAL")
+    @Column(name = "WISHLIST_ITEM_ID") private Long id;
+    @JsonIgnore @ManyToOne(fetch = FetchType.LAZY, optional = false) @JoinColumn(name = "CUSTOMER_ID") private Customer customer;
+    @ManyToOne(fetch = FetchType.LAZY, optional = false) @JoinColumn(name = "PRODUCT_ID") private Product product;
+    @Temporal(TemporalType.TIMESTAMP) @Column(name = "ADDED_AT", nullable = false) private Date addedAt = new Date();
+    public Long getId() { return id; } public void setId(Long id) { this.id = id; }
+    public Customer getCustomer() { return customer; } public void setCustomer(Customer c) { customer = c; }
+    public Product getProduct() { return product; } public void setProduct(Product p) { product = p; }
+    public Date getAddedAt() { return addedAt == null ? null : new Date(addedAt.getTime()); }
+    public void setAddedAt(Date d) { addedAt = d == null ? null : new Date(d.getTime()); }
+}
