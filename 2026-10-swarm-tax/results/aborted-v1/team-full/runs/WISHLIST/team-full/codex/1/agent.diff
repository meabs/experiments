+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.UnauthorizedException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/auth/customer/wishlist")
+public class CustomerWishlistApi {
+ @Inject private CustomerWishlistService wishlistService; @Inject private ProductService productService; @Inject private ProductAvailabilityService availabilityService; @Inject private CustomerFacade customerFacade; @Inject private CustomerService customerService; @Inject private ShoppingCartFacade shoppingCartFacade; @Inject private ShoppingCartService shoppingCartService;
+ private Customer customer(Principal p, MerchantStore store){ if(p==null) throw new UnauthorizedException(); Customer c=customerFacade.getCustomerByUserName(p.getName(),store); if(c==null) throw new ResourceNotFoundException("Customer not found"); return c; }
+ private Product product(String sku,MerchantStore store){ try { Product p=productService.getBySku(sku,store); if(p==null) throw new ResourceNotFoundException("Product not found"); return p; } catch(Exception e){ if(e instanceof ResourceNotFoundException) throw (ResourceNotFoundException)e; throw new ResourceNotFoundException("Product not found"); } }
+ private ReadableWishlistItem dto(CustomerWishlistItem i, MerchantStore store){ Product p=i.getProduct(); String name=p.getDescriptions()!=null&&!p.getDescriptions().isEmpty()?p.getDescriptions().iterator().next().getName():p.getSku(); BigDecimal price=null; boolean stock=false; try { for(com.salesmanager.core.model.catalog.product.availability.ProductAvailability a: availabilityService.getBySku(p.getSku(),store)){ stock |= a.getProductQuantity()!=null && a.getProductQuantity()>0; for(com.salesmanager.core.model.catalog.product.price.ProductPrice pp:a.getPrices()) if(pp.isDefaultPrice()){ price=pp.getProductPriceSpecialAmount()!=null?pp.getProductPriceSpecialAmount():pp.getProductPriceAmount(); break; } } } catch(Exception ignored) {} return new ReadableWishlistItem(p.getSku(),name,price,p.isAvailable()&&stock,i.getAddedAt()); }
+ @GetMapping public ReadableWishlist list(Principal principal,@ApiIgnore MerchantStore store){ List<ReadableWishlistItem> items=wishlistService.list(customer(principal,store)).stream().map(i->dto(i,store)).collect(Collectors.toList()); return new ReadableWishlist(items); }
+ public static class WishlistRequest { private String product; public String getProduct(){return product;} public void setProduct(String p){product=p;} }
+ @PostMapping public ResponseEntity<ReadableWishlist> add(@RequestBody WishlistRequest request,Principal principal,@ApiIgnore MerchantStore store){ return addSku(request==null?null:request.getProduct(),principal,store); }
+ @PostMapping("/{sku}") public ResponseEntity<ReadableWishlist> addSku(@PathVariable String sku,Principal principal,@ApiIgnore MerchantStore store){ Customer c=customer(principal,store); Product p=product(sku,store); boolean existed=wishlistService.find(c,p).isPresent(); if(!available(p,store)) return ResponseEntity.status(HttpStatus.CONFLICT).build(); try { wishlistService.add(c,p); List<ReadableWishlistItem> all=wishlistService.list(c).stream().map(i->dto(i,store)).collect(Collectors.toList()); return ResponseEntity.status(existed?HttpStatus.OK:HttpStatus.CREATED).body(new ReadableWishlist(all)); } catch(IllegalStateException e){ return ResponseEntity.badRequest().build(); } }
+ private boolean available(Product p, MerchantStore store){ if(!p.isAvailable()) return false; try { return availabilityService.getBySku(p.getSku(),store).stream().anyMatch(a->a.getProductQuantity()!=null&&a.getProductQuantity()>0); } catch(Exception e){ return false; } }
+ @DeleteMapping("/{sku}") public ResponseEntity<Void> remove(@PathVariable String sku,Principal principal,@ApiIgnore MerchantStore store){ wishlistService.remove(customer(principal,store),product(sku,store)); return ResponseEntity.noContent().build(); }
+ @PostMapping("/{sku}/cart/{cartCode}") public ResponseEntity<?> move(@PathVariable String sku,@PathVariable String cartCode,Principal principal,@ApiIgnore MerchantStore store,@ApiIgnore Language language){ Customer c=customer(principal,store); Product p=product(sku,store); if(!available(p,store)) return ResponseEntity.status(HttpStatus.CONFLICT).build(); try { com.salesmanager.core.model.shoppingcart.ShoppingCart cart=shoppingCartService.getByCode(cartCode,store); if(cart==null || !c.getId().equals(cart.getCustomerId())) return ResponseEntity.status(HttpStatus.NOT_FOUND).build(); PersistableShoppingCartItem item=new PersistableShoppingCartItem(); item.setProduct(sku); item.setQuantity(1); ResponseEntity<?> response=ResponseEntity.ok(shoppingCartFacade.modifyCart(cartCode,item,store,language)); wishlistService.remove(c,p); return response; } catch(com.salesmanager.core.business.exception.ServiceException e){ return ResponseEntity.status(HttpStatus.NOT_FOUND).build(); } catch(Exception e){ return ResponseEntity.status(HttpStatus.BAD_REQUEST).build(); } }
+}
