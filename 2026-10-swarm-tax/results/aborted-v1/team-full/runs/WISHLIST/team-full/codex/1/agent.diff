+package com.salesmanager.core.business.services.customer.wishlist;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.data.domain.Pageable;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.customer.wishlist.CustomerWishlistRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.wishlist.CustomerWishlistItem;
+@Service("customerWishlistService")
+public class CustomerWishlistServiceImpl implements CustomerWishlistService {
+ private static final int MAX_ITEMS = 50;
+ @Inject private CustomerWishlistRepository repository;
+ public List<CustomerWishlistItem> list(Customer c) { return repository.findByCustomerIdOrderByAddedAtDesc(c.getId()); }
+ public Optional<CustomerWishlistItem> find(Customer c, Product p) { return repository.findByCustomerIdAndProductId(c.getId(), p.getId()); }
+ public CustomerWishlistItem add(Customer c, Product p) {
+   Optional<CustomerWishlistItem> existing = find(c,p); if(existing.isPresent()) return existing.get();
+   if(repository.countByCustomerId(c.getId()) >= MAX_ITEMS) throw new IllegalStateException("Wishlist is full");
+   CustomerWishlistItem i = new CustomerWishlistItem(); i.setCustomer(c); i.setProduct(p); i.setAddedAt(new Date()); return repository.save(i);
+ }
+ public void remove(Customer c, Product p) { repository.deleteByCustomerIdAndProductId(c.getId(), p.getId()); }
+ public void removeProduct(Product p) { repository.deleteByProductId(p.getId()); }
+ public List<Object[]> popular(Integer storeId, Pageable pageable) { return repository.findPopularByStore(storeId, pageable); }
+}
