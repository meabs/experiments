+package com.salesmanager.shop.store.api.v1.wishlist;
+
+import java.security.Principal;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import javax.validation.Valid;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.business.services.customer.WishlistService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.Wishlist;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.model.wishlist.PersistableWishlist;
+import com.salesmanager.shop.model.wishlist.ReadableWishlist;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.api.exception.UnauthorizedException;
+import com.salesmanager.shop.store.api.exception.ConflictException;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+import com.salesmanager.shop.store.controller.user.facade.UserFacade;
+import io.swagger.annotations.Api;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Customer wishlist and administrator popularity endpoints. */
+@RestController
+@RequestMapping("/api/v1")
+@Api(tags = { "Wishlist api" })
+public class WishlistApi {
+    @Inject private WishlistService wishlistService;
+    @Inject private CustomerService customerService;
+    @Inject private ProductService productService;
+    @Inject private ShoppingCartFacade shoppingCartFacade;
+    @Inject private UserFacade userFacade;
+
+    @PostMapping("/auth/customer/wishlist")
+    @ResponseStatus(HttpStatus.CREATED)
+    public ReadableWishlist add(@Valid @RequestBody PersistableWishlist request,
+            @ApiIgnore MerchantStore store, HttpServletRequest servletRequest) {
+        Customer customer = customer(servletRequest, store);
+        Product product = product(request == null ? null : request.getProductId(), store);
+        if (wishlistService.list(customer, store).stream().anyMatch(w -> w.getProduct() != null && product.getId().equals(w.getProduct().getId())))
+            throw new ConflictException("Product is already in the wishlist");
+        try { return read(wishlistService.add(customer, product, store)); }
+        catch (ServiceException e) { throw new RestApiException("400", e.getMessage(), e); }
+    }
+
+    @GetMapping("/auth/customer/wishlist")
+    public List<ReadableWishlist> list(@ApiIgnore MerchantStore store, HttpServletRequest request) {
+        Customer customer = customer(request, store);
+        return wishlistService.list(customer, store).stream().map(this::read).collect(Collectors.toList());
+    }
+
+    @DeleteMapping("/auth/customer/wishlist/{productId}")
+    @ResponseStatus(HttpStatus.NO_CONTENT)
+    public void remove(@PathVariable Long productId, @ApiIgnore MerchantStore store, HttpServletRequest request) {
+        Customer customer = customer(request, store);
+        Product product = product(productId, store);
+        try { wishlistService.remove(customer, product); }
+        catch (ServiceException e) { throw new RestApiException("400", e.getMessage(), e); }
+    }
+
+    @PostMapping("/auth/customer/wishlist/{sku}/cart/{cartCode}")
+    public ReadableShoppingCart moveToCart(@PathVariable String sku, @PathVariable String cartCode,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest request) {
+        Customer customer = customer(request, store);
+        Product product = productBySku(sku, store);
+        boolean inWishlist = wishlistService.list(customer, store).stream()
+                .anyMatch(w -> w.getProduct() != null && product.getId().equals(w.getProduct().getId()));
+        if (!inWishlist) {
+            throw new ResourceNotFoundException("Product [" + sku + "] is not in the wishlist");
+        }
+        PersistableShoppingCartItem cartItem = new PersistableShoppingCartItem();
+        cartItem.setProduct(product.getSku());
+        cartItem.setQuantity(1);
+        try {
+            ReadableShoppingCart cart = shoppingCartFacade.modifyCart(cartCode, cartItem, store, language);
+            wishlistService.remove(customer, product);
+            return cart;
+        } catch (ResourceNotFoundException e) {
+            throw e;
+        } catch (Exception e) {
+            // Cart availability (out of stock, date unavailable, etc.) is a
+            // conflict with the requested move, rather than malformed input.
+            throw new ConflictException(e.getMessage() == null ? "Product cannot be added to cart" : e.getMessage());
+        }
+    }
+
+    @GetMapping("/private/wishlists/popular")
+    public Map<Long, Long> popular(@ApiIgnore MerchantStore store, HttpServletRequest request) {
+        String username = request.getUserPrincipal() == null ? null : request.getUserPrincipal().getName();
+        if (username == null) throw new UnauthorizedException();
+        userFacade.authorizedGroup(username, java.util.Arrays.asList(Constants.GROUP_SUPERADMIN, Constants.GROUP_ADMIN, Constants.GROUP_ADMIN_RETAIL));
+        return wishlistService.popularity(store);
+    }
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal principal = request == null ? null : request.getUserPrincipal();
+        if (principal == null) throw new UnauthorizedException();
+        Customer customer = customerService.getByNick(principal.getName());
+        if (customer == null || customer.getMerchantStore() == null || store == null || !store.getId().equals(customer.getMerchantStore().getId()))
+            throw new ResourceNotFoundException("Customer not found");
+        return customer;
+    }
+    private Product product(Long id, MerchantStore store) {
+        if (id == null) throw new RestApiException("400", "productId is required");
+        Product product = productService.findOne(id, store);
+        if (product == null) throw new ResourceNotFoundException("Product [" + id + "] not found");
+        return product;
+    }
+    private Product productBySku(String sku, MerchantStore store) {
+        if (sku == null || sku.trim().isEmpty()) throw new RestApiException("400", "sku is required");
+        try {
+            Product product = productService.getBySku(sku, store);
+            if (product == null) throw new ResourceNotFoundException("Product [" + sku + "] not found");
+            return product;
+        } catch (ResourceNotFoundException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new ResourceNotFoundException("Product [" + sku + "] not found");
+        }
+    }
+    private ReadableWishlist read(Wishlist item) {
+        ReadableWishlist result = new ReadableWishlist();
+        result.setId(item.getId()); result.setAddedAt(item.getAddedAt());
+        if (item.getProduct() != null) result.setProductId(item.getProduct().getId());
+        return result;
+    }
+}
