+package com.salesmanager.core.business.services.customer;
+
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import javax.inject.Inject;
+import org.springframework.dao.DataIntegrityViolationException;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.customer.WishlistRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.Wishlist;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("wishlistService")
+public class WishlistServiceImpl implements WishlistService {
+    private static final int MAX_ITEMS = 50;
+    private final WishlistRepository repository;
+
+    @Inject public WishlistServiceImpl(WishlistRepository repository) { this.repository = repository; }
+
+    @Override @Transactional
+    public Wishlist add(Customer customer, Product product) throws ServiceException {
+        return add(customer, product, customer == null ? null : customer.getMerchantStore());
+    }
+
+    @Override @Transactional
+    public Wishlist add(Customer customer, Product product, MerchantStore store) throws ServiceException {
+        if (customer == null || product == null || store == null || customer.getId() == null || product.getId() == null)
+            throw new ServiceException("Customer, product and store are required");
+        if (customer.getMerchantStore() == null || product.getMerchantStore() == null ||
+            !store.getId().equals(customer.getMerchantStore().getId()) || !store.getId().equals(product.getMerchantStore().getId()))
+            throw new ServiceException("Customer and product must belong to the store");
+        Wishlist existing = repository.findByCustomerIdAndProductId(customer.getId(), product.getId());
+        if (existing != null) return existing;
+        if (repository.findByCustomerIdAndProductMerchantStoreIdOrderByAddedAtDesc(customer.getId(), store.getId()).size() >= MAX_ITEMS)
+            throw new ServiceException("Wishlist cannot contain more than " + MAX_ITEMS + " products");
+        Wishlist wishlist = new Wishlist(); wishlist.setCustomer(customer); wishlist.setProduct(product);
+        try { return repository.save(wishlist); }
+        catch (DataIntegrityViolationException e) { // concurrent duplicate insert: preserve idempotent semantics
+            Wishlist concurrent = repository.findByCustomerIdAndProductId(customer.getId(), product.getId());
+            if (concurrent != null) return concurrent;
+            throw e;
+        }
+    }
+
+    @Override public List<Wishlist> list(Customer customer, MerchantStore store) {
+        if (customer == null || customer.getId() == null || store == null) return java.util.Collections.emptyList();
+        return repository.findByCustomerIdAndProductMerchantStoreIdOrderByAddedAtDesc(customer.getId(), store.getId());
+    }
+    @Override @Transactional public void remove(Customer customer, Product product) throws ServiceException {
+        if (customer != null && product != null) { Wishlist w = repository.findByCustomerIdAndProductId(customer.getId(), product.getId()); if (w != null) repository.delete(w); }
+    }
+    @Override @Transactional public void remove(Product product) throws ServiceException { if (product != null && product.getId() != null) repository.deleteByProductId(product.getId()); }
+    @Override public Map<Long, Long> popularity(MerchantStore store) {
+        Map<Long, Long> result = new LinkedHashMap<>();
+        if (store != null && store.getId() != null) for (Object[] row : repository.countByProductInStore(store.getId())) result.put((Long) row[0], ((Number) row[1]).longValue());
+        return result;
+    }
+}
