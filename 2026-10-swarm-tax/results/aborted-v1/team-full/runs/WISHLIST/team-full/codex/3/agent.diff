+package com.salesmanager.core.business.services.wishlist;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.wishlist.WishlistRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.wishlist.WishlistItem;
+@Service("wishlistService")
+public class WishlistServiceImpl extends SalesManagerEntityServiceImpl<Long,WishlistItem> implements WishlistService {
+ private final WishlistRepository repo;
+ @Inject public WishlistServiceImpl(WishlistRepository r){super(r);repo=r;}
+ private Integer sid(MerchantStore s){return s.getId().intValue();}
+ public List<WishlistItem> getItems(Customer c,MerchantStore s)throws ServiceException{return repo.findByCustomerIdAndMerchantStoreIdOrderByAddedAtDesc(c.getId(),sid(s));}
+ public List<WishlistItem> getItems(MerchantStore s)throws ServiceException{return repo.findByMerchantStoreId(sid(s));}
+ public WishlistItem get(Customer c,MerchantStore s,String sku)throws ServiceException{return repo.findByCustomerIdAndMerchantStoreIdAndSku(c.getId(),sid(s),sku);}
+ @Transactional public WishlistItem add(Customer c,MerchantStore s,String sku)throws ServiceException { WishlistItem old= get(c,s,sku); if(old!=null)return old; if(repo.countByCustomerIdAndMerchantStoreId(c.getId(),sid(s))>=50) throw new ServiceException("Wishlist limit reached"); WishlistItem i=new WishlistItem();i.setCustomer(c);i.setMerchantStore(s);i.setSku(sku);return repo.save(i); }
+ @Transactional public void remove(Customer c,MerchantStore s,String sku)throws ServiceException {repo.deleteByCustomerIdAndMerchantStoreIdAndSku(c.getId(),sid(s),sku);}
+ @Transactional public void remove(MerchantStore s,String sku)throws ServiceException {repo.deleteByMerchantStoreIdAndSku(sid(s),sku);}
+ @Transactional public void removeProduct(MerchantStore s,Long productId,String sku)throws ServiceException {repo.deleteForProduct(sid(s),productId,sku);}
+}
