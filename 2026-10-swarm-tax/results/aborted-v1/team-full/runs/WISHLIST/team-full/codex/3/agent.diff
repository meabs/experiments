+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.OperationNotAllowedException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/auth/customer/wishlist")
+public class CustomerWishlistApi {
+ @Inject private WishlistService wishlistService; @Inject private CustomerService customerService; @Inject private ProductService productService;
+ @Inject private PricingService pricingService; @Inject private ShoppingCartService cartService; @Inject private ShoppingCartFacade cartFacade;
+ private Customer customer(HttpServletRequest r){Principal p=r.getUserPrincipal(); if(p==null) throw new OperationNotAllowedException("Authentication required"); Customer c=customerService.getByNick(p.getName()); if(c==null) throw new ResourceNotFoundException("Customer not found"); return c;}
+ @PostMapping public ResponseEntity<WishlistData> add(@RequestBody Map<String,String> body,@ApiIgnore MerchantStore store,@ApiIgnore Language language,HttpServletRequest req){Customer c=customer(req); String sku=body.get("sku"); if(sku==null||sku.trim().isEmpty()) return ResponseEntity.badRequest().build(); Product p=find(sku,store); if(p==null) throw new ResourceNotFoundException("Product not found"); try { if(wishlistService.get(c,store,sku)!=null)return ResponseEntity.status(HttpStatus.CONFLICT).body(data(c,store,language)); wishlistService.add(c,store,sku); return ResponseEntity.status(HttpStatus.CREATED).body(data(c,store,language)); }catch(Exception e){if(e.getMessage()!=null&&e.getMessage().contains("limit"))return ResponseEntity.status(HttpStatus.CONFLICT).build(); throw new RuntimeException(e);} }
+ @GetMapping public WishlistData get(@ApiIgnore MerchantStore store,@ApiIgnore Language language,HttpServletRequest req){return data(customer(req),store,language);}
+ @DeleteMapping("/{sku}") @ResponseStatus(HttpStatus.NO_CONTENT) public void remove(@PathVariable String sku,@ApiIgnore MerchantStore store,HttpServletRequest req){try{wishlistService.remove(customer(req),store,sku);}catch(ServiceRuntimeException e){throw e;}catch(Exception e){throw new ServiceRuntimeException("Unable to remove wishlist item",e);}}
+ @PostMapping("/{sku}/cart/{cartCode}") public ResponseEntity<?> move(@PathVariable String sku,@PathVariable String cartCode,@ApiIgnore MerchantStore store,@ApiIgnore Language language,HttpServletRequest req){Customer c=customer(req); Product p=find(sku,store); if(p==null)throw new ResourceNotFoundException("Product not found"); if(!p.isAvailable()||!inStock(p))return ResponseEntity.status(HttpStatus.CONFLICT).build(); try {ShoppingCart cart=cartService.getByCode(cartCode,store); if(cart==null||!Objects.equals(cart.getCustomerId(),c.getId()))throw new ResourceNotFoundException("Cart not found"); PersistableShoppingCartItem i=new PersistableShoppingCartItem();i.setProduct(sku);i.setQuantity(1); cartFacade.modifyCart(cartCode,i,store,language); wishlistService.remove(c,store,sku); return ResponseEntity.ok(data(c,store,language));}catch(ResourceNotFoundException e){throw e;}catch(Exception e){throw new RuntimeException(e);}}
+ private Product find(String sku,MerchantStore s){try{return productService.getBySku(sku,s);}catch(Exception e){return null;}}
+ private boolean inStock(Product p){if(p.getAvailabilities()==null||p.getAvailabilities().isEmpty())return true; for(ProductAvailability a:p.getAvailabilities())if(a.getProductStatus()&&a.getProductQuantity()!=null&&a.getProductQuantity()>0)return true; return false;}
+ private WishlistData data(Customer c,MerchantStore s,Language l){WishlistData d=new WishlistData();try{for(com.salesmanager.core.model.wishlist.WishlistItem w:wishlistService.getItems(c,s)){Product p=find(w.getSku(),s);if(p==null)continue;WishlistItemData x=new WishlistItemData();x.setSku(w.getSku());x.setAddedAt(w.getAddedAt());x.setAvailable(p.isAvailable()&&inStock(p));if(p.getProductDescription()!=null)x.setName(p.getProductDescription().getName());try{x.setPrice(pricingService.calculateProductPrice(p,c).getFinalPrice());}catch(Exception ignored){}d.getItems().add(x);}d.setCount(d.getItems().size());return d;}catch(Exception e){throw new RuntimeException(e);}}
+}
