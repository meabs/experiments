+package com.salesmanager.core.business.repositories.wishlist;
+import java.util.List;
+import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Modifying;
+import org.springframework.data.jpa.repository.Query;
+import org.springframework.data.repository.query.Param;
+import com.salesmanager.core.model.wishlist.WishlistItem;
+public interface WishlistRepository extends JpaRepository<WishlistItem,Long> {
+ List<WishlistItem> findByCustomerIdAndMerchantStoreIdOrderByAddedAtDesc(Long customerId, Integer storeId);
+ List<WishlistItem> findByMerchantStoreId(Integer storeId);
+ WishlistItem findByCustomerIdAndMerchantStoreIdAndSku(Long customerId,Integer storeId,String sku);
+ void deleteByCustomerIdAndMerchantStoreIdAndSku(Long customerId,Integer storeId,String sku);
+ void deleteByMerchantStoreIdAndSku(Integer storeId, String sku);
+ @Modifying
+ @Query("delete from WishlistItem w where w.merchantStore.id = :storeId and (w.sku = :sku or w.sku in (select v.sku from ProductVariant v where v.product.id = :productId))")
+ void deleteForProduct(@Param("storeId") Integer storeId, @Param("productId") Long productId, @Param("sku") String sku);
+ long countByCustomerIdAndMerchantStoreId(Long customerId,Integer storeId);
+}
