+package com.salesmanager.shop.store.api.v1.wishlist;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+
+import org.springframework.http.MediaType;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.wishlist.WishlistService;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.wishlist.WishlistItem;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Administration reporting endpoints for customer wishlists. */
+@RestController
+@RequestMapping("/api/v1")
+public class WishlistAdministrationApi {
+
+    @Inject
+    private WishlistService wishlistService;
+
+    @GetMapping(value = "/private/wishlists/popular", produces = MediaType.APPLICATION_JSON_VALUE)
+    @ApiImplicitParams(@ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT"))
+    public List<PopularWishlistItem> popular(@ApiIgnore MerchantStore merchantStore) {
+        try {
+            List<WishlistItem> items = wishlistService.getItems(merchantStore);
+            Map<String, Set<Long>> customersBySku = items.stream().collect(Collectors.groupingBy(
+                    WishlistItem::getSku,
+                    Collectors.mapping(item -> customerId(item.getCustomer()),
+                            Collectors.toCollection(HashSet::new))));
+            return customersBySku.entrySet().stream()
+                    .map(entry -> new PopularWishlistItem(entry.getKey(), entry.getValue().size()))
+                    .sorted(Comparator.comparingInt(PopularWishlistItem::getCount).reversed()
+                            .thenComparing(PopularWishlistItem::getSku))
+                    .limit(10)
+                    .collect(Collectors.toCollection(ArrayList::new));
+        } catch (ServiceException e) {
+            throw new ServiceRuntimeException("Unable to load popular wishlists", e);
+        }
+    }
+
+    private static Long customerId(Customer customer) {
+        return customer == null ? null : customer.getId();
+    }
+
+    public static class PopularWishlistItem {
+        private final String sku;
+        private final int count;
+
+        public PopularWishlistItem(String sku, int count) {
+            this.sku = sku;
+            this.count = count;
+        }
+
+        public String getSku() { return sku; }
+        public int getCount() { return count; }
+    }
+}
