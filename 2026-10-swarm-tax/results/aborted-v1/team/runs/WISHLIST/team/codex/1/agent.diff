+package com.salesmanager.core.business.services.customer;
+
+import java.util.List;
+import java.util.Optional;
+
+import javax.inject.Inject;
+
+import org.springframework.data.domain.PageRequest;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.customer.WishlistRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.WishlistItem;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("wishlistService")
+public class WishlistServiceImpl implements WishlistService {
+    private static final int MAX_ITEMS = 50;
+    @Inject private WishlistRepository repository;
+
+    @Override @Transactional
+    public WishlistItem add(Customer customer, Product product, MerchantStore store) throws ServiceException {
+        if (customer == null || product == null || store == null || customer.getMerchantStore() == null
+                || product.getMerchantStore() == null || !store.getId().equals(customer.getMerchantStore().getId())
+                || !store.getId().equals(product.getMerchantStore().getId()))
+            throw new ServiceException("Wishlist entities must belong to the requested store");
+        Optional<WishlistItem> existing = find(customer, product, store);
+        if (existing.isPresent()) return existing.get();
+        if (repository.countByCustomerIdAndMerchantStoreId(customer.getId(), store.getId()) >= MAX_ITEMS)
+            throw new ServiceException("Wishlist limit exceeded");
+        WishlistItem item = new WishlistItem();
+        item.setCustomer(customer); item.setProduct(product); item.setMerchantStore(store);
+        return repository.saveAndFlush(item);
+    }
+    @Override @Transactional
+    public void remove(Customer customer, Product product, MerchantStore store) throws ServiceException {
+        repository.deleteByCustomerIdAndProductIdAndMerchantStoreId(customer.getId(), product.getId(), store.getId());
+    }
+    public List<WishlistItem> list(Customer customer, MerchantStore store) { return repository.findByCustomerIdAndMerchantStoreIdOrderByAddedAtDesc(customer.getId(), store.getId()); }
+    public Optional<WishlistItem> find(Customer customer, Product product, MerchantStore store) { return repository.findByCustomerIdAndProductIdAndMerchantStoreId(customer.getId(), product.getId(), store.getId()); }
+    public List<Object[]> popular(MerchantStore store, int limit) { return repository.findPopular(store.getId(), PageRequest.of(0, Math.min(limit, 10))); }
+    @Override @Transactional
+    public void deleteByProduct(Product product) throws ServiceException { repository.deleteByProductId(product.getId()); }
+}
