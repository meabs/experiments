+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.security.Principal;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+import springfox.documentation.annotations.ApiIgnore;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.customer.WishlistService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.WishlistItem;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.customer.*;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+
+@RestController
+@RequestMapping("/api/v1")
+public class WishlistApi {
+ @Inject private WishlistService wishlistService; @Inject private ProductService productService; @Inject private CustomerFacade customerFacade; @Inject private ShoppingCartFacade shoppingCartFacade;
+ private Customer customer(Principal p, MerchantStore s){ return customerFacade.getCustomerByUserName(p.getName(),s); }
+ private ReadableWishlistItem item(WishlistItem w){ ReadableWishlistItem x=new ReadableWishlistItem(); Product p=w.getProduct(); x.setSku(p.getSku()); x.setName(p.getSku()); x.setAvailable(p.getAvailabilities()!=null&&!p.getAvailabilities().isEmpty()); x.setAddedAt(w.getAddedAt()); return x; }
+ @PostMapping("/auth/customer/wishlist") public ResponseEntity<ReadableWishlist> add(@RequestParam String sku,@ApiIgnore MerchantStore store,HttpServletRequest req){ try { Customer c=customer(req.getUserPrincipal(),store); Product p=productService.getBySku(sku,store); if(p==null)return new ResponseEntity<ReadableWishlist>(HttpStatus.NOT_FOUND); wishlistService.add(c,p,store); return new ResponseEntity<ReadableWishlist>(get(c,store),HttpStatus.CREATED);}catch(Exception e){return new ResponseEntity<ReadableWishlist>(HttpStatus.BAD_REQUEST);} }
+ @GetMapping("/auth/customer/wishlist") public ReadableWishlist get(@ApiIgnore MerchantStore store,HttpServletRequest req){return get(customer(req.getUserPrincipal(),store),store);}
+ private ReadableWishlist get(Customer c,MerchantStore s){ReadableWishlist r=new ReadableWishlist(); java.util.List<ReadableWishlistItem> l=new java.util.ArrayList<ReadableWishlistItem>(); for(WishlistItem w:wishlistService.list(c,s))l.add(item(w));r.setItems(l);r.setCount(l.size());return r;}
+ @DeleteMapping("/auth/customer/wishlist/{sku}") @ResponseStatus(HttpStatus.NO_CONTENT) public void remove(@PathVariable String sku,@ApiIgnore MerchantStore store,HttpServletRequest req)throws Exception{Product p=productService.getBySku(sku,store);if(p!=null)wishlistService.remove(customer(req.getUserPrincipal(),store),p,store);}
+ @PostMapping("/auth/customer/wishlist/{sku}/cart/{cartCode}") public ResponseEntity<?> move(@PathVariable String sku,@PathVariable String cartCode,@ApiIgnore MerchantStore store,@ApiIgnore Language lang)throws Exception { Product p=productService.getBySku(sku,store); if(p==null)return new ResponseEntity<Object>(HttpStatus.NOT_FOUND); PersistableShoppingCartItem i=new PersistableShoppingCartItem();i.setProduct(sku);i.setQuantity(1); Object cart=shoppingCartFacade.modifyCart(cartCode,i,store,lang); return new ResponseEntity<Object>(cart,HttpStatus.OK); }
+}
