+package com.salesmanager.shop.store.api.v1.shoppingCart;
+
+import javax.inject.Inject;
+import javax.validation.Valid;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.shoppingcart.PersistableCartRules;
+import com.salesmanager.shop.model.shoppingcart.PersistableProductCartLimit;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Private administration endpoints for cart limits. */
+@RestController
+@RequestMapping("/api/v1/private")
+public class CartLimitAdministrationApi {
+    @Inject private ProductService productService;
+    @Inject private MerchantStoreService merchantStoreService;
+
+    @PutMapping("/product/{id}/limits")
+    @ResponseStatus(HttpStatus.OK)
+    public PersistableProductCartLimit setProductLimit(@PathVariable Long id, @Valid @RequestBody PersistableProductCartLimit dto, @ApiIgnore MerchantStore store) throws Exception {
+        Product p = productService.retrieveById(id, store).orElseThrow(() -> new IllegalArgumentException("Product not found"));
+        if (p.getMerchantStore() == null || store == null || !p.getMerchantStore().getId().equals(store.getId())) throw new IllegalArgumentException("Product does not belong to store");
+        if ((dto.getMinPerCart()!=null&&dto.getMinPerCart()<1)||(dto.getMaxPerCart()!=null&&dto.getMaxPerCart()<1)||(dto.getPackSize()!=null&&dto.getPackSize()<1)) throw new IllegalArgumentException("limits must be >= 1");
+        if (dto.getMinPerCart()!=null&&dto.getMaxPerCart()!=null&&dto.getMinPerCart()>dto.getMaxPerCart()) throw new IllegalArgumentException("minPerCart cannot exceed maxPerCart");
+        p.setCartMinQuantity(dto.getMinPerCart()); p.setCartMaxQuantity(dto.getMaxPerCart()); p.setCartPackSize(dto.getPackSize()); productService.saveProduct(p); return dto;
+    }
+
+    @PutMapping("/cart-rules")
+    public PersistableCartRules setStoreRules(@Valid @RequestBody PersistableCartRules dto, @ApiIgnore MerchantStore store) throws Exception {
+        if ((dto.getMaxLines()!=null&&dto.getMaxLines()<1)||(dto.getMaxUnits()!=null&&dto.getMaxUnits()<1)) throw new IllegalArgumentException("caps must be >= 1");
+        store.setCartMaxLines(dto.getMaxLines()); store.setCartMaxUnits(dto.getMaxUnits()); merchantStoreService.saveOrUpdate(store); return dto;
+    }
+}
