@@ -0,0 +1,62 @@
+package com.salesmanager.shop.store.controller.shoppingCart;
+
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.shoppingcart.ShoppingCartService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.store.api.exception.CartLimitExceededException;
+
+/** Validates a proposed cart mutation before the facade writes anything. */
+@Service
+public class CartLimitValidationService {
+    @Inject private ShoppingCartService cartService;
+    @Inject private ProductService productService;
+
+    public void validate(String code, List<PersistableShoppingCartItem> changes, MerchantStore store, Language language) {
+        ShoppingCart cart;
+        try { cart = code == null ? null : cartService.getByCode(code, store); }
+        catch (Exception e) { cart = null; }
+        Map<Long,Integer> quantities = new HashMap<Long,Integer>();
+        if (cart != null && cart.getLineItems() != null) for (ShoppingCartItem i : cart.getLineItems())
+            quantities.put(i.getProductId(), i.getQuantity());
+        for (PersistableShoppingCartItem change : changes) {
+            Product p;
+            try { p = productService.getBySku(change.getProduct(), store, language); }
+            catch (Exception e) { p = null; }
+            if (p == null) continue; // facade emits the canonical not-found error
+            int q = Math.max(0, change.getQuantity());
+            if (q > 0 && p.getCartMinQuantity() != null && q < p.getCartMinQuantity())
+                throw new CartLimitExceededException("minPerCart: " + change.getProduct());
+            if (q > 0 && p.getCartMaxQuantity() != null && q > p.getCartMaxQuantity())
+                throw new CartLimitExceededException("maxPerCart: " + change.getProduct());
+            if (q > 0 && p.getCartPackSize() != null && q % p.getCartPackSize() != 0)
+                throw new CartLimitExceededException("packSize: " + change.getProduct());
+            if (q == 0) quantities.remove(p.getId()); else quantities.put(p.getId(), q);
+        }
+        if (store.getCartMaxItems() != null && store.getCartMaxItems() > 0) {
+            int total = 0; for (Integer q : quantities.values()) total += q;
+            if (total > store.getCartMaxItems()) throw new CartLimitExceededException("maxUnits");
+        }
+        if (store.getCartMaxLines() != null && store.getCartMaxLines() > 0 && quantities.size() > store.getCartMaxLines())
+            throw new CartLimitExceededException("maxLines");
+    }
+
+    public void decorate(ReadableShoppingCart cart, MerchantStore store) {
+        if (cart == null || store == null || store.getCartMaxItems() == null || store.getCartMaxItems() <= 0) return;
+        if (cart.getQuantity() >= store.getCartMaxItems()) cart.getLimitWarnings().add(new com.salesmanager.shop.model.shoppingcart.CartLimitWarning(null,"maxUnits"));
+    }
+}
