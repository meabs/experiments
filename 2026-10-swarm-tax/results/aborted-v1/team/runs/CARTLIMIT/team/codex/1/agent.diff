+package com.salesmanager.shop.store.api.v1.privateapi;
+
+import javax.inject.Inject;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.product.ProductLimits;
+import com.salesmanager.shop.model.store.CartRules;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+@RestController
+@RequestMapping("/api/v1/private")
+public class CartRulesApi {
+ @Inject private ProductService productService;
+ @Inject private MerchantStoreService storeService;
+ @PutMapping("/product/{id}/limits")
+ public ProductLimits put(@PathVariable Long id,@RequestParam String store,@RequestBody ProductLimits body) throws Exception {
+  MerchantStore s=storeService.getByCode(store); Product p=productService.getById(id);
+  if(s==null||p==null||p.getMerchantStore()==null||!p.getMerchantStore().getId().equals(s.getId())) throw new ResourceNotFoundException("Product not found");
+  if(body==null) throw new RestApiException("limits","Limits are required");
+  check(body.getMinPerCart(),"minPerCart"); check(body.getMaxPerCart(),"maxPerCart"); check(body.getPackSize(),"packSize");
+  if(body.getMinPerCart()!=null&&body.getMaxPerCart()!=null&&body.getMinPerCart()>body.getMaxPerCart()) throw new RestApiException("minPerCart","minPerCart must be <= maxPerCart");
+  if(body.getMaxPerCart()!=null&&body.getPackSize()!=null&&body.getMaxPerCart()<body.getPackSize()) throw new RestApiException("maxPerCart","maxPerCart must be >= packSize");
+  p.setMinPerCart(body.getMinPerCart()); p.setMaxPerCart(body.getMaxPerCart()); p.setPackSize(body.getPackSize()); productService.saveProduct(p); return body;
+ }
+ @GetMapping("/product/{id}/limits")
+ public ProductLimits get(@PathVariable Long id,@RequestParam String store) throws Exception { MerchantStore s=storeService.getByCode(store); Product p=productService.getById(id); if(s==null||p==null||p.getMerchantStore()==null||!p.getMerchantStore().getId().equals(s.getId())) throw new ResourceNotFoundException("Product not found"); return limits(p); }
+ @PutMapping("/cart-rules") public CartRules putRules(@RequestParam String store,@RequestBody CartRules b) throws Exception { MerchantStore s=storeService.getByCode(store); if(s==null) throw new ResourceNotFoundException("Store not found"); if(b==null) throw new RestApiException("cartRules","Rules are required"); check(b.getMaxLines(),"maxLines"); check(b.getMaxUnits(),"maxUnits"); s.setMaxLines(b.getMaxLines()); s.setMaxUnits(b.getMaxUnits()); storeService.saveOrUpdate(s); return b; }
+ @GetMapping("/cart-rules") public CartRules getRules(@RequestParam String store) throws Exception { MerchantStore s=storeService.getByCode(store); if(s==null) throw new ResourceNotFoundException("Store not found"); CartRules b=new CartRules(); b.setMaxLines(s.getMaxLines()); b.setMaxUnits(s.getMaxUnits()); return b; }
+ private static void check(Integer v,String n){if(v!=null&&v<=0) throw new RestApiException(n,n+" must be positive");}
+ private static ProductLimits limits(Product p){ProductLimits b=new ProductLimits();b.setMinPerCart(p.getMinPerCart());b.setMaxPerCart(p.getMaxPerCart());b.setPackSize(p.getPackSize());return b;}
+}
