+  @ManyToOne(fetch=FetchType.LAZY, optional=false) @JoinColumn(name="MERCHANT_STORE_ID", nullable=false) private com.salesmanager.core.model.merchant.MerchantStore merchantStore;
+  public Long getId(){return id;} public void setId(Long v){id=v;}
