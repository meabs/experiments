+package com.salesmanager.shop.store.api.v1.product;
+import java.security.Principal; import java.text.*; import java.util.*; import javax.inject.Inject; import javax.servlet.http.HttpServletRequest; import javax.validation.Valid;
+import org.springframework.http.*; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.catalog.product.question.*; import com.salesmanager.core.business.services.customer.CustomerService; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.question.*; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.catalog.product.*; import com.salesmanager.shop.store.api.exception.ResourceNotFoundException; import com.salesmanager.shop.store.api.exception.UnauthorizedException; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class ProductQuestionApi {
+ @Inject ProductQuestionService service; @Inject ProductService products; @Inject CustomerService customers;
+ private Product product(String sku,MerchantStore s){try{return products.getBySku(sku,s);}catch(Exception e){return null;}}
+ private ProductQuestionResponse dto(ProductQuestion q){ProductQuestionResponse r=new ProductQuestionResponse();r.setId(q.getId());r.setText(q.getText());r.setAnswer(q.getAnswer());r.setStatus(q.getStatus().name());r.setSku(q.getProduct().getSku());r.setCreatedAt(fmt(q.getCreatedAt()));r.setUpdatedAt(fmt(q.getUpdatedAt()));if(q.getCustomer()!=null&&q.getCustomer().getBilling()!=null)r.setCustomerFirstName(q.getCustomer().getBilling().getFirstName());return r;}
+ private String fmt(Date d){return d==null?null:new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSSXXX").format(d);}
+ private Customer customer(HttpServletRequest req, MerchantStore store){Principal p=req.getUserPrincipal();if(p==null)throw new UnauthorizedException();Customer c=customers.getByNick(p.getName(),store.getId());if(c==null)throw new UnauthorizedException();return c;}
+ @PostMapping("/auth/products/{sku}/questions") @ResponseStatus(HttpStatus.CREATED) public ProductQuestionResponse ask(@PathVariable String sku,@Valid @RequestBody ProductQuestionRequest in,@ApiIgnore MerchantStore store,HttpServletRequest req){Product p=product(sku,store);if(p==null)throw new ResourceNotFoundException("Product not found");try{return dto(service.ask(p,customer(req,store),store,in.getText()));}catch(com.salesmanager.core.business.exception.ServiceException e){throw new org.springframework.web.server.ResponseStatusException(HttpStatus.CONFLICT,e.getMessage(),e);}}
+ @GetMapping("/auth/customer/questions") public ProductQuestionList mine(@ApiIgnore MerchantStore store,HttpServletRequest req){ProductQuestionList out=new ProductQuestionList();for(ProductQuestion q:service.getByCustomer(customer(req,store)))if(q.getMerchantStore().getId().equals(store.getId()))out.add(dto(q));return out;}
+ @GetMapping("/products/{sku}/questions") public ProductQuestionList byProduct(@PathVariable String sku,@ApiIgnore MerchantStore store){Product p=product(sku,store);if(p==null)throw new ResourceNotFoundException("Product not found");ProductQuestionList out=new ProductQuestionList();for(ProductQuestion q:service.getByProduct(p,store))if(q.getStatus()!=ProductQuestionStatus.REJECTED)out.add(dto(q));return out;}
+ @GetMapping("/private/questions") public ProductQuestionList admin(@RequestParam(required=false) ProductQuestionStatus status,@ApiIgnore MerchantStore store){ProductQuestionList out=new ProductQuestionList();for(ProductQuestion q:service.getByStore(store,status))out.add(dto(q));return out;}
+ @PutMapping("/private/questions/{id}/answer") public ProductQuestionResponse answer(@PathVariable Long id,@RequestBody ProductQuestionRequest in,@ApiIgnore MerchantStore store){try{return dto(service.answer(id,store,in.getText()));}catch(com.salesmanager.core.business.exception.ServiceException e){if("Question not found".equals(e.getMessage()))throw new ResourceNotFoundException(e.getMessage());throw new org.springframework.web.server.ResponseStatusException(HttpStatus.CONFLICT,e.getMessage(),e);}}
+ @PutMapping("/private/questions/{id}/reject") public ProductQuestionResponse reject(@PathVariable Long id,@ApiIgnore MerchantStore store){try{return dto(service.reject(id,store));}catch(com.salesmanager.core.business.exception.ServiceException e){if("Question not found".equals(e.getMessage()))throw new ResourceNotFoundException(e.getMessage());throw new org.springframework.web.server.ResponseStatusException(HttpStatus.CONFLICT,e.getMessage(),e);}}
+}
