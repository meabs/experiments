+package com.salesmanager.core.business.services.catalog.product.question;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.*;
+import com.salesmanager.core.model.catalog.product.question.*;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long,ProductQuestion> implements ProductQuestionService {
+ private final ProductQuestionRepository repo;
+ @Inject public ProductQuestionServiceImpl(ProductQuestionRepository repo){super(repo);this.repo=repo;}
+ public ProductQuestion ask(Product p, Customer c, MerchantStore s, String text) throws ServiceException { if(p==null||c==null||s==null) throw new ServiceException("Product, customer and store are required"); if(text==null||text.trim().length()<1||text.trim().length()>1000) throw new ServiceException("Question must be between 1 and 1000 characters"); if(repo.countByCustomerIdAndStatus(c.getId(),ProductQuestionStatus.PENDING)>=3) throw new ServiceException("Maximum of 3 pending questions"); ProductQuestion q=new ProductQuestion(); q.setProduct(p);q.setCustomer(c);q.setMerchantStore(s);q.setText(text.trim());q.setStatus(ProductQuestionStatus.PENDING);q.setCreatedAt(new Date());q.setUpdatedAt(new Date()); save(q); return q; }
+ public List<ProductQuestion> getByCustomer(Customer c){return repo.findByCustomerIdOrderByCreatedAtDesc(c.getId());}
+ public List<ProductQuestion> getByProduct(Product p, MerchantStore s){return repo.findByProductIdAndMerchantStoreIdOrderByCreatedAtAsc(p.getId(),s.getId());}
+ public List<ProductQuestion> getByStore(MerchantStore s, ProductQuestionStatus status){return status==null?repo.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(s.getId(),ProductQuestionStatus.PENDING):repo.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(s.getId(),status);}
+ private ProductQuestion transition(Long id, MerchantStore s, boolean answer, String value) throws ServiceException { ProductQuestion q=repo.findById(id).orElse(null); if(q==null||q.getMerchantStore()==null||!q.getMerchantStore().getId().equals(s.getId())) throw new ServiceException("Question not found"); if(q.getStatus()!=ProductQuestionStatus.PENDING) throw new ServiceException("Question is no longer pending"); if(answer && (value==null||value.trim().isEmpty()||value.trim().length()>2000)) throw new ServiceException("Answer must be between 1 and 2000 characters"); q.setAnswer(answer?value.trim():null);q.setStatus(answer?ProductQuestionStatus.ANSWERED:ProductQuestionStatus.REJECTED);q.setUpdatedAt(new Date());update(q);return q; }
+ public ProductQuestion answer(Long id,MerchantStore s,String a)throws ServiceException{return transition(id,s,true,a);} public ProductQuestion reject(Long id,MerchantStore s)throws ServiceException{return transition(id,s,false,null);}
+}
