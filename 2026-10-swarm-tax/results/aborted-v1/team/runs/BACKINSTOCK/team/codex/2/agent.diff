+package com.salesmanager.shop.store.api.v1.product;
+import java.util.*;
+import javax.validation.Valid;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.stock.StockAlertService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.stock.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.stock.*;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1")
+public class StockAlertApi {
+ @Autowired private StockAlertService service; @Autowired private ProductService products;
+ @PostMapping("/products/{sku}/alerts") @ResponseStatus(HttpStatus.CREATED)
+ public void subscribe(@PathVariable String sku,@Valid @RequestBody PersistableStockAlert body,@ApiIgnore MerchantStore store){ try { Product p=products.getBySku(sku,store); if(p==null) throw new ResourceNotFoundException("Product not found"); service.subscribe(sku,body.getEmail(),store,p); } catch(Exception e){ if(e instanceof ResourceNotFoundException) throw (ResourceNotFoundException)e; throw new IllegalArgumentException(e.getMessage(),e); } }
+ @DeleteMapping("/products/{sku}/alerts") @ResponseStatus(HttpStatus.NO_CONTENT)
+ public void unsubscribe(@PathVariable String sku,@RequestParam String email,@ApiIgnore MerchantStore store){service.unsubscribe(sku,email,store);}
+ @GetMapping("/private/stock-alerts") public List<ReadableStockAlert> alerts(@RequestParam(required=false) String status,@ApiIgnore MerchantStore store){ StockAlertStatus s=parse(status); List<ReadableStockAlert> out=new ArrayList<>(); for(StockAlert a:service.alerts(s,store)){ReadableStockAlert x=new ReadableStockAlert();x.setId(a.getId());x.setSku(a.getSku());x.setEmail(a.getEmail());x.setStatus(a.getStatus().name());out.add(x);} return out; }
+ @GetMapping("/private/stock-alerts/outbox") public List<ReadableStockAlert> outbox(@RequestParam(required=false) String status,@ApiIgnore MerchantStore store){ StockAlertOutboxStatus s=null; if(status!=null) try{s=StockAlertOutboxStatus.valueOf(status.toUpperCase());}catch(Exception e){throw new IllegalArgumentException("Invalid status");} List<ReadableStockAlert> out=new ArrayList<>(); for(StockAlertOutbox a:service.outbox(s,store)){ReadableStockAlert x=new ReadableStockAlert();x.setId(a.getId());x.setSku(a.getSku());x.setEmail(a.getEmail());x.setSubject(a.getSubject());x.setStatus(a.getStatus().name());out.add(x);} return out; }
+ private StockAlertStatus parse(String v){if(v==null)return null;try{return StockAlertStatus.valueOf(v.toUpperCase());}catch(Exception e){throw new IllegalArgumentException("Invalid status");}}
+}
