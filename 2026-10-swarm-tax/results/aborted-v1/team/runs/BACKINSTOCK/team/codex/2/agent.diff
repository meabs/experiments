+package com.salesmanager.core.business.services.catalog.product.stock;
+import java.util.*;
+import org.springframework.stereotype.Service;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.catalog.product.stock.*;
+import com.salesmanager.core.model.catalog.product.stock.*;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+ @Autowired private StockAlertRepository alerts; @Autowired private StockAlertOutboxRepository outbox;
+ @Transactional public StockAlert subscribe(String sku,String email,MerchantStore store,Product product){
+  if(sku==null||sku.trim().isEmpty()||email==null||email.trim().isEmpty()) throw new IllegalArgumentException("sku and email are required");
+  List<StockAlert> found=alerts.findByMerchantStoreIdAndSkuIgnoreCaseAndStatus(store.getId(),sku,StockAlertStatus.ACTIVE);
+  for(StockAlert a:found) if(a.getEmail().equalsIgnoreCase(email)) return a;
+  StockAlert a=new StockAlert(); a.setSku(sku); a.setEmail(email.trim()); a.setMerchantStore(store); a.setProduct(product); return alerts.save(a);
+ }
+ @Transactional public void unsubscribe(String sku,String email,MerchantStore store){ for(StockAlert a:alerts.findByMerchantStoreIdAndSkuIgnoreCaseAndStatus(store.getId(),sku,StockAlertStatus.ACTIVE)) if(email==null||a.getEmail().equalsIgnoreCase(email)) { a.setStatus(StockAlertStatus.CANCELLED); alerts.save(a); } }
+ public List<StockAlert> alerts(StockAlertStatus s, MerchantStore store){return s==null?alerts.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(store.getId(), StockAlertStatus.ACTIVE):alerts.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(store.getId(),s);}
+ public List<StockAlertOutbox> outbox(StockAlertOutboxStatus s, MerchantStore store){return s==null?outbox.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId()):outbox.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(store.getId(),s);}
+ @Transactional public void createOutbox(Product p,MerchantStore store){ if(p==null)return; String name=p.getProductDescription()!=null?p.getProductDescription().getName():p.getSku(); for(StockAlert a:alerts.findByMerchantStoreIdAndSkuIgnoreCaseAndStatus(store.getId(),p.getSku(),StockAlertStatus.ACTIVE)){ if(!outbox.existsByMerchantStoreIdAndSkuIgnoreCaseAndEmailIgnoreCaseAndStatus(store.getId(),p.getSku(),a.getEmail(),StockAlertOutboxStatus.PENDING)){ StockAlertOutbox o=new StockAlertOutbox();o.setSku(p.getSku());o.setEmail(a.getEmail());o.setMerchantStore(store);o.setSubject("Back in stock: "+name);outbox.save(o); } } }
+}
