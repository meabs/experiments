+	@OneToMany(fetch = FetchType.LAZY, cascade = CascadeType.ALL, mappedBy = "product", orphanRemoval = true)
+	private Set<WholesalePriceTier> wholesalePriceTiers = new HashSet<WholesalePriceTier>();
+
+	public Set<WholesalePriceTier> getWholesalePriceTiers() { return wholesalePriceTiers; }
+	public void setWholesalePriceTiers(Set<WholesalePriceTier> tiers) {
+		this.wholesalePriceTiers = tiers == null ? new HashSet<WholesalePriceTier>() : tiers;
+	}
+	/** Returns the applicable tier price, capped at the product's normal final price. */
+	public BigDecimal getPriceForQuantity(int quantity, BigDecimal finalPrice) {
+		BigDecimal result = finalPrice;
+		if (result == null || wholesalePriceTiers == null) return result;
+		for (WholesalePriceTier tier : wholesalePriceTiers) {
+			if (tier.getMinQuantity() != null && tier.getPrice() != null && quantity >= tier.getMinQuantity()
+					&& tier.getPrice().compareTo(result) < 0) result = tier.getPrice();
+		}
+		return result;
+	}
 	
