+	@GetMapping(value = "/private/product/{id}/tiers", produces = APPLICATION_JSON_VALUE)
+	public ResponseEntity<List<ProductWholesalePriceTier>> getWholesaleTiers(@PathVariable Long id,
+			@ApiIgnore MerchantStore merchantStore) {
+		Product product;
+		try { product = productService.retrieveById(id, merchantStore).orElse(null); }
+		catch (RuntimeException e) { product = null; }
+		if (product == null || product.getMerchantStore() == null || !product.getMerchantStore().getId().equals(merchantStore.getId()))
+			return new ResponseEntity<>(HttpStatus.NOT_FOUND);
+		List<ProductWholesalePriceTier> result = new ArrayList<>();
+		for (WholesalePriceTier tier : product.getWholesalePriceTiers()) {
+			ProductWholesalePriceTier dto = new ProductWholesalePriceTier();
+			dto.setMinQuantity(tier.getMinQuantity()); dto.setPrice(tier.getPrice()); result.add(dto);
+		}
+		result.sort(Comparator.comparing(ProductWholesalePriceTier::getMinQuantity));
+		return ResponseEntity.ok(result);
+	}
+
+	@org.springframework.web.bind.annotation.PutMapping(value = "/private/product/{id}/tiers", consumes = APPLICATION_JSON_VALUE, produces = APPLICATION_JSON_VALUE)
+	public ResponseEntity<?> putWholesaleTiers(@PathVariable Long id, @RequestBody List<ProductWholesalePriceTier> tiers,
+			@ApiIgnore MerchantStore merchantStore) {
+		Product product;
+		try { product = productService.retrieveById(id, merchantStore).orElse(null); }
+		catch (RuntimeException e) { product = null; }
+		if (product == null || product.getMerchantStore() == null || !product.getMerchantStore().getId().equals(merchantStore.getId()))
+			return new ResponseEntity<>(HttpStatus.NOT_FOUND);
+		if (tiers == null || tiers.size() > 10) return ResponseEntity.badRequest().body("At most 10 tiers are allowed");
+		for (ProductWholesalePriceTier tier : tiers)
+			if (tier == null) return ResponseEntity.badRequest().body("Each tier requires minQuantity >= 2 and price > 0");
+		List<ProductWholesalePriceTier> sorted = new ArrayList<>(tiers);
+		sorted.sort(Comparator.comparing(ProductWholesalePriceTier::getMinQuantity, Comparator.nullsFirst(Comparator.naturalOrder())));
+		Integer previousQuantity = null; BigDecimal previousPrice = null;
+		for (ProductWholesalePriceTier tier : sorted) {
+			if (tier == null || tier.getMinQuantity() == null || tier.getMinQuantity() < 2 || tier.getPrice() == null || tier.getPrice().compareTo(BigDecimal.ZERO) <= 0)
+				return ResponseEntity.badRequest().body("Each tier requires minQuantity >= 2 and price > 0");
+			if (previousQuantity != null && (tier.getMinQuantity().equals(previousQuantity) || tier.getPrice().compareTo(previousPrice) >= 0))
+				return ResponseEntity.badRequest().body("Tier quantities must be unique and prices strictly decrease");
+			previousQuantity = tier.getMinQuantity(); previousPrice = tier.getPrice();
+		}
+		Set<WholesalePriceTier> replacement = new HashSet<>();
+		for (ProductWholesalePriceTier dto : sorted) { WholesalePriceTier tier = new WholesalePriceTier(); tier.setProduct(product); tier.setMinQuantity(dto.getMinQuantity()); tier.setPrice(dto.getPrice()); replacement.add(tier); }
+		product.setWholesalePriceTiers(replacement);
+		try { productService.update(product); } catch (Exception e) { LOGGER.error("Error updating wholesale tiers", e); return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR).build(); }
+		return getWholesaleTiers(id, merchantStore);
+	}
