+	private void updateProductRating(Product product) throws ServiceException {
+		List<ProductReview> reviews = productReviewRepository.findByProduct(product.getId());
+		BigDecimal total = BigDecimal.ZERO;
+		for (ProductReview current : reviews) {
+			total = total.add(BigDecimal.valueOf(current.getReviewRating()));
+		}
+		product.setProductReviewCount(reviews.size());
+		product.setProductReviewAvg(reviews.isEmpty() ? BigDecimal.ZERO
+				: total.divide(BigDecimal.valueOf(reviews.size()), 2, java.math.RoundingMode.HALF_UP));
+		productService.update(product);
+	}
