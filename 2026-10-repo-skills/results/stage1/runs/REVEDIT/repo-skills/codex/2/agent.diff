+	@Override
+	public ProductReview getById(Long id) {
+		return productReviewRepository.findById(id).orElse(null);
+	}
+
+	@Override
+	public void delete(ProductReview review) throws ServiceException {
+		Product product = productService.getById(review.getProduct().getId());
+		productReviewRepository.delete(review);
+		productReviewRepository.flush();
+		refreshProductRating(product);
+		productService.update(product);
+	}
+
+	private void refreshProductRating(Product product) {
+		List<ProductReview> reviews = productReviewRepository.findByProduct(product.getId());
+		int count = reviews.size();
+		BigDecimal total = BigDecimal.ZERO;
+		Set<Long> countedReviews = new HashSet<>();
+		for (ProductReview current : reviews) {
+			if (countedReviews.add(current.getId())) {
+				total = total.add(BigDecimal.valueOf(current.getReviewRating()));
+			}
+		}
+		count = countedReviews.size();
+		product.setProductReviewCount(count);
+		product.setProductReviewAvg(count == 0 ? BigDecimal.ZERO : total.divide(BigDecimal.valueOf(count), 8, java.math.RoundingMode.HALF_UP));
+	}
