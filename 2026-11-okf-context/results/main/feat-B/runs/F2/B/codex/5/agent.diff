@@ -81,6 +81,26 @@ public class PaymentService {
         return payment;
     }
 
+    /** Cancel a queued payment from the caller's own account. */
+    public Payment cancel(Long paymentId) {
+        CurrentUser user = users.current();
+        Payment payment = payments.findById(paymentId).orElseThrow(() -> new NotFoundException("Payment not found"));
+        Account account;
+        try {
+            account = accounts.getVisible(payment.getAccountId());
+        } catch (NotFoundException e) {
+            throw new NotFoundException("Payment not found");
+        }
+        if (!access.ownsAccount(user, account)) {
+            throw new ForbiddenException("Only the account holder can cancel payments");
+        }
+        if (payment.getStatus() != PaymentStatus.QUEUED) {
+            throw new ConflictException("Only queued payments can be cancelled");
+        }
+        payment.setStatus(PaymentStatus.CANCELLED);
+        return payments.save(payment);
+    }
+
