+++ b/src/main/java/com/example/accounts/payment/PaymentService.java
@@ -81,6 +81,21 @@ public class PaymentService {
         return payment;
     }
 
+    /** Cancel a queued payment from one of the caller's own accounts. */
+    public Payment cancel(Long paymentId) {
+        Payment payment = get(paymentId);
+        CurrentUser user = users.current();
+        Account account = accounts.getVisible(payment.getAccountId());
+        if (!access.ownsAccount(user, account)) {
+            throw new ForbiddenException("Only the account holder can cancel payments");
+        }
+        if (payment.getStatus() != PaymentStatus.QUEUED) {
+            throw new ConflictException("Payment cannot be cancelled");
+        }
+        payment.setStatus(PaymentStatus.CANCELLED);
+        return payments.save(payment);
+    }
+
