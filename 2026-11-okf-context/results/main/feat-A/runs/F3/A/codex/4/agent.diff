diff --git a/src/main/java/com/example/accounts/payment/PaymentService.java b/src/main/java/com/example/accounts/payment/PaymentService.java
index 5d41980..8a4d9d4 100644
--- a/src/main/java/com/example/accounts/payment/PaymentService.java
+++ b/src/main/java/com/example/accounts/payment/PaymentService.java
@@ -81,10 +81,22 @@ public class PaymentService {
         return payment;
     }
 
+    @Transactional(readOnly = true)
+    public PaymentAllowance allowance(Long accountId) {
+        Account account = accounts.getVisible(accountId);
+        BigDecimal paidToday = paidToday(accountId);
+        BigDecimal dailyLimit = BigDecimal.valueOf(account.getDailyLimit());
+        return new PaymentAllowance(account.getDailyLimit(), paidToday,
+            dailyLimit.subtract(paidToday).max(BigDecimal.ZERO));
+    }
+
     private BigDecimal paidToday(Long accountId) {
         return payments.findByAccountIdAndCreatedAtGreaterThanEqual(accountId,
                 LocalDate.now(clock).atStartOfDay(clock.getZone()).toInstant()).stream()
             .filter(p -> p.getStatus() != PaymentStatus.REJECTED && p.getStatus() != PaymentStatus.CANCELLED)
             .map(Payment::getAmount).reduce(BigDecimal.ZERO, BigDecimal::add);
     }
+
+    public record PaymentAllowance(int dailyLimit, BigDecimal paidToday, BigDecimal remaining) {
+    }
 }
