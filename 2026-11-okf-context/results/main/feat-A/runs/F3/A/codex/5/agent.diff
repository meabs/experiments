+    /** The part of today's payments that counts against the account's daily limit. */
+    @Transactional(readOnly = true)
+    public PaymentAllowance allowance(Long accountId) {
+        Account account = accounts.getVisible(accountId);
+        BigDecimal dailyLimit = BigDecimal.valueOf(account.getDailyLimit());
+        BigDecimal paidToday = paidToday(account.getId());
+        return new PaymentAllowance(dailyLimit, paidToday, dailyLimit.subtract(paidToday).max(BigDecimal.ZERO));
+    }
