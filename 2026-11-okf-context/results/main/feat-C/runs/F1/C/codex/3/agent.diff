+    @Transactional(readOnly = true)
+    public List<Payment> history(Long accountId, String status) {
+        // Resolve visibility first so an invalid filter cannot reveal an account the caller may not see.
+        accounts.getVisible(accountId);
+        PaymentStatus requestedStatus = status == null ? null : PaymentStatus.valueOf(status);
+        return payments.findByAccountIdOrderByCreatedAtDescIdDesc(accountId).stream()
+            .filter(payment -> requestedStatus == null || payment.getStatus() == requestedStatus)
+            .toList();
+    }
