+package com.example.accounts.payment;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.scheduling.annotation.Scheduled;
+import org.springframework.stereotype.Component;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.example.accounts.integration.ledger.LedgerClient;
+import com.example.accounts.integration.ledger.LedgerPosting;
+import com.example.accounts.integration.ledger.LedgerTimeoutException;
+
+/** Retries failed ledger postings every 15 minutes, up to three times per payment. */
+@Component
+public class LedgerRetryJob {
+
+    private static final Logger log = LoggerFactory.getLogger(LedgerRetryJob.class);
+    private static final int MAX_RETRIES = 3;
+
+    private final PaymentRepository payments;
+    private final LedgerClient ledger;
+
+    public LedgerRetryJob(PaymentRepository payments, LedgerClient ledger) {
+        this.payments = payments;
+        this.ledger = ledger;
+    }
+
+    @Scheduled(cron = "0 */15 * * * *", zone = "Europe/London")
+    @Transactional
+    public void retryFailed() {
+        for (Payment payment : payments.findByStatusAndLedgerRetryCountLessThanOrderById(
+                PaymentStatus.POSTING_FAILED.name(), MAX_RETRIES)) {
+            try {
+                ledger.post(new LedgerPosting(payment.getLedgerReference(), payment.getAccountId(),
+                    payment.getAmount().negate(), "Payment to " + payment.getPayeeName()));
+                payment.setStatus(PaymentStatus.COMPLETED);
+                payments.save(payment);
+            } catch (LedgerTimeoutException e) {
+                payment.incrementLedgerRetryCount();
+                payments.save(payment);
+                log.warn("Ledger retry {} failed for payment {}", payment.getLedgerRetryCount(), payment.getId(), e);
+            }
+        }
+    }
+}
