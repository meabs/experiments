+    /** Payments from an account the caller may see, newest first. */
+    @Transactional(readOnly = true)
+    public List<Payment> history(Long accountId, String status) {
+        Account account = accounts.getVisible(accountId);
+        if (status == null) {
+            return payments.findByAccountIdOrderByCreatedAtDescIdDesc(account.getId());
+        }
+        PaymentStatus requestedStatus;
+        try {
+            requestedStatus = PaymentStatus.valueOf(status);
+        } catch (IllegalArgumentException e) {
+            throw new IllegalArgumentException("Unknown payment status");
+        }
+        return payments.findByAccountIdAndStatusOrderByCreatedAtDescIdDesc(account.getId(), requestedStatus.name());
+    }
+
