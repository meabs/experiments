+package com.example.accounts.payment;
+
+import org.springframework.scheduling.annotation.Scheduled;
+import org.springframework.stereotype.Component;
+import org.springframework.transaction.annotation.Transactional;
+
+/** Retries ledger postings that timed out after the payment was sent to the scheme. */
+@Component
+public class LedgerRetryJob {
+
+    private static final int MAX_RETRIES = 3;
+
+    private final PaymentRepository payments;
+    private final PaymentDispatcher dispatcher;
+
+    public LedgerRetryJob(PaymentRepository payments, PaymentDispatcher dispatcher) {
+        this.payments = payments;
+        this.dispatcher = dispatcher;
+    }
+
+    @Scheduled(cron = "0 */15 * * * *", zone = "Europe/London")
+    @Transactional
+    public void retryFailed() {
+        for (Payment payment : payments.findByStatusOrderById(PaymentStatus.POSTING_FAILED.name())) {
+            if (payment.getLedgerRetryCount() < MAX_RETRIES) {
+                dispatcher.retryLedgerPosting(payment);
+            }
+        }
+    }
+}
