+    public Payment retryLedgerPosting(Payment payment) {
+        payment.incrementLedgerRetryCount();
+        try {
+            ledger.post(new LedgerPosting(payment.getLedgerReference(), payment.getAccountId(), payment.getAmount().negate(),
+                "Payment to " + payment.getPayeeName()));
+            payment.setStatus(PaymentStatus.COMPLETED);
+        } catch (LedgerTimeoutException e) {
+            log.warn("Ledger retry failed for payment {}", payment.getId(), e);
+        }
+        return payments.save(payment);
+    }
