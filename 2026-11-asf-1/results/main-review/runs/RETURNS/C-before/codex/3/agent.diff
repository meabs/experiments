+package com.salesmanager.shop.model.order.returns;
+import java.math.BigDecimal; import java.time.LocalDate; import java.util.*; import com.salesmanager.core.model.order.*;
+public class ReadableReturn { private Long id,orderId; private List<ReadableReturnLine> lines=new ArrayList<>(); private BigDecimal tax,amount; private boolean restocked; private String reason; private LocalDate date;
+ public ReadableReturn(OrderReturn r){id=r.getId();orderId=r.getOrder().getId();tax=r.getTax();amount=r.getAmount();restocked=r.isRestocked();reason=r.getReason();date=r.getDate().toInstant().atZone(java.time.ZoneId.systemDefault()).toLocalDate();for(OrderReturnLine l:r.getLines())lines.add(new ReadableReturnLine(l));}
+ public Long getId(){return id;} public Long getOrderId(){return orderId;} public List<ReadableReturnLine> getLines(){return lines;} public BigDecimal getTax(){return tax;} public BigDecimal getAmount(){return amount;} public boolean isRestocked(){return restocked;} public String getReason(){return reason;} public LocalDate getDate(){return date;}
+ public static class ReadableReturnLine {private String sku;private int quantity;private BigDecimal amount;public ReadableReturnLine(OrderReturnLine l){sku=l.getSku();quantity=l.getQuantity();amount=l.getAmount();}public String getSku(){return sku;}public int getQuantity(){return quantity;}public BigDecimal getAmount(){return amount;}}
+}
