+package com.salesmanager.shop.store.validation;
+
+import java.util.Set;
+
+import org.springframework.stereotype.Component;
+
+import com.salesmanager.core.business.constants.Constants;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.shop.model.catalog.product.product.PersistableProduct;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+
+@Component
+public class QuantityOrderValidator {
+
+    public void validate(PersistableProduct product) {
+        validate(product.getQuantityOrderMinimum(), product.getQuantityOrderMaximum());
+    }
+
+    public void validate(Product product, int quantity, boolean conflict) {
+        if (quantity == 0) {
+            return;
+        }
+        ProductAvailability availability = defaultAvailability(product.getAvailabilities());
+        int minimum = availability == null || availability.getProductQuantityOrderMin() == null
+                ? 1 : availability.getProductQuantityOrderMin();
+        int maximum = availability == null || availability.getProductQuantityOrderMax() == null
+                ? -1 : availability.getProductQuantityOrderMax();
+        if (!Boolean.TRUE.equals(availability == null ? null : availability.getQuantityOrderLimitsSet())
+                && minimum == 1 && maximum == 1) {
+            maximum = -1;
+        }
+        if (quantity < minimum || (maximum != -1 && quantity > maximum)) {
+            String message = "Quantity for product " + product.getSku() + " must be between " + minimum
+                    + " and " + (maximum == -1 ? "unlimited" : maximum);
+            if (conflict) {
+                throw new QuantityOrderConflictException(message);
+            }
+            throw new ServiceRuntimeException("400", message);
+        }
+    }
+
+    public void validate(int minimum, int maximum) {
+        if (minimum < 1 || (maximum != -1 && maximum < minimum)) {
+            throw new ServiceRuntimeException("400",
+                    "quantityOrderMinimum must be at least 1 and quantityOrderMaximum must be -1 or at least the minimum");
+        }
+    }
+
+    private ProductAvailability defaultAvailability(Set<ProductAvailability> availabilities) {
+        if (availabilities == null) {
+            return null;
+        }
+        for (ProductAvailability availability : availabilities) {
+            if (availability.getProductVariant() == null && availability.getRegionVariant() == null
+                    && Constants.ALL_REGIONS.equals(availability.getRegion())) {
+                return availability;
+            }
+        }
+        return availabilities.isEmpty() ? null : availabilities.iterator().next();
+    }
+}
