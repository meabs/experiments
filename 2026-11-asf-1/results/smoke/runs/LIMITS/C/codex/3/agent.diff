@@ -0,0 +1,92 @@
+package com.salesmanager.test.shop.validation;
+
+import java.util.HashSet;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+import com.salesmanager.core.business.constants.Constants;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.shop.model.catalog.product.product.PersistableProduct;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.validation.QuantityOrderConflictException;
+import com.salesmanager.shop.store.validation.QuantityOrderValidator;
+
+public class QuantityOrderValidatorTest {
+
+    private final QuantityOrderValidator validator = new QuantityOrderValidator();
+
+    @Test
+    public void validatesProductBoundsAndDefaultUnlimitedMaximum() {
+        PersistableProduct product = new PersistableProduct();
+        product.setQuantityOrderMinimum(2);
+        product.setQuantityOrderMaximum(5);
+        validator.validate(product);
+
+        product.setQuantityOrderMinimum(0);
+        try {
+            validator.validate(product);
+            Assert.fail("Expected invalid product limits");
+        } catch (ServiceRuntimeException exception) {
+            Assert.assertEquals("400", exception.getErrorCode());
+        }
+    }
+
+    @Test
+    public void acceptsMinimumAndRejectsCartConflictAgainstCurrentLimits() {
+        Product product = new Product();
+        product.setSku("SKU");
+        ProductAvailability availability = new ProductAvailability();
+        availability.setRegion(Constants.ALL_REGIONS);
+        availability.setProductQuantityOrderMin(2);
+        availability.setProductQuantityOrderMax(5);
+        product.setAvailabilities(new HashSet<ProductAvailability>());
+        product.getAvailabilities().add(availability);
+
+        validator.validate(product, 2, false);
+        try {
+            validator.validate(product, 6, true);
+            Assert.fail("Expected checkout/cart quantity conflict");
+        } catch (QuantityOrderConflictException exception) {
+            Assert.assertEquals("409", exception.getErrorCode());
+        }
+    }
+
+    @Test
+    public void treatsLegacyImplicitOneAsUnlimitedButPreservesExplicitMaximumOne() {
+        Product legacyProduct = new Product();
+        ProductAvailability legacyAvailability = availability(1, 1);
+        legacyProduct.setAvailabilities(new HashSet<ProductAvailability>());
+        legacyProduct.getAvailabilities().add(legacyAvailability);
+
+        validator.validate(legacyProduct, 100, false);
+
+        Product explicitProduct = new Product();
+        ProductAvailability explicitAvailability = availability(1, 1);
+        explicitAvailability.setQuantityOrderLimitsSet(true);
+        explicitProduct.setAvailabilities(new HashSet<ProductAvailability>());
+        explicitProduct.getAvailabilities().add(explicitAvailability);
+        try {
+            validator.validate(explicitProduct, 2, false);
+            Assert.fail("Expected explicit maximum to be enforced");
+        } catch (ServiceRuntimeException exception) {
+            Assert.assertEquals("400", exception.getErrorCode());
+        }
+
+        Product legacyNullFlagProduct = new Product();
+        ProductAvailability legacyNullFlagAvailability = availability(1, 1);
+        legacyNullFlagAvailability.setQuantityOrderLimitsSet(null);
+        legacyNullFlagProduct.setAvailabilities(new HashSet<ProductAvailability>());
+        legacyNullFlagProduct.getAvailabilities().add(legacyNullFlagAvailability);
+        validator.validate(legacyNullFlagProduct, 100, false);
+    }
+
+    private ProductAvailability availability(int minimum, int maximum) {
+        ProductAvailability availability = new ProductAvailability();
+        availability.setRegion(Constants.ALL_REGIONS);
+        availability.setProductQuantityOrderMin(minimum);
+        availability.setProductQuantityOrderMax(maximum);
+        return availability;
+    }
+}
