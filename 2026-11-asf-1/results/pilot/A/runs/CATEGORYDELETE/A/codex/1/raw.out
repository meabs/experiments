t\t// appended the id a second time and consequently missed descendants.\n+\t\tList<Category> categories = this.getListByLineage(category.getMerchantStore(), dbCategory.getLineage());\n+\t\tSet<Long> categoryIds = new HashSet<>();\n+\t\tcategoryIds.add(dbCategory.getId());\n+\t\tfor (Category descendant : categories) {\n+\t\t\tcategoryIds.add(descendant.getId());\n+\t\t}\n \n+\t\t// Keep products and remove only their category associations.\n+\t\tList<Product> products = productService.getProducts(new ArrayList<>(categoryIds));\n+\t\tfor (Product product : products) {\n+\t\t\tProduct dbProduct = productService.getById(product.getId());\n+\t\t\tif (dbProduct != null && dbProduct.getCategories() != null\n+\t\t\t\t\t&& dbProduct.getCategories().removeIf(c -> categoryIds.contains(c.getId()))) {\n+\t\t\t\tproductService.update(dbProduct);\n \t\t\t}\n-\n-\t\t\tCategory categ = getById(category.getId(), category.getMerchantStore().getId());\n-\t\t\tcategoryRepository.delete(categ);\n-\n \t\t}\n \n+\t\t// Category.categories is CascadeType.REMOVE, so this removes the whole\n+\t\t// subtree after its product links have been detached.\n+\t\tcategoryRepository.delete(dbCategory);\n+\t\tcategoryRepository.flush();\n+\n \t}\n \n \t@Override\ndiff --git a/sm-shop/src/main/java/com/salesmanager/shop/store/facade/category/CategoryFacadeImpl.java b/sm-shop/src/main/java/com/salesmanager/shop/store/facade/category/CategoryFacadeImpl.java\nindex 3d9067d..0046a3f 100755\n--- a/sm-shop/src/main/java/com/salesmanager/shop/store/facade/category/CategoryFacadeImpl.java\n+++ b/sm-shop/src/main/java/com/salesmanager/shop/store/facade/category/CategoryFacadeImpl.java\n@@ -363,7 +363,7 @@ public class CategoryFacadeImpl implements CategoryFacade {\n \t}\n \n \tprivate Category getOne(Long categoryId, int storeId) {\n-\t\treturn Optional.ofNullable(categoryService.getById(categoryId)).orElseThrow(\n+\t\treturn Optional.ofNullable(categoryService.getById(categoryId, storeId)).orElseThrow(\n \t\t