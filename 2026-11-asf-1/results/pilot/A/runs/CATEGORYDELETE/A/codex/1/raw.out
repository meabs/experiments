d());\n   239\t\n   240\t\t\tif (dbCategory != null && dbCategory.getId().longValue() == category.getId().longValue()) {\n   241\t\n   242\t\t\t\tcategories.add(dbCategory);\n   243\t\n   244\t\t\t\tCollections.reverse(categories);\n   245\t\n   246\t\t\t\tList<Long> categoryIds = new ArrayList<Long>();\n   247\t\n   248\t\t\t\tfor (Category c : categories) {\n   249\t\t\t\t\tcategoryIds.add(c.getId());\n   250\t\t\t\t}\n   251\t\n   252\t\t\t\tList<Product> products = productService.getProducts(categoryIds);\n   253\t\t\t\t// org.hibernate.Session session =\n   254\t\t\t\t// em.unwrap(org.hibernate.Session.class);// need to refresh the\n   255\t\t\t\t// session to update\n   256\t\t\t\t// all product\n   257\t\t\t\t// categories\n   258\t\n   259\t\t\t\tfor (Product product : products) {\n   260\t\t\t\t\t// session.evict(product);// refresh product so we get all\n   261\t\t\t\t\t// product categories\n   262\t\t\t\t\tProduct dbProduct = productService.getById(product.getId());\n   263\t\t\t\t\tSet<Category> productCategories = dbProduct.getCategories();\n   264\t\t\t\t\tif (productCategories.size() > 1) {\n   265\t\t\t\t\t\tfor (Category c : categories) {\n   266\t\t\t\t\t\t\tproductCategories.remove(c);\n   267\t\t\t\t\t\t\tproductService.update(dbProduct);\n   268\t\t\t\t\t\t}\n   269\t\n   270\t\t\t\t\t\tif (product.getCategories() == null || product.getCategories().size() == 0) {\n   271\t\t\t\t\t\t\tproductService.delete(dbProduct);\n   272\t\t\t\t\t\t}\n   273\t\n   274\t\t\t\t\t} else {\n   275\t\t\t\t\t\tproductService.delete(dbProduct);\n   276\t\t\t\t\t}\n   277\t\n   278\t\t\t\t}\n   279\t\n   280\t\t\t\tCategory categ = getById(category.getId(), category.getMerchantStore().getId());\n   281\t\t\t\tcategoryRepository.delete(categ);\n   282\t\n   283\t\t\t}\n   284\t\n   285\t\t}\n   286\t\n   287\t\t@Override\n   288\t\tpublic CategoryDescription getDescription(Category category, Language language) {\n   289\t\n   290\t\t\tfor (CategoryDescription description : category.getDescriptions()) {\n   291\t\t\t\tif (description.getLanguage().equals(language)) {\n   292\t\t\t\t\treturn description;\n   293\t\t\t\t}\n   294\t\t\t}\n   295\t\t\treturn null;\n","exit_code":0,"status":"completed"}}
