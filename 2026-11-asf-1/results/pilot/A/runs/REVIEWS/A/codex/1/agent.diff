+  private boolean isAuthenticatedCustomer(HttpServletRequest request, Long customerId) {
+    if (request == null || !request.getRequestURI().contains("/auth/")) {
+      return true;
+    }
+    org.springframework.security.core.Authentication authentication =
+        org.springframework.security.core.context.SecurityContextHolder.getContext().getAuthentication();
+    Object principal = authentication == null ? null : authentication.getPrincipal();
+    boolean customerAuthentication = authentication != null && authentication.getAuthorities().stream()
+        .anyMatch(a -> ("ROLE_" + Constants.PERMISSION_CUSTOMER_AUTHENTICATED).equals(a.getAuthority()));
+    return customerAuthentication && principal instanceof com.salesmanager.shop.store.security.user.JWTUser
+        && customerId != null
+        && customerId.equals(((com.salesmanager.shop.store.security.user.JWTUser) principal).getId());
+  }
 }
