(review, merchantStore, language);\n \n       return review;\n \n-    } catch (Exception e) {\n+      } catch (Exception e) {\n       LOGGER.error(\"Error while saving product review\", e);\n       try {\n-        response.sendError(503, \"Error while saving product review\" + e.getMessage());\n+        if (!response.isCommitted()) response.sendError(HttpStatus.INTERNAL_SERVER_ERROR.value(), \"Error while saving product review\");\n       } catch (Exception ignore) {\n       }\n \n@@ -140,8 +144,8 @@ public class ProductReviewApi {\n \n   @RequestMapping(\n       value = {\n-        \"/private/products/{id}/reviews/{reviewid}\",\n-        \"/auth/products/{id}/reviews/{reviewid}\"\n+        \"/private/products/{id}/reviews/{reviewId}\",\n+        \"/auth/products/{id}/reviews/{reviewId}\"\n       },\n       method = RequestMethod.PUT)\n   @ResponseStatus(HttpStatus.OK)\n@@ -166,18 +170,19 @@ public class ProductReviewApi {\n         return null;\n       }\n \n-      if (prodReview.getCustomer().getId().longValue() != review.getCustomerId().longValue()) {\n+\t  if (prodReview.getProduct() == null || !prodReview.getProduct().getId().equals(id)) {\n         response.sendError(404, \"Product review with id \" + reviewId + \" does not exist\");\n         return null;\n       }\n \n-      // rating maximum 5\n-      if (review.getRating() > Constants.MAX_REVIEW_RATING_SCORE) {\n-        response.sendError(503, \"Maximum rating score is \" + Constants.MAX_REVIEW_RATING_SCORE);\n+\t      if (review.getRating() == null || review.getRating() < 1 || review.getRating() > Constants.MAX_REVIEW_RATING_SCORE\n+\t\t\t\t|| review.getRating() % 1 != 0) {\n+\t        response.sendError(HttpStatus.BAD_REQUEST.value(), \"Rating must be a whole number from 1 to 5\");\n         return null;\n       }\n \n       review.setProductId(id);\n+\t  review.setId(reviewId);\n \n       productCommonFacade.saveOrUpdateReview(review, merchantStore, language);\n \n@@ -196,8 +201,8 @@ public class Produ