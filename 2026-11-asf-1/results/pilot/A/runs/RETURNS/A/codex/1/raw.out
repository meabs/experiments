{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"nl -ba sm-shop/src/main/java/com/salesmanager/shop/store/controller/order/ReturnService.java | sed -n '25,45p'\"","aggregated_output":"    25\t  BigDecimal alreadyTax=returnRepository.findByOrderIdOrderByDateAscIdAsc(id).stream().map(OrderReturn::getTax).reduce(BigDecimal.ZERO,BigDecimal::add);\n    26\t  int all=0, done=0; for(OrderProduct p:order.getOrderProducts()){all+=p.getProductQuantity(); done+=already.getOrDefault(p.getSku(),0)+wanted.getOrDefault(p.getSku(),0);}\n    27\t  BigDecimal returnTax=done==all ? tax.subtract(alreadyTax) : subtotal.signum()==0?BigDecimal.ZERO:tax.multiply(returnedSubtotal).divide(subtotal,2,RoundingMode.HALF_UP);\n    28\t  returnTax=returnTax.setScale(2,RoundingMode.HALF_UP); BigDecimal total=returnedSubtotal.add(returnTax).setScale(2,RoundingMode.HALF_UP);\n    29\t  OrderReturn ret=new OrderReturn(); ret.setOrder(order); ret.setTax(returnTax); ret.setAmount(total); ret.setRestocked(!refundAll && Boolean.TRUE.equals(request.getRestock())); ret.setReason(refundAll?\"refund\":request.getReason()); ret.setDate(new Date());\n    30\t  for(Map.Entry<String,Integer> e:wanted.entrySet()){ OrderReturnLine line=new OrderReturnLine(); line.setOrderReturn(ret); line.setSku(e.getKey()); line.setQuantity(e.getValue()); line.setAmount(price(products.get(e.getKey())).multiply(BigDecimal.valueOf(e.getValue())).setScale(2,RoundingMode.HALF_UP)); ret.getLines().add(line); }\n    31\t  returnRepository.saveAndFlush(ret);\n    32\t  if(ret.isRestocked()) for(String sku:wanted.keySet()){ Product product=productService.getBySku(sku,store); if(product!=null){ for(ProductAvailability a:product.getAvailabilities()) a.setProductQuantity(a.getProductQuantity()+wanted.get(sku)); productService.update(product); } }\n    33\t  if(done==all) order.setStatus(OrderStatus.REFUNDED);\n    34\t  BigDecimal refunded=order.getOrderTotal().stream().filter(t->\"order.total.refunded\".equals(t.getOrderTotalCode())).map(OrderTotal::getValue).reduce(BigDecimal.ZERO,BigDecimal::add).add(total);\n    35\t  Optional<OrderTotal> existing=order.getOrderTotal().stream().filter(t->\"order.total.refunded\".equals(t.getOrderTotalCode())).findFirst(); OrderTotal rt=existing.orElseGet(OrderTotal::new); rt.setOrderTotalCode(\"order.total.refunded\"); rt.setValue(refunded); rt.setOrder(order); rt.setSortOrder(999); rt.setOrderTotalType(OrderTotalType.REFUND); if(!existing.isPresent()) order.getOrderTotal().add(rt);\n    36\t  OrderStatusHistory history=new OrderStatusHistory(); history.setOrder(order); history.setStatus(order.getStatus()); history.setComments(\"Refunded \" + total.toPlainString()); history.setDateAdded(new Date()); history.setCustomerNotified(0); order.getOrderHistory().add(history);\n    37\t  orderService.update(order);\n    38\t  Transaction tx=new Transaction(); tx.setOrder(order); tx.setAmount(total); tx.setTransactionType(TransactionType.REFUND); tx.setPaymentType(order.getPaymentType()); tx.setTransactionDate(new Date()); transactionService.create(tx);\n    39\t  return readable(ret);\n    40\t }\n    41\t public List<ReadableReturn> list(Long id, MerchantStore store){ Order order=orderService.getById(id); if(order==null||order.getMerchant()==null||!order.getMerchant().getId().equals(store.getId())) throw new ResourceNotFoundException(\"Order \" + id + \" does not exist\"); return returnRepository.findByOrderIdOrderByDateAscIdAsc(id).stream().map(this::readable).collect(Collectors.toList()); }\n    42\t private BigDecimal price(OrderProduct p){return p.getOneTimeCharge()==null?BigDecimal.ZERO:p.getOneTimeCharge();}\n    43\t private ReadableReturn readable(OrderReturn r){ReadableReturn x=new ReadableReturn(); x.id=r.getId(); x.orderId=r.getOrder().getId(); x.tax=r.getTax(); x.amount=r.getAmount(); x.restocked=r.isRestocked(); x.reason=r.getReason(); x.date=r.getDate().toInstant().atZone(ZoneId.systemDefault()).toLocalDate(); x.lines=r.getLines().stream().map(l->{ReadableReturnLine y=new ReadableReturnLine();y.sku=l.getSku();y.quantity=l.getQuantity();y.amount=l.getAmount();return y;}).collect(Collectors.toList()); return x;}\n    44\t}\n","exit_code":0,"status":"completed"}}
