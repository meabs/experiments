+package com.salesmanager.core.model.order;
+
+import java.math.BigDecimal;
+import java.util.Date;
+import java.util.LinkedHashSet;
+import java.util.Set;
+import javax.persistence.*;
+import com.fasterxml.jackson.annotation.JsonIgnore;
+import com.salesmanager.core.model.generic.SalesManagerEntity;
+
+@Entity
+@Table(name = "ORDER_RETURN")
+public class OrderReturn extends SalesManagerEntity<Long, OrderReturn> {
+    @Id @GeneratedValue(strategy = GenerationType.TABLE, generator = "TABLE_GEN")
+    @TableGenerator(name = "TABLE_GEN", table = "SM_SEQUENCER", pkColumnName = "SEQ_NAME", valueColumnName = "SEQ_COUNT", pkColumnValue = "ORDER_RETURN_ID_SEQ_NEXT_VAL")
+    @Column(name = "ORDER_RETURN_ID") private Long id;
+    @JsonIgnore @ManyToOne @JoinColumn(name = "ORDER_ID", nullable = false) private Order order;
+    @OneToMany(mappedBy = "orderReturn", cascade = CascadeType.ALL, orphanRemoval = true) private Set<OrderReturnLine> lines = new LinkedHashSet<>();
+    @Column(name = "TAX", precision = 15, scale = 4, nullable = false) private BigDecimal tax;
+    @Column(name = "AMOUNT", precision = 15, scale = 4, nullable = false) private BigDecimal amount;
+    @Column(name = "RESTOCKED", nullable = false) private boolean restocked;
+    @Column(name = "REASON") private String reason;
+    @Temporal(TemporalType.DATE) @Column(name = "RETURN_DATE", nullable = false) private Date date;
+    public Long getId(){return id;} public void setId(Long v){id=v;}
+    public Order getOrder(){return order;} public void setOrder(Order v){order=v;}
+    public Set<OrderReturnLine> getLines(){return lines;} public void setLines(Set<OrderReturnLine> v){lines=v;}
+    public BigDecimal getTax(){return tax;} public void setTax(BigDecimal v){tax=v;}
+    public BigDecimal getAmount(){return amount;} public void setAmount(BigDecimal v){amount=v;}
+    public boolean isRestocked(){return restocked;} public void setRestocked(boolean v){restocked=v;}
+    public String getReason(){return reason;} public void setReason(String v){reason=v;}
+    public Date getDate(){return date;} public void setDate(Date v){date=v;}
+}
