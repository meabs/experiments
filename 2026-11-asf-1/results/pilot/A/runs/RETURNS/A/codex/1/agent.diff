@@ -0,0 +1,48 @@
+package com.salesmanager.shop.store.controller.order;
+
+import java.math.*; import java.time.*; import java.util.*; import java.util.stream.*;
+import javax.inject.Inject; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.order.OrderReturnRepository; import com.salesmanager.core.business.repositories.order.OrderRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.order.OrderService; import com.salesmanager.core.business.services.payments.TransactionService;
+import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.availability.ProductAvailability; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.order.*; import com.salesmanager.core.model.order.orderproduct.OrderProduct; import com.salesmanager.core.model.order.orderstatus.*; import com.salesmanager.core.model.payments.*;
+import com.salesmanager.shop.model.order.returning.*; import com.salesmanager.shop.store.api.exception.*;
+
+@Service
+public class ReturnService {
+ @Inject private OrderService orderService; @Inject private OrderRepository orderRepository; @Inject private OrderReturnRepository returnRepository; @Inject private TransactionService transactionService; @Inject private ProductService productService;
+ @Transactional public ReadableReturn create(Long id, MerchantStore store, ReturnRequest request, boolean refundAll) {
+  Order order=orderRepository.findById(id).orElse(null); if(order==null || order.getMerchant()==null || !order.getMerchant().getId().equals(store.getId())) throw new ResourceNotFoundException("Order " + id + " does not exist");
+  if(order.getStatus()==OrderStatus.CANCELED || order.getStatus()==OrderStatus.REFUNDED) throw new ReturnConflictException("Order cannot be returned");
+  Map<String,Integer> wanted=new LinkedHashMap<>();
+  if(refundAll){ for(OrderProduct p:order.getOrderProducts()) wanted.merge(p.getSku(),p.getProductQuantity(),Integer::sum); }
+  else { if(request==null || request.getLines()==null || request.getLines().isEmpty()) throw new ReturnBadRequestException("At least one return line is required"); for(ReturnRequestLine l:request.getLines()){ if(l==null || l.getSku()==null || l.getQuantity()==null || l.getQuantity()<=0) throw new ReturnBadRequestException("Invalid return line"); wanted.merge(l.getSku(),l.getQuantity(),Integer::sum); } }
+  Map<String,OrderProduct> products=order.getOrderProducts().stream().collect(Collectors.toMap(OrderProduct::getSku,p->p,(a,b)->a,LinkedHashMap::new));
+  Map<String,Integer> already=new HashMap<>(); for(OrderReturn r:returnRepository.findByOrderIdOrderByDateAscIdAsc(id)) for(OrderReturnLine l:r.getLines()) already.merge(l.getSku(),l.getQuantity(),Integer::sum);
+  for(Map.Entry<String,Integer> e:wanted.entrySet()){ OrderProduct p=products.get(e.getKey()); if(p==null || e.getValue()+already.getOrDefault(e.getKey(),0)>p.getProductQuantity()) throw new ReturnBadRequestException("Invalid returned quantity for " + e.getKey()); }
+  BigDecimal subtotal=order.getOrderProducts().stream().map(p->price(p).multiply(BigDecimal.valueOf(p.getProductQuantity()))).reduce(BigDecimal.ZERO,BigDecimal::add);
+  BigDecimal tax=order.getOrderTotal().stream().filter(t->t.getOrderTotalType()==OrderTotalType.TAX).map(OrderTotal::getValue).reduce(BigDecimal.ZERO,BigDecimal::add);
+  BigDecimal returnedSubtotal=wanted.entrySet().stream().map(e->price(products.get(e.getKey())).multiply(BigDecimal.valueOf(e.getValue()))).reduce(BigDecimal.ZERO,BigDecimal::add);
+  BigDecimal alreadyTax=returnRepository.findByOrderIdOrderByDateAscIdAsc(id).stream().map(OrderReturn::getTax).reduce(BigDecimal.ZERO,BigDecimal::add);
+  int all=0, done=0; for(OrderProduct p:order.getOrderProducts()){all+=p.getProductQuantity(); done+=already.getOrDefault(p.getSku(),0)+wanted.getOrDefault(p.getSku(),0);}
+  BigDecimal returnTax=done==all ? tax.subtract(alreadyTax) : subtotal.signum()==0?BigDecimal.ZERO:tax.multiply(returnedSubtotal).divide(subtotal,2,RoundingMode.HALF_UP);
+  returnTax=returnTax.setScale(2,RoundingMode.HALF_UP); BigDecimal total=returnedSubtotal.add(returnTax).setScale(2,RoundingMode.HALF_UP);
+  OrderReturn ret=new OrderReturn(); ret.setOrder(order); ret.setTax(returnTax); ret.setAmount(total); ret.setRestocked(!refundAll && Boolean.TRUE.equals(request.getRestock())); ret.setReason(refundAll?"refund":request.getReason()); ret.setDate(new Date());
+  for(Map.Entry<String,Integer> e:wanted.entrySet()){ OrderReturnLine line=new OrderReturnLine(); line.setOrderReturn(ret); line.setSku(e.getKey()); line.setQuantity(e.getValue()); line.setAmount(price(products.get(e.getKey())).multiply(BigDecimal.valueOf(e.getValue())).setScale(2,RoundingMode.HALF_UP)); ret.getLines().add(line); }
+  returnRepository.saveAndFlush(ret);
+  if(ret.isRestocked()) for(String sku:wanted.keySet()){ Product product=product(sku,store); if(product!=null){ for(ProductAvailability a:product.getAvailabilities()) a.setProductQuantity(a.getProductQuantity()+wanted.get(sku)); updateProduct(product); } }
+  if(done==all) order.setStatus(OrderStatus.REFUNDED);
+  BigDecimal refunded=order.getOrderTotal().stream().filter(t->"order.total.refunded".equals(t.getOrderTotalCode())).map(OrderTotal::getValue).reduce(BigDecimal.ZERO,BigDecimal::add).add(total);
+  Optional<OrderTotal> existing=order.getOrderTotal().stream().filter(t->"order.total.refunded".equals(t.getOrderTotalCode())).findFirst(); OrderTotal rt=existing.orElseGet(OrderTotal::new); rt.setOrderTotalCode("order.total.refunded"); rt.setValue(refunded); rt.setOrder(order); rt.setSortOrder(999); rt.setOrderTotalType(OrderTotalType.REFUND); if(!existing.isPresent()) order.getOrderTotal().add(rt);
+  OrderStatusHistory history=new OrderStatusHistory(); history.setOrder(order); history.setStatus(order.getStatus()); history.setComments("Refunded " + total.toPlainString()); history.setDateAdded(new Date()); history.setCustomerNotified(0); order.getOrderHistory().add(history);
+  updateOrder(order);
+  Transaction tx=new Transaction(); tx.setOrder(order); tx.setAmount(total); tx.setTransactionType(TransactionType.REFUND); tx.setPaymentType(order.getPaymentType()); tx.setTransactionDate(new Date()); createTransaction(tx);
+  return readable(ret);
+ }
+ public List<ReadableReturn> list(Long id, MerchantStore store){ Order order=orderRepository.findById(id).orElse(null); if(order==null||order.getMerchant()==null||!order.getMerchant().getId().equals(store.getId())) throw new ResourceNotFoundException("Order " + id + " does not exist"); return returnRepository.findByOrderIdOrderByDateAscIdAsc(id).stream().map(this::readable).collect(Collectors.toList()); }
+ private BigDecimal price(OrderProduct p){return p.getOneTimeCharge()==null?BigDecimal.ZERO:p.getOneTimeCharge();}
+ private Product product(String sku, MerchantStore store){try{return productService.getBySku(sku,store);}catch(Exception e){throw new ServiceRuntimeException("Unable to update stock",e);}}
+ private void updateProduct(Product p){try{productService.update(p);}catch(Exception e){throw new ServiceRuntimeException("Unable to update stock",e);}}
+ private void updateOrder(Order o){try{orderService.update(o);}catch(Exception e){throw new ServiceRuntimeException("Unable to save return",e);}}
+ private void createTransaction(Transaction t){try{transactionService.create(t);}catch(Exception e){throw new ServiceRuntimeException("Unable to save refund transaction",e);}}
+ private ReadableReturn readable(OrderReturn r){ReadableReturn x=new ReadableReturn(); x.id=r.getId(); x.orderId=r.getOrder().getId(); x.tax=r.getTax(); x.amount=r.getAmount(); x.restocked=r.isRestocked(); x.reason=r.getReason(); x.date=r.getDate().toInstant().atZone(ZoneId.systemDefault()).toLocalDate(); x.lines=r.getLines().stream().map(l->{ReadableReturnLine y=new ReadableReturnLine();y.sku=l.getSku();y.quantity=l.getQuantity();y.amount=l.getAmount();return y;}).collect(Collectors.toList()); return x;}
+}
