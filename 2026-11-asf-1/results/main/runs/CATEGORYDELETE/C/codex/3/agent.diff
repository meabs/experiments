+	public void deleteCategoryKeepsProductsAndRemovesSubtreeLinks() throws Exception {
+		MerchantStore store = merchantService.getByCode(MerchantStore.DEFAULT_STORE);
+
+		Category deleted = category(store, "delete-products-root");
+		Category child = category(store, "delete-products-child");
+		child.setParent(deleted);
+		categoryService.create(child);
+		categoryService.addChild(deleted, child);
+		Category retained = category(store, "retain-products-category");
+
+		Product onlyInDeleted = product(store, "DELETE_ONLY");
+		onlyInDeleted.getCategories().add(child);
+		productService.saveProduct(onlyInDeleted);
+
+		Product inBoth = product(store, "DELETE_AND_RETAIN");
+		inBoth.getCategories().add(child);
+		inBoth.getCategories().add(retained);
+		productService.saveProduct(inBoth);
+		Assert.assertEquals(2, productService.findOne(inBoth.getId(), store).getCategories().size());
+
+		categoryService.delete(deleted);
+
+		Product remainingOnly = productService.findOne(onlyInDeleted.getId(), store);
+		Product remainingBoth = productService.findOne(inBoth.getId(), store);
+		Assert.assertNotNull(remainingOnly);
+		Assert.assertTrue(remainingOnly.getCategories().isEmpty());
+		Assert.assertNotNull(remainingBoth);
+		Assert.assertEquals(inBoth.getSku(), remainingBoth.getSku());
+		Assert.assertEquals(0, BigDecimal.TEN.compareTo(remainingBoth.getAvailabilities().iterator().next().getPrices().iterator().next().getProductPriceAmount()));
+		Assert.assertEquals(Integer.valueOf(10), remainingBoth.getAvailabilities().iterator().next().getProductQuantity());
+		Assert.assertEquals(1, remainingBoth.getCategories().size());
+		Assert.assertEquals(retained.getId(), remainingBoth.getCategories().iterator().next().getId());
+		Assert.assertNotNull(categoryService.getById(retained.getId(), store.getId()));
+		Assert.assertNull(categoryService.getById(deleted.getId(), store.getId()));
+		Assert.assertNull(categoryService.getById(child.getId(), store.getId()));
+
+		productService.delete(remainingOnly);
+		productService.delete(remainingBoth);
+		categoryService.delete(retained);
