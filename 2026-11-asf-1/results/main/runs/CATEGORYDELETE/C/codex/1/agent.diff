+    private PersistableCategory createCategory(String code, Long parentId) throws Exception {
+        PersistableCategory category = category(code);
+        category.getDescriptions().get(0).setFriendlyUrl(code);
+        if (parentId != null) {
+            Category parent = new Category();
+            parent.setId(parentId);
+            category.setParent(parent);
+        }
+        return createCategory(category);
+    }
+
+    private PersistableCategory createCategory(PersistableCategory category) throws Exception {
+        ResponseEntity<PersistableCategory> response = testRestTemplate.postForEntity("/api/v1/private/category",
+                new HttpEntity<>(category, getHeader()), PersistableCategory.class);
+        assertThat(response.getStatusCode(), is(CREATED));
+        assertNotNull(response.getBody());
+        assertNotNull(response.getBody().getId());
+        return response.getBody();
+    }
+
+    private PersistableProduct product(String sku, String... categoryCodes) {
+        PersistableProduct product = product(sku);
+        product.setSku(sku);
+        product.setPrice(new BigDecimal("42.50"));
+        product.setQuantity(17);
+        product.setAvailable(true);
+        ProductSpecification specification = new ProductSpecification();
+        specification.setManufacturer("DEFAULT");
+        product.setProductSpecifications(specification);
+        for (String code : categoryCodes) {
+            Category category = new Category();
+            category.setCode(code);
+            product.getCategories().add(category);
+        }
+        return product;
+    }
+
+    private Entity createProduct(PersistableProduct product) throws Exception {
