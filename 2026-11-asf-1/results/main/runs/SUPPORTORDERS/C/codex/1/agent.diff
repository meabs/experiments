+package com.salesmanager.test.order;
+
+import static org.junit.Assert.assertEquals;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+
+import javax.persistence.Query;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.utils.RepositoryHelper;
+import com.salesmanager.core.model.common.Criteria;
+import com.salesmanager.core.model.common.GenericEntityList;
+
+public class RepositoryHelperTest {
+
+    @Test
+    public void pagePaginationUsesZeroBasedOffsetAndCeilingPageCount() {
+        Query query = mock(Query.class);
+        Criteria criteria = new Criteria();
+        criteria.setLegacyPagination(false);
+        criteria.setStartPage(2);
+        criteria.setPageSize(5);
+        GenericEntityList entityList = new GenericEntityList();
+
+        RepositoryHelper.paginateQuery(query, 10, entityList, criteria);
+
+        verify(query).setFirstResult(10);
+        verify(query).setMaxResults(5);
+        assertEquals(2, entityList.getTotalPages());
+        assertEquals(10, entityList.getTotalCount());
+    }
+}
