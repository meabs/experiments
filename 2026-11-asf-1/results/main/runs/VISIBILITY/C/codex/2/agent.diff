@@ -0,0 +1,36 @@
+package com.salesmanager.core.business.configuration;
+
+import javax.annotation.PostConstruct;
+import javax.inject.Inject;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.jdbc.BadSqlGrammarException;
+import org.springframework.context.annotation.DependsOn;
+import org.springframework.stereotype.Component;
+
+/** Backfills the default-visible flag when upgrading an existing catalogue. */
+@Component
+@DependsOn("entityManagerFactory")
+public class ProductVisibilityMigration {
+
+	private static final Logger LOGGER = LoggerFactory.getLogger(ProductVisibilityMigration.class);
+
+	@Inject
+	private JdbcTemplate jdbcTemplate;
+
+	@PostConstruct
+	public void backfillExistingProducts() {
+		try {
+			int updated = jdbcTemplate.update("UPDATE PRODUCT SET VISIBLE = TRUE WHERE VISIBLE IS NULL");
+			if (updated > 0) {
+				LOGGER.info("Marked {} existing products visible during the visibility migration", updated);
+			}
+		} catch (BadSqlGrammarException exception) {
+			// On a fresh installation Shopizer creates the catalogue tables after
+			// application context initialization. The column default covers those rows.
+			LOGGER.debug("Product table is not available yet; skipping visibility backfill", exception);
+		}
+	}
+}
