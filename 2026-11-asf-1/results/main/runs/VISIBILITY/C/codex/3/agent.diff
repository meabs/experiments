diff --git a/sm-core/src/test/java/com/salesmanager/test/catalog/ProductRepositoryQueryTest.java b/sm-core/src/test/java/com/salesmanager/test/catalog/ProductRepositoryQueryTest.java
new file mode 100644
index 000000000..f9f1f1a73
--- /dev/null
+++ b/sm-core/src/test/java/com/salesmanager/test/catalog/ProductRepositoryQueryTest.java
@@ -0,0 +1,72 @@
+package com.salesmanager.test.catalog;
+
+import static org.junit.Assert.assertTrue;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import java.lang.reflect.Field;
+import java.util.Collections;
+import java.util.Locale;
+
+import javax.persistence.EntityManager;
+import javax.persistence.Query;
+
+import org.junit.Before;
+import org.junit.Test;
+
+import com.salesmanager.core.business.repositories.catalog.product.ProductRepositoryImpl;
+import com.salesmanager.core.model.catalog.product.ProductCriteria;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+public class ProductRepositoryQueryTest {
+
+	private EntityManager entityManager;
+	private ProductRepositoryImpl repository;
+
+	@Before
+	public void setUp() throws Exception {
+		entityManager = mock(EntityManager.class);
+		repository = new ProductRepositoryImpl();
+		Field field = ProductRepositoryImpl.class.getDeclaredField("em");
+		field.setAccessible(true);
+		field.set(repository, entityManager);
+	}
+
+	@Test
+	public void friendlyUrlLookupIsScopedToTheRequestedStore() {
+		Query query = mock(Query.class);
+		when(entityManager.createQuery(anyString())).thenReturn(query);
+		when(query.getResultList()).thenReturn(Collections.emptyList());
+		MerchantStore store = new MerchantStore();
+		store.setId(12);
+
+		repository.getByFriendlyUrl(store, "shared-url", Locale.ENGLISH);
+
+		verify(entityManager).createQuery(org.mockito.ArgumentMatchers.contains("pm.id=:merchantId"));
+		verify(query).setParameter("merchantId", 12);
+	}
+
+	@Test
+	public void privateListKeepsOptionValueFilterInResultQuery() {
+		Query countQuery = mock(Query.class);
+		Query resultQuery = mock(Query.class);
+		when(entityManager.createQuery(anyString())).thenReturn(countQuery, resultQuery);
+		when(countQuery.getSingleResult()).thenReturn(1L);
+		when(resultQuery.getResultList()).thenReturn(Collections.emptyList());
+
+		MerchantStore store = new MerchantStore();
+		store.setId(12);
+		ProductCriteria criteria = new ProductCriteria();
+		criteria.setOrigin(ProductCriteria.ORIGIN_ADMIN);
+		criteria.setOptionValueIds(Collections.singletonList(34L));
+
+		repository.listByStore(store, null, criteria);
+
+		org.mockito.ArgumentCaptor<String> hql = org.mockito.ArgumentCaptor.forClass(String.class);
+		verify(entityManager, org.mockito.Mockito.times(2)).createQuery(hql.capture());
+		assertTrue(hql.getAllValues().get(1).contains("pov.id in (:povid)"));
+		verify(resultQuery).setParameter("povid", Collections.singletonList(34L));
+	}
+}
