+        for (ProductAvailability availability : availabilities) {
+            if (sku.equals(availability.getSku())) {
+                return availability;
+            }
+            if (availability.getProductVariant() == null && fallback == null) {
+                fallback = availability;
+            }
+        }
+        if (fallback != null) {
+            return fallback;
+        }
