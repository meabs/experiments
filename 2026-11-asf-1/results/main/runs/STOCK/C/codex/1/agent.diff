+    private Map<String, Integer> aggregateQuantities(List<ShoppingCartItem> items) {
+        Map<String, Integer> quantitiesBySku = new HashMap<>();
+        for (ShoppingCartItem item : items) {
+            quantitiesBySku.merge(item.getSku(), item.getQuantity(), Integer::sum);
+        }
+        return quantitiesBySku;
+    }
+
+    private void validateInventory(Map<String, Integer> quantitiesBySku, MerchantStore store) {
+        for (Map.Entry<String, Integer> entry : quantitiesBySku.entrySet()) {
+            ProductAvailability availability = inventoryFor(entry.getKey(), store);
+            if (entry.getValue() < 0 || availability.getProductQuantity() == null
+                    || availability.getProductQuantity() < entry.getValue()) {
+                throw new InventoryConflictException("Insufficient stock for product " + entry.getKey());
+            }
+        }
+    }
