+    private Map<String, ProductAvailability> validateInventory(List<ShoppingCartItem> items, MerchantStore store)
+            throws ServiceException {
+        Map<String, Integer> requested = new TreeMap<>();
+        for (ShoppingCartItem item : items) {
+            requested.merge(item.getSku(), item.getQuantity(), Integer::sum);
+        }
 
+        Map<String, ProductAvailability> locked = new HashMap<>();
+        for (Map.Entry<String, Integer> request : requested.entrySet()) {
+            Product product = productService.getBySku(request.getKey(), store);
+            if (product == null) {
+                throw new ServiceException(ServiceException.EXCEPTION_INVENTORY_MISMATCH,
+                        "Insufficient stock for product " + request.getKey());
+            }
+            ProductAvailability selected = stockAvailability(product);
+            ProductAvailability availability = entityManager.find(ProductAvailability.class, selected.getId(),
+                    LockModeType.PESSIMISTIC_WRITE);
+            if (availability == null || availability.getProductQuantity() == null
+                    || availability.getProductQuantity() < request.getValue()) {
+                throw new ServiceException(ServiceException.EXCEPTION_INVENTORY_MISMATCH,
+                        "Insufficient stock for product " + request.getKey());
+            }
+            locked.put(request.getKey(), availability);
+        }
+        return locked;
+    }
 
