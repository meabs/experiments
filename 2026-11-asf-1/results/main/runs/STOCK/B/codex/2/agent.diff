@@ -0,0 +1,28 @@
+package com.salesmanager.core.business.utils;
+
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+
+/** Selects the inventory record represented as product quantity by the APIs. */
+public final class ProductInventoryUtils {
+    private ProductInventoryUtils() {
+    }
+
+    public static ProductAvailability getStock(Product product) {
+        if (product == null || product.getAvailabilities() == null || product.getAvailabilities().isEmpty()) {
+            return null;
+        }
+        for (ProductAvailability availability : product.getAvailabilities()) {
+            if (availability.getProductVariant() == null
+                    && (availability.getRegionVariant() == null || availability.getRegionVariant().isEmpty())) {
+                return availability;
+            }
+        }
+        return product.getAvailabilities().iterator().next();
+    }
+
+    public static int getQuantity(Product product) {
+        ProductAvailability stock = getStock(product);
+        return stock == null || stock.getProductQuantity() == null ? 0 : stock.getProductQuantity();
+    }
+}
