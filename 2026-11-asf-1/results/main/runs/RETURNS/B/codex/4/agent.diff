+package com.salesmanager.core.business.services.order;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.order.ReturnRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.payments.TransactionService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.Order;
+import com.salesmanager.core.model.order.OrderTotal;
+import com.salesmanager.core.model.order.OrderTotalType;
+import com.salesmanager.core.model.order.orderproduct.OrderProduct;
+import com.salesmanager.core.model.order.orderstatus.OrderStatus;
+import com.salesmanager.core.model.order.orderstatus.OrderStatusHistory;
+import com.salesmanager.core.model.order.returns.Return;
+import com.salesmanager.core.model.order.returns.ReturnLine;
+import com.salesmanager.core.model.payments.Transaction;
+import com.salesmanager.core.model.payments.TransactionType;
+
+@Service("returnService")
+public class ReturnServiceImpl implements ReturnService {
+    @Inject private ReturnRepository returnRepository;
+    @Inject private TransactionService transactionService;
+    @Inject private ProductService productService;
+    @Inject private OrderService orderService;
+
+    @Override
+    @Transactional
+    public Return createReturn(Order order, Map<String, Integer> requested, boolean restock, String reason,
+            MerchantStore store) throws ServiceException {
+        Map<String, Integer> already = new HashMap<>();
+        for (Return prior : returnRepository.findByOrderIdOrderByDateAscIdAsc(order.getId()))
+            for (ReturnLine line : prior.getLines()) already.merge(line.getSku(), line.getQuantity(), Integer::sum);
+        Map<String, OrderProduct> products = new HashMap<>();
+        BigDecimal subtotal = BigDecimal.ZERO;
+        for (OrderProduct product : order.getOrderProducts()) {
+            products.put(product.getSku(), product);
+            subtotal = subtotal.add(product.getOneTimeCharge().multiply(BigDecimal.valueOf(product.getProductQuantity())));
+        }
+        if (requested.isEmpty()) throw new IllegalArgumentException("At least one return line is required");
+        for (Map.Entry<String, Integer> entry : requested.entrySet()) {
+            OrderProduct product = products.get(entry.getKey());
+            if (product == null || entry.getValue() == null || entry.getValue() <= 0
+                    || entry.getValue() + already.getOrDefault(entry.getKey(), 0) > product.getProductQuantity())
+                throw new IllegalArgumentException("Invalid return quantity for sku " + entry.getKey());
+        }
+        BigDecimal lineAmount = BigDecimal.ZERO;
+        for (Map.Entry<String, Integer> entry : requested.entrySet())
+            lineAmount = lineAmount.add(products.get(entry.getKey()).getOneTimeCharge().multiply(BigDecimal.valueOf(entry.getValue())));
+        BigDecimal orderTax = BigDecimal.ZERO;
+        for (OrderTotal total : order.getOrderTotal()) if (total.getOrderTotalType() == OrderTotalType.TAX) orderTax = orderTax.add(total.getValue());
+        BigDecimal refundedTax = BigDecimal.ZERO;
+        BigDecimal refundedAmount = BigDecimal.ZERO;
+        for (Return prior : returnRepository.findByOrderIdOrderByDateAscIdAsc(order.getId())) {
+            refundedTax = refundedTax.add(prior.getTax());
+            refundedAmount = refundedAmount.add(prior.getAmount());
+        }
+        int returnedUnits = already.values().stream().mapToInt(Integer::intValue).sum();
+        int totalUnits = products.values().stream().mapToInt(OrderProduct::getProductQuantity).sum();
+        int requestedUnits = requested.values().stream().mapToInt(Integer::intValue).sum();
+        BigDecimal tax = returnedUnits + requestedUnits == totalUnits ? orderTax.subtract(refundedTax)
+                : orderTax.multiply(lineAmount).divide(subtotal, 10, RoundingMode.HALF_UP).setScale(2, RoundingMode.HALF_UP);
+        tax = tax.max(BigDecimal.ZERO).setScale(2, RoundingMode.HALF_UP);
+        Return result = new Return(); result.setOrder(order); result.setTax(tax); result.setAmount(lineAmount.add(tax));
+        result.setRestocked(restock); result.setReason(reason); result.setDate(new Date());
+        for (Map.Entry<String, Integer> entry : requested.entrySet()) {
+            ReturnLine line = new ReturnLine(); line.setOrderReturn(result); line.setSku(entry.getKey()); line.setQuantity(entry.getValue());
+            line.setAmount(products.get(entry.getKey()).getOneTimeCharge().multiply(BigDecimal.valueOf(entry.getValue()))); result.getLines().add(line);
+            if (restock) {
+                Product product = productService.getBySku(entry.getKey(), store);
+                if (product != null) for (ProductAvailability availability : product.getAvailabilities()) availability.setProductQuantity(availability.getProductQuantity() + entry.getValue());
+                if (product != null) productService.update(product);
+            }
+        }
+        boolean complete = returnedUnits + requestedUnits == totalUnits;
+        if (complete) order.setStatus(OrderStatus.REFUNDED);
+        OrderStatusHistory history = new OrderStatusHistory(); history.setOrder(order); history.setStatus(order.getStatus()); history.setDateAdded(new Date());
+        history.setComments("Refunded " + result.getAmount()); order.getOrderHistory().add(history);
+        Transaction transaction = new Transaction(); transaction.setOrder(order); transaction.setAmount(result.getAmount()); transaction.setTransactionDate(new Date()); transaction.setTransactionType(TransactionType.REFUND); transactionService.create(transaction);
+        OrderTotal refund = null;
+        for (OrderTotal total : order.getOrderTotal()) if ("order.total.refunded".equals(total.getOrderTotalCode())) { refund = total; break; }
+        if (refund == null) { refund = new OrderTotal(); refund.setOrder(order); refund.setOrderTotalCode("order.total.refunded"); refund.setTitle("order.total.refunded"); refund.setText("order.total.refunded"); refund.setModule("refund"); refund.setOrderTotalType(OrderTotalType.REFUND); refund.setSortOrder(100); order.getOrderTotal().add(refund); }
+        refund.setValue(refundedAmount.add(result.getAmount()));
+        order.setLastModified(new Date());
+        orderService.saveOrUpdate(order);
+        returnRepository.saveAndFlush(result);
+        return result;
+    }
+
+    @Override public List<Return> listReturns(Order order) { return returnRepository.findByOrderIdOrderByDateAscIdAsc(order.getId()); }
+}
