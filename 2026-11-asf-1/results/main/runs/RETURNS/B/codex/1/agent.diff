+package com.salesmanager.shop.store.api.v1.order;
+
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestMethod;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.order.OrderService;
+import com.salesmanager.core.business.services.order.returns.OrderReturnService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.Order;
+import com.salesmanager.core.model.order.OrderReturn;
+import com.salesmanager.core.model.order.orderstatus.OrderStatus;
+import com.salesmanager.shop.model.order.returns.PersistableOrderReturn;
+import com.salesmanager.shop.model.order.returns.ReadableOrderReturn;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class OrderReturnApi {
+    @Inject private OrderService orderService;
+    @Inject private OrderReturnService returnService;
+
+    @RequestMapping(value = "/private/orders/{id}/returns", method = RequestMethod.POST)
+    @ResponseStatus(HttpStatus.CREATED)
+    @ResponseBody
+    public ReadableOrderReturn create(@PathVariable Long id, @RequestBody PersistableOrderReturn request,
+            @ApiIgnore MerchantStore store) {
+        return process(id, request, store);
+    }
+
+    @RequestMapping(value = "/private/orders/{id}/returns", method = RequestMethod.GET)
+    @ResponseBody
+    public List<ReadableOrderReturn> list(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        Order order = find(id, store);
+        try { return returnService.list(order).stream().map(this::read).collect(Collectors.toList()); }
+        catch (ServiceException e) { throw new IllegalStateException(e); }
+    }
+
+    @RequestMapping(value = "/private/orders/{id}/refund", method = RequestMethod.POST)
+    @ResponseStatus(HttpStatus.CREATED)
+    @ResponseBody
+    public ReadableOrderReturn refund(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        Order order = find(id, store);
+        PersistableOrderReturn request = new PersistableOrderReturn();
+        Map<String, Integer> returned = new LinkedHashMap<>();
+        try { for (OrderReturn prior : returnService.list(order)) for (com.salesmanager.core.model.order.OrderReturnLine line : prior.getLines()) returned.merge(line.getSku(), line.getQuantity(), Integer::sum); }
+        catch (ServiceException e) { throw new IllegalStateException(e); }
+        List<PersistableOrderReturn.Line> lines = order.getOrderProducts().stream().map(product -> { PersistableOrderReturn.Line line = new PersistableOrderReturn.Line(); line.setSku(product.getSku()); line.setQuantity(product.getProductQuantity() - returned.getOrDefault(product.getSku(), 0)); return line; }).filter(line -> line.getQuantity() > 0).collect(Collectors.toList());
+        request.setLines(lines); request.setRestock(false); request.setReason("refund");
+        return process(order, request, store);
+    }
+
+    private ReadableOrderReturn process(Long id, PersistableOrderReturn request, MerchantStore store) { return process(find(id, store), request, store); }
+    private ReadableOrderReturn process(Order order, PersistableOrderReturn request, MerchantStore store) {
+        if (order.getStatus() == OrderStatus.CANCELED || order.getStatus() == OrderStatus.REFUNDED) throw new ReturnConflictException("Order cannot be returned");
+        Map<String, Integer> lines = new LinkedHashMap<>();
+        if (request != null && request.getLines() != null) for (PersistableOrderReturn.Line line : request.getLines()) lines.merge(line.getSku(), line.getQuantity(), Integer::sum);
+        try { return read(returnService.create(order, store, lines, request != null && request.isRestock(), request == null ? null : request.getReason())); }
+        catch (ServiceException e) { throw new ReturnBadRequestException(e.getMessage()); }
+    }
+    private Order find(Long id, MerchantStore store) { Order order = orderService.getOrder(id, store); if (order == null) throw new ResourceNotFoundException("Order " + id + " not found"); return order; }
