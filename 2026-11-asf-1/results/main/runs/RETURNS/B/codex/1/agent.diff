+    private static final long serialVersionUID = 1L;
+
+    @Id
+    @Column(name = "ORDER_RETURN_ID")
+    @TableGenerator(name = "TABLE_GEN", table = "SM_SEQUENCER", pkColumnName = "SEQ_NAME", valueColumnName = "SEQ_COUNT", pkColumnValue = "ORDER_RETURN_ID_NEXT_VALUE")
