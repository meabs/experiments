+package com.salesmanager.core.business.services.order.returns;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.util.Date;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.order.OrderReturnRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.availability.ProductAvailabilityService;
+import com.salesmanager.core.business.services.order.OrderService;
+import com.salesmanager.core.business.services.payments.TransactionService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.Order;
+import com.salesmanager.core.model.order.OrderReturn;
+import com.salesmanager.core.model.order.OrderReturnLine;
+import com.salesmanager.core.model.order.OrderTotal;
+import com.salesmanager.core.model.order.OrderTotalType;
+import com.salesmanager.core.model.order.orderproduct.OrderProduct;
+import com.salesmanager.core.model.order.orderstatus.OrderStatus;
+import com.salesmanager.core.model.order.orderstatus.OrderStatusHistory;
+import com.salesmanager.core.model.payments.Transaction;
+import com.salesmanager.core.model.payments.TransactionType;
+
+@Service("orderReturnService")
+public class OrderReturnServiceImpl implements OrderReturnService {
+    private final OrderReturnRepository repository;
+    private final OrderService orderService;
+    private final TransactionService transactionService;
+    private final ProductService productService;
+    private final ProductAvailabilityService availabilityService;
+
+    @Inject
+    public OrderReturnServiceImpl(OrderReturnRepository repository, OrderService orderService,
+            TransactionService transactionService, ProductService productService,
+            ProductAvailabilityService availabilityService) {
+        this.repository = repository;
+        this.orderService = orderService;
+        this.transactionService = transactionService;
+        this.productService = productService;
+        this.availabilityService = availabilityService;
+    }
+
+    @Override
+    @Transactional
+    public OrderReturn create(Order order, MerchantStore store, Map<String, Integer> requested,
+            boolean restock, String reason) throws ServiceException {
+        if (requested == null || requested.isEmpty()) throw new ServiceException("At least one return line is required");
+        Map<String, Integer> returned = new LinkedHashMap<>();
+        for (OrderReturn prior : repository.findByOrderIdOrderByDateAscIdAsc(order.getId())) {
+            for (OrderReturnLine line : prior.getLines()) returned.merge(line.getSku(), line.getQuantity(), Integer::sum);
+        }
+        Map<String, OrderProduct> products = new LinkedHashMap<>();
+        for (OrderProduct product : order.getOrderProducts()) products.put(product.getSku(), product);
+        BigDecimal productSubtotal = BigDecimal.ZERO;
+        for (OrderProduct product : order.getOrderProducts()) {
+            productSubtotal = productSubtotal.add(product.getOneTimeCharge().multiply(BigDecimal.valueOf(product.getProductQuantity())));
+        }
+        BigDecimal orderTax = BigDecimal.ZERO;
+        for (OrderTotal total : order.getOrderTotal()) if (total.getOrderTotalType() == OrderTotalType.TAX) orderTax = orderTax.add(total.getValue());
+        BigDecimal lineAmount = BigDecimal.ZERO;
+        for (Map.Entry<String, Integer> entry : requested.entrySet()) {
+            if (entry.getKey() == null || entry.getValue() == null || entry.getValue() <= 0 || !products.containsKey(entry.getKey()))
+                throw new ServiceException("Invalid return line");
+            OrderProduct product = products.get(entry.getKey());
+            int total = returned.getOrDefault(entry.getKey(), 0) + entry.getValue();
+            if (total > product.getProductQuantity()) throw new ServiceException("Return quantity exceeds ordered quantity");
+            lineAmount = lineAmount.add(product.getOneTimeCharge().multiply(BigDecimal.valueOf(entry.getValue())));
+        }
+        BigDecimal alreadyTax = BigDecimal.ZERO;
+        for (OrderReturn prior : repository.findByOrderIdOrderByDateAscIdAsc(order.getId())) alreadyTax = alreadyTax.add(prior.getTax());
+        BigDecimal tax = productSubtotal.signum() == 0 ? BigDecimal.ZERO
+                : orderTax.multiply(lineAmount).divide(productSubtotal, 2, RoundingMode.HALF_UP);
+        boolean complete = true;
+        for (OrderProduct product : order.getOrderProducts()) {
+            if (returned.getOrDefault(product.getSku(), 0) + requested.getOrDefault(product.getSku(), 0) < product.getProductQuantity()) complete = false;
+        }
+        if (complete) tax = orderTax.subtract(alreadyTax).setScale(2, RoundingMode.HALF_UP);
+        tax = tax.setScale(2, RoundingMode.HALF_UP);
+        OrderReturn result = new OrderReturn();
+        result.setOrder(order); result.setTax(tax); result.setAmount(lineAmount.add(tax).setScale(2, RoundingMode.HALF_UP));
+        result.setRestocked(restock); result.setReason(reason); result.setDate(new Date());
+        for (Map.Entry<String, Integer> entry : requested.entrySet()) {
+            OrderProduct product = products.get(entry.getKey());
+            OrderReturnLine line = new OrderReturnLine(); line.setOrderReturn(result); line.setSku(entry.getKey()); line.setQuantity(entry.getValue());
+            line.setAmount(product.getOneTimeCharge().multiply(BigDecimal.valueOf(entry.getValue())).setScale(2, RoundingMode.HALF_UP));
+            result.getLines().add(line);
+            if (restock) {
+                Product catalogProduct = productService.getBySku(entry.getKey(), store);
+                if (catalogProduct != null) for (ProductAvailability availability : catalogProduct.getAvailabilities()) {
+                    availability.setProductQuantity(availability.getProductQuantity() + entry.getValue());
+                    availabilityService.saveOrUpdate(availability);
+                }
+            }
+        }
+        repository.save(result);
+        Transaction transaction = new Transaction(); transaction.setOrder(order); transaction.setAmount(result.getAmount()); transaction.setTransactionType(TransactionType.REFUND); transaction.setTransactionDate(new Date()); transactionService.create(transaction);
+        BigDecimal refunded = result.getAmount();
+        OrderTotal refundedTotal = null;
+        for (OrderTotal total : order.getOrderTotal()) {
+            if ("order.total.refunded".equals(total.getOrderTotalCode())) { refundedTotal = total; break; }
+        }
+        if (refundedTotal == null) {
+            refundedTotal = new OrderTotal(); refundedTotal.setOrder(order); refundedTotal.setOrderTotalCode("order.total.refunded");
+            refundedTotal.setModule("refund"); refundedTotal.setTitle("order.total.refunded"); refundedTotal.setText("order.total.refunded");
+            refundedTotal.setOrderTotalType(OrderTotalType.REFUND); refundedTotal.setSortOrder(100); order.getOrderTotal().add(refundedTotal);
+        }
+        for (OrderReturn prior : repository.findByOrderIdOrderByDateAscIdAsc(order.getId())) refunded = refunded.add(prior.getAmount());
+        refundedTotal.setValue(refunded.setScale(2, RoundingMode.HALF_UP));
+        if (complete) order.setStatus(OrderStatus.REFUNDED);
+        OrderStatusHistory history = new OrderStatusHistory(); history.setOrder(order); history.setStatus(order.getStatus()); history.setDateAdded(new Date()); history.setComments("Refunded " + result.getAmount()); order.getOrderHistory().add(history);
+        orderService.saveOrUpdate(order);
+        return result;
+    }
+
+    @Override
+    public List<OrderReturn> list(Order order) throws ServiceException { return repository.findByOrderIdOrderByDateAscIdAsc(order.getId()); }
+}
