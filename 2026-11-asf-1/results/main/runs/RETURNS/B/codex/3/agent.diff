+package com.salesmanager.shop.store.controller.order.returns;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDate;
+import java.util.Date;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.salesmanager.core.business.repositories.order.OrderReturnRepository;
+import com.salesmanager.core.business.repositories.payments.TransactionRepository;
+import com.salesmanager.core.business.services.catalog.product.availability.ProductAvailabilityService;
+import com.salesmanager.core.business.services.order.OrderService;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.Order;
+import com.salesmanager.core.model.order.OrderReturn;
+import com.salesmanager.core.model.order.OrderReturnLine;
+import com.salesmanager.core.model.order.orderproduct.OrderProduct;
+import com.salesmanager.core.model.order.orderstatus.OrderStatus;
+import com.salesmanager.core.model.order.orderstatus.OrderStatusHistory;
+import com.salesmanager.core.model.payments.Transaction;
+import com.salesmanager.core.model.payments.TransactionType;
+import com.salesmanager.shop.model.order.returns.PersistableReturn;
+import com.salesmanager.shop.model.order.returns.PersistableReturnLine;
+import com.salesmanager.shop.store.api.exception.ReturnValidationException;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+
+@Service
+public class OrderReturnService {
+    private static final String REFUNDED_TOTAL = "order.total.refunded";
+
+    @Inject private OrderService orderService;
+    @Inject private OrderReturnRepository returnRepository;
+    @Inject private TransactionRepository transactionRepository;
+    @Inject private ProductAvailabilityService availabilityService;
+
+    @Transactional
+    public OrderReturn create(Long id, MerchantStore store, PersistableReturn request) {
+        Order order = orderService.getOrder(id, store);
+        if (order == null) throw new ResourceNotFoundException("Order " + id + " does not exist");
+        if (order.getStatus() == OrderStatus.CANCELED || order.getStatus() == OrderStatus.REFUNDED) {
+            throw new ReturnValidationException("Order cannot be returned in status " + order.getStatus(), true);
+        }
+        if (request == null || request.getLines() == null || request.getLines().isEmpty()) {
+            throw new ReturnValidationException("At least one return line is required");
+        }
+
+        Map<String, Integer> requested = new LinkedHashMap<>();
+        for (PersistableReturnLine line : request.getLines()) {
+            if (line == null || line.getSku() == null || line.getSku().trim().isEmpty() || line.getQuantity() <= 0) {
+                throw new ReturnValidationException("Each return line needs a product sku and a positive quantity");
+            }
+            requested.merge(line.getSku(), line.getQuantity(), Integer::sum);
+        }
+
+        Map<String, OrderProduct> products = order.getOrderProducts().stream()
+            .collect(Collectors.toMap(OrderProduct::getSku, p -> p, (a, b) -> a, LinkedHashMap::new));
+        Map<String, Integer> returned = returnRepository.findByOrderId(id).stream().flatMap(r -> r.getLines().stream())
+            .collect(Collectors.groupingBy(OrderReturnLine::getSku, Collectors.summingInt(OrderReturnLine::getQuantity)));
+        for (Map.Entry<String, Integer> entry : requested.entrySet()) {
+            OrderProduct product = products.get(entry.getKey());
+            if (product == null || entry.getValue() + returned.getOrDefault(entry.getKey(), 0) > product.getProductQuantity()) {
+                throw new ReturnValidationException("Return quantity exceeds the ordered quantity for " + entry.getKey());
+            }
+        }
+
