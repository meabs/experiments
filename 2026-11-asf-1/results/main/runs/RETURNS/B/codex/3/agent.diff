+package com.salesmanager.shop.store.api.v1.order;
+
+import java.util.List;
+import java.util.stream.Collectors;
+import java.util.stream.Stream;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestMethod;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.repositories.order.OrderReturnRepository;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.OrderReturn;
+import com.salesmanager.core.model.order.OrderReturnLine;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.model.order.returns.PersistableReturn;
+import com.salesmanager.shop.model.order.returns.ReadableReturn;
+import com.salesmanager.shop.model.order.returns.ReadableReturnLine;
+import com.salesmanager.shop.store.controller.order.returns.OrderReturnService;
+import com.salesmanager.shop.utils.AuthorizationUtils;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class OrderReturnApi {
+    @Inject private OrderReturnService returnService;
+    @Inject private OrderReturnRepository returnRepository;
+    @Inject private AuthorizationUtils authorizationUtils;
+
+    @RequestMapping(value = "/private/orders/{id}/returns", method = RequestMethod.POST)
+    @ResponseStatus(HttpStatus.CREATED)
+    @ResponseBody
+    public ReadableReturn create(@PathVariable Long id, @RequestBody PersistableReturn request, @ApiIgnore MerchantStore store, @ApiIgnore Language language) {
+        authorize(store); return map(returnService.create(id, store, request));
+    }
+
+    @RequestMapping(value = "/private/orders/{id}/returns", method = RequestMethod.GET)
+    @ResponseBody
+    public List<ReadableReturn> list(@PathVariable Long id, @ApiIgnore MerchantStore store, @ApiIgnore Language language) {
+        authorize(store); return returnService.list(id, store).stream().map(OrderReturnApi::map).collect(Collectors.toList());
+    }
+
+    private void authorize(MerchantStore store) {
+        String user = authorizationUtils.authenticatedUser();
+        authorizationUtils.authorizeUser(user, Stream.of(Constants.GROUP_SUPERADMIN, Constants.GROUP_ADMIN, Constants.GROUP_ADMIN_ORDER, Constants.GROUP_ADMIN_RETAIL).collect(Collectors.toList()), store);
+    }
+    public static ReadableReturn map(OrderReturn source) {
+        ReadableReturn result = new ReadableReturn(); result.setId(source.getId()); result.setOrderId(source.getOrder().getId()); result.setTax(source.getTax()); result.setAmount(source.getAmount()); result.setRestocked(source.isRestocked()); result.setReason(source.getReason()); result.setDate(source.getDate());
+        for (OrderReturnLine sourceLine : source.getLines()) { ReadableReturnLine line = new ReadableReturnLine(); line.setSku(sourceLine.getSku()); line.setQuantity(sourceLine.getQuantity()); line.setAmount(sourceLine.getAmount()); result.getLines().add(line); }
+        return result;
+    }
+}
