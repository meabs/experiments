+package com.salesmanager.shop.store.api.v1.order;
+
+import java.util.*; import java.util.stream.*; import javax.inject.Inject;
+import org.springframework.http.HttpStatus; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.order.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.order.*; import com.salesmanager.core.model.order.orderproduct.OrderProduct;
+import com.salesmanager.shop.constants.Constants; import com.salesmanager.shop.model.order.returns.*; import com.salesmanager.shop.store.api.exception.*; import com.salesmanager.shop.utils.AuthorizationUtils; import io.swagger.annotations.*; import springfox.documentation.annotations.ApiIgnore;
+
+@RestController @RequestMapping("/api/v1") @Api(tags={"Order returns api"})
+public class OrderReturnApi {
+ @Inject private OrderService orderService; @Inject private OrderReturnService returnService; @Inject private AuthorizationUtils authorizationUtils;
+ private void authorize(MerchantStore store){String user=authorizationUtils.authenticatedUser(); authorizationUtils.authorizeUser(user,Stream.of(Constants.GROUP_SUPERADMIN,Constants.GROUP_ADMIN,Constants.GROUP_ADMIN_ORDER,Constants.GROUP_ADMIN_RETAIL).collect(Collectors.toList()),store);}
+ @PostMapping("/private/orders/{id}/returns") @ResponseStatus(HttpStatus.CREATED) public ReadableReturn create(@PathVariable Long id,@RequestBody PersistableReturn request,@ApiIgnore MerchantStore store){authorize(store); return map(createInternal(id,store,request));}
+ @GetMapping("/private/orders/{id}/returns") public List<ReadableReturn> list(@PathVariable Long id,@ApiIgnore MerchantStore store){authorize(store); Order order=getOrder(id,store); return returnService.list(order).stream().map(this::map).collect(Collectors.toList());}
+ @PostMapping("/private/orders/{id}/refund") @ResponseStatus(HttpStatus.CREATED) public ReadableReturn refund(@PathVariable Long id,@ApiIgnore MerchantStore store){authorize(store); Order order=getOrder(id,store); List<PersistableReturnLine> lines=order.getOrderProducts().stream().map(p->{PersistableReturnLine l=new PersistableReturnLine();l.setSku(p.getSku());l.setQuantity(p.getProductQuantity());return l;}).collect(Collectors.toList()); for(OrderReturn r:returnService.list(order)) for(OrderReturnLine l:r.getLines()) lines.stream().filter(x->x.getSku().equals(l.getSku())).findFirst().ifPresent(x->x.setQuantity(x.getQuantity()-l.getQuantity())); PersistableReturn req=new PersistableReturn(); req.setLines(lines.stream().filter(x->x.getQuantity()>0).collect(Collectors.toList())); req.setRestock(false); req.setReason("refund"); return map(createInternal(id,store,req));}
+ private OrderReturn createInternal(Long id,MerchantStore store,PersistableReturn request){Order order=getOrder(id,store); if(request==null)throw new RestApiException("400","Return body is required"); try{return returnService.create(order,store,request.getLines()==null?null:request.getLines().stream().map(x->new OrderReturnService.ReturnLineRequest(x.getSku(),x.getQuantity())).collect(Collectors.toList()),request.isRestock(),request.getReason());}catch(IllegalStateException e){throw new ReturnConflictException(e.getMessage());}catch(IllegalArgumentException e){throw new RestApiException("400",e.getMessage());}}
+ private Order getOrder(Long id,MerchantStore store){Order order=orderService.getOrder(id,store); if(order==null)throw new ResourceNotFoundException("Order " + id + " does not exist"); return order;}
+ private ReadableReturn map(OrderReturn source){ReadableReturn r=new ReadableReturn();r.setId(source.getId());r.setOrderId(source.getOrder().getId());r.setTax(source.getTax());r.setAmount(source.getAmount());r.setRestocked(source.isRestocked());r.setReason(source.getReason());r.setDate(source.getDate());r.setLines(source.getLines().stream().map(l->{ReadableReturnLine x=new ReadableReturnLine();x.setSku(l.getSku());x.setQuantity(l.getQuantity());x.setAmount(l.getAmount());return x;}).collect(Collectors.toList()));return r;}
+}
