+package com.salesmanager.core.business.services.order;
+
+import java.math.*; import java.util.*; import java.util.stream.Collectors;
+import javax.inject.Inject; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.order.OrderReturnRepository; import com.salesmanager.core.business.services.catalog.product.availability.ProductAvailabilityService; import com.salesmanager.core.business.services.payments.TransactionService; import com.salesmanager.core.model.catalog.product.availability.ProductAvailability; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.order.*; import com.salesmanager.core.model.order.orderproduct.OrderProduct; import com.salesmanager.core.model.order.orderstatus.*; import com.salesmanager.core.model.order.OrderTotalType; import com.salesmanager.core.model.payments.*;
+
+@Service("orderReturnService")
+public class OrderReturnServiceImpl implements OrderReturnService {
+    private final OrderReturnRepository repository; @Inject private TransactionService transactionService; @Inject private ProductAvailabilityService availabilityService; @Inject private OrderService orderService;
+    @Inject public OrderReturnServiceImpl(OrderReturnRepository repository){this.repository=repository;}
+    @Override @Transactional
+    public OrderReturn create(Order order, MerchantStore store, List<ReturnLineRequest> requests, boolean restock, String reason) {
+        if (requests==null || requests.isEmpty()) throw new IllegalArgumentException("At least one return line is required");
+        if (order==null) throw new NoSuchElementException("Order does not exist");
+        if (order.getStatus()==OrderStatus.CANCELED || order.getStatus()==OrderStatus.REFUNDED) throw new IllegalStateException("Order cannot be returned");
+        Map<String,Integer> wanted=new LinkedHashMap<>(); for(ReturnLineRequest r:requests){ if(r==null||r.sku==null||r.quantity<=0) throw new IllegalArgumentException("Invalid return line"); wanted.merge(r.sku,r.quantity,Integer::sum); }
+        Map<String,Integer> returned=new HashMap<>(); for(OrderReturn old:repository.findByOrderIdOrderByDateAscIdAsc(order.getId())) for(OrderReturnLine l:old.getLines()) returned.merge(l.getSku(),l.getQuantity(),Integer::sum);
+        Map<String,OrderProduct> products=order.getOrderProducts().stream().collect(Collectors.toMap(OrderProduct::getSku,p->p,(a,b)->a));
+        BigDecimal subtotal=BigDecimal.ZERO, lineTotal=BigDecimal.ZERO; for(Map.Entry<String,Integer> e:wanted.entrySet()){ OrderProduct p=products.get(e.getKey()); if(p==null || returned.getOrDefault(e.getKey(),0)+e.getValue()>p.getProductQuantity()) throw new IllegalArgumentException("Invalid return quantity for " + e.getKey()); BigDecimal amount=p.getOneTimeCharge().multiply(BigDecimal.valueOf(e.getValue())).setScale(2,RoundingMode.HALF_UP); lineTotal=lineTotal.add(amount); subtotal=subtotal.add(p.getOneTimeCharge().multiply(BigDecimal.valueOf(p.getProductQuantity()))); }
+        BigDecimal orderTax=order.getOrderTotal().stream().filter(t->t.getOrderTotalType()==OrderTotalType.TAX).map(OrderTotal::getValue).filter(Objects::nonNull).reduce(BigDecimal.ZERO,BigDecimal::add).setScale(2,RoundingMode.HALF_UP);
+        BigDecimal already=repository.findByOrderIdOrderByDateAscIdAsc(order.getId()).stream().map(OrderReturn::getTax).reduce(BigDecimal.ZERO,BigDecimal::add);
+        int totalUnits=order.getOrderProducts().stream().mapToInt(OrderProduct::getProductQuantity).sum(), returnedUnits=returned.values().stream().mapToInt(Integer::intValue).sum()+wanted.values().stream().mapToInt(Integer::intValue).sum();
+        BigDecimal tax=returnedUnits==totalUnits ? orderTax.subtract(already) : subtotal.signum()==0?BigDecimal.ZERO:orderTax.multiply(lineTotal).divide(subtotal,2,RoundingMode.HALF_UP); tax=tax.max(BigDecimal.ZERO).setScale(2,RoundingMode.HALF_UP); BigDecimal amount=lineTotal.add(tax);
+        OrderReturn result=new OrderReturn(); result.setOrder(order); result.setRestocked(restock); result.setReason(reason); result.setDate(new Date()); result.setTax(tax); result.setAmount(amount);
+        for(Map.Entry<String,Integer> e:wanted.entrySet()){ OrderProduct p=products.get(e.getKey()); OrderReturnLine l=new OrderReturnLine(); l.setOrderReturn(result); l.setSku(e.getKey()); l.setQuantity(e.getValue()); l.setAmount(p.getOneTimeCharge().multiply(BigDecimal.valueOf(e.getValue())).setScale(2,RoundingMode.HALF_UP)); result.getLines().add(l); if(restock){ try { for(ProductAvailability a:availabilityService.getBySku(e.getKey(),store)){a.setProductQuantity(a.getProductQuantity()+e.getValue()); availabilityService.saveOrUpdate(a); break;} } catch(Exception ex){throw new IllegalStateException(ex);} } }
+        repository.saveAndFlush(result);
+        Transaction trx=new Transaction(); trx.setOrder(order); trx.setAmount(amount); trx.setTransactionType(TransactionType.REFUND); trx.setPaymentType(order.getPaymentType()); trx.setTransactionDate(new Date()); try { transactionService.create(trx); } catch(Exception ex){throw new IllegalStateException(ex);}
+        if(returnedUnits==totalUnits) order.setStatus(OrderStatus.REFUNDED); OrderStatusHistory h=new OrderStatusHistory(); h.setOrder(order); h.setStatus(order.getStatus()); h.setDateAdded(new Date()); h.setComments("Refunded " + amount); order.getOrderHistory().add(h);
+        OrderTotal total=new OrderTotal(); total.setModule("order.total.refunded"); total.setText("order.total.refunded"); total.setTitle("order.total.refunded"); total.setOrderTotalCode("order.total.refunded"); total.setOrderTotalType(OrderTotalType.REFUND); total.setValue(amount.add(order.getOrderTotal().stream().filter(t->"order.total.refunded".equals(t.getOrderTotalCode())).map(OrderTotal::getValue).filter(Objects::nonNull).reduce(BigDecimal.ZERO,BigDecimal::add))); total.setSortOrder(100); total.setOrder(order); order.getOrderTotal().removeIf(t->"order.total.refunded".equals(t.getOrderTotalCode())); order.getOrderTotal().add(total); try { orderService.saveOrUpdate(order); } catch(Exception ex){throw new IllegalStateException(ex);}
+        return result;
+    }
+    public List<OrderReturn> list(Order order){return repository.findByOrderIdOrderByDateAscIdAsc(order.getId());}
+}
