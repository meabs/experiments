+package com.salesmanager.shop.store.api.v1.order;
+
+import java.time.ZoneId;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestMethod;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import com.salesmanager.core.business.services.order.OrderReturnService;
+import com.salesmanager.core.business.services.order.OrderReturnValidationException;
+import com.salesmanager.core.business.services.order.OrderService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.Order;
+import com.salesmanager.core.model.order.OrderReturn;
+import com.salesmanager.core.model.order.OrderReturnLine;
+import com.salesmanager.core.model.order.orderproduct.OrderProduct;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.model.order.returnrequest.PersistableOrderReturn;
+import com.salesmanager.shop.model.order.returnrequest.PersistableOrderReturnLine;
+import com.salesmanager.shop.model.order.returnrequest.ReadableOrderReturn;
+import com.salesmanager.shop.model.order.returnrequest.ReadableOrderReturnLine;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.utils.AuthorizationUtils;
+import com.salesmanager.shop.store.controller.order.facade.OrderFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@Controller
+@RequestMapping("/api/v1/private/orders/{id}")
+public class OrderReturnApi {
+    @Inject private OrderService orderService;
+    @Inject private OrderReturnService returnService;
+    @Inject private OrderFacade orderFacade;
+    @Inject private AuthorizationUtils authorizationUtils;
+
+    @RequestMapping(value="/returns", method=RequestMethod.POST)
+    @ResponseStatus(HttpStatus.CREATED) @ResponseBody
+    public ReadableOrderReturn create(@PathVariable Long id, @RequestBody PersistableOrderReturn request, @ApiIgnore MerchantStore store, @ApiIgnore Language language) {
+        authorize(store); Order order = find(id, store); Map<String,Integer> lines = request == null ? null : requested(request.getLines());
+        return readable(returnService.create(order, lines, request != null && request.isRestock(), request == null ? null : request.getReason(), store));
+    }
+
+    @RequestMapping(value="/returns", method=RequestMethod.GET)
+    @ResponseStatus(HttpStatus.OK) @ResponseBody
+    public List<ReadableOrderReturn> list(@PathVariable Long id, @ApiIgnore MerchantStore store, @ApiIgnore Language language) {
+        authorize(store); return returnService.list(find(id, store)).stream().map(this::readable).collect(Collectors.toList());
+    }
+
+    @RequestMapping(value="/refund", method=RequestMethod.POST)
+    @ResponseStatus(HttpStatus.CREATED) @ResponseBody
+    public ReadableOrderReturn refund(@PathVariable Long id, @ApiIgnore MerchantStore store, @ApiIgnore Language language) {
+        authorize(store); Order order = find(id, store); Map<String,Integer> returned = new LinkedHashMap<>();
+        for (OrderReturn prior : returnService.list(order)) for (OrderReturnLine line : prior.getLines()) returned.merge(line.getSku(), line.getQuantity(), Integer::sum);
+        Map<String,Integer> remaining = new LinkedHashMap<>(); for (OrderProduct product : order.getOrderProducts()) { int q=product.getProductQuantity()-returned.getOrDefault(product.getSku(),0); if(q>0) remaining.put(product.getSku(),q); }
+        if (remaining.isEmpty()) throw new com.salesmanager.core.business.services.order.OrderReturnConflictException("Order cannot be refunded");
+        return readable(returnService.create(order, remaining, false, "refund", store));
+    }
+    private void authorize(MerchantStore store) { String user=authorizationUtils.authenticatedUser(); authorizationUtils.authorizeUser(user, java.util.stream.Stream.of(Constants.GROUP_SUPERADMIN, Constants.GROUP_ADMIN, Constants.GROUP_ADMIN_ORDER, Constants.GROUP_ADMIN_RETAIL).collect(Collectors.toList()), store); }
+    private Order find(Long id, MerchantStore store) { Order o=orderService.getOrder(id,store); if(o==null) throw new ResourceNotFoundException("Order not found with id "+id); return o; }
+    private Map<String,Integer> requested(List<PersistableOrderReturnLine> values) { if(values==null) return null; Map<String,Integer> result=new LinkedHashMap<>(); for(PersistableOrderReturnLine line:values) { if(line==null || line.getSku()==null || line.getQuantity()==null || line.getQuantity()<=0) throw new OrderReturnValidationException("Invalid return line"); result.merge(line.getSku(), line.getQuantity(), Integer::sum); } return result; }
+    private ReadableOrderReturn readable(OrderReturn source) { ReadableOrderReturn target=new ReadableOrderReturn(); target.setId(source.getId()); target.setOrderId(source.getOrder().getId()); target.setTax(source.getTax()); target.setAmount(source.getAmount()); target.setRestocked(source.isRestocked()); target.setReason(source.getReason()); target.setDate(source.getDate().toInstant().atZone(ZoneId.systemDefault()).toLocalDate()); for(OrderReturnLine line:source.getLines()){ReadableOrderReturnLine l=new ReadableOrderReturnLine(); l.setSku(line.getSku()); l.setQuantity(line.getQuantity()); l.setAmount(line.getAmount()); target.getLines().add(l);} return target; }
+}
