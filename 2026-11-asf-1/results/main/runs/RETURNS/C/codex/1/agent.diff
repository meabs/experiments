+package com.salesmanager.core.business.services.order;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.util.Date;
+import java.util.List;
+import java.util.Map;
+import java.util.HashMap;
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.constants.Constants;
+import com.salesmanager.core.business.repositories.order.OrderReturnRepository;
+import com.salesmanager.core.business.services.catalog.product.availability.ProductAvailabilityService;
+import com.salesmanager.core.business.services.payments.TransactionService;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.Order;
+import com.salesmanager.core.model.order.OrderReturn;
+import com.salesmanager.core.model.order.OrderReturnLine;
+import com.salesmanager.core.model.order.OrderTotal;
+import com.salesmanager.core.model.order.OrderTotalType;
+import com.salesmanager.core.model.order.orderproduct.OrderProduct;
+import com.salesmanager.core.model.order.orderstatus.OrderStatus;
+import com.salesmanager.core.model.order.orderstatus.OrderStatusHistory;
+import com.salesmanager.core.model.payments.Transaction;
+import com.salesmanager.core.model.payments.TransactionType;
+
+@Service("orderReturnService")
+public class OrderReturnServiceImpl extends SalesManagerEntityServiceImpl<Long, OrderReturn> implements OrderReturnService {
+    private final OrderReturnRepository repository;
+    @Inject private OrderService orderService;
+    @Inject private TransactionService transactionService;
+    @Inject private ProductAvailabilityService availabilityService;
+
+    @Inject
+    public OrderReturnServiceImpl(OrderReturnRepository repository) { super(repository); this.repository = repository; }
+
+    @Override @Transactional
+    public OrderReturn create(Order order, Map<String, Integer> requested, boolean restock, String reason, MerchantStore store) {
+        if (order == null) throw new OrderReturnException(404, "Order not found");
+        if (order.getStatus() == OrderStatus.CANCELED || order.getStatus() == OrderStatus.REFUNDED)
+            throw new OrderReturnConflictException("Order cannot be returned");
+        if (requested == null || requested.isEmpty() || requested.values().stream().anyMatch(q -> q == null || q <= 0))
+            throw new OrderReturnValidationException("At least one positive return line is required");
+
+        Map<String, Integer> already = new HashMap<String, Integer>();
+        for (OrderReturn prior : repository.findByOrder_IdOrderByDateAscIdAsc(order.getId()))
+            for (OrderReturnLine line : prior.getLines()) already.merge(line.getSku(), line.getQuantity(), Integer::sum);
+
+        Map<String, OrderProduct> products = new HashMap<String, OrderProduct>();
+        BigDecimal subtotal = BigDecimal.ZERO;
+        for (OrderProduct product : order.getOrderProducts()) {
+            products.put(product.getSku(), product);
+            subtotal = subtotal.add(product.getOneTimeCharge().multiply(BigDecimal.valueOf(product.getProductQuantity())));
+        }
+        BigDecimal lineTotal = BigDecimal.ZERO;
+        for (Map.Entry<String, Integer> entry : requested.entrySet()) {
+            OrderProduct product = products.get(entry.getKey());
+            if (product == null || entry.getValue() + already.getOrDefault(entry.getKey(), 0) > product.getProductQuantity())
+                throw new OrderReturnValidationException("Invalid or over-limit return line: " + entry.getKey());
+            lineTotal = lineTotal.add(product.getOneTimeCharge().multiply(BigDecimal.valueOf(entry.getValue())));
+        }
+
+        BigDecimal orderTax = BigDecimal.ZERO;
+        for (OrderTotal total : order.getOrderTotal())
+            if (total.getOrderTotalType() == OrderTotalType.TAX) orderTax = orderTax.add(total.getValue());
+        BigDecimal taxRefunded = BigDecimal.ZERO;
+        BigDecimal amountRefunded = BigDecimal.ZERO;
+        for (OrderReturn prior : repository.findByOrder_IdOrderByDateAscIdAsc(order.getId())) { taxRefunded = taxRefunded.add(prior.getTax()); amountRefunded = amountRefunded.add(prior.getAmount()); }
+        int orderedUnits = 0, returnedUnits = 0;
+        for (OrderProduct product : order.getOrderProducts()) {
+            orderedUnits += product.getProductQuantity();
+            returnedUnits += already.getOrDefault(product.getSku(), 0) + requested.getOrDefault(product.getSku(), 0);
+        }
+        boolean completes = orderedUnits == returnedUnits;
+        BigDecimal tax = completes ? orderTax.subtract(taxRefunded) : subtotal.signum() == 0 ? BigDecimal.ZERO : orderTax.multiply(lineTotal).divide(subtotal, 2, RoundingMode.HALF_UP);
+        tax = tax.max(BigDecimal.ZERO).setScale(2, RoundingMode.HALF_UP);
+        BigDecimal amount = lineTotal.add(tax).setScale(2, RoundingMode.HALF_UP);
+
+        OrderReturn result = new OrderReturn(); result.setOrder(order); result.setTax(tax); result.setAmount(amount); result.setRestocked(restock); result.setReason(reason); result.setDate(new Date());
+        for (Map.Entry<String, Integer> entry : requested.entrySet()) {
+            OrderProduct product = products.get(entry.getKey());
+            OrderReturnLine line = new OrderReturnLine(); line.setOrderReturn(result); line.setSku(entry.getKey()); line.setQuantity(entry.getValue()); line.setAmount(product.getOneTimeCharge().multiply(BigDecimal.valueOf(entry.getValue())).setScale(2, RoundingMode.HALF_UP)); result.getLines().add(line);
+            if (restock) {
+                List<ProductAvailability> availabilities = availabilityService.getBySku(entry.getKey(), store);
+                for (ProductAvailability availability : availabilities) {
+                    boolean productMatches = availability.getProduct() != null
+                            && entry.getKey().equals(availability.getProduct().getSku());
+                    boolean variantMatches = availability.getProductVariant() != null
+                            && entry.getKey().equals(availability.getProductVariant().getSku());
+                    if (productMatches || variantMatches) {
+                        availability.setProductQuantity(availability.getProductQuantity() + entry.getValue());
+                        try { availabilityService.saveOrUpdate(availability); } catch (Exception e) { throw new OrderReturnException(500, "Unable to update stock"); }
+                        break;
+                    }
+                }
+            }
+        }
+        try { repository.save(result); } catch (Exception e) { throw new OrderReturnException(500, "Unable to save return"); }
+        Transaction transaction = new Transaction(); transaction.setOrder(order); transaction.setAmount(amount); transaction.setTransactionDate(new Date()); transaction.setTransactionType(TransactionType.REFUND); transaction.setPaymentType(order.getPaymentType());
+        try { transactionService.create(transaction); } catch (Exception e) { throw new OrderReturnException(500, "Unable to record refund transaction"); }
+        if (completes) order.setStatus(OrderStatus.REFUNDED);
+        OrderStatusHistory history = new OrderStatusHistory(); history.setOrder(order); history.setStatus(order.getStatus()); history.setDateAdded(new Date()); history.setComments("Refunded amount " + amount); order.getOrderHistory().add(history);
+        BigDecimal totalRefunded = amountRefunded.add(amount);
+        OrderTotal refundTotal = null; for (OrderTotal total : order.getOrderTotal()) if ("order.total.refunded".equals(total.getOrderTotalCode())) refundTotal = total;
+        if (refundTotal == null) { refundTotal = new OrderTotal(); refundTotal.setOrder(order); refundTotal.setOrderTotalCode("order.total.refunded"); refundTotal.setModule(Constants.OT_REFUND_MODULE_CODE); refundTotal.setText("order.total.refunded"); refundTotal.setTitle("order.total.refunded"); refundTotal.setOrderTotalType(OrderTotalType.REFUND); refundTotal.setSortOrder(100); order.getOrderTotal().add(refundTotal); }
+        refundTotal.setValue(totalRefunded.setScale(2, RoundingMode.HALF_UP));
+        try { orderService.saveOrUpdate(order); } catch (Exception e) { throw new OrderReturnException(500, "Unable to update order"); }
+        return result;
+    }
+    @Override public List<OrderReturn> list(Order order) { return repository.findByOrder_IdOrderByDateAscIdAsc(order.getId()); }
+}
