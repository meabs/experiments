+    @Mock private OrderReturnService returnService;
+    @Mock private OrderFacade orderFacade;
+    @Mock private AuthorizationUtils authorizationUtils;
+    @Mock private MerchantStore store;
+    private OrderReturnApi api;
+    private Order order;
+
+    @Before
+    public void setUp() {
+        api = new OrderReturnApi();
+        ReflectionTestUtils.setField(api, "orderService", orderService);
+        ReflectionTestUtils.setField(api, "returnService", returnService);
+        ReflectionTestUtils.setField(api, "orderFacade", orderFacade);
+        ReflectionTestUtils.setField(api, "authorizationUtils", authorizationUtils);
+        order = new Order();
+        order.setId(12L);
+        when(authorizationUtils.authenticatedUser()).thenReturn("admin");
+        when(orderService.getOrder(12L, store)).thenReturn(order);
+    }
+
+    @Test
+    public void aggregatesDuplicateRequestSkusAndReturnsCreatedResource() {
+        PersistableOrderReturn request = request(line("SKU", 1), line("SKU", 2));
+        OrderReturn saved = savedReturn();
+        when(returnService.create(eq(order), any(Map.class), eq(true), eq("customer"), eq(store))).thenReturn(saved);
+
+        api.create(12L, request, store, null);
+
+        ArgumentCaptor<Map> lines = ArgumentCaptor.forClass(Map.class);
+        verify(returnService).create(eq(order), lines.capture(), eq(true), eq("customer"), eq(store));
+        assertEquals(Map.of("SKU", 3), lines.getValue());
+    }
+
+    @Test
+    public void rejectsNonPositiveDuplicateLineBeforeAggregatingOrMutating() {
+        PersistableOrderReturn request = request(line("SKU", -1), line("SKU", 2));
+
+        assertThrows(OrderReturnValidationException.class, () -> api.create(12L, request, store, null));
+
+        verify(returnService, never()).create(any(Order.class), any(Map.class), any(Boolean.class), any(), eq(store));
+    }
+
+    @Test
+    public void missingStoreOrderIsNotSentToReturnService() {
+        when(orderService.getOrder(99L, store)).thenReturn(null);
+
+        assertThrows(ResourceNotFoundException.class, () -> api.list(99L, store, null));
+    }
+
+    @Test
+    public void returnAndRefundEndpointsAreCreatedResponses() throws Exception {
+        ResponseStatus returnsStatus = OrderReturnApi.class.getDeclaredMethod("create", Long.class,
+                PersistableOrderReturn.class, MerchantStore.class,
+                com.salesmanager.core.model.reference.language.Language.class).getAnnotation(ResponseStatus.class);
+        ResponseStatus refundStatus = OrderReturnApi.class.getDeclaredMethod("refund", Long.class,
+                MerchantStore.class, com.salesmanager.core.model.reference.language.Language.class).getAnnotation(ResponseStatus.class);
+
+        assertEquals(HttpStatus.CREATED, returnsStatus.value());
+        assertEquals(HttpStatus.CREATED, refundStatus.value());
+    }
+
+    private PersistableOrderReturn request(PersistableOrderReturnLine... lines) {
+        PersistableOrderReturn request = new PersistableOrderReturn();
+        request.setLines(List.of(lines));
+        request.setRestock(true);
+        request.setReason("customer");
