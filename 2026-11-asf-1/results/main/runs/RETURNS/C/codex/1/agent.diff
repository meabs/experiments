+    }
+
+    private PersistableOrderReturnLine line(String sku, int quantity) {
+        PersistableOrderReturnLine line = new PersistableOrderReturnLine();
+        line.setSku(sku);
+        line.setQuantity(quantity);
+        return line;
+    }
+
+    private OrderReturn savedReturn() {
+        OrderReturn saved = new OrderReturn();
+        saved.setId(7L);
+        saved.setOrder(order);
+        saved.setDate(new Date());
+        saved.setTax(BigDecimal.ZERO);
+        saved.setAmount(BigDecimal.ZERO);
+        OrderReturnLine line = new OrderReturnLine();
+        line.setSku("SKU");
+        line.setQuantity(3);
+        line.setAmount(BigDecimal.ZERO);
+        saved.getLines().add(line);
+        return saved;
+    }
