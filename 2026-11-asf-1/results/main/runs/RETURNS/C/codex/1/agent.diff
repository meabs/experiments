+package com.salesmanager.test.order;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertThrows;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+import static org.mockito.Mockito.times;
+
+import java.math.BigDecimal;
+import java.util.Collections;
+import java.util.Date;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.Mock;
+import org.mockito.ArgumentCaptor;
+import org.mockito.junit.MockitoJUnitRunner;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import com.salesmanager.core.business.repositories.order.OrderReturnRepository;
+import com.salesmanager.core.business.services.catalog.product.availability.ProductAvailabilityService;
+import com.salesmanager.core.business.services.order.OrderReturnServiceImpl;
+import com.salesmanager.core.business.services.order.OrderReturnConflictException;
+import com.salesmanager.core.business.services.order.OrderReturnValidationException;
+import com.salesmanager.core.business.services.order.OrderService;
+import com.salesmanager.core.business.services.payments.TransactionService;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.variant.ProductVariant;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.Order;
+import com.salesmanager.core.model.order.OrderReturn;
+import com.salesmanager.core.model.order.OrderReturnLine;
+import com.salesmanager.core.model.order.OrderTotal;
+import com.salesmanager.core.model.order.OrderTotalType;
+import com.salesmanager.core.model.order.orderstatus.OrderStatus;
+import com.salesmanager.core.model.order.orderproduct.OrderProduct;
+import com.salesmanager.core.model.payments.Transaction;
+import com.salesmanager.core.model.payments.TransactionType;
+
+@RunWith(MockitoJUnitRunner.class)
+public class OrderReturnServiceTest {
+
+    @Mock private OrderReturnRepository repository;
+    @Mock private OrderService orderService;
+    @Mock private TransactionService transactionService;
+    @Mock private ProductAvailabilityService availabilityService;
+    @Mock private MerchantStore store;
+    private OrderReturnServiceImpl service;
+
+    private Order order;
+    private ProductAvailability variantAvailability;
+
+    @Before
+    public void setUp() {
+        service = new OrderReturnServiceImpl(repository);
+        ReflectionTestUtils.setField(service, "orderService", orderService);
+        ReflectionTestUtils.setField(service, "transactionService", transactionService);
+        ReflectionTestUtils.setField(service, "availabilityService", availabilityService);
+        order = new Order();
+        order.setId(12L);
+        order.setStatus(OrderStatus.ORDERED);
+        order.setOrderProducts(new HashSet<>(Collections.singletonList(orderProduct("TSHIRT-BLUE-M", 2, "12.50"))));
+        order.setOrderTotal(new HashSet<>(Collections.singleton(orderTotal(OrderTotalType.TAX, "5.00"))));
+        when(repository.findByOrder_IdOrderByDateAscIdAsc(12L)).thenReturn(Collections.emptyList());
+
+        ProductVariant variant = new ProductVariant();
+        variant.setSku("TSHIRT-BLUE-M");
+        variantAvailability = new ProductAvailability();
+        variantAvailability.setProductVariant(variant);
+        variantAvailability.setProductQuantity(4);
+        when(availabilityService.getBySku("TSHIRT-BLUE-M", store)).thenReturn(List.of(variantAvailability));
+    }
+
+    @Test
+    public void restocksAvailabilityForOrderedVariantSku() throws Exception {
+        service.create(order, Map.of("TSHIRT-BLUE-M", 1), true, "customer return", store);
+
+        assertEquals(Integer.valueOf(5), variantAvailability.getProductQuantity());
+        verify(availabilityService).saveOrUpdate(variantAvailability);
+        verify(repository).save(any());
+    }
+
+    @Test
+    public void rejectsInvalidLineBeforeAnyMutation() throws Exception {
+        assertThrows(OrderReturnValidationException.class,
+                () -> service.create(order, Map.of("UNKNOWN", 1), true, null, store));
+
+        verify(availabilityService, never()).getBySku(any(), any());
+        verify(availabilityService, never()).saveOrUpdate(any());
+        verify(repository, never()).save(any());
+        verify(transactionService, never()).create(any());
+    }
+
+    @Test
+    public void calculatesProportionalTaxAndRecordsRefundSideEffects() throws Exception {
+        OrderProduct trousers = orderProduct("TROUSER", 1, "25.00");
+        order.getOrderProducts().add(trousers);
+        order.getOrderTotal().clear();
+        order.getOrderTotal().add(orderTotal(OrderTotalType.TAX, "10.00"));
+
+        OrderReturn result = service.create(order, Map.of("TSHIRT-BLUE-M", 1), false, "customer return", store);
+
+        assertEquals(new BigDecimal("12.50"), result.getLines().iterator().next().getAmount());
+        assertEquals(new BigDecimal("2.50"), result.getTax());
+        assertEquals(new BigDecimal("15.00"), result.getAmount());
+        assertEquals(OrderStatus.ORDERED, order.getStatus());
+        assertEquals(new BigDecimal("15.00"), refundedTotal(order).getValue());
+        assertEquals(1, order.getOrderHistory().size());
+        assertEquals("Refunded amount 15.00", order.getOrderHistory().iterator().next().getComments());
+
+        ArgumentCaptor<Transaction> transaction = ArgumentCaptor.forClass(Transaction.class);
+        verify(transactionService).create(transaction.capture());
+        assertEquals(TransactionType.REFUND, transaction.getValue().getTransactionType());
+        assertEquals(new BigDecimal("15.00"), transaction.getValue().getAmount());
+        verify(availabilityService, never()).getBySku(any(), any());
+    }
+
+    @Test
+    public void completingReturnRefundsExactRemainingTaxAndChangesStatus() throws Exception {
+        OrderReturn prior = priorReturn("TSHIRT-BLUE-M", 1, "12.50", "2.50", "15.00");
+        when(repository.findByOrder_IdOrderByDateAscIdAsc(12L)).thenReturn(List.of(prior));
+        order.getOrderTotal().clear();
+        order.getOrderTotal().add(orderTotal(OrderTotalType.TAX, "10.00"));
+
+        OrderReturn result = service.create(order, Map.of("TSHIRT-BLUE-M", 1), false, null, store);
+
+        assertEquals(new BigDecimal("7.50"), result.getTax());
+        assertEquals(new BigDecimal("20.00"), result.getAmount());
+        assertEquals(OrderStatus.REFUNDED, order.getStatus());
+        assertEquals(new BigDecimal("35.00"), refundedTotal(order).getValue());
+        verify(transactionService, times(1)).create(any(Transaction.class));
+    }
+
+    @Test
+    public void rejectsOverReturnWithoutAnyMutation() throws Exception {
+        assertThrows(OrderReturnValidationException.class,
+                () -> service.create(order, Map.of("TSHIRT-BLUE-M", 3), true, null, store));
+
+        verify(repository, never()).save(any());
+        verify(transactionService, never()).create(any());
+        verify(availabilityService, never()).getBySku(any(), any());
+        verify(orderService, never()).saveOrUpdate(any());
+    }
+
+    @Test
+    public void rejectsCanceledAndRefundedOrdersAsConflicts() {
+        order.setStatus(OrderStatus.CANCELED);
+        assertThrows(OrderReturnConflictException.class,
+                () -> service.create(order, Map.of("TSHIRT-BLUE-M", 1), false, null, store));
+        order.setStatus(OrderStatus.REFUNDED);
+        assertThrows(OrderReturnConflictException.class,
+                () -> service.create(order, Map.of("TSHIRT-BLUE-M", 1), false, null, store));
+        verify(repository, never()).save(any());
+    }
+
+    @Test
+    public void nonRestockedReturnDoesNotChangeAvailability() throws Exception {
+        service.create(order, Map.of("TSHIRT-BLUE-M", 1), false, "refund", store);
+
+        verify(availabilityService, never()).getBySku(any(), any());
+        verify(availabilityService, never()).saveOrUpdate(any());
+    }
+
+    private OrderTotal orderTotal(OrderTotalType type, String value) {
+        OrderTotal total = new OrderTotal();
+        total.setOrderTotalType(type);
+        total.setOrderTotalCode(type.name());
+        total.setValue(new BigDecimal(value));
+        total.setOrder(order);
+        return total;
+    }
+
+    private OrderTotal refundedTotal(Order source) {
+        return source.getOrderTotal().stream()
+                .filter(total -> "order.total.refunded".equals(total.getOrderTotalCode()))
+                .findFirst().orElseThrow();
+    }
+
+    private OrderReturn priorReturn(String sku, int quantity, String lineAmount, String tax, String amount) {
+        OrderReturn prior = new OrderReturn();
+        prior.setOrder(order);
+        prior.setDate(new Date());
+        prior.setTax(new BigDecimal(tax));
+        prior.setAmount(new BigDecimal(amount));
+        OrderReturnLine line = new OrderReturnLine();
+        line.setOrderReturn(prior);
+        line.setSku(sku);
+        line.setQuantity(quantity);
+        line.setAmount(new BigDecimal(lineAmount));
+        prior.getLines().add(line);
+        return prior;
+    }
+
+    private OrderProduct orderProduct(String sku, int quantity, String unitPrice) {
+        OrderProduct product = new OrderProduct();
+        product.setSku(sku);
+        product.setProductQuantity(quantity);
+        product.setOneTimeCharge(new BigDecimal(unitPrice));
+        return product;
+    }
+}
