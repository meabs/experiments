+package com.salesmanager.core.business.services.order;
+
+import static com.salesmanager.core.business.services.order.OrderReturnServiceImpl.refundTax;
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.Mockito.*;
+
+import java.lang.reflect.Field;
+import java.math.BigDecimal;
+import java.util.*;
+
+import org.junit.Before;
+import org.junit.Test;
+
+import com.salesmanager.core.business.repositories.order.OrderReturnRepository;
+import com.salesmanager.core.business.services.catalog.product.availability.ProductAvailabilityService;
+import com.salesmanager.core.business.services.order.OrderReturnServiceImpl;
+import com.salesmanager.core.business.services.order.OrderService;
+import com.salesmanager.core.business.services.payments.TransactionService;
+import com.salesmanager.core.business.exception.ReturnConflictException;
+import com.salesmanager.core.business.exception.ReturnValidationException;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.Order;
+import com.salesmanager.core.model.order.OrderReturn;
+import com.salesmanager.core.model.order.OrderTotal;
+import com.salesmanager.core.model.order.OrderTotalType;
+import com.salesmanager.core.model.order.orderproduct.OrderProduct;
+import com.salesmanager.core.model.order.orderstatus.OrderStatus;
+import com.salesmanager.core.model.payments.Transaction;
+
+public class OrderReturnServiceTest {
+    private OrderReturnServiceImpl service;
+    private OrderService orderService;
+    private OrderReturnRepository returnRepository;
+    private TransactionService transactionService;
+    private ProductAvailabilityService availabilityService;
+    private MerchantStore store;
+    private Order order;
+    private ProductAvailability availability;
+
+    @Before
+    public void setUp() throws Exception {
+        service = new OrderReturnServiceImpl();
+        orderService = mock(OrderService.class);
+        returnRepository = mock(OrderReturnRepository.class);
+        transactionService = mock(TransactionService.class);
+        availabilityService = mock(ProductAvailabilityService.class);
+        store = new MerchantStore();
+        store.setCode("store-a");
+        order = order("sku-1", 3, "10.00");
+        order.setId(12L);
+        order.setStatus(OrderStatus.PROCESSED);
+        OrderTotal tax = new OrderTotal();
+        tax.setOrderTotalType(OrderTotalType.TAX);
+        tax.setValue(new BigDecimal("3.00"));
+        order.setOrderTotal(new LinkedHashSet<>(Collections.singleton(tax)));
+        order.setOrderHistory(new LinkedHashSet<>());
+        when(orderService.getOrder(12L, store)).thenReturn(order);
+        when(returnRepository.findByOrderId(12L)).thenReturn(new ArrayList<>());
+        inject("orderService", orderService);
+        inject("returnRepository", returnRepository);
+        inject("transactionService", transactionService);
+        inject("availabilityService", availabilityService);
+        availability = new ProductAvailability();
+        availability.setMerchantStore(store);
+        availability.setProductQuantity(4);
+        when(availabilityService.getBySku("sku-1", store)).thenReturn(Collections.singletonList(availability));
+    }
+
+    @Test
+    public void createsReturnAndRecordsAllRefundSideEffects() throws Exception {
+        OrderReturn result = service.create(12L, store, Collections.singletonMap("sku-1", 1), true, "damaged");
+        assertEquals(new BigDecimal("10.00"), result.getLines().iterator().next().getAmount());
+        assertEquals(new BigDecimal("1.00"), result.getTax());
+        assertEquals(new BigDecimal("11.00"), result.getAmount());
+        assertEquals(5, availability.getProductQuantity().intValue());
+        assertEquals(1, order.getOrderHistory().size());
+        assertEquals(new BigDecimal("11.00"), order.getOrderTotal().stream()
+                .filter(t -> "order.total.refunded".equals(t.getOrderTotalCode())).findFirst().get().getValue());
+        verify(returnRepository).saveAndFlush(result);
+        verify(transactionService).create(any(Transaction.class));
+        verify(orderService).update(order);
+        assertEquals(OrderStatus.PROCESSED, order.getStatus());
+    }
+
+    @Test
+    public void aggregatesDuplicateLinesBeforeCheckingAndRecording() throws Exception {
+        Map<String, Integer> lines = new LinkedHashMap<>();
+        lines.put("sku-1", 2);
+        OrderReturn result = service.create(12L, store, lines, false, null);
+        assertEquals(2, result.getLines().iterator().next().getQuantity());
+        verify(availabilityService, never()).update(any(ProductAvailability.class));
+    }
+
+    @Test(expected = ReturnValidationException.class)
+    public void rejectsOverReturnWithoutWritingAnything() throws Exception {
+        try {
+            service.create(12L, store, Collections.singletonMap("sku-1", 4), true, null);
+        } finally {
+            verify(returnRepository, never()).saveAndFlush(any(OrderReturn.class));
+            verify(transactionService, never()).create(any(Transaction.class));
+            verify(availabilityService, never()).update(any(ProductAvailability.class));
+        }
+    }
+
+    @Test
+    public void refusesToRestockAvailabilityFromAnotherStore() throws Exception {
+        MerchantStore other = new MerchantStore();
+        other.setCode("store-b");
+        availability.setMerchantStore(other);
+        service.create(12L, store, Collections.singletonMap("sku-1", 1), true, null);
+        assertEquals(4, availability.getProductQuantity().intValue());
+        verify(availabilityService, never()).update(any(ProductAvailability.class));
+    }
+
+    @Test
+    public void refundAllCreatesOneNonRestockingCompletionReturn() throws Exception {
+        OrderReturn result = service.refund(12L, store);
+        assertTrue(!result.isRestocked());
+        assertEquals("refund", result.getReason());
+        assertEquals(3, result.getLines().iterator().next().getQuantity());
+        assertEquals(OrderStatus.REFUNDED, order.getStatus());
+        assertEquals(new BigDecimal("3.00"), result.getTax());
+        verify(availabilityService, never()).update(any(ProductAvailability.class));
+    }
+
+    @Test(expected = ReturnConflictException.class)
+    public void rejectsCanceledOrder() throws Exception {
+        order.setStatus(OrderStatus.CANCELED);
+        service.create(12L, store, Collections.singletonMap("sku-1", 1), false, null);
+    }
+
+    @Test
+    public void partialTaxRoundingNeverExceedsOrderTax() {
+        BigDecimal tax = new BigDecimal("0.02");
+        BigDecimal subtotal = new BigDecimal("4.00");
+        BigDecimal first = refundTax(tax, BigDecimal.ZERO, new BigDecimal("1.00"), subtotal, false);
+        BigDecimal second = refundTax(tax, first, new BigDecimal("1.00"), subtotal, false);
+        BigDecimal third = refundTax(tax, first.add(second), new BigDecimal("1.00"), subtotal, false);
+        BigDecimal completing = refundTax(tax, first.add(second).add(third), new BigDecimal("1.00"), subtotal, true);
+        assertEquals(new BigDecimal("0.01"), first);
+        assertEquals(new BigDecimal("0.01"), second);
+        assertEquals(new BigDecimal("0.00"), third);
+        assertEquals(new BigDecimal("0.00"), completing);
+        assertEquals(tax, first.add(second).add(third).add(completing));
+    }
+
+    @Test
+    public void roundsTheFinalProportionalTaxAmount() {
+        assertEquals(new BigDecimal("4.33"), refundTax(new BigDecimal("6.50"), BigDecimal.ZERO,
+                new BigDecimal("2.00"), new BigDecimal("3.00"), false));
+    }
+
+    private OrderProduct orderProduct(String sku, int quantity, String price) {
+        OrderProduct p = new OrderProduct();
+        p.setSku(sku);
+        p.setProductQuantity(quantity);
+        p.setOneTimeCharge(new BigDecimal(price));
+        return p;
+    }
+
+    private Order order(String sku, int quantity, String price) {
+        Order o = new Order();
+        o.setOrderProducts(new LinkedHashSet<>(Collections.singleton(orderProduct(sku, quantity, price))));
+        return o;
+    }
+
+    private void inject(String fieldName, Object value) throws Exception {
+        Field field = OrderReturnServiceImpl.class.getDeclaredField(fieldName);
+        field.setAccessible(true);
+        field.set(service, value);
+    }
+}
