diff --git a/sm-core/src/main/java/com/salesmanager/core/business/services/order/OrderReturnServiceImpl.java b/sm-core/src/main/java/com/salesmanager/core/business/services/order/OrderReturnServiceImpl.java
new file mode 100644
index 000000000..a3d2de4e1
--- /dev/null
+++ b/sm-core/src/main/java/com/salesmanager/core/business/services/order/OrderReturnServiceImpl.java
@@ -0,0 +1,39 @@
+package com.salesmanager.core.business.services.order;
+
+import java.math.*; import java.util.*; import javax.inject.Inject;
+import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.*; import com.salesmanager.core.business.repositories.order.*;
+import com.salesmanager.core.business.services.catalog.product.availability.ProductAvailabilityService; import com.salesmanager.core.business.services.payments.TransactionService;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.order.*; import com.salesmanager.core.model.order.orderproduct.OrderProduct; import com.salesmanager.core.model.order.orderstatus.*; import com.salesmanager.core.model.order.OrderTotalType; import com.salesmanager.core.model.payments.*;
+
+@Service("orderReturnService")
+public class OrderReturnServiceImpl implements OrderReturnService {
+ @Inject private OrderService orderService; @Inject private OrderReturnRepository returnRepository; @Inject private TransactionService transactionService; @Inject private ProductAvailabilityService availabilityService;
+ @Override @Transactional public OrderReturn create(Long id, MerchantStore store, Map<String,Integer> requested, boolean restock, String reason) {
+  Order order = order(id, store); validateStatus(order); if (requested == null || requested.isEmpty()) throw new ReturnValidationException("At least one return line is required");
+  Map<String,Integer> returned = returned(order); Map<String,OrderProduct> products = new HashMap<>(); for (OrderProduct p: order.getOrderProducts()) products.put(p.getSku(), p);
+  BigDecimal subtotal = BigDecimal.ZERO, lineAmount = BigDecimal.ZERO; for (Map.Entry<String,Integer> e: requested.entrySet()) { OrderProduct p=products.get(e.getKey()); if(p==null || e.getValue()==null || e.getValue()<=0 || e.getValue()+returned.getOrDefault(e.getKey(),0)>p.getProductQuantity()) throw new ReturnValidationException("Invalid return quantity for " + e.getKey()); lineAmount=lineAmount.add(p.getOneTimeCharge().multiply(BigDecimal.valueOf(e.getValue()))); }
+  for(OrderProduct p: order.getOrderProducts()) subtotal=subtotal.add(p.getOneTimeCharge().multiply(BigDecimal.valueOf(p.getProductQuantity())));
+  BigDecimal tax=tax(order), priorTax=priorTax(order); boolean complete=true; for(OrderProduct p: order.getOrderProducts()) if(returned.getOrDefault(p.getSku(),0)+requested.getOrDefault(p.getSku(),0)<p.getProductQuantity()) complete=false;
+  BigDecimal refundTax=refundTax(tax, priorTax, lineAmount, subtotal, complete);
+  OrderReturn r=new OrderReturn(); r.setOrder(order); r.setDate(new Date()); r.setRestocked(restock); r.setReason(reason); r.setTax(refundTax); r.setAmount(lineAmount.add(refundTax).setScale(2,RoundingMode.HALF_UP));
+  for(Map.Entry<String,Integer> e:requested.entrySet()){ OrderProduct p=products.get(e.getKey()); OrderReturnLine l=new OrderReturnLine(); l.setOrderReturn(r); l.setSku(e.getKey()); l.setQuantity(e.getValue()); l.setAmount(p.getOneTimeCharge().multiply(BigDecimal.valueOf(e.getValue())).setScale(2,RoundingMode.HALF_UP)); r.getLines().add(l); if(restock) restock(e.getKey(), e.getValue(), store); }
+  if(complete) order.setStatus(OrderStatus.REFUNDED); addTotal(order, r.getAmount()); history(order,r.getAmount()); returnRepository.saveAndFlush(r); Transaction t=new Transaction(); t.setOrder(order); t.setAmount(r.getAmount()); t.setTransactionDate(new Date()); t.setTransactionType(TransactionType.REFUND); t.setPaymentType(order.getPaymentType()); try { transactionService.create(t); orderService.update(order); } catch(Exception e) { throw new ReturnValidationException(e.getMessage()); } return r;
+ }
+ @Override @Transactional public OrderReturn refund(Long id, MerchantStore store){ Order o=order(id,store); validateStatus(o); Map<String,Integer> outstanding=new LinkedHashMap<>(), returned=returned(o); for(OrderProduct p:o.getOrderProducts()){int q=p.getProductQuantity()-returned.getOrDefault(p.getSku(),0);if(q>0)outstanding.put(p.getSku(),q);} return create(id,store,outstanding,false,"refund"); }
+ @Override @Transactional(readOnly=true) public List<OrderReturn> list(Long id, MerchantStore store){ order(id,store); return returnRepository.findByOrderId(id); }
+ private Order order(Long id, MerchantStore s){Order o=orderService.getOrder(id,s);if(o==null)throw new ReturnNotFoundException("Order " + id + " does not exist");return o;}
+ private void validateStatus(Order o){if(o.getStatus()==OrderStatus.CANCELED||o.getStatus()==OrderStatus.REFUNDED)throw new ReturnConflictException("Order cannot be returned");}
+ private Map<String,Integer> returned(Order o){Map<String,Integer> m=new HashMap<>();for(OrderReturn r:returnRepository.findByOrderId(o.getId()))for(OrderReturnLine l:r.getLines())m.put(l.getSku(),m.getOrDefault(l.getSku(),0)+l.getQuantity());return m;}
+ private BigDecimal tax(Order o){BigDecimal n=BigDecimal.ZERO;for(OrderTotal t:o.getOrderTotal())if(t.getOrderTotalType()==OrderTotalType.TAX)n=n.add(t.getValue());return n;}
+ private BigDecimal priorTax(Order o){BigDecimal n=BigDecimal.ZERO;for(OrderReturn r:returnRepository.findByOrderId(o.getId()))n=n.add(r.getTax());return n;}
+ static BigDecimal refundTax(BigDecimal tax, BigDecimal priorTax, BigDecimal returnedAmount, BigDecimal subtotal, boolean complete){
+  BigDecimal remaining=tax.subtract(priorTax).max(BigDecimal.ZERO);
+  if(complete || subtotal.signum()==0) return remaining.setScale(2,RoundingMode.HALF_UP);
+  BigDecimal proportional=tax.multiply(returnedAmount).divide(subtotal,MathContext.DECIMAL128).setScale(2,RoundingMode.HALF_UP);
+  return proportional.min(remaining).setScale(2,RoundingMode.HALF_UP);
+ }
+ private void restock(String sku,int q,MerchantStore s){List<ProductAvailability> a=availabilityService.getBySku(sku,s);for(ProductAvailability p:a){if(p.getMerchantStore()!=null&&s.getCode().equals(p.getMerchantStore().getCode())){p.setProductQuantity(p.getProductQuantity()+q);try{availabilityService.update(p);}catch(Exception e){throw new ReturnValidationException(e.getMessage());}return;}}}
+ private void addTotal(Order o,BigDecimal amount){OrderTotal t=null;for(OrderTotal x:o.getOrderTotal())if("order.total.refunded".equals(x.getOrderTotalCode()))t=x;if(t==null){t=new OrderTotal();t.setOrder(o);t.setOrderTotalCode("order.total.refunded");t.setOrderTotalType(OrderTotalType.REFUND);t.setSortOrder(999);o.getOrderTotal().add(t);}t.setValue((t.getValue()==null?BigDecimal.ZERO:t.getValue()).add(amount));}
+ private void history(Order o,BigDecimal amount){OrderStatusHistory h=new OrderStatusHistory();h.setOrder(o);h.setStatus(o.getStatus());h.setDateAdded(new Date());h.setComments("Refunded " + amount);o.getOrderHistory().add(h);}
+}
