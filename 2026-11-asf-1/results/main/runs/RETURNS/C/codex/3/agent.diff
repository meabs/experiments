+package com.salesmanager.shop.store.api.v1.order;
+import java.util.*; import java.util.stream.*; import javax.inject.Inject; import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.order.OrderReturn; import com.salesmanager.core.business.services.order.OrderReturnService; import com.salesmanager.shop.constants.Constants; import com.salesmanager.shop.model.order.returns.*; import com.salesmanager.shop.store.api.exception.ResourceNotFoundException; import com.salesmanager.shop.utils.AuthorizationUtils; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/orders/{id}")
+public class OrderReturnApi { @Inject private OrderReturnService service; @Inject private AuthorizationUtils auth;
+ private void authorize(MerchantStore s){auth.authorizeUser(auth.authenticatedUser(),Stream.of(Constants.GROUP_SUPERADMIN,Constants.GROUP_ADMIN,Constants.GROUP_ADMIN_ORDER,Constants.GROUP_ADMIN_RETAIL).collect(Collectors.toList()),s);}
+ @PostMapping("/returns") @ResponseStatus(HttpStatus.CREATED) public ReadableReturn create(@PathVariable Long id,@RequestBody ReturnRequest request,@ApiIgnore MerchantStore store){authorize(store);Map<String,Integer> lines=new LinkedHashMap<>();if(request!=null&&request.getLines()!=null)for(ReturnLineRequest l:request.getLines())lines.put(l.getSku(),lines.getOrDefault(l.getSku(),0)+l.getQuantity());return new ReadableReturn(service.create(id,store,lines,request!=null&&request.isRestock(),request==null?null:request.getReason()));}
+ @GetMapping("/returns") public List<ReadableReturn> list(@PathVariable Long id,@ApiIgnore MerchantStore store){authorize(store);List<ReadableReturn> out=new ArrayList<>();for(OrderReturn r:service.list(id,store))out.add(new ReadableReturn(r));return out;}
+ @PostMapping("/refund") @ResponseStatus(HttpStatus.CREATED) public ReadableReturn refund(@PathVariable Long id,@ApiIgnore MerchantStore store){authorize(store);return new ReadableReturn(service.refund(id,store));}
+}
