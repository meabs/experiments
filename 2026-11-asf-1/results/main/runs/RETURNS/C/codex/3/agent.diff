+package com.salesmanager.test.shop.integration.order;
+
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import java.math.BigDecimal;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.web.method.support.HandlerMethodArgumentResolver;
+import org.springframework.web.method.support.ModelAndViewContainer;
+import org.springframework.core.MethodParameter;
+import org.springframework.web.context.request.NativeWebRequest;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+
+import com.salesmanager.core.business.services.order.OrderReturnService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.Order;
+import com.salesmanager.core.model.order.OrderReturn;
+import com.salesmanager.core.model.order.OrderReturnLine;
+import com.salesmanager.shop.store.api.v1.order.OrderReturnApi;
+import com.salesmanager.shop.utils.AuthorizationUtils;
+
+public class OrderReturnApiTest {
+    private MockMvc mvc;
+    private OrderReturnService service;
+    private AuthorizationUtils authorization;
+    private MerchantStore store;
+    private OrderReturn returned;
+
+    @Before
+    public void setUp() throws Exception {
+        service = mock(OrderReturnService.class);
+        authorization = mock(AuthorizationUtils.class);
+        store = new MerchantStore();
+        store.setCode("store-a");
+        returned = returnModel(7L, "sku-1", 2, "20.00", "2.00", "22.00");
+        OrderReturnApi api = new OrderReturnApi();
+        inject(api, "service", service);
+        inject(api, "auth", authorization);
+        mvc = MockMvcBuilders.standaloneSetup(api).setCustomArgumentResolvers(new HandlerMethodArgumentResolver() {
+            @Override
+            public boolean supportsParameter(MethodParameter parameter) {
+                return parameter.getParameterType().equals(MerchantStore.class);
+            }
+
+            @Override
+            public Object resolveArgument(MethodParameter parameter, ModelAndViewContainer container,
+                    NativeWebRequest request, org.springframework.web.bind.support.WebDataBinderFactory binderFactory) {
+                return store;
+            }
+        }).build();
+        when(authorization.authenticatedUser()).thenReturn("admin");
+        when(service.create(eq(12L), any(MerchantStore.class), any(Map.class), eq(true), eq("damaged")))
+                .thenReturn(returned);
+        when(service.list(eq(12L), any(MerchantStore.class))).thenReturn(Arrays.asList(returned));
+        when(service.refund(eq(12L), any(MerchantStore.class))).thenReturn(returned);
+    }
+
+    @Test
+    public void createsReturnThroughProtectedEndpoint() throws Exception {
+        mvc.perform(post("/api/v1/private/orders/12/returns").param("store", "store-a")
+                .contentType(MediaType.APPLICATION_JSON)
+                .content("{\"lines\":[{\"sku\":\"sku-1\",\"quantity\":1},{\"sku\":\"sku-1\",\"quantity\":1}],\"restock\":true,\"reason\":\"damaged\"}"))
+                .andExpect(status().isCreated())
+                .andExpect(jsonPath("$.id").value(7))
+                .andExpect(jsonPath("$.amount").value(22.0));
+        verify(authorization).authorizeUser(eq("admin"), any(List.class), any(MerchantStore.class));
+        verify(service).create(eq(12L), any(MerchantStore.class), eq(Collections.singletonMap("sku-1", 2)),
+                eq(true), eq("damaged"));
+    }
+
+    @Test
+    public void listsReturnsOldestFirst() throws Exception {
+        mvc.perform(get("/api/v1/private/orders/12/returns").param("store", "store-a"))
+                .andExpect(status().isOk())
+                .andExpect(jsonPath("$[0].id").value(7))
+                .andExpect(jsonPath("$[0].lines[0].sku").value("sku-1"));
+        verify(service).list(eq(12L), any(MerchantStore.class));
+    }
+
+    @Test
+    public void refundsThroughProtectedEndpoint() throws Exception {
+        mvc.perform(post("/api/v1/private/orders/12/refund").param("store", "store-a"))
+                .andExpect(status().isCreated())
+                .andExpect(jsonPath("$.reason").value("refund"));
+        verify(service).refund(eq(12L), any(MerchantStore.class));
+    }
+
+    private OrderReturn returnModel(Long id, String sku, int quantity, String lineAmount, String tax, String amount) {
+        Order order = new Order();
+        order.setId(12L);
+        OrderReturn value = new OrderReturn();
+        value.setId(id);
+        value.setOrder(order);
+        value.setDate(new java.util.Date());
+        value.setTax(new BigDecimal(tax));
+        value.setAmount(new BigDecimal(amount));
+        value.setReason("refund");
+        OrderReturnLine line = new OrderReturnLine();
+        line.setOrderReturn(value);
+        line.setSku(sku);
+        line.setQuantity(quantity);
+        line.setAmount(new BigDecimal(lineAmount));
+        value.setLines(new LinkedHashSet<>(Collections.singleton(line)));
+        return value;
+    }
+
+    private void inject(Object target, String name, Object value) throws Exception {
+        java.lang.reflect.Field field = target.getClass().getDeclaredField(name);
+        field.setAccessible(true);
+        field.set(target, value);
+    }
+}
