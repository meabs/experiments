+
+import java.util.*; import java.util.stream.Collectors; import javax.inject.Inject;
+import org.springframework.http.HttpStatus; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.business.services.order.OrderService; import com.salesmanager.core.business.services.order.returns.OrderReturnService; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.order.Order; import com.salesmanager.core.model.order.orderproduct.OrderProduct; import com.salesmanager.core.model.order.orderstatus.OrderStatus; import com.salesmanager.core.model.order.returns.*; import com.salesmanager.core.model.reference.language.Language; import com.salesmanager.shop.constants.Constants; import com.salesmanager.shop.model.order.returns.*; import com.salesmanager.shop.store.api.exception.*; import com.salesmanager.shop.utils.AuthorizationUtils; import springfox.documentation.annotations.ApiIgnore;
+
+@RestController @RequestMapping("/api/v1/private/orders/{id}") public class OrderReturnsApi {
+ @Inject private OrderService orderService; @Inject private OrderReturnService returnService; @Inject private AuthorizationUtils authorizationUtils;
+ private Order order(Long id,MerchantStore store){String user=authorizationUtils.authenticatedUser();authorizationUtils.authorizeUser(user,Arrays.asList(Constants.GROUP_SUPERADMIN,Constants.GROUP_ADMIN,Constants.GROUP_ADMIN_ORDER,Constants.GROUP_ADMIN_RETAIL),store);Order o=orderService.getOrder(id,store);if(o==null)throw new ResourceNotFoundException("Order "+id+" does not exist");return o;}
+ @PostMapping("/returns") @ResponseStatus(HttpStatus.CREATED) public ReadableReturn create(@PathVariable Long id,@RequestBody PersistableReturn request,@ApiIgnore MerchantStore store){Order o=order(id,store);if(o.getStatus()==OrderStatus.CANCELED||o.getStatus()==OrderStatus.REFUNDED)throw new ConflictException("Order cannot be returned");Map<String,Integer> quantities=new LinkedHashMap<>();if(request!=null&&request.getLines()!=null)for(PersistableReturnLine l:request.getLines()){if(l==null||l.getSku()==null||l.getQuantity()<=0)throw new RestApiException("400","Invalid return line");quantities.merge(l.getSku(),l.getQuantity(),Integer::sum);}try{return map(returnService.create(o,quantities,request!=null&&request.isRestock(),request==null?null:request.getReason(),store));}catch(ServiceException e){throw new RestApiException("400",e.getMessage());}}
