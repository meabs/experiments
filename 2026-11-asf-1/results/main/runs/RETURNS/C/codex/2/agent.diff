+package com.salesmanager.core.business.services.order.returns;
+
+import java.math.BigDecimal; import java.math.RoundingMode; import java.util.*;
+import javax.inject.Inject; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.business.repositories.order.OrderRepository; import com.salesmanager.core.business.repositories.order.returns.OrderReturnRepository; import com.salesmanager.core.business.services.catalog.product.availability.ProductAvailabilityService; import com.salesmanager.core.business.services.order.OrderService; import com.salesmanager.core.business.services.payments.TransactionService; import com.salesmanager.core.model.catalog.product.availability.ProductAvailability; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.order.*; import com.salesmanager.core.model.order.orderproduct.OrderProduct; import com.salesmanager.core.model.order.orderstatus.*; import com.salesmanager.core.model.order.returns.*; import com.salesmanager.core.model.payments.*;
+
+@Service("orderReturnService") public class OrderReturnServiceImpl implements OrderReturnService {
+ private final OrderReturnRepository repository; private final OrderRepository orderRepository; private final OrderService orderService; private final TransactionService transactionService; private final ProductAvailabilityService availabilityService;
+ @Inject public OrderReturnServiceImpl(OrderReturnRepository r, OrderRepository or, OrderService o, TransactionService t, ProductAvailabilityService a){repository=r;orderRepository=or;orderService=o;transactionService=t;availabilityService=a;}
+ @Override @Transactional public OrderReturn create(Order order, Map<String,Integer> requested, boolean restock, String reason, MerchantStore store) throws ServiceException {
+  if(requested==null||requested.isEmpty()) throw new ServiceException("return lines are required");
+  order = orderRepository.findOneForUpdate(order.getId(), store.getId());
+  if(order==null) throw new ServiceException("order not found");
+  if(order.getStatus()==OrderStatus.CANCELED||order.getStatus()==OrderStatus.REFUNDED) throw new ServiceException("order cannot be returned");
+  Map<String,OrderProduct> products=new HashMap<>(); for(OrderProduct p:order.getOrderProducts()) products.put(p.getSku(),p);
+  Map<String,Integer> returned=new HashMap<>(); for(OrderReturn old: repository.findByOrderIdOrderByDateAscIdAsc(order.getId())) for(OrderReturnLine l:old.getLines()) returned.merge(l.getSku(),l.getQuantity(),Integer::sum);
+  BigDecimal subtotal=BigDecimal.ZERO, lineTotal=BigDecimal.ZERO; for(Map.Entry<String,Integer> e:requested.entrySet()){ OrderProduct p=products.get(e.getKey()); if(p==null||e.getValue()==null||e.getValue()<=0||e.getValue()+returned.getOrDefault(e.getKey(),0)>p.getProductQuantity()) throw new ServiceException("invalid return line"); subtotal=subtotal.add(p.getOneTimeCharge().multiply(BigDecimal.valueOf(e.getValue()))); lineTotal=lineTotal.add(p.getOneTimeCharge().multiply(BigDecimal.valueOf(e.getValue()))); }
+  BigDecimal productSubtotal=BigDecimal.ZERO; for(OrderProduct p:products.values()) productSubtotal=productSubtotal.add(p.getOneTimeCharge().multiply(BigDecimal.valueOf(p.getProductQuantity())));
+  BigDecimal orderTax=order.getOrderTotal().stream().filter(t->t.getOrderTotalType()==OrderTotalType.TAX).map(OrderTotal::getValue).filter(Objects::nonNull).reduce(BigDecimal.ZERO,BigDecimal::add);
+  BigDecimal alreadyTax=repository.findByOrderIdOrderByDateAscIdAsc(order.getId()).stream().map(OrderReturn::getTax).reduce(BigDecimal.ZERO,BigDecimal::add);
+  int totalUnits=products.values().stream().mapToInt(OrderProduct::getProductQuantity).sum(); int returnedAfter=returned.values().stream().mapToInt(Integer::intValue).sum()+requested.values().stream().mapToInt(Integer::intValue).sum();
+  BigDecimal tax=returnedAfter==totalUnits?orderTax.subtract(alreadyTax):productSubtotal.signum()==0?BigDecimal.ZERO:orderTax.multiply(subtotal).divide(productSubtotal,2,RoundingMode.HALF_UP);
+  OrderReturn result=new OrderReturn(); result.setOrder(order); result.setTax(tax); result.setAmount(lineTotal.add(tax)); result.setRestocked(restock); result.setReason(reason); result.setDate(new Date());
+  for(Map.Entry<String,Integer> e:requested.entrySet()){OrderProduct p=products.get(e.getKey()); OrderReturnLine l=new OrderReturnLine(); l.setOrderReturn(result); l.setSku(e.getKey()); l.setQuantity(e.getValue()); l.setAmount(p.getOneTimeCharge().multiply(BigDecimal.valueOf(e.getValue()))); result.getLines().add(l); if(restock){List<ProductAvailability> av=availabilityService.getBySku(e.getKey(),store); if(!av.isEmpty()){ProductAvailability a=av.get(0);a.setProductQuantity(a.getProductQuantity()+e.getValue());availabilityService.saveOrUpdate(a);}}}
+  if(returnedAfter==totalUnits) order.setStatus(OrderStatus.REFUNDED); OrderStatusHistory h=new OrderStatusHistory();h.setOrder(order);h.setStatus(order.getStatus());h.setDateAdded(new Date());h.setComments("Refunded amount " + result.getAmount());order.getOrderHistory().add(h);
+  BigDecimal refundedSoFar=repository.findByOrderIdOrderByDateAscIdAsc(order.getId()).stream().map(OrderReturn::getAmount).reduce(BigDecimal.ZERO,BigDecimal::add).add(result.getAmount());
+  OrderTotal refundTotal=order.getOrderTotal().stream().filter(t->"order.total.refunded".equals(t.getOrderTotalCode())).findFirst().orElse(null); if(refundTotal==null){refundTotal=new OrderTotal();refundTotal.setOrder(order);refundTotal.setOrderTotalCode("order.total.refunded");refundTotal.setOrderTotalType(OrderTotalType.REFUND);refundTotal.setTitle("Refunded");refundTotal.setSortOrder(999);order.getOrderTotal().add(refundTotal);} refundTotal.setValue(refundedSoFar);
+  repository.saveAndFlush(result); orderService.saveOrUpdate(order); Transaction tx=new Transaction();tx.setOrder(order);tx.setAmount(result.getAmount());tx.setTransactionType(TransactionType.REFUND);tx.setTransactionDate(new Date());transactionService.create(tx); return result;
+ }
+ @Override public List<OrderReturn> list(Order order)throws ServiceException{return repository.findByOrderIdOrderByDateAscIdAsc(order.getId());}
+}
