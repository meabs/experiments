+                org.mockito.ArgumentMatchers.any(MerchantStore.class),
+                org.mockito.ArgumentMatchers.any(Language.class));
+    }
+
+    @Test
+    public void mismatchedCustomerIsForbiddenAndIsNotSaved() throws Exception {
+        MockHttpServletResponse response = new MockHttpServletResponse();
+
+        api.create(10L, review(4D, 21L), store, language, request, response);
+
+        assertEquals(HttpServletResponse.SC_FORBIDDEN, response.getStatus());
+        verify(productCommonFacade, never()).saveOrUpdateReview(
+                org.mockito.ArgumentMatchers.any(PersistableProductReview.class),
+                org.mockito.ArgumentMatchers.any(MerchantStore.class),
+                org.mockito.ArgumentMatchers.any(Language.class));
+    }
+
+    @Test
+    public void duplicateCustomerReviewIsConflictAndIsNotSaved() throws Exception {
+        when(productReviewService.getByProductAndCustomer(10L, 20L)).thenReturn(new ProductReview());
+        MockHttpServletResponse response = new MockHttpServletResponse();
+
+        api.create(10L, review(4D, 20L), store, language, request, response);
+
+        assertEquals(HttpServletResponse.SC_CONFLICT, response.getStatus());
+        verify(productCommonFacade, never()).saveOrUpdateReview(
+                org.mockito.ArgumentMatchers.any(PersistableProductReview.class),
+                org.mockito.ArgumentMatchers.any(MerchantStore.class),
+                org.mockito.ArgumentMatchers.any(Language.class));
+    }
+
+    @Test
+    public void missingOrCrossProductReviewsAreNotUpdatedOrDeleted() throws Exception {
