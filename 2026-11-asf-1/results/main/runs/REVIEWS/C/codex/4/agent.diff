--- /dev/null
+++ b/sm-core/src/test/java/com/salesmanager/test/catalog/ProductReviewServiceImplTest.java
@@ -0,0 +1,83 @@
+package com.salesmanager.test.catalog;
+
+import static org.junit.Assert.assertEquals;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import java.math.BigDecimal;
+import java.util.Arrays;
+import java.util.Collections;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import com.salesmanager.core.business.repositories.catalog.product.review.ProductReviewRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.review.ProductReviewServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.review.ProductReview;
+import com.salesmanager.core.model.customer.Customer;
+
+public class ProductReviewServiceImplTest {
+
+  private ProductReviewRepository repository;
+  private ProductService productService;
+  private ProductReviewServiceImpl service;
+  private Product product;
+
+  @Before
+  public void setUp() {
+    repository = mock(ProductReviewRepository.class);
+    productService = mock(ProductService.class);
+    service = new ProductReviewServiceImpl(repository);
+    ReflectionTestUtils.setField(service, "productService", productService);
+    product = new Product();
+    product.setId(10L);
+    when(productService.getById(10L)).thenReturn(product);
+  }
+
+  @Test
+  public void updateRecomputesRoundedAverageAndCount() throws Exception {
+    ProductReview first = review(product, 1D);
+    ProductReview second = review(product, 2D);
+    ProductReview third = review(product, 2D);
+    when(repository.findByProductNoCustomers(10L))
+        .thenReturn(Arrays.asList(first, second, third));
+
+    service.update(review(product, 5D));
+
+    assertEquals(Integer.valueOf(3), product.getProductReviewCount());
+    assertEquals(new BigDecimal("1.7"), product.getProductReviewAvg());
+    verify(productService).update(product);
+  }
+
+  @Test
+  public void deleteWithNoRemainingReviewsResetsAggregate() throws Exception {
+    ProductReview review = review(product, 4D);
+    when(repository.findByProductNoCustomers(10L)).thenReturn(Collections.emptyList());
+
+    service.delete(review);
+
+    assertEquals(Integer.valueOf(0), product.getProductReviewCount());
+    assertEquals(BigDecimal.ZERO, product.getProductReviewAvg());
+    verify(repository).delete(review);
+    verify(productService).update(product);
+  }
+
+  @Test
+  public void findByIdReturnsNullForMissingReview() {
+    when(repository.findOne(99L)).thenReturn(null);
+
+    assertEquals(null, service.findById(99L));
+  }
+
+  private ProductReview review(Product product, double rating) {
+    ProductReview review = new ProductReview();
+    review.setProduct(product);
+    review.setCustomer(mock(Customer.class));
+    review.setReviewRating(rating);
+    return review;
+  }
+}
