@@ -0,0 +1,91 @@
+package com.salesmanager.test.catalog;
+
+import static org.junit.Assert.assertEquals;
+import static org.mockito.Mockito.doAnswer;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.List;
+
+import org.junit.Before;
+import org.junit.Test;
+
+import com.salesmanager.core.business.repositories.catalog.product.review.ProductReviewRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.review.ProductReviewServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.review.ProductReview;
+import com.salesmanager.core.model.customer.Customer;
+
+public class ProductReviewServiceImplTest {
+
+    private ProductReviewRepository repository;
+    private ProductService productService;
+    private ProductReviewServiceImpl service;
+    private Product product;
+    private List<ProductReview> reviews;
+
+    @Before
+    public void setUp() {
+        repository = mock(ProductReviewRepository.class);
+        productService = mock(ProductService.class);
+        service = new ProductReviewServiceImpl(repository);
+        org.springframework.test.util.ReflectionTestUtils.setField(service, "productService", productService);
+        product = new Product();
+        product.setId(11L);
+        reviews = new ArrayList<>();
+        when(productService.getById(11L)).thenReturn(product);
+        when(repository.findByProductNoCustomers(11L)).thenReturn(reviews);
+        doAnswer(invocation -> {
+            ProductReview review = invocation.getArgument(0);
+            if (!reviews.contains(review)) {
+                reviews.add(review);
+            }
+            return review;
+        }).when(repository).saveAndFlush(org.mockito.ArgumentMatchers.any(ProductReview.class));
+        doAnswer(invocation -> {
+            reviews.remove(invocation.getArgument(0));
+            return null;
+        }).when(repository).delete(org.mockito.ArgumentMatchers.any(ProductReview.class));
+    }
+
+    @Test
+    public void createUpdateAndDeleteAlwaysRecomputeCountAndHalfUpAverage() throws Exception {
+        ProductReview first = review(3D);
+        first.setProduct(product);
+        service.create(first);
+        assertRating(1, "3.0");
+
+        ProductReview second = review(4D);
+        second.setProduct(product);
+        service.create(second);
+        assertRating(2, "3.5");
+
+        first.setReviewRating(4D);
+        service.update(first);
+        assertRating(2, "4.0");
+
+        service.delete(second);
+        assertRating(1, "4.0");
+
+        service.delete(first);
+        assertRating(0, "0");
+    }
+
+    private ProductReview review(Double rating) {
+        ProductReview review = new ProductReview();
+        review.setReviewRating(rating);
+        Customer customer = new Customer();
+        customer.setId(7L);
+        review.setCustomer(customer);
+        return review;
+    }
+
+    private void assertRating(int count, String average) throws Exception {
+        assertEquals(count, product.getProductReviewCount().intValue());
+        assertEquals(new BigDecimal(average), product.getProductReviewAvg());
+    }
+}
