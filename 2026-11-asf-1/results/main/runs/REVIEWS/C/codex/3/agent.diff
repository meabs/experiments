+    @Test
+    public void createRejectsReviewForAnotherCustomerWithoutSaving() throws Exception {
+        authenticateAs(7L);
+        PersistableProductReview review = review(8L, 4D);
+        MockHttpServletResponse response = new MockHttpServletResponse();
+
+        api.create(11L, review, null, null, response);
+
+        assertEquals(HttpServletResponse.SC_FORBIDDEN, response.getStatus());
+        verify(reviewService, never()).getByProductAndCustomer(11L, 8L);
+        verify(facade, never()).saveOrUpdateReview(org.mockito.ArgumentMatchers.any(),
+                org.mockito.ArgumentMatchers.any(), org.mockito.ArgumentMatchers.any());
+    }
+
+    @Test
+    public void createRejectsDuplicateWithConflictWithoutSaving() throws Exception {
+        authenticateAs(8L);
+        when(reviewService.getByProductAndCustomer(11L, 8L)).thenReturn(new ProductReview());
+        MockHttpServletResponse response = new MockHttpServletResponse();
+
+        api.create(11L, review(8L, 4D), null, null, response);
+
+        assertEquals(HttpServletResponse.SC_CONFLICT, response.getStatus());
+        verify(facade, never()).saveOrUpdateReview(org.mockito.ArgumentMatchers.any(),
+                org.mockito.ArgumentMatchers.any(), org.mockito.ArgumentMatchers.any());
+    }
+
+    @Test
+    public void createTranslatesConcurrentUniqueConstraintFailureToConflict() throws Exception {
+        authenticateAs(8L);
+        doThrow(new DataIntegrityViolationException("duplicate review"))
+                .when(facade).saveOrUpdateReview(org.mockito.ArgumentMatchers.any(),
+                        org.mockito.ArgumentMatchers.any(), org.mockito.ArgumentMatchers.any());
+        MockHttpServletResponse response = new MockHttpServletResponse();
+
+        api.create(11L, review(8L, 4D), null, null, response);
+
+        assertEquals(HttpServletResponse.SC_CONFLICT, response.getStatus());
+    }
+
+    @Test
+    public void merchantUpdateAndDeleteRejectMissingOrMismatchedReviewsWithNotFound() throws Exception {
+        MockHttpServletResponse missingUpdate = new MockHttpServletResponse();
+        api.update(11L, 19L, update(4D, "changed"), null, null, missingUpdate);
+        assertEquals(HttpServletResponse.SC_NOT_FOUND, missingUpdate.getStatus());
+
+        ProductReview review = persistedReview(12L, 5L, 3D);
+        when(reviewService.getById(19L)).thenReturn(review);
+        MockHttpServletResponse wrongProductUpdate = new MockHttpServletResponse();
+        api.update(11L, 19L, update(4D, "changed"), null, null, wrongProductUpdate);
+        assertEquals(HttpServletResponse.SC_NOT_FOUND, wrongProductUpdate.getStatus());
+
+        MockHttpServletResponse wrongProductDelete = new MockHttpServletResponse();
+        api.delete(11L, 19L, null, null, wrongProductDelete);
+        assertEquals(HttpServletResponse.SC_NOT_FOUND, wrongProductDelete.getStatus());
+        verify(facade, never()).deleteReview(org.mockito.ArgumentMatchers.any(),
+                org.mockito.ArgumentMatchers.any(), org.mockito.ArgumentMatchers.any());
+    }
+
+    @Test
+    public void merchantUpdateRejectsOutOfRangeRating() throws Exception {
+        when(reviewService.getById(19L)).thenReturn(persistedReview(11L, 5L, 3D));
+        MockHttpServletResponse response = new MockHttpServletResponse();
+
+        api.update(11L, 19L, update(9D, "changed"), null, null, response);
+
+        assertEquals(HttpServletResponse.SC_BAD_REQUEST, response.getStatus());
+        verify(facade, never()).saveOrUpdateReview(org.mockito.ArgumentMatchers.any(),
+                org.mockito.ArgumentMatchers.any(), org.mockito.ArgumentMatchers.any());
+    }
+
+    @Test
+    public void ratingContractRequiresWholeNumbersFromOneToFive() throws Exception {
+        Field rating = ProductReviewEntity.class.getDeclaredField("rating");
+        assertNotNull(rating.getAnnotation(NotNull.class));
+        assertEquals(1, rating.getAnnotation(Min.class).value());
+        assertEquals(5, rating.getAnnotation(Max.class).value());
+        assertEquals(0, rating.getAnnotation(Digits.class).fraction());
+    }
