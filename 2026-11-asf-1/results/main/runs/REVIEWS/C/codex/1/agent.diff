@@ -0,0 +1,76 @@
+package com.salesmanager.test.catalog;
+
+import static org.junit.Assert.assertEquals;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import java.math.BigDecimal;
+import java.util.Arrays;
+import java.util.Collections;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.Mock;
+import org.mockito.junit.MockitoJUnitRunner;
+
+import com.salesmanager.core.business.repositories.catalog.product.review.ProductReviewRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.review.ProductReviewServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.review.ProductReview;
+import com.salesmanager.core.model.customer.Customer;
+
+@RunWith(MockitoJUnitRunner.class)
+public class ProductReviewServiceImplTest {
+
+  @Mock private ProductReviewRepository repository;
+  @Mock private ProductService productService;
+
+  private ProductReviewServiceImpl service;
+  private Product product;
+
+  @Before
+  public void setUp() {
+    service = new ProductReviewServiceImpl(repository);
+    org.springframework.test.util.ReflectionTestUtils.setField(service, "productService", productService);
+    product = new Product();
+    product.setId(10L);
+    when(productService.getById(10L)).thenReturn(product);
+  }
+
+  @Test
+  public void createRecalculatesCountAndHalfUpAverage() throws Exception {
+    ProductReview review = review(1D);
+    when(repository.findByProductNoCustomers(10L)).thenReturn(
+        Arrays.asList(review(1D), review(2D), review(3D), review(3D)));
+
+    service.create(review);
+
+    assertEquals(Integer.valueOf(4), product.getProductReviewCount());
+    assertEquals(new BigDecimal("2.3"), product.getProductReviewAvg());
+    verify(productService).update(product);
+  }
+
+  @Test
+  public void deleteRecalculatesEmptyAggregate() throws Exception {
+    ProductReview review = review(5D);
+    when(repository.findByProductNoCustomers(10L)).thenReturn(Collections.emptyList());
+
+    service.delete(review);
+
+    assertEquals(Integer.valueOf(0), product.getProductReviewCount());
+    assertEquals(new BigDecimal("0.0"), product.getProductReviewAvg());
+    verify(repository).delete(review);
+    verify(repository).flush();
+    verify(productService).update(product);
+  }
+
+  private ProductReview review(Double rating) {
+    ProductReview review = new ProductReview();
+    review.setReviewRating(rating);
+    review.setProduct(product);
+    review.setCustomer(new Customer());
+    return review;
+  }
+}
