ntId = merchant.getParent().getId();\n\t\t\t\t\tids.add(parentId);\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tif(merchantId != null) {\n\t\t\t\t//qs.append(\" and merch.id=:mid\");\n\t\t\t\tqs.append(\" and merch.id in (:mid)\");\n\t\t\t}\n\n\t\t\tString hql = qs.toString();\n\t\t\tQuery q = this.em.createQuery(hql);\n\n\t\t\tq.setParameter(\"pid\", productId);\n\n\n\t\t\tif(merchantId != null) {\n\t\t\t\t//q.setParameter(\"mid\", merchant.getId());\nsm-core/src/main/java/com/salesmanager/core/business/services/reference/init/InitializationDatabaseImpl.java:103:\t@Transactional\nsm-core/src/main/java/com/salesmanager/core/business/services/shoppingcart/ShoppingCartServiceImpl.java:70:\t@Transactional\nsm-core/src/main/java/com/salesmanager/core/business/services/shoppingcart/ShoppingCartServiceImpl.java:132:\t@Transactional\nsm-core/src/main/java/com/salesmanager/core/business/services/shoppingcart/ShoppingCartServiceImpl.java:163:\t * @Transactional public ShoppingCart getById(final Long id, MerchantStore\nsm-core/src/main/java/com/salesmanager/core/business/services/shoppingcart/ShoppingCartServiceImpl.java:183:\t@Transactional\nsm-core/src/main/java/com/salesmanager/core/business/services/shoppingcart/ShoppingCartServiceImpl.java:209:\t@Transactional\nsm-core/src/main/java/com/salesmanager/core/business/services/shoppingcart/ShoppingCartServiceImpl.java:220:\t * @Transactional public ShoppingCart getByCustomer(final Customer customer)\nsm-core/src/main/java/com/salesmanager/core/business/services/shoppingcart/ShoppingCartServiceImpl.java:230:\t@Transactional(noRollbackFor = { org.springframework.dao.EmptyResultDataAccessException.class })\nsm-core/src/main/java/com/salesmanager/core/business/services/shoppingcart/ShoppingCartServiceImpl.java:292:\t@Transactional\nsm-core/src/main/java/com/salesmanager/core/business/services/shoppingcart/ShoppingCartServiceImpl.java:492:\t@Transactional\nsm-shop/src/main/java/com/salesmanager/shop/store/controller/error/ShopErrorController.java