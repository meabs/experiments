/salesmanager/core/model/catalog/product/ProductList.java:17:\tpublic List<Product> getProducts() {\nsm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/ProductService.java:32:\tList<Product> getProductsForLocale(Category category, Language language, Locale locale) throws ServiceException;\nsm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/ProductService.java:34:\tList<Product> getProducts(List<Long> categoryIds) throws ServiceException;\nsm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/ProductService.java:36:\tList<Product> getProductsByIds(List<Long> productIds) throws ServiceException;\nsm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/ProductService.java:75:\tList<Product> getProducts(List<Long> categoryIds, Language language)\nsm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/ProductServiceImpl.java:114:\tpublic List<Product> getProducts(List<Long> categoryIds) throws ServiceException {\nsm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/ProductServiceImpl.java:123:\tpublic List<Product> getProductsByIds(List<Long> productIds) throws ServiceException {\nsm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/ProductServiceImpl.java:134:\tpublic List<Product> getProducts(List<Long> categoryIds, Language language) throws ServiceException {\nsm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/ProductServiceImpl.java:170:\tpublic List<Product> getProductsForLocale(Category category, Language language, Locale locale)\nsm-core/src/main/java/com/salesmanager/core/business/repositories/catalog/product/relationship/ProductRelationshipRepositoryImpl.java:15:public class ProductRelationshipRepositoryImpl implements ProductRelationshipRepositoryCustom {\nsm-core/src/main/java/com/salesmanager/core/business/repositories/catalog/product/ProductRepositoryImpl.java:3