lishDescription.setLanguage(en);\n\n\t    CategoryDescription bookFrenchDescription = new CategoryDescription();\n\t    bookFrenchDescription.setName(\"Livre\");\n\t    bookFrenchDescription.setCategory(materingstuff);\n\t    bookFrenchDescription.setLanguage(fr);\n\n\t    Set<CategoryDescription> descriptions = new HashSet<CategoryDescription>();\n\t    descriptions.add(bookEnglishDescription);\n\t    descriptions.add(bookFrenchDescription);\n\t    materingstuff.setDescriptions(descriptions);\n\n\t    categoryService.create(materingstuff);\n\t    \n\t    assertNotNull(materingstuff.getId());\n\t    \n\t    Long bookId = materingstuff.getId();\n\t    \n\t    Category fetchedBook = categoryService.getById(bookId, store.getId());\n\t\tAssert.assertEquals(2, fetchedBook.getDescriptions().size());\n\n\t    // Clean up for other tests\n\t    categoryService.delete(materingstuff);\n\n\t}\n\n\n\n}diff --git a/sm-core/src/main/java/com/salesmanager/core/business/services/catalog/category/CategoryServiceImpl.java b/sm-core/src/main/java/com/salesmanager/core/business/services/catalog/category/CategoryServiceImpl.java\nindex 36a1aeb..1d473b6 100755\n--- a/sm-core/src/main/java/com/salesmanager/core/business/services/catalog/category/CategoryServiceImpl.java\n+++ b/sm-core/src/main/java/com/salesmanager/core/business/services/catalog/category/CategoryServiceImpl.java\n@@ -257,24 +257,12 @@ public class CategoryServiceImpl extends SalesManagerEntityServiceImpl<Long, Cat\n \t\t\t// categories\n \n \t\t\tfor (Product product : products) {\n-\t\t\t\t// session.evict(product);// refresh product so we get all\n-\t\t\t\t// product categories\n+\t\t\t\t// Remove only the product/category join rows. The product itself must\n+\t\t\t\t// remain available to carts, orders, and any other categories.\n \t\t\t\tProduct dbProduct = productService.getById(product.getId());\n \t\t\t\tSet<Category> productCategories = dbProduct.getCategories();\n-\t\t\t\tif (productCategories.size() > 1) {\n-\t\