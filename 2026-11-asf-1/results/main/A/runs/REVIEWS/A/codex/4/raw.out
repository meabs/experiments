roduct product, MerchantStore store,\nsm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/ProductServiceImpl.java:34:import com.salesmanager.core.business.services.catalog.product.review.ProductReviewService;\nsm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/ProductServiceImpl.java:87:\tProductReviewService productReviewService;\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/product/ProductReviewApi.java:22:import com.salesmanager.core.business.services.catalog.product.review.ProductReviewService;\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/product/ProductReviewApi.java:44:  @Inject private ProductReviewService productReviewService;\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/product/ProductReviewApi.java:50:        \"/private/products/{id}/reviews\",\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/product/ProductReviewApi.java:51:        \"/auth/products/{id}/reviews\",\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/product/ProductReviewApi.java:52:        \"/auth/products/{id}/reviews\",\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/product/ProductReviewApi.java:53:        \"/auth/products/{id}/reviews\"\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/product/ProductReviewApi.java:103:  @RequestMapping(value = \"/product/{id}/reviews\", method = RequestMethod.GET)\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/product/ProductReviewApi.java:126:    \t\t  productCommonFacade.getProductReviews(product, merchantStore, language);\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/product/ProductReviewApi.java:143:        \"/private/products/{id}/reviews/{reviewid}\",\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/product/ProductReviewApi.java:144:        \"/auth/products/{id}/reviews/{reviewid}\"\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/product/ProductReviewApi.java:199:        \"/private/