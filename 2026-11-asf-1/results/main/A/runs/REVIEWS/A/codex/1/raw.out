ct\n+\t\t// Refresh product and derive the aggregate from the reviews themselves. This\n+\t\t// handles both edits and legacy/inconsistent aggregate values.\n \t\tProduct product = productService.getById(review.getProduct().getId());\n+\t\tsuper.save(review);\n+\t\treview.setProduct(product);\n+\t\trefreshProductRating(product);\n \t\t\n-\t\t//ajust product rating\n-\t\tInteger count = 0;\n-\t\tif(product.getProductReviewCount()!=null) {\n-\t\t\tcount = product.getProductReviewCount();\n-\t\t}\n-\t\t\t\t\n-\t\t\n-\t\t\n+\t}\n \n-\t\tBigDecimal averageRating = product.getProductReviewAvg();\n-\t\tif(averageRating==null) {\n-\t\t\taverageRating = new BigDecimal(0);\n+\tprivate void refreshProductRating(Product product) throws ServiceException {\n+\t\tList<ProductReview> reviews = productReviewRepository.findByProductNoCustomers(product.getId());\n+\t\tif (reviews.isEmpty()) {\n+\t\t\tproduct.setProductReviewAvg(BigDecimal.ZERO);\n+\t\t\tproduct.setProductReviewCount(0);\n+\t\t} else {\n+\t\t\tBigDecimal total = reviews.stream().map(ProductReview::getReviewRating)\n+\t\t\t\t\t.map(BigDecimal::valueOf).reduce(BigDecimal.ZERO, BigDecimal::add);\n+\t\t\tproduct.setProductReviewAvg(total.divide(BigDecimal.valueOf(reviews.size()), 1,\n+\t\t\t\t\tjava.math.RoundingMode.HALF_UP));\n+\t\t\tproduct.setProductReviewCount(reviews.size());\n \t\t}\n-\t\t//get reviews\n-\n-\t\t\n-\t\tBigDecimal totalRating = averageRating.multiply(new BigDecimal(count));\n-\t\ttotalRating = totalRating.add(new BigDecimal(review.getReviewRating()));\n-\t\t\n-\t\tcount = count + 1;\n-\t\tdouble avg = totalRating.doubleValue() / count;\n-\t\t\n-\t\tproduct.setProductReviewAvg(new BigDecimal(avg));\n-\t\tproduct.setProductReviewCount(count);\n-\t\tsuper.save(review);\n-\t\t\n \t\tproductService.update(product);\n-\t\t\n-\t\treview.setProduct(product);\n-\t\t\n \t}\n \t\n \tpublic void update(ProductReview review) throws ServiceException {\n@@ -106,6 +100,15 @@ public class ProductReviewServiceImpl exte