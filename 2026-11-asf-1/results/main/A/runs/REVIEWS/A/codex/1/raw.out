uctReviewServiceImpl.java:23:\t\tProductReviewService {\nsm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/review/ProductReviewServiceImpl.java:26:\tprivate ProductReviewRepository productReviewRepository;\nsm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/review/ProductReviewServiceImpl.java:32:\tpublic ProductReviewServiceImpl(\nsm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/review/ProductReviewServiceImpl.java:33:\t\t\tProductReviewRepository productReviewRepository) {\nsm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/review/ProductReviewServiceImpl.java:34:\t\t\tsuper(productReviewRepository);\nsm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/review/ProductReviewServiceImpl.java:35:\t\t\tthis.productReviewRepository = productReviewRepository;\nsm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/review/ProductReviewServiceImpl.java:39:\tpublic List<ProductReview> getByCustomer(Customer customer) {\nsm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/review/ProductReviewServiceImpl.java:40:\t\treturn productReviewRepository.findByCustomer(customer.getId());\nsm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/review/ProductReviewServiceImpl.java:44:\tpublic List<ProductReview> getByProduct(Product product) {\nsm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/review/ProductReviewServiceImpl.java:45:\t\treturn productReviewRepository.findByProduct(product.getId());\nsm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/review/ProductReviewServiceImpl.java:49:\tpublic ProductReview getByProductAndCustomer(Long productId, Long customerId) {\nsm-core/src/main/java/com/salesmanager/core/business/services/catalog/product/review/ProductReviewServiceImpl.java:50:\t\treturn productReviewRepository.findBy