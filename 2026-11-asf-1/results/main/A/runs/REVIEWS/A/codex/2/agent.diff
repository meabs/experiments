+	@Override
+	public void delete(ProductReview review) throws ServiceException {
+		Product product = productService.getById(review.getProduct().getId());
+		super.delete(review);
+		productReviewRepository.flush();
+		recalculateRating(product);
+		productService.update(product);
+	}
+
+	@Override
+	public ProductReview getById(Long id) {
+		return productReviewRepository.findOne(id);
+	}
+
+	private void recalculateRating(Product product) {
+		List<ProductReview> reviews = productReviewRepository.findByProduct(product.getId());
+		if (reviews.isEmpty()) {
+			product.setProductReviewAvg(BigDecimal.ZERO.setScale(1));
+			product.setProductReviewCount(0);
+			return;
+		}
+		BigDecimal total = BigDecimal.ZERO;
+		for (ProductReview review : reviews) {
+			total = total.add(BigDecimal.valueOf(review.getReviewRating()));
+		}
+		product.setProductReviewAvg(total.divide(BigDecimal.valueOf(reviews.size()), 1, RoundingMode.HALF_UP));
+		product.setProductReviewCount(reviews.size());
+	}
+
