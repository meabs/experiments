ll) {\n\t\t\tstart = new Integer(0);\n\t\t}\n\t\tif (count == null) {\n\t\t\tcount = new Integer(100);\n\t\t}\n\n\t\tOrderCriteria criteria = new OrderCriteria();\n\t\tcriteria.setCustomerId(id);\n\t\tcriteria.setStartPage(start / count);\n\t\tcriteria.setPageSize(count);\n\t\tcriteria.setLegacyPagination(false);\n\t\tReadableOrderList returnList = orderFacade.getReadableOrderList(criteria, merchantStore);\n\n\t\tList<ReadableOrder> orders = returnList.getOrders();\n\n\t\tif (customer != null && !CollectionUtils.isEmpty(orders)) {\n\t\t\tReadableCustomer readableCustomer = new ReadableCustomer();\n\t\t\tReadableCustomerPopulator customerPopulator = new ReadableCustomerPopulator();\n\t\t\tcustomerPopulator.populate(customer, readableCustomer, merchantStore, language);\n\t\t\tfor (ReadableOrder order : orders) {\n\t\t\t\torder.setCustomer(readableCustomer);\n936:\tpublic com.salesmanager.shop.model.order.v0.ReadableOrderList getReadableOrderList(OrderCriteria criteria,\n937-\t\t\tMerchantStore store) {\n938-\n939-\t\ttry {\n940-\t\t\tcriteria.setLegacyPagination(false);\n941-\n942-\t\t\tOrderList orderList = orderService.getOrders(criteria, store);\n943-\n944-\t\t\tList<Order> orders = orderList.getOrders();\n945-\t\t\tcom.salesmanager.shop.model.order.v0.ReadableOrderList returnList = new com.salesmanager.shop.model.order.v0.ReadableOrderList();\n946-\n947-\t\t\tif (CollectionUtils.isEmpty(orders)) {\n948-\t\t\t\treturnList.setRecordsTotal(0);\n949-\t\t\t\treturn returnList;\n950-\t\t\t}\n951-\n952-\t\t\tList<com.salesmanager.shop.model.order.v0.ReadableOrder> readableOrders = new ArrayList<com.salesmanager.shop.model.order.v0.ReadableOrder>();\n953-\t\t\tfor (Order order : orders) {\n954-\t\t\t\tcom.salesmanager.shop.model.order.v0.ReadableOrder readableOrder = new com.salesmanager.shop.model.order.v0.ReadableOrder();\n955-\t\t\t\treadableOrderPopulator.populate(order, readableOrder, null, null);\n956-\t\t\t\treadableOrders.add(readableOrder);\n957-\n958-\t\t\t}\n95