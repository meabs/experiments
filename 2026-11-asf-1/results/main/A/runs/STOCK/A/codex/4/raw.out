anager.core.model.shoppingcart.ShoppingCartItem> inCartItemList = createCartItems(cartModel,\n   992\t\t\t\t\tcartItems, store);\n   993\t\n   994\t\t\tSet<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> existingItems = cartModel.getLineItems();\n   995\t\t\t// loop over incoming items since they drive changes\n   996\t\t\tfor (com.salesmanager.core.model.shoppingcart.ShoppingCartItem newItemValue : inCartItemList) {\n   997\t\n   998\t\t\t\t// check that item exist in persisted cart\n   999\t\t\t\tOptional<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> oOldItem = existingItems.stream()\n  1000\t\t\t\t\t\t.filter(i -> i.getSku().equals(newItemValue.getSku())\n  1001\t\n  1002\t\t\t\t\t\t).findFirst();\n  1003\t\n  1004\t\t\t\tif (oOldItem.isPresent()) {\n  1005\t\t\t\t\t// update of existing cartItem\n  1006\t\t\t\t\tcom.salesmanager.core.model.shoppingcart.ShoppingCartItem oldCartItem = oOldItem.get();\n  1007\t\t\t\t\tif (oldCartItem.getQuantity().intValue() == newItemValue.getQuantity()) {\n  1008\t\t\t\t\t\t// this is unchanged\n  1009\t\t\t\t\t\tcontinue;\n  1010\t\t\t\t\t}\n  1011\t\t\t\t\tif (newItemValue.getQuantity() == 0) {\n  1012\t\t\t\t\t\t// remove from cart\n  1013\t\t\t\t\t\tshoppingCartService.deleteShoppingCartItem(oldCartItem.getId());\n  1014\t\t\t\t\t\tcartModel.getLineItems().remove(oldCartItem);\n  1015\t\t\t\t\t\t++itemUpdatedCnt;\n  1016\t\t\t\t\t\tcontinue;\n  1017\t\t\t\t\t}\n  1018\t\t\t\t\t// update qty\n  1019\t\t\t\t\toldCartItem.setQuantity(newItemValue.getQuantity());\n  1020\t\t\t\t\t++itemUpdatedCnt;\n  1021\t\t\t\t} else {\n  1022\t\t\t\t\t// addition of new item\n  1023\t\t\t\t\tcartModel.getLineItems().add(newItemValue);\n  1024\t\t\t\t\t++itemUpdatedCnt;\n  1025\t\t\t\t}\n  1026\t\t\t}\n  1027\t\t\t// at the moment we expect that some change have been done\n  1028\t\t\tsaveShoppingCart(cartModel);\n  1029\t\n  1030\t\t\t// refresh cart\n","exit_code":0,"status":"completed"}}
