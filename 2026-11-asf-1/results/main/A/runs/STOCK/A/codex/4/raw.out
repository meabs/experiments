ble = true)\n\tprivate MerchantStore merchantStore;\n\t\n\t/**\n\t * This describes the availability of a product variant\n\t */\n\t@ManyToOne(targetEntity = ProductVariant.class)\n\t@JoinColumn(name = \"PRODUCT_VARIANT\", nullable = true)\n\tprivate ProductVariant productVariant;\n\t\n\t@Pattern(regexp=\"^[a-zA-Z0-9_]*$\")\n\t@Column(name = \"SKU\", nullable = true)\n\tprivate String sku;\n\n\t@Embedded\n\tprivate ProductDimensions dimensions;\nsm-shop/src/main/java/com/salesmanager/shop/mapper/catalog/product/ReadableProductDefinitionMapper.java:80:\t\treturnDestination.setVisible(source.isAvailable());\nsm-shop/src/main/java/com/salesmanager/shop/mapper/catalog/product/PersistableProductMapper.java:100:\t\t\tdestination.setAvailable(source.isVisible());\nsm-shop/src/main/java/com/salesmanager/shop/mapper/catalog/product/ReadableProductMapper.java:121:\t\tdestination.setAvailable(source.isAvailable());\nsm-shop/src/main/java/com/salesmanager/shop/mapper/catalog/product/ReadableProductMapper.java:363:\t\t\tif (availability.getProductQuantity().intValue() > 0 && destination.isAvailable()) {\nsm-shop/src/main/java/com/salesmanager/shop/mapper/catalog/product/PersistableProductVariantMapper.java:98:\t\tdestination.setAvailable(source.isAvailable());\nsm-shop/src/main/java/com/salesmanager/shop/mapper/catalog/product/PersistableProductDefinitionMapper.java:79:\t\t\tdestination.setAvailable(source.isVisible());\nsm-shop/src/main/java/com/salesmanager/shop/mapper/catalog/product/PersistableProductDefinitionMapper.java:191:\t\t\t  productAvailability.setAvailable(Boolean.valueOf(destination.isAvailable()));\nsm-shop/src/main/java/com/salesmanager/shop/mapper/catalog/product/ReadableProductVariantMapper.java:65:\t\tdestination.setAvailable(source.isAvailable());\n","exit_code":0,"status":"completed"}}
