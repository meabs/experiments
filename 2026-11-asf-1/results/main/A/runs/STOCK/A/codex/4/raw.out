product\n   902\t\t\tSet<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> items = cartModel.getLineItems();\n   903\t\t\tif (!CollectionUtils.isEmpty(items)) {\n   904\t\t\t\tSet<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> newItems = new HashSet<com.salesmanager.core.model.shoppingcart.ShoppingCartItem>();\n   905\t\t\t\tSet<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> removeItems = new HashSet<com.salesmanager.core.model.shoppingcart.ShoppingCartItem>();\n   906\t\t\t\tfor (com.salesmanager.core.model.shoppingcart.ShoppingCartItem anItem : items) {// take care of existing\n   907\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t// product\n   908\t\t\t\t\tif (itemModel.getProduct().getId().longValue() == anItem.getProduct().getId()) {\n   909\t\t\t\t\t\tif (item.getQuantity() == 0) {\n   910\t\t\t\t\t\t\t// left aside item to be removed\n   911\t\t\t\t\t\t\t// don't add it to new list of item\n   912\t\t\t\t\t\t\tremoveItems.add(anItem);\n   913\t\t\t\t\t\t} else {\n   914\t\t\t\t\t\t\t// new quantity\n   915\t\t\t\t\t\t\tanItem.setQuantity(item.getQuantity());\n   916\t\t\t\t\t\t\tnewItems.add(anItem);\n   917\t\t\t\t\t\t}\n   918\t\t\t\t\t\titemModified = true;\n   919\t\t\t\t\t} else {\n   920\t\t\t\t\t\tnewItems.add(anItem);\n   921\t\t\t\t\t}\n   922\t\t\t\t}\n   923\t\n   924\t\t\t\tif (!removeItems.isEmpty()) {\n   925\t\t\t\t\tfor (com.salesmanager.core.model.shoppingcart.ShoppingCartItem emptyItem : removeItems) {\n   926\t\t\t\t\t\tshoppingCartService.deleteShoppingCartItem(emptyItem.getId());\n   927\t\t\t\t\t}\n   928\t\n   929\t\t\t\t}\n   930\t\n  1020\t\t\t\t\t++itemUpdatedCnt;\n  1021\t\t\t\t} else {\n  1022\t\t\t\t\t// addition of new item\n  1023\t\t\t\t\tcartModel.getLineItems().add(newItemValue);\n  1024\t\t\t\t\t++itemUpdatedCnt;\n  1025\t\t\t\t}\n  1026\t\t\t}\n  1027\t\t\t// at the moment we expect that some change have been done\n  1028\t\t\tsaveShoppingCart(cartModel);\n  1029\t\n  1030\t\t\t// refresh cart\n  1031\t\t\tcartModel = shoppingCartService.getById(cartModel.getId(), store);\n  1032\t\n  1033\t\t\tif (cartModel == null) {\n  1034\t\t\t\treturn null;\n  1035\t\t\t}\n  1036\t\n  1037\t\t\tshoppingCartCalculationService.calculate(cartModel, store, language);\n  1038\t\n  1039\t\t\treturn readableShoppingCartMapper.convert(cartModel, store, language);\n  1040\t\n","exit_code":0,"status":"completed"}}
