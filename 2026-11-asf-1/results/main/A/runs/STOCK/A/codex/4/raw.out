).equals(Constants.ALL_REGIONS)) {//TODO REL 3.X\n   346\t\t\t\t// accept a region\n   347\t\t\t\t\n   348\t\t\t\t/**\n   349\t\t\t\t * Default availability\n   350\t\t\t\t * store\n   351\t\t\t\t * product\n   352\t\t\t\t * instance null\n   353\t\t\t\t * region variant null\n   354\t\t\t\t */\n   355\t\t\t\t\n   356\t\t\t\t\n   357\t\t\t\tavailability = a;\n   358\t\t\t\tdestination.setQuantity(availability.getProductQuantity() == null ? 1 : availability.getProductQuantity());\n   359\t\t\t\tdestination.setQuantityOrderMaximum(\n   360\t\t\t\t\t\tavailability.getProductQuantityOrderMax() == null ? 1 : availability.getProductQuantityOrderMax());\n   361\t\t\t\tdestination.setQuantityOrderMinimum(\n   362\t\t\t\t\t\tavailability.getProductQuantityOrderMin() == null ? 1 : availability.getProductQuantityOrderMin());\n   363\t\t\t\tif (availability.getProductQuantity().intValue() > 0 && destination.isAvailable()) {\n   364\t\t\t\t\tdestination.setCanBePurchased(true);\n   365\t\t\t\t}\n   366\t\t\t\t\n   367\t\t\t\tif(a.getProductVariant()==null && StringUtils.isEmpty(a.getRegionVariant())) {\n   368\t\t\t\t\tbreak;\n   369\t\t\t\t}\n   370\t\t\t}\n   371\t\t\t\n   372\t\t\t//if default instance\n   373\t\n   374\t\t\tdestination.setSku(source.getSku());\n   375\t\n   375\t\n   376\t\t\t\tOrder modelOrder = orderFacade.processOrder(order, customer, merchantStore, language, locale);\n   377\t\t\t\tLong orderId = modelOrder.getId();\n   378\t\t\t\tmodelOrder.setId(orderId);\n   379\t\n   380\t\n   381\t\t\t\treturn orderFacadeV1.orderConfirmation(modelOrder, customer, merchantStore, language);\n   382\t\n   383\t\n   384\t\n   385\t\t\t} catch (StockConflictException e) {\n   386\t\t\t\tthrow e;\n   387\t\t\t} catch (Exception e) {\n   388\t\t\t\tLOGGER.error(\"Error while processing checkout\", e);\n   389\t\t\t\ttry {\n   390\t\t\t\t\tresponse.sendError(503, \"Error while processing checkout \" + e.getMessage());\n   391\t\t\t\t} catch (Exception ignore) {\n   392\t\t\t\t}\n   393\t\t\t\treturn null;\n   394\t\t\t}\n   395\t\t}\n   396\t\n   397\t\t/**\n   398\t\t * Main checkout resource that will complete the order flow\n   399\t\t * @param code\n   400\t\t * @param order\n   401\t\t * @param merchantStore\n   402\t\t * @param language\n   403\t\t * @return\n   404\t\t */\n   405\t\t@RequestMapping(value = { \"/cart/{code}/checkout\" }, method = RequestMethod.POST)\n   406\t\t@ResponseStatus(HttpStatus.OK)\n   407\t\t@ResponseBody\n   408\t\t@ApiImplicitParams({ @ApiImplicitParam(name = \"store\", dataType = \"string\", defaultValue = \"DEFAULT\"),\n   409\t\t\t\t@ApiImplicitParam(name = \"lang\", dataType = \"string\", defaultValue = \"en\") })\n   410\t\tpublic ReadableOrderConfirmation checkout(\n   411\t\t\t\t@PathVariable final String code,//shopping cart\n   412\t\t\t\t@Valid @RequestBody PersistableAnonymousOrder order,//order\n   413\t\t\t\t@ApiIgnore MerchantStore merchantStore,\n   414\t\t\t\t@ApiIgnore Language language) {\n   415\t\n   416\t\t\tValidate.notNull(order.getCustomer(), \"Customer must not be null\");\n   417\t\n   418\t\n   419\t\t\tShoppingCart cart;\n   420\t\t\ttry {\n   421\t\t\t\tcart = shoppingCartService.getByCode(code, merchantStore);\n   422\t\n   423\t\t\t\tif (cart == null) {\n   424\t\t\t\t\tthrow new ResourceNotFoundException(\"Cart code \" + code + \" does not exist\");\n   425\t\t\t\t}\n   426\t\n   427\t\t\t\t//security password validation\n   428\t\t\t\tPersistableCustomer presistableCustomer = order.getCustomer();\n   429\t\t\t\tif(!StringUtils.isBlank(presistableCustomer.getPassword())) { //validate customer password\n   430\t\t\t\t\tcredentialsService.validateCredentials(presistableCustomer.getPassword(), presistableCustomer.getRepeatPassword(), merchantStore, language);\n   431\t\t\t\t}\n   432\t\n   433\t\t\t\tCustomer customer = new Customer();\n   434\t\t\t\tcustomer = customerFacade.populateCustomerModel(customer, order.getCustomer(), merchantStore, language);\n   435\t\n   436\t\t\t\tif(!StringUtils.isBlank(presistableCustomer.getPassword())) {\n   437\t\t\t\t\t//check if customer already exist\n   438\t\t\t\t\tcustomer.setAnonymous(false);\n   439\t\t\t\t\tcustomer.setNick(customer.getEmailAddress()); //username\n   440\t\t\t\t\tif(customerFacadev1.checkIfUserExists(customer.getNick(),  merchantStore)) {\n   441\t\t\t\t\t\t//409 Conflict\n   442\t\t\t\t\t\tthrow new GenericRuntimeException(\"409\", \"Customer with email [\" + customer.getEmailAddress() + \"] is already registered\");\n   443\t\t\t\t\t}\n   444\t\t\t\t}\n   445\t\n   446\t\n   447\t\t\t\torder.setShoppingCartId(cart.getId());\n   448\t\n   449\t\t\t\tOrder modelOrder = orderFacade.processOrder(order, customer, merchantStore, language,\n   450\t\t\t\t\t\tLocaleUtils.getLocale(language));\n   451\t\t\t\tLong orderId = modelOrder.getId();\n   452\t\t\t\t//populate order confirmation\n   453\t\t\t\torder.setId(orderId);\n   454\t\t\t\t// set customer id\n   455\t\t\t\torder.getCustomer().setId(modelOrder.getCustomerId());\n   456\t\n   457\t\t\t\treturn orderFacadeV1.orderConfirmation(modelOrder, customer, merchantStore, language);\n   458\t\n   459\t\n   460\t\t\t} catch (StockConflictException e) {\n   461\t\t\t\tthrow e;\n   462\t\t\t} catch (Exception e) {\n   463\t\t\t\tif(e instanceof CredentialsException) {\n   464\t\t\t\t\tthrow new GenericRuntimeException(\"412\",\"Credentials creation Failed [\" + e.getMessage() + \"]\");\n   465\t\t\t\t}\n   466\t\t\t\tString message = e.getMessage();\n   467\t\t\t\tif(StringUtils.isBlank(message)) {//exception type\n   468\t\t\t\t\tmessage = \"APP-BACKEND\";\n   469\t\t\t\t\tif(e.getCause() instanceof com.salesmanager.core.modules.integration.IntegrationException) {\n   470\t\t\t\t\t\tmessage = \"Integration problen occured to complete order\";\n .../business/services/order/OrderServiceImpl.java  | 43 +++++++++++++++-------\n .../shop/store/api/v1/order/OrderApi.java          |  5 +++\n .../store/api/v1/shoppingCart/ShoppingCartApi.java |  7 ++++\n .../controller/order/facade/OrderFacadeImpl.java   | 29 ++++++++++++++-\n .../facade/ShoppingCartFacadeImpl.java             | 37 ++++++++++++++-----\n 5 files changed, 97 insertions(+), 24 deletions(-)\n M sm-core/src/main/java/com/salesmanager/core/business/services/order/OrderServiceImpl.java\n M sm-shop/src/main/java/com/salesmanager/shop/store/api/v1/order/OrderApi.java\n M sm-shop/src/main/java/com/salesmanager/shop/store/api/v1/shoppingCart/ShoppingCartApi.java\n M sm-shop/src/main/java/com/salesmanager/shop/store/controller/order/facade/OrderFacadeImpl.java\n M sm-shop/src/main/java/com/salesmanager/shop/store/controller/shoppingCart/facade/ShoppingCartFacadeImpl.java\n?? sm-shop/src/main/java/com/salesmanager/shop/store/api/exception/StockConflictException.java\n","exit_code":0,"status":"completed"}}
