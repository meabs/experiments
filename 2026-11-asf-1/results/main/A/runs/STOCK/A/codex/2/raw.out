urrent status\nsm-shop/src/main/java/com/salesmanager/shop/store/controller/order/facade/OrderFacadeImpl.java:1629:\t\t\treturn; // we have the same status, lets just return\nsm-shop/src/main/java/com/salesmanager/shop/store/controller/order/facade/OrderFacadeImpl.java:1635:\t\thistory.setComments( messages.getMessage(\"email.order.status.changed\", new String[] {oldStatus.name(),\nsm-core/src/main/java/com/salesmanager/core/business/modules/order/total/PromoCodeCalculatorModule.java:99:\t\t\t\t\tBigDecimal reduction = productPrice.getFinalPrice().multiply(new BigDecimal(discount));\nsm-core/src/main/java/com/salesmanager/core/business/modules/order/total/PromoCodeCalculatorModule.java:100:\t\t\t\t\treduction = reduction.multiply(new BigDecimal(shoppingCartItem.getQuantity()));\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/store/MerchantStoreApi.java:32:import org.springframework.web.multipart.MultipartFile;\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/store/MerchantStoreApi.java:105:\t@ApiOperation(httpMethod = \"GET\", value = \"Get retailer child stores\", notes = \"Merchant (retailer) can have multiple stores\", response = ReadableMerchantStore.class)\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/system/ModulesApi.java:22:      \"code\": \"paypal-express-checkout\",\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/system/ModulesApi.java:27:      \"configuration\":[{\"env\":\"TEST\",\"scheme\":\"\",\"host\":\"\",\"port\":\"\",\"uri\":\"\",\"config1\":\"https://www.sandbox.paypal.com/cgi-bin/webscr?cmd=_express-checkout&token=\"},{\"env\":\"PROD\",\"scheme\":\"\",\"host\":\"\",\"port\":\"\",\"uri\":\"\",\"config1\":\"https://www.paypal.com/cgi-bin/webscr?cmd=_express-checkout&token=\"}]\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/content/ContentApi.java:27:import org.springframework.web.multipart.MultipartFile;\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/order/OrderStatusHistoryApi.java:34:@