ng checkout\", e);\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/order/OrderApi.java:387:\t\t\t\tresponse.sendError(503, \"Error while processing checkout \" + e.getMessage());\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/order/OrderApi.java:395:\t * Main checkout resource that will complete the order flow\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/order/OrderApi.java:402:\t@RequestMapping(value = { \"/cart/{code}/checkout\" }, method = RequestMethod.POST)\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/order/OrderApi.java:407:\tpublic ReadableOrderConfirmation checkout(\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/order/OrderApi.java:468:\t\t\tthrow new ServiceRuntimeException(\"Error during checkout [\" + message + \"]\", e);\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/order/OrderApi.java:494:\t@RequestMapping(value = { \"/private/orders/{id}/status\" }, method = RequestMethod.PUT)\n","exit_code":0,"status":"completed"}}
