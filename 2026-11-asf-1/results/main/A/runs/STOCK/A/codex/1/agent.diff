+
+	private void validateProductStock(Product product, int quantity) {
+		if (product == null || CollectionUtils.isEmpty(product.getAvailabilities())) {
+			throw new StockConflictException("Product inventory is not configured");
+		}
+		for (ProductAvailability availability : product.getAvailabilities()) {
+			Integer stock = availability.getProductQuantity();
+			if (stock == null || stock < quantity) {
+				throw new StockConflictException("Insufficient stock for product " + product.getSku());
+			}
+		}
+	}
