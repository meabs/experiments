{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"nl -ba sm-core/src/main/java/com/salesmanager/core/business/services/order/returns/OrderReturnServiceImpl.java | sed -n '1,70p'\"","aggregated_output":"     1\tpackage com.salesmanager.core.business.services.order.returns;\n     2\t\n     3\timport java.math.*; import java.util.*; import javax.inject.Inject; import javax.transaction.Transactional;\n     4\timport org.springframework.stereotype.Service;\n     5\timport com.salesmanager.core.business.repositories.order.OrderReturnRepository; import com.salesmanager.core.business.services.order.OrderService; import com.salesmanager.core.business.services.payments.TransactionService; import com.salesmanager.core.business.services.catalog.product.availability.ProductAvailabilityService;\n     6\timport com.salesmanager.core.model.catalog.product.availability.ProductAvailability; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.order.*; import com.salesmanager.core.model.order.orderproduct.OrderProduct; import com.salesmanager.core.model.order.orderstatus.*; import com.salesmanager.core.model.order.returns.*; import com.salesmanager.core.model.payments.*;\n     7\t\n     8\t@Service(\"orderReturnService\") public class OrderReturnServiceImpl implements OrderReturnService {\n     9\t @Inject private OrderReturnRepository repository; @Inject private OrderService orderService; @Inject private TransactionService transactionService; @Inject private ProductAvailabilityService availabilityService;\n    10\t private static final BigDecimal ZERO=BigDecimal.ZERO;\n    11\t @Override @Transactional public OrderReturn create(Order order, MerchantStore store, Map<String,Integer> requested, boolean restock, String reason) {\n    12\t  if(order==null) throw new ReturnException(\"Order does not exist\");\n    13\t  if(order.getStatus()==OrderStatus.CANCELED||order.getStatus()==OrderStatus.REFUNDED) throw new ReturnConflictException(\"Order cannot be returned\");\n    14\t  if(requested==null||requested.isEmpty()||requested.values().stream().anyMatch(q->q==null||q<=0)) throw new ReturnException(\"At least one valid line is required\");\n    15\t  Map<String,OrderProduct> products=new HashMap<>(); for(OrderProduct p:order.getOrderProducts()) products.put(p.getSku(),p);\n    16\t  Map<String,Integer> already=new HashMap<>(); for(OrderReturn r:repository.findByOrderIdOrderByDateAscIdAsc(order.getId())) for(OrderReturnLine l:r.getLines()) already.merge(l.getSku(),l.getQuantity(),Integer::sum);\n    17\t  BigDecimal subtotal=ZERO; for(OrderProduct p:order.getOrderProducts()) subtotal=subtotal.add(unit(p).multiply(BigDecimal.valueOf(p.getProductQuantity())));\n    18\t  BigDecimal returnedSubtotal=ZERO; for(Map.Entry<String,Integer> e:requested.entrySet()){ OrderProduct p=products.get(e.getKey()); if(p==null||e.getValue()+already.getOrDefault(e.getKey(),0)>p.getProductQuantity()) throw new ReturnException(\"Invalid return quantity\"); returnedSubtotal=returnedSubtotal.add(unit(p).multiply(BigDecimal.valueOf(e.getValue()))); }\n    19\t  BigDecimal orderTax=ZERO; for(OrderTotal t:order.getOrderTotal()) if(t.getOrderTotalType()==OrderTotalType.TAX) orderTax=orderTax.add(nvl(t.getValue()));\n    20\t  BigDecimal refundedTax=ZERO; for(OrderReturn r:repository.findByOrderIdOrderByDateAscIdAsc(order.getId())) refundedTax=refundedTax.add(nvl(r.getTax()));\n    21\t  boolean complete=true; for(OrderProduct p:order.getOrderProducts()) if(already.getOrDefault(p.getSku(),0)+requested.getOrDefault(p.getSku(),0)<p.getProductQuantity()) complete=false;\n    22\t  BigDecimal tax=complete?orderTax.subtract(refundedTax):subtotal.signum()==0?ZERO:orderTax.multiply(returnedSubtotal).divide(subtotal,2,RoundingMode.HALF_UP); tax=tax.setScale(2,RoundingMode.HALF_UP);\n    23\t  OrderReturn result=new OrderReturn(); result.setOrder(order); result.setTax(tax); result.setAmount(returnedSubtotal.add(tax).setScale(2,RoundingMode.HALF_UP)); result.setRestocked(restock); result.setReason(reason); result.setDate(new Date());\n    24\t  for(Map.Entry<String,Integer> e:requested.entrySet()){OrderProduct p=products.get(e.getKey()); OrderReturnLine l=new OrderReturnLine(); l.setOrderReturn(result); l.setSku(e.getKey()); l.setQuantity(e.getValue()); l.setAmount(unit(p).multiply(BigDecimal.valueOf(e.getValue())).setScale(2,RoundingMode.HALF_UP)); result.getLines().add(l); if(restock){ for(ProductAvailability a:availabilityService.getBySku(e.getKey(),store)) {a.setProductQuantity(a.getProductQuantity()+e.getValue()); availabilityService.saveOrUpdate(a); break;}}}\n    25\t  repository.save(result); Transaction tx=new Transaction(); tx.setOrder(order); tx.setAmount(result.getAmount()); tx.setTransactionType(TransactionType.REFUND); tx.setTransactionDate(new Date()); tx.setPaymentType(order.getPaymentType()); transactionService.create(tx);\n    26\t  OrderTotal refund=null; for(OrderTotal t:order.getOrderTotal()) if(\"order.total.refunded\".equals(t.getOrderTotalCode())) refund=t; if(refund==null){refund=new OrderTotal(); refund.setOrder(order); refund.setOrderTotalCode(\"order.total.refunded\"); refund.setOrderTotalType(OrderTotalType.REFUND); refund.setModule(\"refund\"); refund.setTitle(\"refund\"); refund.setText(\"refund\"); refund.setSortOrder(100); order.getOrderTotal().add(refund);} refund.setValue(nvl(refund.getValue()).add(result.getAmount()));\n    27\t  OrderStatus status=complete?OrderStatus.REFUNDED:order.getStatus(); if(complete) order.setStatus(status); OrderStatusHistory h=new OrderStatusHistory(); h.setOrder(order); h.setStatus(status); h.setDateAdded(new Date()); h.setComments(\"Refunded amount \"+result.getAmount()); order.getOrderHistory().add(h); try{orderService.saveOrUpdate(order);}catch(Exception e){throw new ReturnException(e.getMessage());} return result;\n    28\t }\n    29\t private BigDecimal unit(OrderProduct p){return nvl(p.getOneTimeCharge());} private BigDecimal nvl(BigDecimal v){return v==null?ZERO:v;}\n    30\t @Override public List<OrderReturn> list(Order order){return repository.findByOrderIdOrderByDateAscIdAsc(order.getId());}\n    31\t}\n","exit_code":0,"status":"completed"}}
