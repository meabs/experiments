+package com.salesmanager.shop.store.api.v1.order;
+import java.util.*; import java.util.stream.*; import javax.inject.Inject;
+import org.springframework.http.HttpStatus; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.business.services.order.OrderService; import com.salesmanager.core.business.services.order.returns.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.order.Order; import com.salesmanager.core.model.order.returns.*; import com.salesmanager.core.model.reference.language.Language; import com.salesmanager.shop.constants.Constants; import com.salesmanager.shop.model.order.returns.*; import com.salesmanager.shop.store.api.exception.ResourceNotFoundException; import com.salesmanager.shop.utils.AuthorizationUtils; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/orders") public class OrderReturnApi {
+ @Inject private OrderService orders; @Inject private OrderReturnService returns; @Inject private AuthorizationUtils auth;
+ private void authorize(MerchantStore store){auth.authorizeUser(auth.authenticatedUser(),Arrays.asList(Constants.GROUP_SUPERADMIN,Constants.GROUP_ADMIN,Constants.GROUP_ADMIN_ORDER,Constants.GROUP_ADMIN_RETAIL),store);}
+ @PostMapping("/{id}/returns") @ResponseStatus(HttpStatus.CREATED) public ReadableOrderReturn create(@PathVariable Long id,@RequestBody PersistableOrderReturn body,@ApiIgnore MerchantStore store,@ApiIgnore Language lang){authorize(store); Order o=order(id,store); Map<String,Integer> lines=new LinkedHashMap<>(); if(body!=null&&body.getLines()!=null) for(PersistableOrderReturn.Line l:body.getLines()) lines.merge(l.getSku(),l.getQuantity(),Integer::sum); return map(returns.create(o,store,lines,body!=null&&body.isRestock(),body==null?null:body.getReason()));}
+ @GetMapping("/{id}/returns") public List<ReadableOrderReturn> list(@PathVariable Long id,@ApiIgnore MerchantStore store){authorize(store); Order o=order(id,store); return returns.list(o).stream().map(this::map).collect(Collectors.toList());}
+ @PostMapping("/{id}/refund") @ResponseStatus(HttpStatus.CREATED) public ReadableOrderReturn refund(@PathVariable Long id,@ApiIgnore MerchantStore store){authorize(store); Order o=order(id,store); Map<String,Integer> lines=new LinkedHashMap<>(); Map<String,Integer> used=new HashMap<>(); for(OrderReturn r:returns.list(o))for(OrderReturnLine l:r.getLines())used.merge(l.getSku(),l.getQuantity(),Integer::sum); for(com.salesmanager.core.model.order.orderproduct.OrderProduct p:o.getOrderProducts()){int n=p.getProductQuantity()-used.getOrDefault(p.getSku(),0);if(n>0)lines.merge(p.getSku(),n,Integer::sum);} return map(returns.create(o,store,lines,false,"refund"));}
+ private Order order(Long id,MerchantStore store){Order o=orders.getOrder(id,store);if(o==null)throw new ResourceNotFoundException("Order id "+id+" does not exist");return o;}
+ private ReadableOrderReturn map(OrderReturn r){ReadableOrderReturn x=new ReadableOrderReturn();x.id=r.getId();x.orderId=r.getOrder().getId();x.tax=r.getTax();x.amount=r.getAmount();x.restocked=r.isRestocked();x.reason=r.getReason();x.date=r.getDate().toInstant().atZone(java.time.ZoneId.systemDefault()).toLocalDate();for(OrderReturnLine l:r.getLines()){ReadableOrderReturn.Line q=new ReadableOrderReturn.Line();q.sku=l.getSku();q.quantity=l.getQuantity();q.amount=l.getAmount();x.lines.add(q);}return x;}
+}
