+++ b/sm-shop/src/main/java/com/salesmanager/shop/store/api/v1/order/OrderReturnApi.java
@@ -0,0 +1,127 @@
+package com.salesmanager.shop.store.api.v1.order;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.util.*;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+import com.fasterxml.jackson.annotation.JsonFormat;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.order.OrderReturnRepository;
+import com.salesmanager.core.business.services.catalog.product.availability.ProductAvailabilityService;
+import com.salesmanager.core.business.services.order.OrderService;
+import com.salesmanager.core.business.services.payments.TransactionService;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.*;
+import com.salesmanager.core.model.order.orderproduct.OrderProduct;
+import com.salesmanager.core.model.order.orderstatus.OrderStatus;
+import com.salesmanager.core.model.order.orderstatus.OrderStatusHistory;
+import com.salesmanager.core.model.payments.Transaction;
+import com.salesmanager.core.model.payments.TransactionType;
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.model.order.ReturnRequest;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ReturnBadRequestException;
+import com.salesmanager.shop.store.api.exception.ReturnConflictException;
+import com.salesmanager.shop.utils.AuthorizationUtils;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/orders/{id}")
+public class OrderReturnApi {
+    @Inject private OrderService orderService;
+    @Inject private OrderReturnRepository returnRepository;
+    @Inject private TransactionService transactionService;
+    @Inject private ProductAvailabilityService availabilityService;
+    @Inject private AuthorizationUtils authorizationUtils;
+
+    @PostMapping("/returns")
+    @ResponseStatus(HttpStatus.CREATED)
+    @Transactional
+    public ReturnView create(@PathVariable Long id, @RequestBody ReturnRequest request, @ApiIgnore MerchantStore store) {
+        authorize(store);
+        Order order = order(id, store);
+        return createReturn(order, request, store);
+    }
+
+    @GetMapping("/returns")
+    @Transactional(Transactional.TxType.SUPPORTS)
+    public List<ReturnView> list(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        authorize(store);
+        Order order = order(id, store);
+        return returnRepository.findByOrderIdOrderByDateAscIdAsc(order.getId()).stream().map(ReturnView::new).collect(Collectors.toList());
+    }
+
+    @PostMapping("/refund")
+    @ResponseStatus(HttpStatus.CREATED)
+    @Transactional
+    public ReturnView refund(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        authorize(store);
+        Order order = order(id, store);
+        Map<String,Integer> quantities = new LinkedHashMap<>();
+        for (OrderProduct product : order.getOrderProducts()) {
+            int returned = returnedQuantity(order, product.getSku());
+            if (product.getProductQuantity() > returned) quantities.put(product.getSku(), product.getProductQuantity() - returned);
+        }
+        if (quantities.isEmpty()) throw new ReturnBadRequestException("Order has no refundable items");
+        ReturnRequest request = new ReturnRequest();
+        request.setRestock(false); request.setReason("refund");
+        request.setLines(new ArrayList<>());
+        quantities.forEach((sku, quantity) -> { ReturnRequest.Line line = new ReturnRequest.Line(); line.setSku(sku); line.setQuantity(quantity); request.getLines().add(line); });
+        return createReturn(order, request, store);
+    }
+
+    private ReturnView createReturn(Order order, ReturnRequest request, MerchantStore store) {
+        if (order.getStatus() == OrderStatus.CANCELED || order.getStatus() == OrderStatus.REFUNDED)
+            throw new ReturnConflictException("Order cannot be returned or refunded in status " + order.getStatus());
+        if (request == null || request.getLines() == null || request.getLines().isEmpty()) throw new ReturnBadRequestException("At least one return line is required");
+        Map<String,Integer> requested = new LinkedHashMap<>();
+        for (ReturnRequest.Line line : request.getLines()) {
+            if (line == null || line.getSku() == null || line.getSku().trim().isEmpty() || line.getQuantity() <= 0) throw new ReturnBadRequestException("Invalid return line");
+            requested.merge(line.getSku(), line.getQuantity(), Integer::sum);
+        }
+        Map<String,OrderProduct> products = order.getOrderProducts().stream().collect(Collectors.toMap(OrderProduct::getSku, p -> p, (a,b) -> a, LinkedHashMap::new));
+        BigDecimal productSubtotal = BigDecimal.ZERO;
+        for (OrderProduct product : order.getOrderProducts()) productSubtotal = productSubtotal.add(product.getOneTimeCharge().multiply(BigDecimal.valueOf(product.getProductQuantity())));
+        BigDecimal lineAmount = BigDecimal.ZERO;
+        boolean completes = true;
+        for (Map.Entry<String,Integer> entry : requested.entrySet()) {
+            OrderProduct product = products.get(entry.getKey());
+            if (product == null || entry.getValue() > product.getProductQuantity() - returnedQuantity(order, entry.getKey())) throw new ReturnBadRequestException("Invalid return quantity for sku " + entry.getKey());
+        }
+        for (OrderProduct product : order.getOrderProducts()) if (product.getProductQuantity() > returnedQuantity(order, product.getSku()) + requested.getOrDefault(product.getSku(), 0)) completes = false;
+        BigDecimal orderTax = order.getOrderTotal().stream().filter(t -> t.getOrderTotalType() == OrderTotalType.TAX).map(OrderTotal::getValue).reduce(BigDecimal.ZERO, BigDecimal::add);
+        BigDecimal previousTax = returnRepository.findByOrderIdOrderByDateAscIdAsc(order.getId()).stream().map(OrderReturn::getTax).reduce(BigDecimal.ZERO, BigDecimal::add);
+        OrderReturn result = new OrderReturn(); result.setOrder(order); result.setRestocked(Boolean.TRUE.equals(request.getRestock())); result.setReason(request.getReason()); result.setDate(new Date());
+        for (Map.Entry<String,Integer> entry : requested.entrySet()) { OrderProduct product = products.get(entry.getKey()); BigDecimal amount = product.getOneTimeCharge().multiply(BigDecimal.valueOf(entry.getValue())).setScale(2, RoundingMode.HALF_UP); lineAmount = lineAmount.add(amount); OrderReturnLine line = new OrderReturnLine(); line.setOrderReturn(result); line.setSku(entry.getKey()); line.setQuantity(entry.getValue()); line.setAmount(amount); result.getLines().add(line); }
+        BigDecimal tax = completes ? orderTax.subtract(previousTax) : productSubtotal.signum() == 0 ? BigDecimal.ZERO : orderTax.multiply(lineAmount).divide(productSubtotal, 2, RoundingMode.HALF_UP);
+        tax = tax.setScale(2, RoundingMode.HALF_UP); result.setTax(tax); result.setAmount(lineAmount.add(tax).setScale(2, RoundingMode.HALF_UP));
+        try { returnRepository.save(result); } catch (RuntimeException e) { throw e; }
+        if (result.isRestocked()) for (String sku : requested.keySet()) for (ProductAvailability availability : availabilityService.getBySku(sku, store)) { availability.setProductQuantity(availability.getProductQuantity() + requested.get(sku)); try { availabilityService.update(availability); } catch (ServiceException e) { throw new IllegalStateException(e); } break; }
+        Transaction transaction = new Transaction(); transaction.setOrder(order); transaction.setAmount(result.getAmount()); transaction.setTransactionType(TransactionType.REFUND); transaction.setPaymentType(order.getPaymentType()); transaction.setTransactionDate(new Date()); try { transactionService.create(transaction); } catch (ServiceException e) { throw new IllegalStateException(e); }
+        BigDecimal refunded = returnRepository.findByOrderIdOrderByDateAscIdAsc(order.getId()).stream().map(OrderReturn::getAmount).reduce(BigDecimal.ZERO, BigDecimal::add);
+        OrderTotal refundTotal = order.getOrderTotal().stream().filter(t -> "order.total.refunded".equals(t.getOrderTotalCode())).findFirst().orElse(null);
+        if (refundTotal == null) { refundTotal = new OrderTotal(); refundTotal.setOrder(order); refundTotal.setOrderTotalCode("order.total.refunded"); refundTotal.setOrderTotalType(OrderTotalType.REFUND); refundTotal.setSortOrder(100); order.getOrderTotal().add(refundTotal); }
+        refundTotal.setValue(refunded.setScale(2, RoundingMode.HALF_UP));
+        if (completes) order.setStatus(OrderStatus.REFUNDED);
+        OrderStatusHistory history = new OrderStatusHistory(); history.setOrder(order); history.setStatus(order.getStatus()); history.setDateAdded(new Date()); history.setComments("Refunded amount " + result.getAmount().setScale(2, RoundingMode.HALF_UP)); order.getOrderHistory().add(history);
+        try { orderService.saveOrUpdate(order); } catch (ServiceException e) { throw new IllegalStateException(e); }
+        return new ReturnView(result);
+    }
+
+    private int returnedQuantity(Order order, String sku) { return returnRepository.findByOrderIdOrderByDateAscIdAsc(order.getId()).stream().flatMap(r -> r.getLines().stream()).filter(l -> sku.equals(l.getSku())).mapToInt(OrderReturnLine::getQuantity).sum(); }
+    private Order order(Long id, MerchantStore store) { Order order = orderService.getOrder(id, store); if (order == null) throw new ResourceNotFoundException("Order id " + id + " does not exist"); return order; }
+    private void authorize(MerchantStore store) { String user = authorizationUtils.authenticatedUser(); authorizationUtils.authorizeUser(user, Arrays.asList(Constants.GROUP_SUPERADMIN, Constants.GROUP_ADMIN, Constants.GROUP_ADMIN_ORDER, Constants.GROUP_ADMIN_RETAIL), store); }
+
+    public static class ReturnView {
+        public Long id; public Long orderId; public List<LineView> lines; public BigDecimal tax; public BigDecimal amount; public boolean restocked; public String reason; @JsonFormat(pattern="yyyy-MM-dd") public Date date;
+        ReturnView(OrderReturn source) { id=source.getId(); orderId=source.getOrder().getId(); tax=source.getTax(); amount=source.getAmount(); restocked=source.isRestocked(); reason=source.getReason(); date=source.getDate(); lines=source.getLines().stream().map(LineView::new).collect(Collectors.toList()); }
+    }
+    public static class LineView { public String sku; public int quantity; public BigDecimal amount; LineView(OrderReturnLine source) { sku=source.getSku(); quantity=source.getQuantity(); amount=source.getAmount(); } }
+}
