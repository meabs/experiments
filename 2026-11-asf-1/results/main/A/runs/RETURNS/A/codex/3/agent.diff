+package com.salesmanager.shop.store.api.v1.order;
+
+import java.time.ZoneId;
+import java.util.List;
+import java.util.stream.Collectors;
+import java.util.stream.Stream;
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestMethod;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.stereotype.Controller;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.OrderReturn;
+import com.salesmanager.core.model.order.OrderReturnLine;
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.model.order.returns.PersistableReturn;
+import com.salesmanager.shop.model.order.returns.ReadableReturn;
+import com.salesmanager.shop.model.order.returns.ReadableReturnLine;
+import com.salesmanager.shop.store.controller.order.ReturnService;
+import com.salesmanager.shop.utils.AuthorizationUtils;
+import springfox.documentation.annotations.ApiIgnore;
+
+@Controller
+@RequestMapping("/api/v1/private/orders")
+public class OrderReturnApi {
+    @Inject private ReturnService returnService;
+    @Inject private AuthorizationUtils authorizationUtils;
+    @RequestMapping(value="/{id}/returns", method=RequestMethod.POST)
+    @ResponseStatus(HttpStatus.CREATED) @ResponseBody
+    public ReadableReturn create(@PathVariable Long id, @RequestBody PersistableReturn request, @ApiIgnore MerchantStore store) { authorize(store); return map(returnService.create(id, store, request)); }
+    @RequestMapping(value="/{id}/returns", method=RequestMethod.GET)
+    @ResponseStatus(HttpStatus.OK) @ResponseBody
+    public List<ReadableReturn> list(@PathVariable Long id, @ApiIgnore MerchantStore store) { authorize(store); return returnService.list(id, store).stream().map(this::map).collect(Collectors.toList()); }
+    @RequestMapping(value="/{id}/refund", method=RequestMethod.POST)
+    @ResponseStatus(HttpStatus.CREATED) @ResponseBody
+    public ReadableReturn refund(@PathVariable Long id, @ApiIgnore MerchantStore store) { authorize(store); return map(returnService.refund(id, store)); }
+    private void authorize(MerchantStore store) { String user=authorizationUtils.authenticatedUser(); authorizationUtils.authorizeUser(user, Stream.of(Constants.GROUP_SUPERADMIN,Constants.GROUP_ADMIN,Constants.GROUP_ADMIN_ORDER,Constants.GROUP_ADMIN_RETAIL).collect(Collectors.toList()), store); }
+    private ReadableReturn map(OrderReturn source) { ReadableReturn r=new ReadableReturn(); r.setId(source.getId()); r.setOrderId(source.getOrder().getId()); r.setTax(source.getTax()); r.setAmount(source.getAmount()); r.setRestocked(source.isRestocked()); r.setReason(source.getReason()); r.setDate(source.getDate().toInstant().atZone(ZoneId.systemDefault()).toLocalDate()); r.setLines(source.getLines().stream().map(this::mapLine).collect(Collectors.toList())); return r; }
+    private ReadableReturnLine mapLine(OrderReturnLine source) { ReadableReturnLine l=new ReadableReturnLine(); l.setSku(source.getSku()); l.setQuantity(source.getQuantity()); l.setAmount(source.getAmount()); return l; }
+}
