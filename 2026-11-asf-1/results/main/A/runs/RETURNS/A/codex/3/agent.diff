+package com.salesmanager.shop.store.controller.order;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.order.OrderReturnRepository;
+import com.salesmanager.core.business.services.catalog.product.availability.ProductAvailabilityService;
+import com.salesmanager.core.business.services.order.OrderService;
+import com.salesmanager.core.business.services.payments.TransactionService;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.Order;
+import com.salesmanager.core.model.order.orderproduct.OrderProduct;
+import com.salesmanager.core.model.order.OrderReturn;
+import com.salesmanager.core.model.order.OrderReturnLine;
+import com.salesmanager.core.model.order.OrderTotal;
+import com.salesmanager.core.model.order.OrderTotalType;
+import com.salesmanager.core.model.order.orderstatus.OrderStatus;
+import com.salesmanager.core.model.order.orderstatus.OrderStatusHistory;
+import com.salesmanager.core.model.payments.Transaction;
+import com.salesmanager.core.model.payments.TransactionType;
+import com.salesmanager.shop.model.order.returns.PersistableReturn;
+import com.salesmanager.shop.model.order.returns.PersistableReturnLine;
+import com.salesmanager.shop.store.api.exception.ConflictException;
+import com.salesmanager.shop.store.api.exception.InvalidRequestException;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+
+@Service
+public class ReturnService {
+    @Inject private OrderService orderService;
+    @Inject private OrderReturnRepository returnRepository;
+    @Inject private TransactionService transactionService;
+    @Inject private ProductAvailabilityService availabilityService;
+
+    public List<OrderReturn> list(Long id, MerchantStore store) {
+        Order order = order(id, store);
+        return returnRepository.findByOrderIdOrderByDateAscIdAsc(order.getId());
+    }
+
+    @Transactional
+    public OrderReturn create(Long id, MerchantStore store, PersistableReturn request) {
+        Order order = order(id, store);
+        if (order.getStatus() == OrderStatus.CANCELED || order.getStatus() == OrderStatus.REFUNDED)
+            throw new ConflictException("Order cannot be returned in status " + order.getStatus());
+        if (request == null || request.getLines() == null || request.getLines().isEmpty()) throw new InvalidRequestException("At least one return line is required");
+
+        Map<String,Integer> requested = new LinkedHashMap<>();
+        for (PersistableReturnLine line : request.getLines()) {
+            if (line == null || line.getSku() == null || line.getQuantity() <= 0) throw new InvalidRequestException("Invalid return line");
+            requested.merge(line.getSku(), line.getQuantity(), Integer::sum);
+        }
+        Map<String,OrderProduct> products = new LinkedHashMap<>();
+        for (OrderProduct p : order.getOrderProducts()) products.put(p.getSku(), p);
+        Map<String,Integer> already = new LinkedHashMap<>();
+        for (OrderReturn old : returnRepository.findByOrderIdOrderByDateAscIdAsc(order.getId())) for (OrderReturnLine l : old.getLines()) already.merge(l.getSku(), l.getQuantity(), Integer::sum);
+        for (Map.Entry<String,Integer> e : requested.entrySet()) {
+            OrderProduct p = products.get(e.getKey());
+            if (p == null || e.getValue() + already.getOrDefault(e.getKey(), 0) > p.getProductQuantity()) throw new InvalidRequestException("Invalid return quantity for sku " + e.getKey());
+        }
+
+        BigDecimal lineAmount = BigDecimal.ZERO;
+        BigDecimal productSubtotal = BigDecimal.ZERO;
+        for (OrderProduct p : order.getOrderProducts()) productSubtotal = productSubtotal.add(p.getOneTimeCharge().multiply(BigDecimal.valueOf(p.getProductQuantity())));
+        BigDecimal orderTax = order.getOrderTotal().stream().filter(t -> t.getOrderTotalType() == OrderTotalType.TAX).map(OrderTotal::getValue).reduce(BigDecimal.ZERO, BigDecimal::add);
+        List<OrderReturn> previousReturns = returnRepository.findByOrderIdOrderByDateAscIdAsc(order.getId());
+        BigDecimal priorTax = previousReturns.stream().map(OrderReturn::getTax).reduce(BigDecimal.ZERO, BigDecimal::add);
+        OrderReturn result = new OrderReturn(); result.setOrder(order); result.setRestocked(Boolean.TRUE.equals(request.getRestock())); result.setReason(request.getReason()); result.setDate(new Date());
+        for (Map.Entry<String,Integer> e : requested.entrySet()) { OrderProduct p = products.get(e.getKey()); BigDecimal amount = p.getOneTimeCharge().multiply(BigDecimal.valueOf(e.getValue())).setScale(2, RoundingMode.HALF_UP); lineAmount = lineAmount.add(amount); OrderReturnLine l = new OrderReturnLine(); l.setOrderReturn(result); l.setSku(e.getKey()); l.setQuantity(e.getValue()); l.setAmount(amount); result.getLines().add(l); if (result.isRestocked()) restock(e.getKey(), store, e.getValue()); }
+        boolean complete = true; for (OrderProduct p : order.getOrderProducts()) if (already.getOrDefault(p.getSku(), 0) + requested.getOrDefault(p.getSku(), 0) < p.getProductQuantity()) complete = false;
+        BigDecimal tax = complete ? orderTax.subtract(priorTax) : productSubtotal.signum() == 0 ? BigDecimal.ZERO : orderTax.multiply(lineAmount).divide(productSubtotal, 2, RoundingMode.HALF_UP);
+        tax = tax.setScale(2, RoundingMode.HALF_UP); result.setTax(tax); result.setAmount(lineAmount.add(tax).setScale(2, RoundingMode.HALF_UP));
+        result = returnRepository.save(result);
+        Transaction transaction = new Transaction(); transaction.setOrder(order); transaction.setAmount(result.getAmount()); transaction.setTransactionType(TransactionType.REFUND); transaction.setTransactionDate(new Date()); try { transactionService.create(transaction); } catch (Exception e) { throw new InvalidRequestException("Unable to record refund payment"); }
+        BigDecimal refunded = previousReturns.stream().map(OrderReturn::getAmount).reduce(BigDecimal.ZERO, BigDecimal::add).add(result.getAmount()).setScale(2, RoundingMode.HALF_UP); OrderTotal refundTotal = order.getOrderTotal().stream().filter(t -> "order.total.refunded".equals(t.getOrderTotalCode())).findFirst().orElse(null); if (refundTotal == null) { refundTotal = new OrderTotal(); refundTotal.setOrder(order); refundTotal.setOrderTotalCode("order.total.refunded"); refundTotal.setModule("order.total.refunded"); refundTotal.setOrderTotalType(OrderTotalType.REFUND); refundTotal.setSortOrder(100); order.getOrderTotal().add(refundTotal); } refundTotal.setValue(refunded);
+        if (complete) order.setStatus(OrderStatus.REFUNDED); OrderStatusHistory history = new OrderStatusHistory(); history.setOrder(order); history.setStatus(order.getStatus()); history.setDateAdded(new Date()); history.setComments("Refunded " + result.getAmount()); order.getOrderHistory().add(history); try { orderService.saveOrUpdate(order); } catch (Exception e) { throw new InvalidRequestException("Unable to save returned order"); } return result;
+    }
+    @Transactional
+    public OrderReturn refund(Long id, MerchantStore store) {
+        Order order = order(id, store);
+        Map<String,Integer> returned = new LinkedHashMap<>();
