{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc 'rg -n \"priorTax|refunded\" sm-shop/src/main/java/com/salesmanager/shop/store/controller/order/ReturnService.java'","aggregated_output":"72:        BigDecimal priorTax = returnRepository.findByOrderIdOrderByDateAscIdAsc(order.getId()).stream().map(OrderReturn::getTax).reduce(BigDecimal.ZERO, BigDecimal::add);\n76:        BigDecimal tax = complete ? orderTax.subtract(priorTax) : productSubtotal.signum() == 0 ? BigDecimal.ZERO : orderTax.multiply(lineAmount).divide(productSubtotal, 2, RoundingMode.HALF_UP);\n80:        BigDecimal refunded = priorTax.add(lineAmount).add(tax).setScale(2, RoundingMode.HALF_UP); OrderTotal refundTotal = order.getOrderTotal().stream().filter(t -> \"order.total.refunded\".equals(t.getOrderTotalCode())).findFirst().orElse(null); if (refundTotal == null) { refundTotal = new OrderTotal(); refundTotal.setOrder(order); refundTotal.setOrderTotalCode(\"order.total.refunded\"); refundTotal.setModule(\"order.total.refunded\"); refundTotal.setOrderTotalType(OrderTotalType.REFUND); refundTotal.setSortOrder(100); order.getOrderTotal().add(refundTotal); } refundTotal.setValue(refunded);\n","exit_code":0,"status":"completed"}}
