{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"nl -ba sm-shop/src/main/java/com/salesmanager/shop/store/controller/order/ReturnService.java | sed -n '74,86p'\"","aggregated_output":"    74\t        OrderReturn result = new OrderReturn(); result.setOrder(order); result.setRestocked(Boolean.TRUE.equals(request.getRestock())); result.setReason(request.getReason()); result.setDate(new Date());\n    75\t        for (Map.Entry<String,Integer> e : requested.entrySet()) { OrderProduct p = products.get(e.getKey()); BigDecimal amount = p.getOneTimeCharge().multiply(BigDecimal.valueOf(e.getValue())).setScale(2, RoundingMode.HALF_UP); lineAmount = lineAmount.add(amount); OrderReturnLine l = new OrderReturnLine(); l.setOrderReturn(result); l.setSku(e.getKey()); l.setQuantity(e.getValue()); l.setAmount(amount); result.getLines().add(l); if (result.isRestocked()) restock(e.getKey(), store, e.getValue()); }\n    76\t        boolean complete = true; for (OrderProduct p : order.getOrderProducts()) if (already.getOrDefault(p.getSku(), 0) + requested.getOrDefault(p.getSku(), 0) < p.getProductQuantity()) complete = false;\n    77\t        BigDecimal tax = complete ? orderTax.subtract(priorTax) : productSubtotal.signum() == 0 ? BigDecimal.ZERO : orderTax.multiply(lineAmount).divide(productSubtotal, 2, RoundingMode.HALF_UP);\n    78\t        tax = tax.setScale(2, RoundingMode.HALF_UP); result.setTax(tax); result.setAmount(lineAmount.add(tax).setScale(2, RoundingMode.HALF_UP));\n    79\t        result = returnRepository.save(result);\n    80\t        Transaction transaction = new Transaction(); transaction.setOrder(order); transaction.setAmount(result.getAmount()); transaction.setTransactionType(TransactionType.REFUND); transaction.setTransactionDate(new Date()); transactionService.create(transaction);\n    81\t        BigDecimal refunded = previousReturns.stream().map(OrderReturn::getAmount).reduce(BigDecimal.ZERO, BigDecimal::add).add(result.getAmount()).setScale(2, RoundingMode.HALF_UP); OrderTotal refundTotal = order.getOrderTotal().stream().filter(t -> \"order.total.refunded\".equals(t.getOrderTotalCode())).findFirst().orElse(null); if (refundTotal == null) { refundTotal = new OrderTotal(); refundTotal.setOrder(order); refundTotal.setOrderTotalCode(\"order.total.refunded\"); refundTotal.setModule(\"order.total.refunded\"); refundTotal.setOrderTotalType(OrderTotalType.REFUND); refundTotal.setSortOrder(100); order.getOrderTotal().add(refundTotal); } refundTotal.setValue(refunded);\n    82\t        if (complete) order.setStatus(OrderStatus.REFUNDED); OrderStatusHistory history = new OrderStatusHistory(); history.setOrder(order); history.setStatus(order.getStatus()); history.setDateAdded(new Date()); history.setComments(\"Refunded \" + result.getAmount()); order.getOrderHistory().add(history); orderService.saveOrUpdate(order); return result;\n    83\t    }\n    84\t    public OrderReturn refund(Long id, MerchantStore store) {\n    85\t        Order order = order(id, store);\n    86\t        Map<String,Integer> returned = new LinkedHashMap<>();\n","exit_code":0,"status":"completed"}}
