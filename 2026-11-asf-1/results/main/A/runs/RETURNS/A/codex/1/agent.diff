+package com.salesmanager.shop.store.api.v1.order;
+
+import java.util.*;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.order.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.Order;
+import com.salesmanager.core.model.order.orderproduct.OrderProduct;
+import com.salesmanager.core.model.order.returns.*;
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.model.order.returns.*;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.utils.AuthorizationUtils;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController @RequestMapping("/api/v1")
+public class OrderReturnApi {
+ @Inject private OrderReturnService returnService; @Inject private OrderService orderService; @Inject private AuthorizationUtils authorizationUtils;
+ private void authorize(MerchantStore store) { authorizationUtils.authorizeUser(authorizationUtils.authenticatedUser(), Arrays.asList(Constants.GROUP_SUPERADMIN, Constants.GROUP_ADMIN, Constants.GROUP_ADMIN_ORDER, Constants.GROUP_ADMIN_RETAIL), store); }
+ @PostMapping("/private/orders/{id}/returns") @ResponseStatus(HttpStatus.CREATED)
+ public ReadableReturn create(@PathVariable Long id, @RequestBody PersistableReturn request, @ApiIgnore MerchantStore store) {
+   authorize(store); if (request == null) throw new ServiceRuntimeException("400", "Invalid return");
+   List<OrderReturnLine> lines = request.getLines() == null ? null : request.getLines().stream().map(l -> { OrderReturnLine x=new OrderReturnLine(); x.setSku(l.getSku()); x.setQuantity(l.getQuantity()); return x; }).collect(Collectors.toList());
+   try { return map(returnService.create(id, store, lines, request.getRestock() == null || request.getRestock(), request.getReason())); } catch (ServiceException e) { throw translate(e); }
+ }
+ @GetMapping("/private/orders/{id}/returns")
+ public List<ReadableReturn> list(@PathVariable Long id, @ApiIgnore MerchantStore store) { authorize(store); if(orderService.getOrder(id, store)==null) throw new ResourceNotFoundException("Order not found"); return returnService.list(id, store).stream().map(OrderReturnApi::map).collect(Collectors.toList()); }
+ public static ReadableReturn map(OrderReturn source) { ReadableReturn r=new ReadableReturn(); r.setId(source.getId()); r.setOrderId(source.getOrder().getId()); r.setTax(source.getTax()); r.setAmount(source.getAmount()); r.setRestocked(source.isRestocked()); r.setReason(source.getReason()); r.setDate(new java.text.SimpleDateFormat("yyyy-MM-dd").format(source.getDate())); for(OrderReturnLine x:source.getLines()){ ReadableReturnLine l=new ReadableReturnLine(); l.setSku(x.getSku()); l.setQuantity(x.getQuantity()); l.setAmount(x.getAmount()); r.getLines().add(l); } return r; }
+ static RuntimeException translate(ServiceException e) { String m=e.getMessage()==null?"":e.getMessage(); if(m.startsWith("NOT_FOUND:")) return new ResourceNotFoundException(m.substring(11)); if(m.startsWith("CONFLICT:")) return new ServiceRuntimeException("409",m.substring(10)); return new ServiceRuntimeException("400",m.replaceFirst("BAD_REQUEST:", "").trim()); }
+}
