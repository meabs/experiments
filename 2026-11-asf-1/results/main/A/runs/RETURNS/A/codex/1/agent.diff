+package com.salesmanager.core.business.services.order;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.order.OrderReturnRepository;
+import com.salesmanager.core.business.services.catalog.product.availability.ProductAvailabilityService;
+import com.salesmanager.core.business.services.payments.TransactionService;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.*;
+import com.salesmanager.core.model.order.orderproduct.OrderProduct;
+import com.salesmanager.core.model.order.orderstatus.*;
+import com.salesmanager.core.model.order.returns.*;
+import com.salesmanager.core.model.payments.*;
+
+@Service("orderReturnService")
+public class OrderReturnServiceImpl implements OrderReturnService {
+    @Inject private OrderService orderService;
+    @Inject private OrderReturnRepository repository;
+    @Inject private TransactionService transactionService;
+    @Inject private ProductAvailabilityService availabilityService;
+
+    @Override @Transactional
+    public OrderReturn create(Long orderId, MerchantStore store, List<OrderReturnLine> requested, boolean restock, String reason) throws ServiceException {
+        Order order = orderService.getOrder(orderId, store);
+        if (order == null) throw new ServiceException("NOT_FOUND: order does not exist");
+        if (order.getStatus() == OrderStatus.CANCELED || order.getStatus() == OrderStatus.REFUNDED)
+            throw new ServiceException("CONFLICT: order cannot be returned");
+        if (requested == null || requested.isEmpty()) throw new ServiceException("BAD_REQUEST: at least one return line is required");
+
+        Map<String, Integer> requestedQty = new LinkedHashMap<String, Integer>();
+        for (OrderReturnLine line : requested) {
+            if (line == null || line.getSku() == null || line.getSku().trim().isEmpty() || line.getQuantity() <= 0)
+                throw new ServiceException("BAD_REQUEST: invalid return line");
+            requestedQty.put(line.getSku(), requestedQty.containsKey(line.getSku()) ? requestedQty.get(line.getSku()) + line.getQuantity() : line.getQuantity());
+        }
+        Map<String, OrderProduct> products = new HashMap<String, OrderProduct>();
+        BigDecimal subtotal = BigDecimal.ZERO;
+        for (OrderProduct p : order.getOrderProducts()) { products.put(p.getSku(), p); subtotal = subtotal.add(p.getOneTimeCharge().multiply(BigDecimal.valueOf(p.getProductQuantity()))); }
+        Map<String, Integer> returned = new HashMap<String, Integer>();
+        BigDecimal taxAlready = BigDecimal.ZERO;
+        for (OrderReturn old : repository.findByOrderIdOrderByDateAscIdAsc(orderId)) {
+            taxAlready = taxAlready.add(old.getTax());
+            for (OrderReturnLine line : old.getLines()) returned.put(line.getSku(), returned.containsKey(line.getSku()) ? returned.get(line.getSku()) + line.getQuantity() : line.getQuantity());
+        }
+        BigDecimal lineAmount = BigDecimal.ZERO;
+        boolean complete = true;
+        for (Map.Entry<String,Integer> e : requestedQty.entrySet()) {
+            OrderProduct p = products.get(e.getKey());
+            if (p == null || e.getValue() + returned.getOrDefault(e.getKey(), 0) > p.getProductQuantity()) throw new ServiceException("BAD_REQUEST: quantity exceeds ordered quantity");
+            lineAmount = lineAmount.add(p.getOneTimeCharge().multiply(BigDecimal.valueOf(e.getValue())));
+        }
+        for (OrderProduct p : order.getOrderProducts()) if (returned.getOrDefault(p.getSku(), 0) + requestedQty.getOrDefault(p.getSku(), 0) < p.getProductQuantity()) complete = false;
+        BigDecimal orderTax = BigDecimal.ZERO;
+        for (OrderTotal total : order.getOrderTotal()) if (total.getOrderTotalType() == OrderTotalType.TAX) orderTax = orderTax.add(total.getValue());
+        BigDecimal tax = complete ? orderTax.subtract(taxAlready) : subtotal.signum() == 0 ? BigDecimal.ZERO : orderTax.multiply(lineAmount).divide(subtotal, 2, RoundingMode.HALF_UP);
+        tax = tax.setScale(2, RoundingMode.HALF_UP);
+        OrderReturn result = new OrderReturn(); result.setOrder(order); result.setDate(new Date()); result.setTax(tax); result.setAmount(lineAmount.add(tax)); result.setRestocked(restock); result.setReason(reason);
+        for (Map.Entry<String,Integer> e : requestedQty.entrySet()) {
+            OrderProduct p = products.get(e.getKey()); OrderReturnLine line = new OrderReturnLine(); line.setOrderReturn(result); line.setSku(e.getKey()); line.setQuantity(e.getValue()); line.setAmount(p.getOneTimeCharge().multiply(BigDecimal.valueOf(e.getValue())).setScale(2, RoundingMode.HALF_UP)); result.getLines().add(line);
+            if (restock) { List<ProductAvailability> stock = availabilityService.getBySku(e.getKey(), store); if (!stock.isEmpty()) { ProductAvailability a = stock.get(0); a.setProductQuantity(a.getProductQuantity() + e.getValue()); availabilityService.saveOrUpdate(a); } }
+        }
+        if (complete) order.setStatus(OrderStatus.REFUNDED);
+        OrderStatusHistory history = new OrderStatusHistory(); history.setOrder(order); history.setStatus(order.getStatus()); history.setDateAdded(new Date()); history.setComments("Refunded " + result.getAmount()); orderService.addOrderStatusHistory(order, history);
+        OrderTotal refundTotal = null; for (OrderTotal total : order.getOrderTotal()) if ("order.total.refunded".equals(total.getOrderTotalCode())) refundTotal = total;
+        if (refundTotal == null) { refundTotal = new OrderTotal(); refundTotal.setOrder(order); refundTotal.setOrderTotalCode("order.total.refunded"); refundTotal.setOrderTotalType(OrderTotalType.REFUND); refundTotal.setSortOrder(999); refundTotal.setValue(BigDecimal.ZERO); order.getOrderTotal().add(refundTotal); }
+        refundTotal.setValue(refundTotal.getValue().add(result.getAmount()));
+        orderService.saveOrUpdate(order); repository.saveAndFlush(result);
+        Transaction transaction = new Transaction(); transaction.setOrder(order); transaction.setAmount(result.getAmount()); transaction.setTransactionType(TransactionType.REFUND); transaction.setPaymentType(order.getPaymentType()); transaction.setTransactionDate(new Date()); transactionService.create(transaction);
+        return result;
+    }
+    @Override public List<OrderReturn> list(Long orderId, MerchantStore store) { Order order = orderService.getOrder(orderId, store); if (order == null) return Collections.emptyList(); return repository.findByOrderIdOrderByDateAscIdAsc(orderId); }
+}
