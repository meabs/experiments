ER.error(\"Error while filtering products product\", e);\n\t\t\ttry {\n\t\t\t\tresponse.sendError(503, \"Error while filtering products \" + e.getMessage());\n\t\t\t} catch (Exception ignore) {\n\t\t\t}\n\n\t\t\treturn null;\n\t\t}\n\t}\n\n\t/** Merchant product list, including products which are not visible to shoppers. */\n\t@RequestMapping(value = \"/private/products\", method = RequestMethod.GET)\n\t@ResponseBody\n\tpublic ReadableProductList privateList(\n\t\t\t@RequestParam(value = \"lang\", required = false) String lang,\n\t\t\t@RequestParam(value = \"category\", required = false) Long category,\n\t\t\t@RequestParam(value = \"name\", required = false) String name,\n\t\t\t@RequestParam(value = \"sku\", required = false) String sku,\n\t\t\t@RequestParam(value = \"manufacturer\", required = false) Long manufacturer,\n\t\t\t@RequestParam(value = \"optionValues\", required = false) List<Long> optionValueIds,\n\t\t\t@RequestParam(value = \"status\", required = false) String status,\n\t\t\t@RequestParam(value = \"owner\", required = false) Long owner,\n\t\t\t@RequestParam(value = \"page\", required = false, defaultValue = \"0\") Integer page,\n\t\t\t@RequestParam(value = \"count\", required = false, defaultValue = \"100\") Integer count,\n\t\t\t@RequestParam(value = \"slug\", required = false) String slug,\n\t\t\t@RequestParam(value = \"available\", required = false) Boolean available,\n\t\t\t@ApiIgnore MerchantStore merchantStore, @ApiIgnore Language language,\n\t\t\tHttpServletRequest request, HttpServletResponse response) throws Exception {\n\t\tProductCriteria criteria = new ProductCriteria();\n\t\tcriteria.setOrigin(ProductCriteria.ORIGIN_ADMIN);\n\t\tcriteria.setLanguage(lang != null ? lang : language.getCode());\n\t\tcriteria.setStartPage(page);\n\t\tcriteria.setMaxCount(count);\n\t\tif (status != null) criteria.setStatus(status);\n\t\tif (name != null) criteria.setProductName(name);\n\t\tif (sku != null) criteria.setCode(sku);\n\t\tif (manufacturer != null) criteria.setManufacturerId(manufacturer);\n\t\tif (owner != null) criteria.setOwnerId(owner);\n\t\tif (optionValueIds != null) criteria.setOptionValueIds(optionValueIds);\n\t\tif (available != null) criteria.setAvailable(available);\n\t\tif (slug != null) {\n\t\t\tCategory c = categoryService.getBySeUrl(merchantStore, slug, language);\n\t\t\tif (c != null) criteria.setCategoryIds(java.util.Collections.singletonList(c.getId()));\n\t\t} else if (category != null) {\n\t\t\tcriteria.setCategoryIds(java.util.Collections.singletonList(category));\n\t\t}\n\t\treturn productFacade.getProductListsByCriterias(merchantStore, language, criteria);\n\t}\n\n\t/**\n\t * API for getting a product\n\t * Removed in 3.2.5 in favor of /product/sku\n\t *\n\t * @param id\n\t * @param lang     ?lang=fr|en|...\n\t * @param response\n\t * @return ReadableProduct\n\t * @throws Exception\n\t *                   <p>\n\t *                   /api/product/123\n\t */\n    /**\n\t@RequestMapping(value = {\"/product/{id}\",\"/products/{id}\"}, method = RequestMethod.GET)\n\t@ApiOperation(httpMethod = \"GET\", value = \"Get a product by id\", notes = \"For administration and shop purpose. Specifying ?merchant is required otherwise it falls back to DEFAULT\")\n\t@ApiResponses(value = {\n\t\t\t@ApiResponse(code = 200, message = \"Single product found\", response = ReadableProduct.class) })\n\t@ResponseBody\n\t@ApiImplicitParams({ @ApiImplicitParam(name = \"store\", dataType = \"String\", defaultValue = \"DEFAULT\"),\n\t\t\t@ApiImplicitParam(name = \"lang\", dataType = \"String\", defaultValue = \"en\") })\n","exit_code":0,"status":"completed"}}
