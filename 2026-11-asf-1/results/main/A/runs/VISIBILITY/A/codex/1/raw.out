le(boolean visible) {\n\t\tthis.visible = visible;\n\t}\n\n\n\n}\nsm-shop-model/src/main/java/com/salesmanager/shop/model/catalog/product/product/definition/PersistableProductDefinition.java:11:public class PersistableProductDefinition extends ProductDefinition {\nsm-shop-model/src/main/java/com/salesmanager/shop/model/catalog/product/product/definition/ProductDefinition.java:17:\tprivate boolean visible = true;\nsm-shop-model/src/main/java/com/salesmanager/shop/model/catalog/product/product/definition/ProductDefinition.java:29:\t\treturn visible;\nsm-shop-model/src/main/java/com/salesmanager/shop/model/catalog/product/product/definition/ProductDefinition.java:31:\tpublic void setVisible(boolean visible) {\nsm-shop-model/src/main/java/com/salesmanager/shop/model/catalog/product/product/definition/ProductDefinition.java:32:\t\tthis.visible = visible;\nsm-shop-model/src/main/java/com/salesmanager/shop/model/catalog/product/product/definition/PersistableProductDefinition.java:11:public class PersistableProductDefinition extends ProductDefinition {\n","exit_code":1,"status":"failed"}}
