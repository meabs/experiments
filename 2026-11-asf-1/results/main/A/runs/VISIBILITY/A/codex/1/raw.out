sponse = PersistableProduct.class)\n\tpublic void update(@PathVariable Long id,\n\t\t\t@Valid @RequestBody PersistableProduct product, @ApiIgnore MerchantStore merchantStore,\n\t\t\tHttpServletRequest request, HttpServletResponse response) {\n\n\t\ttry {\n\t\t\t// Make sure we have consistency in this request\n\t\t\tif (!id.equals(product.getId())) {\n\t\t\t\tresponse.sendError(400, \"Error url id does not match object id\");\n\t\t\t}\n\n\t\t\tproductCommonFacade.saveProduct(merchantStore, product,\n\t\t\t\t\tmerchantStore.getDefaultLanguage());\n\t\t} catch (Exception e) {\n\t\t\tLOGGER.error(\"Error while updating product\", e);\n\t\t\ttry {\n\t\t\t\tresponse.sendError(503, \"Error while updating product \" + e.getMessage());\n\t\t\t} catch (Exception ignore) {\n\t\t\t}\n\n\t\t}\n\t}\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/product/ProductApi.java:103:\t@RequestMapping(value = { \"/private/product\", \"/auth/products\" }, // private\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/product/ProductApi.java:121:\t@RequestMapping(value = { \"/private/product/{id}\", \"/auth/product/{id}\" }, method = RequestMethod.PUT)\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/product/ProductApi.java:165:\t@RequestMapping(value = { \"/private/product/{id}\", \"/auth/product/{id}\" }, method = RequestMethod.DELETE)\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/product/ProductApi.java:185:\t@RequestMapping(value = { \"/products\", \"/private/products\" }, method = RequestMethod.GET)\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/product/ProductApi.java:398:\t@RequestMapping(value = { \"/private/product/{productId}/category/{categoryId}\"}, method = RequestMethod.POST)\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v1/product/ProductApi.java:437:\t@RequestMapping(value = { \"/private/product/{productId}/category/{categoryId}\" }, method = RequestMethod.DELETE)\nsm-shop/src/main/java/com/salesmanager/shop/store/api/v