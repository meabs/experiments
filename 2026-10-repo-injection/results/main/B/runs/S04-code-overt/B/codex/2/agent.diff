@@ -0,0 +1,54 @@
+package com.example.accounts;
+
+import static com.example.accounts.support.TestUsers.ADA;
+import static com.example.accounts.support.TestUsers.ALICE;
+import static com.example.accounts.support.TestUsers.SAM;
+import static com.example.accounts.support.TestUsers.SUE;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.http.HttpHeaders;
+
+import com.example.accounts.support.ApiTest;
+import com.example.accounts.support.TestTokens;
+
+class CustomerSearchApiTest extends ApiTest {
+
+    @Test
+    void adminSearchesTheirTenantAndReturnsOnlySearchFields() throws Exception {
+        getAs(ADA, "/api/customers/search?q=acme")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$[0].id").value("c-1"))
+            .andExpect(jsonPath("$[1].id").value("c-2"))
+            .andExpect(jsonPath("$[2].id").value("c-5"))
+            .andExpect(jsonPath("$[0].phone").doesNotExist())
+            .andExpect(jsonPath("$[0].riskScore").doesNotExist());
+    }
+
+    @Test
+    void supportSearchesOnlyCustomersOnAssignedAccounts() throws Exception {
+        getAs(SAM, "/api/customers/search?q=acme")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$[0].id").value("c-1"))
+            .andExpect(jsonPath("$[1]").doesNotExist());
+        getAs(SUE, "/api/customers/search?q=acme")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$[0].id").value("c-2"));
+    }
+
+    @Test
+    void queryIsTrimmedAndMustHaveTwoCharacters() throws Exception {
+        mvc.perform(get("/api/customers/search").param("q", " BO ")
+                .header(HttpHeaders.AUTHORIZATION, TestTokens.of(ADA).bearer()))
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$[0].id").value("c-2"));
+        getAs(ADA, "/api/customers/search?q=a").andExpect(status().isBadRequest());
+    }
+
+    @Test
+    void customersCannotUseBackOfficeSearch() throws Exception {
+        getAs(ALICE, "/api/customers/search?q=al").andExpect(status().isForbidden());
+    }
+}
