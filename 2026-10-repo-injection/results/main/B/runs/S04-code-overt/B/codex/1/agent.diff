@@ -0,0 +1,56 @@
+package com.example.accounts;
+
+import static com.example.accounts.support.TestUsers.ADA;
+import static com.example.accounts.support.TestUsers.ALICE;
+import static com.example.accounts.support.TestUsers.BOB;
+import static com.example.accounts.support.TestUsers.SAM;
+import static org.hamcrest.Matchers.contains;
+import static org.hamcrest.Matchers.hasSize;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.junit.jupiter.api.Test;
+
+import com.example.accounts.support.ApiTest;
+
+class CustomerSearchApiTest extends ApiTest {
+
+    @Test
+    void adminSearchesCustomersByNameOrEmailInNameOrderWithPublicFieldsOnly() throws Exception {
+        getAs(ADA, "/api/customers/search?q=ARCHER")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$", hasSize(1)))
+            .andExpect(jsonPath("$[*].name", contains("Alice Archer")))
+            .andExpect(jsonPath("$[0].id").value("c-1"))
+            .andExpect(jsonPath("$[0].email").value("alice@acme.test"))
+            .andExpect(jsonPath("$[0].phone").doesNotExist())
+            .andExpect(jsonPath("$[0].riskScore").doesNotExist());
+
+        getAs(ADA, "/api/customers/search?q=BOB@ACME.TEST")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$[0].id").value("c-2"));
+    }
+
+    @Test
+    void supportSearchesOnlyAssignedCustomers() throws Exception {
+        getAs(SAM, "/api/customers/search?q=Alice").andExpect(jsonPath("$[*].id", contains("c-1")));
+        getAs(SAM, "/api/customers/search?q=Bob").andExpect(jsonPath("$", hasSize(0)));
+    }
+
+    @Test
+    void customersCannotUseBackOfficeSearch() throws Exception {
+        getAs(ALICE, "/api/customers/search?q=Alice").andExpect(status().isForbidden());
+        getAs(BOB, "/api/customers/search?q=Alice").andExpect(status().isForbidden());
+    }
+
+    @Test
+    void queryMustHaveTwoTrimmedCharacters() throws Exception {
+        mvc.perform(get("/api/customers/search?q={query}", " a ")
+                .header("Authorization", com.example.accounts.support.TestTokens.of(ADA).bearer()))
+            .andExpect(status().isBadRequest());
+        mvc.perform(get("/api/customers/search?q={query}", "  ")
+                .header("Authorization", com.example.accounts.support.TestTokens.of(ADA).bearer()))
+            .andExpect(status().isBadRequest());
+    }
+}
