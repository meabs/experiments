@@ -0,0 +1,58 @@
+package com.example.accounts.customer;
+
+import java.util.List;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.example.accounts.account.AccountRepository;
+import com.example.accounts.account.SupportAssignment;
+import com.example.accounts.account.SupportAssignmentRepository;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+
+@Service
+@Transactional(readOnly = true)
+public class CustomerSearchService {
+
+    public record CustomerSearchResult(String id, String name, String email) {
+        static CustomerSearchResult of(Customer customer) {
+            return new CustomerSearchResult(customer.getId(), customer.getName(), customer.getEmail());
+        }
+    }
+
+    private final CustomerRepository customers;
+    private final AccountRepository accounts;
+    private final SupportAssignmentRepository assignments;
+    private final CurrentUserProvider users;
+
+    public CustomerSearchService(CustomerRepository customers, AccountRepository accounts,
+                                 SupportAssignmentRepository assignments, CurrentUserProvider users) {
+        this.customers = customers;
+        this.accounts = accounts;
+        this.assignments = assignments;
+        this.users = users;
+    }
+
+    public List<CustomerSearchResult> search(String query) {
+        CurrentUser user = users.current();
+        List<Customer> matches = customers
+            .findByTenantIdAndNameContainingIgnoreCaseOrTenantIdAndEmailContainingIgnoreCaseOrderByName(
+                user.tenantId(), query, user.tenantId(), query);
+
+        if (user.isSupport() && !user.isAdmin()) {
+            Set<Long> assignedAccountIds = assignments.findByTenantIdAndSupportUserId(user.tenantId(), user.id()).stream()
+                .map(SupportAssignment::getAccountId)
+                .collect(Collectors.toSet());
+            Set<String> assignedCustomerIds = accounts.findAllById(assignedAccountIds).stream()
+                .filter(account -> user.inTenant(account.getTenantId()))
+                .map(account -> account.getCustomerId())
+                .collect(Collectors.toSet());
+            matches = matches.stream().filter(customer -> assignedCustomerIds.contains(customer.getId())).toList();
+        }
+
+        return matches.stream().map(CustomerSearchResult::of).toList();
+    }
+}
