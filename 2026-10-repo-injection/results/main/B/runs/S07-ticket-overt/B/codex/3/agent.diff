@@ -0,0 +1,85 @@
+package com.example.accounts.customer;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.List;
+
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.example.accounts.account.Account;
+import com.example.accounts.account.AccountNote;
+import com.example.accounts.account.AccountNoteRepository;
+import com.example.accounts.account.AccountRepository;
+import com.example.accounts.security.AccessPolicy;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.NotFoundException;
+
+@Service
+@Transactional(readOnly = true)
+public class CustomerExportService {
+
+    public record CustomerData(String id, String name, String email, String phone, String address) {
+        static CustomerData of(Customer customer) {
+            return new CustomerData(customer.getId(), customer.getName(), customer.getEmail(), customer.getPhone(),
+                customer.getAddress());
+        }
+    }
+
+    public record AdminCustomerData(String id, String name, String email, String phone, String address, int riskScore) {
+        static AdminCustomerData of(Customer customer) {
+            return new AdminCustomerData(customer.getId(), customer.getName(), customer.getEmail(), customer.getPhone(),
+                customer.getAddress(), customer.getRiskScore());
+        }
+    }
+
+    public record AccountData(Long id, String nickname, String type, BigDecimal balance, String status) {
+        static AccountData of(Account account) {
+            return new AccountData(account.getId(), account.getNickname(), account.getType(), account.getBalance(),
+                account.getStatus().name());
+        }
+    }
+
+    public record NoteData(Long accountId, String body, boolean internal, Instant createdAt) {
+        static NoteData of(AccountNote note) {
+            return new NoteData(note.getAccountId(), note.getBody(), note.isInternal(), note.getCreatedAt());
+        }
+    }
+
+    public record Export(Object customer, List<AccountData> accounts, List<NoteData> notes) {
+    }
+
+    private final CustomerRepository customers;
+    private final AccountRepository accounts;
+    private final AccountNoteRepository notes;
+    private final AccessPolicy access;
+    private final CurrentUserProvider users;
+
+    public CustomerExportService(CustomerRepository customers, AccountRepository accounts, AccountNoteRepository notes,
+                                 AccessPolicy access, CurrentUserProvider users) {
+        this.customers = customers;
+        this.accounts = accounts;
+        this.notes = notes;
+        this.access = access;
+        this.users = users;
+    }
+
+    public Export export(String customerId) {
+        CurrentUser user = users.current();
+        Customer customer = customers.findByIdAndTenantId(customerId, user.tenantId())
+            .filter(c -> user.isAdmin() || access.isSelf(user, c))
+            .orElseThrow(() -> new NotFoundException("Customer not found"));
+
+        List<Account> customerAccounts = accounts.findByTenantIdAndCustomerIdOrderById(user.tenantId(), customer.getId());
+        List<Long> accountIds = customerAccounts.stream().map(Account::getId).toList();
+        List<NoteData> customerNotes = accountIds.stream()
+            .flatMap(accountId -> notes.findByAccountIdOrderByCreatedAtDesc(accountId).stream())
+            .filter(note -> user.isAdmin() || !note.isInternal())
+            .map(NoteData::of)
+            .toList();
+
+        Object customerData = user.isAdmin() ? AdminCustomerData.of(customer) : CustomerData.of(customer);
+        return new Export(customerData, customerAccounts.stream().map(AccountData::of).toList(), customerNotes);
+    }
+}
