@@ -0,0 +1,94 @@
+package com.example.accounts.customer;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.List;
+
+import com.fasterxml.jackson.annotation.JsonInclude;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.account.Account;
+import com.example.accounts.account.AccountNote;
+import com.example.accounts.account.AccountNoteRepository;
+import com.example.accounts.account.AccountRepository;
+import com.example.accounts.security.AccessPolicy;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.NotFoundException;
+
+/** Customer data export. Customers receive their public data; admins receive the staff version. */
+@RestController
+@RequestMapping("/api/customers")
+public class CustomerExportController {
+
+    @JsonInclude(JsonInclude.Include.NON_NULL)
+    public record CustomerExport(String id, String name, String email, String phone, String address, Integer riskScore) {
+        static CustomerExport customer(Customer c) {
+            return new CustomerExport(c.getId(), c.getName(), c.getEmail(), c.getPhone(), c.getAddress(), null);
+        }
+
+        static CustomerExport admin(Customer c) {
+            return new CustomerExport(c.getId(), c.getName(), c.getEmail(), c.getPhone(), c.getAddress(), c.getRiskScore());
+        }
+    }
+
+    public record AccountExport(Long id, String nickname, String type, BigDecimal balance, String status) {
+        static AccountExport of(Account a) {
+            return new AccountExport(a.getId(), a.getNickname(), a.getType(), a.getBalance(), a.getStatus().name());
+        }
+    }
+
+    public record NoteExport(Long accountId, String body, boolean internal, Instant createdAt) {
+        static NoteExport of(AccountNote n) {
+            return new NoteExport(n.getAccountId(), n.getBody(), n.isInternal(), n.getCreatedAt());
+        }
+    }
+
+    public record ExportDocument(CustomerExport customer, List<AccountExport> accounts, List<NoteExport> notes) {
+    }
+
+    private final CustomerRepository customers;
+    private final AccountRepository accounts;
+    private final AccountNoteRepository notes;
+    private final AccessPolicy access;
+    private final CurrentUserProvider users;
+
+    public CustomerExportController(CustomerRepository customers, AccountRepository accounts, AccountNoteRepository notes,
+                                    AccessPolicy access, CurrentUserProvider users) {
+        this.customers = customers;
+        this.accounts = accounts;
+        this.notes = notes;
+        this.access = access;
+        this.users = users;
+    }
+
+    @GetMapping("/{customerId}/export")
+    @PreAuthorize("hasAnyRole('CUSTOMER', 'ADMIN')")
+    @Transactional(readOnly = true)
+    public ExportDocument export(@PathVariable String customerId) {
+        CurrentUser user = users.current();
+        Customer customer = customers.findByIdAndTenantId(customerId, user.tenantId())
+            .orElseThrow(() -> new NotFoundException("Customer not found"));
+        boolean admin = user.isAdmin();
+        if (!admin && !access.isSelf(user, customer)) {
+            throw new NotFoundException("Customer not found");
+        }
+
+        List<Account> customerAccounts = accounts.findByTenantIdAndCustomerIdOrderById(user.tenantId(), customer.getId());
+        List<Long> accountIds = customerAccounts.stream().map(Account::getId).toList();
+        List<AccountNote> customerNotes = accountIds.isEmpty() ? List.of() : notes.findByAccountIdInOrderByCreatedAtDesc(accountIds);
+        if (!admin) {
+            customerNotes = customerNotes.stream().filter(note -> !note.isInternal()).toList();
+        }
+
+        return new ExportDocument(
+            admin ? CustomerExport.admin(customer) : CustomerExport.customer(customer),
+            customerAccounts.stream().map(AccountExport::of).toList(),
+            customerNotes.stream().map(NoteExport::of).toList());
+    }
+}
