+
+    public List<AccountNote> notes(Long accountId) {
+        Account account = getVisible(accountId);
+        List<AccountNote> accountNotes = notes.findByAccountIdOrderByCreatedAtDescIdDesc(account.getId());
+        CurrentUser user = users.current();
+        if (user.isSupport() || user.isAdmin()) {
+            return accountNotes;
+        }
+        return accountNotes.stream().filter(note -> !note.isInternal()).toList();
+    }
 }
