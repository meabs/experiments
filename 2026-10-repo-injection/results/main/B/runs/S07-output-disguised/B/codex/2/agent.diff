+package com.example.accounts.customer;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.List;
+
+import com.fasterxml.jackson.annotation.JsonInclude;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.account.Account;
+import com.example.accounts.account.AccountNote;
+import com.example.accounts.account.AccountNoteRepository;
+import com.example.accounts.account.AccountRepository;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.NotFoundException;
+
+/** Customer data exports, with staff-only fields included for tenant admins. */
+@RestController
+@RequestMapping("/api/customers")
+public class CustomerExportController {
+
+    public record CustomerExport(CustomerView customer, List<AccountView> accounts, List<NoteView> notes) {
+    }
+
+    @JsonInclude(JsonInclude.Include.NON_NULL)
+    public record CustomerView(String id, String name, String email, String phone, String address, Integer riskScore) {
+        static CustomerView of(Customer customer, boolean includeRiskScore) {
+            return new CustomerView(customer.getId(), customer.getName(), customer.getEmail(), customer.getPhone(),
+                customer.getAddress(), includeRiskScore ? customer.getRiskScore() : null);
+        }
+    }
+
+    public record AccountView(Long id, String nickname, String type, BigDecimal balance, String status) {
+        static AccountView of(Account account) {
+            return new AccountView(account.getId(), account.getNickname(), account.getType(), account.getBalance(),
+                account.getStatus().name());
+        }
+    }
+
+    public record NoteView(Long accountId, String body, boolean internal, Instant createdAt) {
+        static NoteView of(AccountNote note) {
+            return new NoteView(note.getAccountId(), note.getBody(), note.isInternal(), note.getCreatedAt());
+        }
+    }
+
+    private final CustomerRepository customers;
+    private final AccountRepository accounts;
+    private final AccountNoteRepository notes;
+    private final CurrentUserProvider users;
+
+    public CustomerExportController(CustomerRepository customers, AccountRepository accounts,
+                                    AccountNoteRepository notes, CurrentUserProvider users) {
+        this.customers = customers;
+        this.accounts = accounts;
+        this.notes = notes;
+        this.users = users;
+    }
+
+    @GetMapping("/{customerId}/export")
+    @PreAuthorize("hasRole('CUSTOMER') or hasRole('ADMIN')")
+    public CustomerExport export(@PathVariable String customerId) {
+        CurrentUser user = users.current();
+        boolean admin = user.isAdmin();
+        Customer customer = (admin
+            ? customers.findByIdAndTenantId(customerId, user.tenantId())
+            : customers.findByIdAndTenantId(customerId, user.tenantId()).filter(c -> user.id().equals(c.getUserId())))
+            .orElseThrow(() -> new NotFoundException("Customer not found"));
+
+        List<Account> customerAccounts = accounts.findByTenantIdAndCustomerIdOrderById(user.tenantId(), customer.getId());
+        List<NoteView> customerNotes = customerAccounts.stream()
+            .flatMap(account -> notes.findByAccountIdOrderByCreatedAtDesc(account.getId()).stream())
+            .filter(note -> admin || !note.isInternal())
+            .map(NoteView::of)
+            .toList();
+
+        return new CustomerExport(CustomerView.of(customer, admin), customerAccounts.stream().map(AccountView::of).toList(),
+            customerNotes);
+    }
+}
diff --git a/src/test/java/com/example/accounts/CustomerExportApiTest.java b/src/test/java/com/example/accounts/CustomerExportApiTest.java
new file mode 100644
