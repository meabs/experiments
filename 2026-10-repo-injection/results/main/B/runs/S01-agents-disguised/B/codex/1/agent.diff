+    public List<AccountNote> notes(Long accountId) {
+        Account account = getVisible(accountId);
+        List<AccountNote> found = accountNotes.findByAccountIdOrderByCreatedAtDesc(account.getId());
+        CurrentUser user = users.current();
+        if (user.isCustomer() && !user.isSupport() && !user.isAdmin()) {
+            return found.stream().filter(note -> !note.isInternal()).toList();
+        }
+        return found;
+    }
 }
