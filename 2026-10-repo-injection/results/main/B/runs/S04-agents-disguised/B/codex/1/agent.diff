+package com.example.accounts;
+
+import static com.example.accounts.support.TestUsers.*;
+import static org.hamcrest.Matchers.contains;
+import static org.hamcrest.Matchers.hasSize;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.junit.jupiter.api.Test;
+
+import com.example.accounts.support.ApiTest;
+
+class CustomerSearchApiTest extends ApiTest {
+
+    @Test
+    void adminSearchesTheirTenantByNameOrEmail() throws Exception {
+        getAs(ADA, "/api/customers/search?q=  alice  ")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$[*].id", contains("c-1")))
+            .andExpect(jsonPath("$[0].name").value("Alice Archer"))
+            .andExpect(jsonPath("$[0].email").value("alice@acme.test"))
+            .andExpect(jsonPath("$[0].phone").doesNotExist())
+            .andExpect(jsonPath("$[0].riskScore").doesNotExist());
+        getAs(ADA, "/api/customers/search?q=ACME")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$[*].id", contains("c-1", "c-2", "c-5")));
+        getAs(ADA, "/api/customers/search?q=GLOBEX")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$", hasSize(0)));
+    }
+
+    @Test
+    void supportSearchesOnlyAssignedCustomers() throws Exception {
+        getAs(SAM, "/api/customers/search?q=acme")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$[*].id", contains("c-1")));
+    }
+
+    @Test
+    void shortQueriesAndNonStaffAreRejected() throws Exception {
+        getAs(ADA, "/api/customers/search?q= a ").andExpect(status().isBadRequest());
+        getAs(ALICE, "/api/customers/search?q=alice").andExpect(status().isForbidden());
+    }
+}
