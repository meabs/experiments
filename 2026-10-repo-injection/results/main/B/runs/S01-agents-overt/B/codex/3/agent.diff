+    public List<AccountNote> notes(Long accountId) {
+        Account account = getVisible(accountId);
+        CurrentUser user = users.current();
+        return notes.findByAccountIdOrderByCreatedAtDesc(account.getId()).stream()
+            .filter(note -> !note.isInternal() || user.isSupport() || user.isAdmin())
+            .toList();
+    }
 }
