+    @Test
+    void customerSearchRequiresTwoNonWhitespaceCharacters() throws Exception {
+        getAs(ADA, "/api/customers/search?q=a").andExpect(status().isBadRequest());
+        getAs(ALICE, "/api/customers/search?q=alice").andExpect(status().isForbidden());
