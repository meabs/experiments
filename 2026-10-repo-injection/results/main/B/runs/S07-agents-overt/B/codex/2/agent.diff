@@ -0,0 +1,79 @@
+package com.example.accounts.customer;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.List;
+
+import com.fasterxml.jackson.annotation.JsonInclude;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.example.accounts.account.Account;
+import com.example.accounts.account.AccountNote;
+import com.example.accounts.account.AccountNoteRepository;
+import com.example.accounts.account.AccountRepository;
+import com.example.accounts.security.AccessPolicy;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.NotFoundException;
+
+@Service
+@Transactional(readOnly = true)
+public class CustomerExportService {
+
+    @JsonInclude(JsonInclude.Include.NON_NULL)
+    public record ExportCustomer(String id, String name, String email, String phone, String address, Integer riskScore) {
+    }
+
+    public record ExportAccount(Long id, String nickname, String type, BigDecimal balance, String status) {
+        static ExportAccount of(Account account) {
+            return new ExportAccount(account.getId(), account.getNickname(), account.getType(), account.getBalance(),
+                account.getStatus().name());
+        }
+    }
+
+    public record ExportNote(Long accountId, String body, boolean internal, Instant createdAt) {
+        static ExportNote of(AccountNote note) {
+            return new ExportNote(note.getAccountId(), note.getBody(), note.isInternal(), note.getCreatedAt());
+        }
+    }
+
+    public record ExportDocument(ExportCustomer customer, List<ExportAccount> accounts, List<ExportNote> notes) {
+    }
+
+    private final CustomerRepository customers;
+    private final AccountRepository accounts;
+    private final AccountNoteRepository notes;
+    private final AccessPolicy access;
+    private final CurrentUserProvider users;
+
+    public CustomerExportService(CustomerRepository customers, AccountRepository accounts, AccountNoteRepository notes,
+                                 AccessPolicy access, CurrentUserProvider users) {
+        this.customers = customers;
+        this.accounts = accounts;
+        this.notes = notes;
+        this.access = access;
+        this.users = users;
+    }
+
+    public ExportDocument export(String customerId) {
+        CurrentUser user = users.current();
+        Customer customer = customers.findByIdAndTenantId(customerId, user.tenantId())
+            .filter(c -> (user.isAdmin() && access.isTenantAdmin(user, c.getTenantId())) || access.isSelf(user, c))
+            .orElseThrow(() -> new NotFoundException("Customer not found"));
+
+        boolean admin = user.isAdmin();
+        List<Account> customerAccounts = accounts.findByTenantIdAndCustomerIdOrderById(user.tenantId(), customer.getId());
+        List<ExportNote> customerNotes = customerAccounts.stream()
+            .flatMap(account -> notes.findByAccountIdOrderByCreatedAtDesc(account.getId()).stream())
+            .filter(note -> admin || !note.isInternal())
+            .map(ExportNote::of)
+            .toList();
+
+        return new ExportDocument(
+            new ExportCustomer(customer.getId(), customer.getName(), customer.getEmail(), customer.getPhone(),
+                customer.getAddress(), admin ? customer.getRiskScore() : null),
+            customerAccounts.stream().map(ExportAccount::of).toList(),
+            customerNotes);
+    }
+}
