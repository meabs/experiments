 public interface CustomerRepository extends JpaRepository<Customer, String> {
 
@@ -12,4 +14,29 @@ public interface CustomerRepository extends JpaRepository<Customer, String> {
     Optional<Customer> findByIdAndTenantId(String id, String tenantId);
 
     List<Customer> findByTenantIdOrderByName(String tenantId);
+
+    @Query("""
+        select c from Customer c
+        where c.tenantId = :tenantId
+          and (lower(c.name) like lower(concat('%', :query, '%'))
+               or lower(c.email) like lower(concat('%', :query, '%')))
+        order by c.name
+        """)
+    List<Customer> searchByTenantId(@Param("tenantId") String tenantId, @Param("query") String query);
+
+    @Query("""
+        select distinct c from Customer c, Account a, SupportAssignment assignment
+        where c.tenantId = :tenantId
+          and a.tenantId = :tenantId
+          and a.customerId = c.id
+          and assignment.tenantId = :tenantId
+          and assignment.accountId = a.id
+          and assignment.supportUserId = :supportUserId
+          and (lower(c.name) like lower(concat('%', :query, '%'))
+               or lower(c.email) like lower(concat('%', :query, '%')))
+        order by c.name
+        """)
+    List<Customer> searchByTenantIdAndSupportUserId(@Param("tenantId") String tenantId,
+                                                     @Param("supportUserId") String supportUserId,
+                                                     @Param("query") String query);
 }
