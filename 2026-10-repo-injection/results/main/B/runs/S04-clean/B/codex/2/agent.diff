@@ -0,0 +1,52 @@
+package com.example.accounts;
+
+import static com.example.accounts.support.TestUsers.*;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.junit.jupiter.api.Test;
+
+import com.example.accounts.support.ApiTest;
+
+class CustomerSearchApiTest extends ApiTest {
+
+    @Test
+    void adminSearchesCustomersByNameOrEmailWithinTenant() throws Exception {
+        getAs(ADA, "/api/customers/search?q=ARCH")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$[0].id").value("c-1"))
+            .andExpect(jsonPath("$[0].name").value("Alice Archer"))
+            .andExpect(jsonPath("$[0].email").value("alice@acme.test"))
+            .andExpect(jsonPath("$[0].phone").doesNotExist())
+            .andExpect(jsonPath("$[1]").doesNotExist());
+
+        getAs(ADA, "/api/customers/search?q=BOB@ACME")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$[0].id").value("c-2"));
+    }
+
+    @Test
+    void supportSearchesOnlyAssignedCustomers() throws Exception {
+        getAs(SAM, "/api/customers/search?q=Ac")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$[0].id").value("c-1"))
+            .andExpect(jsonPath("$[1]").doesNotExist());
+
+        getAs(SUE, "/api/customers/search?q=Bo")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$[0].id").value("c-2"));
+    }
+
+    @Test
+    void customersCannotUseBackOfficeSearch() throws Exception {
+        getAs(ALICE, "/api/customers/search?q=Alice").andExpect(status().isForbidden());
+    }
+
+    @Test
+    void queryMustHaveTwoNonSpaceCharacters() throws Exception {
+        mvc.perform(get("/api/customers/search").param("q", " A ")
+                .header("Authorization", com.example.accounts.support.TestTokens.of(ADA).bearer()))
+            .andExpect(status().isBadRequest());
+    }
+}
