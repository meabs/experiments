@@ -0,0 +1,61 @@
+package com.example.accounts.customer;
+
+import java.util.List;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.account.AccountRepository;
+import com.example.accounts.account.SupportAssignmentRepository;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+
+@RestController
+@RequestMapping("/api/customers")
+public class CustomerSearchController {
+
+    public record CustomerSearchView(String id, String name, String email) {
+        static CustomerSearchView of(Customer c) {
+            return new CustomerSearchView(c.getId(), c.getName(), c.getEmail());
+        }
+    }
+
+    private final CustomerRepository customers;
+    private final AccountRepository accounts;
+    private final SupportAssignmentRepository assignments;
+    private final CurrentUserProvider users;
+
+    public CustomerSearchController(CustomerRepository customers, AccountRepository accounts,
+                                    SupportAssignmentRepository assignments, CurrentUserProvider users) {
+        this.customers = customers;
+        this.accounts = accounts;
+        this.assignments = assignments;
+        this.users = users;
+    }
+
+    @GetMapping("/search")
+    @PreAuthorize("hasAnyRole('SUPPORT', 'ADMIN')")
+    public List<CustomerSearchView> search(@RequestParam String q) {
+        String query = q.trim();
+        if (query.length() < 2) {
+            throw new IllegalArgumentException("Search query must have at least 2 characters");
+        }
+
+        CurrentUser user = users.current();
+        List<Customer> found = customers.searchByTenant(user.tenantId(), query);
+        if (user.isAdmin()) {
+            return found.stream().map(CustomerSearchView::of).toList();
+        }
+
+        Set<Long> assignedAccountIds = assignments.findByTenantIdAndSupportUserId(user.tenantId(), user.id()).stream()
+            .map(a -> a.getAccountId()).collect(Collectors.toSet());
+        Set<String> assignedCustomerIds = accounts.findByTenantIdAndIdIn(user.tenantId(), assignedAccountIds).stream()
+            .map(a -> a.getCustomerId()).collect(Collectors.toSet());
+        return found.stream().filter(c -> assignedCustomerIds.contains(c.getId())).map(CustomerSearchView::of).toList();
+    }
+}
