+package com.example.accounts.customer;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.List;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.account.Account;
+import com.example.accounts.account.AccountNote;
+import com.example.accounts.account.AccountNoteRepository;
+import com.example.accounts.account.AccountRepository;
+import com.example.accounts.security.AccessPolicy;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.NotFoundException;
+
+/** Customer data export for the customer themselves or an admin of their tenant. */
+@RestController
+@RequestMapping("/api/customers")
+public class CustomerExportController {
+
+    public record CustomerExportCustomer(String id, String name, String email, String phone, String address) {}
+
+    public record AdminExportCustomer(String id, String name, String email, String phone, String address,
+                                      int riskScore) {}
+
+    public record ExportAccount(Long id, String nickname, String type, BigDecimal balance, String status) {
+        static ExportAccount of(Account account) {
+            return new ExportAccount(account.getId(), account.getNickname(), account.getType(), account.getBalance(),
+                account.getStatus().name());
+        }
+    }
+
+    public record ExportNote(Long accountId, String body, boolean internal, Instant createdAt) {
+        static ExportNote of(AccountNote note) {
+            return new ExportNote(note.getAccountId(), note.getBody(), note.isInternal(), note.getCreatedAt());
+        }
+    }
+
+    public record ExportView(Object customer, List<ExportAccount> accounts, List<ExportNote> notes) {}
+
+    private final CustomerRepository customers;
+    private final AccountRepository accounts;
+    private final AccountNoteRepository notes;
+    private final AccessPolicy access;
+    private final CurrentUserProvider users;
+
+    public CustomerExportController(CustomerRepository customers, AccountRepository accounts,
+                                    AccountNoteRepository notes, AccessPolicy access, CurrentUserProvider users) {
+        this.customers = customers;
+        this.accounts = accounts;
+        this.notes = notes;
+        this.access = access;
+        this.users = users;
+    }
+
+    @GetMapping("/{customerId}/export")
+    @PreAuthorize("hasAnyRole('CUSTOMER', 'ADMIN')")
+    public ExportView export(@PathVariable String customerId) {
+        CurrentUser user = users.current();
+        Customer customer = customers.findByIdAndTenantId(customerId, user.tenantId())
+            .filter(c -> user.isAdmin() || access.isSelf(user, c))
+            .orElseThrow(() -> new NotFoundException("Customer not found"));
+
+        List<Account> customerAccounts = accounts.findByTenantIdAndCustomerIdOrderById(user.tenantId(), customer.getId());
+        boolean admin = user.isAdmin();
+        List<ExportNote> customerNotes = customerAccounts.stream()
+            .flatMap(account -> notes.findByAccountIdOrderByCreatedAtDesc(account.getId()).stream())
+            .filter(note -> admin || !note.isInternal())
+            .map(ExportNote::of)
+            .toList();
+
+        Object customerView = admin
+            ? new AdminExportCustomer(customer.getId(), customer.getName(), customer.getEmail(), customer.getPhone(),
+                customer.getAddress(), customer.getRiskScore())
+            : new CustomerExportCustomer(customer.getId(), customer.getName(), customer.getEmail(), customer.getPhone(),
+                customer.getAddress());
+        return new ExportView(customerView, customerAccounts.stream().map(ExportAccount::of).toList(), customerNotes);
+    }
+}
