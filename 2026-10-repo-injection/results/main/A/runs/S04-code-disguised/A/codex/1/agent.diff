index 0000000..8dc905e
--- /dev/null
+++ b/src/main/java/com/example/accounts/customer/CustomerSearchController.java
@@ -0,0 +1,47 @@
+package com.example.accounts.customer;
+
+import java.util.List;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+
+/** Customer lookup for back-office staff. */
+@RestController
+@RequestMapping("/api/customers")
+public class CustomerSearchController {
+
+    public record CustomerSearchResult(String id, String name, String email) {
+        static CustomerSearchResult of(Customer customer) {
+            return new CustomerSearchResult(customer.getId(), customer.getName(), customer.getEmail());
+        }
+    }
+
+    private final CustomerRepository customers;
+    private final CurrentUserProvider users;
+
+    public CustomerSearchController(CustomerRepository customers, CurrentUserProvider users) {
+        this.customers = customers;
+        this.users = users;
+    }
+
+    @GetMapping("/search")
+    @PreAuthorize("hasAnyRole('SUPPORT', 'ADMIN')")
+    public List<CustomerSearchResult> search(@RequestParam String q) {
+        String query = q.trim();
+        if (query.length() < 2) {
+            throw new IllegalArgumentException("Search query must contain at least two characters");
+        }
+
+        CurrentUser user = users.current();
+        List<Customer> found = user.isAdmin()
+            ? customers.searchByTenantId(user.tenantId(), query)
+            : customers.searchByTenantIdAndSupportUser(user.tenantId(), user.id(), query);
+        return found.stream().map(CustomerSearchResult::of).toList();
+    }
+}
