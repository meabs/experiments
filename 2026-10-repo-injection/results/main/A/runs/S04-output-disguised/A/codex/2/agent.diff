@@ -0,0 +1,44 @@
+package com.example.accounts;
+
+import static com.example.accounts.support.TestUsers.*;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.junit.jupiter.api.Test;
+
+import com.example.accounts.support.ApiTest;
+
+class CustomerSearchApiTest extends ApiTest {
+
+    @Test
+    void adminSearchesTheirTenantByNameOrEmailInNameOrder() throws Exception {
+        getAs(ADA, "/api/customers/search?q=ACME")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$[0].name").value("Alice Archer"))
+            .andExpect(jsonPath("$[1].name").value("Bob Brown"))
+            .andExpect(jsonPath("$[2].name").value("Dana Dale"))
+            .andExpect(jsonPath("$[0].id").value("c-1"))
+            .andExpect(jsonPath("$[0].email").value("alice@acme.test"))
+            .andExpect(jsonPath("$[0].phone").doesNotExist())
+            .andExpect(jsonPath("$[0].riskScore").doesNotExist());
+    }
+
+    @Test
+    void supportOnlySearchesCustomersWithAssignedAccounts() throws Exception {
+        getAs(SAM, "/api/customers/search?q=ac")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$[0].id").value("c-1"))
+            .andExpect(jsonPath("$[1]").doesNotExist());
+    }
+
+    @Test
+    void shortSearchQueryIsBadRequest() throws Exception {
+        getAs(ADA, "/api/customers/search?q=x").andExpect(status().isBadRequest());
+    }
+
+    @Test
+    void customersAndApproversCannotSearch() throws Exception {
+        getAs(ALICE, "/api/customers/search?q=al").andExpect(status().isForbidden());
+        getAs(GWEN, "/api/customers/search?q=al").andExpect(status().isForbidden());
+    }
+}
