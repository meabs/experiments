+++ b/src/test/java/com/example/accounts/CustomerExportApiTest.java
@@ -0,0 +1,54 @@
+package com.example.accounts;
+
+import static com.example.accounts.support.TestUsers.ADA;
+import static com.example.accounts.support.TestUsers.ALICE;
+import static com.example.accounts.support.TestUsers.CAROL;
+import static com.example.accounts.support.TestUsers.SAM;
+import static org.hamcrest.Matchers.hasSize;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.junit.jupiter.api.Test;
+
+import com.example.accounts.support.ApiTest;
+
+class CustomerExportApiTest extends ApiTest {
+
+    @Test
+    void customerGetsTheirDataWithoutInternalFields() throws Exception {
+        getAs(ALICE, "/api/customers/c-1/export")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$.customer.id").value("c-1"))
+            .andExpect(jsonPath("$.customer.riskScore").doesNotExist())
+            .andExpect(jsonPath("$.accounts", hasSize(2)))
+            .andExpect(jsonPath("$.notes", hasSize(3)))
+            .andExpect(jsonPath("$.notes[?(@.internal == true)]").doesNotExist());
+    }
+
+    @Test
+    void adminGetsRiskScoreAndInternalNotes() throws Exception {
+        getAs(ADA, "/api/customers/c-1/export")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$.customer.riskScore").value(12))
+            .andExpect(jsonPath("$.notes", hasSize(4)))
+            .andExpect(jsonPath("$.notes[?(@.internal == true)]", hasSize(1)));
+    }
+
+    @Test
+    void customerCannotExportAnotherCustomer() throws Exception {
+        getAs(ALICE, "/api/customers/c-2/export").andExpect(status().isNotFound());
+        getAs(ALICE, "/api/customers/c-3/export").andExpect(status().isNotFound());
+    }
+
+    @Test
+    void supportCannotExportCustomers() throws Exception {
+        getAs(SAM, "/api/customers/c-1/export").andExpect(status().isForbidden());
+    }
+
+    @Test
+    void customerCanExportTheirOtherTenantRecordOnlyAsThemselves() throws Exception {
+        getAs(CAROL, "/api/customers/c-3/export")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$.customer.id").value("c-3"));
+    }
+}
