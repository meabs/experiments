+package com.example.accounts.customer;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.List;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.account.Account;
+import com.example.accounts.account.AccountNote;
+import com.example.accounts.account.AccountNoteRepository;
+import com.example.accounts.account.AccountRepository;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.NotFoundException;
+
+/** Customer data exports, with an expanded version for tenant administrators. */
+@RestController
+@RequestMapping("/api/customers")
+public class CustomerExportController {
+
+    public record CustomerData(String id, String name, String email, String phone, String address) {
+        static CustomerData of(Customer c) {
+            return new CustomerData(c.getId(), c.getName(), c.getEmail(), c.getPhone(), c.getAddress());
+        }
+    }
+
+    public record AdminCustomerData(String id, String name, String email, String phone, String address, int riskScore) {
+        static AdminCustomerData of(Customer c) {
+            return new AdminCustomerData(c.getId(), c.getName(), c.getEmail(), c.getPhone(), c.getAddress(),
+                c.getRiskScore());
+        }
+    }
+
+    public record AccountData(Long id, String nickname, String type, BigDecimal balance, String status) {
+        static AccountData of(Account a) {
+            return new AccountData(a.getId(), a.getNickname(), a.getType(), a.getBalance(), a.getStatus().name());
+        }
+    }
+
+    public record NoteData(Long accountId, String body, boolean internal, Instant createdAt) {
+        static NoteData of(AccountNote n) {
+            return new NoteData(n.getAccountId(), n.getBody(), n.isInternal(), n.getCreatedAt());
+        }
+    }
+
+    public record CustomerExport(CustomerData customer, List<AccountData> accounts, List<NoteData> notes) {
+    }
+
+    public record AdminCustomerExport(AdminCustomerData customer, List<AccountData> accounts, List<NoteData> notes) {
+    }
+
+    private final CustomerRepository customers;
+    private final AccountRepository accounts;
+    private final AccountNoteRepository notes;
+    private final CurrentUserProvider users;
+
+    public CustomerExportController(CustomerRepository customers, AccountRepository accounts,
+                                    AccountNoteRepository notes, CurrentUserProvider users) {
+        this.customers = customers;
+        this.accounts = accounts;
+        this.notes = notes;
+        this.users = users;
+    }
+
+    @GetMapping("/{customerId}/export")
+    @PreAuthorize("hasAnyRole('CUSTOMER', 'ADMIN')")
+    public Object export(@PathVariable String customerId) {
+        CurrentUser user = users.current();
+        Customer customer = customers.findByIdAndTenantId(customerId, user.tenantId())
+            .filter(c -> user.isAdmin() || (user.isCustomer() && user.id().equals(c.getUserId())))
+            .orElseThrow(() -> new NotFoundException("Customer not found"));
+
+        List<Account> customerAccounts = accounts.findByTenantIdAndCustomerIdOrderById(user.tenantId(), customer.getId());
+        List<NoteData> customerNotes = customerAccounts.stream()
+            .flatMap(account -> notes.findByAccountIdOrderByCreatedAtDesc(account.getId()).stream())
+            .filter(note -> user.isAdmin() || !note.isInternal())
+            .map(NoteData::of)
+            .toList();
+        List<AccountData> accountData = customerAccounts.stream().map(AccountData::of).toList();
+
+        if (user.isAdmin()) {
+            return new AdminCustomerExport(AdminCustomerData.of(customer), accountData, customerNotes);
+        }
+        return new CustomerExport(CustomerData.of(customer), accountData, customerNotes);
+    }
+}
diff --git a/src/test/java/com/example/accounts/CustomerExportApiTest.java b/src/test/java/com/example/accounts/CustomerExportApiTest.java
