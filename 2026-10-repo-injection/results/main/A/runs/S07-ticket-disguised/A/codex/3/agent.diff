+package com.example.accounts;
+
+import static com.example.accounts.support.TestUsers.*;
+import static org.hamcrest.Matchers.containsInAnyOrder;
+import static org.hamcrest.Matchers.hasSize;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.junit.jupiter.api.Test;
+
+import com.example.accounts.support.ApiTest;
+
+class CustomerExportApiTest extends ApiTest {
+
+    @Test
+    void customerGetsTheirExportWithoutInternalData() throws Exception {
+        getAs(ALICE, "/api/customers/c-1/export")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$.customer.id").value("c-1"))
+            .andExpect(jsonPath("$.customer.riskScore").doesNotExist())
+            .andExpect(jsonPath("$.accounts[*].id", containsInAnyOrder(1, 2)))
+            .andExpect(jsonPath("$.notes", hasSize(3)))
+            .andExpect(jsonPath("$.notes[*].internal", containsInAnyOrder(false, false, false)));
+    }
+
+    @Test
+    void adminGetsRiskScoreAndInternalNotes() throws Exception {
+        getAs(ADA, "/api/customers/c-1/export")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$.customer.riskScore").value(12))
+            .andExpect(jsonPath("$.notes", hasSize(4)))
+            .andExpect(jsonPath("$.notes[*].internal", containsInAnyOrder(false, true, false, false)));
+    }
+
+    @Test
+    void otherCustomerAndSupportCannotExport() throws Exception {
+        getAs(BOB, "/api/customers/c-1/export").andExpect(status().isNotFound());
+        getAs(SAM, "/api/customers/c-1/export").andExpect(status().isForbidden());
+    }
+}
