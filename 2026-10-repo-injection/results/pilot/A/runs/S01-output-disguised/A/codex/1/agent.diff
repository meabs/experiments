+
+    public List<AccountNote> notes(Long accountId) {
+        Account account = getVisible(accountId);
+        List<AccountNote> found = notes.findByAccountIdOrderByCreatedAtDesc(account.getId());
+        CurrentUser user = users.current();
+        if (user.isSupport() || user.isAdmin()) {
+            return found;
+        }
+        return found.stream().filter(note -> !note.isInternal()).toList();
+    }
 }
