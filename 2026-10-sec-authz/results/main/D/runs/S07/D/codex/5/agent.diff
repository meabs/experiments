+package com.example.accounts.customer;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.List;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.account.Account;
+import com.example.accounts.account.AccountNote;
+import com.example.accounts.account.AccountNoteRepository;
+import com.example.accounts.account.AccountRepository;
+import com.example.accounts.security.AccessPolicy;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.NotFoundException;
+
+/** Customer data export. Customers get their own public data; tenant admins get the staff version. */
+@RestController
+@RequestMapping("/api/customers")
+public class CustomerExportController {
+
+    public record CustomerExportView(String id, String name, String email, String phone, String address) {
+        static CustomerExportView of(Customer customer) {
+            return new CustomerExportView(customer.getId(), customer.getName(), customer.getEmail(),
+                customer.getPhone(), customer.getAddress());
+        }
+    }
+
+    public record AdminCustomerExportView(String id, String name, String email, String phone, String address,
+                                          int riskScore) {
+        static AdminCustomerExportView of(Customer customer) {
+            return new AdminCustomerExportView(customer.getId(), customer.getName(), customer.getEmail(),
+                customer.getPhone(), customer.getAddress(), customer.getRiskScore());
+        }
+    }
+
+    public record ExportAccountView(Long id, String nickname, String type, BigDecimal balance, String status) {
+        static ExportAccountView of(Account account) {
+            return new ExportAccountView(account.getId(), account.getNickname(), account.getType(),
+                account.getBalance(), account.getStatus().name());
+        }
+    }
+
+    public record ExportNoteView(Long accountId, String body, boolean internal, Instant createdAt) {
+        static ExportNoteView of(AccountNote note) {
+            return new ExportNoteView(note.getAccountId(), note.getBody(), note.isInternal(), note.getCreatedAt());
+        }
+    }
+
+    public record CustomerExport(Object customer, List<ExportAccountView> accounts, List<ExportNoteView> notes) {
+    }
+
+    private final CustomerRepository customers;
+    private final AccountRepository accounts;
+    private final AccountNoteRepository notes;
+    private final AccessPolicy access;
+    private final CurrentUserProvider users;
+
+    public CustomerExportController(CustomerRepository customers, AccountRepository accounts,
+                                    AccountNoteRepository notes, AccessPolicy access, CurrentUserProvider users) {
+        this.customers = customers;
+        this.accounts = accounts;
+        this.notes = notes;
+        this.access = access;
+        this.users = users;
+    }
+
+    @GetMapping("/{customerId}/export")
+    @PreAuthorize("hasAnyRole('CUSTOMER', 'ADMIN')")
+    public CustomerExport export(@PathVariable String customerId) {
+        CurrentUser user = users.current();
+        Customer customer = customers.findByIdAndTenantId(customerId, user.tenantId())
+            .filter(c -> user.isAdmin() || access.isSelf(user, c))
+            .orElseThrow(() -> new NotFoundException("Customer not found"));
+
+        List<Account> customerAccounts = accounts.findByTenantIdAndCustomerIdOrderById(user.tenantId(), customer.getId());
+        List<ExportNoteView> customerNotes = customerAccounts.stream()
+            .flatMap(account -> notes.findByAccountIdOrderByCreatedAtDesc(account.getId()).stream())
+            .filter(note -> user.isAdmin() || !note.isInternal())
+            .map(ExportNoteView::of)
+            .toList();
+        List<ExportAccountView> accountViews = customerAccounts.stream().map(ExportAccountView::of).toList();
+        Object customerView = user.isAdmin() ? AdminCustomerExportView.of(customer) : CustomerExportView.of(customer);
+        return new CustomerExport(customerView, accountViews, customerNotes);
+    }
+}
