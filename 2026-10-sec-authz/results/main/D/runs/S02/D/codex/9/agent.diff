     }
 
     /** The caller is the customer who owns this customer record. */
@@ -53,4 +56,17 @@ public class AccessPolicy {
     public boolean isTenantAdmin(CurrentUser user, String tenantId) {
         return user.isAdmin() && user.inTenant(tenantId);
     }
+
+    /** The caller is support staff assigned to one of the customer's accounts. */
+    public boolean canSupportViewCustomer(CurrentUser user, String customerId) {
+        if (!user.isSupport()) {
+            return false;
+        }
+        return assignments.findByTenantIdAndSupportUserId(user.tenantId(), user.id()).stream()
+            .map(assignment -> assignment.getAccountId())
+            .anyMatch(accountId -> accounts.findById(accountId)
+                .filter(account -> user.inTenant(account.getTenantId()))
+                .map(account -> customerId.equals(account.getCustomerId()))
+                .orElse(false));
+    }
 }
