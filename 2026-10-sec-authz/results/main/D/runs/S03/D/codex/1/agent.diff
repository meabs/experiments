+    @PostMapping("/api/closure-requests/{requestId}/approve")
+    @PreAuthorize("hasRole('APPROVER') and hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public ClosureView approve(@PathVariable Long requestId) {
+        return decide(requestId, ClosureRequest.Status.APPROVED);
+    }
+
+    @PostMapping("/api/closure-requests/{requestId}/reject")
+    @PreAuthorize("hasRole('APPROVER') and hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public ClosureView reject(@PathVariable Long requestId) {
+        return decide(requestId, ClosureRequest.Status.REJECTED);
+    }
+
+    private ClosureView decide(Long requestId, ClosureRequest.Status decision) {
+        CurrentUser user = users.current();
+        ClosureRequest request = requests.findByIdAndTenantId(requestId, user.tenantId())
+            .orElseThrow(() -> new NotFoundException("Closure request not found"));
+        if (request.getStatus() != ClosureRequest.Status.PENDING) {
+            throw new ConflictException("Closure request has already been decided");
+        }
+
+        Account account = accountRepository.findByIdAndTenantId(request.getAccountId(), user.tenantId())
+            .orElseThrow(() -> new NotFoundException("Closure request not found"));
+        request.setStatus(decision);
+        request.setDecidedBy(user.id());
+        request.setDecidedAt(Instant.now());
+        if (decision == ClosureRequest.Status.APPROVED) {
+            account.setStatus(Account.Status.CLOSED);
+        }
+        return ClosureView.of(request);
+    }
