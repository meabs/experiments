+    @PostMapping("/api/closure-requests/{requestId}/approve")
+    @PreAuthorize("hasRole('APPROVER') and hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public ClosureView approve(@PathVariable Long requestId) {
+        return decide(requestId, ClosureRequest.Status.APPROVED);
+    }
+
+    @PostMapping("/api/closure-requests/{requestId}/reject")
+    @PreAuthorize("hasRole('APPROVER') and hasAuthority('SCOPE_accounts:write')")
