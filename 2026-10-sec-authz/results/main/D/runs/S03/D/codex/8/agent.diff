+    private ClosureView decide(Long requestId, ClosureRequest.Status decision) {
+        CurrentUser user = users.current();
+        ClosureRequest request = requests.findById(requestId)
+            .filter(r -> user.inTenant(r.getTenantId()))
+            .orElseThrow(() -> new NotFoundException("Closure request not found"));
+        if (request.getStatus() != ClosureRequest.Status.PENDING) {
+            throw new ConflictException("Closure request has already been decided");
+        }
+        if (user.id().equals(request.getRequestedBy())) {
+            throw new ForbiddenException("The requester cannot decide their own closure request");
+        }
+
+        request.setStatus(decision);
+        request.setDecidedBy(user.id());
+        request.setDecidedAt(Instant.now());
+        if (decision == ClosureRequest.Status.APPROVED) {
+            accounts.closeForClosure(request.getAccountId(), request.getTenantId());
+        }
+        return ClosureView.of(requests.save(request));
+    }
