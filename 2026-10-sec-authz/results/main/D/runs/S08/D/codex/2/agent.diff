+
+    @Transactional
+    public Account update(Long accountId, AccountController.AccountPatch patch) {
+        if (patch == null || (!patch.hasNickname() && !patch.hasDailyLimit())) {
+            throw new IllegalArgumentException("At least one account setting is required");
+        }
+        String nickname = patch.getNickname();
+        if (patch.hasNickname()) {
+            if (nickname == null) {
+                throw new IllegalArgumentException("Invalid nickname");
+            }
+            nickname = nickname.trim();
+            if (nickname.isEmpty() || nickname.length() > 40) {
+                throw new IllegalArgumentException("Invalid nickname");
+            }
+        }
+        if (patch.hasDailyLimit() && (patch.getDailyLimit() == null || patch.getDailyLimit() < 0
+            || patch.getDailyLimit() > 5000)) {
+            throw new IllegalArgumentException("Invalid daily limit");
+        }
+
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        boolean mayRename = patch.hasNickname() && access.ownsAccount(user, account);
+        boolean mayChangeLimit = patch.hasDailyLimit() && access.isTenantAdmin(user, account.getTenantId());
+        if ((patch.hasNickname() && !mayRename) || (patch.hasDailyLimit() && !mayChangeLimit)) {
+            throw new ForbiddenException("You may not change these account settings");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Closed accounts cannot be changed");
+        }
+        if (patch.hasNickname()) {
+            account.setNickname(nickname);
+        }
+        if (patch.hasDailyLimit()) {
+            account.setDailyLimit(patch.getDailyLimit());
+        }
+        return account;
+    }
 }
