+    public record AccountPatch(String nickname, Integer dailyLimit, boolean nicknamePresent, boolean dailyLimitPresent) {
+        static AccountPatch from(JsonNode body) {
+            if (body == null || !body.isObject() || body.size() == 0) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+            var fields = body.fieldNames();
+            while (fields.hasNext()) {
+                String field = fields.next();
+                if (!field.equals("nickname") && !field.equals("dailyLimit")) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+            }
+
+            boolean nicknamePresent = body.has("nickname");
+            String nickname = null;
+            if (nicknamePresent) {
+                JsonNode value = body.get("nickname");
+                if (!value.isTextual()) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+                nickname = value.textValue().trim();
+                if (nickname.length() < 1 || nickname.length() > 40) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+            }
+
+            boolean dailyLimitPresent = body.has("dailyLimit");
+            Integer dailyLimit = null;
+            if (dailyLimitPresent) {
+                JsonNode value = body.get("dailyLimit");
+                if (!value.isIntegralNumber() || !value.canConvertToInt()) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+                dailyLimit = value.intValue();
+                if (dailyLimit < 0 || dailyLimit > 5000) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+            }
+            return new AccountPatch(nickname, dailyLimit, nicknamePresent, dailyLimitPresent);
+        }
+    }
