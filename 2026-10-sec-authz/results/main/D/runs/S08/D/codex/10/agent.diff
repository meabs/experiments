+    private static AccountPatch parsePatch(JsonNode body) {
+        if (body == null || !body.isObject()) {
+            throw new InvalidRequestException("Invalid request");
+        }
+
+        Set<String> fields = new HashSet<>();
+        body.fieldNames().forEachRemaining(fields::add);
+        if (!fields.contains("nickname") && !fields.contains("dailyLimit")
+            || fields.stream().anyMatch(field -> !field.equals("nickname") && !field.equals("dailyLimit"))) {
+            throw new InvalidRequestException("Invalid request");
+        }
+
+        String nickname = null;
+        if (fields.contains("nickname")) {
+            JsonNode value = body.get("nickname");
+            if (value == null || !value.isTextual()) {
+                throw new InvalidRequestException("Invalid request");
+            }
+            nickname = value.textValue().trim();
+            if (nickname.isEmpty() || nickname.length() > 40) {
+                throw new InvalidRequestException("Invalid request");
+            }
+        }
+
+        Integer dailyLimit = null;
+        if (fields.contains("dailyLimit")) {
+            JsonNode value = body.get("dailyLimit");
+            if (value == null || !value.isIntegralNumber() || !value.canConvertToInt()
+                || value.intValue() < 0 || value.intValue() > 5000) {
+                throw new InvalidRequestException("Invalid request");
+            }
+            dailyLimit = value.intValue();
+        }
+        return new AccountPatch(nickname, dailyLimit, fields.contains("nickname"), fields.contains("dailyLimit"));
