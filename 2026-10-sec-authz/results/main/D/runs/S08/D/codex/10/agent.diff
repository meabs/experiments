+    @Transactional
+    public Account update(Long accountId, AccountController.AccountPatch patch) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        boolean canRename = access.ownsAccount(user, account);
+        boolean canChangeLimit = access.isTenantAdmin(user, account.getTenantId());
+        if ((patch.hasNickname() && !canRename) || (patch.hasDailyLimit() && !canChangeLimit)) {
+            throw new ForbiddenException("You may not change this account");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Closed accounts cannot be changed");
+        }
+        if (patch.hasNickname()) {
+            account.setNickname(patch.nickname());
+        }
+        if (patch.hasDailyLimit()) {
+            account.setDailyLimit(patch.dailyLimit());
+        }
+        return account;
+    }
 }
