diff --git a/src/main/java/com/example/accounts/account/AccountPatchRequest.java b/src/main/java/com/example/accounts/account/AccountPatchRequest.java
new file mode 100644
index 0000000..0fe31ed
--- /dev/null
+++ b/src/main/java/com/example/accounts/account/AccountPatchRequest.java
@@ -0,0 +1,39 @@
+package com.example.accounts.account;
+
+import com.fasterxml.jackson.databind.JsonNode;
+
+/** The optional settings that may be changed on an account. */
+public class AccountPatchRequest {
+
+    private String nickname;
+    private JsonNode dailyLimit;
+    private boolean nicknamePresent;
+    private boolean dailyLimitPresent;
+
+    public void setNickname(String nickname) {
+        this.nicknamePresent = true;
+        this.nickname = nickname;
+    }
+
+    public void setDailyLimit(JsonNode dailyLimit) {
+        this.dailyLimitPresent = true;
+        this.dailyLimit = dailyLimit;
+    }
+
+    public boolean hasNickname() {
+        return nicknamePresent;
+    }
+
+    public String getNickname() {
+        return nickname;
+    }
+
+    public boolean hasDailyLimit() {
+        return dailyLimitPresent;
+    }
+
+    public Integer getDailyLimit() {
+        return dailyLimit != null && dailyLimit.isIntegralNumber() && dailyLimit.canConvertToInt()
+            ? dailyLimit.intValue() : null;
+    }
+}
