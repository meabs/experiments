+    @Transactional
+    public Account update(Long accountId, boolean hasNickname, String nickname, boolean hasDailyLimit,
+                          Integer dailyLimit) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+        if ((hasNickname && !access.ownsAccount(user, account))
+            || (hasDailyLimit && !access.isTenantAdmin(user, account.getTenantId()))) {
+            throw new ForbiddenException("You may not change these account settings");
+        }
+        if (hasNickname) {
+            account.setNickname(nickname);
+        }
+        if (hasDailyLimit) {
+            account.setDailyLimit(dailyLimit);
+        }
+        return account;
+    }
