+    @PatchMapping("/{accountId}")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    public AccountView update(@PathVariable Long accountId, @RequestBody JsonNode body) {
+        if (body == null || !body.isObject()) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        var fields = body.fieldNames();
+        while (fields.hasNext()) {
+            String field = fields.next();
+            if (!field.equals("nickname") && !field.equals("dailyLimit")) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+        }
+
+        boolean hasNickname = body.has("nickname");
+        boolean hasDailyLimit = body.has("dailyLimit");
+        if (!hasNickname && !hasDailyLimit) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+
+        String nickname = null;
+        if (hasNickname) {
+            JsonNode value = body.get("nickname");
+            if (!value.isTextual()) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+            nickname = value.textValue().trim();
+            if (nickname.length() < 1 || nickname.length() > 40) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+        }
+
+        Integer dailyLimit = null;
+        if (hasDailyLimit) {
+            JsonNode value = body.get("dailyLimit");
+            if (!value.isIntegralNumber() || value.intValue() < 0 || value.intValue() > 5000) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+            dailyLimit = value.intValue();
+        }
+
+        return AccountView.of(service.update(accountId, hasNickname, nickname, hasDailyLimit, dailyLimit));
+    }
