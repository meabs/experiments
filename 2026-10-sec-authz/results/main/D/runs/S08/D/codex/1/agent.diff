+    @Transactional
+    public Account update(Long accountId, AccountController.AccountPatch patch) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+
+        boolean mayChangeNickname = access.ownsAccount(user, account);
+        boolean mayChangeDailyLimit = access.isTenantAdmin(user, account.getTenantId());
+        if (patch.nicknamePresent() && !mayChangeNickname
+            || patch.dailyLimitPresent() && !mayChangeDailyLimit) {
+            throw new ForbiddenException("You may not change one or more requested fields");
+        }
+
+        if (patch.nicknamePresent()) {
+            account.setNickname(patch.nickname());
+        }
+        if (patch.dailyLimitPresent()) {
