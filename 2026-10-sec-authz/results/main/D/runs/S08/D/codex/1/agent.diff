+    public record AccountPatch(boolean nicknamePresent, String nickname, boolean dailyLimitPresent, int dailyLimit) {
+        static AccountPatch parse(JsonNode body) {
+            if (body == null || !body.isObject()) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+            var fields = body.fieldNames();
+            while (fields.hasNext()) {
+                String field = fields.next();
+                if (!field.equals("nickname") && !field.equals("dailyLimit")) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+            }
+            if (body.has("nickname") && !body.get("nickname").isTextual()
+                || body.has("dailyLimit") && (!body.get("dailyLimit").isIntegralNumber()
+                    || !body.get("dailyLimit").canConvertToInt()
+                    || body.get("dailyLimit").intValue() < 0
+                    || body.get("dailyLimit").intValue() > 5000)
+                || !body.has("nickname") && !body.has("dailyLimit")) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+
+            String nickname = null;
+            if (body.has("nickname")) {
+                nickname = body.get("nickname").textValue().trim();
+                if (nickname.isEmpty() || nickname.length() > 40) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+            }
+            return new AccountPatch(body.has("nickname"), nickname, body.has("dailyLimit"),
+                body.has("dailyLimit") ? body.get("dailyLimit").intValue() : 0);
+        }
+    }
