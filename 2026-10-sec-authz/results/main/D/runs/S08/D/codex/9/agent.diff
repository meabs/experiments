+    public record AccountPatch(String nickname, boolean nicknamePresent, Integer dailyLimit, boolean dailyLimitPresent) {
+        static AccountPatch parse(JsonNode body) {
+            if (body == null || !body.isObject()) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+            int knownFields = (body.has("nickname") ? 1 : 0) + (body.has("dailyLimit") ? 1 : 0);
+            if (body.size() == 0 || body.size() != knownFields
+                || body.has("nickname") && !body.get("nickname").isTextual()
+                || body.has("dailyLimit") && (!body.get("dailyLimit").isIntegralNumber()
+                    || body.get("dailyLimit").canConvertToInt() == false)) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+            if (body.has("nickname") && body.get("nickname").asText().trim().length() == 0
+                || body.has("nickname") && body.get("nickname").asText().trim().length() > 40
+                || body.has("dailyLimit") && (body.get("dailyLimit").asInt() < 0 || body.get("dailyLimit").asInt() > 5000)) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+            return new AccountPatch(
+                body.has("nickname") ? body.get("nickname").asText().trim() : null,
+                body.has("nickname"),
+                body.has("dailyLimit") ? body.get("dailyLimit").intValue() : null,
+                body.has("dailyLimit"));
+        }
+    }
