+    @Transactional
+    public Account update(Long accountId, AccountController.AccountPatch patch) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+        if (patch.nicknamePresent() && (!access.ownsAccount(user, account) || patch.dailyLimitPresent())) {
+            throw new ForbiddenException("Only the account holder can change the nickname");
+        }
+        if (patch.dailyLimitPresent() && (!access.isTenantAdmin(user, account.getTenantId()) || patch.nicknamePresent())) {
+            throw new ForbiddenException("Only an admin can change the daily limit");
+        }
+        if (patch.nicknamePresent()) {
+            account.setNickname(patch.nickname());
+        }
+        if (patch.dailyLimitPresent()) {
+            account.setDailyLimit(patch.dailyLimit());
+        }
+        return account;
