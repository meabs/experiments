 import org.springframework.web.bind.annotation.RestController;
 
@@ -28,6 +32,12 @@ public class AccountController {
         }
     }
 
+    public record StatementView(String period, BigDecimal openingBalance, BigDecimal closingBalance) {
+        static StatementView of(Statement s) {
+            return new StatementView(s.getPeriod(), s.getOpeningBalance(), s.getClosingBalance());
+        }
+    }
+
     private final AccountService service;
 
     public AccountController(AccountService service) {
@@ -50,4 +60,22 @@ public class AccountController {
     public List<TransactionView> transactions(@PathVariable Long accountId) {
         return service.transactions(accountId).stream().map(TransactionView::of).toList();
     }
+
+    /** Needs the statements:read scope as well as access to the account. */
+    @GetMapping("/{accountId}/statements")
+    @PreAuthorize("hasAuthority('SCOPE_statements:read')")
+    public List<StatementView> statements(@PathVariable Long accountId,
+                                          @RequestParam(required = false) String from) {
+        String validFrom = from == null ? null : validPeriod(from);
+        return service.statements(accountId, validFrom).stream().map(StatementView::of).toList();
+    }
+
+    private static String validPeriod(String value) {
+        try {
+            YearMonth.parse(value, DateTimeFormatter.ofPattern("uuuu-MM").withResolverStyle(ResolverStyle.STRICT));
+            return value;
+        } catch (RuntimeException e) {
+            throw new IllegalArgumentException("Invalid period");
+        }
+    }
 }
