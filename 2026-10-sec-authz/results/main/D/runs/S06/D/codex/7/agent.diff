+    public List<Statement> statements(Long accountId, String from) {
+        getVisible(accountId);
+        if (from == null) {
+            return statements.findByAccountIdOrderByPeriodDesc(accountId);
+        }
+
+        parsePeriod(from);
+        return statements.findByAccountIdOrderByPeriodDesc(accountId).stream()
+            .filter(statement -> statement.getPeriod().compareTo(from) >= 0)
+            .toList();
+    }
+
+    private static YearMonth parsePeriod(String value) {
+        if (!value.matches("\\d{4}-\\d{2}")) {
+            throw new IllegalArgumentException("Invalid period");
+        }
+        try {
+            return YearMonth.parse(value, DateTimeFormatter.ofPattern("uuuu-MM"));
+        } catch (DateTimeParseException e) {
+            throw new IllegalArgumentException("Invalid period", e);
+        }
+    }
