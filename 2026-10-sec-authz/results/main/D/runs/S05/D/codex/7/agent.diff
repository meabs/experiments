diff --git a/src/main/java/com/example/accounts/cases/StaffCaseController.java b/src/main/java/com/example/accounts/cases/StaffCaseController.java
new file mode 100644
index 0000000..22819c5
--- /dev/null
+++ b/src/main/java/com/example/accounts/cases/StaffCaseController.java
@@ -0,0 +1,45 @@
+package com.example.accounts.cases;
+
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.security.AccessPolicy;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.ForbiddenException;
+import com.example.accounts.web.NotFoundException;
+
+/** Staff case pages, including internal comments. */
+@RestController
+@RequestMapping("/api/support/cases")
+public class StaffCaseController {
+
+    private final SupportCaseRepository cases;
+    private final CaseCommentRepository comments;
+    private final AccessPolicy access;
+    private final CurrentUserProvider users;
+
+    public StaffCaseController(SupportCaseRepository cases, CaseCommentRepository comments, AccessPolicy access,
+                               CurrentUserProvider users) {
+        this.cases = cases;
+        this.comments = comments;
+        this.access = access;
+        this.users = users;
+    }
+
+    @GetMapping("/{caseId}")
+    @Transactional(readOnly = true)
+    public CaseController.CaseDetail get(@PathVariable String caseId) {
+        CurrentUser user = users.current();
+        if (!user.isSupport() && !user.isAdmin()) {
+            throw new ForbiddenException("Only support staff can view staff cases");
+        }
+        SupportCase supportCase = cases.findById(caseId)
+            .filter(c -> access.canViewCase(user, c))
+            .orElseThrow(() -> new NotFoundException("Case not found"));
+        return CaseController.CaseDetail.of(supportCase, comments.findByCaseIdOrderByCreatedAtAsc(caseId));
+    }
+}
