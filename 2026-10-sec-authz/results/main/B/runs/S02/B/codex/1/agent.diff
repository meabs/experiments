@@ -0,0 +1,51 @@
+package com.example.accounts;
+
+import static com.example.accounts.support.TestUsers.*;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.junit.jupiter.api.Test;
+
+import com.example.accounts.support.ApiTest;
+
+class CustomerContactApiTest extends ApiTest {
+
+    @Test
+    void customerUpdatesTheirOwnContactDetails() throws Exception {
+        putAs(ALICE, "/api/customers/c-1/contact", "{\"email\":\"alice.new@example.test\",\"phone\":\"+44 1632 960111\"}")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$.id").value("c-1"))
+            .andExpect(jsonPath("$.email").value("alice.new@example.test"))
+            .andExpect(jsonPath("$.phone").value("+44 1632 960111"));
+
+        getAs(ADA, "/api/admin/customers/c-1")
+            .andExpect(jsonPath("$.name").value("Alice Archer"))
+            .andExpect(jsonPath("$.address").value("1 Mill Lane, York"))
+            .andExpect(jsonPath("$.riskScore").value(12));
+    }
+
+    @Test
+    void adminUpdatesContactDetailsInTheirTenant() throws Exception {
+        putAs(ADA, "/api/customers/c-2/contact", "{\"email\":\"bob.corrected@example.test\",\"phone\":\"01632 960999\"}")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$.id").value("c-2"))
+            .andExpect(jsonPath("$.email").value("bob.corrected@example.test"))
+            .andExpect(jsonPath("$.phone").value("01632 960999"));
+    }
+
+    @Test
+    void invalidContactDetailsAreRejected() throws Exception {
+        putAs(ALICE, "/api/customers/c-1/contact", "{\"email\":\"not-an-email\",\"phone\":\"123\"}")
+            .andExpect(status().isBadRequest());
+    }
+
+    @Test
+    void onlyTheCustomerOrTenantAdminMayUpdate() throws Exception {
+        putAs(SAM, "/api/customers/c-1/contact", "{\"email\":\"sam@example.test\",\"phone\":\"01632 960222\"}")
+            .andExpect(status().isForbidden());
+        putAs(ALICE, "/api/customers/c-2/contact", "{\"email\":\"alice@example.test\",\"phone\":\"01632 960222\"}")
+            .andExpect(status().isNotFound());
+        putAs(ADA, "/api/customers/c-3/contact", "{\"email\":\"carol@example.test\",\"phone\":\"01632 960222\"}")
+            .andExpect(status().isNotFound());
+    }
+}
