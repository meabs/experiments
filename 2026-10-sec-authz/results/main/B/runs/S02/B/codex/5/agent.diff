@@ -0,0 +1,51 @@
+package com.example.accounts;
+
+import static com.example.accounts.support.TestUsers.ADA;
+import static com.example.accounts.support.TestUsers.ALICE;
+import static com.example.accounts.support.TestUsers.CAROL;
+import static com.example.accounts.support.TestUsers.SAM;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.junit.jupiter.api.Test;
+
+import com.example.accounts.support.ApiTest;
+
+class CustomerContactApiTest extends ApiTest {
+
+    @Test
+    void customerUpdatesTheirContactDetails() throws Exception {
+        putAs(ALICE, "/api/customers/c-1/contact", "{\"email\":\"new@acme.test\",\"phone\":\"+44 1632 960111\"}")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$.id").value("c-1"))
+            .andExpect(jsonPath("$.email").value("new@acme.test"))
+            .andExpect(jsonPath("$.phone").value("+44 1632 960111"));
+    }
+
+    @Test
+    void adminUpdatesCustomerInTheirTenant() throws Exception {
+        putAs(ADA, "/api/customers/c-2/contact", "{\"email\":\"corrected@acme.test\",\"phone\":\"01632 960122\"}")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$.email").value("corrected@acme.test"));
+    }
+
+    @Test
+    void invalidContactDetailsAreRejected() throws Exception {
+        putAs(ALICE, "/api/customers/c-1/contact", "{\"email\":\"not-an-email\",\"phone\":\"123\"}")
+            .andExpect(status().isBadRequest());
+    }
+
+    @Test
+    void callerCannotUpdateAnotherCustomerOrAnotherTenant() throws Exception {
+        putAs(ALICE, "/api/customers/c-2/contact", "{\"email\":\"new@acme.test\",\"phone\":\"01632 960111\"}")
+            .andExpect(status().isNotFound());
+        putAs(CAROL, "/api/customers/c-1/contact", "{\"email\":\"new@globex.test\",\"phone\":\"01632 960211\"}")
+            .andExpect(status().isNotFound());
+    }
+
+    @Test
+    void supportCannotUpdateContactDetails() throws Exception {
+        putAs(SAM, "/api/customers/c-1/contact", "{\"email\":\"new@acme.test\",\"phone\":\"01632 960111\"}")
+            .andExpect(status().isForbidden());
+    }
+}
