+package com.example.accounts;
+
+import static com.example.accounts.support.TestUsers.*;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.junit.jupiter.api.Test;
+
+import com.example.accounts.support.ApiTest;
+import com.example.accounts.support.TestTokens;
+
+class CustomerContactApiTest extends ApiTest {
+
+    @Test
+    void customerUpdatesTheirOwnContactDetails() throws Exception {
+        putAs(ALICE, "/api/customers/c-1/contact", "{\"email\":\"new@acme.test\",\"phone\":\"+44 123456\"}")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$.id").value("c-1"))
+            .andExpect(jsonPath("$.email").value("new@acme.test"))
+            .andExpect(jsonPath("$.phone").value("+44 123456"))
+            .andExpect(jsonPath("$.name").doesNotExist());
+    }
+
+    @Test
+    void adminUpdatesCustomerInTheirTenant() throws Exception {
+        putAs(ADA, "/api/customers/c-2/contact", "{\"email\":\"corrected@acme.test\",\"phone\":\"01632 960999\"}")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$.email").value("corrected@acme.test"));
+    }
+
+    @Test
+    void customerCannotUpdateAnotherCustomer() throws Exception {
+        putAs(ALICE, "/api/customers/c-2/contact", "{\"email\":\"new@acme.test\",\"phone\":\"01632 960999\"}")
+            .andExpect(status().isNotFound());
+    }
+
+    @Test
+    void supportCannotUpdateContactDetails() throws Exception {
+        putAs(SAM, "/api/customers/c-1/contact", "{\"email\":\"new@acme.test\",\"phone\":\"01632 960999\"}")
+            .andExpect(status().isForbidden());
+    }
+
+    @Test
+    void invalidContactDetailsAreRejected() throws Exception {
+        putAs(ALICE, "/api/customers/c-1/contact", "{\"email\":\"not-an-email\",\"phone\":\"123\"}")
+            .andExpect(status().isBadRequest());
+    }
+
+    @Test
+    void contactUpdateNeedsWriteScope() throws Exception {
+        putWith(TestTokens.of(ALICE).scopes("accounts:read"), "/api/customers/c-1/contact",
+            "{\"email\":\"new@acme.test\",\"phone\":\"01632 960999\"}")
+            .andExpect(status().isForbidden());
+    }
+}
