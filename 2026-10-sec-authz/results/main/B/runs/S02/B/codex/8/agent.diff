+++ b/src/test/java/com/example/accounts/AdminCustomerApiTest.java
@@ -30,4 +30,37 @@ class AdminCustomerApiTest extends ApiTest {
     void meShowsTheCaller() throws Exception {
         getAs(ANA, "/api/me").andExpect(jsonPath("$.id").value("u-ana")).andExpect(jsonPath("$.tenantId").value("acme"));
     }
+
+    @Test
+    void customerUpdatesOwnContactDetailsWithoutChangingOtherDetails() throws Exception {
+        putAs(ALICE, "/api/customers/c-1/contact", "{\"email\":\"new@acme.test\",\"phone\":\"+44 1632 960111\"}")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$.id").value("c-1"))
+            .andExpect(jsonPath("$.email").value("new@acme.test"))
+            .andExpect(jsonPath("$.phone").value("+44 1632 960111"));
+        getAs(ADA, "/api/admin/customers/c-1")
+            .andExpect(jsonPath("$.name").value("Alice Archer"))
+            .andExpect(jsonPath("$.address").value("1 Mill Lane, York"));
+    }
+
+    @Test
+    void tenantAdminUpdatesCustomerContactDetails() throws Exception {
+        putAs(ADA, "/api/customers/c-2/contact", "{\"email\":\"corrected@acme.test\",\"phone\":\"01632 960199\"}")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$.email").value("corrected@acme.test"));
+    }
+
+    @Test
+    void contactDetailsRequireValidValues() throws Exception {
+        putAs(ALICE, "/api/customers/c-1/contact", "{\"email\":\"not-an-email\",\"phone\":\"abc\"}")
+            .andExpect(status().isBadRequest());
+    }
+
+    @Test
+    void customerCannotUpdateAnotherCustomerOrCrossTenantCustomer() throws Exception {
+        putAs(ALICE, "/api/customers/c-2/contact", "{\"email\":\"other@acme.test\",\"phone\":\"01632 960199\"}")
+            .andExpect(status().isForbidden());
+        putAs(CAROL, "/api/customers/c-1/contact", "{\"email\":\"other@globex.test\",\"phone\":\"01632 960299\"}")
+            .andExpect(status().isNotFound());
+    }
 }
