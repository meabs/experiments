+++ b/src/main/java/com/example/accounts/security/AccessPolicy.java
@@ -53,4 +53,9 @@ public class AccessPolicy {
     public boolean isTenantAdmin(CurrentUser user, String tenantId) {
         return user.isAdmin() && user.inTenant(tenantId);
     }
+
+    /** The customer themselves or an admin of the customer's tenant may change contact details. */
+    public boolean canUpdateContact(CurrentUser user, Customer customer) {
+        return isSelf(user, customer) || isTenantAdmin(user, customer.getTenantId());
+    }
 }
