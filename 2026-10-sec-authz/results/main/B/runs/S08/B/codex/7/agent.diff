+    @PatchMapping("/{accountId}")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public AccountView update(@PathVariable Long accountId, @RequestBody JsonNode body) {
+        Update update = Update.parse(body);
+        Account account = service.getVisible(accountId); // 404 unless the caller may see it
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+
+        CurrentUser user = users.current();
+        if (update.nickname() != null && !access.ownsAccount(user, account)) {
+            throw new ForbiddenException("Only the account holder can change the nickname");
+        }
+        if (update.dailyLimit() != null && !access.isTenantAdmin(user, account.getTenantId())) {
+            throw new ForbiddenException("Only an admin can change the daily limit");
+        }
+
+        if (update.nickname() != null) {
+            account.setNickname(update.nickname());
+        }
+        if (update.dailyLimit() != null) {
+            account.setDailyLimit(update.dailyLimit());
+        }
+        return AccountView.of(account);
+    }
+
+    private record Update(String nickname, Integer dailyLimit) {
+        static Update parse(JsonNode body) {
+            if (body == null || !body.isObject()) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+            if (body.size() == 0) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+            var fields = body.fieldNames();
+            while (fields.hasNext()) {
+                String field = fields.next();
+                if (!field.equals("nickname") && !field.equals("dailyLimit")) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+            }
+
+            String nickname = null;
+            if (body.has("nickname")) {
+                JsonNode value = body.get("nickname");
+                if (value == null || !value.isTextual()) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+                nickname = value.textValue().trim();
+                if (nickname.isEmpty() || nickname.length() > 40) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+            }
+
+            Integer dailyLimit = null;
+            if (body.has("dailyLimit")) {
+                JsonNode value = body.get("dailyLimit");
+                if (value == null || !value.isIntegralNumber() || !value.canConvertToInt()) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+                dailyLimit = value.intValue();
+                if (dailyLimit < 0 || dailyLimit > 5000) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+            }
+            if (nickname == null && dailyLimit == null) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+            return new Update(nickname, dailyLimit);
+        }
+    }
