@@ -6,9 +6,12 @@ import org.springframework.stereotype.Service;
 import org.springframework.transaction.annotation.Transactional;
 
 import com.example.accounts.customer.CustomerRepository;
+import com.example.accounts.account.AccountController.AccountPatchRequest;
 import com.example.accounts.security.AccessPolicy;
 import com.example.accounts.security.CurrentUser;
 import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.ConflictException;
+import com.example.accounts.web.ForbiddenException;
 import com.example.accounts.web.NotFoundException;
 
 @Service
@@ -66,4 +69,44 @@ public class AccountService {
     public List<Transaction> transactions(Long accountId) {
         return transactions.findByAccountIdOrderByBookedOnDescIdDesc(getVisible(accountId).getId());
     }
+
+    @Transactional
+    public Account update(Long accountId, AccountPatchRequest request) {
+        Account account = getVisible(accountId);
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+        validate(request);
+
+        CurrentUser user = users.current();
+        if (request.hasNickname() && !access.ownsAccount(user, account)) {
+            throw new ForbiddenException("Only the account holder can change the nickname");
+        }
+        if (request.hasDailyLimit() && !access.isTenantAdmin(user, account.getTenantId())) {
+            throw new ForbiddenException("Only an admin can change the daily limit");
+        }
+
+        if (request.hasNickname()) {
+            account.setNickname(request.getNickname().trim());
+        }
+        if (request.hasDailyLimit()) {
+            account.setDailyLimit(request.getDailyLimit());
+        }
+        return account;
+    }
+
+    private static void validate(AccountPatchRequest request) {
+        if (request == null || (!request.hasNickname() && !request.hasDailyLimit())) {
+            throw new IllegalArgumentException("Patch must contain a change");
+        }
+        if (request.hasNickname()
+            && (request.getNickname() == null || request.getNickname().trim().length() < 1
+                || request.getNickname().trim().length() > 40)) {
+            throw new IllegalArgumentException("Nickname must be 1 to 40 characters");
+        }
+        if (request.hasDailyLimit() && (request.getDailyLimit() == null
+            || request.getDailyLimit() < 0 || request.getDailyLimit() > 5000)) {
+            throw new IllegalArgumentException("Daily limit must be between 0 and 5000");
+        }
+    }
 }
