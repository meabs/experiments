diff --git a/src/main/java/com/example/accounts/account/AccountService.java b/src/main/java/com/example/accounts/account/AccountService.java
index c1dfaa8..2605b5d 100644
--- a/src/main/java/com/example/accounts/account/AccountService.java
+++ b/src/main/java/com/example/accounts/account/AccountService.java
@@ -10,6 +10,8 @@ import com.example.accounts.security.AccessPolicy;
 import com.example.accounts.security.CurrentUser;
 import com.example.accounts.security.CurrentUserProvider;
 import com.example.accounts.web.NotFoundException;
+import com.example.accounts.web.ConflictException;
+import com.example.accounts.web.ForbiddenException;
 
 @Service
 @Transactional(readOnly = true)
@@ -66,4 +68,35 @@ public class AccountService {
     public List<Transaction> transactions(Long accountId) {
         return transactions.findByAccountIdOrderByBookedOnDescIdDesc(getVisible(accountId).getId());
     }
+
+    @Transactional
+    public Account update(Long accountId, AccountController.AccountPatch patch) {
+        if (patch == null || (!patch.isNicknameProvided() && !patch.isDailyLimitProvided())
+            || (patch.isNicknameProvided() && (patch.getNickname() == null
+                || patch.getNickname().trim().isEmpty() || patch.getNickname().trim().length() > 40))
+            || (patch.isDailyLimitProvided() && (patch.getDailyLimit() == null
+                || patch.getDailyLimit() < 0 || patch.getDailyLimit() > 5000))) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        boolean changesNickname = patch.isNicknameProvided();
+        boolean changesDailyLimit = patch.isDailyLimitProvided();
+        if ((changesNickname && !access.ownsAccount(user, account))
+            || (changesDailyLimit && !access.isTenantAdmin(user, account.getTenantId()))) {
+            throw new ForbiddenException("You may not change these account fields");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Closed accounts cannot be changed");
+        }
+
+        if (changesNickname) {
+            account.setNickname(patch.getNickname().trim());
+        }
+        if (changesDailyLimit) {
+            account.setDailyLimit(patch.getDailyLimit());
+        }
+        return account;
+    }
 }
