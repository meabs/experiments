+            }
+            if (nickname != null) {
+                String trimmed = nickname.strip();
+                if (trimmed.isEmpty() || trimmed.codePointCount(0, trimmed.length()) > 40) {
+                    throw new IllegalArgumentException("Invalid nickname");
+                }
+            }
+            if (dailyLimit != null && (dailyLimit < 0 || dailyLimit > 5000)) {
+                throw new IllegalArgumentException("Invalid daily limit");
+            }
+        }
