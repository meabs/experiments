+
+    @Transactional
+    public Account update(Long accountId, String nickname, Integer dailyLimit) {
+        if (nickname == null && dailyLimit == null) {
+            throw new IllegalArgumentException("At least one account setting is required");
+        }
+
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Closed accounts cannot be changed");
+        }
+        if (nickname != null && !access.ownsAccount(user, account)) {
+            throw new ForbiddenException("Only the account holder can change the nickname");
+        }
+        if (dailyLimit != null && !access.isTenantAdmin(user, account.getTenantId())) {
+            throw new ForbiddenException("Only an admin can change the daily limit");
+        }
+
+        if (nickname != null) {
+            account.setNickname(nickname);
+        }
+        if (dailyLimit != null) {
+            account.setDailyLimit(dailyLimit);
+        }
+        return account;
+    }
