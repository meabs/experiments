+    @Transactional
+    public Account update(Long accountId, AccountController.AccountPatch patch) {
+        if (patch == null || (!patch.nicknamePresent() && !patch.dailyLimitPresent())) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        Account account = getVisible(accountId);
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+
+        CurrentUser user = users.current();
+        boolean customerChange = patch.nicknamePresent() && !patch.dailyLimitPresent();
+        boolean adminChange = patch.dailyLimitPresent() && !patch.nicknamePresent();
+        if ((customerChange && !access.ownsAccount(user, account))
+            || (adminChange && !access.isTenantAdmin(user, account.getTenantId()))
+            || (!customerChange && !adminChange)) {
+            throw new ForbiddenException("You may not change these account fields");
+        }
+
+        if (patch.nicknamePresent()) {
+            account.setNickname(validNickname(patch.nickname()));
+        }
+        if (patch.dailyLimitPresent()) {
+            account.setDailyLimit(validDailyLimit(patch.dailyLimit()));
+        }
+        return account;
+    }
+
+    private static String validNickname(JsonNode value) {
+        if (value == null || !value.isTextual()) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        String nickname = value.textValue().trim();
+        if (nickname.isEmpty() || nickname.length() > 40) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        return nickname;
+    }
+
+    private static int validDailyLimit(JsonNode value) {
+        if (value == null || !value.isIntegralNumber() || !value.canConvertToInt()) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        int dailyLimit = value.intValue();
+        if (dailyLimit < 0 || dailyLimit > 5000) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        return dailyLimit;
+    }
