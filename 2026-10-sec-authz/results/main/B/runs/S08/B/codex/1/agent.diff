+
+    @Transactional
+    public Account update(Long accountId, String nickname, Integer dailyLimit, boolean nicknameIncluded,
+                          boolean dailyLimitIncluded) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if ((nicknameIncluded && !access.ownsAccount(user, account))
+            || (dailyLimitIncluded && !access.isTenantAdmin(user, account.getTenantId()))) {
+            throw new ForbiddenException("You may not change one or more account settings");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Closed accounts cannot be changed");
+        }
+        if (nicknameIncluded) {
+            account.setNickname(nickname);
+        }
+        if (dailyLimitIncluded) {
+            account.setDailyLimit(dailyLimit);
+        }
+        return account;
+    }
 }
