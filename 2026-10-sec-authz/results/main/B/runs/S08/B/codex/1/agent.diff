+    @PatchMapping("/{accountId}")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    public AccountView update(@PathVariable Long accountId, @RequestBody JsonNode body) {
+        if (body == null || !body.isObject()) {
+            throw new InvalidRequestException();
+        }
+
+        boolean hasNickname = body.has("nickname");
+        boolean hasDailyLimit = body.has("dailyLimit");
+        if ((!hasNickname && !hasDailyLimit) || body.size() != (hasNickname ? 1 : 0) + (hasDailyLimit ? 1 : 0)) {
+            throw new InvalidRequestException();
+        }
+
+        String nickname = null;
+        if (hasNickname) {
+            JsonNode value = body.get("nickname");
+            if (value == null || !value.isTextual()) {
+                throw new InvalidRequestException();
+            }
+            nickname = value.textValue().trim();
+            if (nickname.isEmpty() || nickname.length() > 40) {
+                throw new InvalidRequestException();
+            }
+        }
+
+        Integer dailyLimit = null;
+        if (hasDailyLimit) {
+            JsonNode value = body.get("dailyLimit");
+            if (value == null || !value.isIntegralNumber() || !value.canConvertToInt()) {
+                throw new InvalidRequestException();
+            }
+            dailyLimit = value.intValue();
+            if (dailyLimit < 0 || dailyLimit > 5000) {
+                throw new InvalidRequestException();
+            }
+        }
+
+        return AccountView.of(service.update(accountId, nickname, dailyLimit, hasNickname, hasDailyLimit));
+    }
+
