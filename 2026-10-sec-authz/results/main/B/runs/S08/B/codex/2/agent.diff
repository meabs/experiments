+++ b/src/main/java/com/example/accounts/account/AccountService.java
@@ -9,6 +9,8 @@ import com.example.accounts.customer.CustomerRepository;
 import com.example.accounts.security.AccessPolicy;
 import com.example.accounts.security.CurrentUser;
 import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.ConflictException;
+import com.example.accounts.web.ForbiddenException;
 import com.example.accounts.web.NotFoundException;
 
 @Service
@@ -66,4 +68,25 @@ public class AccountService {
     public List<Transaction> transactions(Long accountId) {
         return transactions.findByAccountIdOrderByBookedOnDescIdDesc(getVisible(accountId).getId());
     }
+
+    @Transactional
+    public Account update(Long accountId, String nickname, Integer dailyLimit) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        boolean mayRename = nickname == null || access.ownsAccount(user, account);
+        boolean mayChangeLimit = dailyLimit == null || access.isTenantAdmin(user, account.getTenantId());
+        if (!mayRename || !mayChangeLimit) {
+            throw new ForbiddenException("You may not change these account settings");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Closed accounts cannot be changed");
+        }
+        if (nickname != null) {
+            account.setNickname(nickname);
+        }
+        if (dailyLimit != null) {
+            account.setDailyLimit(dailyLimit);
+        }
+        return account;
+    }
 }
