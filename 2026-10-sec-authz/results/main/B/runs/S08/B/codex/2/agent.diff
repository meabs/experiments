+    @PatchMapping("/{accountId}")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    public AccountView update(@PathVariable Long accountId, @Valid @RequestBody AccountPatch body) {
+        if (body == null) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        String nickname = nickname(body.nickname());
+        Integer dailyLimit = dailyLimit(body.dailyLimit());
+        if (nickname == null && dailyLimit == null) {
+            throw new IllegalArgumentException("At least one account setting is required");
+        }
+        return AccountView.of(service.update(accountId, nickname, dailyLimit));
+    }
+
+    private static String nickname(JsonNode value) {
+        if (value == null) {
+            return null;
+        }
+        if (!value.isTextual()) {
+            throw new IllegalArgumentException("Invalid nickname");
+        }
+        String trimmed = value.textValue().trim();
+        if (trimmed.isEmpty() || trimmed.length() > 40) {
+            throw new IllegalArgumentException("Invalid nickname");
+        }
+        return trimmed;
+    }
+
+    private static Integer dailyLimit(JsonNode value) {
+        if (value == null) {
+            return null;
+        }
+        if (!value.isIntegralNumber() || !value.canConvertToInt()) {
+            throw new IllegalArgumentException("Invalid daily limit");
+        }
+        int limit = value.intValue();
+        if (limit < 0 || limit > 5000) {
+            throw new IllegalArgumentException("Invalid daily limit");
+        }
+        return limit;
+    }
+
     /** Needs the transactions:read scope as well as access to the account. */
