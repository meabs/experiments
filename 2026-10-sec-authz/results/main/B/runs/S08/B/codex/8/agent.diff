+    @Transactional
+    public Account update(Long accountId, AccountController.AccountPatch patch) {
+        patch.validate();
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        boolean mayChangeNickname = patch.nicknameSet() && access.ownsAccount(user, account);
+        boolean mayChangeDailyLimit = patch.dailyLimitSet() && access.isTenantAdmin(user, account.getTenantId());
+        if ((patch.nicknameSet() && !mayChangeNickname)
+            || (patch.dailyLimitSet() && !mayChangeDailyLimit)) {
+            throw new ForbiddenException("You may not change these account settings");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Closed accounts cannot be changed");
+        }
+        if (patch.nicknameSet()) {
+            account.setNickname(patch.trimmedNickname());
+        }
+        if (patch.dailyLimitSet()) {
+            account.setDailyLimit(patch.dailyLimit());
+        }
+        return account;
+    }
