+    public static class AccountPatch {
+        private String nickname;
+        private Integer dailyLimit;
+        private boolean nicknameSet;
+        private boolean dailyLimitSet;
+
+        public void setNickname(String nickname) {
+            this.nickname = nickname;
+            this.nicknameSet = true;
+        }
+
+        public void setDailyLimit(Integer dailyLimit) {
+            this.dailyLimit = dailyLimit;
+            this.dailyLimitSet = true;
+        }
+
+        public String nickname() { return nickname; }
+        public Integer dailyLimit() { return dailyLimit; }
+        public boolean nicknameSet() { return nicknameSet; }
+        public boolean dailyLimitSet() { return dailyLimitSet; }
+
+        void validate() {
+            if (!nicknameSet && !dailyLimitSet) {
+                throw new IllegalArgumentException("At least one account setting is required");
+            }
+            if (nicknameSet) {
+                if (nickname == null) {
+                    throw new IllegalArgumentException("Nickname is required when supplied");
+                }
+                String trimmed = nickname.trim();
+                if (trimmed.isEmpty() || trimmed.length() > 40) {
+                    throw new IllegalArgumentException("Nickname must be 1 to 40 characters after trimming");
+                }
+            }
+            if (dailyLimitSet && (dailyLimit == null || dailyLimit < 0 || dailyLimit > 5000)) {
+                throw new IllegalArgumentException("Daily limit must be between 0 and 5000");
+            }
+        }
+
+        String trimmedNickname() {
+            return nickname.trim();
+        }
+    }
