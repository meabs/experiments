--- /dev/null
+++ b/src/main/java/com/example/accounts/account/AccountPatchRequest.java
@@ -0,0 +1,47 @@
+package com.example.accounts.account;
+
+import com.fasterxml.jackson.annotation.JsonProperty;
+
+/** Fields that may be changed on an account. Presence is tracked so null is not treated as omission. */
+public class AccountPatchRequest {
+
+    private String nickname;
+    private Integer dailyLimit;
+    private boolean nicknamePresent;
+    private boolean dailyLimitPresent;
+
+    @JsonProperty("nickname")
+    public void setNickname(String nickname) {
+        this.nicknamePresent = true;
+        this.nickname = nickname;
+    }
+
+    @JsonProperty("dailyLimit")
+    public void setDailyLimit(Integer dailyLimit) {
+        this.dailyLimitPresent = true;
+        this.dailyLimit = dailyLimit;
+    }
+
+    public boolean hasNickname() { return nicknamePresent; }
+    public boolean hasDailyLimit() { return dailyLimitPresent; }
+    public String getNickname() { return nickname; }
+    public Integer getDailyLimit() { return dailyLimit; }
+
+    public String normalizedNickname() {
+        if (!nicknamePresent || nickname == null) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        String normalized = nickname.strip();
+        if (normalized.isEmpty() || normalized.length() > 40) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        return normalized;
+    }
+
+    public int validDailyLimit() {
+        if (!dailyLimitPresent || dailyLimit == null || dailyLimit < 0 || dailyLimit > 5000) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        return dailyLimit;
+    }
+}
