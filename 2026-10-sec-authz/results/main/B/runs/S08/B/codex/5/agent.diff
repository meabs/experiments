+    @Transactional
+    public Account update(Long accountId, String nickname, boolean nicknamePresent, Integer dailyLimit,
+                          boolean dailyLimitPresent) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Closed accounts cannot be changed");
+        }
+
+        boolean mayChangeNickname = !nicknamePresent || access.ownsAccount(user, account);
+        boolean mayChangeDailyLimit = !dailyLimitPresent || access.isTenantAdmin(user, account.getTenantId());
+        if (!mayChangeNickname || !mayChangeDailyLimit) {
+            throw new ForbiddenException("You may not change this account setting");
+        }
+
+        if (nicknamePresent) {
+            account.setNickname(nickname.trim());
+        }
