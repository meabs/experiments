@@ -0,0 +1,45 @@
+package com.example.accounts;
+
+import static com.example.accounts.support.TestUsers.*;
+import static org.hamcrest.Matchers.contains;
+import static org.hamcrest.Matchers.hasSize;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.junit.jupiter.api.Test;
+
+import com.example.accounts.support.ApiTest;
+
+class CustomerSearchApiTest extends ApiTest {
+
+    @Test
+    void adminSearchesTheirTenantByNameOrEmailAndGetsOnlyPublicFields() throws Exception {
+        getAs(ADA, "/api/customers/search?q=  ARCH  ")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$[*].id", contains("c-1")))
+            .andExpect(jsonPath("$[*].name", contains("Alice Archer")))
+            .andExpect(jsonPath("$[0].email").value("alice@acme.test"))
+            .andExpect(jsonPath("$[0].phone").doesNotExist())
+            .andExpect(jsonPath("$[0].riskScore").doesNotExist());
+        getAs(ADA, "/api/customers/search?q=ACME.TEST")
+            .andExpect(status().isOk()).andExpect(jsonPath("$", hasSize(3)));
+    }
+
+    @Test
+    void supportSeesOnlyCustomersWithAssignedAccounts() throws Exception {
+        getAs(SAM, "/api/customers/search?q=a")
+            .andExpect(status().isBadRequest());
+        getAs(SAM, "/api/customers/search?q=ac")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$[*].id", contains("c-1")));
+        getAs(SUE, "/api/customers/search?q=ob")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$[*].id", contains("c-2")));
+    }
+
+    @Test
+    void otherRolesAreForbiddenAndQueryMustBeAtLeastTwoCharacters() throws Exception {
+        getAs(ALICE, "/api/customers/search?q=Al").andExpect(status().isForbidden());
+        getAs(ADA, "/api/customers/search").andExpect(status().isBadRequest());
+    }
+}
