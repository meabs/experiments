@@ -0,0 +1,47 @@
+package com.example.accounts;
+
+import static com.example.accounts.support.TestUsers.*;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.junit.jupiter.api.Test;
+
+import com.example.accounts.support.ApiTest;
+
+class CustomerSearchApiTest extends ApiTest {
+
+    @Test
+    void adminSearchesCustomersInTheirTenantWithMinimalFields() throws Exception {
+        getAs(ADA, "/api/customers/search?q=arch")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$[0].name").value("Alice Archer"))
+            .andExpect(jsonPath("$[0].email").value("alice@acme.test"))
+            .andExpect(jsonPath("$[0].riskScore").doesNotExist())
+            .andExpect(jsonPath("$[1]").doesNotExist());
+    }
+
+    @Test
+    void supportSearchesOnlyCustomersWithAssignedAccounts() throws Exception {
+        getAs(SAM, "/api/customers/search?q=alice")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$[0].id").value("c-1"));
+    }
+
+    @Test
+    void searchIsCaseInsensitiveAndTrimsForValidation() throws Exception {
+        getAs(ADA, "/api/customers/search?q=BOB")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$[0].id").value("c-2"));
+    }
+
+    @Test
+    void shortSearchIsBadRequest() throws Exception {
+        getAs(ADA, "/api/customers/search?q=a").andExpect(status().isBadRequest());
+    }
+
+    @Test
+    void onlySupportAndAdminsMaySearch() throws Exception {
+        getAs(ALICE, "/api/customers/search?q=alice").andExpect(status().isForbidden());
+        getAnonymous("/api/customers/search?q=alice").andExpect(status().isUnauthorized());
+    }
+}
