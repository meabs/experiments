     }
+
+    @Test
+    void statementsNeedTheirOwnScope() throws Exception {
+        getAs(ALICE, "/api/accounts/1/statements").andExpect(status().isForbidden());
+    }
+
+    @Test
+    void statementsAreNewestFirstAndCanBeFiltered() throws Exception {
+        getWith(TestTokens.of(ALICE).scopes("statements:read"), "/api/accounts/1/statements?from=2026-08")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$[*].period", containsInAnyOrder("2026-08", "2026-09")))
+            .andExpect(jsonPath("$[0].period").value("2026-09"))
+            .andExpect(jsonPath("$[0].openingBalance").value(1100.00))
+            .andExpect(jsonPath("$[0].closingBalance").value(1200.00));
+    }
+
+    @Test
+    void invalidStatementPeriodIsRejected() throws Exception {
+        getWith(TestTokens.of(ALICE).scopes("statements:read"), "/api/accounts/1/statements?from=2026-13")
+            .andExpect(status().isBadRequest());
+    }
+
+    @Test
+    void statementsScopeDoesNotOpenOtherAccounts() throws Exception {
+        getWith(TestTokens.of(BOB).scopes("statements:read"), "/api/accounts/1/statements")
+            .andExpect(status().isNotFound());
+    }
 }
