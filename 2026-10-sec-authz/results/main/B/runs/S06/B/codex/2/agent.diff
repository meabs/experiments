         this.accounts = accounts;
         this.customers = customers;
         this.assignments = assignments;
         this.transactions = transactions;
+        this.statements = statements;
         this.access = access;
         this.users = users;
     }
@@ -66,4 +73,24 @@ public class AccountService {
     public List<Transaction> transactions(Long accountId) {
         return transactions.findByAccountIdOrderByBookedOnDescIdDesc(getVisible(accountId).getId());
     }
+
+    public List<Statement> statements(Long accountId, String from) {
+        Long visibleAccountId = getVisible(accountId).getId();
+        if (from == null) {
+            return statements.findByAccountIdOrderByPeriodDesc(visibleAccountId);
+        }
+        validatePeriod(from);
+        return statements.findByAccountIdAndPeriodGreaterThanEqualOrderByPeriodDesc(visibleAccountId, from);
+    }
+
+    private static void validatePeriod(String period) {
+        if (!period.matches("\\d{4}-\\d{2}")) {
+            throw new IllegalArgumentException("Invalid period");
+        }
+        try {
+            YearMonth.parse(period, DateTimeFormatter.ofPattern("uuuu-MM").withResolverStyle(ResolverStyle.STRICT));
+        } catch (DateTimeParseException e) {
+            throw new IllegalArgumentException("Invalid period", e);
+        }
+    }
 }
