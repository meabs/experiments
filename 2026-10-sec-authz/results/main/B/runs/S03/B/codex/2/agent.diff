+
+    /** Closes an account for an already-authorised closure request in the same tenant. */
+    @Transactional
+    public void closeForClosure(Long accountId, String tenantId) {
+        accounts.findById(accountId)
+            .filter(a -> tenantId.equals(a.getTenantId()))
+            .orElseThrow(() -> new NotFoundException("Account not found"))
+            .setStatus(Account.Status.CLOSED);
+    }
 }
