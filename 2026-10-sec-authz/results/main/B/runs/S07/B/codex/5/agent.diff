+package com.example.accounts.customer;
+
+import com.fasterxml.jackson.annotation.JsonInclude;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+@RestController
+@RequestMapping("/api/customers")
+public class CustomerExportController {
+
+    @JsonInclude(JsonInclude.Include.NON_NULL)
+    public record CustomerView(String id, String name, String email, String phone, String address, Integer riskScore) {
+        static CustomerView of(CustomerExportService.CustomerData customer) {
+            return new CustomerView(customer.id(), customer.name(), customer.email(), customer.phone(),
+                customer.address(), customer.riskScore());
+        }
+    }
+
+    public record AccountView(Long id, String nickname, String type, java.math.BigDecimal balance, String status) {
+        static AccountView of(CustomerExportService.AccountData account) {
+            return new AccountView(account.id(), account.nickname(), account.type(), account.balance(), account.status());
+        }
+    }
+
+    public record NoteView(Long accountId, String body, boolean internal, java.time.Instant createdAt) {
+        static NoteView of(CustomerExportService.NoteData note) {
+            return new NoteView(note.accountId(), note.body(), note.internal(), note.createdAt());
+        }
+    }
+
+    public record ExportView(CustomerView customer, java.util.List<AccountView> accounts, java.util.List<NoteView> notes) {
+        static ExportView of(CustomerExportService.ExportData export) {
+            return new ExportView(CustomerView.of(export.customer()),
+                export.accounts().stream().map(AccountView::of).toList(),
+                export.notes().stream().map(NoteView::of).toList());
+        }
+    }
+
+    private final CustomerExportService service;
+
+    public CustomerExportController(CustomerExportService service) {
+        this.service = service;
+    }
+
+    @GetMapping("/{customerId}/export")
+    @PreAuthorize("hasRole('CUSTOMER') or hasRole('ADMIN')")
+    public ExportView export(@PathVariable String customerId) {
+        return ExportView.of(service.export(customerId));
+    }
+}
