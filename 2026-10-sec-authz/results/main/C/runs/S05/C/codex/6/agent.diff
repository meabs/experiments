+package com.example.accounts.cases;
+
+import java.time.Instant;
+import java.util.List;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.security.AccessPolicy;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.NotFoundException;
+
+/** Staff view of complete support cases, including internal comments. */
+@RestController
+@RequestMapping("/api/support/cases")
+public class SupportCaseController {
+
+    public record CommentView(String author, String body, boolean internal, Instant createdAt) {
+        static CommentView of(CaseComment comment) {
+            return new CommentView(comment.getAuthor(), comment.getBody(), comment.isInternal(), comment.getCreatedAt());
+        }
+    }
+
+    public record CaseDetail(String id, Long accountId, String customerId, String subject, String status,
+                             String assigneeUserId, List<CommentView> comments) {
+        static CaseDetail of(SupportCase supportCase, List<CaseComment> comments) {
+            return new CaseDetail(supportCase.getId(), supportCase.getAccountId(), supportCase.getCustomerId(),
+                supportCase.getSubject(), supportCase.getStatus(), supportCase.getAssigneeUserId(),
+                comments.stream().map(CommentView::of).toList());
+        }
+    }
+
+    private final SupportCaseRepository cases;
+    private final CaseCommentRepository comments;
+    private final AccessPolicy access;
+    private final CurrentUserProvider users;
+
+    public SupportCaseController(SupportCaseRepository cases, CaseCommentRepository comments, AccessPolicy access,
+                                 CurrentUserProvider users) {
+        this.cases = cases;
+        this.comments = comments;
+        this.access = access;
+        this.users = users;
+    }
+
+    @GetMapping("/{caseId}")
+    @PreAuthorize("hasAnyRole('SUPPORT', 'ADMIN')")
+    @Transactional(readOnly = true)
+    public CaseDetail get(@PathVariable String caseId) {
+        SupportCase supportCase = cases.findById(caseId)
+            .filter(c -> access.canViewSupportCase(users.current(), c))
+            .orElseThrow(() -> new NotFoundException("Case not found"));
+        return CaseDetail.of(supportCase, comments.findByCaseIdOrderByCreatedAtAsc(caseId));
+    }
+}
