     public boolean isTenantAdmin(CurrentUser user, String tenantId) {
         return user.isAdmin() && user.inTenant(tenantId);
     }
+
+    /** Staff may see a case when they are its assignee or are assigned to its account. */
+    public boolean canViewCase(CurrentUser user, SupportCase supportCase) {
+        if (!user.inTenant(supportCase.getTenantId())) {
+            return false;
+        }
+        if (user.isAdmin()) {
+            return true;
+        }
+        return user.isSupport()
+            && (user.id().equals(supportCase.getAssigneeUserId())
+                || assignments.existsByTenantIdAndSupportUserIdAndAccountId(
+                    supportCase.getTenantId(), user.id(), supportCase.getAccountId()));
+    }
 }
