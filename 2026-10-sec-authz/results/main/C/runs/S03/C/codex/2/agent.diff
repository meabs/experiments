+
+    /** Closes an account belonging to the supplied tenant as part of an approved closure request. */
+    @Transactional
+    public void closeInTenant(String tenantId, Long accountId) {
+        Account account = accounts.findById(accountId)
+            .filter(a -> tenantId.equals(a.getTenantId()))
+            .orElseThrow(() -> new NotFoundException("Account not found"));
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is already closed");
+        }
+        account.setStatus(Account.Status.CLOSED);
+    }
 }
