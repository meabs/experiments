+        Account account = getVisible(accountId);
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+        // Check every requested field before changing any of them, so mixed requests are atomic.
+        if (patch.nicknamePresent() && !access.ownsAccount(user, account)) {
+            throw new ForbiddenException("Only the account holder can change the nickname");
+        }
+        if (patch.dailyLimitPresent() && !access.isTenantAdmin(user, account.getTenantId())) {
+            throw new ForbiddenException("Only a tenant admin can change the daily limit");
+        }
+        if (patch.nicknamePresent()) {
+            account.setNickname(patch.nickname());
+        }
+        if (patch.dailyLimitPresent()) {
+            account.setDailyLimit(patch.dailyLimit());
+        }
+        return account;
