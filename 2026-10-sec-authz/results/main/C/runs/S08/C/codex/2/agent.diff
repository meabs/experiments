diff --git a/src/main/java/com/example/accounts/account/AccountPatch.java b/src/main/java/com/example/accounts/account/AccountPatch.java
new file mode 100644
index 0000000..17f7fd9
--- /dev/null
+++ b/src/main/java/com/example/accounts/account/AccountPatch.java
@@ -0,0 +1,47 @@
+package com.example.accounts.account;
+
+import com.fasterxml.jackson.databind.JsonNode;
+
+/** Validated presence-aware fields for the partial account update request. */
+record AccountPatch(boolean nicknamePresent, String nickname, boolean dailyLimitPresent, int dailyLimit) {
+
+    static AccountPatch from(JsonNode body) {
+        if (body == null || !body.isObject() || body.size() == 0) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        var fields = body.fieldNames();
+        while (fields.hasNext()) {
+            String field = fields.next();
+            if (!field.equals("nickname") && !field.equals("dailyLimit")) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+        }
+
+        boolean hasNickname = body.has("nickname");
+        String nickname = null;
+        if (hasNickname) {
+            JsonNode value = body.get("nickname");
+            if (!value.isTextual()) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+            nickname = value.textValue().strip();
+            if (nickname.isEmpty() || nickname.codePointCount(0, nickname.length()) > 40) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+        }
+
+        boolean hasDailyLimit = body.has("dailyLimit");
+        int dailyLimit = 0;
+        if (hasDailyLimit) {
+            JsonNode value = body.get("dailyLimit");
+            if (!value.isIntegralNumber() || !value.canConvertToInt()) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+            dailyLimit = value.intValue();
+            if (dailyLimit < 0 || dailyLimit > 5000) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+        }
+        return new AccountPatch(hasNickname, nickname, hasDailyLimit, dailyLimit);
+    }
+}
