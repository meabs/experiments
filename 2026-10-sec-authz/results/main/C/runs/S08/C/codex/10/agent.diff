+    @Transactional
+    public Account update(Long accountId, String nickname, Integer dailyLimit) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+
+        boolean owns = access.ownsAccount(user, account);
+        boolean admin = access.isTenantAdmin(user, account.getTenantId());
+        if ((nickname != null && !owns) || (dailyLimit != null && !admin)) {
+            throw new ForbiddenException("You may not change these account fields");
+        }
+        if (nickname != null) {
+            account.setNickname(nickname);
+        }
+        if (dailyLimit != null) {
+            account.setDailyLimit(dailyLimit);
+        }
+        return account;
+    }
