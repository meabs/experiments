+    @Transactional
+    public Account update(Long accountId, String nickname, Integer dailyLimit) {
+        Account account = getVisible(accountId);
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+        if (nickname != null) {
+            account.setNickname(nickname);
+        }
+        if (dailyLimit != null) {
+            account.setDailyLimit(dailyLimit);
+        }
+        return account;
+    }
