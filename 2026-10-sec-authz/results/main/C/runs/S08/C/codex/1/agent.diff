+    @PatchMapping("/{accountId}")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    public AccountView patch(@PathVariable Long accountId, @RequestBody JsonNode body) {
+        Account account = service.getVisible(accountId);
+        AccountPatch patch = AccountPatch.from(body);
+        CurrentUser user = users.current();
+
+        if (patch.dailyLimit() != null && !access.isTenantAdmin(user, account.getTenantId())) {
+            throw new ForbiddenException("Only an admin can change the daily limit");
+        }
+        if (patch.nickname() != null && !access.ownsAccount(user, account)
+            && !access.isTenantAdmin(user, account.getTenantId())) {
+            throw new ForbiddenException("Only the account holder or an admin can change the nickname");
+        }
+        return AccountView.of(service.update(accountId, patch.nickname(), patch.dailyLimit()));
+    }
+
+    private record AccountPatch(String nickname, Integer dailyLimit) {
+        static AccountPatch from(JsonNode body) {
+            if (body == null || !body.isObject() || body.size() == 0) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+            var fields = body.fieldNames();
+            while (fields.hasNext()) {
+                String field = fields.next();
+                if (!field.equals("nickname") && !field.equals("dailyLimit")) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+            }
+
+            JsonNode nicknameNode = body.get("nickname");
+            JsonNode dailyLimitNode = body.get("dailyLimit");
+            if (nicknameNode == null && dailyLimitNode == null) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+
+            String nickname = null;
+            if (nicknameNode != null) {
+                if (!nicknameNode.isTextual()) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+                nickname = nicknameNode.textValue().trim();
+                if (nickname.isEmpty() || nickname.length() > 40) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+            }
+
+            Integer dailyLimit = null;
+            if (dailyLimitNode != null) {
+                if (!dailyLimitNode.isIntegralNumber() || !dailyLimitNode.canConvertToInt()) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+                dailyLimit = dailyLimitNode.intValue();
+                if (dailyLimit < 0 || dailyLimit > 5000) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+            }
+            return new AccountPatch(nickname, dailyLimit);
+        }
+    }
