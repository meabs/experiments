+    @Transactional
+    public Account update(Long accountId, String nickname, Integer dailyLimit, boolean nicknameRequested,
+                          boolean dailyLimitRequested) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Closed accounts cannot be changed");
+        }
+
+        boolean admin = access.isTenantAdmin(user, account.getTenantId());
+        boolean owner = access.ownsAccount(user, account);
+        if (!admin && (!owner || dailyLimitRequested)) {
+            throw new ForbiddenException("You may not change these account settings");
+        }
+
+        if (nicknameRequested) {
+            account.setNickname(nickname);
+        }
+        if (dailyLimitRequested) {
+            account.setDailyLimit(dailyLimit);
+        }
+        return account;
+    }
