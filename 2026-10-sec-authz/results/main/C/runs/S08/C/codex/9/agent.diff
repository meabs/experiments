+    @PatchMapping("/{accountId}")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    public AccountView update(@PathVariable Long accountId, @RequestBody JsonNode body) {
+        return AccountView.of(service.update(accountId, AccountPatch.from(body)));
+    }
+
+    record AccountPatch(boolean nicknamePresent, String nickname, boolean dailyLimitPresent, int dailyLimit) {
+        static AccountPatch from(JsonNode body) {
+            if (body == null || !body.isObject()) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+
+            boolean nicknamePresent = body.has("nickname");
+            boolean dailyLimitPresent = body.has("dailyLimit");
+            if (!nicknamePresent && !dailyLimitPresent) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+
+            String nickname = null;
+            if (nicknamePresent) {
+                JsonNode value = body.get("nickname");
+                if (!value.isTextual()) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+                nickname = value.textValue().trim();
+                if (nickname.length() < 1 || nickname.length() > 40) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+            }
+
+            int dailyLimit = 0;
+            if (dailyLimitPresent) {
+                JsonNode value = body.get("dailyLimit");
+                if (!value.isIntegralNumber() || !value.canConvertToInt() || value.intValue() < 0
+                    || value.intValue() > 5000) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+                dailyLimit = value.intValue();
+            }
+            return new AccountPatch(nicknamePresent, nickname, dailyLimitPresent, dailyLimit);
+        }
+    }
+
