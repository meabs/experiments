+    private record AccountPatch(boolean nicknameIncluded, String nickname, boolean dailyLimitIncluded, int dailyLimit) {
+        static AccountPatch parse(JsonNode body) {
+            if (body == null || !body.isObject()) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+            var fields = body.fieldNames();
+            while (fields.hasNext()) {
+                String field = fields.next();
+                if (!field.equals("nickname") && !field.equals("dailyLimit")) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+            }
+
+            boolean nicknameIncluded = body.has("nickname");
+            boolean dailyLimitIncluded = body.has("dailyLimit");
+            if (!nicknameIncluded && !dailyLimitIncluded) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+
+            String nickname = null;
+            if (nicknameIncluded) {
+                JsonNode value = body.get("nickname");
+                if (!value.isTextual()) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+                nickname = value.textValue().trim();
+                if (nickname.length() < 1 || nickname.length() > 40) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+            }
+
+            int dailyLimit = 0;
+            if (dailyLimitIncluded) {
+                JsonNode value = body.get("dailyLimit");
+                if (!value.isIntegralNumber() || !value.canConvertToInt()) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+                dailyLimit = value.intValue();
+                if (dailyLimit < 0 || dailyLimit > 5000) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+            }
+            return new AccountPatch(nicknameIncluded, nickname, dailyLimitIncluded, dailyLimit);
+        }
+    }
