+
+    @Transactional
+    public Account update(Long accountId, AccountController.UpdateAccountRequest request) {
+        if (request == null || (request.nickname() == null && request.dailyLimit() == null)) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+
+        Account account = getVisible(accountId);
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+
+        CurrentUser user = users.current();
+        boolean changesNickname = request.nickname() != null;
+        boolean changesDailyLimit = request.dailyLimit() != null;
+        if ((changesNickname && !access.ownsAccount(user, account) && !access.isTenantAdmin(user, account.getTenantId()))
+            || (changesDailyLimit && !access.isTenantAdmin(user, account.getTenantId()))) {
+            throw new ForbiddenException("You may not change these account settings");
+        }
+
+        if (changesNickname) {
+            account.setNickname(parseNickname(request.nickname()));
+        }
+        if (changesDailyLimit) {
+            account.setDailyLimit(parseDailyLimit(request.dailyLimit()));
+        }
+        return account;
+    }
+
+    private static String parseNickname(JsonNode value) {
+        if (!value.isTextual()) {
+            throw new IllegalArgumentException("Invalid nickname");
+        }
+        String nickname = value.textValue().trim();
+        if (nickname.isEmpty() || nickname.length() > 40) {
+            throw new IllegalArgumentException("Invalid nickname");
+        }
+        return nickname;
+    }
+
+    private static int parseDailyLimit(JsonNode value) {
+        if (!value.isIntegralNumber() || !value.canConvertToInt()) {
+            throw new IllegalArgumentException("Invalid daily limit");
+        }
+        int dailyLimit = value.intValue();
+        if (dailyLimit < 0 || dailyLimit > 5000) {
+            throw new IllegalArgumentException("Invalid daily limit");
+        }
+        return dailyLimit;
+    }
 }
