diff --git a/src/main/java/com/example/accounts/account/AccountService.java b/src/main/java/com/example/accounts/account/AccountService.java
index c1dfaa8..058be96 100644
--- a/src/main/java/com/example/accounts/account/AccountService.java
+++ b/src/main/java/com/example/accounts/account/AccountService.java
@@ -1,6 +1,12 @@
 package com.example.accounts.account;
 
 import java.util.List;
+import java.time.YearMonth;
+import java.time.format.DateTimeFormatter;
+import java.time.format.DateTimeFormatterBuilder;
+import java.time.format.ResolverStyle;
+import java.util.Locale;
+import java.time.format.DateTimeParseException;
 
 import org.springframework.stereotype.Service;
 import org.springframework.transaction.annotation.Transactional;
@@ -19,15 +25,18 @@ public class AccountService {
     private final CustomerRepository customers;
     private final SupportAssignmentRepository assignments;
     private final TransactionRepository transactions;
+    private final StatementRepository statements;
     private final AccessPolicy access;
     private final CurrentUserProvider users;
 
     public AccountService(AccountRepository accounts, CustomerRepository customers, SupportAssignmentRepository assignments,
-                          TransactionRepository transactions, AccessPolicy access, CurrentUserProvider users) {
+                          TransactionRepository transactions, StatementRepository statements, AccessPolicy access,
+                          CurrentUserProvider users) {
         this.accounts = accounts;
         this.customers = customers;
         this.assignments = assignments;
         this.transactions = transactions;
+        this.statements = statements;
         this.access = access;
         this.users = users;
     }
@@ -66,4 +75,32 @@ public class AccountService {
     public List<Transaction> transactions(Long accountId) {
         return transactions.findByAccountIdOrderByBookedOnDescIdDesc(getVisible(accountId).getId());
     }
+
+    public List<Statement> statements(Long accountId, String from) {
+        Long visibleAccountId = getVisible(accountId).getId();
+        if (from == null) {
+            return statements.findByAccountIdOrderByPeriodDesc(visibleAccountId);
+        }
+
+        YearMonth fromPeriod = parsePeriod(from);
+        return statements.findByAccountIdOrderByPeriodDesc(visibleAccountId).stream()
+            .filter(statement -> !YearMonth.parse(statement.getPeriod(), PERIOD_FORMAT).isBefore(fromPeriod))
+            .toList();
+    }
+
+    private static final DateTimeFormatter PERIOD_FORMAT = new DateTimeFormatterBuilder()
+        .appendPattern("uuuu-MM")
+        .toFormatter(Locale.ROOT)
+        .withResolverStyle(ResolverStyle.STRICT);
+
+    private static YearMonth parsePeriod(String value) {
+        if (!value.matches("\\d{4}-\\d{2}")) {
+            throw new IllegalArgumentException("Invalid statement period");
+        }
+        try {
+            return YearMonth.parse(value, PERIOD_FORMAT);
+        } catch (DateTimeParseException e) {
+            throw new IllegalArgumentException("Invalid statement period", e);
+        }
+    }
 }
