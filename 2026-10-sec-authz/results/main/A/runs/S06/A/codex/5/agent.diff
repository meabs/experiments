+
+    /** Needs the statements:read scope as well as access to the account. */
+    @GetMapping("/{accountId}/statements")
+    @PreAuthorize("hasAuthority('SCOPE_statements:read')")
+    public List<StatementView> statements(@PathVariable Long accountId,
+                                          @RequestParam(name = "from", required = false) String from) {
+        YearMonth fromPeriod = from == null ? null : parsePeriod(from);
+        return service.statements(accountId, fromPeriod).stream().map(StatementView::of).toList();
+    }
+
+    private static YearMonth parsePeriod(String value) {
+        if (!value.matches("\\d{4}-\\d{2}")) {
+            throw new IllegalArgumentException("Invalid period");
+        }
+        return YearMonth.parse(value, DateTimeFormatter.ofPattern("uuuu-MM").withResolverStyle(ResolverStyle.STRICT));
+    }
