+
+    public List<Statement> statements(Long accountId, String from) {
+        Long visibleAccountId = getVisible(accountId).getId();
+        String minimumPeriod = validPeriodOrNull(from);
+        return statements.findByAccountIdOrderByPeriodDesc(visibleAccountId).stream()
+            .filter(statement -> minimumPeriod == null || statement.getPeriod().compareTo(minimumPeriod) >= 0)
+            .toList();
+    }
+
+    private static String validPeriodOrNull(String from) {
+        if (from == null) {
+            return null;
+        }
+        if (!from.matches("\\d{4}-\\d{2}")) {
+            throw new IllegalArgumentException("Invalid statement period");
+        }
+        try {
+            YearMonth.parse(from, DateTimeFormatter.ofPattern("uuuu-MM"));
+            return from;
+        } catch (DateTimeParseException e) {
+            throw new IllegalArgumentException("Invalid statement period", e);
+        }
+    }
 }
