+
+    /** Needs the statements:read scope as well as access to the account. */
+    @GetMapping("/{accountId}/statements")
+    @PreAuthorize("hasAuthority('SCOPE_statements:read')")
+    public List<StatementView> statements(@PathVariable Long accountId,
+                                           @RequestParam(required = false) String from) {
+        validatePeriod(from);
+        return service.statements(accountId, from).stream().map(StatementView::of).toList();
+    }
+
+    private static void validatePeriod(String period) {
+        if (period == null) {
+            return;
+        }
+        try {
+            if (!period.matches("\\d{4}-\\d{2}")) {
+                throw new DateTimeParseException("Invalid period", period, 0);
+            }
+            YearMonth.parse(period, DateTimeFormatter.ofPattern("uuuu-MM").withResolverStyle(ResolverStyle.STRICT));
+        } catch (DateTimeParseException e) {
+            throw new IllegalArgumentException("Invalid period");
+        }
+    }
 }
