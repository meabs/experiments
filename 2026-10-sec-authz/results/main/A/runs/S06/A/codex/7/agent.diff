+
+    public List<Statement> statements(Long accountId, String from) {
+        if (from != null && !PERIOD.matcher(from).matches()) {
+            throw new IllegalArgumentException("Invalid statement period");
+        }
+        Long visibleAccountId = getVisible(accountId).getId();
+        return from == null
+            ? statements.findByAccountIdOrderByPeriodDesc(visibleAccountId)
+            : statements.findByAccountIdAndPeriodGreaterThanEqualOrderByPeriodDesc(visibleAccountId, from);
+    }
+
+    private static final Pattern PERIOD = Pattern.compile("\\d{4}-(0[1-9]|1[0-2])");
 }
