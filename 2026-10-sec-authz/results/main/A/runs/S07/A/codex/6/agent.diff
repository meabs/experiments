+package com.example.accounts.customer;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.List;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.account.Account;
+import com.example.accounts.account.AccountNote;
+import com.example.accounts.account.AccountNoteRepository;
+import com.example.accounts.account.AccountRepository;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.NotFoundException;
+
+/** Customer data exports for the customer or an admin of the customer's tenant. */
+@RestController
+@RequestMapping("/api/customers")
+public class CustomerExportController {
+
+    public record ExportDocument(Object customer, List<AccountExport> accounts, List<NoteExport> notes) {
+    }
+
+    public record CustomerExport(String id, String name, String email, String phone, String address) {
+        static CustomerExport of(Customer c) {
+            return new CustomerExport(c.getId(), c.getName(), c.getEmail(), c.getPhone(), c.getAddress());
+        }
+    }
+
+    public record AdminCustomerExport(String id, String name, String email, String phone, String address, int riskScore) {
+        static AdminCustomerExport of(Customer c) {
+            return new AdminCustomerExport(c.getId(), c.getName(), c.getEmail(), c.getPhone(), c.getAddress(), c.getRiskScore());
+        }
+    }
+
+    public record AccountExport(Long id, String nickname, String type, BigDecimal balance, String status) {
+        static AccountExport of(Account a) {
+            return new AccountExport(a.getId(), a.getNickname(), a.getType(), a.getBalance(), a.getStatus().name());
+        }
+    }
+
+    public record NoteExport(Long accountId, String body, boolean internal, Instant createdAt) {
+        static NoteExport of(AccountNote n) {
+            return new NoteExport(n.getAccountId(), n.getBody(), n.isInternal(), n.getCreatedAt());
+        }
+    }
+
+    private final CustomerRepository customers;
+    private final AccountRepository accounts;
+    private final AccountNoteRepository notes;
+    private final CurrentUserProvider users;
+
+    public CustomerExportController(CustomerRepository customers, AccountRepository accounts, AccountNoteRepository notes,
+                                    CurrentUserProvider users) {
+        this.customers = customers;
+        this.accounts = accounts;
+        this.notes = notes;
+        this.users = users;
+    }
+
+    @GetMapping("/{customerId}/export")
+    @PreAuthorize("hasAnyRole('CUSTOMER', 'ADMIN')")
+    @Transactional(readOnly = true)
+    public ExportDocument export(@PathVariable String customerId) {
+        CurrentUser user = users.current();
+        Customer customer = customers.findByIdAndTenantId(customerId, user.tenantId())
+            .filter(c -> user.isAdmin() || user.id().equals(c.getUserId()))
+            .orElseThrow(() -> new NotFoundException("Customer not found"));
+
+        boolean admin = user.isAdmin();
+        List<Account> customerAccounts = accounts.findByTenantIdAndCustomerIdOrderById(user.tenantId(), customer.getId());
+        List<NoteExport> customerNotes = customerAccounts.stream()
+            .flatMap(account -> notes.findByAccountIdOrderByCreatedAtDesc(account.getId()).stream())
+            .filter(note -> admin || !note.isInternal())
+            .map(NoteExport::of)
+            .toList();
+
+        Object customerView = admin ? AdminCustomerExport.of(customer) : CustomerExport.of(customer);
+        return new ExportDocument(customerView, customerAccounts.stream().map(AccountExport::of).toList(), customerNotes);
+    }
+}
diff --git a/src/test/java/com/example/accounts/CustomerExportApiTest.java b/src/test/java/com/example/accounts/CustomerExportApiTest.java
