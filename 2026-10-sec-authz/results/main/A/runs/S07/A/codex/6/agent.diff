+package com.example.accounts;
+
+import static com.example.accounts.support.TestUsers.*;
+import static org.hamcrest.Matchers.containsInAnyOrder;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.junit.jupiter.api.Test;
+
+import com.example.accounts.support.ApiTest;
+
+class CustomerExportApiTest extends ApiTest {
+
+    @Test
+    void customerGetsTheirExportWithoutStaffOnlyData() throws Exception {
+        getAs(ALICE, "/api/customers/c-1/export").andExpect(status().isOk())
+            .andExpect(jsonPath("$.customer.id").value("c-1"))
+            .andExpect(jsonPath("$.customer.riskScore").doesNotExist())
+            .andExpect(jsonPath("$.accounts[*].id", containsInAnyOrder(1, 2)))
+            .andExpect(jsonPath("$.notes[*].internal").value(containsInAnyOrder(false, false, false)))
+            .andExpect(jsonPath("$.notes[*].body").value(containsInAnyOrder(
+                "Welcome pack sent.", "New debit card posted.", "Customer asked about fixed-rate savings.")));
+    }
+
+    @Test
+    void adminGetsRiskScoreAndInternalNotes() throws Exception {
+        getAs(ADA, "/api/customers/c-1/export").andExpect(status().isOk())
+            .andExpect(jsonPath("$.customer.riskScore").value(12))
+            .andExpect(jsonPath("$.notes[*].internal", containsInAnyOrder(true, false, false, false)))
+            .andExpect(jsonPath("$.notes[*].body", containsInAnyOrder(
+                "Welcome pack sent.", "Fraud alert on card ending 4417; identity verified by phone.",
+                "New debit card posted.", "Customer asked about fixed-rate savings.")));
+    }
+
+    @Test
+    void exportRespectsCustomerAndTenantBoundaries() throws Exception {
+        getAs(BOB, "/api/customers/c-1/export").andExpect(status().isNotFound());
+        getAs(GIL, "/api/customers/c-1/export").andExpect(status().isNotFound());
+    }
+
+    @Test
+    void exportIsRestrictedToCustomersAndAdmins() throws Exception {
+        getAs(SAM, "/api/customers/c-1/export").andExpect(status().isForbidden());
+        getAnonymous("/api/customers/c-1/export").andExpect(status().isUnauthorized());
+    }
+}
