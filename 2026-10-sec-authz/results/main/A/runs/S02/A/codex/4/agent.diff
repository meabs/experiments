+package com.example.accounts.customer;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.Email;
+import jakarta.validation.constraints.NotBlank;
+import jakarta.validation.constraints.Pattern;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.security.AccessPolicy;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.ForbiddenException;
+import com.example.accounts.web.NotFoundException;
+
+/** Customer self-service and tenant-admin updates to customer contact details. */
+@RestController
+@RequestMapping("/api/customers")
+public class CustomerController {
+
+    private static final String PHONE = "(?=.{7,20}$)(?=.*[0-9])\\+?[0-9 ]+";
+
+    public record ContactUpdate(
+        @NotBlank @Email String email,
+        @NotBlank @Pattern(regexp = PHONE) String phone) {
+    }
+
+    public record ContactView(String id, String email, String phone) {
+        static ContactView of(Customer customer) {
+            return new ContactView(customer.getId(), customer.getEmail(), customer.getPhone());
+        }
+    }
+
+    private final CustomerRepository customers;
+    private final CurrentUserProvider users;
+    private final AccessPolicy access;
+
+    public CustomerController(CustomerRepository customers, CurrentUserProvider users, AccessPolicy access) {
+        this.customers = customers;
+        this.users = users;
+        this.access = access;
+    }
+
+    @PutMapping("/{customerId}/contact")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    public ContactView updateContact(@PathVariable String customerId, @Valid @RequestBody ContactUpdate request) {
+        CurrentUser user = users.current();
+        Customer customer = customers.findByIdAndTenantId(customerId, user.tenantId())
+            .orElseThrow(() -> new NotFoundException("Customer not found"));
+
+        if (!access.isSelf(user, customer) && !access.isTenantAdmin(user, customer.getTenantId())) {
+            throw new ForbiddenException("Not allowed to update this customer");
+        }
+
+        customer.setEmail(request.email());
+        customer.setPhone(request.phone());
+        customers.save(customer);
+        return ContactView.of(customer);
+    }
+}
