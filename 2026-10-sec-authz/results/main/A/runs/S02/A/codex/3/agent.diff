@@ -0,0 +1,42 @@
+package com.example.accounts;
+
+import static com.example.accounts.support.TestUsers.ADA;
+import static com.example.accounts.support.TestUsers.ALICE;
+import static com.example.accounts.support.TestUsers.SAM;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.junit.jupiter.api.Test;
+
+import com.example.accounts.support.ApiTest;
+
+class CustomerApiTest extends ApiTest {
+
+    @Test
+    void customerUpdatesTheirContactDetails() throws Exception {
+        putAs(ALICE, "/api/customers/c-1/contact", "{\"email\":\"new@example.test\",\"phone\":\"+44 1234567\"}")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$.id").value("c-1"))
+            .andExpect(jsonPath("$.email").value("new@example.test"))
+            .andExpect(jsonPath("$.phone").value("+44 1234567"));
+    }
+
+    @Test
+    void adminUpdatesCustomerInTheirTenant() throws Exception {
+        putAs(ADA, "/api/customers/c-2/contact", "{\"email\":\"corrected@example.test\",\"phone\":\"01632 960999\"}")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$.id").value("c-2"));
+    }
+
+    @Test
+    void invalidContactDetailsAreRejected() throws Exception {
+        putAs(ALICE, "/api/customers/c-1/contact", "{\"email\":\"not-an-email\",\"phone\":\"123-456\"}")
+            .andExpect(status().isBadRequest());
+    }
+
+    @Test
+    void supportCannotUpdateContactDetails() throws Exception {
+        putAs(SAM, "/api/customers/c-1/contact", "{\"email\":\"new@example.test\",\"phone\":\"01632 960111\"}")
+            .andExpect(status().isForbidden());
+    }
+}
