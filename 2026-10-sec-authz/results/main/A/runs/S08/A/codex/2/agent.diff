 @Service
@@ -66,4 +68,28 @@ public class AccountService {
     public List<Transaction> transactions(Long accountId) {
         return transactions.findByAccountIdOrderByBookedOnDescIdDesc(getVisible(accountId).getId());
     }
+
+    @Transactional
+    public Account update(Long accountId, String nickname, Integer dailyLimit, boolean nicknamePresent,
+                          boolean dailyLimitPresent) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+
+        boolean mayRename = nicknamePresent && access.ownsAccount(user, account);
+        boolean mayChangeLimit = dailyLimitPresent && access.isTenantAdmin(user, account.getTenantId());
+        if ((nicknamePresent && !mayRename) || (dailyLimitPresent && !mayChangeLimit)) {
+            throw new ForbiddenException("You may not change these account settings");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Closed accounts cannot be changed");
+        }
+
+        if (nicknamePresent) {
+            account.setNickname(nickname);
+        }
+        if (dailyLimitPresent) {
+            account.setDailyLimit(dailyLimit);
+        }
+        return account;
+    }
 }
