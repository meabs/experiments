+++ b/src/main/java/com/example/accounts/account/AccountController.java
@@ -4,9 +4,12 @@ import java.math.BigDecimal;
 import java.time.LocalDate;
 import java.util.List;
 
+import com.fasterxml.jackson.databind.JsonNode;
 import org.springframework.security.access.prepost.PreAuthorize;
 import org.springframework.web.bind.annotation.GetMapping;
 import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PatchMapping;
+import org.springframework.web.bind.annotation.RequestBody;
 import org.springframework.web.bind.annotation.RequestMapping;
 import org.springframework.web.bind.annotation.RestController;
 
@@ -44,10 +47,64 @@ public class AccountController {
         return AccountView.of(service.getVisible(accountId));
     }
 
+    @PatchMapping("/{accountId}")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    public AccountView update(@PathVariable Long accountId, @RequestBody JsonNode body) {
+        Patch patch = Patch.parse(body);
+        return AccountView.of(service.update(accountId, patch.nickname(), patch.dailyLimit(),
+            patch.nicknamePresent(), patch.dailyLimitPresent()));
+    }
+
     /** Needs the transactions:read scope as well as access to the account. */
     @GetMapping("/{accountId}/transactions")
     @PreAuthorize("hasAuthority('SCOPE_transactions:read')")
     public List<TransactionView> transactions(@PathVariable Long accountId) {
         return service.transactions(accountId).stream().map(TransactionView::of).toList();
     }
+
+    private record Patch(String nickname, Integer dailyLimit, boolean nicknamePresent, boolean dailyLimitPresent) {
+
+        static Patch parse(JsonNode body) {
+            if (body == null || !body.isObject()) {
+                throw new IllegalArgumentException("Request body must be an object");
+            }
+            boolean hasNickname = body.has("nickname");
+            boolean hasDailyLimit = body.has("dailyLimit");
+            if (!hasNickname && !hasDailyLimit) {
+                throw new IllegalArgumentException("At least one account setting is required");
+            }
+            if (body.fieldNames().hasNext()) {
+                var fields = body.fieldNames();
+                while (fields.hasNext()) {
+                    String field = fields.next();
+                    if (!field.equals("nickname") && !field.equals("dailyLimit")) {
+                        throw new IllegalArgumentException("Unknown account setting");
+                    }
+                }
+            }
+
+            String nickname = null;
+            if (hasNickname) {
+                JsonNode value = body.get("nickname");
+                if (!value.isTextual()) {
+                    throw new IllegalArgumentException("Invalid nickname");
+                }
+                nickname = value.textValue().strip();
+                if (nickname.isEmpty() || nickname.length() > 40) {
+                    throw new IllegalArgumentException("Invalid nickname");
+                }
+            }
+
+            Integer dailyLimit = null;
+            if (hasDailyLimit) {
+                JsonNode value = body.get("dailyLimit");
+                if (!value.isIntegralNumber() || !value.canConvertToInt()
+                    || value.intValue() < 0 || value.intValue() > 5000) {
+                    throw new IllegalArgumentException("Invalid daily limit");
+                }
+                dailyLimit = value.intValue();
+            }
+            return new Patch(nickname, dailyLimit, hasNickname, hasDailyLimit);
+        }
+    }
 }
