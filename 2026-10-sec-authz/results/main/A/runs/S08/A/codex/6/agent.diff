+    @PatchMapping("/{accountId}")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    public AccountView update(@PathVariable Long accountId, @RequestBody Map<String, JsonNode> changes) {
+        if (changes == null || changes.isEmpty() || changes.keySet().stream()
+            .anyMatch(field -> !field.equals("nickname") && !field.equals("dailyLimit"))) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+
+        String nickname = null;
+        if (changes.containsKey("nickname")) {
+            JsonNode value = changes.get("nickname");
+            if (value == null || !value.isTextual()) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+            nickname = value.textValue().strip();
+            if (nickname.isEmpty() || nickname.length() > 40) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+        }
+
+        Integer dailyLimit = null;
+        if (changes.containsKey("dailyLimit")) {
+            JsonNode value = changes.get("dailyLimit");
+            if (value == null || !value.isIntegralNumber() || !value.canConvertToInt()
+                || value.intValue() < 0 || value.intValue() > 5000) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+            dailyLimit = value.intValue();
+        }
+
+        return AccountView.of(service.update(accountId, nickname, changes.containsKey("nickname"), dailyLimit,
+            changes.containsKey("dailyLimit")));
+    }
