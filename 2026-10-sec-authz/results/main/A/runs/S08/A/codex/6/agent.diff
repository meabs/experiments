+
+    @Transactional
+    public Account update(Long accountId, String nickname, boolean changeNickname, Integer dailyLimit,
+                          boolean changeDailyLimit) {
+        Account account = getVisible(accountId);
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Closed accounts cannot be changed");
+        }
+
+        CurrentUser user = users.current();
+        if ((changeNickname && !access.ownsAccount(user, account))
+            || (changeDailyLimit && !access.isTenantAdmin(user, account.getTenantId()))) {
+            throw new ForbiddenException("You may not change these account settings");
+        }
+
+        if (changeNickname) {
+            account.setNickname(nickname);
+        }
+        if (changeDailyLimit) {
+            account.setDailyLimit(dailyLimit);
+        }
+        return account;
+    }
