+    @PatchMapping("/{accountId}")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    public AccountView update(@PathVariable Long accountId, @RequestBody AccountPatch patch) {
+        if (patch == null) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        patch.validate();
+        var account = service.getVisible(accountId);
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+
+        CurrentUser user = users.current();
+        boolean mayRename = patch.isNicknamePresent() && access.ownsAccount(user, account)
+            && !patch.isDailyLimitPresent();
+        boolean mayChangeLimit = patch.isDailyLimitPresent() && access.isTenantAdmin(user, account.getTenantId())
+            && !patch.isNicknamePresent();
+        if (!mayRename && !mayChangeLimit) {
+            throw new ForbiddenException("You may not change these account settings");
+        }
+
+        return AccountView.of(service.update(account.getId(), patch.getNickname(), patch.getDailyLimit()));
+    }
