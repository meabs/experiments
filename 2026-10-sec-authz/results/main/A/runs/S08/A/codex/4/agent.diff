+    @Transactional
+    public Account update(Long accountId, String nickname, boolean changeNickname, Integer dailyLimit,
+                          boolean changeDailyLimit) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+
+        boolean mayChangeNickname = !changeNickname || access.ownsAccount(user, account);
+        boolean mayChangeDailyLimit = !changeDailyLimit || access.isTenantAdmin(user, account.getTenantId());
+        if (!mayChangeNickname || !mayChangeDailyLimit) {
+            throw new ForbiddenException("You may not change this account field");
+        }
+
+        if (changeNickname) {
+            account.setNickname(nickname);
+        }
+        if (changeDailyLimit) {
+            account.setDailyLimit(dailyLimit);
+        }
+        return account;
+    }
