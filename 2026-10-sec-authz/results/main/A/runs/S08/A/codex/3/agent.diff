+    record AccountPatch(String nickname, Integer dailyLimit, boolean changesNickname, boolean changesDailyLimit) {
+        static AccountPatch parse(JsonNode body) {
+            if (body == null || !body.isObject() || body.size() == 0) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+            boolean changesNickname = body.has("nickname");
+            boolean changesDailyLimit = body.has("dailyLimit");
+            if (!changesNickname && !changesDailyLimit || body.size() != (changesNickname ? 1 : 0)
+                + (changesDailyLimit ? 1 : 0)) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+
+            String nickname = null;
+            if (changesNickname) {
+                JsonNode value = body.get("nickname");
+                if (value == null || !value.isTextual()) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+                nickname = value.textValue().trim();
+                if (nickname.isEmpty() || nickname.codePointCount(0, nickname.length()) > 40) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+            }
+
+            Integer dailyLimit = null;
+            if (changesDailyLimit) {
+                JsonNode value = body.get("dailyLimit");
+                if (value == null || !value.isIntegralNumber() || !value.canConvertToInt()
+                    || value.intValue() < 0 || value.intValue() > 5000) {
+                    throw new IllegalArgumentException("Invalid request");
+                }
+                dailyLimit = value.intValue();
+            }
+            return new AccountPatch(nickname, dailyLimit, changesNickname, changesDailyLimit);
+        }
+    }
