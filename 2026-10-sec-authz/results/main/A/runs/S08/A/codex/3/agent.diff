+    public Account update(Long accountId, AccountController.AccountPatch patch) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        boolean mayChangeNickname = patch.changesNickname() && access.ownsAccount(user, account);
+        boolean mayChangeDailyLimit = patch.changesDailyLimit() && access.isTenantAdmin(user, account.getTenantId());
+        if ((patch.changesNickname() && !mayChangeNickname)
+            || (patch.changesDailyLimit() && !mayChangeDailyLimit)) {
+            throw new ForbiddenException("You may not change these account settings");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+        if (patch.changesNickname()) {
+            account.setNickname(patch.nickname());
+        }
