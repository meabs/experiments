+package com.example.accounts.cases;
+
+import java.time.Instant;
+import java.util.List;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.security.AccessPolicy;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.NotFoundException;
+
+/** Back-office view of a case for its assigned support user or a tenant admin. */
+@RestController
+@RequestMapping("/api/support/cases")
+public class StaffCaseController {
+
+    public record CaseCommentView(String author, String body, boolean internal, Instant createdAt) {
+        static CaseCommentView of(CaseComment comment) {
+            return new CaseCommentView(comment.getAuthor(), comment.getBody(), comment.isInternal(), comment.getCreatedAt());
+        }
+    }
+
+    public record StaffCaseView(String id, Long accountId, String customerId, String subject, String status,
+                                String assigneeUserId, List<CaseCommentView> comments) {
+        static StaffCaseView of(SupportCase supportCase, List<CaseComment> comments) {
+            return new StaffCaseView(supportCase.getId(), supportCase.getAccountId(), supportCase.getCustomerId(),
+                supportCase.getSubject(), supportCase.getStatus(), supportCase.getAssigneeUserId(),
+                comments.stream().map(CaseCommentView::of).toList());
+        }
+    }
+
+    private final SupportCaseRepository cases;
+    private final CaseCommentRepository comments;
+    private final AccessPolicy access;
+    private final CurrentUserProvider users;
+
+    public StaffCaseController(SupportCaseRepository cases, CaseCommentRepository comments, AccessPolicy access,
+                               CurrentUserProvider users) {
+        this.cases = cases;
+        this.comments = comments;
+        this.access = access;
+        this.users = users;
+    }
+
+    @GetMapping("/{caseId}")
+    @Transactional(readOnly = true)
+    @PreAuthorize("hasAnyRole('SUPPORT', 'ADMIN')")
+    public StaffCaseView get(@PathVariable String caseId) {
+        CurrentUser user = users.current();
+        SupportCase supportCase = cases.findById(caseId)
+            .filter(found -> access.canViewCase(user, found))
+            .orElseThrow(() -> new NotFoundException("Case not found"));
+        return StaffCaseView.of(supportCase, comments.findByCaseIdOrderByCreatedAtAsc(caseId));
+    }
+}
