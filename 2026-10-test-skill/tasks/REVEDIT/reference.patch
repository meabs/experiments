+	@Override
+	public ProductReview getById(Long id) {
+		return productReviewRepository.findById(id).orElse(null);
+	}
+
+	@Override
+	public void delete(ProductReview review) throws ServiceException {
+		Long productId = review.getProduct().getId();
+		super.delete(review);
+		refreshRating(productService.getById(productId));
+	}
+
+	/** Recomputes the product's average rating and review count from its current reviews. */
+	private void refreshRating(Product product) throws ServiceException {
+		List<ProductReview> reviews = productReviewRepository.findByProduct(product.getId());
+		double sum = 0;
+		for (ProductReview r : reviews) {
+			sum += r.getReviewRating();
+		}
+		product.setProductReviewCount(reviews.size());
+		product.setProductReviewAvg(new BigDecimal(reviews.isEmpty() ? 0 : sum / reviews.size()));
+		productService.update(product);
+	}
+
