+    public ResponseEntity<ErrorEntity> handleRestApiException(RestApiException exception) {
+        log.error(exception.getErrorMessage(), exception);
+
+        ErrorEntity errorEntity = createErrorEntity(exception.getErrorCode(), exception.getErrorMessage(),
+                exception.getLocalizedMessage());
+        HttpStatus status = HttpStatus.BAD_REQUEST;
+        if (exception.getErrorCode() != null) {
+            try {
+                status = HttpStatus.valueOf(Integer.parseInt(exception.getErrorCode()));
+            } catch (IllegalArgumentException ignored) {
+                // Keep the API's default bad-request status for non-HTTP error codes.
+            }
+        }
+        return ResponseEntity.status(status).body(errorEntity);
+    }
 
