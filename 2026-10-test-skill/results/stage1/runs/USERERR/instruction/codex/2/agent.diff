+      user.setLastName("User");
+      user.setDefaultLanguage("en");
+      user.setPassword(CREATED_PASSWORD);
+      user.setRepeatPassword(CREATED_PASSWORD);
+      PersistableGroup group = new PersistableGroup();
+      group.setName("ADMIN");
+      user.getGroups().add(group);
+      return user;
+  }
   
 
 
