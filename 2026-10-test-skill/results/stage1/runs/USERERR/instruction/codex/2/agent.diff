+  @Test
+  public void invalidUserRequestsReturnClientErrors() {
+      final long missingId = Long.MAX_VALUE;
+
+      ResponseEntity<Void> missingUpdate = testRestTemplate.exchange(
+          "/api/v1/private/user/" + missingId, HttpMethod.PUT,
+          new HttpEntity<>(existingUser("missing-user"), getHeader()), Void.class);
+      assertEquals(HttpStatus.NOT_FOUND, missingUpdate.getStatusCode());
+
+      UserPassword password = new UserPassword();
+      password.setPassword("wrong-current-password");
+      password.setChangePassword("Password3");
+      ResponseEntity<Void> missingPassword = testRestTemplate.exchange(
+          "/api/v1/private/user/" + missingId + "/password", HttpMethod.PATCH,
+          new HttpEntity<>(password, getHeader()), Void.class);
+      assertEquals(HttpStatus.NOT_FOUND, missingPassword.getStatusCode());
+
+      ResponseEntity<Void> duplicate = testRestTemplate.exchange(
+          "/api/v1/private/user/", HttpMethod.POST,
+          new HttpEntity<>(existingUser("admin@shopizer.com"), getHeader()), Void.class);
+      assertEquals(HttpStatus.CONFLICT, duplicate.getStatusCode());
+
+      UserPassword wrongPassword = new UserPassword();
+      wrongPassword.setPassword("wrong-current-password");
+      wrongPassword.setChangePassword("Password3");
+      ResponseEntity<Void> wrongPasswordResponse = testRestTemplate.exchange(
+          "/api/v1/private/user/" + DEFAULT_USER_ID + "/password", HttpMethod.PATCH,
+          new HttpEntity<>(wrongPassword, getHeader()), Void.class);
+      assertEquals(HttpStatus.BAD_REQUEST, wrongPasswordResponse.getStatusCode());
+  }
+
+  private PersistableUser existingUser(String userName) {
+      PersistableUser user = new PersistableUser();
