+package com.salesmanager.test.shop.integration.product;
+
+import static org.mockito.ArgumentMatchers.isNull;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.ArgumentMatchers.nullable;
+import static org.mockito.Mockito.lenient;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import static org.mockito.Mockito.when;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.Mock;
+import org.mockito.junit.MockitoJUnitRunner;
+import org.springframework.test.util.ReflectionTestUtils;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+
+import com.salesmanager.shop.model.catalog.manufacturer.ReadableManufacturer;
+import com.salesmanager.shop.model.catalog.product.ReadableProduct;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.v1.product.ProductManufacturerApi;
+import com.salesmanager.shop.store.api.v2.product.ProductApiV2;
+import com.salesmanager.shop.store.controller.manufacturer.facade.ManufacturerFacade;
+import com.salesmanager.shop.store.controller.product.facade.ProductFacade;
+
+@RunWith(MockitoJUnitRunner.class)
+public class ProductAndManufacturerNotFoundApiTest {
+
+    private MockMvc mvc;
+    @Mock private ManufacturerFacade manufacturerFacade;
+    @Mock private ProductFacade productFacade;
+
+    @Before
+    public void setUp() {
+        ProductManufacturerApi manufacturers = new ProductManufacturerApi();
+        ReflectionTestUtils.setField(manufacturers, "manufacturerFacade", manufacturerFacade);
+        ProductApiV2 products = new ProductApiV2();
+        ReflectionTestUtils.setField(products, "productFacadeV2", productFacade);
+        mvc = MockMvcBuilders.standaloneSetup(manufacturers, products).build();
+    }
+
+    @Test
+    public void missingItemsAreNotFoundAndExistingItemsRemainOk() throws Exception {
+        lenient().when(manufacturerFacade.getManufacturer(eq(404L), isNull(), isNull()))
+                .thenThrow(new ResourceNotFoundException("missing manufacturer"));
+        lenient().when(productFacade.getProductByCode(nullable(MerchantStore.class), eq("missing"), nullable(Language.class)))
+                .thenThrow(new ResourceNotFoundException("missing product"));
+        lenient().when(manufacturerFacade.getManufacturer(eq(1L), nullable(MerchantStore.class), nullable(Language.class)))
+                .thenReturn(new ReadableManufacturer());
+        lenient().when(productFacade.getProductByCode(nullable(MerchantStore.class), eq("present"), nullable(Language.class)))
+                .thenReturn(new ReadableProduct());
+
+        mvc.perform(get("/api/v1/manufacturer/404")).andExpect(status().isNotFound());
+        mvc.perform(get("/api/v2/product/missing")).andExpect(status().isNotFound());
+        mvc.perform(get("/api/v1/manufacturer/1")).andExpect(status().isOk());
+        mvc.perform(get("/api/v2/product/present")).andExpect(status().isOk());
+    }
+}
