@@ -0,0 +1,43 @@
+package com.salesmanager.test.shop.integration.product;
+
+import static org.hamcrest.CoreMatchers.is;
+import static org.junit.Assert.assertThat;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.boot.test.web.client.TestRestTemplate;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import javax.inject.Inject;
+
+import com.salesmanager.shop.application.ShopApplication;
+
+@RunWith(SpringRunner.class)
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+public class StorefrontMissingItemApiIntegrationTest {
+
+    @Inject
+    private TestRestTemplate testRestTemplate;
+
+    @Test
+    public void missingStorefrontItemsReturnNotFound() {
+        HttpEntity<Void> request = new HttpEntity<>(new HttpHeaders());
+
+        ResponseEntity<String> manufacturer = testRestTemplate.exchange(
+                "/api/v1/manufacturer/9223372036854775807", HttpMethod.GET, request, String.class);
+        ResponseEntity<String> product = testRestTemplate.exchange(
+                "/api/v2/product/DOES-NOT-EXIST", HttpMethod.GET, request, String.class);
+
+        assertThat(manufacturer.getStatusCode(), is(HttpStatus.NOT_FOUND));
+        assertThat(manufacturer.getBody() != null, is(true));
+        assertThat(product.getStatusCode(), is(HttpStatus.NOT_FOUND));
+        assertThat(product.getBody() != null, is(true));
+    }
+}
