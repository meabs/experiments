+package com.salesmanager.test.shop.integration.content;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@RunWith(SpringRunner.class)
+public class ContentListApiIntegrationTest extends ServicesTestSupport {
+
+	@Test
+	public void listsPagesAndBoxesWithoutPaginationParameters() {
+		String page = "{\"code\":\"api-page\",\"name\":\"API page\",\"visible\":true,\"descriptions\":[{\"language\":\"en\",\"name\":\"API page\",\"description\":\"Page\",\"friendlyUrl\":\"api-page\"}]}";
+		String box = "{\"code\":\"api-box\",\"name\":\"API box\",\"visible\":true,\"descriptions\":[{\"language\":\"en\",\"name\":\"API box\",\"description\":\"Box\",\"friendlyUrl\":\"api-box\"}]}";
+		assertEquals(HttpStatus.CREATED, testRestTemplate.postForEntity("/api/v1/private/content/page", new HttpEntity<>(page, getHeader()), String.class).getStatusCode());
+		assertEquals(HttpStatus.CREATED, testRestTemplate.postForEntity("/api/v1/private/content/box", new HttpEntity<>(box, getHeader()), String.class).getStatusCode());
+
+		ResponseEntity<String> pages = testRestTemplate.exchange("/api/v1/content/pages?store=DEFAULT&lang=en", HttpMethod.GET, new HttpEntity<>(getHeader()), String.class);
+		ResponseEntity<String> boxes = testRestTemplate.exchange("/api/v1/content/boxes?store=DEFAULT&lang=en", HttpMethod.GET, new HttpEntity<>(getHeader()), String.class);
+
+		assertEquals(HttpStatus.OK, pages.getStatusCode());
+		assertEquals(HttpStatus.OK, boxes.getStatusCode());
+		assertTrue(pages.getBody().contains("api-page"));
+		assertTrue(boxes.getBody().contains("api-box"));
+	}
+}
