+package com.salesmanager.test.shop.integration.content;
+
+import static org.hamcrest.MatcherAssert.assertThat;
+import static org.hamcrest.Matchers.greaterThanOrEqualTo;
+import static org.hamcrest.Matchers.is;
+
+import java.util.Collections;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.content.box.PersistableContentBox;
+import com.salesmanager.shop.model.content.common.ContentDescription;
+import com.salesmanager.shop.model.content.page.PersistableContentPage;
+import com.salesmanager.shop.model.entity.Entity;
+import com.salesmanager.shop.model.entity.ReadableEntityList;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class ContentListApiIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void listsPagesAndBoxesThroughClientApi() {
+        String suffix = String.valueOf(System.nanoTime());
+        HttpEntity<PersistableContentPage> pageRequest = new HttpEntity<>(page("api-page-" + suffix), getHeader());
+        ResponseEntity<Entity> pageCreated = testRestTemplate.exchange("/api/v1/private/content/page",
+                HttpMethod.POST, pageRequest, Entity.class);
+        assertThat(pageCreated.getStatusCode(), is(HttpStatus.CREATED));
+
+        HttpEntity<PersistableContentBox> boxRequest = new HttpEntity<>(box("api-box-" + suffix), getHeader());
+        ResponseEntity<Entity> boxCreated = testRestTemplate.exchange("/api/v1/private/content/box",
+                HttpMethod.POST, boxRequest, Entity.class);
+        assertThat(boxCreated.getStatusCode(), is(HttpStatus.CREATED));
+
+        HttpEntity<Void> request = new HttpEntity<>(getHeader());
+        ResponseEntity<ReadableEntityList> pages = testRestTemplate.exchange(
+                "/api/v1/content/pages?page=0&count=20", HttpMethod.GET, request, ReadableEntityList.class);
+        ResponseEntity<ReadableEntityList> boxes = testRestTemplate.exchange(
+                "/api/v1/content/boxes?page=0&count=20", HttpMethod.GET, request, ReadableEntityList.class);
+
+        assertThat(pages.getStatusCode(), is(HttpStatus.OK));
+        assertThat(pages.getBody().getItems().size(), greaterThanOrEqualTo(1));
+        assertThat(boxes.getStatusCode(), is(HttpStatus.OK));
+        assertThat(boxes.getBody().getItems().size(), greaterThanOrEqualTo(1));
+    }
+
+    private PersistableContentPage page(String code) {
+        PersistableContentPage page = new PersistableContentPage();
+        page.setCode(code);
+        page.setVisible(true);
+        page.setDescriptions(Collections.singletonList(description(code)));
+        return page;
+    }
+
+    private PersistableContentBox box(String code) {
+        PersistableContentBox box = new PersistableContentBox();
+        box.setCode(code);
+        box.setVisible(true);
+        box.setDescriptions(Collections.singletonList(description(code)));
+        return box;
+    }
+
+    private ContentDescription description(String name) {
+        ContentDescription description = new ContentDescription();
+        description.setLanguage("en");
+        description.setName(name);
+        description.setTitle(name);
+        description.setDescription(name);
+        return description;
+    }
+}
