+package com.salesmanager.test.shop.integration.content;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+import java.util.Arrays;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.content.box.PersistableContentBox;
+import com.salesmanager.shop.model.content.common.ContentDescription;
+import com.salesmanager.shop.model.content.page.PersistableContentPage;
+import com.salesmanager.shop.model.entity.Entity;
+import com.salesmanager.shop.model.entity.ReadableEntityList;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class ContentListApiIntegrationTest extends ServicesTestSupport {
+    @Test
+    public void listsPagesAndBoxesCreatedThroughAdminApi() {
+        PersistableContentPage page = new PersistableContentPage();
+        page.setCode("api-list-page"); page.setVisible(true);
+        page.setDescriptions(Arrays.asList(description("API list page")));
+        ResponseEntity<Entity> pageResponse = testRestTemplate.postForEntity(
+                "/api/v1/private/content/page?store=DEFAULT&lang=en", new HttpEntity<>(page, getHeader()), Entity.class);
+        assertEquals(HttpStatus.CREATED, pageResponse.getStatusCode());
+
+        PersistableContentBox box = new PersistableContentBox();
+        box.setCode("api-list-box"); box.setVisible(true);
+        box.setDescriptions(Arrays.asList(description("API list box")));
+        ResponseEntity<Entity> boxResponse = testRestTemplate.postForEntity(
+                "/api/v1/private/content/box?store=DEFAULT&lang=en", new HttpEntity<>(box, getHeader()), Entity.class);
+        assertEquals(HttpStatus.CREATED, boxResponse.getStatusCode());
+
+        HttpEntity<Object> request = new HttpEntity<>(getHeader());
+        ResponseEntity<ReadableEntityList> pages = testRestTemplate.exchange(
+                "/api/v1/content/pages?store=DEFAULT&lang=en&page=0&count=20", HttpMethod.GET, request, ReadableEntityList.class);
+        ResponseEntity<ReadableEntityList> boxes = testRestTemplate.exchange(
+                "/api/v1/content/boxes?store=DEFAULT&lang=en&page=0&count=20", HttpMethod.GET, request, ReadableEntityList.class);
+        assertEquals(HttpStatus.OK, pages.getStatusCode()); assertEquals(HttpStatus.OK, boxes.getStatusCode());
+        assertTrue(pages.getBody().getItems().toString().contains("api-list-page"));
+        assertTrue(boxes.getBody().getItems().toString().contains("api-list-box"));
+    }
+    private ContentDescription description(String name) {
+        ContentDescription d = new ContentDescription(); d.setLanguage("en"); d.setName(name); d.setDescription(name); return d;
+    }
+}
