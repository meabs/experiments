+package com.salesmanager.test.shop.integration.content;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.boot.test.web.client.TestRestTemplate;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class ContentApiIntegrationTest extends ServicesTestSupport {
+
+    @Autowired
+    private TestRestTemplate restTemplate;
+
+    @Test
+    public void listsContentPagesAndBoxesWithAndWithoutPagination() throws Exception {
+        HttpEntity<String> request = new HttpEntity<>(getHeader());
+        ObjectMapper mapper = new ObjectMapper();
+
+        for (String path : new String[] {"/api/v1/content/pages", "/api/v1/content/boxes"}) {
+            ResponseEntity<String> response = restTemplate.exchange(path, HttpMethod.GET, request, String.class);
+            assertEquals(HttpStatus.OK, response.getStatusCode());
+            assertNotNull(response.getBody());
+            assertNotNull(mapper.readTree(response.getBody()).get("items"));
+
+            response = restTemplate.exchange(path + "?page=0&count=10", HttpMethod.GET, request, String.class);
+            assertEquals(HttpStatus.OK, response.getStatusCode());
+            assertNotNull(response.getBody());
+            JsonNode items = mapper.readTree(response.getBody()).get("items");
+            assertNotNull(items);
+            assertTrue(items.isArray());
+        }
+    }
+}
