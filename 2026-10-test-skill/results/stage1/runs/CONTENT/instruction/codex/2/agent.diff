+package com.salesmanager.test.shop.integration.content;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+/** Exercises content lists as an HTTP client does, including omitted pagination. */
+@RunWith(SpringRunner.class)
+public class ContentListApiIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void listsPagesAndBoxesWithoutPagination() {
+        HttpEntity<String> request = new HttpEntity<>(getHeader());
+
+        ResponseEntity<String> pages = testRestTemplate.exchange(
+                "/api/v1/content/pages?store=DEFAULT&lang=en", HttpMethod.GET, request, String.class);
+        ResponseEntity<String> boxes = testRestTemplate.exchange(
+                "/api/v1/content/boxes?store=DEFAULT&lang=en", HttpMethod.GET, request, String.class);
+
+        assertEquals(200, pages.getStatusCodeValue());
+        assertEquals(200, boxes.getStatusCodeValue());
+        assertTrue(pages.getBody().contains("\"items\""));
+        assertTrue(boxes.getBody().contains("\"items\""));
+    }
+}
