+package com.salesmanager.test.shop.integration.content;
+
+import static org.hamcrest.Matchers.hasItem;
+import static org.hamcrest.Matchers.notNullValue;
+import static org.junit.Assert.assertThat;
+import static org.springframework.http.HttpStatus.CREATED;
+import static org.springframework.http.HttpStatus.OK;
+
+import java.util.Arrays;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.salesmanager.shop.model.content.common.ContentDescription;
+import com.salesmanager.shop.model.content.box.PersistableContentBox;
+import com.salesmanager.shop.model.content.page.PersistableContentPage;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@RunWith(SpringRunner.class)
+public class ContentListApiIntegrationTest extends ServicesTestSupport {
+
+    private final ObjectMapper objectMapper = new ObjectMapper();
+
+    @Test
+    public void listsPagesAndBoxesThroughPublicApi() throws Exception {
+        HttpHeaders headers = getHeader();
+
+        PersistableContentPage page = new PersistableContentPage();
+        page.setCode("api-page");
+        page.setDescriptions(Arrays.asList(description("api-page")));
+        ResponseEntity<String> pageCreated = testRestTemplate.postForEntity(
+                "/api/v1/private/content/page", new HttpEntity<>(page, headers), String.class);
+        assertThat(pageCreated.getStatusCode(), org.hamcrest.Matchers.is(CREATED));
+
+        PersistableContentBox box = new PersistableContentBox();
+        box.setCode("api-box");
+        box.setDescriptions(Arrays.asList(description("api-box")));
+        ResponseEntity<String> boxCreated = testRestTemplate.postForEntity(
+                "/api/v1/private/content/box", new HttpEntity<>(box, headers), String.class);
+        assertThat(boxCreated.getStatusCode(), org.hamcrest.Matchers.is(CREATED));
+
+        ResponseEntity<String> pages = testRestTemplate.getForEntity(
+                "/api/v1/content/pages?store=DEFAULT&lang=en&page=0&count=20", String.class);
+        ResponseEntity<String> boxes = testRestTemplate.getForEntity(
+                "/api/v1/content/boxes?store=DEFAULT&lang=en&page=0&count=20", String.class);
+
+        assertThat(pages.getStatusCode(), org.hamcrest.Matchers.is(OK));
+        assertThat(boxes.getStatusCode(), org.hamcrest.Matchers.is(OK));
+        assertContainsCode(pages.getBody(), "api-page");
+        assertContainsCode(boxes.getBody(), "api-box");
+    }
+
+    private ContentDescription description(String name) {
+        ContentDescription description = new ContentDescription();
+        description.setLanguage("en");
+        description.setName(name);
+        description.setDescription(name);
+        return description;
+    }
+
+    private void assertContainsCode(String body, String code) throws Exception {
+        JsonNode items = objectMapper.readTree(body).get("items");
+        assertThat(items, notNullValue());
+        assertThat(items.toString(), org.hamcrest.Matchers.containsString(code));
+    }
+}
