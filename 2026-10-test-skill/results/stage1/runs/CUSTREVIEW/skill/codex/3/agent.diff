+package com.salesmanager.test.shop.integration.customer;
+
+import static org.hamcrest.CoreMatchers.is;
+import static org.junit.Assert.assertThat;
+import static org.springframework.http.HttpStatus.NOT_FOUND;
+import static org.springframework.http.HttpStatus.OK;
+
+import javax.inject.Inject;
+import java.util.UUID;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.boot.test.web.client.TestRestTemplate;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.business.services.customer.review.CustomerReviewService;
+import com.salesmanager.core.business.services.reference.language.LanguageService;
+import com.salesmanager.core.model.customer.review.CustomerReview;
+import com.salesmanager.core.model.customer.review.CustomerReviewDescription;
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.customer.PersistableCustomerReview;
+import com.salesmanager.shop.model.customer.PersistableCustomer;
+import com.salesmanager.core.model.customer.CustomerGender;
+import com.salesmanager.shop.model.customer.address.Address;
+import com.salesmanager.shop.populator.customer.ReadableCustomerList;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@RunWith(SpringRunner.class)
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+public class CustomerReviewApiIntegrationTest extends ServicesTestSupport {
+
+  @Inject
+  private CustomerService customerService;
+
+  @Inject
+  private CustomerReviewService customerReviewService;
+
+  @Inject
+  private LanguageService languageService;
+
+  @Test
+  public void updateReviewChangesRatingAndTextAndMissingReviewIsNotFound() throws Exception {
+    Long reviewerId = registerTestCustomer();
+    Long reviewedId = registerTestCustomer();
+    CustomerReview stored = new CustomerReview();
+    stored.setCustomer(customerService.getById(reviewerId));
+    stored.setReviewedCustomer(customerService.getById(reviewedId));
+    stored.setReviewRating(2D);
+    CustomerReviewDescription description = new CustomerReviewDescription();
+    description.setDescription("original text");
+    description.setName("-");
+    description.setLanguage(languageService.getByCode("en"));
+    description.setCustomerReview(stored);
+    stored.getDescriptions().add(description);
+    customerReviewService.create(stored);
+
+    try {
+      PersistableCustomerReview update = new PersistableCustomerReview();
+      update.setCustomerId(reviewerId);
+      update.setReviewedCustomer(reviewedId);
+      update.setRating(5D);
+      update.setDescription("corrected text");
+      HttpHeaders headers = getHeader();
+      ResponseEntity<PersistableCustomerReview> response = testRestTemplate.exchange(
+          "/api/v1/private/customers/" + reviewedId + "/reviews/" + stored.getId(), HttpMethod.PUT,
+          new HttpEntity<>(update, headers), PersistableCustomerReview.class);
+
+      assertThat(response.getStatusCode(), is(OK));
+      assertThat(response.getBody().getRating(), is(5D));
+      assertThat(response.getBody().getDescription(), is("corrected text"));
+
+      ResponseEntity<String> missing = testRestTemplate.exchange(
+          "/api/v1/private/customers/" + reviewedId + "/reviews/999999999", HttpMethod.DELETE,
+          new HttpEntity<>(headers), String.class);
+      assertThat(missing.getStatusCode(), is(NOT_FOUND));
+    } finally {
+      customerReviewService.delete(stored);
+    }
+  }
+
+  private Long registerTestCustomer() {
+    PersistableCustomer customer = new PersistableCustomer();
+    customer.setEmailAddress(UUID.randomUUID() + "@test.com");
+    customer.setPassword("clear123");
+    customer.setGender(CustomerGender.M.name());
+    customer.setLanguage("en");
+    Address address = new Address();
+    address.setFirstName("review");
+    address.setLastName("test");
+    address.setCountry("BE");
+    customer.setBilling(address);
+    customer.setStoreCode("DEFAULT");
+    return testRestTemplate.postForEntity("/api/v1/customer/register", new HttpEntity<>(customer),
+        PersistableCustomer.class).getBody().getId();
+  }
+}
