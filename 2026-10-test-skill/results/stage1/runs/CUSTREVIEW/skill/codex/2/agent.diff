+package com.salesmanager.test.shop.integration.customer;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertThat;
+import static org.hamcrest.CoreMatchers.is;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+
+import com.salesmanager.shop.model.customer.PersistableCustomerReview;
+import com.salesmanager.shop.model.customer.PersistableCustomer;
+import com.salesmanager.shop.model.customer.ReadableCustomerReview;
+import com.salesmanager.core.model.customer.CustomerGender;
+import com.salesmanager.shop.model.customer.address.Address;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+import com.salesmanager.shop.application.ShopApplication;
+
+@RunWith(org.springframework.test.context.junit4.SpringRunner.class)
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+public class CustomerReviewApiIntegrationTest extends ServicesTestSupport {
+
+  @Test
+  public void updatesReviewAndReturnsNotFoundForUnknownReview() {
+    HttpHeaders headers = getHeader();
+    Long reviewerId = registerCustomer("reviewer").getId();
+    Long reviewedId = registerCustomer("reviewed").getId();
+    PersistableCustomerReview created = new PersistableCustomerReview();
+    created.setCustomerId(reviewerId);
+    created.setRating(2D);
+    created.setDescription("Original review");
+
+    ResponseEntity<PersistableCustomerReview> create = testRestTemplate.postForEntity(
+        "/api/v1/private/customers/" + reviewedId + "/reviews?store=DEFAULT&lang=en", new HttpEntity<>(created, headers),
+        PersistableCustomerReview.class);
+    assertThat(create.getStatusCode(), is(HttpStatus.CREATED));
+    assertNotNull(create.getBody());
+
+    Long reviewId = create.getBody().getId();
+    PersistableCustomerReview changed = new PersistableCustomerReview();
+    changed.setCustomerId(reviewerId);
+    changed.setRating(5D);
+    changed.setDescription("Corrected review");
+    ResponseEntity<PersistableCustomerReview> update = testRestTemplate.exchange(
+        "/api/v1/private/customers/" + reviewedId + "/reviews/" + reviewId + "?store=DEFAULT&lang=en", HttpMethod.PUT,
+        new HttpEntity<>(changed, headers), PersistableCustomerReview.class);
+    assertThat(update.getStatusCode(), is(HttpStatus.OK));
+    assertEquals(Double.valueOf(5D), update.getBody().getRating());
+
+    ResponseEntity<ReadableCustomerReview[]> reviews = testRestTemplate.exchange(
+        "/api/v1/customers/" + reviewedId + "/reviews?store=DEFAULT&lang=en", HttpMethod.GET, new HttpEntity<>(headers),
+        ReadableCustomerReview[].class);
+    assertThat(reviews.getStatusCode(), is(HttpStatus.OK));
+    assertEquals("Corrected review", reviews.getBody()[0].getDescription());
+    assertEquals(Double.valueOf(5D), reviews.getBody()[0].getRating());
+
+    ResponseEntity<Void> missingUpdate = testRestTemplate.exchange(
+        "/api/v1/private/customers/" + reviewedId + "/reviews/999999?store=DEFAULT&lang=en", HttpMethod.PUT,
+        new HttpEntity<>(changed, headers), Void.class);
+    assertThat(missingUpdate.getStatusCode(), is(HttpStatus.NOT_FOUND));
+    ResponseEntity<Void> missingDelete = testRestTemplate.exchange(
+        "/api/v1/private/customers/" + reviewedId + "/reviews/999999?store=DEFAULT&lang=en", HttpMethod.DELETE,
+        new HttpEntity<>(headers), Void.class);
+    assertThat(missingDelete.getStatusCode(), is(HttpStatus.NOT_FOUND));
+  }
+
+  private PersistableCustomer registerCustomer(String name) {
+    PersistableCustomer customer = new PersistableCustomer();
+    customer.setEmailAddress(name + System.nanoTime() + "@test.com");
+    customer.setPassword("clear123");
+    customer.setGender(CustomerGender.M.name());
+    customer.setLanguage("en");
+    customer.setStoreCode("DEFAULT");
+    Address billing = new Address();
+    billing.setFirstName(name);
+    billing.setLastName("Customer");
+    billing.setCountry("BE");
+    customer.setBilling(billing);
+    return testRestTemplate.postForEntity("/api/v1/customer/register", new HttpEntity<>(customer, getHeader()),
+        PersistableCustomer.class).getBody();
+  }
+}
