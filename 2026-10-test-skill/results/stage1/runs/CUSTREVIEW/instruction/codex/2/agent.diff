+@RunWith(SpringRunner.class)
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+public class CustomerReviewApiIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void missingReviewIsNotFoundForUpdateAndDelete() {
+        HttpEntity<String> request = new HttpEntity<>("{\"rating\":5,\"description\":\"corrected\"}", getHeader());
+
+        ResponseEntity<String> update = testRestTemplate.exchange(
+                "/api/v1/private/customers/1/reviews/9223372036854775807", HttpMethod.PUT, request, String.class);
+        ResponseEntity<String> delete = testRestTemplate.exchange(
+                "/api/v1/private/customers/1/reviews/9223372036854775807", HttpMethod.DELETE,
+                new HttpEntity<>(getHeader()), String.class);
+
+        assertEquals(HttpStatus.NOT_FOUND, update.getStatusCode());
+        assertEquals(HttpStatus.NOT_FOUND, delete.getStatusCode());
+    }
