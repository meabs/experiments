@@ -0,0 +1,51 @@
+package com.salesmanager.test.shop.integration.customer;
+
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.junit.Assert.assertEquals;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.put;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.salesmanager.shop.model.customer.PersistableCustomerReview;
+import com.salesmanager.shop.store.api.v1.customer.CustomerReviewApi;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import org.junit.Before;
+import org.junit.Test;
+import org.mockito.ArgumentCaptor;
+import org.springframework.test.util.ReflectionTestUtils;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+
+public class CustomerReviewApiTest {
+
+  private MockMvc mockMvc;
+  private CustomerFacade customerFacade;
+
+  @Before
+  public void setUp() {
+    CustomerReviewApi api = new CustomerReviewApi();
+    customerFacade = mock(CustomerFacade.class);
+    ReflectionTestUtils.setField(api, "customerFacade", customerFacade);
+    mockMvc = MockMvcBuilders.standaloneSetup(api).build();
+  }
+
+  @Test
+  public void updateReviewUsesReviewIdPathVariable() throws Exception {
+    PersistableCustomerReview review = new PersistableCustomerReview();
+    review.setRating(4D);
+    review.setDescription("Resolved dispute");
+
+    mockMvc.perform(put("/api/v1/private/customers/12/reviews/34")
+            .contentType("application/json")
+            .content(new ObjectMapper().writeValueAsString(review)))
+        .andExpect(status().isOk());
+
+    ArgumentCaptor<PersistableCustomerReview> captured = ArgumentCaptor.forClass(PersistableCustomerReview.class);
+    verify(customerFacade).updateCustomerReview(eq(12L), eq(34L), captured.capture(),
+        org.mockito.ArgumentMatchers.any(), org.mockito.ArgumentMatchers.any());
+    assertEquals(review.getRating(), captured.getValue().getRating());
+    assertEquals(review.getDescription(), captured.getValue().getDescription());
+  }
+}
