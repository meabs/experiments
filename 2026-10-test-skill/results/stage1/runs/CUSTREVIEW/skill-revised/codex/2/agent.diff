+package com.salesmanager.test.shop.integration.customer;
+
+import static org.junit.Assert.assertEquals;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.model.customer.PersistableCustomerReview;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@RunWith(SpringRunner.class)
+public class CustomerReviewApiIntegrationTest extends ServicesTestSupport {
+
+  @Test
+  public void missingReviewIsNotFoundWhenUpdatingOrDeleting() {
+    HttpHeaders headers = getHeader();
+    PersistableCustomerReview changed = new PersistableCustomerReview();
+    changed.setRating(5d);
+    changed.setDescription("corrected review");
+    ResponseEntity<String> missingUpdate = testRestTemplate.exchange(
+        "/api/v1/private/customers/1/reviews/999999999", HttpMethod.PUT,
+        new HttpEntity<>(changed, headers), String.class);
+    assertEquals(HttpStatus.NOT_FOUND, missingUpdate.getStatusCode());
+    ResponseEntity<String> missingDelete = testRestTemplate.exchange(
+        "/api/v1/private/customers/1/reviews/999999999", HttpMethod.DELETE,
+        new HttpEntity<>(headers), String.class);
+    assertEquals(HttpStatus.NOT_FOUND, missingDelete.getStatusCode());
+  }
+}
