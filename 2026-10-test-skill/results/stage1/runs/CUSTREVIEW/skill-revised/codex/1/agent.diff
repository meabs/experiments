+package com.salesmanager.test.shop.integration.customer;
+
+import static org.hamcrest.core.Is.is;
+import static org.junit.Assert.assertThat;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.core.model.customer.CustomerGender;
+import com.salesmanager.shop.model.customer.PersistableCustomer;
+import com.salesmanager.shop.model.customer.address.Address;
+import com.salesmanager.shop.model.customer.PersistableCustomerReview;
+import com.salesmanager.core.business.constants.Constants;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@RunWith(SpringRunner.class)
+public class CustomerReviewApiIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void updateReviewThroughApiAndRejectUnknownReview() {
+        PersistableCustomer reviewer = registerCustomer("reviewer");
+        PersistableCustomer reviewed = registerCustomer("reviewed");
+
+        PersistableCustomerReview created = new PersistableCustomerReview();
+        created.setCustomerId(reviewer.getId());
+        created.setReviewedCustomer(reviewed.getId());
+        created.setRating(2d);
+        created.setDescription("original text");
+        HttpEntity<PersistableCustomerReview> createRequest = new HttpEntity<>(created, getHeader());
+        ResponseEntity<PersistableCustomerReview> createResponse = testRestTemplate.postForEntity(
+                "/api/v1/private/customers/" + reviewed.getId() + "/reviews", createRequest,
+                PersistableCustomerReview.class);
+        assertThat(createResponse.getStatusCode(), is(HttpStatus.CREATED));
+
+        PersistableCustomerReview edit = new PersistableCustomerReview();
+        edit.setCustomerId(reviewer.getId());
+        edit.setRating(5d);
+        edit.setDescription("corrected text");
+        HttpEntity<PersistableCustomerReview> editRequest = new HttpEntity<>(edit, getHeader());
+        ResponseEntity<PersistableCustomerReview> editResponse = testRestTemplate.exchange(
+                "/api/v1/private/customers/" + reviewed.getId() + "/reviews/" + createResponse.getBody().getId(),
+                HttpMethod.PUT, editRequest, PersistableCustomerReview.class);
+
+        assertThat(editResponse.getStatusCode(), is(HttpStatus.OK));
+        assertThat(editResponse.getBody().getRating(), is(5d));
+        assertThat(editResponse.getBody().getDescription(), is("corrected text"));
+
+        long unknownReviewId = createResponse.getBody().getId() + 100000L;
+        ResponseEntity<String> unknownEdit = testRestTemplate.exchange(
+                "/api/v1/private/customers/" + reviewed.getId() + "/reviews/" + unknownReviewId,
+                HttpMethod.PUT, new HttpEntity<>(edit, getHeader()), String.class);
+        assertThat(unknownEdit.getStatusCode(), is(HttpStatus.NOT_FOUND));
+
+        ResponseEntity<String> unknownDelete = testRestTemplate.exchange(
+                "/api/v1/private/customers/" + reviewed.getId() + "/reviews/" + unknownReviewId,
+                HttpMethod.DELETE, new HttpEntity<>(getHeader()), String.class);
+        assertThat(unknownDelete.getStatusCode(), is(HttpStatus.NOT_FOUND));
+    }
+
+    private PersistableCustomer registerCustomer(String suffix) {
+        PersistableCustomer customer = new PersistableCustomer();
+        customer.setEmailAddress("customer-review-" + suffix + "@test.com");
+        customer.setPassword("clear123");
+        customer.setGender(CustomerGender.M.name());
+        customer.setLanguage("en");
+        customer.setStoreCode(Constants.DEFAULT_STORE);
+        Address billing = new Address();
+        billing.setFirstName(suffix);
+        billing.setLastName("review");
+        billing.setCountry("BE");
+        customer.setBilling(billing);
+        ResponseEntity<PersistableCustomer> response = testRestTemplate.postForEntity(
+                "/api/v1/customer/register", new HttpEntity<>(customer, getHeader()), PersistableCustomer.class);
+        assertThat(response.getStatusCode(), is(HttpStatus.OK));
+        return response.getBody();
+    }
+}
