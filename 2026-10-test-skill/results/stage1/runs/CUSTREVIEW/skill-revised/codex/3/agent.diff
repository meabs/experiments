+package com.salesmanager.test.shop.integration.customer;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertThat;
+import static org.hamcrest.Matchers.is;
+import static org.springframework.http.HttpStatus.NOT_FOUND;
+import static org.springframework.http.HttpStatus.OK;
+
+import java.util.List;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.customer.PersistableCustomerReview;
+import com.salesmanager.shop.model.customer.PersistableCustomer;
+import com.salesmanager.shop.model.customer.ReadableCustomer;
+import com.salesmanager.shop.model.customer.ReadableCustomerReview;
+import com.salesmanager.core.model.customer.CustomerGender;
+import com.salesmanager.shop.model.customer.address.Address;
+import com.salesmanager.shop.populator.customer.ReadableCustomerList;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class CustomerReviewApiIntegrationTest extends ServicesTestSupport {
+
+  @Test
+  public void updateReviewChangesRatingAndTextAndUnknownReviewIsNotFound() {
+    registerCustomer("reviewer");
+    registerCustomer("reviewed");
+    ReadableCustomerList customers = fetchCustomers();
+    List<ReadableCustomer> customerList = customers.getCustomers();
+    assertThat(customerList.size() >= 2, is(true));
+    Long reviewerId = customerList.get(0).getId();
+    Long reviewedId = customerList.get(1).getId();
+
+    PersistableCustomerReview create = new PersistableCustomerReview();
+    create.setCustomerId(reviewerId);
+    create.setReviewedCustomer(reviewedId);
+    create.setRating(2d);
+    create.setDescription("original review");
+    ResponseEntity<PersistableCustomerReview> created = testRestTemplate.postForEntity(
+        "/api/v1/private/customers/" + reviewedId + "/reviews?store=DEFAULT",
+        new HttpEntity<>(create, getHeader()), PersistableCustomerReview.class);
+    assertThat(created.getStatusCode(), is(org.springframework.http.HttpStatus.CREATED));
+
+    ResponseEntity<ReadableCustomerReview[]> reviews = testRestTemplate.exchange(
+        "/api/v1/customers/" + reviewedId + "/reviews?store=DEFAULT", HttpMethod.GET,
+        new HttpEntity<>(getHeader()), ReadableCustomerReview[].class);
+    Long reviewId = null;
+    for (ReadableCustomerReview review : reviews.getBody()) {
+      if ("original review".equals(review.getDescription())) {
+        reviewId = review.getId();
+      }
+    }
+    assertNotNull(reviewId);
+
+    PersistableCustomerReview update = new PersistableCustomerReview();
+    update.setRating(5d);
+    update.setDescription("corrected review");
+    ResponseEntity<PersistableCustomerReview> updated = testRestTemplate.exchange(
+        "/api/v1/private/customers/" + reviewedId + "/reviews/" + reviewId + "?store=DEFAULT",
+        HttpMethod.PUT, new HttpEntity<>(update, getHeader()), PersistableCustomerReview.class);
+    assertThat(updated.getStatusCode(), is(OK));
+    assertEquals(5d, updated.getBody().getRating(), 0.0d);
+    assertEquals("corrected review", updated.getBody().getDescription());
+
+    ResponseEntity<Void> missingUpdate = testRestTemplate.exchange(
+        "/api/v1/private/customers/" + reviewedId + "/reviews/999999999?store=DEFAULT",
+        HttpMethod.PUT, new HttpEntity<>(update, getHeader()), Void.class);
+    assertThat(missingUpdate.getStatusCode(), is(NOT_FOUND));
+    ResponseEntity<Void> missingDelete = testRestTemplate.exchange(
+        "/api/v1/private/customers/" + reviewedId + "/reviews/999999999?store=DEFAULT",
+        HttpMethod.DELETE, new HttpEntity<>(getHeader()), Void.class);
+    assertThat(missingDelete.getStatusCode(), is(NOT_FOUND));
+  }
+
+  private void registerCustomer(String name) {
+    PersistableCustomer customer = new PersistableCustomer();
+    customer.setEmailAddress(name + System.nanoTime() + "@test.com");
+    customer.setPassword("clear123");
+    customer.setGender(CustomerGender.M.name());
+    customer.setLanguage("en");
+    customer.setStoreCode("DEFAULT");
+    Address billing = new Address();
+    billing.setFirstName(name);
+    billing.setLastName(name);
+    billing.setCountry("BE");
+    customer.setBilling(billing);
+    ResponseEntity<PersistableCustomer> response = testRestTemplate.postForEntity(
+        "/api/v1/customer/register", new HttpEntity<>(customer), PersistableCustomer.class);
+    assertThat(response.getStatusCode(), is(OK));
+  }
+}
