+package com.salesmanager.test.shop.integration.content;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertTrue;
+
+import java.util.Collections;
+
+import javax.inject.Inject;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.boot.test.web.client.TestRestTemplate;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.content.box.PersistableContentBox;
+import com.salesmanager.shop.model.content.box.ReadableContentBox;
+import com.salesmanager.shop.model.content.common.ContentDescription;
+import com.salesmanager.shop.model.entity.Entity;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class ContentBoxApiIntegrationTest extends ServicesTestSupport {
+
+    @Inject
+    private TestRestTemplate testRestTemplate;
+
+    @Test
+    public void getBoxByCodeReturnsPersistedFieldsAndRawText() {
+        String code = "api-box-fields";
+        String text = "Promotion <strong>today</strong>";
+        PersistableContentBox box = new PersistableContentBox();
+        box.setCode(code);
+        box.setVisible(true);
+        ContentDescription description = new ContentDescription();
+        description.setLanguage("en");
+        description.setName(code);
+        description.setDescription(text);
+        box.setDescriptions(Collections.singletonList(description));
+
+        HttpEntity<PersistableContentBox> createRequest = new HttpEntity<>(box, getHeader());
+        ResponseEntity<Entity> created = testRestTemplate.exchange(
+                "/api/v1/private/content/box", HttpMethod.POST, createRequest, Entity.class);
+        assertEquals(HttpStatus.CREATED, created.getStatusCode());
+        assertNotNull(created.getBody());
+
+        ResponseEntity<ReadableContentBox> response = testRestTemplate.exchange(
+                "/api/v1/content/boxes/" + code, HttpMethod.GET,
+                new HttpEntity<>(getHeader()), ReadableContentBox.class);
+        assertEquals(HttpStatus.OK, response.getStatusCode());
+        ReadableContentBox returned = response.getBody();
+        assertNotNull(returned);
+        assertEquals(code, returned.getCode());
+        assertTrue(returned.getId() > 0);
+        assertTrue(returned.isVisible());
+        assertEquals(text, returned.getDescription().getDescription());
+
+        ResponseEntity<ReadableContentBox> missing = testRestTemplate.exchange(
+                "/api/v1/content/boxes/does-not-exist", HttpMethod.GET,
+                new HttpEntity<>(getHeader()), ReadableContentBox.class);
+        assertEquals(HttpStatus.NOT_FOUND, missing.getStatusCode());
+    }
+}
