+package com.salesmanager.test.shop.integration.content;
+
+import static org.hamcrest.MatcherAssert.assertThat;
+import static org.hamcrest.Matchers.is;
+import static org.hamcrest.Matchers.greaterThan;
+
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.Map;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class ContentBoxApiIntegrationTest extends ServicesTestSupport {
+
+    private final ObjectMapper objectMapper = new ObjectMapper();
+
+    @Test
+    public void getBoxByCodeReturnsStoredMetadataAndExactText() throws Exception {
+        String code = "api_box_exact_text";
+        String text = "Promotion <strong>10%</strong>\nKeep this exactly.";
+
+        Map<String, Object> description = new HashMap<>();
+        description.put("language", "en");
+        description.put("description", text);
+        description.put("name", "API box");
+
+        Map<String, Object> box = new HashMap<>();
+        box.put("code", code);
+        box.put("visible", true);
+        box.put("descriptions", Collections.singletonList(description));
+
+        HttpEntity<Map<String, Object>> createRequest = new HttpEntity<>(box, getHeader());
+        ResponseEntity<String> created = testRestTemplate.exchange(
+                "/api/v1/private/content/box", HttpMethod.POST, createRequest, String.class);
+        assertThat(created.getStatusCode(), is(HttpStatus.CREATED));
+
+        ResponseEntity<String> response = testRestTemplate.exchange(
+                "/api/v1/content/boxes/" + code, HttpMethod.GET,
+                new HttpEntity<>(getHeader()), String.class);
+
+        assertThat(response.getStatusCode(), is(HttpStatus.OK));
+        JsonNode body = objectMapper.readTree(response.getBody());
+        assertThat(body.get("code").asText(), is(code));
+        assertThat(body.get("id").asLong(), greaterThan(0L));
+        assertThat(body.get("visible").asBoolean(), is(true));
+        assertThat(body.at("/description/description").asText(), is(text));
+    }
+}
