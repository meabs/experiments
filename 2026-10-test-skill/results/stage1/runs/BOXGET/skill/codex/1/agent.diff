+package com.salesmanager.test.shop.integration.content;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertTrue;
+
+import java.util.Arrays;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+
+import com.salesmanager.shop.model.content.box.PersistableContentBox;
+import com.salesmanager.shop.model.content.common.ContentDescription;
+import com.salesmanager.shop.model.entity.Entity;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@RunWith(SpringRunner.class)
+public class ContentBoxApiIntegrationTest extends ServicesTestSupport {
+
+	@Test
+	public void getBoxByCodeReturnsStoredFieldsAndText() {
+		String code = "api-box-regression";
+		String text = "Promotion text exactly as written\nwith a second line";
+		PersistableContentBox box = new PersistableContentBox();
+		box.setCode(code);
+		box.setVisible(true);
+		ContentDescription description = new ContentDescription();
+		description.setLanguage("en");
+		description.setName(code);
+		description.setDescription(text);
+		box.setDescriptions(Arrays.asList(description));
+
+		ResponseEntity<Entity> created = testRestTemplate.postForEntity(
+				"/api/v1/private/content/box?store=DEFAULT&lang=en",
+				new HttpEntity<>(box, getHeader()), Entity.class);
+		assertEquals(HttpStatus.CREATED, created.getStatusCode());
+		assertNotNull(created.getBody());
+
+		ResponseEntity<String> response = testRestTemplate.exchange(
+				"/api/v1/content/boxes/" + code + "?store=DEFAULT&lang=en",
+				HttpMethod.GET, new HttpEntity<>(getHeader()), String.class);
+
+		assertEquals(HttpStatus.OK, response.getStatusCode());
+		assertNotNull(response.getBody());
+		JsonNode result;
+		try {
+			result = new ObjectMapper().readTree(response.getBody());
+		} catch (Exception e) {
+			throw new AssertionError("Response was not JSON: " + response.getBody(), e);
+		}
+		assertEquals(code, result.get("code").asText());
+		assertTrue(result.get("id").asLong() > 0);
+		assertEquals(true, result.get("visible").asBoolean());
+		assertEquals(text, result.get("description").get("description").asText());
+	}
+}
