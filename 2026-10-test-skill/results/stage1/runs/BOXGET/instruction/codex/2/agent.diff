+package com.salesmanager.test.shop.integration.content;
+
+import static org.hamcrest.core.Is.is;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertThat;
+import static org.junit.Assert.assertTrue;
+import static org.springframework.http.HttpStatus.CREATED;
+import static org.springframework.http.HttpStatus.OK;
+
+import java.util.Collections;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.content.box.PersistableContentBox;
+import com.salesmanager.shop.model.content.box.ReadableContentBox;
+import com.salesmanager.shop.model.content.common.ContentDescription;
+import com.salesmanager.shop.model.entity.Entity;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class ContentBoxApiIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void getBoxByCodeReturnsStoredFieldsAndText() {
+        String code = "api-box-" + System.currentTimeMillis();
+        String text = "Welcome\nSave 20%\t today";
+        PersistableContentBox box = new PersistableContentBox();
+        box.setCode(code);
+        box.setVisible(true);
+        ContentDescription description = new ContentDescription();
+        description.setLanguage("en");
+        description.setName(code);
+        description.setDescription(text);
+        box.setDescriptions(Collections.singletonList(description));
+
+        ResponseEntity<Entity> created = testRestTemplate.postForEntity("/api/v1/private/content/box",
+                new HttpEntity<>(box, getHeader()), Entity.class);
+        assertThat(created.getStatusCode(), is(CREATED));
+        assertNotNull(created.getBody());
+
+        ResponseEntity<ReadableContentBox> response = testRestTemplate.exchange("/api/v1/content/boxes/" + code,
+                HttpMethod.GET, new HttpEntity<>(getHeader()), ReadableContentBox.class);
+        assertThat(response.getStatusCode(), is(OK));
+        ReadableContentBox result = response.getBody();
+        assertThat(result.getCode(), is(code));
+        assertNotNull(result.getId());
+        assertTrue(result.getId() > 0);
+        assertThat(result.isVisible(), is(true));
+        assertThat(result.getDescription().getDescription(), is(text));
+    }
+}
