+package com.salesmanager.test.shop.integration.customer;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.springframework.http.HttpStatus.OK;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.customer.PersistableCustomer;
+import com.salesmanager.shop.model.customer.ReadableCustomer;
+import com.salesmanager.core.model.customer.CustomerGender;
+import com.salesmanager.core.business.constants.Constants;
+import com.salesmanager.shop.model.customer.address.Address;
+import com.salesmanager.shop.populator.customer.ReadableCustomerList;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@RunWith(SpringRunner.class)
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+public class CustomerAddressApiIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void patchThenGetPreservesDeliveryAddress() {
+        PersistableCustomer newCustomer = new PersistableCustomer();
+        newCustomer.setEmailAddress("address-test-" + System.nanoTime() + "@test.com");
+        newCustomer.setPassword("clear123");
+        newCustomer.setGender(CustomerGender.M.name());
+        newCustomer.setLanguage("en");
+        newCustomer.setStoreCode(Constants.DEFAULT_STORE);
+        Address initialBilling = new Address();
+        initialBilling.setFirstName("Address");
+        initialBilling.setLastName("Tester");
+        initialBilling.setAddress("Initial Street");
+        initialBilling.setCity("Initial City");
+        initialBilling.setPostalCode("I1 1II");
+        initialBilling.setCountry("GB");
+        newCustomer.setBilling(initialBilling);
+        ResponseEntity<ReadableCustomer> created = testRestTemplate.postForEntity("/api/v1/private/customer",
+                new HttpEntity<>(newCustomer, getHeader()), ReadableCustomer.class);
+        assertEquals(OK, created.getStatusCode());
+        Long customerId = created.getBody().getId();
+
+        PersistableCustomer update = new PersistableCustomer();
+        Address billing = new Address();
+        billing.setAddress("Billing Street");
+        billing.setFirstName("Address");
+        billing.setLastName("Tester");
+        billing.setCity("Billing City");
+        billing.setPostalCode("B1 1BB");
+        billing.setCountry("GB");
+        update.setBilling(billing);
+        Address delivery = new Address();
+        delivery.setAddress("Delivery Street");
+        delivery.setFirstName("Address");
+        delivery.setLastName("Tester");
+        delivery.setCity("Delivery City");
+        delivery.setPostalCode("D2 2DD");
+        delivery.setStateProvince("Delivery State");
+        delivery.setCountry("GB");
+        update.setDelivery(delivery);
+
+        ResponseEntity<Void> patch = testRestTemplate.exchange("/api/v1/private/customer/" + customerId + "/address",
+                HttpMethod.PATCH, new HttpEntity<>(update, getHeader()), Void.class);
+        assertEquals(OK, patch.getStatusCode());
+
+        ResponseEntity<ReadableCustomer> get = testRestTemplate.exchange("/api/v1/private/customer/" + customerId,
+                HttpMethod.GET, new HttpEntity<>(getHeader()), ReadableCustomer.class);
+        assertEquals(OK, get.getStatusCode());
+        assertEquals("Delivery Street", get.getBody().getDelivery().getAddress());
+        assertEquals("Delivery City", get.getBody().getDelivery().getCity());
+        assertEquals("D2 2DD", get.getBody().getDelivery().getPostalCode());
+        assertEquals("Delivery State", get.getBody().getDelivery().getStateProvince());
+        assertEquals("GB", get.getBody().getDelivery().getCountry());
+    }
+}
