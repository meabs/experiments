+        billing.setCity("Billing City");
+        billing.setPostalCode("BILL-POST");
+        billing.setCountry("BE");
+        registration.setBilling(billing);
+
+        ResponseEntity<ReadableCustomer> created = testRestTemplate.postForEntity(
