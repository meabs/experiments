+package com.salesmanager.test.shop.integration.customer;
+
+import static org.hamcrest.core.Is.is;
+import static org.junit.Assert.assertThat;
+import static org.springframework.http.HttpStatus.OK;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.customer.PersistableCustomer;
+import com.salesmanager.shop.model.customer.ReadableCustomer;
+import com.salesmanager.shop.model.customer.address.Address;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@RunWith(SpringRunner.class)
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+public class CustomerAddressApiIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void patchCustomerAddressPreservesDeliveryFieldsAndUsesBillingFallbacks() {
+        PersistableCustomer newCustomer = new PersistableCustomer();
+        newCustomer.setEmailAddress("address-api-" + System.nanoTime() + "@test.com");
+        newCustomer.setPassword("clear123");
+        newCustomer.setGender("M");
+        Address billing = new Address();
+        billing.setFirstName("Api");
+        billing.setLastName("Customer");
+        billing.setAddress("Billing street");
+        billing.setCity("Billing city");
+        billing.setPostalCode("BILL-POST");
+        billing.setCountry("US");
+        newCustomer.setBilling(billing);
+
+        ResponseEntity<PersistableCustomer> created = testRestTemplate.postForEntity(
+                "/api/v1/private/customer", new HttpEntity<>(newCustomer, getHeader()), PersistableCustomer.class);
+        assertThat(created.getStatusCode(), is(OK));
+
+        Address delivery = new Address();
+        delivery.setAddress("Delivery street");
+        delivery.setStateProvince("CA");
+        PersistableCustomer update = new PersistableCustomer();
+        update.setBilling(billing);
+        update.setDelivery(delivery);
+
+        ResponseEntity<Void> patched = testRestTemplate.exchange(
+                "/api/v1/private/customer/" + created.getBody().getId() + "/address", HttpMethod.PATCH,
+                new HttpEntity<>(update, getHeader()), Void.class);
+        assertThat(patched.getStatusCode(), is(OK));
+
+        ResponseEntity<ReadableCustomer> read = testRestTemplate.exchange(
+                "/api/v1/private/customer/" + created.getBody().getId(), HttpMethod.GET,
+                new HttpEntity<>(getHeader()), ReadableCustomer.class);
+        assertThat(read.getStatusCode(), is(OK));
+        assertThat(read.getBody().getDelivery().getAddress(), is("Delivery street"));
+        assertThat(read.getBody().getDelivery().getCity(), is("Billing city"));
+        assertThat(read.getBody().getDelivery().getPostalCode(), is("BILL-POST"));
+        assertThat(read.getBody().getDelivery().getCountry(), is("US"));
+        assertThat(read.getBody().getDelivery().getStateProvince(), is("CA"));
+    }
+}
