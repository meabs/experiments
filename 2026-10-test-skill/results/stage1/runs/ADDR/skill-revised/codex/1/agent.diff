+package com.salesmanager.test.shop.integration.customer;
+
+import static org.junit.Assert.assertEquals;
+import static org.springframework.http.HttpStatus.OK;
+
+import java.util.UUID;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.core.model.customer.CustomerGender;
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.customer.PersistableCustomer;
+import com.salesmanager.shop.model.customer.ReadableCustomer;
+import com.salesmanager.shop.model.customer.address.Address;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class CustomerAddressApiIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void patchCustomerAddressesPreservesDeliveryFields() {
+        PersistableCustomer registration = new PersistableCustomer();
+        registration.setEmailAddress("address-" + UUID.randomUUID() + "@test.com");
+        registration.setPassword("clear123");
+        registration.setGender(CustomerGender.M.name());
+        registration.setLanguage("en");
+        registration.setBilling(address("Billing Street", "Billing City", "BILL-100", "CA"));
+
+        ResponseEntity<PersistableCustomer> created = testRestTemplate.postForEntity(
+                "/api/v1/customer/register", new HttpEntity<>(registration, getHeader()), PersistableCustomer.class);
+        assertEquals(OK, created.getStatusCode());
+
+        PersistableCustomer update = new PersistableCustomer();
+        update.setBilling(address("Billing Street", "Billing City", "BILL-100", "CA"));
+        update.setDelivery(address("Delivery Street", "Delivery City", "DEL-200", "US"));
+
+        ResponseEntity<Void> patched = testRestTemplate.exchange(
+                "/api/v1/private/customer/" + created.getBody().getId() + "/address",
+                HttpMethod.PATCH, new HttpEntity<>(update, getHeader()), Void.class);
+        assertEquals(OK, patched.getStatusCode());
+
+        ResponseEntity<ReadableCustomer> fetched = testRestTemplate.exchange(
+                "/api/v1/private/customer/" + created.getBody().getId(), HttpMethod.GET,
+                new HttpEntity<>(getHeader()), ReadableCustomer.class);
+        assertEquals(OK, fetched.getStatusCode());
+        assertEquals("Delivery Street", fetched.getBody().getDelivery().getAddress());
+        assertEquals("Delivery City", fetched.getBody().getDelivery().getCity());
+        assertEquals("DEL-200", fetched.getBody().getDelivery().getPostalCode());
+        assertEquals("US", fetched.getBody().getDelivery().getCountry());
+
+        PersistableCustomer partialUpdate = new PersistableCustomer();
+        partialUpdate.setBilling(address("Billing Street", "Billing City", "BILL-100", "CA"));
+        partialUpdate.setDelivery(address("Delivery Street Only", null, null, null));
+        testRestTemplate.exchange(
+                "/api/v1/private/customer/" + created.getBody().getId() + "/address",
+                HttpMethod.PATCH, new HttpEntity<>(partialUpdate, getHeader()), Void.class);
+
+        fetched = testRestTemplate.exchange(
+                "/api/v1/private/customer/" + created.getBody().getId(), HttpMethod.GET,
+                new HttpEntity<>(getHeader()), ReadableCustomer.class);
+        assertEquals("Delivery Street Only", fetched.getBody().getDelivery().getAddress());
+        assertEquals("Billing City", fetched.getBody().getDelivery().getCity());
+        assertEquals("BILL-100", fetched.getBody().getDelivery().getPostalCode());
+        assertEquals("CA", fetched.getBody().getDelivery().getCountry());
+    }
+
+    private Address address(String street, String city, String postalCode, String country) {
+        Address address = new Address();
+        address.setFirstName("Test");
+        address.setLastName("Customer");
+        address.setAddress(street);
+        address.setCity(city);
+        address.setPostalCode(postalCode);
+        address.setCountry(country);
+        return address;
+    }
+}
