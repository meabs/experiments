+package com.salesmanager.test.shop.integration.customer;
+
+import static org.hamcrest.CoreMatchers.is;
+import static org.junit.Assert.assertThat;
+import static org.springframework.http.HttpStatus.OK;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.core.model.customer.CustomerGender;
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.customer.PersistableCustomer;
+import com.salesmanager.shop.model.customer.ReadableCustomer;
+import com.salesmanager.shop.model.customer.address.Address;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class CustomerAddressApiIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void patchStoresAndReturnsDeliveryAddress() {
+        PersistableCustomer customer = new PersistableCustomer();
+        customer.setEmailAddress("address-api-test@example.com");
+        customer.setPassword("clear123");
+        customer.setGender(CustomerGender.M.name());
+        customer.setLanguage("en");
+        Address billing = address("Billing Street", "Billing City", "B1 1AA", "US", "Billing State");
+        customer.setBilling(billing);
+
+        ResponseEntity<ReadableCustomer> created = testRestTemplate.postForEntity(
+                "/api/v1/private/customer", new HttpEntity<>(customer, getHeader()), ReadableCustomer.class);
+        assertThat(created.getStatusCode(), is(OK));
+
+        Address delivery = address("Delivery Street", "Delivery City", "D2 2BB", "CA", "Delivery State");
+        PersistableCustomer update = new PersistableCustomer();
+        update.setBilling(billing);
+        update.setDelivery(delivery);
+        HttpHeaders headers = getHeader();
+        ResponseEntity<Void> patched = testRestTemplate.exchange(
+                "/api/v1/private/customer/" + created.getBody().getId() + "/address", HttpMethod.PATCH,
+                new HttpEntity<>(update, headers), Void.class);
+        assertThat(patched.getStatusCode(), is(OK));
+
+        ResponseEntity<ReadableCustomer> fetched = testRestTemplate.exchange(
+                "/api/v1/private/customer/" + created.getBody().getId(), HttpMethod.GET,
+                new HttpEntity<>(headers), ReadableCustomer.class);
+        assertThat(fetched.getStatusCode(), is(OK));
+        Address actual = fetched.getBody().getDelivery();
+        assertThat(actual.getAddress(), is("Delivery Street"));
+        assertThat(actual.getCity(), is("Delivery City"));
+        assertThat(actual.getPostalCode(), is("D2 2BB"));
+        assertThat(actual.getCountry(), is("CA"));
+        assertThat(actual.getStateProvince(), is("Delivery State"));
+    }
+
+    private Address address(String street, String city, String postalCode, String country, String state) {
+        Address address = new Address();
+        address.setFirstName("Test");
+        address.setLastName("Customer");
+        address.setAddress(street);
+        address.setCity(city);
+        address.setPostalCode(postalCode);
+        address.setCountry(country);
+        address.setStateProvince(state);
+        return address;
+    }
+}
