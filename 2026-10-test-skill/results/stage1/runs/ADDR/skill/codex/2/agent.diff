+package com.salesmanager.test.shop.integration.customer;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.model.customer.ReadableCustomer;
+import com.salesmanager.shop.model.customer.PersistableCustomer;
+import com.salesmanager.shop.model.customer.address.Address;
+import com.salesmanager.shop.populator.customer.ReadableCustomerList;
+import com.salesmanager.core.model.customer.CustomerGender;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@RunWith(SpringRunner.class)
+public class CustomerAddressApiIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void updatesAndReturnsDeliveryAddressThroughApi() {
+        PersistableCustomer newCustomer = new PersistableCustomer();
+        newCustomer.setEmailAddress("address-test@example.com");
+        newCustomer.setPassword("clear123");
+        newCustomer.setGender(CustomerGender.M.name());
+        newCustomer.setLanguage("en");
+        Address billing = new Address();
+        billing.setFirstName("Address");
+        billing.setLastName("Test");
+        billing.setAddress("Initial Street");
+        billing.setCity("Initial City");
+        billing.setPostalCode("I1");
+        billing.setCountry("US");
+        newCustomer.setBilling(billing);
+        ResponseEntity<PersistableCustomer> created = testRestTemplate.postForEntity(
+                "/api/v1/customer/register", new HttpEntity<>(newCustomer, getHeader()), PersistableCustomer.class);
+        assertEquals(HttpStatus.OK, created.getStatusCode());
+        Long customerId = created.getBody().getId();
+        String payload = "{\"billing\":{\"address\":\"Billing Street\",\"city\":\"Billing City\","
+                + "\"postalCode\":\"B1\",\"country\":\"US\"},"
+                + "\"delivery\":{\"address\":\"Delivery Street\",\"city\":\"Delivery City\","
+                + "\"postalCode\":\"D2\",\"country\":\"US\",\"stateProvince\":\"Delivery State\"}}";
+
+        ResponseEntity<Void> update = testRestTemplate.exchange(
+                "/api/v1/private/customer/" + customerId + "/address", HttpMethod.PATCH,
+                new HttpEntity<>(payload, getHeader()), Void.class);
+
+        assertEquals(HttpStatus.OK, update.getStatusCode());
+
+        ResponseEntity<ReadableCustomer> read = testRestTemplate.exchange(
+                "/api/v1/private/customer/" + customerId, HttpMethod.GET,
+                new HttpEntity<>(getHeader()), ReadableCustomer.class);
+
+        assertEquals(HttpStatus.OK, read.getStatusCode());
+        assertNotNull(read.getBody());
+        assertEquals("Delivery Street", read.getBody().getDelivery().getAddress());
+        assertEquals("Delivery City", read.getBody().getDelivery().getCity());
+        assertEquals("D2", read.getBody().getDelivery().getPostalCode());
+        assertEquals("US", read.getBody().getDelivery().getCountry());
+        assertEquals("Delivery State", read.getBody().getDelivery().getStateProvince());
+    }
+}
