+package com.salesmanager.test.shop.integration.category;
+
+import static org.hamcrest.CoreMatchers.is;
+import static org.junit.Assert.assertThat;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.catalog.category.ReadableCategory;
+import com.salesmanager.shop.model.catalog.category.PersistableCategory;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@RunWith(SpringRunner.class)
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+public class CategoryLookupAPIIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void looksUpCategoryByIdAndFriendlyUrlAndReturnsNotFoundForMissingValues() {
+        HttpEntity<String> request = new HttpEntity<>(getHeader());
+        PersistableCategory created = testRestTemplate.postForEntity(
+                "/api/v1/private/category", new HttpEntity<>(category("api-lookup", "api-lookup"), request.getHeaders()),
+                PersistableCategory.class).getBody();
+        ResponseEntity<ReadableCategory> byId = testRestTemplate.exchange(
+                "/api/v1/category/" + created.getId(), HttpMethod.GET, request, ReadableCategory.class);
+        assertThat(byId.getStatusCode(), is(HttpStatus.OK));
+        assertThat(byId.getBody().getId(), is(created.getId()));
+
+        ResponseEntity<ReadableCategory> byUrl = testRestTemplate.exchange(
+                "/api/v1/category/api-lookup", HttpMethod.GET,
+                request, ReadableCategory.class);
+        assertThat(byUrl.getStatusCode(), is(HttpStatus.OK));
+        assertThat(byUrl.getBody().getId(), is(created.getId()));
+
+        ResponseEntity<String> missing = testRestTemplate.exchange(
+                "/api/v1/category/does-not-exist", HttpMethod.GET, request, String.class);
+        assertThat(missing.getStatusCode(), is(HttpStatus.NOT_FOUND));
+    }
+}
