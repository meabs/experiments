+package com.salesmanager.test.shop.integration.category;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.boot.test.web.client.TestRestTemplate;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.catalog.category.ReadableCategory;
+import com.salesmanager.shop.model.catalog.category.PersistableCategory;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class CategoryLookupAPIIntegrationTest extends ServicesTestSupport {
+
+    @Autowired
+    private TestRestTemplate testRestTemplate;
+
+    @Test
+    public void looksUpCategoryByIdAndFriendlyUrlAndReturnsNotFoundForMissingValues() {
+        HttpEntity<String> request = new HttpEntity<>(getHeader());
+        PersistableCategory created = category("api-lookup", "api-lookup");
+        ResponseEntity<PersistableCategory> createdResponse = testRestTemplate.postForEntity(
+                "/api/v1/private/category", new HttpEntity<>(created, request.getHeaders()), PersistableCategory.class);
+        assertEquals(HttpStatus.CREATED, createdResponse.getStatusCode());
+        ReadableCategory expected = new ReadableCategory();
+        expected.setId(createdResponse.getBody().getId());
+        ResponseEntity<ReadableCategory> byId = testRestTemplate.exchange(
+                "/api/v1/category/" + expected.getId(), org.springframework.http.HttpMethod.GET,
+                request, ReadableCategory.class);
+        assertEquals(HttpStatus.OK, byId.getStatusCode());
+        assertEquals(expected.getId(), byId.getBody().getId());
+
+        String friendlyUrl = "api-lookup";
+        ResponseEntity<ReadableCategory> byFriendlyUrl = testRestTemplate.exchange(
+                "/api/v1/category/" + friendlyUrl, org.springframework.http.HttpMethod.GET,
+                request, ReadableCategory.class);
+        assertEquals(HttpStatus.OK, byFriendlyUrl.getStatusCode());
+        assertEquals(expected.getId(), byFriendlyUrl.getBody().getId());
+
+        ResponseEntity<String> missingId = testRestTemplate.getForEntity(
+                "/api/v1/category/9223372036854775807", String.class);
+        assertEquals(HttpStatus.NOT_FOUND, missingId.getStatusCode());
+        assertTrue(missingId.getBody().contains("404"));
+
+        ResponseEntity<String> missingUrl = testRestTemplate.getForEntity(
+                "/api/v1/category/does-not-exist", String.class);
+        assertEquals(HttpStatus.NOT_FOUND, missingUrl.getStatusCode());
+        assertTrue(missingUrl.getBody().contains("404"));
+    }
+}
