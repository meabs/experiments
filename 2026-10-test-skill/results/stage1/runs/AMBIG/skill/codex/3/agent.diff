+package com.salesmanager.test.shop.integration.category;
+
+import static org.hamcrest.CoreMatchers.is;
+import static org.junit.Assert.assertThat;
+import static org.junit.Assert.assertNotNull;
+import static org.springframework.http.HttpStatus.NOT_FOUND;
+import static org.springframework.http.HttpStatus.OK;
+import static org.springframework.http.HttpStatus.CREATED;
+
+import java.util.Collections;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.boot.test.web.client.TestRestTemplate;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.catalog.category.ReadableCategory;
+import com.salesmanager.shop.model.catalog.category.ReadableCategoryList;
+import com.salesmanager.shop.model.catalog.category.PersistableCategory;
+import com.salesmanager.shop.model.catalog.category.CategoryDescription;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@RunWith(SpringRunner.class)
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+public class CategoryLookupAPIIntegrationTest extends ServicesTestSupport {
+
+	@Autowired
+	private TestRestTemplate restTemplate;
+
+	@Test
+	public void looksUpCategoryByIdAndFriendlyUrlAndReturnsNotFoundWhenMissing() {
+		HttpEntity<String> request = new HttpEntity<>(getHeader());
+		PersistableCategory newCategory = new PersistableCategory();
+		newCategory.setCode("api-lookup-category");
+		newCategory.setVisible(true);
+		newCategory.setDepth(0);
+		CategoryDescription description = new CategoryDescription();
+		description.setLanguage("en");
+		description.setName("API lookup category");
+		description.setFriendlyUrl("api-lookup-category");
+		newCategory.setDescriptions(Collections.singletonList(description));
+		ResponseEntity<PersistableCategory> created = restTemplate.postForEntity("/api/v1/private/category",
+				new HttpEntity<>(newCategory, request.getHeaders()), PersistableCategory.class);
+		assertThat(created.getStatusCode(), is(CREATED));
+		Long categoryId = created.getBody().getId();
+		String friendlyUrl = description.getFriendlyUrl();
+
+		ResponseEntity<ReadableCategory> byId = restTemplate.exchange("/api/v1/category/" + categoryId,
+				HttpMethod.GET, request, ReadableCategory.class);
+		ResponseEntity<ReadableCategory> byUrl = restTemplate.exchange("/api/v1/category/" + friendlyUrl,
+				HttpMethod.GET, request, ReadableCategory.class);
+		assertThat(byId.getStatusCode(), is(OK));
+		assertThat(byUrl.getStatusCode(), is(OK));
+		assertNotNull(byId.getBody());
+		assertThat(byId.getBody().getId(), is(categoryId));
+		assertThat(byUrl.getBody().getId(), is(categoryId));
+
+		assertThat(restTemplate.exchange("/api/v1/category/999999999", HttpMethod.GET, request,
+				ReadableCategory.class).getStatusCode(), is(NOT_FOUND));
+		assertThat(restTemplate.exchange("/api/v1/category/does-not-exist", HttpMethod.GET, request,
+				ReadableCategory.class).getStatusCode(), is(NOT_FOUND));
+	}
+}
