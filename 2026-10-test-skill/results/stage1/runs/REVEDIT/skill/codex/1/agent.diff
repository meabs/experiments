+package com.salesmanager.test.shop.integration.product;
+
+import static org.hamcrest.CoreMatchers.is;
+import static org.junit.Assert.assertThat;
+import static org.springframework.http.HttpStatus.CREATED;
+import static org.springframework.http.HttpStatus.NOT_FOUND;
+import static org.springframework.http.HttpStatus.OK;
+
+import java.util.Map;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+
+import com.salesmanager.shop.model.catalog.product.PersistableProductReview;
+import com.salesmanager.shop.model.catalog.product.ReadableProduct;
+import com.salesmanager.shop.model.catalog.product.product.PersistableProduct;
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.customer.PersistableCustomer;
+import com.salesmanager.core.model.customer.CustomerGender;
+import com.salesmanager.shop.model.customer.address.Address;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+/** Client-level coverage for the complete product-review lifecycle. */
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(org.springframework.test.context.junit4.SpringRunner.class)
+public class ProductReviewApiIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void reviewLifecycleUpdatesAndRemovesProductRating() {
+        PersistableProduct product = product("review-api-" + System.nanoTime());
+        product.setSku(product.getInventory().getSku());
+        ResponseEntity<ReadableProduct> createdProduct = testRestTemplate.postForEntity(
+                "/api/v1/private/product?store=DEFAULT", new HttpEntity<>(product, getHeader()), ReadableProduct.class);
+        Long productId = createdProduct.getBody().getId();
+        String sku = createdProduct.getBody().getSku();
+        String path = "/api/v1/private/products/" + productId + "/reviews?store=DEFAULT";
+        PersistableProductReview review = new PersistableProductReview();
+        PersistableCustomer customer = new PersistableCustomer();
+        customer.setEmailAddress("review-api-" + System.nanoTime() + "@test.com");
+        customer.setPassword("clear123");
+        customer.setGender(CustomerGender.M.name());
+        customer.setLanguage("en");
+        customer.setStoreCode("DEFAULT");
+        Address address = new Address();
+        address.setFirstName("Review");
+        address.setLastName("Tester");
+        address.setCountry("BE");
+        customer.setBilling(address);
+        ResponseEntity<PersistableCustomer> registered = testRestTemplate.postForEntity(
+                "/api/v1/customer/register", new HttpEntity<>(customer, getHeader()), PersistableCustomer.class);
+        review.setCustomerId(registered.getBody().getId());
+        review.setProductId(productId);
+        review.setLanguage("en");
+        review.setRating(2D);
+        review.setDescription("API lifecycle review");
+
+        ResponseEntity<PersistableProductReview> created = testRestTemplate.postForEntity(
+                path, new HttpEntity<>(review, getHeader()), PersistableProductReview.class);
+        assertThat(created.getStatusCode(), is(CREATED));
+        Long reviewId = created.getBody().getId();
+
+        review.setId(reviewId);
+        review.setRating(4D);
+        ResponseEntity<PersistableProductReview> updated = testRestTemplate.exchange(
+                path + "/" + reviewId, HttpMethod.PUT,
+                new HttpEntity<>(review, getHeader()), PersistableProductReview.class);
+        assertThat(updated.getStatusCode(), is(OK));
+
+        ResponseEntity<Map> productResponse = testRestTemplate.getForEntity(
+                "/api/v2/product/" + sku + "?store=DEFAULT", Map.class);
+        assertThat(productResponse.getBody().get("rating"), is(4.0));
+        assertThat(productResponse.getBody().get("ratingCount"), is(1));
+
+        ResponseEntity<Void> deleted = testRestTemplate.exchange(
+                path + "/" + reviewId, HttpMethod.DELETE,
+                new HttpEntity<>(getHeader()), Void.class);
+        assertThat(deleted.getStatusCode(), is(OK));
+
+        ResponseEntity<Void> missing = testRestTemplate.exchange(
+                path + "/" + reviewId, HttpMethod.DELETE,
+                new HttpEntity<>(getHeader()), Void.class);
+        assertThat(missing.getStatusCode(), is(NOT_FOUND));
+    }
+}
