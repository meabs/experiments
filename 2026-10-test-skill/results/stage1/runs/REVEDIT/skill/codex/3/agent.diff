+	@Override
+	public void delete(ProductReview review) throws ServiceException {
+		Product product = productService.getById(review.getProduct().getId());
+		super.delete(review);
+		recalculateRating(product);
+		productService.update(product);
+	}
+
+	private void recalculateRating(Product product) {
+		List<ProductReview> reviews = productReviewRepository.findByProduct(product.getId());
+		BigDecimal total = reviews.stream().map(ProductReview::getReviewRating)
+				.filter(Objects::nonNull).map(BigDecimal::valueOf).reduce(BigDecimal.ZERO, BigDecimal::add);
+		int count = reviews.size();
+		product.setProductReviewCount(count);
+		product.setProductReviewAvg(count == 0 ? BigDecimal.ZERO : total.divide(BigDecimal.valueOf(count), 10, java.math.RoundingMode.HALF_UP));
+	}
