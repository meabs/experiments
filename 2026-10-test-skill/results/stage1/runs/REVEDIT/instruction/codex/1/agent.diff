+package com.salesmanager.test.shop.api;
+
+import static org.mockito.Mockito.*;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.*;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.review.ProductReviewService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.review.ProductReview;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.shop.store.api.v1.product.ProductReviewApi;
+import com.salesmanager.shop.store.controller.product.facade.ProductCommonFacade;
+import org.junit.Before;
+import org.junit.Test;
+import org.springframework.test.util.ReflectionTestUtils;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+
+public class ProductReviewApiTest {
+  private MockMvc client;
+  private ProductReviewService reviews;
+  private ProductCommonFacade facade;
+
+  @Before
+  public void setUp() {
+    ProductReviewApi api = new ProductReviewApi();
+    reviews = mock(ProductReviewService.class);
+    facade = mock(ProductCommonFacade.class);
+    ReflectionTestUtils.setField(api, "productReviewService", reviews);
+    ReflectionTestUtils.setField(api, "productCommonFacade", facade);
+    ReflectionTestUtils.setField(api, "productService", mock(ProductService.class));
+    client = MockMvcBuilders.standaloneSetup(api).build();
+  }
+
+  @Test
+  public void clientCanEditAndDeleteReviewAndUnknownReviewIsNotFound() throws Exception {
+    Product product = new Product();
+    product.setId(7L);
+    Customer customer = new Customer();
+    customer.setId(9L);
+    ProductReview existing = new ProductReview();
+    existing.setId(11L);
+    existing.setProduct(product);
+    existing.setCustomer(customer);
+    when(reviews.getById(11L)).thenReturn(existing);
+
+    String body = "{\"customerId\":9,\"rating\":4,\"description\":\"updated\"}";
+    client.perform(put("/api/v1/private/products/7/reviews/11")
+        .contentType("application/json").content(body)).andExpect(status().isOk());
+    client.perform(delete("/api/v1/private/products/7/reviews/11"))
+        .andExpect(status().isOk());
+    client.perform(delete("/api/v1/private/products/7/reviews/999"))
+        .andExpect(status().isNotFound());
+
+    verify(facade).saveOrUpdateReview(any(), any(), any());
+    verify(facade).deleteReview(eq(existing), any(), any());
+  }
+}
