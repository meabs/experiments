@@ -0,0 +1,47 @@
+package com.salesmanager.test.shop.integration.product;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.catalog.product.PersistableProductReview;
+import com.salesmanager.shop.model.catalog.product.ReadableProductReview;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+/** Exercises review mutation through the same HTTP client surface as a moderator. */
+@RunWith(SpringRunner.class)
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+public class ProductReviewApiIntegrationTest extends ServicesTestSupport {
+
+  @Test
+  public void updateAndDeleteReviewReturnNotFoundForUnknownReview() {
+    long productId = 1L;
+    long unknownReviewId = Long.MAX_VALUE;
+    PersistableProductReview body = new PersistableProductReview();
+    body.setProductId(productId);
+    body.setCustomerId(1L);
+    body.setRating(4D);
+    body.setDescription("api regression");
+    HttpEntity<PersistableProductReview> request = new HttpEntity<>(body, getHeader());
+
+    ResponseEntity<ReadableProductReview> update = testRestTemplate.exchange(
+        "/api/v1/private/products/" + productId + "/reviews/" + unknownReviewId,
+        HttpMethod.PUT, request, ReadableProductReview.class);
+    ResponseEntity<Void> delete = testRestTemplate.exchange(
+        "/api/v1/private/products/" + productId + "/reviews/" + unknownReviewId,
+        HttpMethod.DELETE, new HttpEntity<>(getHeader()), Void.class);
+
+    assertEquals(404, update.getStatusCodeValue());
+    assertEquals(404, delete.getStatusCodeValue());
+    assertNotNull(update);
+  }
+}
