@@ -0,0 +1,53 @@
+package com.salesmanager.test.shop.integration.product;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+
+import java.util.Map;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.customer.ReadableCustomer;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class ProductReviewApiIntegrationTest extends ServicesTestSupport {
+
+  @Test
+  public void clientCanEditAndDeleteReviewAndProductRatingFollowsReviews() {
+    Long customerId = fetchCustomers().getCustomers().stream().map(ReadableCustomer::getId).findFirst().orElseThrow();
+    HttpEntity<String> request = new HttpEntity<>(
+        "{\"customerId\":" + customerId + ",\"rating\":2,\"description\":\"api review\"}", getHeader());
+    ResponseEntity<Map> created = testRestTemplate.postForEntity(
+        "/api/v1/private/products/1/reviews", request, Map.class);
+    assertEquals(HttpStatus.CREATED, created.getStatusCode());
+    Number reviewId = (Number) created.getBody().get("id");
+    assertNotNull(reviewId);
+
+    request = new HttpEntity<>(
+        "{\"customerId\":" + customerId + ",\"rating\":5,\"description\":\"edited review\"}", getHeader());
+    ResponseEntity<Map> edited = testRestTemplate.exchange(
+        "/api/v1/private/products/1/reviews/" + reviewId, HttpMethod.PUT, request, Map.class);
+    assertEquals(HttpStatus.OK, edited.getStatusCode());
+
+    ResponseEntity<Map> product = testRestTemplate.exchange(
+        "/api/v2/product/", HttpMethod.GET, new HttpEntity<>(getHeader()), Map.class);
+    assertEquals(5.0, ((Number) product.getBody().get("rating")).doubleValue(), 0.001);
+    assertEquals(1, ((Number) product.getBody().get("ratingCount")).intValue());
+
+    ResponseEntity<Void> deleted = testRestTemplate.exchange(
+        "/api/v1/private/products/1/reviews/" + reviewId, HttpMethod.DELETE,
+        new HttpEntity<>(getHeader()), Void.class);
+    assertEquals(HttpStatus.OK, deleted.getStatusCode());
+  }
+}
