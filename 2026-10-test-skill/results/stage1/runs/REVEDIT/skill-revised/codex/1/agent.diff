diff --git a/sm-shop/src/test/java/com/salesmanager/test/shop/integration/product/ProductReviewApiIntegrationTest.java b/sm-shop/src/test/java/com/salesmanager/test/shop/integration/product/ProductReviewApiIntegrationTest.java
