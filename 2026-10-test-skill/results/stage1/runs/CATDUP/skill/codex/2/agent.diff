+package com.salesmanager.test.shop.integration.category;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.springframework.http.HttpStatus.CONFLICT;
+import static org.springframework.http.HttpStatus.CREATED;
+import static org.springframework.http.HttpStatus.OK;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.model.catalog.category.PersistableCategory;
+import com.salesmanager.shop.store.api.exception.ErrorEntity;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@RunWith(SpringRunner.class)
+public class CategoryCodeUniquenessApiIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void rejectsDuplicateCodesOnCreateAndUpdateButAllowsOwnCode() {
+        PersistableCategory first = create("api-unique-first");
+        PersistableCategory second = create("api-unique-second");
+
+        PersistableCategory duplicate = category("api-unique-first");
+        ResponseEntity<ErrorEntity> createConflict = testRestTemplate.postForEntity(
+                "/api/v1/private/category", new HttpEntity<>(duplicate, getHeader()), ErrorEntity.class);
+        assertEquals(CONFLICT, createConflict.getStatusCode());
+        assertNotNull(createConflict.getBody().getMessage());
+
+        PersistableCategory changed = category("api-unique-first");
+        ResponseEntity<ErrorEntity> updateConflict = testRestTemplate.exchange(
+                "/api/v1/private/category/" + second.getId(), HttpMethod.PUT,
+                new HttpEntity<>(changed, getHeader()), ErrorEntity.class);
+        assertEquals(CONFLICT, updateConflict.getStatusCode());
+        assertNotNull(updateConflict.getBody().getMessage());
+
+        PersistableCategory ownCode = category("api-unique-first");
+        ResponseEntity<PersistableCategory> ownUpdate = testRestTemplate.exchange(
+                "/api/v1/private/category/" + first.getId(), HttpMethod.PUT,
+                new HttpEntity<>(ownCode, getHeader()), PersistableCategory.class);
+        assertEquals(OK, ownUpdate.getStatusCode());
+
+    }
+
+    private PersistableCategory create(String code) {
+        ResponseEntity<PersistableCategory> response = testRestTemplate.postForEntity(
+                "/api/v1/private/category", new HttpEntity<>(category(code), getHeader()), PersistableCategory.class);
+        assertEquals(CREATED, response.getStatusCode());
+        assertNotNull(response.getBody().getId());
+        return response.getBody();
+    }
+}
