+package com.salesmanager.test.shop.integration.customer;
+
+import static org.hamcrest.core.Is.is;
+import static org.junit.Assert.assertThat;
+import static org.springframework.http.HttpStatus.OK;
+import static org.springframework.http.HttpStatus.UNAUTHORIZED;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.core.business.constants.Constants;
+import com.salesmanager.core.model.customer.CustomerGender;
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.customer.PersistableCustomer;
+import com.salesmanager.shop.model.customer.address.Address;
+import com.salesmanager.shop.store.security.AuthenticationRequest;
+import com.salesmanager.shop.store.security.AuthenticationResponse;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class CustomerAdminUpdateLoginIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void adminUpdateSetsCustomerEmailAndPasswordUsedByLogin() {
+        PersistableCustomer customer = new PersistableCustomer();
+        customer.setEmailAddress("admin-update-before@test.com");
+        customer.setPassword("oldPassword1");
+        customer.setGender(CustomerGender.M.name());
+        customer.setLanguage("en");
+        customer.setStoreCode(Constants.DEFAULT_STORE);
+        Address billing = new Address();
+        billing.setFirstName("Admin");
+        billing.setLastName("Update");
+        billing.setCountry("BE");
+        customer.setBilling(billing);
+
+        ResponseEntity<PersistableCustomer> registration = testRestTemplate.postForEntity(
+                "/api/v1/customer/register", new HttpEntity<>(customer, getHeader()), PersistableCustomer.class);
+        assertThat(registration.getStatusCode(), is(OK));
+
+        PersistableCustomer update = new PersistableCustomer();
+        update.setEmailAddress("admin-update-after@test.com");
+        update.setPassword("newPassword1");
+        update.setGender(CustomerGender.M.name());
+        update.setLanguage("en");
+        update.setStoreCode(Constants.DEFAULT_STORE);
+
+        ResponseEntity<PersistableCustomer> updated = testRestTemplate.exchange(
+                "/api/v1/private/customer/" + registration.getBody().getId(), HttpMethod.PUT,
+                new HttpEntity<>(update, getHeader()), PersistableCustomer.class);
+        assertThat(updated.getStatusCode(), is(OK));
+
+        ResponseEntity<AuthenticationResponse> oldLogin = testRestTemplate.postForEntity(
+                "/api/v1/customer/login",
+                new HttpEntity<>(new AuthenticationRequest("admin-update-before@test.com", "oldPassword1")),
+                AuthenticationResponse.class);
+        assertThat(oldLogin.getStatusCode(), is(UNAUTHORIZED));
+
+        ResponseEntity<AuthenticationResponse> newLogin = testRestTemplate.postForEntity(
+                "/api/v1/customer/login",
+                new HttpEntity<>(new AuthenticationRequest("admin-update-after@test.com", "newPassword1")),
+                AuthenticationResponse.class);
+        assertThat(newLogin.getStatusCode(), is(OK));
+    }
+}
