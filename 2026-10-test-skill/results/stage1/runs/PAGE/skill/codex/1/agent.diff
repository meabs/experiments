+package com.salesmanager.test.shop.integration.product;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotEquals;
+import static org.junit.Assert.assertNotNull;
+
+import javax.inject.Inject;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.boot.test.web.client.TestRestTemplate;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.catalog.product.product.PersistableProduct;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class ProductListPagingAPIIntegrationTest extends ServicesTestSupport {
+
+    @Inject
+    private TestRestTemplate testRestTemplate;
+
+    private final ObjectMapper objectMapper = new ObjectMapper();
+
+    @Test
+    public void productListUsesRequestedPage() throws Exception {
+        createProduct("paging-product-1");
+        createProduct("paging-product-2");
+
+        JsonNode firstPage = getProducts("/api/v2/products?count=1&page=0");
+        JsonNode secondPage = getProducts("/api/v2/products?count=1&page=1");
+        JsonNode pastEnd = getProducts("/api/v2/products?count=1&page=2");
+
+        assertNotEquals(firstPage.get("products"), secondPage.get("products"));
+        assertEquals(0, pastEnd.get("products").size());
+    }
+
+    private void createProduct(String sku) {
+        PersistableProduct product = product(sku);
+        ResponseEntity<PersistableProduct> response = testRestTemplate.postForEntity(
+                "/api/v1/private/product?store=DEFAULT", new HttpEntity<>(product, getHeader()), PersistableProduct.class);
+        assertEquals(HttpStatus.CREATED, response.getStatusCode());
+    }
+
+    private JsonNode getProducts(String path) throws Exception {
+        ResponseEntity<String> response = testRestTemplate.getForEntity(path, String.class);
+        assertEquals(HttpStatus.OK, response.getStatusCode());
+        assertNotNull(response.getBody());
+        return objectMapper.readTree(response.getBody());
+    }
+}
