+package com.salesmanager.test.shop.integration.product;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotEquals;
+import static org.springframework.http.HttpStatus.CREATED;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.core.business.constants.Constants;
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.catalog.product.ReadableProductList;
+import com.salesmanager.shop.model.catalog.product.product.PersistableProduct;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@RunWith(SpringRunner.class)
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+public class ProductV2PagingIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void productsEndpointUsesRequestedPage() {
+        String prefix = "paging-api-" + System.nanoTime();
+        createProduct(prefix + "a");
+        createProduct(prefix + "b");
+
+        String query = "/api/v2/products?name=" + prefix + "&count=1&store=" + Constants.DEFAULT_STORE;
+        ReadableProductList first = testRestTemplate.getForObject(query + "&page=0", ReadableProductList.class);
+        ReadableProductList second = testRestTemplate.getForObject(query + "&page=1", ReadableProductList.class);
+        ReadableProductList pastEnd = testRestTemplate.getForObject(query + "&page=2", ReadableProductList.class);
+
+        assertEquals(1, first.getProducts().size());
+        assertEquals(1, second.getProducts().size());
+        assertNotEquals(first.getProducts().get(0).getId(), second.getProducts().get(0).getId());
+        assertEquals(0, pastEnd.getProducts().size());
+    }
+
+    private void createProduct(String name) {
+        PersistableProduct product = product(name);
+        ResponseEntity<PersistableProduct> response = testRestTemplate.postForEntity(
+                "/api/v1/private/product?store=" + Constants.DEFAULT_STORE,
+                new HttpEntity<>(product, getHeader()), PersistableProduct.class);
+        assertEquals(CREATED, response.getStatusCode());
+    }
+}
