+package com.salesmanager.test.shop.integration.product;
+
+import static org.hamcrest.MatcherAssert.assertThat;
+import static org.hamcrest.Matchers.is;
+import static org.junit.Assert.assertEquals;
+
+import javax.inject.Inject;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.boot.test.web.client.TestRestTemplate;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.catalog.product.ReadableProductList;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class ProductV2PagingAPIIntegrationTest extends ServicesTestSupport {
+
+    @Inject
+    private TestRestTemplate testRestTemplate;
+
+    @Test
+    public void productListUsesPageParameter() {
+        sampleProduct("paging-product-1");
+        sampleProduct("paging-product-2");
+
+        HttpEntity<Void> request = new HttpEntity<>(getHeader());
+        ResponseEntity<ReadableProductList> page0 = getPage(0, request);
+        ResponseEntity<ReadableProductList> page1 = getPage(1, request);
+        ResponseEntity<ReadableProductList> page2 = getPage(2, request);
+
+        assertThat(page0.getStatusCode(), is(HttpStatus.OK));
+        assertThat(page1.getStatusCode(), is(HttpStatus.OK));
+        assertThat(page2.getStatusCode(), is(HttpStatus.OK));
+        assertEquals(1, page0.getBody().getProducts().size());
+        assertEquals(1, page1.getBody().getProducts().size());
+        assertEquals(0, page2.getBody().getProducts().size());
+        assertThat(page0.getBody().getProducts().get(0).getSku(),
+                is("paging-product-1"));
+        assertThat(page1.getBody().getProducts().get(0).getSku(),
+                is("paging-product-2"));
+    }
+
+    private ResponseEntity<ReadableProductList> getPage(int page, HttpEntity<Void> request) {
+        return testRestTemplate.exchange("/api/v2/products?store=DEFAULT&count=1&page=" + page,
+                HttpMethod.GET, request, ReadableProductList.class);
+    }
+}
