+package com.salesmanager.test.shop.integration.customer;
+
+import static org.hamcrest.core.Is.is;
+import static org.junit.Assert.assertThat;
+import static org.springframework.http.HttpStatus.CONFLICT;
+import static org.springframework.http.HttpStatus.OK;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.core.business.constants.Constants;
+import com.salesmanager.core.model.customer.CustomerGender;
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.customer.PersistableCustomer;
+import com.salesmanager.shop.model.customer.address.Address;
+import com.salesmanager.shop.store.api.exception.ErrorEntity;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@RunWith(SpringRunner.class)
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+public class CustomerDuplicateApiIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void duplicateCustomerIsRejectedByRegistrationAndAdminApis() {
+        String email = "duplicate-api@test.com";
+        PersistableCustomer customer = customer(email);
+
+        ResponseEntity<PersistableCustomer> registered = testRestTemplate.postForEntity(
+                "/api/v1/customer/register", new HttpEntity<>(customer, getHeader()), PersistableCustomer.class);
+        assertThat(registered.getStatusCode(), is(OK));
+
+        ResponseEntity<ErrorEntity> registrationDuplicate = testRestTemplate.postForEntity(
+                "/api/v1/customer/register", new HttpEntity<>(customer, getHeader()), ErrorEntity.class);
+        assertThat(registrationDuplicate.getStatusCode(), is(CONFLICT));
+        assertThat(registrationDuplicate.getBody().getErrorCode(), is("409"));
+
+        ResponseEntity<ErrorEntity> adminDuplicate = testRestTemplate.postForEntity(
+                "/api/v1/private/customer", new HttpEntity<>(customer, getHeader()), ErrorEntity.class);
+        assertThat(adminDuplicate.getStatusCode(), is(CONFLICT));
+        assertThat(adminDuplicate.getBody().getErrorCode(), is("409"));
+        assertThat(fetchCustomers().getCustomers().stream()
+                .filter(existing -> email.equals(existing.getEmailAddress())).count(), is(1L));
+    }
+
+    private PersistableCustomer customer(String email) {
+        PersistableCustomer customer = new PersistableCustomer();
+        customer.setEmailAddress(email);
+        customer.setPassword("clear123");
+        customer.setGender(CustomerGender.M.name());
+        customer.setLanguage("en");
+        customer.setStoreCode(Constants.DEFAULT_STORE);
+        Address billing = new Address();
+        billing.setFirstName("duplicate");
+        billing.setLastName("customer");
+        billing.setCountry("BE");
+        customer.setBilling(billing);
+        return customer;
+    }
+}
