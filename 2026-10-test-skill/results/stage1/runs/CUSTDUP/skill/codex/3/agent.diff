+    @Test
+    public void duplicateCustomerEmailReturnsConflictForRegisterAndAdminCreate() {
+        final String email = "duplicate-api-test@test.com";
+        final PersistableCustomer customer = customer(email);
+        final HttpEntity<PersistableCustomer> registration = new HttpEntity<>(customer, getHeader());
+
+        assertThat(testRestTemplate.postForEntity("/api/v1/customer/register", registration,
+                PersistableCustomer.class).getStatusCode(), is(OK));
+
+        final ResponseEntity<String> duplicateRegistration = testRestTemplate.postForEntity(
+                "/api/v1/customer/register", registration, String.class);
+        assertThat(duplicateRegistration.getStatusCode(), is(CONFLICT));
+        assertThat(duplicateRegistration.getBody(), org.hamcrest.Matchers.containsString("409"));
+
+        final ResponseEntity<String> duplicateAdminCreate = testRestTemplate.postForEntity(
+                "/api/v1/private/customer", new HttpEntity<>(customer, getHeader()), String.class);
+        assertThat(duplicateAdminCreate.getStatusCode(), is(CONFLICT));
+        assertThat(duplicateAdminCreate.getBody(), org.hamcrest.Matchers.containsString("409"));
+    }
