+    @Test
+    @Order(8)
+    public void cartApiCalculatesLineAndCartAmountsForQuantities() {
+        ReadableProduct first = sampleProduct("quantityPriceFirst");
+        ReadableProduct second = sampleProduct("quantityPriceSecond");
+
+        PersistableShoppingCartItem firstItem = new PersistableShoppingCartItem();
+        firstItem.setProduct(first.getSku());
+        firstItem.setQuantity(2);
+        ResponseEntity<ReadableShoppingCart> created = testRestTemplate.postForEntity(
+                "/api/v1/cart/", new HttpEntity<>(firstItem, getHeader()), ReadableShoppingCart.class);
+
+        PersistableShoppingCartItem secondItem = new PersistableShoppingCartItem();
+        secondItem.setProduct(second.getSku());
+        secondItem.setQuantity(3);
+        ResponseEntity<ReadableShoppingCart> updated = testRestTemplate.exchange(
+                "/api/v1/cart/" + created.getBody().getCode(), HttpMethod.PUT,
+                new HttpEntity<>(secondItem, getHeader()), ReadableShoppingCart.class);
+
+        ResponseEntity<ReadableShoppingCart> fetched = testRestTemplate.getForEntity(
+                "/api/v1/cart/" + created.getBody().getCode(), ReadableShoppingCart.class);
+        ReadableShoppingCart cart = fetched.getBody();
+        BigDecimal lineTotal = cart.getProducts().stream().map(item -> item.getSubTotal()).reduce(BigDecimal.ZERO, BigDecimal::add);
+
+        assertThat(updated.getBody().getQuantity(), is(5));
+        assertThat(cart.getProducts().stream().mapToInt(item -> item.getQuantity()).sum(), is(5));
+        assertEquals(lineTotal, cart.getSubtotal());
+        assertEquals(lineTotal, cart.getTotal());
+        cart.getProducts().forEach(item -> assertEquals(
+                new BigDecimal(item.getFinalPrice().replaceAll("[^0-9.-]", ""))
+                        .multiply(BigDecimal.valueOf(item.getQuantity())),
+                item.getSubTotal()));
+    }
+
