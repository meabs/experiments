+    @Test
+    public void cartTotalsIncludeEveryUnit() throws Exception {
+        ReadableProduct first = sampleProduct("quantityTotalsFirst");
+        ReadableProduct second = sampleProduct("quantityTotalsSecond");
+
+        PersistableShoppingCartItem firstItem = new PersistableShoppingCartItem();
+        firstItem.setProduct(first.getSku());
+        firstItem.setQuantity(2);
+        ResponseEntity<ReadableShoppingCart> created = testRestTemplate.postForEntity(
+                "/api/v1/cart/", new HttpEntity<>(firstItem, getHeader()), ReadableShoppingCart.class);
+
+        PersistableShoppingCartItem secondItem = new PersistableShoppingCartItem();
+        secondItem.setProduct(second.getSku());
+        secondItem.setQuantity(3);
+        ResponseEntity<ReadableShoppingCart> response = testRestTemplate.exchange(
+                "/api/v1/cart/" + created.getBody().getCode(), HttpMethod.PUT,
+                new HttpEntity<>(secondItem, getHeader()), ReadableShoppingCart.class);
+
+        assertThat(response.getStatusCode(), is(CREATED));
+        ReadableShoppingCart cart = response.getBody();
+        assertEquals(5, cart.getQuantity());
+        assertEquals(first.getPrice().multiply(java.math.BigDecimal.valueOf(2)),
+                cart.getProducts().get(0).getSubTotal());
+        assertEquals(second.getPrice().multiply(java.math.BigDecimal.valueOf(3)),
+                cart.getProducts().get(1).getSubTotal());
+        assertEquals(cart.getProducts().get(0).getSubTotal().add(cart.getProducts().get(1).getSubTotal()),
+                cart.getSubtotal());
+        assertEquals(cart.getSubtotal(), cart.getTotal());
+    }
