+	@Test
+	public void rejectsTaxRatesOutsideRangeOrMissingAndDoesNotUpdateExistingRate() {
+		final HttpHeaders headers = getHeader();
+		final String endpoint = "/api/v1/private/tax/rate/";
+
+		PersistableTaxRate invalid = taxRate("invalid-tax-rate");
+		invalid.setRate(new BigDecimal("150"));
+		ResponseEntity<String> tooHigh = testRestTemplate.postForEntity(endpoint,
+				new HttpEntity<>(invalid, headers), String.class);
+		assertEquals(HttpStatus.BAD_REQUEST, tooHigh.getStatusCode());
+		assertNotNull(tooHigh.getBody());
+
+		invalid.setCode("negative-tax-rate");
+		invalid.setRate(new BigDecimal("-1"));
+		ResponseEntity<String> negative = testRestTemplate.postForEntity(endpoint,
+				new HttpEntity<>(invalid, headers), String.class);
+		assertEquals(HttpStatus.BAD_REQUEST, negative.getStatusCode());
+
+		invalid.setCode("missing-tax-rate");
+		invalid.setRate(null);
+		ResponseEntity<String> missing = testRestTemplate.postForEntity(endpoint,
+				new HttpEntity<>(invalid, headers), String.class);
+		assertEquals(HttpStatus.BAD_REQUEST, missing.getStatusCode());
+
+		PersistableTaxRate valid = taxRate("update-tax-rate");
+		valid.setRate(new BigDecimal("5"));
+		ResponseEntity<Entity> created = testRestTemplate.postForEntity(endpoint,
+				new HttpEntity<>(valid, headers), Entity.class);
+		assertEquals(HttpStatus.OK, created.getStatusCode());
+
+		valid.setRate(new BigDecimal("101"));
+		ResponseEntity<String> update = testRestTemplate.exchange(endpoint + created.getBody().getId(),
+				HttpMethod.PUT, new HttpEntity<>(valid, headers), String.class);
+		assertEquals(HttpStatus.BAD_REQUEST, update.getStatusCode());
+
+		ResponseEntity<com.salesmanager.shop.model.tax.ReadableTaxRate> unchanged = testRestTemplate.exchange(
+				endpoint + created.getBody().getId(), HttpMethod.GET, new HttpEntity<>(headers),
+				com.salesmanager.shop.model.tax.ReadableTaxRate.class);
+		assertEquals(HttpStatus.OK, unchanged.getStatusCode());
+		assertEquals(0, new BigDecimal("5").compareTo(new BigDecimal(unchanged.getBody().getRate())));
+	}
+
+	private PersistableTaxRate taxRate(String code) {
+		PersistableTaxRate rate = new PersistableTaxRate();
