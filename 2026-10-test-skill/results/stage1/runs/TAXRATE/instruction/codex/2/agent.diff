+        assertEquals(400, missingResponse.getStatusCodeValue());
+
+        PersistableTaxRate valid = new PersistableTaxRate();
+        valid.setCode("tax-update-validation");
+        valid.setRate(new BigDecimal("5"));
+        valid.setCountry("US");
+        valid.setTaxClass("DEFAULT");
+        valid.setZone("NY");
+        TaxRateDescription description = new TaxRateDescription();
+        description.setLanguage("en");
+        description.setName("Tax update validation");
+        valid.getDescriptions().add(description);
+        Entity created = testRestTemplate.postForEntity("/api/v1/private/tax/rate/",
+                new HttpEntity<>(valid, getHeader()), Entity.class).getBody();
+        assertNotNull(created.getId());
+
+        valid.setRate(new BigDecimal("150"));
+        ResponseEntity<Void> updateResponse = testRestTemplate.exchange(
+                "/api/v1/private/tax/rate/" + created.getId(), HttpMethod.PUT,
+                new HttpEntity<>(valid, getHeader()), Void.class);
+        assertEquals(400, updateResponse.getStatusCodeValue());
+
+        ResponseEntity<ReadableTaxRate> stored = testRestTemplate.exchange(
+                "/api/v1/private/tax/rate/" + created.getId(), HttpMethod.GET,
+                new HttpEntity<>(getHeader()), ReadableTaxRate.class);
+        assertEquals(0, new BigDecimal("5").compareTo(new BigDecimal(stored.getBody().getRate())));
