+            PersistableTaxRate invalid = new PersistableTaxRate();
+            invalid.setCode("invalid-tax-" + invalidRate.toPlainString().replace('.', '_'));
+            invalid.setRate(invalidRate);
+
+            ResponseEntity<Void> response = testRestTemplate.postForEntity(
+                    "/api/v1/private/tax/rate/", new HttpEntity<>(invalid, getHeader()), Void.class);
+
+            assertEquals(400, response.getStatusCodeValue());
+            ResponseEntity<EntityExists> exists = testRestTemplate.exchange(
+                    "/api/v1/private/tax/rate/unique?code=" + invalid.getCode(), HttpMethod.GET,
+                    new HttpEntity<>(getHeader()), EntityExists.class);
+            assertTrue(!exists.getBody().isExists());
+        }
+
+        PersistableTaxRate missingRate = new PersistableTaxRate();
+        missingRate.setCode("invalid-tax-missing");
+        ResponseEntity<Void> missingResponse = testRestTemplate.postForEntity(
