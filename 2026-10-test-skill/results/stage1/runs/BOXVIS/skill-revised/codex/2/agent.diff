+package com.salesmanager.test.shop.integration.content;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertThat;
+import static org.hamcrest.CoreMatchers.is;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@RunWith(SpringRunner.class)
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+public class ContentBoxVisibilityApiIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void hiddenBoxIsNotAvailableFromStorefront() throws Exception {
+        String code = "hidden-api-box-" + System.currentTimeMillis();
+        String request = "{\"code\":\"" + code
+                + "\",\"visible\":false,\"descriptions\":[{\"language\":\"en\",\"name\":\"Hidden\",\"description\":\"Hidden box\"}]}";
+        ResponseEntity<String> created = testRestTemplate.postForEntity("/api/v1/private/content/box",
+                new HttpEntity<>(request, getHeader()), String.class);
+        assertThat(created.getStatusCode(), is(HttpStatus.CREATED));
+
+        ResponseEntity<String> list = testRestTemplate.exchange("/api/v1/content/boxes?page=0&count=100",
+                HttpMethod.GET, new HttpEntity<>(getHeader()), String.class);
+        assertThat(list.getStatusCode(), is(HttpStatus.OK));
+        JsonNode items = new ObjectMapper().readTree(list.getBody()).path("items");
+        for (JsonNode item : items) {
+            assertFalse(code.equals(item.path("code").asText()));
+        }
+
+        ResponseEntity<String> read = testRestTemplate.exchange("/api/v1/content/boxes/" + code,
+                HttpMethod.GET, new HttpEntity<>(getHeader()), String.class);
+        assertThat(read.getStatusCode(), is(HttpStatus.NOT_FOUND));
+    }
+}
