+package com.salesmanager.test.shop.integration.content;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertEquals;
+
+import java.util.Collections;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+import org.springframework.boot.test.web.client.TestRestTemplate;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.content.box.PersistableContentBox;
+import com.salesmanager.shop.model.content.common.ContentDescription;
+import com.salesmanager.shop.model.entity.Entity;
+import com.salesmanager.shop.model.entity.ReadableEntityList;
+import com.salesmanager.shop.model.content.box.ReadableContentBox;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@RunWith(SpringRunner.class)
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+public class ContentBoxVisibilityApiIntegrationTest extends ServicesTestSupport {
+
+    @Autowired
+    private TestRestTemplate restTemplate;
+
+    @Test
+    public void hiddenBoxIsNotExposedByStorefrontApi() {
+        String code = "hidden-api-box-" + System.nanoTime();
+        PersistableContentBox box = new PersistableContentBox();
+        box.setCode(code);
+        box.setVisible(false);
+        ContentDescription description = new ContentDescription();
+        description.setLanguage("en");
+        description.setName(code);
+        description.setDescription("hidden content");
+        box.setDescriptions(Collections.singletonList(description));
+
+        HttpEntity<PersistableContentBox> request = new HttpEntity<>(box, getHeader());
+        ResponseEntity<Entity> created = restTemplate.postForEntity("/api/v1/private/content/box", request, Entity.class);
+        assertEquals(HttpStatus.CREATED, created.getStatusCode());
+
+        HttpEntity<Void> storefrontRequest = new HttpEntity<>(getHeader());
+        ResponseEntity<ReadableEntityList> list = restTemplate.exchange(
+                "/api/v1/content/boxes?page=0&count=100", org.springframework.http.HttpMethod.GET,
+                storefrontRequest, ReadableEntityList.class);
+        assertFalse(((java.util.List<?>) list.getBody().getItems()).stream()
+                .anyMatch(item -> code.equals(((java.util.Map<?, ?>) item).get("code"))));
+
+        ResponseEntity<String> byCode = restTemplate.exchange("/api/v1/content/boxes/" + code,
+                org.springframework.http.HttpMethod.GET, storefrontRequest, String.class);
+        assertEquals(HttpStatus.NOT_FOUND, byCode.getStatusCode());
+    }
+}
