diff --git a/sm-shop/src/test/java/com/salesmanager/test/shop/integration/content/ContentBoxVisibilityApiIntegrationTest.java b/sm-shop/src/test/java/com/salesmanager/test/shop/integration/content/ContentBoxVisibilityApiIntegrationTest.java
