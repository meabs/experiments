+package com.salesmanager.test.shop.integration.content;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertEquals;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+import com.salesmanager.shop.application.ShopApplication;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(org.springframework.test.context.junit4.SpringRunner.class)
+public class ContentBoxVisibilityApiIntegrationTest extends ServicesTestSupport {
+
+	@Test
+	public void hiddenBoxIsNotExposedByStorefrontApi() throws Exception {
+		String code = "hidden-api-box";
+		String json = "{\"code\":\"" + code
+				+ "\",\"visible\":false,\"descriptions\":[{\"language\":\"en\",\"name\":\"Hidden\",\"description\":\"Hidden box\"}]}";
+		ResponseEntity<String> created = testRestTemplate.exchange("/api/v1/private/content/box",
+				HttpMethod.POST, new HttpEntity<>(json, getHeader()), String.class);
+		assertEquals(HttpStatus.CREATED, created.getStatusCode());
+
+		ResponseEntity<String> list = testRestTemplate.getForEntity("/api/v1/content/boxes?page=0&count=100",
+				String.class);
+		JsonNode items = new ObjectMapper().readTree(list.getBody()).path("items");
+		for (JsonNode item : items) {
+			assertFalse(code.equals(item.path("code").asText()));
+		}
+
+		ResponseEntity<String> read = testRestTemplate.getForEntity("/api/v1/content/boxes/" + code, String.class);
+		assertEquals(HttpStatus.NOT_FOUND, read.getStatusCode());
+	}
+}
