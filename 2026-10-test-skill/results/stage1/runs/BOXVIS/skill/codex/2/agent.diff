+package com.salesmanager.test.shop.integration.content;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.Map;
+
+import javax.inject.Inject;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.boot.test.web.client.TestRestTemplate;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.content.box.ReadableContentBox;
+import com.salesmanager.shop.model.entity.ReadableEntityList;
+import com.salesmanager.shop.model.entity.Entity;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class ContentBoxVisibilityApiIntegrationTest extends ServicesTestSupport {
+
+    @Inject
+    private TestRestTemplate client;
+
+    @Test
+    public void hiddenBoxIsNotExposedByStorefrontApi() {
+        String code = "api-hidden-box";
+        Map<String, Object> box = new HashMap<>();
+        box.put("code", code);
+        box.put("visible", false);
+        Map<String, Object> description = new HashMap<>();
+        description.put("language", "en");
+        description.put("name", "Hidden box");
+        description.put("description", "Not live");
+        box.put("descriptions", Collections.singletonList(description));
+
+        ResponseEntity<Entity> created = client.exchange("/api/v1/private/content/box", HttpMethod.POST,
+                new HttpEntity<>(box, getHeader()), Entity.class);
+        assertEquals(HttpStatus.CREATED, created.getStatusCode());
+
+        HttpHeaders headers = new HttpHeaders();
+        ResponseEntity<ReadableEntityList> list = client.exchange("/api/v1/content/boxes?page=0&count=100",
+                HttpMethod.GET, new HttpEntity<>(headers), ReadableEntityList.class);
+        assertEquals(HttpStatus.OK, list.getStatusCode());
+        assertTrue(list.getBody().getItems().stream().noneMatch(item -> code.equals(((ReadableContentBox) item).getCode())));
+
+        ResponseEntity<String> read = client.exchange("/api/v1/content/boxes/" + code, HttpMethod.GET,
+                new HttpEntity<>(headers), String.class);
+        assertEquals(HttpStatus.NOT_FOUND, read.getStatusCode());
+    }
+}
