+package com.salesmanager.test.shop.integration.cart;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+import static org.springframework.http.HttpStatus.CREATED;
+import static org.springframework.http.HttpStatus.OK;
+
+import java.math.BigDecimal;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit.jupiter.SpringExtension;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.web.client.TestRestTemplate;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.catalog.product.ReadableProduct;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@ExtendWith(SpringExtension.class)
+class EmptyShoppingCartAPIIntegrationTest extends ServicesTestSupport {
+
+    @Autowired
+    private TestRestTemplate client;
+
+    @Test
+    void deletingLastProductKeepsCartReadableAndReusable() {
+        ReadableProduct product = sampleProduct("emptyCartApi");
+        PersistableShoppingCartItem item = new PersistableShoppingCartItem();
+        item.setProduct(product.getSku());
+        item.setQuantity(1);
+        HttpEntity<PersistableShoppingCartItem> request = new HttpEntity<>(item, getHeader());
+
+        ResponseEntity<ReadableShoppingCart> created = client.postForEntity("/api/v1/cart", request,
+                ReadableShoppingCart.class);
+        assertEquals(CREATED, created.getStatusCode());
+        String code = created.getBody().getCode();
+
+        ResponseEntity<ReadableShoppingCart> deleted = client.exchange(
+                "/api/v1/cart/" + code + "/product/" + product.getSku() + "?body=true", HttpMethod.DELETE,
+                new HttpEntity<>(getHeader()), ReadableShoppingCart.class);
+        assertEquals(OK, deleted.getStatusCode());
+
+        ResponseEntity<ReadableShoppingCart> empty = client.exchange("/api/v1/cart/" + code, HttpMethod.GET,
+                new HttpEntity<>(getHeader()), ReadableShoppingCart.class);
+        assertEquals(OK, empty.getStatusCode());
+        assertNotNull(empty.getBody());
+        assertEquals(0, empty.getBody().getQuantity());
+        assertEquals(BigDecimal.ZERO, empty.getBody().getSubtotal());
+
+        ResponseEntity<ReadableShoppingCart> reused = client.exchange("/api/v1/cart/" + code, HttpMethod.PUT,
+                request, ReadableShoppingCart.class);
+        assertEquals(CREATED, reused.getStatusCode());
+        assertEquals(1, reused.getBody().getQuantity());
+    }
+}
