+package com.salesmanager.test.shop.integration.cart;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.boot.test.web.client.TestRestTemplate;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit.jupiter.SpringExtension;
+import org.junit.jupiter.api.extension.ExtendWith;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.catalog.product.ReadableProduct;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@ExtendWith(SpringExtension.class)
+class EmptyShoppingCartAPIIntegrationTest extends ServicesTestSupport {
+
+    @Autowired
+    private TestRestTemplate restTemplate;
+
+    @Test
+    void deletingLastProductKeepsCartAvailableAndReusable() {
+        ReadableProduct product = sampleProduct("emptyCartApi");
+        PersistableShoppingCartItem item = new PersistableShoppingCartItem();
+        item.setProduct(product.getSku());
+        item.setQuantity(1);
+
+        ResponseEntity<ReadableShoppingCart> created = restTemplate.postForEntity(
+                "/api/v1/cart", new HttpEntity<>(item, getHeader()), ReadableShoppingCart.class);
+        assertEquals(HttpStatus.CREATED, created.getStatusCode());
+        String cartCode = created.getBody().getCode();
+
+        ResponseEntity<ReadableShoppingCart> deleted = restTemplate.exchange(
+                "/api/v1/cart/" + cartCode + "/product/" + product.getSku(), HttpMethod.DELETE,
+                new HttpEntity<>(getHeader()), ReadableShoppingCart.class);
+        assertEquals(HttpStatus.NO_CONTENT, deleted.getStatusCode());
+
+        ResponseEntity<ReadableShoppingCart> empty = restTemplate.exchange(
+                "/api/v1/cart/" + cartCode, HttpMethod.GET, new HttpEntity<>(getHeader()),
+                ReadableShoppingCart.class);
+        assertEquals(HttpStatus.OK, empty.getStatusCode());
+        assertNotNull(empty.getBody());
+        assertEquals(cartCode, empty.getBody().getCode());
+        assertEquals(0, empty.getBody().getQuantity());
+        assertEquals(0, empty.getBody().getSubtotal().signum());
+
+        ResponseEntity<ReadableShoppingCart> reused = restTemplate.exchange(
+                "/api/v1/cart/" + cartCode, HttpMethod.PUT,
+                new HttpEntity<>(item, getHeader()), ReadableShoppingCart.class);
+        assertEquals(HttpStatus.CREATED, reused.getStatusCode());
+        assertEquals(cartCode, reused.getBody().getCode());
+        assertEquals(1, reused.getBody().getQuantity());
+    }
+}
