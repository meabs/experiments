+package com.salesmanager.test.shop.integration.cart;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertThat;
+import static org.hamcrest.core.Is.is;
+import static org.springframework.http.HttpStatus.CREATED;
+import static org.springframework.http.HttpStatus.OK;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+import org.springframework.boot.test.web.client.TestRestTemplate;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.catalog.product.ReadableProduct;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+public class EmptyShoppingCartAPIIntegrationTest extends ServicesTestSupport {
+
+    @Autowired
+    private TestRestTemplate restTemplate;
+
+    @Test
+    public void emptyCartRemainsReadableAndCanBeReused() {
+        ReadableProduct deleteProduct = sampleProduct("empty-cart-delete");
+        String deleteCart = addCart(deleteProduct);
+
+        ResponseEntity<ReadableShoppingCart> deleted = restTemplate.exchange(
+                "/api/v1/cart/" + deleteCart + "/product/" + deleteProduct.getSku() + "?body=true",
+                HttpMethod.DELETE, new HttpEntity<>(getHeader()), ReadableShoppingCart.class);
+        assertThat(deleted.getStatusCode(), is(OK));
+
+        assertEmpty(deleteCart);
+        ReadableProduct replacement = sampleProduct("empty-cart-replacement");
+        ResponseEntity<ReadableShoppingCart> reused = restTemplate.exchange("/api/v1/cart/" + deleteCart,
+                HttpMethod.PUT, new HttpEntity<>(item(replacement, 1), getHeader()), ReadableShoppingCart.class);
+        assertThat(reused.getStatusCode(), is(CREATED));
+        assertEquals(1, reused.getBody().getQuantity());
+
+        ReadableProduct zeroProduct = sampleProduct("empty-cart-zero");
+        String zeroCart = addCart(zeroProduct);
+        ResponseEntity<ReadableShoppingCart> zeroed = restTemplate.exchange("/api/v1/cart/" + zeroCart,
+                HttpMethod.PUT, new HttpEntity<>(item(zeroProduct, 0), getHeader()), ReadableShoppingCart.class);
+        assertThat(zeroed.getStatusCode(), is(CREATED));
+        assertEmpty(zeroCart);
+    }
+
+    private String addCart(ReadableProduct product) {
+        ResponseEntity<ReadableShoppingCart> response = restTemplate.postForEntity("/api/v1/cart",
+                new HttpEntity<>(item(product, 1), getHeader()), ReadableShoppingCart.class);
+        assertThat(response.getStatusCode(), is(CREATED));
+        assertNotNull(response.getBody());
+        return response.getBody().getCode();
+    }
+
+    private PersistableShoppingCartItem item(ReadableProduct product, int quantity) {
+        PersistableShoppingCartItem item = new PersistableShoppingCartItem();
+        item.setProduct(product.getSku());
+        item.setQuantity(quantity);
+        return item;
+    }
+
+    private void assertEmpty(String code) {
+        ResponseEntity<ReadableShoppingCart> response = restTemplate.exchange("/api/v1/cart/" + code,
+                HttpMethod.GET, new HttpEntity<>(getHeader()), ReadableShoppingCart.class);
+        assertThat(response.getStatusCode(), is(OK));
+        assertEquals(0, response.getBody().getProducts().size());
+        assertEquals(0, response.getBody().getSubtotal().signum());
+    }
+}
