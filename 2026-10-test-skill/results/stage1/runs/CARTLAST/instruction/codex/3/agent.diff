+    @Test
+    @Order(8)
+    public void emptyCartRemainsAvailableThroughApi() throws Exception {
+        ReadableProduct product = sampleProduct("emptyCartRemainsAvailable");
+        PersistableShoppingCartItem item = new PersistableShoppingCartItem();
+        item.setProduct(product.getSku());
+        item.setQuantity(1);
+
+        ResponseEntity<ReadableShoppingCart> created = testRestTemplate.postForEntity(
+                "/api/v1/cart", new HttpEntity<>(item, getHeader()), ReadableShoppingCart.class);
+        String cartCode = created.getBody().getCode();
+
+        ResponseEntity<ReadableShoppingCart> deleted = testRestTemplate.exchange(
+                "/api/v1/cart/" + cartCode + "/product/" + product.getSku(), HttpMethod.DELETE,
+                null, ReadableShoppingCart.class);
+        assertThat(deleted.getStatusCode(), is(NO_CONTENT));
+
+        ResponseEntity<ReadableShoppingCart> empty = testRestTemplate.getForEntity(
+                "/api/v1/cart/" + cartCode, ReadableShoppingCart.class);
+        assertThat(empty.getStatusCode(), is(OK));
+        assertEquals(0, empty.getBody().getQuantity());
+        assertEquals(0, empty.getBody().getSubtotal().compareTo(java.math.BigDecimal.ZERO));
+
+        ResponseEntity<ReadableShoppingCart> reused = testRestTemplate.exchange(
+                "/api/v1/cart/" + cartCode, HttpMethod.PUT, new HttpEntity<>(item, getHeader()),
+                ReadableShoppingCart.class);
+        assertThat(reused.getStatusCode(), is(CREATED));
+        assertEquals(1, reused.getBody().getQuantity());
+    }
+
