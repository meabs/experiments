+    @Test
+    @Order(8)
+    public void emptyCartRemainsAvailableThroughApi() throws Exception {
+        ReadableProduct product = sampleProduct("emptyCartRemainsAvailable");
+        PersistableShoppingCartItem item = new PersistableShoppingCartItem();
+        item.setProduct(product.getSku());
+        item.setQuantity(1);
+
+        HttpEntity<PersistableShoppingCartItem> request = new HttpEntity<>(item, getHeader());
+        ResponseEntity<ReadableShoppingCart> created = testRestTemplate.postForEntity(
+                "/api/v1/cart", request, ReadableShoppingCart.class);
+        String code = created.getBody().getCode();
+
+        ResponseEntity<ReadableShoppingCart> deleted = testRestTemplate.exchange(
+                "/api/v1/cart/" + code + "/product/" + product.getSku(), HttpMethod.DELETE,
+                new HttpEntity<>(getHeader()), ReadableShoppingCart.class);
+        assertThat(deleted.getStatusCode(), is(NO_CONTENT));
+
+        ResponseEntity<ReadableShoppingCart> empty = testRestTemplate.exchange(
+                "/api/v1/cart/" + code, HttpMethod.GET, new HttpEntity<>(getHeader()),
+                ReadableShoppingCart.class);
+        assertThat(empty.getStatusCode(), is(OK));
+        assertEquals(0, empty.getBody().getProducts().size());
+        assertEquals(BigDecimal.ZERO, empty.getBody().getSubtotal());
+
+        ResponseEntity<ReadableShoppingCart> added = testRestTemplate.exchange(
+                "/api/v1/cart/" + code, HttpMethod.PUT, request, ReadableShoppingCart.class);
+        assertThat(added.getStatusCode(), is(CREATED));
+        assertEquals(1, added.getBody().getQuantity());
+    }
