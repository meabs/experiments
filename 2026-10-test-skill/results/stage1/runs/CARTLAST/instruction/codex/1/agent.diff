+    @Test
+    @Order(8)
+    public void emptyCartRemainsUsableThroughApi() throws Exception {
+        PersistableShoppingCartItem emptyItem = new PersistableShoppingCartItem();
+        emptyItem.setProduct(data.getProducts().get(0).getSku());
+        emptyItem.setQuantity(0);
+
+        ResponseEntity<ReadableShoppingCart> emptyResponse = testRestTemplate.exchange(
+                "/api/v1/cart/" + data.getCartId(), HttpMethod.PUT,
+                new HttpEntity<>(emptyItem, getHeader()), ReadableShoppingCart.class);
+
+        assertThat(emptyResponse.getStatusCode(), is(CREATED));
+        assertEquals(0, emptyResponse.getBody().getQuantity());
+        assertEquals(0, emptyResponse.getBody().getSubtotal().compareTo(java.math.BigDecimal.ZERO));
+
+        ResponseEntity<ReadableShoppingCart> getResponse = testRestTemplate.exchange(
+                "/api/v1/cart/" + data.getCartId(), HttpMethod.GET, new HttpEntity<>(getHeader()),
+                ReadableShoppingCart.class);
+        assertThat(getResponse.getStatusCode(), is(OK));
+        assertEquals(0, getResponse.getBody().getQuantity());
+
+        PersistableShoppingCartItem addItem = new PersistableShoppingCartItem();
+        addItem.setProduct(data.getProducts().get(0).getSku());
+        addItem.setQuantity(1);
+        ResponseEntity<ReadableShoppingCart> addResponse = testRestTemplate.exchange(
+                "/api/v1/cart/" + data.getCartId(), HttpMethod.PUT,
+                new HttpEntity<>(addItem, getHeader()), ReadableShoppingCart.class);
+        assertThat(addResponse.getStatusCode(), is(CREATED));
+        assertEquals(1, addResponse.getBody().getQuantity());
+    }
+
