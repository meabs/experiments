+    /**
+     * An empty cart remains addressable and can be reused after its last item is
+     * removed through the client-facing API.
+     */
+    @Test
+    @Order(8)
+    public void emptyCartCanBeReadAndReusedAfterLastItemRemoval() throws Exception {
+        ReadableProduct product = sampleProduct("emptyCartReuse");
+        HttpEntity<PersistableShoppingCartItem> addEntity = new HttpEntity<>(
+                cartItem(product.getSku(), 1), getHeader());
+        ResponseEntity<ReadableShoppingCart> created = testRestTemplate.postForEntity(
+                "/api/v1/cart/", addEntity, ReadableShoppingCart.class);
+        assertThat(created.getStatusCode(), is(CREATED));
+        String cartCode = created.getBody().getCode();
+
+        HttpEntity<PersistableShoppingCartItem> zeroEntity = new HttpEntity<>(
+                cartItem(product.getSku(), 0), getHeader());
+        ResponseEntity<ReadableShoppingCart> emptied = testRestTemplate.exchange(
+                "/api/v1/cart/" + cartCode, HttpMethod.PUT, zeroEntity, ReadableShoppingCart.class);
+        assertThat(emptied.getStatusCode(), is(CREATED));
+
+        ResponseEntity<ReadableShoppingCart> read = testRestTemplate.exchange(
+                "/api/v1/cart/" + cartCode, HttpMethod.GET, new HttpEntity<>(getHeader()),
+                ReadableShoppingCart.class);
+        assertThat(read.getStatusCode(), is(OK));
+        assertEquals(0, read.getBody().getQuantity());
+        assertEquals(0, read.getBody().getSubtotal().compareTo(java.math.BigDecimal.ZERO));
+
+        ResponseEntity<ReadableShoppingCart> reused = testRestTemplate.exchange(
+                "/api/v1/cart/" + cartCode, HttpMethod.PUT, addEntity, ReadableShoppingCart.class);
+        assertThat(reused.getStatusCode(), is(CREATED));
+        assertEquals(1, reused.getBody().getQuantity());
+
+        ResponseEntity<ReadableShoppingCart> deleted = testRestTemplate.exchange(
+                "/api/v1/cart/" + cartCode + "/product/" + product.getSku(), HttpMethod.DELETE,
+                new HttpEntity<>(getHeader()), ReadableShoppingCart.class);
+        assertThat(deleted.getStatusCode(), is(NO_CONTENT));
+
+        ResponseEntity<ReadableShoppingCart> readAfterDelete = testRestTemplate.exchange(
+                "/api/v1/cart/" + cartCode, HttpMethod.GET, new HttpEntity<>(getHeader()),
+                ReadableShoppingCart.class);
+        assertThat(readAfterDelete.getStatusCode(), is(OK));
+        assertEquals(0, readAfterDelete.getBody().getQuantity());
+    }
+
+    private PersistableShoppingCartItem cartItem(String sku, int quantity) {
+        PersistableShoppingCartItem item = new PersistableShoppingCartItem();
+        item.setProduct(sku);
+        item.setQuantity(quantity);
+        return item;
+    }
+
 }
