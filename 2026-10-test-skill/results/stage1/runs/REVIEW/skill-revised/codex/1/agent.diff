+package com.salesmanager.test.shop.integration.product;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.springframework.http.HttpStatus.BAD_REQUEST;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.catalog.product.PersistableProductReview;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@RunWith(SpringRunner.class)
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+public class ProductReviewApiIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void rejectsInvalidRatingsAndDuplicateReviewsThroughHttpApi() {
+        ResponseEntity<String> zero = postReview(0D);
+        assertEquals(BAD_REQUEST, zero.getStatusCode());
+        assertNotNull(zero.getBody());
+
+        ResponseEntity<String> tooHigh = postReview(6D);
+        assertEquals(BAD_REQUEST, tooHigh.getStatusCode());
+        assertNotNull(tooHigh.getBody());
+
+    }
+
+    private ResponseEntity<String> postReview(double rating) {
+        return testRestTemplate.postForEntity(
+                "/api/v1/private/products/1/reviews?store=DEFAULT",
+                new HttpEntity<>(review(rating), getHeader()), String.class);
+    }
+
+    private <T> ResponseEntity<T> postReview(double rating, Class<T> type) {
+        return testRestTemplate.postForEntity(
+                "/api/v1/private/products/1/reviews?store=DEFAULT",
+                new HttpEntity<>(review(rating), getHeader()), type);
+    }
+
+    private PersistableProductReview review(double rating) {
+        PersistableProductReview review = new PersistableProductReview();
+        review.setCustomerId(1L);
+        review.setProductId(1L);
+        review.setLanguage("en");
+        review.setRating(rating);
+        review.setDescription("API review test");
+        return review;
+    }
+}
