+package com.salesmanager.test.shop.integration.product;
+
+import static org.hamcrest.core.Is.is;
+import static org.junit.Assert.assertThat;
+import static org.springframework.http.HttpStatus.BAD_REQUEST;
+import static org.springframework.http.HttpStatus.CONFLICT;
+import static org.springframework.http.HttpStatus.CREATED;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.core.business.constants.Constants;
+import com.salesmanager.core.model.customer.CustomerGender;
+import com.salesmanager.shop.model.customer.PersistableCustomer;
+import com.salesmanager.shop.model.catalog.product.PersistableProductReview;
+import com.salesmanager.shop.model.customer.address.Address;
+import com.salesmanager.shop.model.catalog.product.product.PersistableProduct;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@RunWith(SpringRunner.class)
+public class ProductReviewAPIIntegrationTest extends ServicesTestSupport {
+
+  @Test
+  public void reviewRatingAndDuplicateStatusesAreClientVisible() {
+    final Long productId = createProduct().getId();
+    final String url = "/api/v1/private/products/" + productId + "/reviews?store=DEFAULT";
+    final Long customerId = registerCustomer().getId();
+
+    final PersistableProductReview invalid = review(0D, customerId, productId);
+    ResponseEntity<String> invalidCreate = testRestTemplate.exchange(
+        url, HttpMethod.POST, new HttpEntity<>(invalid, getHeader()), String.class);
+    assertThat(invalidCreate.getStatusCode(), is(BAD_REQUEST));
+
+    final PersistableProductReview valid = review(4D, customerId, productId);
+    ResponseEntity<PersistableProductReview> created = testRestTemplate.exchange(
+        url, HttpMethod.POST, new HttpEntity<>(valid, getHeader()), PersistableProductReview.class);
+    assertThat(created.getStatusCode(), is(CREATED));
+
+    ResponseEntity<String> duplicate = testRestTemplate.exchange(
+        url, HttpMethod.POST, new HttpEntity<>(review(5D, customerId, productId), getHeader()), String.class);
+    assertThat(duplicate.getStatusCode(), is(CONFLICT));
+
+    final PersistableProductReview invalidEdit = review(6D, customerId, productId);
+    invalidEdit.setId(created.getBody().getId());
+    ResponseEntity<String> invalidUpdate = testRestTemplate.exchange(
+        "/api/v1/private/products/" + productId + "/reviews/" + invalidEdit.getId() + "?store=DEFAULT",
+        HttpMethod.PUT, new HttpEntity<>(invalidEdit, getHeader()), String.class);
+    assertThat(invalidUpdate.getStatusCode(), is(BAD_REQUEST));
+  }
+
+  private PersistableProduct createProduct() {
+    final PersistableProduct product = product("review-product");
+    product.setSku("review-product");
+    return testRestTemplate.postForEntity(
+        "/api/v1/private/product?store=DEFAULT", new HttpEntity<>(product, getHeader()),
+        PersistableProduct.class).getBody();
+  }
+
+  private PersistableCustomer registerCustomer() {
+    final PersistableCustomer customer = new PersistableCustomer();
+    customer.setEmailAddress("review-customer@test.com");
+    customer.setPassword("clear123");
+    customer.setGender(CustomerGender.M.name());
+    customer.setLanguage("en");
+    customer.setStoreCode(Constants.DEFAULT_STORE);
+    final Address billing = new Address();
+    billing.setFirstName("Review");
+    billing.setLastName("Customer");
+    billing.setCountry("BE");
+    customer.setBilling(billing);
+    return testRestTemplate.postForEntity(
+        "/api/v1/customer/register", new HttpEntity<>(customer, getHeader()),
+        PersistableCustomer.class).getBody();
+  }
+
+  private PersistableProductReview review(double rating, Long customerId, Long productId) {
+    final PersistableProductReview review = new PersistableProductReview();
+    review.setCustomerId(customerId);
+    review.setProductId(productId);
+    review.setRating(rating);
+    review.setDescription("API review");
+    review.setLanguage("en");
+    return review;
+  }
+}
