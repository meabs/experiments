+package com.salesmanager.test.shop.integration.product;
+
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.assertEquals;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.model.catalog.product.PersistableProductReview;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@RunWith(SpringRunner.class)
+public class ProductReviewApiIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void reviewApiReturnsClientErrorsAndDoesNotPersistInvalidReviews() {
+        HttpHeaders headers = getHeader("admin@shopizer.com", "password");
+        assertInvalidCreate(0D, headers);
+        assertInvalidCreate(6D, headers);
+    }
+
+    private void assertInvalidCreate(double rating, HttpHeaders headers) {
+        PersistableProductReview review = review(rating);
+        ResponseEntity<String> response = testRestTemplate.postForEntity(
+                "/api/v1/private/products/1/reviews?store=DEFAULT", new HttpEntity<>(review, headers), String.class);
+        assertEquals(HttpStatus.BAD_REQUEST, response.getStatusCode());
+        assertNotNull(response.getBody());
+        assertTrue(response.getBody().contains("400"));
+    }
+
+    private PersistableProductReview review(double rating) {
+        PersistableProductReview review = new PersistableProductReview();
+        review.setCustomerId(null);
+        review.setProductId(1L);
+        review.setLanguage("en");
+        review.setRating(rating);
+        review.setDescription("API review");
+        return review;
+    }
+}
