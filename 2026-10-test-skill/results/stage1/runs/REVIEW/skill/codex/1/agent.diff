@@ -0,0 +1,87 @@
+package com.salesmanager.test.shop.integration.product;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.springframework.http.HttpStatus.BAD_REQUEST;
+import static org.springframework.http.HttpStatus.CONFLICT;
+import static org.springframework.http.HttpStatus.CREATED;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+import java.math.BigDecimal;
+import com.salesmanager.shop.model.catalog.product.product.PersistableProduct;
+import com.salesmanager.shop.model.catalog.product.product.ProductSpecification;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.catalog.product.PersistableProductReview;
+import com.salesmanager.shop.model.catalog.product.ReadableProductList;
+import com.salesmanager.shop.model.customer.PersistableCustomer;
+import com.salesmanager.shop.model.customer.address.Address;
+import com.salesmanager.core.model.customer.CustomerGender;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@RunWith(SpringRunner.class)
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+public class ProductReviewAPIIntegrationTest extends ServicesTestSupport {
+
+  @Test
+  public void validatesRatingsAndDuplicateReviewsThroughApi() {
+    PersistableProduct product = product("review-product-" + System.nanoTime());
+    product.setPrice(BigDecimal.TEN);
+    product.setSku("review-" + System.nanoTime());
+    product.setProductSpecifications(new ProductSpecification());
+    ResponseEntity<PersistableProduct> productResponse = testRestTemplate.postForEntity(
+        "/api/v1/private/product?store=DEFAULT", new HttpEntity<>(product, getHeader()), PersistableProduct.class);
+    assertEquals(CREATED, productResponse.getStatusCode());
+    final Long productId = productResponse.getBody().getId();
+    final String path = "/api/v1/private/products/" + productId + "/reviews?store=DEFAULT";
+    PersistableCustomer customer = new PersistableCustomer();
+    customer.setEmailAddress("review-" + System.nanoTime() + "@test.com");
+    customer.setPassword("clear123");
+    customer.setGender(CustomerGender.M.name());
+    customer.setLanguage("en");
+    customer.setStoreCode("DEFAULT");
+    Address billing = new Address();
+    billing.setFirstName("Review");
+    billing.setLastName("Customer");
+    billing.setCountry("BE");
+    customer.setBilling(billing);
+    ResponseEntity<PersistableCustomer> registration = testRestTemplate.postForEntity(
+        "/api/v1/customer/register", new HttpEntity<>(customer, getHeader()), PersistableCustomer.class);
+    assertEquals(org.springframework.http.HttpStatus.OK, registration.getStatusCode());
+    final Long customerId = registration.getBody().getId();
+    final HttpEntity<PersistableProductReview> invalidEntity = new HttpEntity<>(review(0D, customerId, productId), getHeader());
+
+    assertEquals(BAD_REQUEST, testRestTemplate.postForEntity(path, invalidEntity, String.class).getStatusCode());
+
+    final ResponseEntity<PersistableProductReview> created = testRestTemplate.postForEntity(
+        path, new HttpEntity<>(review(3D, customerId, productId), getHeader()), PersistableProductReview.class);
+    assertEquals(CREATED, created.getStatusCode());
+    assertNotNull(created.getBody());
+
+    assertEquals(CONFLICT, testRestTemplate.postForEntity(
+        path, new HttpEntity<>(review(4D, customerId, productId), getHeader()), String.class).getStatusCode());
+
+    final String updatePath = path.replace("?store=DEFAULT", "/" + created.getBody().getId() + "?store=DEFAULT");
+    final ResponseEntity<String> invalidUpdate = testRestTemplate.exchange(
+        updatePath, HttpMethod.PUT, new HttpEntity<>(review(-1D, customerId, productId), getHeader()), String.class);
+    assertEquals(BAD_REQUEST, invalidUpdate.getStatusCode());
+  }
+
+  private PersistableProductReview review(Double rating, Long customerId, Long productId) {
+    PersistableProductReview review = new PersistableProductReview();
+    review.setCustomerId(customerId);
+    review.setProductId(productId);
+    review.setLanguage("en");
+    review.setRating(rating);
+    review.setDescription("API review validation");
+    review.setDate("2021-06-06");
+    return review;
+  }
+}
