+	public void productReviewApiRejectsInvalidAndDuplicateReviews() {
+		final ReadableProduct product = sampleProduct("review-api-" + System.nanoTime());
+		final String url = "/api/v1/private/products/" + product.getId() + "/reviews";
+		final String query = "?store=" + Constants.DEFAULT_STORE;
+		final PersistableCustomer customer = new PersistableCustomer();
+		customer.setEmailAddress("review-test-" + System.nanoTime() + "@test.com");
+		customer.setPassword("clear123");
+		customer.setGender(CustomerGender.M.name());
+		customer.setLanguage("en");
+		customer.setStoreCode(Constants.DEFAULT_STORE);
+		final Address billing = new Address();
+		billing.setFirstName("review");
+		billing.setLastName("tester");
+		billing.setCountry("BE");
+		customer.setBilling(billing);
+		ResponseEntity<PersistableCustomer> registered = testRestTemplate.postForEntity(
+				"/api/v1/customer/register", new HttpEntity<>(customer, getHeader()), PersistableCustomer.class);
+		assertThat(registered.getStatusCode(), is(HttpStatus.OK));
+		assertNotNull(registered.getBody());
+		final PersistableProductReview review = new PersistableProductReview();
+		review.setCustomerId(registered.getBody().getId());
+		review.setProductId(product.getId());
+		review.setRating(0D);
+		review.setDescription("invalid rating");
+
+		ResponseEntity<String> response = testRestTemplate.postForEntity(url + query,
+				new HttpEntity<>(review, getHeader()), String.class);
+		assertThat(response.getStatusCode(), is(BAD_REQUEST));
+		assertNotNull(response.getBody());
+
+		review.setRating(4D);
+		ResponseEntity<PersistableProductReview> created = testRestTemplate.postForEntity(url + query,
+				new HttpEntity<>(review, getHeader()), PersistableProductReview.class);
+		assertThat(created.getStatusCode(), is(CREATED));
+		assertNotNull(created.getBody());
+		assertNotNull(created.getBody().getId());
+
+		ResponseEntity<String> duplicate = testRestTemplate.postForEntity(url + query,
+				new HttpEntity<>(review, getHeader()), String.class);
+		assertThat(duplicate.getStatusCode(), is(CONFLICT));
+		assertNotNull(duplicate.getBody());
+
+		review.setId(created.getBody().getId());
+		review.setRating(6D);
+		ResponseEntity<String> invalidEdit = testRestTemplate.exchange(
+				url + "/" + created.getBody().getId() + query, HttpMethod.PUT,
+				new HttpEntity<>(review, getHeader()), String.class);
+		assertThat(invalidEdit.getStatusCode(), is(BAD_REQUEST));
+		assertNotNull(invalidEdit.getBody());
