+package com.salesmanager.test.shop.api;
+
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.put;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.InjectMocks;
+import org.mockito.Mock;
+import org.mockito.junit.MockitoJUnitRunner;
+import org.springframework.core.MethodParameter;
+import org.springframework.http.converter.json.MappingJackson2HttpMessageConverter;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+import org.springframework.web.bind.support.WebDataBinderFactory;
+import org.springframework.web.context.request.NativeWebRequest;
+import org.springframework.web.method.support.HandlerMethodArgumentResolver;
+import org.springframework.web.method.support.ModelAndViewContainer;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.salesmanager.core.business.services.catalog.product.review.ProductReviewService;
+import com.salesmanager.core.model.catalog.product.review.ProductReview;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.store.api.v1.product.ProductReviewApi;
+import com.salesmanager.shop.store.controller.product.facade.ProductCommonFacade;
+
+@RunWith(MockitoJUnitRunner.class)
+public class ProductReviewApiTest {
+
+  @Mock private ProductCommonFacade productCommonFacade;
+  @Mock private ProductReviewService productReviewService;
+  @InjectMocks private ProductReviewApi api;
+  private MockMvc client;
+
+  @Before
+  public void setUp() {
+    client = MockMvcBuilders.standaloneSetup(api)
+        .setMessageConverters(new MappingJackson2HttpMessageConverter())
+        .setCustomArgumentResolvers(new FixedArgumentResolver())
+        .build();
+  }
+
+  @Test
+  public void rejectsOutOfRangeRatingsAndDuplicateReviewsThroughApi() throws Exception {
+    when(productReviewService.getByProductAndCustomer(42L, 7L)).thenReturn(null);
+
+    for (double rating : new double[] {0, -1, 6}) {
+      client.perform(post("/api/v1/private/products/42/reviews")
+          .contentType("application/json")
+          .content(reviewJson(rating, 7L)))
+          .andExpect(status().isBadRequest());
+    }
+    verify(productCommonFacade, never()).saveOrUpdateReview(any(), any(), any());
+
+    ProductReview existing = new ProductReview();
+    when(productReviewService.getByProductAndCustomer(42L, 7L)).thenReturn(existing);
+    client.perform(post("/api/v1/private/products/42/reviews")
+        .contentType("application/json")
+        .content(reviewJson(4, 7L)))
+        .andExpect(status().isConflict());
+    verify(productCommonFacade, never()).saveOrUpdateReview(any(), any(), any());
+  }
+
+  @Test
+  public void rejectsOutOfRangeEditThroughApi() throws Exception {
+    ProductReview existing = new ProductReview();
+    com.salesmanager.core.model.customer.Customer customer =
+        new com.salesmanager.core.model.customer.Customer();
+    customer.setId(7L);
+    existing.setCustomer(customer);
+    when(productReviewService.getById(9L)).thenReturn(existing);
+
+    client.perform(put("/api/v1/private/products/42/reviews/9")
+        .contentType("application/json")
+        .content(reviewJson(0, 7L)))
+        .andExpect(status().isBadRequest());
+    verify(productCommonFacade, never()).saveOrUpdateReview(any(), any(), any());
+  }
+
+  private String reviewJson(double rating, Long customerId) throws Exception {
+    return new ObjectMapper().writeValueAsString(new Object() {
+      public final Long customerIdValue = customerId;
+      public final double ratingValue = rating;
+      public final String description = "review";
+      public Long getCustomerId() { return customerIdValue; }
+      public double getRating() { return ratingValue; }
+      public String getDescription() { return description; }
+    });
+  }
+
+  private static class FixedArgumentResolver implements HandlerMethodArgumentResolver {
+    public boolean supportsParameter(MethodParameter parameter) {
+      return parameter.getParameterType() == MerchantStore.class
+          || parameter.getParameterType() == Language.class;
+    }
+    public Object resolveArgument(MethodParameter parameter, ModelAndViewContainer container,
+        NativeWebRequest request, WebDataBinderFactory binderFactory) {
+      return null;
+    }
+  }
+}
