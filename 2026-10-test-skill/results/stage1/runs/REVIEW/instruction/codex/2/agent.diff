@@ -0,0 +1,56 @@
+package com.salesmanager.test.shop.integration.product;
+
+import static org.mockito.Mockito.times;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.InjectMocks;
+import org.mockito.Mock;
+import org.mockito.junit.MockitoJUnitRunner;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.review.ProductReviewService;
+import com.salesmanager.core.model.catalog.product.review.ProductReview;
+import com.salesmanager.shop.store.api.v1.product.ProductReviewApi;
+import com.salesmanager.shop.store.controller.product.facade.ProductCommonFacade;
+
+@RunWith(MockitoJUnitRunner.class)
+public class ProductReviewApiTest {
+
+    @Mock private ProductCommonFacade productCommonFacade;
+    @Mock private ProductService productService;
+    @Mock private ProductReviewService productReviewService;
+    @InjectMocks private ProductReviewApi productReviewApi;
+
+    private MockMvc mockMvc;
+
+    @Before
+    public void setUp() {
+        mockMvc = MockMvcBuilders.standaloneSetup(productReviewApi).build();
+    }
+
+    @Test
+    public void duplicateReviewReturnsConflictThroughPostEndpoint() throws Exception {
+        when(productReviewService.getByProductAndCustomer(7L, 11L))
+                .thenReturn(null, new ProductReview());
+
+        String review = "{\"customerId\":11,\"rating\":4,\"description\":\"Good product\"}";
+
+        mockMvc.perform(post("/api/v1/private/products/7/reviews")
+                .contentType("application/json").content(review))
+                .andExpect(status().isCreated());
+        mockMvc.perform(post("/api/v1/private/products/7/reviews")
+                .contentType("application/json").content(review))
+                .andExpect(status().isConflict());
+        verify(productCommonFacade, times(1)).saveOrUpdateReview(
+                org.mockito.ArgumentMatchers.any(), org.mockito.ArgumentMatchers.any(),
+                org.mockito.ArgumentMatchers.any());
+    }
+}
