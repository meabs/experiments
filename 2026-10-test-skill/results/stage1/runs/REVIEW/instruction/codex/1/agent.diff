+package com.salesmanager.test.shop.api;
+
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyLong;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.salesmanager.core.business.services.catalog.product.review.ProductReviewService;
+import com.salesmanager.core.model.catalog.product.review.ProductReview;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.shop.store.api.v1.product.ProductReviewApi;
+import com.salesmanager.shop.store.controller.product.facade.ProductCommonFacade;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.Mock;
+import org.mockito.junit.MockitoJUnitRunner;
+import org.springframework.test.util.ReflectionTestUtils;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+
+@RunWith(MockitoJUnitRunner.class)
+public class ProductReviewApiTest {
+
+  private MockMvc mockMvc;
+
+  @Mock private ProductReviewService productReviewService;
+  @Mock private ProductCommonFacade productCommonFacade;
+
+  @Before
+  public void setUp() {
+    ProductReviewApi api = new ProductReviewApi();
+    ReflectionTestUtils.setField(api, "productReviewService", productReviewService);
+    ReflectionTestUtils.setField(api, "productCommonFacade", productCommonFacade);
+    mockMvc = MockMvcBuilders.standaloneSetup(api).build();
+  }
+
+  @Test
+  public void duplicateReviewIsConflictAndIsNotSaved() throws Exception {
+    when(productReviewService.getByProductAndCustomer(7L, 11L)).thenReturn(new ProductReview());
+
+    mockMvc.perform(post("/api/v1/private/products/7/reviews")
+        .contentType("application/json")
+        .content(reviewJson(3)))
+        .andExpect(status().isConflict());
+
+    verify(productCommonFacade, never()).saveOrUpdateReview(any(), any(), any());
+  }
+
+  @Test
+  public void outOfRangeRatingIsBadRequestAndIsNotSaved() throws Exception {
+    mockMvc.perform(post("/api/v1/private/products/7/reviews")
+        .contentType("application/json")
+        .content(reviewJson(6)))
+        .andExpect(status().isBadRequest());
+
+    verify(productCommonFacade, never()).saveOrUpdateReview(any(), any(), any());
+  }
+
+  @Test
+  public void editingOutOfRangeRatingIsBadRequestAndIsNotSaved() throws Exception {
+    ProductReview existing = new ProductReview();
+    Customer customer = new Customer();
+    customer.setId(11L);
+    existing.setCustomer(customer);
+    when(productReviewService.getById(19L)).thenReturn(existing);
+
+    mockMvc.perform(org.springframework.test.web.servlet.request.MockMvcRequestBuilders.put(
+        "/api/v1/private/products/7/reviews/19")
+        .contentType("application/json")
+        .content(reviewJson(0)))
+        .andExpect(status().isBadRequest());
+
+    verify(productCommonFacade, never()).saveOrUpdateReview(any(), any(), any());
+  }
+
+  private String reviewJson(int rating) throws Exception {
+    return new ObjectMapper().writeValueAsString(new ReviewRequest(rating));
+  }
+
+  private static class ReviewRequest {
+    public long customerId = 11L;
+    public String description = "Good product";
+    public int rating;
+
+    ReviewRequest(int rating) {
+      this.rating = rating;
+    }
+  }
+}
