+	@Override
+	public List<Object[]> countProductsByCategoryLineage(MerchantStore store, List<Long> categoryIds) {
+		String hql = "select ancestor.id, count(distinct product.id) "
+				+ "from Category ancestor, Product product join product.categories descendant "
+				+ "where ancestor.id in (:cid) and ancestor.merchantStore = :store "
+				+ "and (descendant.id = ancestor.id or descendant.lineage like concat(ancestor.lineage, ancestor.id, '/%')) "
+				+ "and product.available=true and product.dateAvailable<=:dt group by ancestor.id";
+		Query q = this.em.createQuery(hql);
+		q.setParameter("cid", categoryIds);
+		q.setParameter("store", store);
+		q.setParameter("dt", new Date());
+		return q.getResultList();
+	}
 	
 	@SuppressWarnings("unchecked")
 	@Override
