+package com.salesmanager.test.shop.integration.category;
+
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.assertEquals;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.boot.test.web.client.TestRestTemplate;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.catalog.category.ReadableCategory;
+import com.salesmanager.shop.model.catalog.category.ReadableCategoryList;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class CategoryProductCountApiIntegrationTest extends ServicesTestSupport {
+
+    @Autowired
+    private TestRestTemplate testRestTemplate;
+
+    @Test
+    public void categoryListContainsProductCountsForNestedCategories() {
+        sampleProduct("CATEGORY_COUNT_PRODUCT");
+        ResponseEntity<ReadableCategoryList> response = testRestTemplate.exchange(
+                "/api/v1/category?store=DEFAULT&lang=en&count=100", HttpMethod.GET,
+                new HttpEntity<>(null), ReadableCategoryList.class);
+
+        assertEquals(HttpStatus.OK, response.getStatusCode());
+        assertTrue(response.getBody().getCategories().stream()
+                .anyMatch(category -> hasCountFor(category, "CATEGORY_COUNT_PRODUCT", 1)));
+    }
+
+    private boolean hasCountFor(ReadableCategory category, String code, int expected) {
+        return (code.equals(category.getCode()) && category.getProductCount() == expected)
+                || category.getChildren().stream().anyMatch(child -> hasCountFor(child, code, expected));
+    }
+}
