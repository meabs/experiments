+package com.salesmanager.test.shop.integration.customer;
+
+import static org.junit.Assert.assertEquals;
+import static org.springframework.http.HttpStatus.OK;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.core.business.constants.Constants;
+import com.salesmanager.core.model.customer.CustomerGender;
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.customer.PersistableCustomer;
+import com.salesmanager.shop.model.customer.ReadableCustomer;
+import com.salesmanager.shop.model.customer.address.Address;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class CustomerAddressIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void patchCustomerAddressPreservesDeliveryFieldsAndFallsBackToBilling() {
+        PersistableCustomer customer = new PersistableCustomer();
+        customer.setEmailAddress("address-test-" + System.currentTimeMillis() + "@test.com");
+        customer.setPassword("clear123");
+        customer.setGender(CustomerGender.M.name());
+        customer.setLanguage("en");
+        customer.setStoreCode(Constants.DEFAULT_STORE);
+
+        Address billing = address("Billing street", "Billing city", "BILLING-POSTAL", "BE", "Billing state");
+        billing.setFirstName("Address");
+        billing.setLastName("Test");
+        customer.setBilling(billing);
+        ResponseEntity<ReadableCustomer> created = testRestTemplate.postForEntity(
+                "/api/v1/private/customer", new HttpEntity<>(customer, getHeader()), ReadableCustomer.class);
+        assertEquals(OK, created.getStatusCode());
+
+        Address delivery = address("Delivery street", "Delivery city", "DELIVERY-POSTAL", "BE", "Delivery state");
+        customer.setDelivery(delivery);
+        ResponseEntity<Void> patched = testRestTemplate.exchange(
+                "/api/v1/private/customer/" + created.getBody().getId() + "/address",
+                HttpMethod.PATCH, new HttpEntity<>(customer, getHeader()), Void.class);
+        assertEquals(OK, patched.getStatusCode());
+
+        ResponseEntity<ReadableCustomer> read = testRestTemplate.exchange(
+                "/api/v1/private/customer/" + created.getBody().getId(), HttpMethod.GET,
+                new HttpEntity<>(getHeader()), ReadableCustomer.class);
+        assertEquals("Delivery street", read.getBody().getDelivery().getAddress());
+        assertEquals("Delivery city", read.getBody().getDelivery().getCity());
+        assertEquals("DELIVERY-POSTAL", read.getBody().getDelivery().getPostalCode());
+        assertEquals("Delivery state", read.getBody().getDelivery().getStateProvince());
+
+        delivery.setAddress(null);
+        delivery.setCity(null);
+        delivery.setPostalCode(null);
+        delivery.setCountry(null);
+        customer.setDelivery(delivery);
+        testRestTemplate.exchange("/api/v1/private/customer/" + created.getBody().getId() + "/address",
+                HttpMethod.PATCH, new HttpEntity<>(customer, getHeader()), Void.class);
+        read = testRestTemplate.exchange("/api/v1/private/customer/" + created.getBody().getId(), HttpMethod.GET,
+                new HttpEntity<>(getHeader()), ReadableCustomer.class);
+        assertEquals("Billing street", read.getBody().getDelivery().getAddress());
+        assertEquals("Billing city", read.getBody().getDelivery().getCity());
+        assertEquals("BILLING-POSTAL", read.getBody().getDelivery().getPostalCode());
+        assertEquals("BE", read.getBody().getDelivery().getCountry());
+    }
+
+    private Address address(String street, String city, String postal, String country, String state) {
+        Address address = new Address();
+        address.setAddress(street);
+        address.setCity(city);
+        address.setPostalCode(postal);
+        address.setCountry(country);
+        address.setStateProvince(state);
+        return address;
+    }
+}
