+package com.salesmanager.test.shop.integration.customer;
+
+import static org.junit.Assert.assertEquals;
+import static org.springframework.http.HttpMethod.GET;
+import static org.springframework.http.HttpMethod.PATCH;
+import static org.springframework.http.HttpStatus.OK;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.core.model.customer.CustomerGender;
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.customer.ReadableCustomer;
+import com.salesmanager.shop.model.customer.address.Address;
+import com.salesmanager.shop.model.customer.PersistableCustomer;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class CustomerAddressApiIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void patchCustomerAddressPreservesDeliveryFieldsAndUsesBillingFallbacks() {
+        PersistableCustomer registration = new PersistableCustomer();
+        registration.setEmailAddress("address-test-" + System.nanoTime() + "@test.com");
+        registration.setPassword("clear123");
+        registration.setGender(CustomerGender.M.name());
+        registration.setLanguage("en");
+        registration.setBilling(address("Initial street", "Initial city", "INIT", "BE", "Initial state"));
+        ResponseEntity<PersistableCustomer> created = testRestTemplate.postForEntity(
+                "/api/v1/customer/register", new HttpEntity<>(registration, getHeader()), PersistableCustomer.class);
+        assertEquals(OK, created.getStatusCode());
+        long customerId = created.getBody().getId();
+
+        PersistableCustomer update = new PersistableCustomer();
+        update.setBilling(address("Billing street", "Billing city", "BILL", "BE", "Billing state"));
+        update.setDelivery(address("Delivery street", "Delivery city", "DEL", "BE", "Delivery state"));
+
+        ResponseEntity<Void> patch = testRestTemplate.exchange(
+                "/api/v1/private/customer/" + customerId + "/address", PATCH,
+                new HttpEntity<>(update, getHeader()), Void.class);
+        assertEquals(OK, patch.getStatusCode());
+
+        ResponseEntity<ReadableCustomer> read = testRestTemplate.exchange(
+                "/api/v1/private/customer/" + customerId, GET,
+                new HttpEntity<>(getHeader()), ReadableCustomer.class);
+        assertEquals(OK, read.getStatusCode());
+        assertEquals("Delivery street", read.getBody().getDelivery().getAddress());
+        assertEquals("Delivery city", read.getBody().getDelivery().getCity());
+        assertEquals("DEL", read.getBody().getDelivery().getPostalCode());
+        assertEquals("BE", read.getBody().getDelivery().getCountry());
+        assertEquals("Delivery state", read.getBody().getDelivery().getStateProvince());
+
+        PersistableCustomer fallback = new PersistableCustomer();
+        fallback.setBilling(address("Fallback street", "Fallback city", "FALL", "BE", "Fallback state"));
+        fallback.setDelivery(new Address());
+        ResponseEntity<Void> fallbackPatch = testRestTemplate.exchange(
+                "/api/v1/private/customer/" + customerId + "/address", PATCH,
+                new HttpEntity<>(fallback, getHeader()), Void.class);
+        assertEquals(OK, fallbackPatch.getStatusCode());
+
+        ReadableCustomer afterFallback = testRestTemplate.exchange(
+                "/api/v1/private/customer/" + customerId, GET,
+                new HttpEntity<>(getHeader()), ReadableCustomer.class).getBody();
+        assertEquals("Fallback street", afterFallback.getDelivery().getAddress());
+        assertEquals("Fallback city", afterFallback.getDelivery().getCity());
+        assertEquals("FALL", afterFallback.getDelivery().getPostalCode());
+        assertEquals("BE", afterFallback.getDelivery().getCountry());
+    }
+
+    private Address address(String street, String city, String postalCode, String country, String state) {
+        Address address = new Address();
+        address.setFirstName("Address");
+        address.setLastName("Test");
+        address.setAddress(street);
+        address.setCity(city);
+        address.setPostalCode(postalCode);
+        address.setCountry(country);
+        address.setStateProvince(state);
+        return address;
+    }
+}
