+package com.salesmanager.test.shop.content;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import java.lang.reflect.Field;
+import java.lang.reflect.Proxy;
+import java.util.Collections;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.services.content.ContentService;
+import com.salesmanager.core.model.content.Content;
+import com.salesmanager.core.model.content.ContentDescription;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.content.box.ReadableContentBox;
+import com.salesmanager.shop.store.facade.content.ContentFacadeImpl;
+
+public class ContentBoxApiRegressionTest {
+
+    @Test
+    public void getContentBoxReturnsStoredFieldsAndExactText() throws Exception {
+        Language language = new Language();
+        language.setCode("en");
+        ContentDescription description = new ContentDescription();
+        description.setLanguage(language);
+        description.setDescription("Text with\r\n tabs\t and no wrapper");
+
+        Content content = new Content();
+        content.setId(42L);
+        content.setCode("footer_note");
+        content.setVisible(true);
+        content.setDescriptions(Collections.singletonList(description));
+
+        ContentService service = (ContentService) Proxy.newProxyInstance(
+                ContentService.class.getClassLoader(), new Class<?>[] { ContentService.class },
+                (proxy, method, args) -> method.getName().equals("getByCode") ? content : null);
+        ContentFacadeImpl facade = new ContentFacadeImpl();
+        setField(facade, "contentService", service);
+
+        MerchantStore store = new MerchantStore();
+        store.setCode("DEFAULT");
+        ReadableContentBox result = facade.getContentBox("footer_note", store, language);
+
+        assertEquals("footer_note", result.getCode());
+        assertEquals(Long.valueOf(42L), result.getId());
+        assertTrue(result.isVisible());
+        assertEquals("Text with\r\n tabs\t and no wrapper", result.getDescription().getDescription());
+    }
+
+    private static void setField(Object target, String name, Object value) throws Exception {
+        Field field = target.getClass().getDeclaredField(name);
+        field.setAccessible(true);
+        field.set(target, value);
+    }
+}
