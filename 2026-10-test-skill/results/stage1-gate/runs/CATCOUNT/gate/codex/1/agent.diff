+    @Test
+    public void categoryProductCountIncludesDescendantsWithoutDuplicates() throws Exception {
+        HttpHeaders headers = getHeader();
+        PersistableCategory root = createCategory("count-root", null, 0, headers);
+        PersistableCategory child = createCategory("count-child", root.getId(), 1, headers);
+        PersistableCategory grandchild = createCategory("count-grandchild", child.getId(), 2, headers);
+
+        createProduct("count-product-one", categoryRef(child, "count-child"), categoryRef(grandchild, "count-grandchild"), headers);
+        createProduct("count-product-two", categoryRef(grandchild, "count-grandchild"), headers);
+
+        ResponseEntity<ReadableCategoryList> response = testRestTemplate.exchange(
+                "/api/v1/category?name=count-root", HttpMethod.GET, new HttpEntity<>(headers), ReadableCategoryList.class);
+        assertThat(response.getStatusCode(), is(OK));
+
+        ReadableCategory listedRoot = response.getBody().getCategories().stream()
+                .filter(category -> root.getId().equals(category.getId())).findFirst().orElse(null);
+        assertNotNull(listedRoot);
+        assertThat(listedRoot.getProductCount(), is(2));
+        assertThat(listedRoot.getChildren().get(0).getProductCount(), is(2));
+        assertThat(listedRoot.getChildren().get(0).getChildren().get(0).getProductCount(), is(2));
+    }
+
+    private PersistableCategory createCategory(String code, Long parentId, int depth, HttpHeaders headers) {
+        PersistableCategory category = category(code);
+        category.setDepth(depth);
+        if (parentId != null) {
+            Category parent = new Category();
+            parent.setId(parentId);
+            category.setParent(parent);
+        }
+        ResponseEntity<PersistableCategory> response = testRestTemplate.postForEntity(
+                "/api/v1/private/category?store=" + Constants.DEFAULT_STORE,
+                new HttpEntity<>(category, headers), PersistableCategory.class);
+        assertThat(response.getStatusCode(), is(CREATED));
+        return response.getBody();
+    }
+
+    private Category categoryRef(PersistableCategory category, String code) {
+        Category reference = new Category();
+        reference.setId(category.getId());
+        reference.setCode(code);
+        return reference;
+    }
+
+    private void createProduct(String code, Category firstCategory, Category secondCategory, HttpHeaders headers) {
+        createProduct(code, new Category[] { firstCategory, secondCategory }, headers);
+    }
+
+    private void createProduct(String code, Category category, HttpHeaders headers) {
+        createProduct(code, new Category[] { category }, headers);
+    }
+
+    private void createProduct(String code, Category[] categoryRefs, HttpHeaders headers) {
+        PersistableProduct product = product(code);
+        List<Category> categories = new ArrayList<>();
+        for (Category category : categoryRefs) categories.add(category);
+        product.setCategories(categories);
+        product.setAvailable(true);
+        product.setPrice(BigDecimal.TEN);
+        product.setSku(code);
+        product.setQuantity(100);
+        ProductSpecification specifications = new ProductSpecification();
+        specifications.setManufacturer(com.salesmanager.core.model.catalog.product.manufacturer.Manufacturer.DEFAULT_MANUFACTURER);
+        product.setProductSpecifications(specifications);
+        ResponseEntity<PersistableProduct> response = testRestTemplate.postForEntity(
+                "/api/v1/private/product?store=" + Constants.DEFAULT_STORE,
+                new HttpEntity<>(product, headers), PersistableProduct.class);
+        assertThat(response.getStatusCode(), is(CREATED));
+    }
