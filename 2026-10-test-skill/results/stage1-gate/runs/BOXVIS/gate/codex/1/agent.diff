@@ -0,0 +1,58 @@
+package com.salesmanager.test.shop.integration.content;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertThat;
+import static org.hamcrest.Matchers.is;
+
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.Map;
+
+import javax.inject.Inject;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.boot.test.web.client.TestRestTemplate;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class ContentBoxVisibilityApiIntegrationTest extends ServicesTestSupport {
+
+	@Inject
+	private TestRestTemplate restTemplate;
+
+	@Test
+	public void hiddenBoxIsNotExposedByStorefrontApi() {
+		String code = "api-hidden-box-" + System.currentTimeMillis();
+		Map<String, Object> box = new HashMap<>();
+		box.put("code", code);
+		box.put("visible", false);
+		Map<String, Object> description = new HashMap<>();
+		description.put("language", "en");
+		description.put("name", "Hidden box");
+		box.put("descriptions", Collections.singletonList(description));
+
+		ResponseEntity<String> created = restTemplate.postForEntity("/api/v1/private/content/box?store=DEFAULT&lang=en",
+				new HttpEntity<>(box, getHeader()), String.class);
+		assertThat(created.getStatusCode(), is(HttpStatus.CREATED));
+
+		ResponseEntity<String> listing = restTemplate.exchange("/api/v1/content/boxes?store=DEFAULT&lang=en&page=0&count=100",
+				HttpMethod.GET, new HttpEntity<>(getHeader()), String.class);
+		assertThat(listing.getStatusCode(), is(HttpStatus.OK));
+		assertFalse(listing.getBody().contains(code));
+
+		ResponseEntity<String> fetched = restTemplate.exchange("/api/v1/content/boxes/" + code + "?store=DEFAULT&lang=en",
+				HttpMethod.GET, new HttpEntity<>(getHeader()), String.class);
+		assertThat(fetched.getStatusCode(), is(HttpStatus.NOT_FOUND));
+	}
+}
