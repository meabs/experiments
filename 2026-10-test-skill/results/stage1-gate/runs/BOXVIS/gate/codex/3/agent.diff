@@ -0,0 +1,48 @@
+package com.salesmanager.test.shop.integration.content;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertEquals;
+
+import java.util.Arrays;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.model.content.box.PersistableContentBox;
+import com.salesmanager.shop.model.content.common.ContentDescription;
+import com.salesmanager.shop.model.entity.Entity;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@RunWith(SpringRunner.class)
+public class ContentBoxVisibilityApiIntegrationTest extends ServicesTestSupport {
+
+	@Test
+	public void hiddenContentBoxIsNotExposedByStorefrontApi() {
+		PersistableContentBox box = new PersistableContentBox();
+		box.setCode("hidden-api-box-" + System.nanoTime());
+		box.setVisible(false);
+		ContentDescription description = new ContentDescription();
+		description.setLanguage("en");
+		description.setName(box.getCode());
+		description.setDescription("hidden");
+		box.setDescriptions(Arrays.asList(description));
+
+		ResponseEntity<Entity> created = testRestTemplate.postForEntity("/api/v1/private/content/box",
+				new HttpEntity<>(box, getHeader()), Entity.class);
+		assertEquals(HttpStatus.CREATED, created.getStatusCode());
+
+		ResponseEntity<String> list = testRestTemplate.exchange("/api/v1/content/boxes?page=0&count=20", HttpMethod.GET,
+				new HttpEntity<>(getHeader()), String.class);
+		assertEquals(HttpStatus.OK, list.getStatusCode());
+		assertFalse(list.getBody().contains(box.getCode()));
+
+		ResponseEntity<String> read = testRestTemplate.exchange("/api/v1/content/boxes/" + box.getCode(),
+				HttpMethod.GET, new HttpEntity<>(getHeader()), String.class);
+		assertEquals(HttpStatus.NOT_FOUND, read.getStatusCode());
+	}
+}
