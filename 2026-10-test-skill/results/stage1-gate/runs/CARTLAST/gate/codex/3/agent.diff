+    @Test
+    @Order(8)
+    public void deletingLastProductKeepsCartReusable() {
+        ReadableProduct product = sampleProduct("deleteLastProduct");
+        PersistableShoppingCartItem item = new PersistableShoppingCartItem();
+        item.setProduct(product.getSku());
+        item.setQuantity(1);
+        HttpEntity<PersistableShoppingCartItem> entity = new HttpEntity<>(item, getHeader());
+
+        ReadableShoppingCart created = testRestTemplate.postForEntity("/api/v1/cart", entity,
+                ReadableShoppingCart.class).getBody();
+        ResponseEntity<ReadableShoppingCart> deleted = testRestTemplate.exchange(
+                "/api/v1/cart/" + created.getCode() + "/product/" + product.getSku(), HttpMethod.DELETE,
+                new HttpEntity<>(getHeader()), ReadableShoppingCart.class);
+        ResponseEntity<ReadableShoppingCart> fetched = testRestTemplate.exchange("/api/v1/cart/" + created.getCode(),
+                HttpMethod.GET, new HttpEntity<>(getHeader()), ReadableShoppingCart.class);
+        ResponseEntity<ReadableShoppingCart> added = testRestTemplate.exchange("/api/v1/cart/" + created.getCode(),
+                HttpMethod.PUT, entity, ReadableShoppingCart.class);
+
+        assertThat(deleted.getStatusCode(), is(NO_CONTENT));
+        assertThat(fetched.getStatusCode(), is(OK));
+        assertEquals(0, fetched.getBody().getQuantity());
+        assertEquals(BigDecimal.ZERO, fetched.getBody().getSubtotal());
+        assertThat(added.getStatusCode(), is(CREATED));
+        assertEquals(1, added.getBody().getQuantity());
+    }
+
+    @Test
+    @Order(9)
+    public void settingLastProductQuantityToZeroKeepsCartReusable() {
+        ReadableProduct product = sampleProduct("zeroLastProduct");
+        PersistableShoppingCartItem item = new PersistableShoppingCartItem();
+        item.setProduct(product.getSku());
+        item.setQuantity(1);
+        HttpEntity<PersistableShoppingCartItem> entity = new HttpEntity<>(item, getHeader());
+        ReadableShoppingCart created = testRestTemplate.postForEntity("/api/v1/cart", entity,
+                ReadableShoppingCart.class).getBody();
+
+        item.setQuantity(0);
+        ResponseEntity<ReadableShoppingCart> emptied = testRestTemplate.exchange("/api/v1/cart/" + created.getCode(),
+                HttpMethod.PUT, entity, ReadableShoppingCart.class);
+        ResponseEntity<ReadableShoppingCart> fetched = testRestTemplate.exchange("/api/v1/cart/" + created.getCode(),
+                HttpMethod.GET, new HttpEntity<>(getHeader()), ReadableShoppingCart.class);
+        item.setQuantity(1);
+        ResponseEntity<ReadableShoppingCart> added = testRestTemplate.exchange("/api/v1/cart/" + created.getCode(),
+                HttpMethod.PUT, entity, ReadableShoppingCart.class);
+
+        assertThat(emptied.getStatusCode(), is(CREATED));
+        assertEquals(0, emptied.getBody().getQuantity());
+        assertThat(fetched.getStatusCode(), is(OK));
+        assertEquals(0, fetched.getBody().getQuantity());
+        assertEquals(BigDecimal.ZERO, fetched.getBody().getSubtotal());
+        assertThat(added.getStatusCode(), is(CREATED));
+        assertEquals(1, added.getBody().getQuantity());
+    }
