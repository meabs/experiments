+    /**
+     * An emptied cart remains readable and can be reused with its original code.
+     */
+    @Test
+    @Order(8)
+    public void emptyCartCanBeReadAndReused() throws Exception {
+
+        final ResponseEntity<ReadableShoppingCart> emptyCart = testRestTemplate.exchange(
+                "/api/v1/cart/" + data.getCartId(), HttpMethod.GET,
+                new HttpEntity<>(getHeader()), ReadableShoppingCart.class);
+
+        assertThat(emptyCart.getStatusCode(), is(OK));
+        assertEquals(data.getCartId(), emptyCart.getBody().getCode());
+        assertEquals(0, emptyCart.getBody().getQuantity());
+        assertEquals(0, emptyCart.getBody().getProducts().size());
+        assertEquals(0, emptyCart.getBody().getSubtotal().compareTo(java.math.BigDecimal.ZERO));
+
+        PersistableShoppingCartItem cartItem = new PersistableShoppingCartItem();
+        cartItem.setProduct(data.getProducts().get(0).getSku());
+        cartItem.setQuantity(1);
+
+        final ResponseEntity<ReadableShoppingCart> reusedCart = testRestTemplate.exchange(
+                "/api/v1/cart/" + data.getCartId(), HttpMethod.PUT,
+                new HttpEntity<>(cartItem, getHeader()), ReadableShoppingCart.class);
+
+        assertThat(reusedCart.getStatusCode(), is(CREATED));
+        assertEquals(data.getCartId(), reusedCart.getBody().getCode());
+        assertEquals(1, reusedCart.getBody().getQuantity());
+    }
+
 }
