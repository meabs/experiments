+package com.salesmanager.test.shop.integration.cart;
+
+import static org.hamcrest.core.Is.is;
+import static org.junit.Assert.assertThat;
+import static org.springframework.http.HttpStatus.CREATED;
+import static org.springframework.http.HttpStatus.OK;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit.jupiter.SpringExtension;
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.catalog.product.ReadableProduct;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@ExtendWith(SpringExtension.class)
+public class EmptyCartAPIIntegrationTest extends ServicesTestSupport {
+
+    @Autowired
+    private org.springframework.boot.test.web.client.TestRestTemplate testRestTemplate;
+
+    @Test
+    public void emptyCartRemainsReadableAndReusable() {
+        ReadableProduct product = sampleProduct("emptyCartApi");
+
+        PersistableShoppingCartItem item = new PersistableShoppingCartItem();
+        item.setProduct(product.getSku());
+        item.setQuantity(1);
+        HttpEntity<PersistableShoppingCartItem> entity = new HttpEntity<>(item, getHeader());
+
+        ResponseEntity<ReadableShoppingCart> created = testRestTemplate.postForEntity(
+                "/api/v1/cart", entity, ReadableShoppingCart.class);
+        assertThat(created.getStatusCode(), is(CREATED));
+        String cartCode = created.getBody().getCode();
+
+        ResponseEntity<Void> deleted = testRestTemplate.exchange(
+                "/api/v1/cart/" + cartCode + "/product/" + product.getSku(), HttpMethod.DELETE,
+                new HttpEntity<>(getHeader()), Void.class);
+        assertThat(deleted.getStatusCode(), is(org.springframework.http.HttpStatus.NO_CONTENT));
+
+        ResponseEntity<ReadableShoppingCart> empty = testRestTemplate.getForEntity(
+                "/api/v1/cart/" + cartCode, ReadableShoppingCart.class);
+        assertThat(empty.getStatusCode(), is(OK));
+        assertThat(empty.getBody().getProducts().size(), is(0));
+        assertThat(empty.getBody().getQuantity(), is(0));
+        assertThat(empty.getBody().getSubtotal().signum(), is(0));
+
+        item.setQuantity(1);
+        ResponseEntity<ReadableShoppingCart> reused = testRestTemplate.exchange(
+                "/api/v1/cart/" + cartCode, HttpMethod.PUT, new HttpEntity<>(item, getHeader()),
+                ReadableShoppingCart.class);
+        assertThat(reused.getStatusCode(), is(CREATED));
+        assertThat(reused.getBody().getQuantity(), is(1));
+    }
+}
