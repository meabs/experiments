+package com.salesmanager.test.shop.integration.customer;
+
+import static org.hamcrest.core.Is.is;
+import static org.junit.Assert.assertThat;
+import static org.springframework.http.HttpStatus.OK;
+import static org.springframework.http.HttpStatus.UNAUTHORIZED;
+
+import java.util.UUID;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.core.business.constants.Constants;
+import com.salesmanager.core.model.customer.CustomerGender;
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.customer.PersistableCustomer;
+import com.salesmanager.shop.model.customer.ReadableCustomer;
+import com.salesmanager.shop.model.customer.address.Address;
+import com.salesmanager.shop.store.security.AuthenticationRequest;
+import com.salesmanager.shop.store.security.AuthenticationResponse;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class CustomerAdminUpdateLoginIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void adminUpdateChangesCustomerEmailAndPasswordUsedForLogin() {
+        String suffix = UUID.randomUUID().toString();
+        String oldEmail = "admin-update-old-" + suffix + "@test.com";
+        String newEmail = "admin-update-new-" + suffix + "@test.com";
+        String oldPassword = "old-password";
+        String newPassword = "new-password";
+
+        PersistableCustomer registration = new PersistableCustomer();
+        registration.setEmailAddress(oldEmail);
+        registration.setPassword(oldPassword);
+        registration.setGender(CustomerGender.M.name());
+        registration.setLanguage("en");
+        registration.setStoreCode(Constants.DEFAULT_STORE);
+        Address billing = new Address();
+        billing.setCountry("BE");
+        billing.setFirstName("Admin");
+        billing.setLastName("Update");
+        registration.setBilling(billing);
+        ResponseEntity<PersistableCustomer> registered = testRestTemplate.postForEntity(
+                "/api/v1/customer/register", new HttpEntity<>(registration, getHeader()),
+                PersistableCustomer.class);
+        assertThat(registered.getStatusCode(), is(OK));
+
+        ReadableCustomer customer = fetchCustomers().getCustomers().stream()
+                .filter(candidate -> oldEmail.equals(candidate.getEmailAddress()))
+                .findFirst()
+                .orElseThrow(() -> new AssertionError("Registered customer was not listed"));
+
+        PersistableCustomer update = new PersistableCustomer();
+        update.setEmailAddress(newEmail);
+        update.setPassword(newPassword);
+        ResponseEntity<PersistableCustomer> updated = testRestTemplate.exchange(
+                "/api/v1/private/customer/" + customer.getId(), HttpMethod.PUT,
+                new HttpEntity<>(update, getHeader()), PersistableCustomer.class);
+        assertThat(updated.getStatusCode(), is(OK));
+
+        assertThat(login(oldEmail, oldPassword).getStatusCode(), is(UNAUTHORIZED));
+        assertThat(login(oldEmail, newPassword).getStatusCode(), is(UNAUTHORIZED));
+        assertThat(login(newEmail, oldPassword).getStatusCode(), is(UNAUTHORIZED));
+        assertThat(login(newEmail, newPassword).getStatusCode(), is(OK));
+    }
+
+    private ResponseEntity<AuthenticationResponse> login(String email, String password) {
+        return testRestTemplate.postForEntity("/api/v1/customer/login",
+                new HttpEntity<>(new AuthenticationRequest(email, password)),
+                AuthenticationResponse.class);
+    }
+}
