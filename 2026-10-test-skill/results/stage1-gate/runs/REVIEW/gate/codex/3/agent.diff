+package com.salesmanager.test.shop.integration.product;
+
+import static org.mockito.Mockito.when;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.salesmanager.core.business.services.catalog.product.review.ProductReviewService;
+import com.salesmanager.core.model.catalog.product.review.ProductReview;
+import com.salesmanager.shop.store.api.v1.product.ProductReviewApi;
+import com.salesmanager.shop.store.controller.product.facade.ProductCommonFacade;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.Mock;
+import org.mockito.junit.MockitoJUnitRunner;
+import org.springframework.test.util.ReflectionTestUtils;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+
+@RunWith(MockitoJUnitRunner.class)
+public class ProductReviewApiTest {
+
+  private static final Long PRODUCT_ID = 42L;
+  private static final Long CUSTOMER_ID = 7L;
+
+  @Mock
+  private ProductCommonFacade productCommonFacade;
+
+  @Mock
+  private ProductReviewService productReviewService;
+
+  private MockMvc mockMvc;
+
+  @Before
+  public void setUp() {
+    ProductReviewApi api = new ProductReviewApi();
+    ReflectionTestUtils.setField(api, "productCommonFacade", productCommonFacade);
+    ReflectionTestUtils.setField(api, "productReviewService", productReviewService);
+    mockMvc = MockMvcBuilders.standaloneSetup(api).build();
+  }
+
+  @Test
+  public void rejectsOutOfRangeRatingWithBadRequest() throws Exception {
+    when(productReviewService.getByProductAndCustomer(PRODUCT_ID, CUSTOMER_ID)).thenReturn(null);
+
+    mockMvc.perform(post("/api/v1/private/products/{id}/reviews", PRODUCT_ID)
+            .contentType("application/json")
+            .content(reviewJson(0D)))
+        .andExpect(status().isBadRequest());
+  }
+
+  @Test
+  public void rejectsDuplicateReviewWithConflict() throws Exception {
+    when(productReviewService.getByProductAndCustomer(PRODUCT_ID, CUSTOMER_ID))
+        .thenReturn(new ProductReview());
+
+    mockMvc.perform(post("/api/v1/private/products/{id}/reviews", PRODUCT_ID)
+            .contentType("application/json")
+            .content(reviewJson(4D)))
+        .andExpect(status().isConflict());
+  }
+
+  private String reviewJson(Double rating) throws Exception {
+    return new ObjectMapper().writeValueAsString(new ReviewRequest(CUSTOMER_ID, rating));
+  }
+
+  private static class ReviewRequest {
+    public Long customerId;
+    public Double rating;
+
+    ReviewRequest(Long customerId, Double rating) {
+      this.customerId = customerId;
+      this.rating = rating;
+    }
+  }
+}
