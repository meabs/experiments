+      newUser.setLastName("Status");
+      newUser.setUserName(username);
+      newUser.setPassword(CREATED_PASSWORD);
+      newUser.setRepeatPassword(CREATED_PASSWORD);
+      PersistableGroup group = new PersistableGroup();
+      group.setName("ADMIN");
+      newUser.getGroups().add(group);
+
+      HttpEntity<PersistableUser> request = new HttpEntity<>(newUser, getHeader());
+      ResponseEntity<ReadableUser> created = testRestTemplate.exchange(
+          "/api/v1/private/user/", HttpMethod.POST, request, ReadableUser.class);
+      assertEquals(HttpStatus.OK, created.getStatusCode());
+
+      ResponseEntity<ReadableUser> duplicate = testRestTemplate.exchange(
+          "/api/v1/private/user/", HttpMethod.POST, request, ReadableUser.class);
+      assertEquals(HttpStatus.CONFLICT, duplicate.getStatusCode());
+
+      ResponseEntity<ReadableUser> missingUpdate = testRestTemplate.exchange(
+          "/api/v1/private/user/999999999", HttpMethod.PUT, request, ReadableUser.class);
+      assertEquals(HttpStatus.NOT_FOUND, missingUpdate.getStatusCode());
+
+      UserPassword wrongPassword = new UserPassword();
+      wrongPassword.setPassword("wrong-current-password");
+      wrongPassword.setChangePassword(NEW_CREATED_PASSWORD);
+      ResponseEntity<Void> wrongPasswordResponse = testRestTemplate.exchange(
+          "/api/v1/private/user/" + created.getBody().getId() + "/password", HttpMethod.PATCH,
+          new HttpEntity<>(wrongPassword, getHeader()), Void.class);
+      assertEquals(HttpStatus.BAD_REQUEST, wrongPasswordResponse.getStatusCode());
+
+      UserPassword rightPassword = new UserPassword();
+      rightPassword.setPassword(CREATED_PASSWORD);
+      rightPassword.setChangePassword(NEW_CREATED_PASSWORD);
+      ResponseEntity<Void> rightPasswordResponse = testRestTemplate.exchange(
+          "/api/v1/private/user/" + created.getBody().getId() + "/password", HttpMethod.PATCH,
+          new HttpEntity<>(rightPassword, getHeader()), Void.class);
+      assertEquals(HttpStatus.OK, rightPasswordResponse.getStatusCode());
+
+      UserPassword missingPassword = new UserPassword();
+      missingPassword.setPassword(CREATED_PASSWORD);
+      missingPassword.setChangePassword(NEW_CREATED_PASSWORD);
+      ResponseEntity<Void> missingPasswordResponse = testRestTemplate.exchange(
+          "/api/v1/private/user/999999999/password", HttpMethod.PATCH,
+          new HttpEntity<>(missingPassword, getHeader()), Void.class);
+      assertEquals(HttpStatus.NOT_FOUND, missingPasswordResponse.getStatusCode());
+  }
   
 
 
