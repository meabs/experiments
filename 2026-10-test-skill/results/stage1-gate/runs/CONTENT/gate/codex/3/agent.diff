+package com.salesmanager.test.shop.integration.content;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+
+import java.util.Arrays;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.content.common.ContentDescription;
+import com.salesmanager.shop.model.content.box.PersistableContentBox;
+import com.salesmanager.shop.model.content.page.PersistableContentPage;
+import com.salesmanager.shop.model.entity.Entity;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@RunWith(SpringRunner.class)
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+public class ContentApiIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void listsPagesAndBoxesWithoutPaginationParameters() {
+        String suffix = String.valueOf(System.currentTimeMillis());
+        HttpEntity<Object> pageRequest = new HttpEntity<>(contentPage("api-page-" + suffix), getHeader());
+        HttpEntity<Object> boxRequest = new HttpEntity<>(contentBox("api-box-" + suffix), getHeader());
+
+        ResponseEntity<Entity> pageCreated = testRestTemplate.postForEntity("/api/v1/private/content/page?store=DEFAULT&lang=en", pageRequest, Entity.class);
+        ResponseEntity<Entity> boxCreated = testRestTemplate.postForEntity("/api/v1/private/content/box?store=DEFAULT&lang=en", boxRequest, Entity.class);
+        assertEquals(HttpStatus.CREATED, pageCreated.getStatusCode());
+        assertEquals(HttpStatus.CREATED, boxCreated.getStatusCode());
+
+        HttpEntity<Void> request = new HttpEntity<>(getHeader());
+        ResponseEntity<String> pages = testRestTemplate.exchange("/api/v1/content/pages?store=DEFAULT&lang=en", HttpMethod.GET, request, String.class);
+        ResponseEntity<String> boxes = testRestTemplate.exchange("/api/v1/content/boxes?store=DEFAULT&lang=en", HttpMethod.GET, request, String.class);
+
+        assertEquals(HttpStatus.OK, pages.getStatusCode());
+        assertEquals(HttpStatus.OK, boxes.getStatusCode());
+        assertNotNull(pages.getBody());
+        assertNotNull(boxes.getBody());
+        assert pages.getBody().contains("api-page-" + suffix);
+        assert pages.getBody().contains("linkToMenu");
+        assert boxes.getBody().contains("api-box-" + suffix);
+    }
+
+    private PersistableContentPage contentPage(String code) {
+        PersistableContentPage page = new PersistableContentPage();
+        page.setCode(code);
+        page.setDescriptions(Arrays.asList(description(code)));
+        return page;
+    }
+
+    private PersistableContentBox contentBox(String code) {
+        PersistableContentBox box = new PersistableContentBox();
+        box.setCode(code);
+        box.setDescriptions(Arrays.asList(description(code)));
+        return box;
+    }
+
+    private ContentDescription description(String code) {
+        ContentDescription description = new ContentDescription();
+        description.setLanguage("en");
+        description.setName(code);
+        description.setTitle(code);
+        return description;
+    }
+}
