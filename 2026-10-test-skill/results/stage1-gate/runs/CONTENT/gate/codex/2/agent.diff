+package com.salesmanager.test.shop.integration.content;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@RunWith(SpringRunner.class)
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+public class ContentListApiIntegrationTest extends ServicesTestSupport {
+
+    private final ObjectMapper objectMapper = new ObjectMapper();
+
+    @Test
+    public void listsPagesAndBoxesThroughApi() throws Exception {
+        HttpEntity<String> request = new HttpEntity<>(getHeader());
+
+        ResponseEntity<String> pages = testRestTemplate.exchange(
+                "/api/v1/content/pages?store=DEFAULT&lang=en&page=0&count=20",
+                HttpMethod.GET, request, String.class);
+        ResponseEntity<String> boxes = testRestTemplate.exchange(
+                "/api/v1/content/boxes?store=DEFAULT&lang=en&page=0&count=20",
+                HttpMethod.GET, request, String.class);
+
+        assertEquals(HttpStatus.OK, pages.getStatusCode());
+        assertEquals(HttpStatus.OK, boxes.getStatusCode());
+        assertContentType(objectMapper.readTree(pages.getBody()), "PAGE");
+        assertContentType(objectMapper.readTree(boxes.getBody()), "BOX");
+    }
+
+    private void assertContentType(JsonNode response, String expectedType) {
+        assertTrue(response.has("items"));
+        assertTrue(response.get("items").isArray());
+        for (JsonNode item : response.get("items")) {
+            assertEquals(expectedType, item.get("contentType").asText());
+        }
+    }
+}
