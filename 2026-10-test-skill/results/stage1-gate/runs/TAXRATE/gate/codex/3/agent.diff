+
+        taxRate.setRate(null);
+        ResponseEntity<Entity> missing = testRestTemplate.postForEntity(
+                "/api/v1/private/tax/rate", new HttpEntity<>(taxRate, getHeader()), Entity.class);
+        assertEquals(HttpStatus.BAD_REQUEST, missing.getStatusCode());
+
+        taxRate.setRate(new BigDecimal("5"));
+        ResponseEntity<Entity> created = testRestTemplate.postForEntity(
+                "/api/v1/private/tax/rate", new HttpEntity<>(taxRate, getHeader()), Entity.class);
+        assertEquals(HttpStatus.OK, created.getStatusCode());
+
+        taxRate.setRate(new BigDecimal("-1"));
+        ResponseEntity<Void> invalidUpdate = testRestTemplate.exchange(
+                "/api/v1/private/tax/rate/" + created.getBody().getId(), HttpMethod.PUT,
+                new HttpEntity<>(taxRate, getHeader()), Void.class);
+        assertEquals(HttpStatus.BAD_REQUEST, invalidUpdate.getStatusCode());
+
+        ResponseEntity<ReadableTaxRate> unchanged = testRestTemplate.exchange(
+                "/api/v1/private/tax/rate/" + created.getBody().getId(), HttpMethod.GET,
+                new HttpEntity<>(getHeader()), ReadableTaxRate.class);
+        assertEquals("5.0000", unchanged.getBody().getRate());
+    }
