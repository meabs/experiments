+    @Test
+    public void duplicateCategoryCodeReturnsConflictAndDoesNotBreakOwnCodeUpdate() {
+        String suffix = UUID.randomUUID().toString();
+        String existingCode = "duplicate-" + suffix;
+        String otherCode = "other-" + suffix;
+
+        ResponseEntity<PersistableCategory> created = testRestTemplate.postForEntity(
+                "/api/v1/private/category", new HttpEntity<>(categoryJson(existingCode), getHeader()),
+                PersistableCategory.class);
+        assertThat(created.getStatusCode(), is(CREATED));
+
+        ResponseEntity<PersistableCategory> duplicateCreate = testRestTemplate.postForEntity(
+                "/api/v1/private/category", new HttpEntity<>(categoryJson(existingCode), getHeader()),
+                PersistableCategory.class);
+        assertThat(duplicateCreate.getStatusCode(), is(HttpStatus.CONFLICT));
+
+        ResponseEntity<PersistableCategory> otherCreated = testRestTemplate.postForEntity(
+                "/api/v1/private/category", new HttpEntity<>(categoryJson(otherCode), getHeader()),
+                PersistableCategory.class);
+        assertThat(otherCreated.getStatusCode(), is(CREATED));
+
+        PersistableCategory update = otherCreated.getBody();
+        update.setCode(existingCode);
+        ResponseEntity<PersistableCategory> duplicateUpdate = testRestTemplate.exchange(
+                "/api/v1/private/category/" + update.getId(), HttpMethod.PUT,
+                new HttpEntity<>(update, getHeader()), PersistableCategory.class);
+        assertThat(duplicateUpdate.getStatusCode(), is(HttpStatus.CONFLICT));
+
+        update.setCode(otherCode);
+        ResponseEntity<PersistableCategory> ownCodeUpdate = testRestTemplate.exchange(
+                "/api/v1/private/category/" + update.getId(), HttpMethod.PUT,
+                new HttpEntity<>(update, getHeader()), PersistableCategory.class);
+        assertThat(ownCodeUpdate.getStatusCode(), is(OK));
+    }
+
