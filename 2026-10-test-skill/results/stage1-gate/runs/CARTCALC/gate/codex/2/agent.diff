+package com.salesmanager.test.shop.integration.cart;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNotNull;
+
+import java.math.BigDecimal;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.boot.test.web.client.TestRestTemplate;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit.jupiter.SpringExtension;
+import org.junit.jupiter.api.extension.ExtendWith;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.catalog.product.ReadableProduct;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCartItem;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@ExtendWith(SpringExtension.class)
+class CartQuantityPricingAPIIntegrationTest extends ServicesTestSupport {
+
+    @Autowired
+    private TestRestTemplate testRestTemplate;
+
+    @Test
+    void cartApiReturnsLineAndCartAmountsForEveryUnit() {
+        ReadableProduct product = sampleProduct("cartQuantityPricing");
+        BigDecimal unitPrice = new BigDecimal(product.getFinalPrice().replaceAll("[^0-9.-]", ""));
+
+        PersistableShoppingCartItem request = new PersistableShoppingCartItem();
+        request.setProduct(product.getSku());
+        request.setQuantity(2);
+
+        ResponseEntity<ReadableShoppingCart> added = testRestTemplate.postForEntity(
+                "/api/v1/cart/", new HttpEntity<>(request, getHeader()), ReadableShoppingCart.class);
+        assertNotNull(added.getBody());
+
+        ResponseEntity<ReadableShoppingCart> fetched = testRestTemplate.getForEntity(
+                "/api/v1/cart/" + added.getBody().getCode(), ReadableShoppingCart.class);
+        ReadableShoppingCart cart = fetched.getBody();
+        assertNotNull(cart);
+        ReadableShoppingCartItem line = cart.getProducts().stream()
+                .filter(item -> product.getSku().equals(item.getSku())).findFirst().orElseThrow();
+        BigDecimal expected = unitPrice.multiply(BigDecimal.valueOf(2));
+        assertEquals(expected, line.getSubTotal());
+        assertEquals(expected, cart.getSubtotal());
+        assertEquals(expected, cart.getTotal());
+    }
+}
