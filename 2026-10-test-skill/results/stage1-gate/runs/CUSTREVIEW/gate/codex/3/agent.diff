+package com.salesmanager.test.shop.integration.customer;
+
+import static org.junit.Assert.assertEquals;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.customer.PersistableCustomerReview;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@RunWith(SpringRunner.class)
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+public class CustomerReviewApiIntegrationTest extends ServicesTestSupport {
+
+  @Test
+  public void missingReviewReturnsNotFoundForUpdateAndDelete() {
+    HttpEntity<PersistableCustomerReview> updateRequest =
+        new HttpEntity<>(review(), getHeader());
+
+    ResponseEntity<String> updateResponse = testRestTemplate.exchange(
+        "/api/v1/private/customers/1/reviews/999999999?store=DEFAULT&lang=en",
+        HttpMethod.PUT, updateRequest, String.class);
+    assertEquals(HttpStatus.NOT_FOUND, updateResponse.getStatusCode());
+
+    ResponseEntity<String> deleteResponse = testRestTemplate.exchange(
+        "/api/v1/private/customers/1/reviews/999999999?store=DEFAULT&lang=en",
+        HttpMethod.DELETE, new HttpEntity<>(getHeader()), String.class);
+    assertEquals(HttpStatus.NOT_FOUND, deleteResponse.getStatusCode());
+  }
+
+  private PersistableCustomerReview review() {
+    PersistableCustomerReview review = new PersistableCustomerReview();
+    review.setCustomerId(1L);
+    review.setRating(4D);
+    review.setDescription("Corrected review");
+    return review;
+  }
+}
