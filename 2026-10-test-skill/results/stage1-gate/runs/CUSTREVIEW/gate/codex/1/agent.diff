+package com.salesmanager.test.shop.integration.customer;
+
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.eq;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.put;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.salesmanager.shop.model.customer.PersistableCustomerReview;
+import com.salesmanager.shop.store.api.v1.customer.CustomerReviewApi;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.store.facade.StoreFacade;
+import com.salesmanager.shop.utils.LanguageUtils;
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.Mock;
+import org.mockito.junit.MockitoJUnitRunner;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+
+@RunWith(MockitoJUnitRunner.class)
+public class CustomerReviewApiTest {
+
+  @Mock private CustomerFacade customerFacade;
+  @Mock private StoreFacade storeFacade;
+  @Mock private LanguageUtils languageUtils;
+
+  private MockMvc mockMvc;
+
+  @Before
+  public void setUp() {
+    CustomerReviewApi api = new CustomerReviewApi();
+    setField(api, "customerFacade", customerFacade);
+    setField(api, "storeFacade", storeFacade);
+    setField(api, "languageUtils", languageUtils);
+    mockMvc = MockMvcBuilders.standaloneSetup(api).build();
+  }
+
+  @Test
+  public void updateUsesReviewIdFromPath() throws Exception {
+    PersistableCustomerReview response = new PersistableCustomerReview();
+    response.setId(42L);
+    when(customerFacade.updateCustomerReview(eq(7L), eq(42L), any(PersistableCustomerReview.class), any(), any()))
+        .thenReturn(response);
+
+    mockMvc.perform(put("/api/v1/private/customers/7/reviews/42")
+        .contentType("application/json")
+        .content("{\"rating\":5,\"description\":\"Resolved dispute\",\"customerId\":1}"))
+        .andExpect(status().isOk());
+
+    verify(customerFacade).updateCustomerReview(eq(7L), eq(42L), any(PersistableCustomerReview.class), any(), any());
+  }
+
+  private static void setField(Object target, String name, Object value) {
+    try {
+      java.lang.reflect.Field field = target.getClass().getDeclaredField(name);
+      field.setAccessible(true);
+      field.set(target, value);
+    } catch (ReflectiveOperationException e) {
+      throw new AssertionError(e);
+    }
+  }
+}
