 	public void update(CustomerReview review) throws ServiceException {
-		this.saveOrUpdate(review);
+		Validate.notNull(review,"CustomerReview cannot be null");
+		Validate.notNull(review.getReviewedCustomer(),"CustomerReview.reviewedCustomer cannot be null");
+
+		// Updating a review must replace its contribution to the aggregate rather
+		// than count the same review a second time.
+		super.update(review);
+
+		Customer customer = customerService.getById(review.getReviewedCustomer().getId());
+		List<CustomerReview> reviews = customerReviewRepository.findByReviewed(customer.getId());
+		BigDecimal totalRating = BigDecimal.ZERO;
+		for (CustomerReview customerReview : reviews) {
+			totalRating = totalRating.add(BigDecimal.valueOf(customerReview.getReviewRating()));
+		}
+		customer.setCustomerReviewCount(reviews.size());
+		customer.setCustomerReviewAvg(reviews.isEmpty()
+				? BigDecimal.ZERO
+				: totalRating.divide(BigDecimal.valueOf(reviews.size()), 10, java.math.RoundingMode.HALF_UP));
+		customerService.update(customer);
 	}
 	
 	public void create(CustomerReview review) throws ServiceException {
 		this.saveOrUpdate(review);
 	}
+
+	@Override
+	public CustomerReview getById(Long id) {
+		return customerReviewRepository.findOne(id);
+	}
 	
 	
 
