+	private void refreshProductRating(Product product) {
+		List<ProductReview> reviews = productReviewRepository.findByProductNoCustomers(product.getId());
+		BigDecimal total = BigDecimal.ZERO;
+		for (ProductReview current : reviews) {
+			total = total.add(BigDecimal.valueOf(current.getReviewRating()));
+		}
+		product.setProductReviewCount(reviews.size());
+		product.setProductReviewAvg(reviews.isEmpty()
+				? BigDecimal.ZERO
+				: total.divide(BigDecimal.valueOf(reviews.size()), 10, java.math.RoundingMode.HALF_UP));
+	}
