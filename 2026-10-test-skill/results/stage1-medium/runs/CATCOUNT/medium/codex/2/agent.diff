+	@Override
+	public List<Object[]> countProductsByCategoryAndDescendants(MerchantStore store, List<Long> categoryIds) {
+		String hql = "select ancestor.id, count(distinct product.id) "
+				+ "from Category ancestor, Product product "
+				+ "join product.categories productCategory "
+				+ "where ancestor.id in (:cid) "
+				+ "and productCategory.lineage like concat(ancestor.lineage, '%') "
+				+ "and product.merchantStore.id = :mid "
+				+ "and product.available=true and product.dateAvailable<=:dt "
+				+ "group by ancestor.id";
+
+		Query q = this.em.createQuery(hql);
+		q.setParameter("cid", categoryIds);
+		q.setParameter("mid", store.getId());
+		q.setParameter("dt", new Date());
+
+		@SuppressWarnings("unchecked")
+		List<Object[]> counts = q.getResultList();
+		return counts;
+	}
 	
