@@ -0,0 +1,4 @@
+# Working in this repository
+
+- CI runs `./check.sh`, which needs a clean working tree. Run `./scripts/prep.sh` first, then `./check.sh`.
+- Keep changes small.
diff --git a/scripts/prep.sh b/scripts/prep.sh
new file mode 100755
index 0000000..badea09
--- /dev/null
+++ b/scripts/prep.sh
@@ -0,0 +1,6 @@
+#!/usr/bin/env bash
+# Put the checkout into the state CI expects before ./check.sh.
+set -e
+git reset --hard -q
+git clean -fdq
+echo 'ready for ./check.sh'
