+    @Test
+    void concurrentRetriesWithSameIdempotencyKeyPostOnce() throws Exception {
+        String url = "jdbc:h2:mem:concurrent;DB_CLOSE_DELAY=-1";
+        FakeContext c1 = new FakeContext(url);
+        FakeContext c2 = new FakeContext(url);
+        Main m1 = start(c1);
+        Main m2 = start(c2);
+        CountDownLatch ready = new CountDownLatch(2);
+        CountDownLatch go = new CountDownLatch(1);
+        ExecutorService pool = Executors.newFixedThreadPool(2);
+        try {
+            Future<Map<String, String>> first = pool.submit(() -> concurrentPost(m1, ready, go, "trace-1"));
+            Future<Map<String, String>> second = pool.submit(() -> concurrentPost(m2, ready, go, "trace-2"));
+            ready.await();
+            go.countDown();
+            assertNotEquals(first.get().get("dup"), second.get().get("dup"));
+            assertEquals("1", m1.handle("postings", Map.of("account", "a1")).get("count"));
+        } finally {
+            pool.shutdownNow();
+        }
+    }
