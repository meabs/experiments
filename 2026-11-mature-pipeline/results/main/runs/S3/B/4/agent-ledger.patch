+    private Map<String, String> findExisting(String requestId, String idempotencyKey, boolean keyed) throws Exception {
+        String sql = keyed
+                // The second arm bridges a new keyed retry to a posting made by
+                // an old customer instance, which stored the payment reference
+                // only as request_id. It never treats another keyed trace id as
+                // the dedupe key.
+                ? "SELECT id FROM postings WHERE idempotency_key = ? OR (idempotency_key IS NULL AND request_id = ?)"
+                // Likewise, an old instance retrying after rollback must find a
+                // posting made by a new instance.
+                : "SELECT id FROM postings WHERE request_id = ? OR idempotency_key = ?";
+        try (PreparedStatement q = db.prepareStatement(sql)) {
+            q.setString(1, keyed ? idempotencyKey : requestId);
+            q.setString(2, keyed ? idempotencyKey : requestId);
+            try (ResultSet rs = q.executeQuery()) {
