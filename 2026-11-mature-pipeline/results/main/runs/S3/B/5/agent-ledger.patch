+    private Long findPostingId(String idempotencyKey, String requestId) throws Exception {
+        if (idempotencyKey != null) {
+            Long id = findByColumn("idempotency_key", idempotencyKey);
+            if (id != null) return id;
+            // A request accepted by an old ledger has no key.  Treating its
+            // request id as the new key makes a mixed-version rollback safe,
+            // without making requestId a dedupe key for keyed rows.
+            return findLegacyPostingId(idempotencyKey);
+        }
+
+        Long id = findByColumn("request_id", requestId);
+        if (id != null) return id;
+        // The new customer may have committed a keyed payment just before
+        // it was rolled back to the old caller, which sends requestId=ref.
+        return findByColumn("idempotency_key", requestId);
+    }
+
+    private Long findLegacyPostingId(String requestId) throws Exception {
+        try (PreparedStatement q = db.prepareStatement(
+                "SELECT id FROM postings WHERE request_id = ? AND idempotency_key IS NULL")) {
+            q.setString(1, requestId);
+            try (ResultSet rs = q.executeQuery()) {
+                return rs.next() ? rs.getLong(1) : null;
+            }
+        }
+    }
+
+    private Long findByColumn(String column, String value) throws Exception {
+        try (PreparedStatement q = db.prepareStatement("SELECT id FROM postings WHERE " + column + " = ?")) {
+            q.setString(1, value);
+            try (ResultSet rs = q.executeQuery()) {
+                return rs.next() ? rs.getLong(1) : null;
+            }
+        }
+    }
+
+    private Map<String, String> duplicate(long id) {
+        return Map.of("id", String.valueOf(id), "dup", "true");
+    }
