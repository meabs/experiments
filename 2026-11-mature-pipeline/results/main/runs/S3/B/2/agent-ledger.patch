+    private Map<String, String> findExisting(String requestId, String idempotencyKey) throws Exception {
+        String sql = idempotencyKey == null
+                // An old caller cannot send an idempotency key.  Looking up every
+                // posting with its request id lets that caller safely retry a
+                // payment created by a new caller before a rollback.  Keyed
+                // callers still deduplicate exclusively by their key.
+                ? "SELECT id FROM postings WHERE request_id = ? ORDER BY id"
+                : "SELECT id FROM postings WHERE idempotency_key = ?";
+        try (PreparedStatement q = db.prepareStatement(sql)) {
+            q.setString(1, idempotencyKey == null ? requestId : idempotencyKey);
+            try (ResultSet rs = q.executeQuery()) {
+                if (rs.next()) return Map.of("id", String.valueOf(rs.getLong(1)), "dup", "true");
+            }
+        }
+        return null;
+    }
+
+    private void dropRequestIdUniqueConstraint() throws Exception {
+        String sql = "SELECT tc.CONSTRAINT_NAME FROM INFORMATION_SCHEMA.TABLE_CONSTRAINTS tc "
+                + "JOIN INFORMATION_SCHEMA.CONSTRAINT_COLUMN_USAGE ccu "
+                + "ON tc.CONSTRAINT_SCHEMA = ccu.CONSTRAINT_SCHEMA AND tc.CONSTRAINT_NAME = ccu.CONSTRAINT_NAME "
+                + "WHERE tc.TABLE_NAME = 'POSTINGS' AND tc.CONSTRAINT_TYPE = 'UNIQUE' AND ccu.COLUMN_NAME = 'REQUEST_ID'";
+        try (Statement q = db.createStatement(); ResultSet rs = q.executeQuery(sql)) {
+            while (rs.next()) {
+                try (Statement alter = db.createStatement()) {
+                    alter.execute("ALTER TABLE postings DROP CONSTRAINT " + rs.getString(1));
+                }
+            }
+        }
+    }
