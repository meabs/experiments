+    @Test
+    void concurrentKeylessRetriesPublishOnlyOnePosting() throws Exception {
+        FakeContext c = new FakeContext();
+        Main first = start(c);
+        Main second = start(c);
+        var ready = new CountDownLatch(2);
+        var go = new CountDownLatch(1);
+        var pool = Executors.newFixedThreadPool(2);
+        try {
+            var a = pool.submit(() -> postAtTheSameTime(first, c, ready, go));
+            var b = pool.submit(() -> postAtTheSameTime(second, c, ready, go));
+            ready.await();
+            go.countDown();
+            var firstResult = a.get();
+            var secondResult = b.get();
+            assertNotEquals(firstResult.get("dup"), secondResult.get("dup"));
+            assertTrue(Set.of("false", "true").contains(firstResult.get("dup")));
+            assertTrue(Set.of("false", "true").contains(secondResult.get("dup")));
+        } finally {
+            pool.shutdownNow();
+        }
+        assertEquals("1", first.handle("postings", Map.of("account", "a1")).get("count"));
+        assertEquals(1, c.events.size());
+    }
