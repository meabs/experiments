+                "SELECT tc.CONSTRAINT_NAME FROM INFORMATION_SCHEMA.TABLE_CONSTRAINTS tc "
+                        + "JOIN INFORMATION_SCHEMA.KEY_COLUMN_USAGE ku ON ku.CONSTRAINT_NAME = tc.CONSTRAINT_NAME "
+                        + "AND ku.CONSTRAINT_SCHEMA = tc.CONSTRAINT_SCHEMA "
+                        + "WHERE tc.TABLE_NAME = 'POSTINGS' AND tc.CONSTRAINT_TYPE = 'UNIQUE' "
+                        + "AND ku.COLUMN_NAME = 'REQUEST_ID'")) {
+            try (ResultSet rs = q.executeQuery()) {
+                while (rs.next()) s.execute("ALTER TABLE postings DROP CONSTRAINT " + quoteIdentifier(rs.getString(1)));
+            }
+        }
+    }
