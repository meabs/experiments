+    @Test
+    void concurrentInstancesPostAnIdempotencyKeyOnlyOnce() throws Exception {
+        FakeContext c = new FakeContext();
+        Main first = start(c);
+        Main second = start(c);
+        CountDownLatch ready = new CountDownLatch(2);
+        CountDownLatch go = new CountDownLatch(1);
+        ExecutorService pool = Executors.newFixedThreadPool(2);
+        try {
+            Future<Map<String, String>> a = pool.submit(() -> postAfter(go, ready, first, "trace-1"));
+            Future<Map<String, String>> b = pool.submit(() -> postAfter(go, ready, second, "trace-2"));
+            ready.await();
+            go.countDown();
+            assertEquals(1, java.util.stream.Stream.of(a.get().get("dup"), b.get().get("dup"))
+                    .filter("false"::equals).count());
+        } finally {
+            pool.shutdownNow();
+        }
+        assertEquals("1", first.handle("postings", Map.of("account", "a1")).get("count"));
+        assertEquals(1, c.events.size());
+    }
+
+    private Map<String, String> postAfter(CountDownLatch go, CountDownLatch ready, Main m, String requestId)
+            throws InterruptedException, ExecutionException, estate.api.ServiceException {
+        ready.countDown();
+        go.await();
+        return m.handle("post", Map.of("account", "a1", "amount", "5.00", "requestId", requestId,
+                "idempotencyKey", "payment-1"));
+    }
