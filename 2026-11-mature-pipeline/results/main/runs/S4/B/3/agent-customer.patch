+package estate.svc;
+
+import org.h2.api.Trigger;
+
+import java.sql.Connection;
+import java.sql.SQLException;
+
+/**
+ * Makes inserts made by an older customer binary safe after CHG-104.
+ * The old binary writes only the public consent column; preserve its basis in
+ * the additive column and expose only the safe value to that binary.
+ */
+public final class MarketingConsentTrigger implements Trigger {
+    @Override
+    public void init(Connection connection, String schemaName, String triggerName,
+                     String tableName, boolean before, int type) {
+    }
+
+    @Override
+    public void fire(Connection connection, Object[] oldRow, Object[] newRow) {
+        if (newRow != null && "implied".equals(newRow[1])) {
+            newRow[2] = "implied";
+            newRow[1] = "none";
+        }
+    }
+
+    @Override
+    public void close() {
+    }
+
+    @Override
+    public void remove() {
+    }
+}
