+    private void recordCapped(String customerId) throws Exception {
+        // MERGE makes the first increment safe when multiple notifier instances
+        // share the database and cap the same customer's queued offers together.
+        try (PreparedStatement up = db.prepareStatement(
+                "MERGE INTO capped (customer_id, dropped) KEY (customer_id) VALUES (?, "
+                        + "COALESCE((SELECT dropped FROM capped WHERE customer_id = ?), 0) + 1)")) {
+            up.setString(1, customerId);
+            up.setString(2, customerId);
+            up.executeUpdate();
+        }
+    }
