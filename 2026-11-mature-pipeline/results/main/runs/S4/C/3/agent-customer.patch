+package estate.svc;
+
+import org.h2.api.Trigger;
+
+import java.sql.Connection;
+import java.sql.SQLException;
+
+/**
+ * Makes inserts from a pre-CHG-104 customer binary safe after the migration.
+ * H2 passes the mutable row to a BEFORE trigger, so the legacy binary's
+ * two-column INSERT is transparently stored as effective none plus its basis.
+ */
+public final class LegacyConsentTrigger implements Trigger {
+    @Override
+    public void init(Connection connection, String schemaName, String triggerName,
+                     String tableName, boolean before, int type) {
+    }
+
+    @Override
+    public void fire(Connection connection, Object[] oldRow, Object[] newRow) throws SQLException {
+        if (newRow != null && newRow.length >= 3 && "implied".equals(newRow[1])) {
+            newRow[1] = "none";
+            newRow[2] = "implied";
+        }
+    }
+
+    @Override
+    public void close() {
+    }
+
+    @Override
+    public void remove() {
+    }
+}
