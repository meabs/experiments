+    @Test
+    void remainsUsableWhenRolledBackVersionWritesLegacyPosting() throws Exception {
+        FakeContext c = new FakeContext();
+        Main m = start(c);
+
+        // The previous release does not know about amount_cents and writes only
+        // the legacy columns. A rollback must remain able to serve traffic.
+        try (var q = c.db().prepareStatement(
+                "INSERT INTO postings(account, amount, request_id, ts) VALUES (?,?,?,?)")) {
+            q.setString(1, "a1");
+            q.setBigDecimal(2, new java.math.BigDecimal("7.25"));
+            q.setString(3, "legacy");
+            q.setLong(4, 0);
+            q.executeUpdate();
+        }
+
+        assertEquals("725", m.handle("balance", Map.of("account", "a1")).get("balanceCents"));
+        start(c); // startup backfills the legacy-only row
+        try (Statement s = c.db().createStatement(); var rs = s.executeQuery(
+                "SELECT amount_cents FROM postings WHERE request_id = 'legacy'")) {
+            assertTrue(rs.next());
+            assertEquals(725, rs.getLong(1));
+        }
+    }
