+    private void migrateAmountsToCents() throws Exception {
+        try (Statement q = db.createStatement();
+             ResultSet rows = q.executeQuery("SELECT id, amount FROM postings");
+             PreparedStatement update = db.prepareStatement("UPDATE postings SET amount_cents = ? WHERE id = ?")) {
+            while (rows.next()) {
+                long cents = rows.getBigDecimal(2).movePointRight(2).longValueExact();
+                update.setLong(1, cents);
+                update.setLong(2, rows.getLong(1));
+                update.addBatch();
+            }
+            update.executeBatch();
+        }
+        // Keep this column nullable: the previous release does not know about it and
+        // must still be able to insert postings if a rollout is rolled back.
+    }
