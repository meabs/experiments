     @Test
+    void migratesExistingPostingsToCents() throws Exception {
+        FakeContext c = new FakeContext();
+        try (var s = c.db().createStatement()) {
+            s.execute("CREATE TABLE schema_version(v INT NOT NULL)");
+            s.execute("INSERT INTO schema_version(v) VALUES (1)");
+            s.execute("CREATE TABLE postings(id BIGINT AUTO_INCREMENT PRIMARY KEY, account VARCHAR(40) NOT NULL, "
+                    + "amount DECIMAL(18,2) NOT NULL, request_id VARCHAR(80) NOT NULL UNIQUE, ts BIGINT NOT NULL)");
+            s.execute("INSERT INTO postings(account, amount, request_id, ts) VALUES ('a1', 7.25, 'old', 1)");
+        }
+
+        Main m = start(c);
+
+        assertEquals("725", m.handle("balance", Map.of("account", "a1")).get("balanceCents"));
+        try (var q = c.db().createStatement(); var rs = q.executeQuery("SELECT amount_cents FROM postings WHERE request_id = 'old'")) {
+            assertTrue(rs.next());
+            assertEquals(725L, rs.getLong(1));
+        }
