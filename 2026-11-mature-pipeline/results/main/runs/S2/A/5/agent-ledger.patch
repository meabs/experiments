+    @Test
+    void mixedVersionWritesRemainReadableAfterRollback() throws Exception {
+        FakeContext c = new FakeContext();
+        try (var s = c.db().createStatement()) {
+            s.execute("CREATE TABLE schema_version(v INT NOT NULL)");
+            s.execute("INSERT INTO schema_version(v) VALUES (1)");
+            s.execute("CREATE TABLE postings(id BIGINT AUTO_INCREMENT PRIMARY KEY, account VARCHAR(40) NOT NULL, "
+                    + "amount DECIMAL(18,2) NOT NULL, request_id VARCHAR(80) NOT NULL UNIQUE, ts BIGINT NOT NULL)");
+            s.execute("INSERT INTO postings(account, amount, request_id, ts) VALUES ('a1', 7.25, 'old', 1)");
+            // Simulate DDL succeeding before the previous process stopped.
+            s.execute("ALTER TABLE postings ADD amount_cents BIGINT");
+        }
+
+        Main m = start(c);
+
+        assertEquals("725", m.handle("balance", Map.of("account", "a1")).get("balanceCents"));
+        // The rolled-back release writes without knowing amount_cents.
+        try (var s = c.db().createStatement()) {
+            s.execute("INSERT INTO postings(account, amount, request_id, ts) VALUES ('a1', 1.00, 'rollback', 2)");
+        }
+        assertEquals("825", m.handle("balance", Map.of("account", "a1")).get("balanceCents"));
+        m.handle("post", Map.of("account", "a1", "amount", "1.00", "requestId", "new"));
+        try (var q = c.db().createStatement(); var rs = q.executeQuery(
+                "SELECT amount, amount_cents FROM postings WHERE request_id = 'new'")) {
+            assertTrue(rs.next());
+            assertEquals("1.00", rs.getBigDecimal(1).toPlainString());
+            assertEquals(100L, rs.getLong(2));
+        }
+    }
