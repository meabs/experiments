+    /**
+     * amountMinor is the current event contract. The decimal fallback keeps a
+     * rolling deployment safe when an event emitted by an older ledger instance
+     * is delivered to this version of customer.
+     */
+    private long amountMinor(Map<String, String> ev) {
+        String minor = ev.get("amountMinor");
+        if (minor != null && !minor.isBlank()) return Long.parseLong(minor);
+
+        String legacy = ev.get("amount");
+        if (legacy == null || legacy.isBlank()) throw new IllegalArgumentException("payment.posted has no amount");
+        return new BigDecimal(legacy).movePointRight(2).longValueExact();
+    }
