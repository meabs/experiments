+    /**
+     * amountMinor is the current event contract. The decimal fallback keeps a
+     * rolling deployment and rollback safe while older ledger instances drain.
+     */
+    private long amountInMinorUnits(Map<String, String> ev) {
+        String amountMinor = ev.get("amountMinor");
+        if (amountMinor != null) return Long.parseLong(amountMinor);
+
+        String legacyAmount = ev.get("amount");
+        if (legacyAmount == null) throw new NumberFormatException("payment.posted is missing amountMinor");
+        return legacyAmountInMinorUnits(legacyAmount);
+    }
+
+    private long legacyAmountInMinorUnits(String amount) {
+        return new BigDecimal(amount).movePointRight(2).longValueExact();
+    }
