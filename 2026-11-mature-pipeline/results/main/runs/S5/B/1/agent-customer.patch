+    /**
+     * New decision instances may identify their scale additively.  During a
+     * mixed-version rollout old instances have no marker, so their bounded
+     * 0-100 response is treated as the legacy scale.
+     */
+    private int scoreScale(Map<String, String> response) {
+        String marker = response.get("scale");
+        if (marker == null) marker = response.get("scoreScale");
+        if ("100".equals(marker)) return 100;
+        if ("1000".equals(marker)) return 1000;
+        try {
+            return Integer.parseInt(response.get("score")) <= 100 ? 100 : 1000;
+        } catch (NumberFormatException e) {
+            return 1000;
+        }
+    }
