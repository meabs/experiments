+
+        // During a rolling deployment an old decision instance can still return
+        // the original 0..100 score.  Its equivalent thresholds are 60 and 40.
+        // New scores are 0..1000 and use 600 and 400.  Keep the wire value
+        // unchanged so callers see exactly what decision returned.
+        String decision;
+        if (score <= 100) {
+            decision = score >= 60 ? "APPROVE" : score >= 40 ? "REFER" : "DECLINE";
+        } else {
+            decision = score >= 600 ? "APPROVE" : score >= 400 ? "REFER" : "DECLINE";
+        }
+        return Map.of("decision", decision, "score", scoreText);
