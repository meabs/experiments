+
+import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Query;
+
+import com.salesmanager.core.model.catalog.discount.DiscountCode;
+
+public interface DiscountCodeRepository extends JpaRepository<DiscountCode, Long> {
+
+	@Query("select d from DiscountCode d where d.merchantStore.id = ?1 order by d.codeKey")
+	List<DiscountCode> findByStore(Integer storeId);
+
+	@Query("select d from DiscountCode d where d.merchantStore.id = ?1 and d.codeKey = ?2")
+	Optional<DiscountCode> findByStoreAndKey(Integer storeId, String codeKey);
+
+	@Query("select d from DiscountCode d where d.merchantStore.id = ?1 and d.id = ?2")
+	Optional<DiscountCode> findByStoreAndId(Integer storeId, Long id);
+}
