+package com.salesmanager.shop.store.api.v1.discount;
+
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.time.format.DateTimeParseException;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.stream.Collectors;
+
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.repositories.catalog.discount.DiscountCodeRepository;
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.model.catalog.discount.DiscountCode;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.controller.discount.DiscountCalculator;
+
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Admin API for a store's discount codes (reference implementation for the pilot's DISCOUNT feature). */
+@RestController
+@RequestMapping("/api/v1/private/discounts")
+@ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT") })
+public class DiscountApi {
+
+	@Autowired
+	private DiscountCodeRepository repository;
+
+	@Autowired
+	private CategoryService categoryService;
+
+	@GetMapping
+	public List<Map<String, Object>> list(@ApiIgnore MerchantStore store) {
+		return repository.findByStore(store.getId()).stream().map(DiscountApi::readable).collect(Collectors.toList());
+	}
+
+	@PostMapping
+	public ResponseEntity<?> create(@RequestBody Map<String, Object> body, @ApiIgnore MerchantStore store) {
+		return save(new DiscountCode(), body, store, HttpStatus.CREATED);
+	}
+
+	@PutMapping("/{id}")
+	public ResponseEntity<?> update(@PathVariable Long id, @RequestBody Map<String, Object> body,
+			@ApiIgnore MerchantStore store) {
+		Optional<DiscountCode> d = repository.findByStoreAndId(store.getId(), id);
+		if (!d.isPresent()) {
+			return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+		}
+		return save(d.get(), body, store, HttpStatus.OK);
+	}
+
+	@DeleteMapping("/{id}")
+	public ResponseEntity<?> delete(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+		Optional<DiscountCode> d = repository.findByStoreAndId(store.getId(), id);
+		if (!d.isPresent()) {
+			return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+		}
+		repository.delete(d.get());
+		return ResponseEntity.noContent().build();
+	}
+
+	private ResponseEntity<?> save(DiscountCode d, Map<String, Object> body, MerchantStore store, HttpStatus ok) {
+		try {
+			return doSave(d, body, store, ok);
+		} catch (com.salesmanager.core.business.exception.ServiceException e) {
+			throw new com.salesmanager.shop.store.api.exception.ServiceRuntimeException(e);
+		}
+	}
+
+	private ResponseEntity<?> doSave(DiscountCode d, Map<String, Object> body, MerchantStore store, HttpStatus ok)
+			throws com.salesmanager.core.business.exception.ServiceException {
+		String code = body.get("code") == null ? null : String.valueOf(body.get("code")).trim();
+		String type = body.get("type") == null ? null : String.valueOf(body.get("type"));
+		BigDecimal value, minimum;
+		LocalDate start, end;
+		try {
+			value = decimal(body.get("value"));
+			minimum = decimal(body.get("minimumSubtotal"));
+			start = body.get("startDate") == null ? LocalDate.now() : LocalDate.parse(String.valueOf(body.get("startDate")));
+			end = body.get("endDate") == null ? null : LocalDate.parse(String.valueOf(body.get("endDate")));
+		} catch (NumberFormatException | DateTimeParseException e) {
+			return bad("invalid number or date");
+		}
+		if (StringUtils.isBlank(code) || value == null) {
+			return bad("code and value are required");
+		}
+		if ("PERCENT".equals(type)) {
+			if (value.signum() <= 0 || value.compareTo(new BigDecimal(100)) > 0) {
+				return bad("a percentage must be more than 0 and at most 100");
+			}
+		} else if ("AMOUNT".equals(type)) {
+			if (value.signum() <= 0) {
+				return bad("an amount must be more than 0");
+			}
+		} else {
+			return bad("type must be PERCENT or AMOUNT");
+		}
+		if (minimum != null && minimum.signum() < 0) {
+			return bad("minimumSubtotal cannot be negative");
+		}
+		if (end != null && end.isBefore(start)) {
+			return bad("endDate is before startDate");
+		}
+		List<String> categories = new ArrayList<>();
+		Object cats = body.get("categories");
+		if (cats instanceof List) {
+			for (Object c : (List<?>) cats) {
+				String cc = String.valueOf(c).trim();
+				if (categoryService.getByCode(store, cc) == null) {
+					return bad("unknown category " + cc);
+				}
+				categories.add(cc);
+			}
+		} else if (cats != null) {
+			return bad("categories must be a list of category codes");
+		}
+		String key = DiscountCalculator.key(code);
+		Optional<DiscountCode> same = repository.findByStoreAndKey(store.getId(), key);
+		if (same.isPresent() && !same.get().getId().equals(d.getId())) {
+			return ResponseEntity.status(HttpStatus.CONFLICT).body(Collections.singletonMap("message", "code exists"));
+		}
+		d.setMerchantStore(store);
+		d.setCode(code);
+		d.setCodeKey(key);
+		d.setType(type);
+		d.setValue(value);
+		d.setMinimumSubtotal(minimum);
+		d.setStartDate(start);
+		d.setEndDate(end);
+		d.setCategories(String.join(",", categories));
+		d.setActive(body.get("active") == null || Boolean.parseBoolean(String.valueOf(body.get("active"))));
+		return ResponseEntity.status(ok).body(readable(repository.save(d)));
+	}
+
+	private static BigDecimal decimal(Object o) {
+		return o == null ? null : new BigDecimal(String.valueOf(o));
+	}
+
+	private static ResponseEntity<?> bad(String message) {
+		return ResponseEntity.badRequest().body(Collections.singletonMap("message", message));
+	}
+
+	private static Map<String, Object> readable(DiscountCode d) {
+		Map<String, Object> m = new LinkedHashMap<>();
+		m.put("id", d.getId());
+		m.put("code", d.getCode());
+		m.put("type", d.getType());
+		m.put("value", d.getValue());
+		m.put("minimumSubtotal", d.getMinimumSubtotal());
+		m.put("startDate", d.getStartDate().toString());
+		m.put("endDate", d.getEndDate() == null ? null : d.getEndDate().toString());
+		m.put("categories", StringUtils.isBlank(d.getCategories()) ? Collections.emptyList()
+				: java.util.Arrays.asList(d.getCategories().split(",")));
+		m.put("active", d.isActive());
+		return m;
+	}
+}
