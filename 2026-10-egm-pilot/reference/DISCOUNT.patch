+package com.salesmanager.shop.store.controller.discount;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDate;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.Optional;
+
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.stereotype.Component;
+
+import com.salesmanager.core.business.repositories.catalog.discount.DiscountCodeRepository;
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.business.services.catalog.pricing.PricingService;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.catalog.discount.DiscountCode;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+/** Works out whether a discount code applies to a cart, and how much it takes off (reference implementation). */
+@Component
+public class DiscountCalculator {
+
+	public static final String TOTAL_CODE = "discount";
+
+	@Autowired
+	private DiscountCodeRepository repository;
+
+	@Autowired
+	private CategoryService categoryService;
+
+	@Autowired
+	private PricingService pricingService;
+
+	public static class Result {
+		public final DiscountCode code;
+		public final BigDecimal amount;
+
+		Result(DiscountCode code, BigDecimal amount) {
+			this.code = code;
+			this.amount = amount;
+		}
+	}
+
+	public static String key(String code) {
+		return code == null ? null : code.trim().toUpperCase(Locale.ROOT);
+	}
+
+	/** The discount for the given code on the cart, or empty if the code does not apply. */
+	public Optional<Result> discount(String promo, ShoppingCart cart, MerchantStore store) throws Exception {
+		if (StringUtils.isBlank(promo)) {
+			return Optional.empty();
+		}
+		Optional<DiscountCode> found = repository.findByStoreAndKey(store.getId(), key(promo));
+		if (!found.isPresent()) {
+			return Optional.empty();
+		}
+		DiscountCode d = found.get();
+		LocalDate today = LocalDate.now();
+		if (!d.isActive() || today.isBefore(d.getStartDate()) || (d.getEndDate() != null && today.isAfter(d.getEndDate()))) {
+			return Optional.empty();
+		}
+		List<Long> targets = new ArrayList<>();
+		if (StringUtils.isNotBlank(d.getCategories())) {
+			for (String c : d.getCategories().split(",")) {
+				Category category = categoryService.getByCode(store, c);
+				if (category != null) {
+					targets.add(category.getId());
+				}
+			}
+		}
+		BigDecimal subtotal = BigDecimal.ZERO, eligible = BigDecimal.ZERO;
+		for (ShoppingCartItem item : cart.getLineItems()) {
+			Product product = item.getProduct();
+			if (product == null || !product.isAvailable()) {
+				continue;
+			}
+			BigDecimal price = item.getItemPrice() != null ? item.getItemPrice()
+					: pricingService.calculateProductPrice(product).getFinalPrice();
+			BigDecimal line = price.multiply(new BigDecimal(item.getQuantity()));
+			subtotal = subtotal.add(line);
+			if (StringUtils.isBlank(d.getCategories()) || inAny(product, targets)) {
+				eligible = eligible.add(line);
+			}
+		}
+		if (eligible.signum() <= 0) {
+			return Optional.empty();
+		}
+		if (d.getMinimumSubtotal() != null && subtotal.compareTo(d.getMinimumSubtotal()) < 0) {
+			return Optional.empty();
+		}
+		BigDecimal amount = "PERCENT".equals(d.getType())
+				? eligible.multiply(d.getValue()).divide(new BigDecimal(100))
+				: d.getValue().min(eligible);
+		return Optional.of(new Result(d, amount.setScale(2, RoundingMode.HALF_UP)));
+	}
+
