+package com.salesmanager.core.business.services.catalog.discount;
+
+import java.time.LocalDate;
+import java.util.List;
+import java.util.Optional;
+
+import com.salesmanager.core.model.catalog.discount.Discount;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+
+public interface DiscountService {
+    List<Discount> list(MerchantStore store);
+    Optional<Discount> find(Long id, MerchantStore store);
+    Optional<Discount> findByCode(String code, MerchantStore store);
+    boolean exists(String normalizedCode, MerchantStore store, Long excludingId);
+    Discount save(Discount discount, MerchantStore store);
+    void delete(Discount discount);
+    Evaluation evaluate(ShoppingCart cart, String requestedCode, MerchantStore store, LocalDate today);
+
+    class Evaluation {
+        private final boolean applicable;
+        private final String canonicalCode;
+        private final java.math.BigDecimal eligibleSubtotal;
+        private final java.math.BigDecimal discountAmount;
+        private final String reason;
+        public Evaluation(boolean applicable, String canonicalCode, java.math.BigDecimal eligibleSubtotal,
+                java.math.BigDecimal discountAmount, String reason) {
+            this.applicable = applicable; this.canonicalCode = canonicalCode;
+            this.eligibleSubtotal = eligibleSubtotal; this.discountAmount = discountAmount; this.reason = reason;
+        }
+        public boolean isApplicable() { return applicable; }
+        public String getCanonicalCode() { return canonicalCode; }
+        public java.math.BigDecimal getEligibleSubtotal() { return eligibleSubtotal; }
+        public java.math.BigDecimal getDiscountAmount() { return discountAmount; }
+        public String getReason() { return reason; }
+    }
+}
