+
+import com.salesmanager.core.business.repositories.catalog.category.CategoryRepository;
+import com.salesmanager.core.business.services.catalog.discount.DiscountService;
+import com.salesmanager.core.business.services.catalog.discount.DiscountServiceImpl;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.catalog.discount.Discount;
+import com.salesmanager.core.model.catalog.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.model.catalog.discount.PersistableDiscount;
+import com.salesmanager.shop.store.api.exception.ConflictException;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.utils.AuthorizationUtils;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/discounts")
+public class DiscountApi {
+    private final DiscountService service;
+    private final CategoryRepository categoryRepository;
+    private final AuthorizationUtils authorizationUtils;
+    private final Clock clock;
+
+    @Inject
+    public DiscountApi(DiscountService service, CategoryRepository categoryRepository,
+            AuthorizationUtils authorizationUtils, Clock clock) {
+        this.service = service; this.categoryRepository = categoryRepository;
+        this.authorizationUtils = authorizationUtils; this.clock = clock;
+    }
+
+    @PostMapping
+    @ResponseStatus(HttpStatus.CREATED)
+    public PersistableDiscount create(@RequestBody PersistableDiscount request, @ApiIgnore MerchantStore store) {
+        authorize(store); return PersistableDiscount.from(save(request, null, store));
+    }
+
+    @GetMapping
+    public List<PersistableDiscount> list(@ApiIgnore MerchantStore store) {
+        authorize(store); return service.list(store).stream().map(PersistableDiscount::from).collect(Collectors.toList());
+    }
+
+    @PutMapping("/{id}")
+    public PersistableDiscount update(@PathVariable Long id, @RequestBody PersistableDiscount request, @ApiIgnore MerchantStore store) {
+        authorize(store); return PersistableDiscount.from(save(request, id, store));
+    }
+
+    @DeleteMapping("/{id}")
+    @ResponseStatus(HttpStatus.OK)
+    public void delete(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        authorize(store); Discount discount = service.find(id, store).orElseThrow(() -> new ResourceNotFoundException("Discount not found"));
+        service.delete(discount);
+    }
+
+    private void authorize(MerchantStore store) {
+        String user = authorizationUtils.authenticatedUser();
+        authorizationUtils.authorizeUser(user, Stream.of(Constants.GROUP_SUPERADMIN, Constants.GROUP_ADMIN, Constants.GROUP_ADMIN_RETAIL).collect(Collectors.toList()), store);
+    }
+
+    private Discount save(PersistableDiscount request, Long id, MerchantStore store) {
+        Discount target = id == null ? new Discount() : service.find(id, store).orElseThrow(() -> new ResourceNotFoundException("Discount not found"));
+        if (request.getCode() == null || request.getCode().trim().isEmpty()) bad("code is required");
+        String normalized = DiscountServiceImpl.normalize(request.getCode());
+        if (service.exists(normalized, store, id)) throw new ConflictException("Discount code already exists");
+        DiscountType type;
+        try { type = DiscountType.valueOf(request.getType()); } catch (Exception e) { throw new RestApiException("type must be PERCENT or AMOUNT"); }
+        BigDecimal value = decimal(request.getValue(), "value");
+        if (value.signum() <= 0 || (type == DiscountType.PERCENT && value.compareTo(BigDecimal.valueOf(100)) > 0)) bad("invalid discount value");
+        BigDecimal minimum = request.getMinimumSubtotal() == null || request.getMinimumSubtotal().trim().isEmpty() ? null : decimal(request.getMinimumSubtotal(), "minimumSubtotal");
+        if (minimum != null && minimum.signum() < 0) bad("minimumSubtotal must not be negative");
+        LocalDate start = date(request.getStartDate(), "startDate", true);
+        LocalDate end = date(request.getEndDate(), "endDate", false);
+        if (end != null && end.isBefore(start)) bad("endDate must not be before startDate");
+        Set<Category> categories = new LinkedHashSet<>();
+        if (request.getCategories() != null) for (String code : new LinkedHashSet<>(request.getCategories())) {
+            Category category = categoryRepository.findByCode(store.getId(), code);
+            if (category == null) bad("Unknown category: " + code);
+            categories.add(category);
+        }
+        target.setCode(request.getCode()); target.setNormalizedCode(normalized); target.setType(type); target.setValue(value);
+        target.setMinimumSubtotal(minimum); target.setStartDate(start); target.setEndDate(end); target.setActive(request.getActive() == null || request.getActive()); target.setCategories(categories);
+        try { return service.save(target, store); } catch (DataIntegrityViolationException e) { throw new ConflictException("Discount code already exists"); }
+    }
+    private BigDecimal decimal(String value, String field) { try { return new BigDecimal(value); } catch (Exception e) { throw new RestApiException(field + " must be a number"); } }
