+package com.salesmanager.core.business.services.catalog.discount;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.Clock;
+import java.time.LocalDate;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+import java.util.Optional;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.repositories.catalog.category.CategoryRepository;
+import com.salesmanager.core.business.repositories.catalog.discount.DiscountRepository;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.catalog.discount.Discount;
+import com.salesmanager.core.model.catalog.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service
+public class DiscountServiceImpl implements DiscountService {
+    private final DiscountRepository repository;
+    private final CategoryRepository categoryRepository;
+
+    @Inject
+    public DiscountServiceImpl(DiscountRepository repository, CategoryRepository categoryRepository) {
+        this.repository = repository;
+        this.categoryRepository = categoryRepository;
+    }
+
+    public static String normalize(String code) {
+        return code == null ? null : code.trim().toUpperCase(Locale.ROOT);
+    }
+
+    @Override public List<Discount> list(MerchantStore store) { return repository.findByMerchantStoreIdOrderByIdAsc(store.getId()); }
+    @Override public Optional<Discount> find(Long id, MerchantStore store) { return repository.findByIdAndMerchantStoreId(id, store.getId()); }
+    @Override public Optional<Discount> findByCode(String code, MerchantStore store) {
+        String normalized = normalize(code);
+        return normalized == null ? Optional.empty() : repository.findByNormalizedCodeAndMerchantStoreId(normalized, store.getId());
+    }
+    @Override public boolean exists(String normalizedCode, MerchantStore store, Long excludingId) {
+        return excludingId == null ? repository.existsByNormalizedCodeAndMerchantStoreId(normalizedCode, store.getId())
+                : repository.existsByNormalizedCodeAndMerchantStoreIdAndIdNot(normalizedCode, store.getId(), excludingId);
+    }
+    @Override @Transactional public Discount save(Discount discount, MerchantStore store) {
+        discount.setMerchantStore(store);
+        discount.setNormalizedCode(normalize(discount.getCode()));
+        return repository.save(discount);
+    }
+    @Override @Transactional public void delete(Discount discount) { repository.delete(discount); }
+
+    @Override @Transactional(Transactional.TxType.SUPPORTS)
+    public Evaluation evaluate(ShoppingCart cart, String requestedCode, MerchantStore store, LocalDate today) {
+        Optional<Discount> found = findByCode(requestedCode, store);
+        if (!found.isPresent()) return invalid("Unknown discount code");
+        Discount discount = found.get();
+        if (!discount.isActive()) return invalid("Discount is inactive");
+        if (today.isBefore(discount.getStartDate()) || (discount.getEndDate() != null && today.isAfter(discount.getEndDate())))
+            return invalid("Discount is outside its validity period");
+
+        BigDecimal subtotal = BigDecimal.ZERO;
+        BigDecimal eligible = BigDecimal.ZERO;
+        Set<Long> configured = discount.getCategories() == null ? Collections.emptySet()
+                : discount.getCategories().stream().map(Category::getId).collect(Collectors.toSet());
+        for (ShoppingCartItem item : cart.getLineItems()) {
+            BigDecimal line = item.getItemPrice().multiply(BigDecimal.valueOf(item.getQuantity()));
+            subtotal = subtotal.add(line);
+            boolean lineEligible = configured.isEmpty() || item.getProduct().getCategories().stream()
+                .filter(productCategory -> productCategory.getMerchantStore() != null
+                    && productCategory.getMerchantStore().getId().equals(store.getId()))
+                .anyMatch(productCategory -> configured.stream().anyMatch(id -> productCategory.getLineage() != null
+                    && productCategory.getLineage().contains("/" + id + "/")));
+            if (lineEligible) eligible = eligible.add(line);
+        }
+        if (discount.getMinimumSubtotal() != null && subtotal.compareTo(discount.getMinimumSubtotal()) < 0) return invalid("Minimum subtotal not met");
+        if (eligible.signum() <= 0) return invalid("Discount has no eligible items");
+        BigDecimal amount = discount.getType() == DiscountType.PERCENT
+                ? eligible.multiply(discount.getValue()).divide(BigDecimal.valueOf(100), 8, RoundingMode.HALF_UP)
+                : discount.getValue().min(eligible);
+        amount = amount.max(BigDecimal.ZERO).min(eligible).setScale(2, RoundingMode.HALF_UP).min(eligible.setScale(2, RoundingMode.HALF_UP));
+        return new Evaluation(true, discount.getCode(), eligible, amount, null);
+    }
+
+    private Evaluation invalid(String reason) { return new Evaluation(false, null, BigDecimal.ZERO, BigDecimal.ZERO, reason); }
+}
