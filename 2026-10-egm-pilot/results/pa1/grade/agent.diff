+package com.salesmanager.core.business.repositories.catalog.discount;
+
+import java.util.List;
+import java.util.Optional;
+
+import org.springframework.data.jpa.repository.EntityGraph;
+import org.springframework.data.jpa.repository.JpaRepository;
+
+import com.salesmanager.core.model.catalog.discount.Discount;
+
+public interface DiscountRepository extends JpaRepository<Discount, Long> {
+    @EntityGraph(attributePaths = "categories")
+    List<Discount> findByMerchantStoreIdOrderByIdAsc(Integer storeId);
+    @EntityGraph(attributePaths = "categories")
+    Optional<Discount> findByIdAndMerchantStoreId(Long id, Integer storeId);
+    @EntityGraph(attributePaths = "categories")
+    Optional<Discount> findByNormalizedCodeAndMerchantStoreId(String normalizedCode, Integer storeId);
+    boolean existsByNormalizedCodeAndMerchantStoreId(String normalizedCode, Integer storeId);
+    boolean existsByNormalizedCodeAndMerchantStoreIdAndIdNot(String normalizedCode, Integer storeId, Long id);
+}
