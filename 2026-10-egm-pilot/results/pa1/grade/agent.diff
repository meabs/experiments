+package com.salesmanager.shop.model.catalog.discount;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.List;
+
+public class PersistableDiscount {
+    private Long id;
+    private String code;
+    private String type;
+    private String value;
+    private String minimumSubtotal;
+    private String startDate;
+    private String endDate;
+    private List<String> categories = new ArrayList<>();
+    private Boolean active = true;
+
+    public Long getId() { return id; }
+    public void setId(Long id) { this.id = id; }
+    public String getCode() { return code; }
+    public void setCode(String code) { this.code = code; }
+    public String getType() { return type; }
+    public void setType(String type) { this.type = type; }
+    public String getValue() { return value; }
+    public void setValue(String value) { this.value = value; }
+    public String getMinimumSubtotal() { return minimumSubtotal; }
+    public void setMinimumSubtotal(String minimumSubtotal) { this.minimumSubtotal = minimumSubtotal; }
+    public String getStartDate() { return startDate; }
+    public void setStartDate(String startDate) { this.startDate = startDate; }
+    public String getEndDate() { return endDate; }
+    public void setEndDate(String endDate) { this.endDate = endDate; }
+    public List<String> getCategories() { return categories; }
+    public void setCategories(List<String> categories) { this.categories = categories; }
+    public Boolean getActive() { return active; }
+    public void setActive(Boolean active) { this.active = active; }
+
+    public static PersistableDiscount from(com.salesmanager.core.model.catalog.discount.Discount source) {
+        PersistableDiscount target = new PersistableDiscount();
+        target.id = source.getId(); target.code = source.getCode();
+        target.type = source.getType() == null ? null : source.getType().name();
+        target.value = source.getValue() == null ? null : source.getValue().stripTrailingZeros().toPlainString();
+        target.minimumSubtotal = source.getMinimumSubtotal() == null ? null : source.getMinimumSubtotal().stripTrailingZeros().toPlainString();
+        target.startDate = source.getStartDate() == null ? null : source.getStartDate().toString();
+        target.endDate = source.getEndDate() == null ? null : source.getEndDate().toString();
+        if (source.getCategories() != null) source.getCategories().forEach(c -> target.categories.add(c.getCode()));
+        target.active = source.isActive();
+        return target;
+    }
+}
