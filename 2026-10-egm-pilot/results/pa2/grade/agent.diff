+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.discount.DiscountCode;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service("discountCodeService")
+public class DiscountCodeServiceImpl implements DiscountCodeService {
+    private final DiscountCodeRepository repository;
+    private final CategoryRepository categoryRepository;
+	@Inject private Clock clock;
+
+    @Inject
+    public DiscountCodeServiceImpl(DiscountCodeRepository repository, CategoryRepository categoryRepository) {
+        this.repository = repository;
+        this.categoryRepository = categoryRepository;
+    }
+
+    @Override public String normalize(String code) { return code == null ? null : code.toLowerCase(Locale.ROOT); }
+
+    @Override public DiscountCode create(DiscountCode discount, MerchantStore store) throws ServiceException {
+        return persist(discount, store, false);
+    }
+    @Override public DiscountCode update(DiscountCode discount, MerchantStore store) throws ServiceException {
+        if (discount.getId() == null || repository.findByIdAndMerchantStoreId(discount.getId(), store.getId()).isEmpty()) return null;
+        return persist(discount, store, true);
+    }
+    private DiscountCode persist(DiscountCode discount, MerchantStore store, boolean replacing) throws ServiceException {
+		if (discount.getStartDate() == null) discount.setStartDate(LocalDate.now(clock == null ? Clock.systemDefaultZone() : clock));
+        validate(discount, store);
+        String normalized = normalize(discount.getCode());
+        discount.setMerchantStore(store);
+        discount.setNormalizedCode(normalized);
+        if (repository.findByMerchantStoreIdAndNormalizedCode(store.getId(), normalized)
+                .filter(existing -> !existing.getId().equals(discount.getId())).isPresent()) {
+            throw new ServiceException("DUPLICATE_DISCOUNT");
+        }
+        try { return repository.saveAndFlush(discount); }
+        catch (DataIntegrityViolationException e) { throw new ServiceException("DUPLICATE_DISCOUNT", e); }
+    }
+    private void validate(DiscountCode d, MerchantStore store) throws ServiceException {
+        if (d == null || StringUtils.isBlank(d.getCode()) || d.getType() == null || d.getValue() == null || d.getValue().signum() <= 0 || d.getStartDate() == null)
+            throw new ServiceException("Invalid discount fields");
+        if (d.getType() == DiscountType.PERCENT && d.getValue().compareTo(BigDecimal.valueOf(100)) > 0) throw new ServiceException("Invalid percentage");
+        if (d.getEndDate() != null && d.getEndDate().isBefore(d.getStartDate())) throw new ServiceException("Invalid discount dates");
+        Set<Category> resolved = new HashSet<>();
+        Set<Category> discountCategories = d.getCategories() == null ? new HashSet<Category>() : d.getCategories();
+        for (Category category : discountCategories) {
+            Category owned = categoryRepository.findByCode(store.getId(), category.getCode());
+            if (owned == null) throw new ServiceException("Unknown discount category");
+            resolved.add(owned);
+        }
+        d.setCategories(resolved);
+    }
+    @Override public List<DiscountCode> list(MerchantStore store) { return repository.findByMerchantStoreId(store.getId()); }
+    @Override public DiscountCode get(Long id, MerchantStore store) { return repository.findByIdAndMerchantStoreId(id, store.getId()).orElse(null); }
+    @Override public void delete(Long id, MerchantStore store) throws ServiceException {
+        DiscountCode d = get(id, store); if (d == null) throw new ServiceException("Discount not found"); repository.delete(d);
+    }
+
+    @Override public DiscountResult evaluate(ShoppingCart cart, MerchantStore store, LocalDate today, String enteredCode) throws InvalidDiscountException {
+        if (cart == null || store == null || StringUtils.isBlank(enteredCode)) throw new InvalidDiscountException("Discount does not apply");
+        DiscountCode d = repository.findForEvaluation(store.getId(), normalize(enteredCode)).orElse(null);
+        if (d == null || !store.equals(cart.getMerchantStore()) || !d.isActive() || today.isBefore(d.getStartDate()) || (d.getEndDate() != null && today.isAfter(d.getEndDate()))) throw new InvalidDiscountException("Discount does not apply");
+        BigDecimal subtotal = BigDecimal.ZERO;
+        BigDecimal eligible = BigDecimal.ZERO;
+        Set<Long> selected = new HashSet<>();
+        Set<Category> discountCategories = d.getCategories() == null ? new HashSet<Category>() : d.getCategories();
+        for (Category c : discountCategories) selected.add(c.getId());
+        for (ShoppingCartItem item : cart.getLineItems()) {
+            BigDecimal line = item.getItemPrice() != null ? item.getItemPrice().multiply(BigDecimal.valueOf(item.getQuantity())) : (item.getSubTotal() == null ? BigDecimal.ZERO : item.getSubTotal());
+            subtotal = subtotal.add(line);
+            Product p = item.getProduct();
+            boolean applies = selected.isEmpty();
+            if (!applies && p != null) for (Category c : p.getCategories()) if (selected.contains(c.getId()) || isDescendant(c, selected)) { applies = true; break; }
+            if (applies) eligible = eligible.add(line);
+        }
+        if (d.getMinimumSubtotal() != null && subtotal.compareTo(d.getMinimumSubtotal()) < 0 || eligible.signum() <= 0) throw new InvalidDiscountException("Discount does not apply");
+        BigDecimal amount = d.getType() == DiscountType.PERCENT ? eligible.multiply(d.getValue()).divide(BigDecimal.valueOf(100), 2, RoundingMode.HALF_UP) : d.getValue().min(eligible);
+        amount = amount.max(BigDecimal.ZERO).min(eligible).setScale(2, RoundingMode.HALF_UP);
+        return new DiscountResult(d, eligible, amount);
+    }
+    private boolean isDescendant(Category category, Set<Long> selected) {
+        String lineage = category.getLineage();
+        if (lineage == null) return false;
+        for (Long id : selected) if (lineage.contains("/" + id + "/")) return true;
+        return false;
+    }
+}
