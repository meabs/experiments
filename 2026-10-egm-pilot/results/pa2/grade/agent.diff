+import com.salesmanager.shop.store.model.discount.ReadableDiscountCode;
+import com.salesmanager.shop.utils.ServiceRequestCriteriaBuilderUtils;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class DiscountApi {
+    private static final DateTimeFormatter DATE = DateTimeFormatter.ofPattern("uuuu-MM-dd").withResolverStyle(ResolverStyle.STRICT);
+    @Inject private DiscountCodeService service;
+    @Inject private UserFacade userFacade;
+    @Inject private Clock clock;
+
+    private void authorize() {
+        String user = userFacade.authenticatedUser();
+        if (user == null) throw new ServiceRuntimeException("401", "Authentication required");
+        userFacade.authorizedGroup(user, java.util.Arrays.asList(Constants.GROUP_SUPERADMIN, Constants.GROUP_ADMIN, Constants.GROUP_ADMIN_RETAIL, "ADMIN_RETAILER"));
+    }
+    @PostMapping("/private/discounts") @ResponseStatus(HttpStatus.CREATED)
+    public ReadableDiscountCode create(@RequestBody PersistableDiscountCode request, @ApiIgnore MerchantStore store) { authorize(); return save(request, store, null); }
+    @GetMapping("/private/discounts")
+    public List<ReadableDiscountCode> list(@ApiIgnore MerchantStore store) { authorize(); return service.list(store).stream().map(this::read).collect(Collectors.toList()); }
+    @PutMapping("/private/discounts/{id}")
+    public ReadableDiscountCode update(@PathVariable Long id, @RequestBody PersistableDiscountCode request, @ApiIgnore MerchantStore store) { authorize(); return save(request, store, id); }
+    @DeleteMapping("/private/discounts/{id}")
+    public void delete(@PathVariable Long id, @ApiIgnore MerchantStore store) { authorize(); try { service.delete(id, store); } catch (ServiceException e) { throw new ResourceNotFoundException(e.getMessage()); } }
+    private ReadableDiscountCode save(PersistableDiscountCode request, MerchantStore store, Long id) {
+        try {
+            DiscountCode d = new DiscountCode(); d.setId(id); d.setCode(request.getCode()); d.setValue(request.getValue()); d.setMinimumSubtotal(request.getMinimumSubtotal());
+            d.setType(request.getType() == null ? null : DiscountType.valueOf(request.getType()));
+            d.setStartDate(request.getStartDate() == null ? LocalDate.now(clock) : LocalDate.parse(request.getStartDate(), DATE));
+            d.setEndDate(request.getEndDate() == null ? null : LocalDate.parse(request.getEndDate(), DATE)); d.setActive(request.getActive() == null ? true : request.getActive());
+            if (request.getCategories() != null) for (String code : request.getCategories()) { Category c = new Category(); c.setCode(code); d.getCategories().add(c); }
+            DiscountCode saved = id == null ? service.create(d, store) : service.update(d, store);
+            if (saved == null) throw new ResourceNotFoundException("Discount not found"); return read(saved);
+        } catch (IllegalArgumentException | DateTimeParseException e) { throw new ServiceRuntimeException("400", "Invalid discount request"); }
+        catch (ServiceException e) { if ("DUPLICATE_DISCOUNT".equals(e.getMessage())) throw new ConflictException("Discount code already exists"); throw new ServiceRuntimeException("400", e.getMessage()); }
+    }
+    private ReadableDiscountCode read(DiscountCode d) { ReadableDiscountCode r = new ReadableDiscountCode(); r.setId(d.getId()); r.setCode(d.getCode()); r.setType(d.getType().name()); r.setValue(d.getValue()); r.setMinimumSubtotal(d.getMinimumSubtotal()); r.setStartDate(d.getStartDate().format(DATE)); r.setEndDate(d.getEndDate() == null ? null : d.getEndDate().format(DATE)); r.setActive(d.isActive()); r.setCategories(d.getCategories().stream().map(Category::getCode).collect(Collectors.toList())); return r; }
+}
