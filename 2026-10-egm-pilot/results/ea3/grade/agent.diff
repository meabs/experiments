+package com.salesmanager.shop.store.controller.discount.facade;
+
+import java.util.List;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.services.discount.DiscountService;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.mapper.discount.PersistableDiscountMapper;
+import com.salesmanager.shop.model.discount.PersistableDiscount;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+
+@Service("discountFacade")
+public class DiscountFacadeImpl implements DiscountFacade {
+    @Inject private DiscountService discountService;
+    @Inject private PersistableDiscountMapper mapper;
+
+    @Override public PersistableDiscount create(PersistableDiscount discount, MerchantStore store) { return mapper.toDto(discountService.create(mapper.toEntity(discount, store), store)); }
+    @Override public List<PersistableDiscount> list(MerchantStore store) { return discountService.list(store).stream().map(mapper::toDto).collect(Collectors.toList()); }
+    @Override public PersistableDiscount update(Long id, PersistableDiscount discount, MerchantStore store) {
+        Discount updated = discountService.update(id, mapper.toEntity(discount, store), store);
+        if (updated == null) throw new ResourceNotFoundException("Discount not found");
+        return mapper.toDto(updated);
+    }
+    @Override public void delete(Long id, MerchantStore store) {
+        if (discountService.list(store).stream().noneMatch(d -> id.equals(d.getId()))) throw new ResourceNotFoundException("Discount not found");
+        discountService.delete(id, store);
+    }
+}
