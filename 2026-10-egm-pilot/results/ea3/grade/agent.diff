+package com.salesmanager.core.business.services.discount;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.Clock;
+import java.time.LocalDate;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Optional;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.dao.DataIntegrityViolationException;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.salesmanager.core.business.exception.DiscountConflictException;
+import com.salesmanager.core.business.exception.InvalidDiscountException;
+import com.salesmanager.core.business.repositories.discount.DiscountRepository;
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service("discountService")
+public class DiscountServiceImpl implements DiscountService {
+    private final DiscountRepository repository;
+    private final CategoryService categoryService;
+    private final Clock clock;
+
+    @Inject
+    public DiscountServiceImpl(DiscountRepository repository, CategoryService categoryService, Clock clock) {
+        this.repository = repository;
+        this.categoryService = categoryService;
+        this.clock = clock;
+    }
+
+    @Override
+    @Transactional
+    public Discount create(Discount discount, MerchantStore store) {
+        return save(prepare(discount, store), store, null);
+    }
+
+    @Override
+    @Transactional(readOnly = true)
+    public List<Discount> list(MerchantStore store) { return repository.findByMerchantStore(store); }
+
+    @Override
+    @Transactional
+    public Discount update(Long id, Discount discount, MerchantStore store) {
+        Discount existing = repository.findByIdAndMerchantStore(id, store).orElse(null);
+        if (existing == null) return null;
+        Discount replacement = prepare(discount, store);
+        replacement.setId(existing.getId());
+        replacement.setMerchantStore(store);
+        return save(replacement, store, id);
+    }
+
+    @Override
+    @Transactional
+    public void delete(Long id, MerchantStore store) {
+        repository.findByIdAndMerchantStore(id, store).ifPresent(repository::delete);
+    }
+
+    private Discount save(Discount discount, MerchantStore store, Long id) {
+        String normalized = discount.getNormalizedCode();
+        boolean duplicate = id == null
+                ? repository.findByMerchantStoreAndNormalizedCode(store, normalized).isPresent()
+                : repository.existsByMerchantStoreAndNormalizedCodeAndIdNot(store, normalized, id);
+        if (duplicate) throw new DiscountConflictException("Discount code already exists");
+        try {
+            return repository.saveAndFlush(discount);
+        } catch (DataIntegrityViolationException e) {
+            throw new DiscountConflictException("Discount code already exists");
+        }
+    }
+
+    private Discount prepare(Discount discount, MerchantStore store) {
+        if (discount == null) throw new InvalidDiscountException("Discount is required");
+        String code = StringUtils.trimToEmpty(discount.getCode());
+        if (code.isEmpty() || code.length() > 100) throw new InvalidDiscountException("Code must be between 1 and 100 characters");
+        if (discount.getType() == null) throw new InvalidDiscountException("Type is required");
+        if (discount.getValue() == null || discount.getValue().compareTo(BigDecimal.ZERO) <= 0)
+            throw new InvalidDiscountException("Value must be positive");
+        if (discount.getType() == DiscountType.PERCENT && discount.getValue().compareTo(new BigDecimal("100")) > 0)
+            throw new InvalidDiscountException("Percentage cannot exceed 100");
+        if (discount.getMinimumSubtotal() != null && discount.getMinimumSubtotal().compareTo(BigDecimal.ZERO) < 0)
+            throw new InvalidDiscountException("Minimum subtotal cannot be negative");
+        LocalDate start = discount.getStartDate() == null ? LocalDate.now(clock) : discount.getStartDate();
+        if (discount.getEndDate() != null && discount.getEndDate().isBefore(start))
+            throw new InvalidDiscountException("End date cannot precede start date");
+        Set<Category> categories = new HashSet<>();
+        if (discount.getCategories() != null) {
+            for (Category category : discount.getCategories()) {
+                Category resolved;
+                try { resolved = categoryService.getByCode(store, category.getCode()); }
+                catch (Exception e) { throw new InvalidDiscountException("Unknown category"); }
+                if (resolved == null) throw new InvalidDiscountException("Unknown category");
+                categories.add(resolved);
+            }
+        }
+        discount.setMerchantStore(store);
+        discount.setCode(code);
+        discount.setNormalizedCode(code.toLowerCase(Locale.ROOT));
+        discount.setValue(discount.getValue().setScale(2, RoundingMode.HALF_UP));
+        if (discount.getMinimumSubtotal() != null) discount.setMinimumSubtotal(discount.getMinimumSubtotal().setScale(2, RoundingMode.HALF_UP));
+        discount.setStartDate(start);
+        discount.setCategories(categories);
+        return discount;
+    }
+
+    @Override
+    @Transactional(readOnly = true)
+    public Optional<DiscountEvaluation> evaluate(MerchantStore store, String code, List<ShoppingCartItem> availableItems, BigDecimal subtotal) {
+        if (store == null || StringUtils.isBlank(code) || subtotal == null) return Optional.empty();
+        String normalized = code.trim().toLowerCase(Locale.ROOT);
+        Discount discount = repository.findByMerchantStoreAndNormalizedCode(store, normalized).orElse(null);
+        if (discount == null || !discount.isActive()) return Optional.empty();
+        LocalDate today = LocalDate.now(clock);
+        if (discount.getStartDate() == null || today.isBefore(discount.getStartDate()) ||
+                (discount.getEndDate() != null && today.isAfter(discount.getEndDate()))) return Optional.empty();
+        if (discount.getMinimumSubtotal() != null && subtotal.compareTo(discount.getMinimumSubtotal()) < 0) return Optional.empty();
+        Set<Long> categoryIds = discount.getCategories() == null ? Collections.emptySet() : discount.getCategories().stream().map(Category::getId).collect(Collectors.toSet());
+        BigDecimal eligibleSubtotal = BigDecimal.ZERO;
+        for (ShoppingCartItem item : availableItems == null ? Collections.<ShoppingCartItem>emptyList() : availableItems) {
+            Product product = item.getProduct();
+            if (product == null || product.getMerchantStore() == null || !store.getId().equals(product.getMerchantStore().getId())) continue;
+            boolean eligible = categoryIds.isEmpty();
+            if (!eligible && product.getCategories() != null) {
+                for (Category category : product.getCategories()) {
+                    if (category.getMerchantStore() != null && store.getId().equals(category.getMerchantStore().getId()) && categoryIds.contains(category.getId())) { eligible = true; break; }
+                    String lineage = category.getLineage();
+                    if (category.getMerchantStore() != null && store.getId().equals(category.getMerchantStore().getId()) && lineage != null) {
+                        for (String token : lineage.split("/")) {
+                            if (!token.isEmpty()) {
+                                try {
+                                    if (categoryIds.contains(Long.valueOf(token))) { eligible = true; break; }
+                                } catch (NumberFormatException ignored) {
+                                    // A malformed lineage token cannot match a category id.
+                                }
+                            }
+                        }
+                    }
+                    if (eligible) break;
+                }
+            }
+            if (eligible) eligibleSubtotal = eligibleSubtotal.add(item.getItemPrice().multiply(BigDecimal.valueOf(item.getQuantity())));
+        }
+        if (eligibleSubtotal.compareTo(BigDecimal.ZERO) <= 0) return Optional.empty();
+        BigDecimal amount = discount.getType() == DiscountType.PERCENT
+                ? eligibleSubtotal.multiply(discount.getValue()).divide(new BigDecimal("100"), 8, RoundingMode.HALF_UP)
+                : discount.getValue().min(eligibleSubtotal);
+        amount = amount.setScale(2, RoundingMode.HALF_UP);
+        return amount.signum() > 0 ? Optional.of(new DiscountEvaluation(amount, discount.getCode())) : Optional.empty();
+    }
+}
