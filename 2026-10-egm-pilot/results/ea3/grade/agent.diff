+package com.salesmanager.shop.mapper.discount;
+
+import java.util.ArrayList;
+import java.util.stream.Collectors;
+
+import org.springframework.stereotype.Component;
+
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.discount.PersistableDiscount;
+
+@Component
+public class PersistableDiscountMapper {
+    public Discount toEntity(PersistableDiscount source, MerchantStore store) {
+        Discount target = new Discount();
+        target.setId(source.getId());
+        target.setMerchantStore(store);
+        target.setCode(source.getCode());
+        target.setType(source.getType());
+        target.setValue(source.getValue());
+        target.setMinimumSubtotal(source.getMinimumSubtotal());
+        target.setStartDate(source.getStartDate());
+        target.setEndDate(source.getEndDate());
+        target.setActive(source.getActive() == null || source.getActive());
+        target.setCategories(new java.util.HashSet<>());
+        if (source.getCategories() != null) {
+            target.setCategories(source.getCategories().stream().map(code -> { Category c = new Category(); c.setCode(code); return c; }).collect(Collectors.toSet()));
+        }
+        return target;
+    }
+    public PersistableDiscount toDto(Discount source) {
+        PersistableDiscount target = new PersistableDiscount();
+        target.setId(source.getId()); target.setCode(source.getCode()); target.setType(source.getType());
+        target.setValue(source.getValue()); target.setMinimumSubtotal(source.getMinimumSubtotal()); target.setStartDate(source.getStartDate()); target.setEndDate(source.getEndDate()); target.setActive(source.isActive());
+        target.setCategories(source.getCategories() == null ? new ArrayList<>() : source.getCategories().stream().map(Category::getCode).collect(Collectors.toList()));
+        return target;
+    }
+}
