+package com.salesmanager.shop.store.api.v1.discount;
+
+import java.util.List;
+import javax.servlet.http.HttpServletResponse;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.discount.PersistableDiscount;
+import com.salesmanager.shop.model.discount.ReadableDiscount;
+import com.salesmanager.shop.store.controller.discount.facade.DiscountFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/discounts")
+public class DiscountApi {
+    private final DiscountFacade facade;
+    public DiscountApi(DiscountFacade facade) { this.facade = facade; }
+    @PostMapping
+    @ResponseStatus(HttpStatus.CREATED)
+    public ReadableDiscount create(@ApiIgnore MerchantStore store, @RequestBody PersistableDiscount discount) { return facade.create(discount, store); }
+    @GetMapping
+    public List<ReadableDiscount> list(@ApiIgnore MerchantStore store) { return facade.list(store); }
+    @PutMapping("/{id}")
+    public ReadableDiscount update(@PathVariable Long id, @ApiIgnore MerchantStore store, @RequestBody PersistableDiscount discount) { return facade.update(id, discount, store); }
+    @DeleteMapping("/{id}")
+    public void delete(@PathVariable Long id, @ApiIgnore MerchantStore store, HttpServletResponse response) { facade.delete(id, store); response.setStatus(HttpStatus.OK.value()); }
+}
