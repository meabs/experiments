@@ -0,0 +1,61 @@
+package com.salesmanager.shop.store.facade.discount;
+
+import java.time.LocalDate;
+import java.time.format.DateTimeFormatter;
+import java.time.format.DateTimeParseException;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.exception.DiscountConflictException;
+import com.salesmanager.core.business.exception.DiscountNotFoundException;
+import com.salesmanager.core.business.exception.DiscountValidationException;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.discount.DiscountService;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.discount.PersistableDiscount;
+import com.salesmanager.shop.model.discount.ReadableDiscount;
+import com.salesmanager.shop.store.api.exception.ConflictException;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.controller.discount.facade.DiscountFacade;
+
+@Service
+public class DiscountFacadeImpl implements DiscountFacade {
+    private static final DateTimeFormatter DATE = DateTimeFormatter.ISO_LOCAL_DATE;
+    private final DiscountService service;
+    @Inject public DiscountFacadeImpl(DiscountService service) { this.service = service; }
+
+    @Override public ReadableDiscount create(PersistableDiscount input, MerchantStore store) { return readable(save(input, store, null), store); }
+    @Override public ReadableDiscount update(Long id, PersistableDiscount input, MerchantStore store) { return readable(save(input, store, id), store); }
+    @Override public List<ReadableDiscount> list(MerchantStore store) { try { return service.list(store).stream().map(d -> readable(d, store)).collect(Collectors.toList()); } catch (Exception e) { throw translate(e); } }
+    @Override public void delete(Long id, MerchantStore store) { try { service.delete(id, store); } catch (Exception e) { throw translate(e); } }
+
+    private Discount save(PersistableDiscount input, MerchantStore store, Long id) {
+        try {
+            Discount d = new Discount(); d.setId(id); d.setCode(input.getCode()); d.setValue(input.getValue());
+            try { d.setType(input.getType() == null ? null : DiscountType.valueOf(input.getType())); } catch (IllegalArgumentException e) { throw new DiscountValidationException("Unknown discount type"); }
+            d.setMinimumSubtotal(input.getMinimumSubtotal()); d.setStartDate(parse(input.getStartDate())); d.setEndDate(parse(input.getEndDate())); d.setActive(input.getActive() == null || input.getActive());
+            d.setCategories(input.getCategories() == null ? Collections.emptySet() : input.getCategories().stream().collect(Collectors.toSet()));
+            return id == null ? service.create(d, store) : service.update(id, d, store);
+        } catch (Exception e) { throw translate(e); }
+    }
+    private LocalDate parse(String value) throws DiscountValidationException { if (value == null || value.trim().isEmpty()) return null; try { return LocalDate.parse(value, DATE); } catch (DateTimeParseException e) { throw new DiscountValidationException("Malformed date"); } }
+    private ReadableDiscount readable(Discount d, MerchantStore store) {
+        ReadableDiscount r = new ReadableDiscount(); r.setId(d.getId()); r.setCode(d.getCode()); r.setType(d.getType().name()); r.setValue(d.getValue()); r.setMinimumSubtotal(d.getMinimumSubtotal()); r.setStartDate(d.getStartDate().toString()); r.setEndDate(d.getEndDate() == null ? null : d.getEndDate().toString()); r.setActive(d.isActive()); r.setCategories(d.getCategories().stream().collect(Collectors.toList())); return r;
+    }
+    private RuntimeException translate(Exception e) {
+        if (e instanceof ConflictException || e instanceof ResourceNotFoundException || e instanceof ServiceRuntimeException) return (RuntimeException)e;
+        if (e instanceof DiscountConflictException) return new ConflictException(e.getMessage());
+        if (e instanceof DiscountNotFoundException) return new ResourceNotFoundException(e.getMessage());
+        if (e instanceof DiscountValidationException) return new ServiceRuntimeException("400", e.getMessage());
+        return new ServiceRuntimeException(e);
+    }
+}
