+package com.salesmanager.core.business.services.discount;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDate;
+import java.util.Collections;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Optional;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+
+import org.springframework.dao.DataIntegrityViolationException;
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.constants.Constants;
+import com.salesmanager.core.business.exception.DiscountConflictException;
+import com.salesmanager.core.business.exception.DiscountNotFoundException;
+import com.salesmanager.core.business.exception.DiscountValidationException;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.discount.DiscountRepository;
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.OrderSummary;
+import com.salesmanager.core.model.order.OrderTotal;
+import com.salesmanager.core.model.order.OrderTotalType;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service("discountService")
+public class DiscountServiceImpl extends SalesManagerEntityServiceImpl<Long, Discount> implements DiscountService {
+    private final DiscountRepository repository;
+    private final CategoryService categoryService;
+    private final ProductService productService;
+
+    @Inject
+    public DiscountServiceImpl(DiscountRepository repository, CategoryService categoryService, ProductService productService) {
+        super(repository);
+        this.repository = repository;
+        this.categoryService = categoryService;
+        this.productService = productService;
+    }
+
+    @Override public Discount create(Discount discount, MerchantStore store) throws ServiceException {
+        prepare(discount, store, false);
+        try { return repository.saveAndFlush(discount); }
+        catch (DataIntegrityViolationException e) { throw new DiscountConflictException("Discount code already exists", e); }
+    }
+
+    @Override public Discount update(Long id, Discount input, MerchantStore store) throws ServiceException {
+        Discount current = repository.findByIdAndMerchantStoreId(id, store.getId()).orElseThrow(() -> new DiscountNotFoundException("Discount not found"));
+        prepare(input, store, true);
+        current.setCode(input.getCode()); current.setCodeNormalized(input.getCodeNormalized()); current.setType(input.getType());
+        current.setValue(input.getValue()); current.setMinimumSubtotal(input.getMinimumSubtotal()); current.setStartDate(input.getStartDate());
+        current.setEndDate(input.getEndDate()); current.setActive(input.isActive()); current.setCategories(input.getCategories());
+        try { return repository.saveAndFlush(current); }
+        catch (DataIntegrityViolationException e) { throw new DiscountConflictException("Discount code already exists", e); }
+    }
+
+    @Override public void delete(Long id, MerchantStore store) throws ServiceException {
+        Discount current = repository.findByIdAndMerchantStoreId(id, store.getId()).orElseThrow(() -> new DiscountNotFoundException("Discount not found"));
+        repository.delete(current); repository.flush();
+    }
+
+    @Override public List<Discount> list(MerchantStore store) { return repository.findByMerchantStoreId(store.getId()); }
+    @Override public Optional<Discount> findByCode(String code, MerchantStore store) {
+        if (code == null) return Optional.empty();
+        return repository.findByMerchantStoreIdAndCodeNormalized(store.getId(), normalize(code));
+    }
+
+    private void prepare(Discount d, MerchantStore store, boolean update) throws ServiceException {
+        if (d == null || d.getCode() == null || d.getCode().trim().isEmpty()) throw new DiscountValidationException("Code is required");
+        if (d.getType() == null || d.getValue() == null) throw new DiscountValidationException("Type and value are required");
+        if (d.getValue().scale() > 2 || (d.getMinimumSubtotal() != null && d.getMinimumSubtotal().scale() > 2)) throw new DiscountValidationException("Money values may have at most two decimals");
+        if (d.getValue().signum() <= 0 || (d.getType() == DiscountType.PERCENT && d.getValue().compareTo(BigDecimal.valueOf(100)) > 0)) throw new DiscountValidationException("Invalid discount value");
+        if (d.getMinimumSubtotal() != null && d.getMinimumSubtotal().signum() < 0) throw new DiscountValidationException("Invalid minimum subtotal");
+        if (d.getStartDate() == null) d.setStartDate(LocalDate.now());
+        if (d.getEndDate() != null && d.getEndDate().isBefore(d.getStartDate())) throw new DiscountValidationException("End date precedes start date");
+        d.setCode(d.getCode().trim()); d.setCodeNormalized(normalize(d.getCode())); d.setMerchantStore(store);
+        d.setCategories(d.getCategories());
+        for (String categoryCode : d.getCategories()) {
+            try { if (categoryCode == null || categoryService.getByCode(store, categoryCode) == null) throw new DiscountValidationException("Unknown category"); }
+            catch (ServiceException e) { if (e instanceof DiscountValidationException) throw e; throw new DiscountValidationException("Unknown category"); }
+        }
+        Optional<Discount> duplicate = findByCode(d.getCode(), store);
+        if (duplicate.isPresent() && (!update || !duplicate.get().getId().equals(d.getId()))) throw new DiscountConflictException("Discount code already exists");
+        d.setActive(d.isActive());
+    }
+
+    private String normalize(String code) { return code.trim().toUpperCase(Locale.ROOT); }
+
+    @Override @Transactional
+    public Optional<Discount> findApplicable(String code, OrderSummary summary, MerchantStore store) throws ServiceException {
+        Optional<Discount> found = findByCode(code, store);
+        if (!found.isPresent() || !applies(found.get(), summary, store, null)) return Optional.empty();
+        return found;
+    }
+
+    @Override @Transactional
+    public Optional<OrderTotal> calculateDiscount(OrderSummary summary, MerchantStore store, Language language) throws ServiceException {
+        if (summary == null || summary.getPromoCode() == null) return Optional.empty();
+        Optional<Discount> found = findByCode(summary.getPromoCode(), store);
+        if (!found.isPresent() || !applies(found.get(), summary, store, language)) return Optional.empty();
+        Discount d = found.get(); BigDecimal eligible = eligibleSubtotal(d, summary, store, language);
+        BigDecimal value = d.getType() == DiscountType.PERCENT ? eligible.multiply(d.getValue()).divide(BigDecimal.valueOf(100)) : d.getValue().min(eligible);
+        value = value.setScale(2, RoundingMode.HALF_UP);
+        OrderTotal total = new OrderTotal(); total.setOrderTotalCode(Constants.OT_DISCOUNT_TITLE); total.setModule("discount"); total.setTitle("discount"); total.setText(d.getCode()); total.setOrderTotalType(OrderTotalType.SUBTOTAL); total.setValue(value);
+        return Optional.of(total);
+    }
+
+    private boolean applies(Discount d, OrderSummary summary, MerchantStore store, Language language) throws ServiceException {
+        LocalDate today = LocalDate.now();
+        if (!d.isActive() || today.isBefore(d.getStartDate()) || (d.getEndDate() != null && today.isAfter(d.getEndDate()))) return false;
+        BigDecimal subtotal = eligibleSubtotal(null, summary, store, language);
+        if (d.getMinimumSubtotal() != null && subtotal.compareTo(d.getMinimumSubtotal()) < 0) return false;
+        return eligibleSubtotal(d, summary, store, language).signum() > 0;
+    }
+
+    private BigDecimal eligibleSubtotal(Discount d, OrderSummary summary, MerchantStore store, Language language) throws ServiceException {
+        if (summary == null || summary.getProducts() == null) return BigDecimal.ZERO;
+        BigDecimal total = BigDecimal.ZERO;
+        for (ShoppingCartItem item : summary.getProducts()) {
+            Product product = item.getProduct();
+            if (product == null) product = productService.getBySku(item.getSku(), store, language);
+            if (d == null || matches(d, product, store)) total = total.add(item.getItemPrice().multiply(BigDecimal.valueOf(item.getQuantity())));
+        }
+        return total;
+    }
+
+    private boolean matches(Discount d, Product product, MerchantStore store) throws ServiceException {
+        if (d.getCategories().isEmpty()) return true;
+        if (product == null || product.getCategories() == null) return false;
+        for (Category productCategory : product.getCategories()) for (String code : d.getCategories()) {
+            Category configured = categoryService.getByCode(store, code);
+            if (configured != null && (productCategory.getId().equals(configured.getId()) || (productCategory.getLineage() != null && productCategory.getLineage().contains("/" + configured.getId() + "/")))) return true;
+        }
+        return false;
+    }
+}
