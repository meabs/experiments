+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.order.discount.DiscountCodeService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.discount.DiscountCode;
+import com.salesmanager.core.model.order.discount.DiscountType;
+import com.salesmanager.shop.model.discount.DiscountRequest;
+import com.salesmanager.shop.model.discount.DiscountResponse;
+import com.salesmanager.shop.store.api.exception.DiscountBadRequestException;
+import com.salesmanager.shop.store.api.exception.DiscountConflictException;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.UnauthorizedException;
+import com.salesmanager.shop.store.controller.user.facade.UserFacade;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/discounts")
+public class DiscountApi {
+    @Inject private DiscountCodeService discountCodeService;
+    @Inject private UserFacade userFacade;
+    @Inject private Clock discountClock;
+
+    private void authorize() {
+        String user = userFacade.authenticatedUser();
+        if (user == null) throw new UnauthorizedException();
+        userFacade.authorizedGroup(user, java.util.Arrays.asList("SUPERADMIN", "ADMIN", "ADMIN_RETAILER"));
+    }
+    private DiscountCode from(DiscountRequest request, MerchantStore store) {
+        if (request == null) throw new DiscountBadRequestException("Request is required");
+        DiscountCode d = new DiscountCode(); d.setMerchantStore(store); d.setCode(request.getCode());
+        try { d.setType(request.getType() == null ? null : DiscountType.valueOf(request.getType())); }
+        catch (IllegalArgumentException e) { throw new DiscountBadRequestException("Unknown discount type"); }
+        d.setValue(request.getValue()); d.setMinimumSubtotal(request.getMinimumSubtotal());
+        d.setStartDate(request.getStartDate() == null ? LocalDate.now(discountClock) : request.getStartDate());
+        d.setEndDate(request.getEndDate()); d.setActive(request.getActive() == null || request.getActive());
+        d.setCategoryCodes(request.getCategories() == null ? new LinkedHashSet<>() : new LinkedHashSet<>(request.getCategories()));
+        return d;
+    }
+    private DiscountResponse to(DiscountCode d) {
+        DiscountResponse r = new DiscountResponse(); r.setId(d.getId()); r.setCode(d.getCode()); r.setType(d.getType() == null ? null : d.getType().name());
+        r.setValue(d.getValue()); r.setMinimumSubtotal(d.getMinimumSubtotal()); r.setStartDate(d.getStartDate()); r.setEndDate(d.getEndDate());
+        r.setCategories(new ArrayList<>(d.getCategoryCodes() == null ? new LinkedHashSet<>() : d.getCategoryCodes())); r.setActive(d.isActive()); return r;
+    }
+    private DiscountCode save(DiscountCode d, MerchantStore store) {
+        try { return discountCodeService.save(d, store); }
+        catch (DataIntegrityViolationException e) { throw new DiscountConflictException("Discount code already exists"); }
+        catch (ServiceException e) { throw new DiscountBadRequestException(e.getMessage()); }
+    }
+    @PostMapping
+    @ResponseStatus(HttpStatus.CREATED)
+    public DiscountResponse create(@RequestBody DiscountRequest request, @ApiIgnore MerchantStore store, @RequestParam(value="store", required=false) String ignored) { authorize(); return to(save(from(request, store), store)); }
+    @GetMapping
+    public List<DiscountResponse> list(@ApiIgnore MerchantStore store, @RequestParam(value="store", required=false) String ignored) { authorize(); try { return discountCodeService.list(store).stream().map(this::to).collect(Collectors.toList()); } catch (ServiceException e) { throw new DiscountBadRequestException(e.getMessage()); } }
+    @PutMapping("/{id}")
+    public DiscountResponse update(@PathVariable Long id, @RequestBody DiscountRequest request, @ApiIgnore MerchantStore store, @RequestParam(value="store", required=false) String ignored) {
+        authorize(); DiscountCode existing; try { existing = discountCodeService.findById(store, id); } catch (ServiceException e) { throw new DiscountBadRequestException(e.getMessage()); } if (existing == null) throw new ResourceNotFoundException("Discount not found");
+        DiscountCode replacement = from(request, store); replacement.setId(id); return to(save(replacement, store));
+    }
+    @DeleteMapping("/{id}")
+    public ResponseEntity<Void> delete(@PathVariable Long id, @ApiIgnore MerchantStore store, @RequestParam(value="store", required=false) String ignored) {
+        authorize(); DiscountCode existing; try { existing = discountCodeService.findById(store, id); } catch (ServiceException e) { throw new DiscountBadRequestException(e.getMessage()); } if (existing == null) throw new ResourceNotFoundException("Discount not found");
+        try { discountCodeService.delete(existing); } catch (ServiceException e) { throw new DiscountBadRequestException(e.getMessage()); }
+        return ResponseEntity.noContent().build();
+    }
+}
