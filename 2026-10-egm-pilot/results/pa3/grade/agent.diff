@@ -0,0 +1,48 @@
+package com.salesmanager.core.business.services.order.discount;
+
+import java.util.List;
+import java.util.Locale;
+
+import javax.inject.Inject;
+
+import org.springframework.dao.DataIntegrityViolationException;
+import org.springframework.stereotype.Service;
+import org.springframework.util.StringUtils;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.order.discount.DiscountCodeRepository;
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.discount.DiscountCode;
+import com.salesmanager.core.model.order.discount.DiscountType;
+
+@Service("discountCodeService")
+public class DiscountCodeServiceImpl implements DiscountCodeService {
+    private final DiscountCodeRepository repository;
+    private final CategoryService categoryService;
+
+    @Inject
+    public DiscountCodeServiceImpl(DiscountCodeRepository repository, CategoryService categoryService) {
+        this.repository = repository;
+        this.categoryService = categoryService;
+    }
+
+    @Override public List<DiscountCode> list(MerchantStore store) { return repository.findByMerchantStoreIdOrderByIdAsc(store.getId()); }
+    @Override public DiscountCode find(MerchantStore store, String code) { return code == null ? null : repository.findByMerchantStoreIdAndNormalizedCode(store.getId(), code.toUpperCase(Locale.ROOT)); }
+    @Override public DiscountCode findById(MerchantStore store, Long id) { return repository.findByMerchantStoreIdAndId(store.getId(), id); }
+
+    @Override
+    public DiscountCode save(DiscountCode discount, MerchantStore store) throws ServiceException {
+        if (discount == null || discount.getMerchantStore() == null || !store.getId().equals(discount.getMerchantStore().getId())) throw new ServiceException("Discount store is invalid");
+        if (!StringUtils.hasText(discount.getCode())) throw new ServiceException("Discount code is required");
+        if (discount.getType() == null || discount.getValue() == null || discount.getValue().signum() <= 0) throw new ServiceException("Discount type and positive value are required");
+        if (discount.getType() == DiscountType.PERCENT && discount.getValue().compareTo(java.math.BigDecimal.valueOf(100)) > 0) throw new ServiceException("Percentage cannot exceed 100");
+        if (discount.getStartDate() == null) throw new ServiceException("Start date is required");
+        if (discount.getEndDate() != null && discount.getEndDate().isBefore(discount.getStartDate())) throw new ServiceException("End date cannot precede start date");
+        discount.setNormalizedCode(discount.getCode().toUpperCase(Locale.ROOT));
+        if (repository.existsByStoreAndNormalizedCodeExcludingId(store.getId(), discount.getNormalizedCode(), discount.getId())) throw new DataIntegrityViolationException("Duplicate discount code");
+        if (discount.getCategoryCodes() != null) for (String category : discount.getCategoryCodes()) if (categoryService.getByCode(store, category) == null) throw new ServiceException("Unknown category: " + category);
+        try { return repository.saveAndFlush(discount); } catch (DataIntegrityViolationException e) { throw e; }
+    }
+    @Override public void delete(DiscountCode discount) { repository.delete(discount); }
+}
