@@ -0,0 +1,90 @@
+package com.salesmanager.core.business.services.order.discount;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.Clock;
+import java.time.LocalDate;
+import java.util.ArrayList;
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.springframework.context.annotation.Bean;
+import org.springframework.context.annotation.Configuration;
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.business.services.shoppingcart.ShoppingCartService;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.discount.DiscountCode;
+import com.salesmanager.core.model.order.discount.DiscountType;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service("discountCalculationService")
+public class DiscountCalculationServiceImpl implements DiscountCalculationService {
+    private final DiscountCodeService discountCodeService;
+    private final CategoryService categoryService;
+    private final ShoppingCartService shoppingCartService;
+    private final Clock discountClock;
+
+    @Inject
+    public DiscountCalculationServiceImpl(DiscountCodeService discountCodeService, CategoryService categoryService,
+            ShoppingCartService shoppingCartService, Clock discountClock) {
+        this.discountCodeService = discountCodeService; this.categoryService = categoryService;
+        this.shoppingCartService = shoppingCartService; this.discountClock = discountClock;
+    }
+
+    @Override
+    public DiscountEvaluation evaluate(String code, ShoppingCart cart, MerchantStore store) throws ServiceException {
+        if (cart == null || cart.getMerchantStore() == null || !store.getId().equals(cart.getMerchantStore().getId())) return DiscountEvaluation.invalid("Cart store is invalid");
+        if (code == null || code.isEmpty()) return DiscountEvaluation.invalid("Discount code is required");
+        DiscountCode discount = discountCodeService.find(store, code);
+        if (discount == null) return DiscountEvaluation.invalid("Discount code is invalid");
+        LocalDate today = LocalDate.now(discountClock);
+        if (!discount.isActive()) return DiscountEvaluation.invalid("Discount code is inactive");
+        if (today.isBefore(discount.getStartDate()) || (discount.getEndDate() != null && today.isAfter(discount.getEndDate()))) return DiscountEvaluation.invalid("Discount code is not available today");
+
+        List<ShoppingCartItem> available = new ArrayList<>();
+        for (ShoppingCartItem item : cart.getLineItems()) if (item.getProduct() != null && item.getProduct().isAvailable()) available.add(item);
+        BigDecimal subtotal = BigDecimal.ZERO;
+        for (ShoppingCartItem item : available) subtotal = subtotal.add(item.getItemPrice().multiply(BigDecimal.valueOf(item.getQuantity())));
+        if (subtotal.compareTo(discount.getMinimumSubtotal() == null ? BigDecimal.ZERO : discount.getMinimumSubtotal()) < 0) return DiscountEvaluation.invalid("Minimum subtotal not met");
+
+        List<Category> categories = new ArrayList<>();
+        if (discount.getCategoryCodes() != null) for (String categoryCode : discount.getCategoryCodes()) {
+            Category category = categoryService.getByCode(store, categoryCode);
+            if (category != null) categories.add(category);
+        }
+        BigDecimal eligible = BigDecimal.ZERO;
+        for (ShoppingCartItem item : available) {
+            boolean matches = categories.isEmpty() && (discount.getCategoryCodes() == null || discount.getCategoryCodes().isEmpty());
+            if (!matches) for (Category configured : categories) for (Category productCategory : item.getProduct().getCategories()) {
+                String root = configured.getLineage();
+                String productLineage = productCategory.getLineage();
+                if (root != null && productLineage != null && (productLineage.equals(root) || productLineage.startsWith(root))) matches = true;
+            }
+            if (matches) eligible = eligible.add(item.getItemPrice().multiply(BigDecimal.valueOf(item.getQuantity())));
+        }
+        if (eligible.signum() <= 0) return DiscountEvaluation.invalid("No eligible cart items");
+        BigDecimal value = discount.getType() == DiscountType.PERCENT ? eligible.multiply(discount.getValue()).divide(BigDecimal.valueOf(100), 8, RoundingMode.HALF_UP) : discount.getValue().min(eligible);
+        value = value.min(eligible).setScale(2, RoundingMode.HALF_UP);
+        return value.signum() > 0 ? DiscountEvaluation.valid(discount, eligible, value) : DiscountEvaluation.invalid("Discount is zero");
+    }
+
+    @Override
+    public DiscountEvaluation refreshCartDiscount(ShoppingCart cart, MerchantStore store) throws ServiceException {
+        if (cart.getPromoCode() == null) return DiscountEvaluation.invalid("No discount code");
+        DiscountEvaluation result = evaluate(cart.getPromoCode(), cart, store);
+        if (!result.isValid()) { cart.setPromoCode(null); shoppingCartService.saveOrUpdate(cart); }
+        return result;
+    }
+}
+
+@Configuration
+class DiscountClockConfiguration {
+    @Bean
+    public Clock discountClock() { return Clock.systemDefaultZone(); }
+}
