diff --git a/sm-core/src/main/java/com/salesmanager/core/business/services/order/discount/DiscountCalculationServiceImpl.java b/sm-core/src/main/java/com/salesmanager/core/business/services/order/discount/DiscountCalculationServiceImpl.java
