+package com.salesmanager.core.business.services.order.discount;
+
+import java.math.BigDecimal;
+import com.salesmanager.core.model.order.discount.DiscountCode;
+
+public final class DiscountEvaluation {
+    private final DiscountCode discount;
+    private final BigDecimal eligibleSubtotal;
+    private final BigDecimal value;
+    private final String invalidReason;
+
+    private DiscountEvaluation(DiscountCode discount, BigDecimal eligibleSubtotal, BigDecimal value, String invalidReason) {
+        this.discount = discount; this.eligibleSubtotal = eligibleSubtotal; this.value = value; this.invalidReason = invalidReason;
+    }
+    public static DiscountEvaluation invalid(String reason) { return new DiscountEvaluation(null, BigDecimal.ZERO, BigDecimal.ZERO, reason); }
+    public static DiscountEvaluation valid(DiscountCode discount, BigDecimal eligibleSubtotal, BigDecimal value) { return new DiscountEvaluation(discount, eligibleSubtotal, value, null); }
+    public boolean isValid() { return discount != null && value.signum() > 0; }
+    public DiscountCode getDiscount() { return discount; }
+    public BigDecimal getEligibleSubtotal() { return eligibleSubtotal; }
+    public BigDecimal getValue() { return value; }
+    public String getInvalidReason() { return invalidReason; }
+}
