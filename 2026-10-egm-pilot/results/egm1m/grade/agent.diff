@@ -0,0 +1,55 @@
+package com.salesmanager.core.business.services.discount;
+
+import java.math.*;
+import java.time.LocalDate;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.dao.DataIntegrityViolationException;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.discount.DiscountRepository;
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.discount.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.*;
+
+@Service("discountService")
+public class DiscountServiceImpl implements DiscountService {
+    @Inject private DiscountRepository repository;
+    @Inject private CategoryService categoryService;
+    private ServiceException error(String message){ return new ServiceException(ServiceException.EXCEPTION_VALIDATION, message); }
+    private void prepare(Discount d, MerchantStore store) throws ServiceException {
+        if(d==null || d.getCode()==null || d.getCode().trim().isEmpty() || d.getCode().trim().length()>64) throw error("Invalid discount code");
+        if(d.getType()==null || d.getValue()==null || d.getValue().compareTo(BigDecimal.ZERO)<=0) throw error("Invalid discount type or value");
+        if(d.getType()==DiscountType.PERCENT && d.getValue().compareTo(new BigDecimal("100"))>0) throw error("Percentage must be at most 100");
+        if(d.getMinimumSubtotal()!=null && d.getMinimumSubtotal().compareTo(BigDecimal.ZERO)<0) throw error("Minimum subtotal cannot be negative");
+        if(d.getStartDate()==null) d.setStartDate(LocalDate.now());
+        if(d.getEndDate()!=null && d.getEndDate().isBefore(d.getStartDate())) throw error("End date precedes start date");
+        d.setCode(d.getCode().trim()); d.setNormalizedCode(DiscountService.normalize(d.getCode())); d.setMerchantStore(store);
+        if(!d.isActive() && d.getId()==null) d.setActive(false);
+        if(d.getCategories()!=null) for(DiscountCategory link:d.getCategories()) if(link.getCategory()==null || link.getCategory().getMerchantStore()==null || !store.getId().equals(link.getCategory().getMerchantStore().getId())) throw error("Invalid category");
+    }
+    public void validate(Discount d, MerchantStore s)throws ServiceException{prepare(d,s);}
+    @Transactional public Discount create(Discount d, MerchantStore s)throws ServiceException { prepare(d,s); if(repository.findByStoreAndNormalizedCode(s.getId(),d.getNormalizedCode())!=null) throw error("Duplicate discount code"); try{return repository.saveAndFlush(d);}catch(DataIntegrityViolationException e){throw error("Duplicate discount code");} }
+    @Transactional public Discount update(Discount d, MerchantStore s)throws ServiceException { prepare(d,s); Discount old=repository.findByIdAndStore(d.getId(),s.getId()); if(old==null) return null; Discount duplicate=repository.findByStoreAndNormalizedCode(s.getId(),d.getNormalizedCode()); if(duplicate!=null&&!duplicate.getId().equals(d.getId())) throw error("Duplicate discount code"); d.setMerchantStore(s); return repository.saveAndFlush(d); }
+    @Transactional public void delete(Long id, MerchantStore s)throws ServiceException { Discount d=get(id,s); if(d!=null) repository.delete(d); }
+    public Discount get(Long id, MerchantStore s){return repository.findByIdAndStore(id,s.getId());}
+    public List<Discount> list(MerchantStore s){return repository.findByStore(s.getId());}
+    public Discount find(MerchantStore s,String code){return code==null?null:repository.findByStoreAndNormalizedCode(s.getId(),DiscountService.normalize(code));}
+    public BigDecimal calculate(Discount d, ShoppingCart cart, LocalDate today)throws ServiceException {
+        if(d==null||!d.isActive()||today.isBefore(d.getStartDate())||(d.getEndDate()!=null&&today.isAfter(d.getEndDate()))) return null;
+        BigDecimal full=BigDecimal.ZERO; for(ShoppingCartItem i:cart.getLineItems()) if(i.getQuantity()!=null&&i.getProduct()!=null&&i.getFinalPrice()!=null&&i.getFinalPrice().getFinalPrice()!=null) full=full.add(i.getFinalPrice().getFinalPrice().multiply(BigDecimal.valueOf(i.getQuantity())));
+        if(d.getMinimumSubtotal()!=null&&full.compareTo(d.getMinimumSubtotal())<0) return null;
+        BigDecimal eligible=full;
+        if(d.getCategories()!=null&&!d.getCategories().isEmpty()) { Set<Long> ids=new HashSet<>(); for(DiscountCategory l:d.getCategories()){Category c=l.getCategory(); ids.add(c.getId()); if(c.getLineage()!=null) for(Category child:categoryService.getListByLineage(cart.getMerchantStore(),c.getLineage())) ids.add(child.getId());} eligible=BigDecimal.ZERO; for(ShoppingCartItem i:cart.getLineItems()) if(i.getProduct()!=null&&i.getProduct().getCategories()!=null&&i.getProduct().getCategories().stream().anyMatch(c->ids.contains(c.getId()))&&i.getFinalPrice()!=null) eligible=eligible.add(i.getFinalPrice().getFinalPrice().multiply(BigDecimal.valueOf(i.getQuantity()))); }
+        if(eligible.signum()==0)return null; BigDecimal result=d.getType()==DiscountType.PERCENT?eligible.multiply(d.getValue()).divide(new BigDecimal("100")):d.getValue(); return result.min(eligible).setScale(2,RoundingMode.HALF_UP);
+    }
+    public BigDecimal calculate(Discount d, List<ShoppingCartItem> items, LocalDate today)throws ServiceException {
+        if(d==null||!d.isActive()||today.isBefore(d.getStartDate())||(d.getEndDate()!=null&&today.isAfter(d.getEndDate()))) return null;
+        BigDecimal subtotal=BigDecimal.ZERO; for(ShoppingCartItem i:items) if(i.getFinalPrice()!=null&&i.getFinalPrice().getFinalPrice()!=null) subtotal=subtotal.add(i.getFinalPrice().getFinalPrice().multiply(BigDecimal.valueOf(i.getQuantity())));
+        if(d.getMinimumSubtotal()!=null&&subtotal.compareTo(d.getMinimumSubtotal())<0)return null;
+        BigDecimal result=d.getType()==DiscountType.PERCENT?subtotal.multiply(d.getValue()).divide(new BigDecimal("100")):d.getValue(); return result.min(subtotal).setScale(2,RoundingMode.HALF_UP);
+    }
+}
