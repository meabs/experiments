+ private Discount toEntity(DiscountRequest r, MerchantStore s) throws ServiceException { Discount d=new Discount(); d.setCode(r.getCode()); try{d.setType(r.getType()==null?null:DiscountType.valueOf(r.getType().trim().toUpperCase(Locale.ROOT)));}catch(Exception e){throw new ServiceException("Invalid discount type");} d.setValue(r.getValue()); d.setMinimumSubtotal(r.getMinimumSubtotal()); d.setStartDate(r.getStartDate()); d.setEndDate(r.getEndDate()); d.setActive(r.getActive()==null||r.getActive()); d.setMerchantStore(s); if(r.getCategories()!=null){Set<DiscountCategory> links=new HashSet<>(); for(String code:r.getCategories()){Category c=categoryService.getByCode(s,code); if(c==null)throw new ServiceException("Unknown category"); DiscountCategory l=new DiscountCategory(); l.setDiscount(d); l.setCategory(c); links.add(l);} d.setCategories(links);} return d; }
