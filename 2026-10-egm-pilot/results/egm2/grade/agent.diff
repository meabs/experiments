+package com.salesmanager.core.business.services.discount;
+import java.text.Normalizer; import java.util.*;
+import javax.inject.Inject; import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.business.repositories.discount.DiscountRepository;
+import com.salesmanager.core.model.discount.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("discountService") public class DiscountServiceImpl implements DiscountService {
+ @Inject private DiscountRepository repository;
+ public static String normalize(String code){ return Normalizer.normalize(code.trim(),Normalizer.Form.NFKC).toLowerCase(Locale.ROOT); }
+ public Discount save(Discount d, MerchantStore store) throws ServiceException { if(d==null||d.getCode()==null||d.getCode().trim().isEmpty()||d.getCode().trim().length()>64||d.getType()==null||d.getValue()==null||d.getValue().signum()<=0||(d.getType()==DiscountType.PERCENT&&d.getValue().compareTo(java.math.BigDecimal.valueOf(100))>0)) throw new ServiceException("INVALID_DISCOUNT"); d.setMerchantStore(store); d.setCodeNormalized(normalize(d.getCode())); if(!d.isActive()){} if(d.getStartDate()==null)d.setStartDate(java.time.LocalDate.now()); if(d.getId()==null&&repository.existsByMerchantStoreIdAndCodeNormalized(store.getId(),d.getCodeNormalized())) throw new ServiceException("DISCOUNT_CONFLICT"); return repository.save(d); }
+ public Optional<Discount> find(MerchantStore s,String c){return c==null?Optional.empty():repository.findByMerchantStoreIdAndCodeNormalized(s.getId(),normalize(c));}
+ public Optional<Discount> find(MerchantStore s,Long id){return repository.findById(id).filter(d->d.getMerchantStore().getId().equals(s.getId()));}
+ public List<Discount> list(MerchantStore s){return repository.findByMerchantStoreId(s.getId());}
+ public void delete(MerchantStore s,Long id)throws ServiceException{find(s,id).ifPresent(repository::delete);}
+}
