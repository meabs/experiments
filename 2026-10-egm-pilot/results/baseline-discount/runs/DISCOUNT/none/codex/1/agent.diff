+@Service public class DiscountServiceImpl implements DiscountService { private final DiscountRepository repo; @Inject public DiscountServiceImpl(DiscountRepository r){repo=r;} public Discount save(Discount d){return repo.save(d);} public List<Discount> list(MerchantStore s){return repo.findByMerchantStoreId(s.getId());} public Optional<Discount> find(Long id,MerchantStore s){return repo.findByIdAndMerchantStoreId(id,s.getId());} public Optional<Discount> find(String c,MerchantStore s){return repo.findByStoreAndCode(s.getId(),c);} public void delete(Long id,MerchantStore s){find(id,s).ifPresent(repo::delete);} }
