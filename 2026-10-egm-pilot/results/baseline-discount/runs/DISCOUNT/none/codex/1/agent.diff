+package com.salesmanager.shop.store.api.v1.discount;
+import java.math.BigDecimal; import java.time.LocalDate; import java.util.*;
+import javax.inject.Inject; import org.springframework.http.*; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.discount.DiscountService; import com.salesmanager.core.model.discount.*; import com.salesmanager.core.model.merchant.MerchantStore; import springfox.documentation.annotations.ApiIgnore;
+
+@RestController @RequestMapping("/api/v1/private/discounts")
+public class DiscountApi {
+ @Inject private DiscountService service;
+ @PostMapping public ResponseEntity<Discount> create(@RequestBody Discount d,@ApiIgnore MerchantStore store){return new ResponseEntity<>(save(d,null,store),HttpStatus.CREATED);}
+ @GetMapping public List<Discount> list(@ApiIgnore MerchantStore store){return service.list(store);}
+ @PutMapping("/{id}") public Discount update(@PathVariable Long id,@RequestBody Discount d,@ApiIgnore MerchantStore store){return save(d,id,store);}
+ @DeleteMapping("/{id}") public ResponseEntity<Void> delete(@PathVariable Long id,@ApiIgnore MerchantStore store){service.delete(id,store);return ResponseEntity.noContent().build();}
+ private Discount save(Discount d,Long id,MerchantStore store){
+  if(d.getCode()==null||d.getCode().isBlank()||d.getValue()==null||d.getType()==null) throw bad("code, type and value are required");
+  if(d.getType()==DiscountType.PERCENT && (d.getValue().signum()<=0||d.getValue().compareTo(BigDecimal.valueOf(100))>0) || d.getType()==DiscountType.AMOUNT&&d.getValue().signum()<=0) throw bad("invalid value");
+  if(d.getStartDate()==null)d.setStartDate(LocalDate.now()); if(d.getEndDate()!=null&&d.getEndDate().isBefore(d.getStartDate()))throw bad("endDate before startDate");
+  if(d.getCategories()==null)d.setCategories(new HashSet<>()); d.setActive(d.isActive());
+  Optional<Discount> clash=service.find(d.getCode(),store); if(clash.isPresent()&&!Objects.equals(clash.get().getId(),id))throw new ConflictError("code already exists");
+  if(id!=null){Discount old=service.find(id,store).orElseThrow(()->new ApiError(HttpStatus.NOT_FOUND,"not found")); d.setId(id); d.setMerchantStore(store);} else d.setMerchantStore(store); return service.save(d);
+ }
+ private ApiError bad(String s){return new ApiError(HttpStatus.BAD_REQUEST,s);}
+ @ResponseStatus(HttpStatus.BAD_REQUEST) static class ApiError extends RuntimeException { final HttpStatus status; ApiError(HttpStatus s,String m){super(m);status=s;} }
+ @ResponseStatus(HttpStatus.CONFLICT) static class ConflictError extends RuntimeException { ConflictError(String m){super(m);} }
+}
