+package com.salesmanager.shop.store.api.v1.discount;
+import java.math.BigDecimal; import java.time.LocalDate; import java.util.List; import javax.inject.Inject; import javax.servlet.http.HttpServletResponse;
+import org.springframework.http.HttpStatus; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.business.services.discount.DiscountService; import com.salesmanager.core.model.discount.*; import com.salesmanager.core.model.merchant.MerchantStore; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/discounts")
+public class DiscountApi {
+ @Inject private DiscountService service;
+ @PostMapping @ResponseStatus(HttpStatus.CREATED) public Discount create(@RequestBody Discount d,@ApiIgnore MerchantStore store,HttpServletResponse response){return write(validate(d,store,null),store,response);}
+ @GetMapping public List<Discount> list(@ApiIgnore MerchantStore store){return service.list(store);}
+ @PutMapping("/{id}") public Discount update(@PathVariable Long id,@RequestBody Discount d,@ApiIgnore MerchantStore store,HttpServletResponse response){return write(validate(d,store,id),store,response);}
+ @DeleteMapping("/{id}") @ResponseStatus(HttpStatus.NO_CONTENT) public void delete(@PathVariable Long id,@ApiIgnore MerchantStore store){if(service.find(id,store).isEmpty()) throw new IllegalArgumentException("not found"); service.delete(id,store);}
+ private Discount write(Discount d,MerchantStore s,HttpServletResponse r){if(service.find(d.getCode(),s).filter(x->!x.getId().equals(d.getId())).isPresent()) throw new IllegalArgumentException("Code already exists"); return service.save(d,s);}
+ private Discount validate(Discount d,MerchantStore s,Long id){if(d.getCode()==null||d.getCode().trim().isEmpty()||d.getValue()==null||d.getType()==null) throw new IllegalArgumentException("invalid discount"); if(d.getType()==DiscountType.PERCENT&&(d.getValue().compareTo(BigDecimal.ZERO)<=0||d.getValue().compareTo(BigDecimal.valueOf(100))>0)||d.getType()==DiscountType.AMOUNT&&d.getValue().compareTo(BigDecimal.ZERO)<=0) throw new IllegalArgumentException("invalid value"); if(d.getStartDate()==null)d.setStartDate(LocalDate.now()); if(d.getEndDate()!=null&&d.getEndDate().isBefore(d.getStartDate()))throw new IllegalArgumentException("invalid dates"); d.setId(id); d.setCode(d.getCode().trim()); return d; }
+}
