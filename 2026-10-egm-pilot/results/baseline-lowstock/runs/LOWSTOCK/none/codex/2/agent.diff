+	@GetMapping(value = "/private/products/low-stock", produces = APPLICATION_JSON_VALUE)
+	public @ResponseBody Map<String, Object> lowStock(
+			@RequestParam("store") String storeCode,
+			@RequestParam(value = "threshold", defaultValue = "5") String thresholdValue,
+			@RequestParam(value = "page", defaultValue = "0") int page,
+			@RequestParam(value = "count", defaultValue = "20") int count,
+			@ApiIgnore MerchantStore merchantStore) {
+		final int threshold;
+		try {
+			threshold = Integer.parseInt(thresholdValue);
+		} catch (NumberFormatException e) {
+			throw new BadRequestException("threshold must be a non-negative integer");
+		}
+		if (threshold < 0 || page < 0 || count <= 0) {
+			throw new BadRequestException("threshold, page and count have invalid values");
+		}
+		if (merchantStore == null || !merchantStore.getCode().equals(storeCode)) {
+			throw new BadRequestException("store does not match the authenticated store");
+		}
+
+		List<LowStockItem> matching = new ArrayList<>();
+		for (Product product : productService.listByStore(merchantStore)) {
+			int stock = product.getAvailabilities().stream()
+					.mapToInt(a -> a.getProductQuantity() == null ? 0 : a.getProductQuantity()).sum();
+			if (stock <= threshold) {
+				matching.add(new LowStockItem(product.getId(), product.getSku(), stock));
+			}
+		}
+		matching.sort(Comparator.comparingInt(LowStockItem::getStock)
+				.thenComparing(LowStockItem::getSku, Comparator.nullsFirst(String.CASE_INSENSITIVE_ORDER)));
+		int from = Math.min(page * count, matching.size());
+		int to = Math.min(from + count, matching.size());
+
+		Map<String, Object> response = new LinkedHashMap<>();
+		response.put("threshold", threshold);
+		response.put("totalCount", matching.size());
+		response.put("items", matching.subList(from, to));
+		return response;
+	}
+
+	private static class LowStockItem {
+		private final Long id;
+		private final String sku;
+		private final int stock;
+
+		private LowStockItem(Long id, String sku, int stock) {
+			this.id = id;
+			this.sku = sku;
+			this.stock = stock;
+		}
+
+		public Long getId() { return id; }
+		public String getSku() { return sku; }
+		public int getStock() { return stock; }
+	}
+
+	@ResponseStatus(HttpStatus.BAD_REQUEST)
+	private static class BadRequestException extends RuntimeException {
+		private static final long serialVersionUID = 1L;
+		private BadRequestException(String message) { super(message); }
+	}
