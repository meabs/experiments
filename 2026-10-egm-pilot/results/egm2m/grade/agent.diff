+package com.salesmanager.core.business.services.discount;
+
+import java.math.BigDecimal;
+
+import com.salesmanager.core.model.discount.Discount;
+
+public final class DiscountCalculation {
+    private final Discount discount;
+    private final BigDecimal amount;
+
+    public DiscountCalculation(Discount discount, BigDecimal amount) {
+        this.discount = discount;
+        this.amount = amount;
+    }
+    public Discount getDiscount() { return discount; }
+    public BigDecimal getAmount() { return amount; }
+    public boolean isApplied() { return discount != null && amount != null && amount.signum() > 0; }
+}
