+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service("discountService")
+public class DiscountServiceImpl implements DiscountService {
+    private static final int CODE_LIMIT = 64;
+    private static final int CATEGORY_LIMIT = 50;
+
+    @Inject private DiscountRepository repository;
+    @Inject private CategoryRepository categoryRepository;
+
+    public static String normalize(String code) {
+        if (code == null) return null;
+        return Normalizer.normalize(code.trim(), Normalizer.Form.NFKC).toLowerCase(Locale.ROOT);
+    }
+
+    @Override @Transactional
+    public Discount create(Discount discount, MerchantStore store) throws ServiceException {
+        prepare(discount, store, false);
+        try { return repository.saveAndFlush(discount); }
+        catch (RuntimeException e) { throw new ServiceException("DISCOUNT_CONFLICT", e); }
+    }
+
+    @Override @Transactional
+    public Discount update(Discount discount, MerchantStore store) throws ServiceException {
+        prepare(discount, store, true);
+        try { return repository.saveAndFlush(discount); }
+        catch (RuntimeException e) { throw new ServiceException("DISCOUNT_CONFLICT", e); }
+    }
+
+    private void prepare(Discount d, MerchantStore store, boolean update) throws ServiceException {
+        if (d == null || store == null || d.getCode() == null || d.getType() == null || d.getValue() == null)
+            throw new ServiceException("INVALID_DISCOUNT");
+        String normalized = normalize(d.getCode());
+        if (normalized.isEmpty() || normalized.length() > CODE_LIMIT || d.getStartDate() == null
+                || d.getValue().signum() <= 0 || (d.getType() == DiscountType.PERCENT && d.getValue().compareTo(new BigDecimal("100")) > 0)
+                || (d.getEndDate() != null && d.getEndDate().isBefore(d.getStartDate()))
+                || d.getMinimumSubtotal() != null && d.getMinimumSubtotal().signum() < 0)
+            throw new ServiceException("INVALID_DISCOUNT");
+        if (d.getCategories() != null && d.getCategories().size() > CATEGORY_LIMIT) throw new ServiceException("INVALID_DISCOUNT");
+        Discount existing = repository.findByMerchantStoreIdAndNormalizedCode(store.getId(), normalized);
+        if (existing != null && (!update || !existing.getId().equals(d.getId()))) throw new ServiceException("DISCOUNT_CONFLICT");
+        d.setMerchantStore(store); d.setNormalizedCode(normalized);
+        if (d.getCategories() == null) d.setCategories(new HashSet<>());
+        for (Category c : d.getCategories()) {
+            Category persisted = c == null || c.getId() == null ? null : categoryRepository.findByIdAndStore(c.getId(), store.getId());
+            if (persisted == null) throw new ServiceException("INVALID_DISCOUNT");
+        }
+    }
+
+    @Override public Discount get(Long id, MerchantStore store) { return id == null || store == null ? null : repository.findByIdAndMerchantStoreId(id, store.getId()); }
+    @Override public Discount find(MerchantStore store, String code) { String normalized = normalize(code); return normalized == null ? null : repository.findByMerchantStoreIdAndNormalizedCode(store.getId(), normalized); }
+    @Override public List<Discount> list(MerchantStore store) { return repository.findByMerchantStoreId(store.getId()); }
+    @Override public Page<Discount> list(MerchantStore store, Pageable pageable) { return repository.findByMerchantStoreId(store.getId(), pageable); }
+    @Override @Transactional public void delete(Long id, MerchantStore store) throws ServiceException { Discount d = get(id, store); if (d == null) throw new ServiceException("DISCOUNT_NOT_FOUND"); repository.delete(d); }
+
+    @Override public DiscountCalculation calculate(ShoppingCart cart, MerchantStore store) { return calculate(cart, store, cart == null ? null : cart.getPromoCode()); }
+
+    @Override public DiscountCalculation calculate(ShoppingCart cart, MerchantStore store, String code) {
+        if (cart == null || store == null || code == null) return new DiscountCalculation(null, BigDecimal.ZERO.setScale(2));
+        Discount d = find(store, code);
+        if (d == null || !d.isActive() || d.getStartDate() == null) return new DiscountCalculation(null, BigDecimal.ZERO.setScale(2));
+        LocalDate today = LocalDate.now();
+        if (today.isBefore(d.getStartDate()) || d.getEndDate() != null && today.isAfter(d.getEndDate())) return new DiscountCalculation(null, BigDecimal.ZERO.setScale(2));
+        BigDecimal subtotal = BigDecimal.ZERO;
+        BigDecimal eligible = BigDecimal.ZERO;
+        Set<Long> configured = d.getCategories().stream().map(Category::getId).collect(Collectors.toSet());
+        for (ShoppingCartItem item : cart.getLineItems()) {
+            BigDecimal line = item.getItemPrice().multiply(BigDecimal.valueOf(item.getQuantity())); subtotal = subtotal.add(line);
+            if (configured.isEmpty() || item.getProduct().getCategories().stream().anyMatch(c -> isDescendant(c, configured))) eligible = eligible.add(line);
+        }
+        if (d.getMinimumSubtotal() != null && subtotal.compareTo(d.getMinimumSubtotal()) < 0 || eligible.signum() <= 0) return new DiscountCalculation(null, BigDecimal.ZERO.setScale(2));
+        BigDecimal amount = d.getType() == DiscountType.PERCENT ? eligible.multiply(d.getValue()).divide(new BigDecimal("100"), 8, RoundingMode.HALF_UP) : d.getValue().min(eligible);
+        amount = amount.min(eligible).setScale(2, RoundingMode.HALF_UP);
+        return new DiscountCalculation(d, amount);
+    }
+
+    private boolean isDescendant(Category category, Set<Long> configured) {
+        if (configured.contains(category.getId())) return true;
+        String lineage = category.getLineage();
+        return lineage != null && configured.stream().anyMatch(id -> lineage.contains("/" + id + "/"));
+    }
+}
