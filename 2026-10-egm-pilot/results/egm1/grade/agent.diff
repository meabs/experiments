+package com.salesmanager.core.business.services.order;
+import java.math.*; import java.time.LocalDate; import java.util.*; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional; import com.salesmanager.core.business.repositories.order.DiscountRepository; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.order.*; import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+@Service public class DiscountServiceImpl implements DiscountService {
+ private final DiscountRepository repo; public DiscountServiceImpl(DiscountRepository r){repo=r;}
+ public List<Discount> list(MerchantStore s){return repo.findByMerchantStoreId(s.getId());}
+ public Discount get(MerchantStore s,String code){return repo.findByMerchantStoreIdAndNormalizedCode(s.getId(),code.trim().toLowerCase(Locale.ROOT)).orElse(null);}
+ @Transactional public Discount save(Discount d){return repo.save(d);} public void delete(Discount d){repo.delete(d);}
+ public void validate(Discount d,MerchantStore s){if(d.getCode()==null||d.getCode().trim().isEmpty()||d.getCode().trim().length()>64||d.getType()==null||d.getValue()==null||d.getValue().signum()<=0)throw new IllegalArgumentException("Invalid discount"); if(d.getType()==DiscountType.PERCENT&&(d.getValue().compareTo(BigDecimal.valueOf(100))>0))throw new IllegalArgumentException("Invalid percentage"); if(d.getMinimumSubtotal()!=null&&d.getMinimumSubtotal().signum()<0)throw new IllegalArgumentException("Invalid minimum"); if(d.getEndDate()!=null&&d.getStartDate()!=null&&d.getEndDate().isBefore(d.getStartDate()))throw new IllegalArgumentException("Invalid dates"); d.setMerchantStore(s); d.setCode(d.getCode().trim()); if(d.getStartDate()==null)d.setStartDate(LocalDate.now()); if(d.getCategories()==null)d.setCategories(new HashSet<>());}
+ public boolean eligible(Discount d,ShoppingCart c,BigDecimal subtotal){LocalDate now=LocalDate.now();return d!=null&&d.isActive()&&(d.getStartDate()==null||!now.isBefore(d.getStartDate()))&&(d.getEndDate()==null||!now.isAfter(d.getEndDate()))&&(d.getMinimumSubtotal()==null||subtotal.compareTo(d.getMinimumSubtotal())>=0);}
+ public BigDecimal calculate(Discount d,ShoppingCart c,BigDecimal subtotal){if(!eligible(d,c,subtotal))return BigDecimal.ZERO; BigDecimal x=d.getType()==DiscountType.PERCENT?subtotal.multiply(d.getValue()).divide(BigDecimal.valueOf(100)):d.getValue();return x.min(subtotal).setScale(2,RoundingMode.HALF_UP);}
+}
