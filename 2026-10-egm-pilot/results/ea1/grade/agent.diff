+package com.salesmanager.core.business.services.discount;
+import java.math.*; import java.time.LocalDate; import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional; import com.salesmanager.core.business.services.catalog.category.CategoryService; import com.salesmanager.core.business.services.discount.DiscountCalculationService.PricedCartItem; import com.salesmanager.core.business.repositories.discount.DiscountCodeRepository; import com.salesmanager.core.model.catalog.category.Category; import com.salesmanager.core.model.discount.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("discountCalculationService") public class DiscountCalculationServiceImpl implements DiscountCalculationService { @Inject private DiscountCodeRepository repository; @Inject private CategoryService categoryService;
+ @Transactional(readOnly=true) public DiscountApplicationResult evaluate(MerchantStore store,String code,List<PricedCartItem> items,LocalDate today){if(code==null||code.trim().isEmpty())return DiscountApplicationResult.notApplicable(); DiscountCode d=repository.findByMerchantStoreAndCodeNormalized(store,code.toUpperCase(Locale.ROOT)); if(d==null||!d.isActive()||d.getStartDate()==null||today.isBefore(d.getStartDate())||(d.getEndDate()!=null&&today.isAfter(d.getEndDate())))return DiscountApplicationResult.notApplicable(); BigDecimal whole=BigDecimal.ZERO; for(PricedCartItem i:items)whole=whole.add(i.getLineSubtotal()); if(d.getMinimumSubtotal()!=null&&whole.compareTo(d.getMinimumSubtotal())<0)return DiscountApplicationResult.notApplicable(); Set<Long> selected=new HashSet<>(); for(String c:d.getCategories()){try{Category cat=categoryService.getByCode(store,c);if(cat!=null)selected.add(cat.getId());}catch(Exception ignored){}} if(!d.getCategories().isEmpty()&&selected.isEmpty())return DiscountApplicationResult.notApplicable(); BigDecimal eligible=BigDecimal.ZERO; for(PricedCartItem i:items){if(i.getItem().getProduct()==null)continue; boolean ok=selected.isEmpty(); if(!ok)for(Category c:i.getItem().getProduct().getCategories())if(selected.contains(c.getId())||(c.getLineage()!=null&&selected.stream().anyMatch(x->c.getLineage().contains("/"+x+"/")))){ok=true;break;} if(ok)eligible=eligible.add(i.getLineSubtotal());} if(eligible.signum()==0)return DiscountApplicationResult.notApplicable(); BigDecimal amount=d.getType()==DiscountType.PERCENT?eligible.multiply(d.getValue()).divide(BigDecimal.valueOf(100),MathContext.DECIMAL128):d.getValue().min(eligible); amount=amount.max(BigDecimal.ZERO).setScale(2,RoundingMode.HALF_UP); return DiscountApplicationResult.applicable(d.getCode(),amount); }
+}
