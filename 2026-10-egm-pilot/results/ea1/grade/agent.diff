+package com.salesmanager.shop.store.controller.discount;
+import java.time.LocalDate; import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.*; import com.salesmanager.core.business.services.catalog.category.CategoryService; import com.salesmanager.core.business.services.discount.DiscountCodeService; import com.salesmanager.core.model.catalog.category.Category; import com.salesmanager.core.model.discount.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.discount.*; import com.salesmanager.shop.store.api.exception.*;
+@Service("discountCodeFacade") public class DiscountCodeFacadeImpl implements DiscountCodeFacade {
+ @Inject private DiscountCodeService service; @Inject private CategoryService categoryService;
+ private DiscountCode map(PersistableDiscountCode d,MerchantStore s){ if(d==null||d.getCode()==null||d.getCode().trim().isEmpty()||d.getCode().length()>100||d.getValue()==null||d.getValue().signum()<=0) throw new DiscountValidationException("Invalid discount code"); DiscountType type; try{type=DiscountType.valueOf(d.getType());}catch(Exception e){throw new DiscountValidationException("Invalid discount type");} if(type==DiscountType.PERCENT&&d.getValue().compareTo(java.math.BigDecimal.valueOf(100))>0) throw new DiscountValidationException("Percent must not exceed 100"); if(d.getMinimumSubtotal()!=null&&d.getMinimumSubtotal().signum()<0) throw new DiscountValidationException("Minimum subtotal must not be negative"); LocalDate start=d.getStartDate()==null?LocalDate.now():d.getStartDate(); if(d.getEndDate()!=null&&d.getEndDate().isBefore(start)) throw new DiscountValidationException("End date must not precede start date"); DiscountCode c=new DiscountCode(); c.setMerchantStore(s); c.setCode(d.getCode()); c.setType(type); c.setValue(d.getValue()); c.setMinimumSubtotal(d.getMinimumSubtotal()); c.setStartDate(start); c.setEndDate(d.getEndDate()); c.setActive(d.getActive()==null||d.getActive()); Set<String> cats=new HashSet<>(); if(d.getCategories()!=null) for(String x:d.getCategories()){if(x==null||x.trim().isEmpty()) throw new DiscountValidationException("Invalid category"); try{Category cat=categoryService.getByCode(s,x); if(cat==null) throw new Exception(); cats.add(x);}catch(Exception e){throw new DiscountValidationException("Unknown category: "+x);}} c.setCategories(cats); return c; }
+ private ReadableDiscountCode read(DiscountCode c){ReadableDiscountCode d=new ReadableDiscountCode();d.setId(c.getId());d.setCode(c.getCode());d.setType(c.getType().name());d.setValue(c.getValue());d.setMinimumSubtotal(c.getMinimumSubtotal());d.setStartDate(c.getStartDate());d.setEndDate(c.getEndDate());d.setActive(c.isActive());d.setCategories(c.getCategories());return d;}
+ public ReadableDiscountCode create(PersistableDiscountCode d,MerchantStore s){try{return read(service.create(map(d,s),s));}catch(DiscountCodeConflictException e){throw new DiscountConflictException(e.getMessage());}catch(ServiceException e){throw new DiscountValidationException(e.getMessage());}}
+ public List<ReadableDiscountCode> list(MerchantStore s){List<ReadableDiscountCode> r=new ArrayList<>();for(DiscountCode c:service.list(s))r.add(read(c));return r;}
+ public ReadableDiscountCode update(Long id,PersistableDiscountCode d,MerchantStore s){try{DiscountCode c=map(d,s);c.setId(id);return read(service.update(c,s));}catch(DiscountCodeNotFoundException e){throw new ResourceNotFoundException(e.getMessage());}catch(DiscountCodeConflictException e){throw new DiscountConflictException(e.getMessage());}catch(ServiceException e){throw new DiscountValidationException(e.getMessage());}}
+ public void delete(Long id,MerchantStore s){try{service.delete(id,s);}catch(DiscountCodeNotFoundException e){throw new ResourceNotFoundException(e.getMessage());}catch(ServiceException e){throw new DiscountValidationException(e.getMessage());}}
+}
