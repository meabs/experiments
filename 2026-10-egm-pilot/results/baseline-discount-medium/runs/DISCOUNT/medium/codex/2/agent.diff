+package com.salesmanager.core.business.services.discount;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDate;
+import java.util.List;
+import java.util.Objects;
+
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.discount.DiscountCodeRepository;
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.discount.DiscountCode;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service("discountCodeService")
+public class DiscountCodeServiceImpl extends SalesManagerEntityServiceImpl<Long, DiscountCode> implements DiscountCodeService {
+    private final DiscountCodeRepository repository;
+    @Inject private CategoryService categoryService;
+
+    @Inject
+    public DiscountCodeServiceImpl(DiscountCodeRepository repository) { super(repository); this.repository = repository; }
+
+    @Override public List<DiscountCode> listByStore(MerchantStore store) { return repository.findByMerchantStoreId(store.getId()); }
+    @Override public DiscountCode findByCode(MerchantStore store, String code) { return repository.findByMerchantStoreIdAndCodeIgnoreCase(store.getId(), code); }
+
+    @Override
+    public void validate(DiscountCode discount, MerchantStore store, Long id) throws ServiceException {
+        if (discount == null || discount.getCode() == null || discount.getCode().trim().isEmpty() || discount.getType() == null || discount.getValue() == null)
+            throw new ServiceException("code, type and value are required");
+        discount.setCode(discount.getCode().trim());
+        if (discount.getType() == DiscountType.PERCENT && (discount.getValue().signum() <= 0 || discount.getValue().compareTo(BigDecimal.valueOf(100)) > 0))
+            throw new ServiceException("percent value must be between 0 and 100");
+        if (discount.getType() == DiscountType.AMOUNT && discount.getValue().signum() <= 0) throw new ServiceException("amount must be positive");
+        if (discount.getStartDate() == null) discount.setStartDate(LocalDate.now());
+        if (discount.getEndDate() != null && discount.getEndDate().isBefore(discount.getStartDate())) throw new ServiceException("end date must not precede start date");
+        DiscountCode existing = findByCode(store, discount.getCode());
+        if (existing != null && !Objects.equals(existing.getId(), id)) throw new IllegalStateException("discount code already exists");
+        if (discount.getCategories() != null) for (String categoryCode : discount.getCategories()) {
+            Category category = categoryService.getByCode(store, categoryCode);
+            if (category == null) throw new ServiceException("unknown category: " + categoryCode);
+        }
+    }
+
+    @Override
+    public boolean applies(DiscountCode discount, ShoppingCart cart, BigDecimal subtotal, LocalDate today) {
+        if (discount == null || cart == null || !discount.isActive() || !Objects.equals(cart.getMerchantStore().getId(), discount.getMerchantStore().getId())) return false;
+        if (today.isBefore(discount.getStartDate()) || (discount.getEndDate() != null && today.isAfter(discount.getEndDate()))) return false;
+        if (discount.getMinimumSubtotal() != null && subtotal.compareTo(discount.getMinimumSubtotal()) < 0) return false;
+        return eligibleSubtotal(discount, cart).signum() > 0;
+    }
+
+    @Override
+    public BigDecimal calculateDiscount(DiscountCode discount, ShoppingCart cart, BigDecimal subtotal, LocalDate today) {
+        if (!applies(discount, cart, subtotal, today)) return BigDecimal.ZERO.setScale(2);
+        BigDecimal eligible = eligibleSubtotal(discount, cart);
+        BigDecimal result = discount.getType() == DiscountType.PERCENT ? eligible.multiply(discount.getValue()).divide(BigDecimal.valueOf(100), 8, RoundingMode.HALF_UP) : discount.getValue().min(eligible);
+        return result.setScale(2, RoundingMode.HALF_UP);
+    }
+
+    private BigDecimal eligibleSubtotal(DiscountCode discount, ShoppingCart cart) {
+        BigDecimal total = BigDecimal.ZERO;
+        for (ShoppingCartItem item : cart.getLineItems()) {
+            Product product = item.getProduct();
+            if (product != null && (discount.getCategories() == null || discount.getCategories().isEmpty() || product.getCategories().stream().anyMatch(c -> discount.getCategories().stream().anyMatch(code -> isInCategoryTree(c, code)))))
+                total = total.add(item.getItemPrice().multiply(BigDecimal.valueOf(item.getQuantity())));
+        }
+        return total;
+    }
+
+    private boolean isInCategoryTree(Category category, String code) {
+        Category current = category;
+        while (current != null) { if (code.equalsIgnoreCase(current.getCode())) return true; current = current.getParent(); }
+        return false;
+    }
+}
