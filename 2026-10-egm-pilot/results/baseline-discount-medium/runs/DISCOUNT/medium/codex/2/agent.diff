+import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.business.services.discount.DiscountCodeService; import com.salesmanager.core.model.discount.DiscountCode; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.discount.*; import com.salesmanager.shop.store.api.exception.RestApiException; import com.salesmanager.shop.store.api.exception.ConflictException; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/discounts")
+public class DiscountCodeApi {
+ @Inject private DiscountCodeService service;
+ @PostMapping @ResponseStatus(HttpStatus.CREATED) public ReadableDiscountCode create(@RequestBody PersistableDiscountCode r,@ApiIgnore MerchantStore s){return save(r,null,s);}
+ @GetMapping public List<ReadableDiscountCode> list(@ApiIgnore MerchantStore s){return service.listByStore(s).stream().map(this::read).collect(Collectors.toList());}
+ @PutMapping("/{id}") public ReadableDiscountCode update(@PathVariable Long id,@RequestBody PersistableDiscountCode r,@ApiIgnore MerchantStore s){return save(r,id,s);}
+ @DeleteMapping("/{id}") @ResponseStatus(HttpStatus.NO_CONTENT) public void delete(@PathVariable Long id,@ApiIgnore MerchantStore s){DiscountCode c=service.getById(id); if(c==null||!c.getMerchantStore().getId().equals(s.getId()))throw new RestApiException("discount not found"); try{service.delete(c);}catch(ServiceException e){throw new RestApiException(e);}}
+ private ReadableDiscountCode save(PersistableDiscountCode r,Long id,MerchantStore s){DiscountCode c=id==null?new DiscountCode():service.getById(id); if(c==null||(id!=null&&!c.getMerchantStore().getId().equals(s.getId())))throw new RestApiException("discount not found"); c.setMerchantStore(s);c.setCode(r.getCode());c.setType(r.getType());c.setValue(r.getValue());c.setMinimumSubtotal(r.getMinimumSubtotal());c.setStartDate(r.getStartDate());c.setEndDate(r.getEndDate());c.setCategories(r.getCategories()==null?null:r.getCategories().stream().collect(Collectors.toSet()));c.setActive(r.getActive()==null||r.getActive()); try{service.validate(c,s,id);service.save(c);return read(c);}catch(IllegalStateException e){throw new ConflictException(e.getMessage());}catch(ServiceException e){throw new RestApiException("400",e.getMessage());}}
+ private ReadableDiscountCode read(DiscountCode c){ReadableDiscountCode r=new ReadableDiscountCode();r.setId(c.getId());r.setCode(c.getCode());r.setType(c.getType());r.setValue(c.getValue());r.setMinimumSubtotal(c.getMinimumSubtotal());r.setStartDate(c.getStartDate());r.setEndDate(c.getEndDate());r.setCategories(c.getCategories().stream().collect(Collectors.toList()));r.setActive(c.isActive());return r;}
+}
