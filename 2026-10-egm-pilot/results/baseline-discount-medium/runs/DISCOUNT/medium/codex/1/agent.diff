+package com.salesmanager.core.business.services.discount;
+import java.math.*; import java.time.LocalDate; import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.business.repositories.discount.DiscountRepository; import com.salesmanager.core.business.services.catalog.category.CategoryService; import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl; import com.salesmanager.core.model.catalog.category.Category; import com.salesmanager.core.model.discount.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.shoppingcart.*;
+@Service("discountService") public class DiscountServiceImpl extends SalesManagerEntityServiceImpl<Long,Discount> implements DiscountService {
+ private final DiscountRepository repo; @Inject private CategoryService categoryService;
+ @Inject public DiscountServiceImpl(DiscountRepository r){super(r);repo=r;}
+ public List<Discount> listByStore(MerchantStore s){return repo.findByMerchantStoreId(s.getId());}
+ public Discount findByCode(MerchantStore s,String c){return c==null?null:repo.findByMerchantStoreIdAndCodeIgnoreCase(s.getId(),c);}
+ public void validate(Discount d, MerchantStore s) throws ServiceException { if(d.getCode()==null||d.getCode().trim().isEmpty()||d.getValue()==null||d.getType()==null) throw new ServiceException("code, type and value are required"); if(d.getType()==DiscountType.PERCENT&&(d.getValue().compareTo(BigDecimal.ZERO)<=0||d.getValue().compareTo(new BigDecimal("100"))>0)||d.getType()==DiscountType.AMOUNT&&d.getValue().compareTo(BigDecimal.ZERO)<=0) throw new ServiceException("invalid discount value"); if(d.getStartDate()==null)d.setStartDate(LocalDate.now()); if(d.getEndDate()!=null&&d.getEndDate().isBefore(d.getStartDate()))throw new ServiceException("endDate before startDate"); if(d.getCategories()!=null) for(String c:d.getCategories()) if(categoryService.getByCode(s,c)==null) throw new ServiceException("unknown category: "+c); Discount old=findByCode(s,d.getCode()); if(old!=null&&(d.getId()==null||!old.getId().equals(d.getId())))throw new IllegalStateException("discount code already exists"); d.setCode(d.getCode().trim()); d.setMerchantStore(s); }
+ public boolean applies(Discount d, ShoppingCart c){ if(d==null||!d.isActive()||c==null||c.getMerchantStore()==null||!c.getMerchantStore().getId().equals(d.getMerchantStore().getId()))return false; LocalDate n=LocalDate.now(); if(d.getStartDate()!=null&&n.isBefore(d.getStartDate())||d.getEndDate()!=null&&n.isAfter(d.getEndDate()))return false; BigDecimal sub=BigDecimal.ZERO, eligible=BigDecimal.ZERO; for(ShoppingCartItem i:c.getLineItems()){BigDecimal x=i.getSubTotal();sub=sub.add(x);if(eligible(i,d))eligible=eligible.add(x);} return (d.getMinimumSubtotal()==null||sub.compareTo(d.getMinimumSubtotal())>=0)&&eligible.signum()>0; }
+ private boolean eligible(ShoppingCartItem i,Discount d){if(d.getCategories()==null||d.getCategories().isEmpty())return true; for(Category c:i.getProduct().getCategories()) for(String wanted:d.getCategories()){Category current=c; while(current!=null){if(current.getCode().equalsIgnoreCase(wanted))return true; current=current.getParent();}} return false;}
+ public BigDecimal calculate(Discount d,ShoppingCart c){if(!applies(d,c))return BigDecimal.ZERO;BigDecimal e=BigDecimal.ZERO;for(ShoppingCartItem i:c.getLineItems())if(eligible(i,d))e=e.add(i.getSubTotal());BigDecimal x=d.getType()==DiscountType.PERCENT?e.multiply(d.getValue()).divide(new BigDecimal("100"),10,RoundingMode.HALF_UP):d.getValue();return x.min(e).setScale(2,RoundingMode.HALF_UP);}
+}
