+package com.salesmanager.shop.store.api.v1.discount;
+import java.util.*; import javax.inject.Inject; import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.business.services.discount.DiscountService; import com.salesmanager.core.model.discount.Discount; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.discount.PersistableDiscount; import com.salesmanager.shop.store.api.exception.RestApiException; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/discounts") public class DiscountApi {
+ @Inject private DiscountService service;
+ @PostMapping public ResponseEntity<PersistableDiscount> create(@RequestBody PersistableDiscount in,@ApiIgnore MerchantStore store){Discount d=toModel(in);save(d,store);in.setId(d.getId());return ResponseEntity.status(HttpStatus.CREATED).body(in);}
+ @GetMapping public List<PersistableDiscount> list(@ApiIgnore MerchantStore store){List<PersistableDiscount> out=new ArrayList<>();for(Discount d:service.listByStore(store))out.add(toDto(d));return out;}
+ @PutMapping("/{id}") public PersistableDiscount update(@PathVariable Long id,@RequestBody PersistableDiscount in,@ApiIgnore MerchantStore store){Discount d=service.getById(id);if(d==null||d.getMerchantStore()==null||!d.getMerchantStore().getId().equals(store.getId()))throw new RestApiException("404","discount not found");d=toModel(in);d.setId(id);save(d,store);in.setId(id);return in;}
+ @DeleteMapping("/{id}") @ResponseStatus(HttpStatus.NO_CONTENT) public void delete(@PathVariable Long id,@ApiIgnore MerchantStore store){Discount d=service.getById(id);if(d==null||d.getMerchantStore()==null||!d.getMerchantStore().getId().equals(store.getId()))throw new RestApiException("404","discount not found");try{service.delete(d);}catch(Exception e){throw new RestApiException("500",e.getMessage());}}
+ private void save(Discount d,MerchantStore s){try{service.validate(d,s);service.save(d);}catch(IllegalStateException e){throw new RestApiException("409",e.getMessage());}catch(Exception e){throw new RestApiException("400",e.getMessage());}}
+ private Discount toModel(PersistableDiscount x){Discount d=new Discount();d.setCode(x.getCode());d.setType(x.getType());d.setValue(x.getValue());d.setMinimumSubtotal(x.getMinimumSubtotal());d.setStartDate(x.getStartDate());d.setEndDate(x.getEndDate());d.setCategories(x.getCategories()==null?new HashSet<>():new HashSet<>(x.getCategories()));d.setActive(x.getActive()==null||x.getActive());return d;}
+ private PersistableDiscount toDto(Discount d){PersistableDiscount x=new PersistableDiscount();x.setId(d.getId());x.setCode(d.getCode());x.setType(d.getType());x.setValue(d.getValue());x.setMinimumSubtotal(d.getMinimumSubtotal());x.setStartDate(d.getStartDate());x.setEndDate(d.getEndDate());x.setCategories(new ArrayList<>(d.getCategories()));x.setActive(d.isActive());return x;}
+}
