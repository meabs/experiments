diff --git a/src/main/java/com/example/accounts/account/GoodwillCreditService.java b/src/main/java/com/example/accounts/account/GoodwillCreditService.java
new file mode 100644
index 0000000..85fb655
--- /dev/null
+++ b/src/main/java/com/example/accounts/account/GoodwillCreditService.java
@@ -0,0 +1,88 @@
+package com.example.accounts.account;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.ZoneOffset;
+
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.example.accounts.security.AccessPolicy;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.ConflictException;
+import com.example.accounts.web.ForbiddenException;
+import com.example.accounts.web.NotFoundException;
+
+@Service
+public class GoodwillCreditService {
+    private static final BigDecimal APPROVAL_LIMIT = new BigDecimal("100.00");
+
+    private final GoodwillCreditRepository credits;
+    private final AccountRepository accounts;
+    private final TransactionRepository transactions;
+    private final AccountService accountService;
+    private final AccessPolicy access;
+    private final CurrentUserProvider users;
+
+    public GoodwillCreditService(GoodwillCreditRepository credits, AccountRepository accounts,
+                                 TransactionRepository transactions, AccountService accountService,
+                                 AccessPolicy access, CurrentUserProvider users) {
+        this.credits = credits;
+        this.accounts = accounts;
+        this.transactions = transactions;
+        this.accountService = accountService;
+        this.access = access;
+        this.users = users;
+    }
+
+    @Transactional
+    public GoodwillCredit create(Long accountId, BigDecimal amount, String reason) {
+        CurrentUser user = users.current();
+        Account account = accountService.getVisible(accountId);
+        if (!access.isAssignedSupport(user, account) && !access.isTenantAdmin(user, account.getTenantId())) {
+            throw new ForbiddenException("Only assigned staff can issue a goodwill credit");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+        String trimmed = reason == null ? null : reason.trim();
+        if (trimmed == null || trimmed.length() < 1 || trimmed.length() > 500) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        GoodwillCredit.Status status = amount.compareTo(APPROVAL_LIMIT) > 0
+            ? GoodwillCredit.Status.PENDING : GoodwillCredit.Status.PAID;
+        GoodwillCredit credit = credits.save(new GoodwillCredit(accountId, amount, trimmed, user.id(), Instant.now(), status));
+        if (status == GoodwillCredit.Status.PAID) {
+            pay(account, credit);
+        }
+        return credit;
+    }
+
+    @Transactional
+    public GoodwillCredit approve(Long creditId) {
+        CurrentUser user = users.current();
+        GoodwillCredit credit = credits.findById(creditId).orElseThrow(() -> new NotFoundException("Goodwill credit not found"));
+        Account account = accounts.findById(credit.getAccountId()).orElseThrow(() -> new NotFoundException("Goodwill credit not found"));
+        if (!user.inTenant(account.getTenantId())) {
+            throw new NotFoundException("Goodwill credit not found");
+        }
+        if (credit.getStatus() != GoodwillCredit.Status.PENDING) {
+            throw new ConflictException("Goodwill credit is not pending");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+        pay(account, credit);
+        return credit;
+    }
+
+    private void pay(Account account, GoodwillCredit credit) {
+        account.setBalance(account.getBalance().add(credit.getAmount()));
+        accounts.save(account);
+        transactions.save(new Transaction(account.getId(), credit.getAmount(), "Goodwill credit", LocalDate.now(ZoneOffset.UTC)));
+        credit.setStatus(GoodwillCredit.Status.PAID);
+        credits.save(credit);
+    }
+}
