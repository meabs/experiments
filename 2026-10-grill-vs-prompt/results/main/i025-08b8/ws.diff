+    @Transactional
+    public Account changeDailyLimit(Long accountId, int dailyLimit) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Closed accounts cannot have their daily limit changed");
+        }
+        if (user.isAdmin() && access.isTenantAdmin(user, account.getTenantId())) {
+            account.setDailyLimit(dailyLimit);
+            return account;
+        }
+        if (user.isSupport() && access.isAssignedSupport(user, account) && dailyLimit <= account.getDailyLimit()) {
+            account.setDailyLimit(dailyLimit);
+            return account;
+        }
+        throw new ForbiddenException("You may not set this account's daily limit");
+    }
