+    @PutMapping("/{accountId}/daily-limit")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    public AccountView changeDailyLimit(@PathVariable Long accountId, @RequestBody DailyLimitRequest body) {
+        if (body == null || body.dailyLimit() == null || !body.dailyLimit().isNumber()) {
+            throw new IllegalArgumentException("Invalid dailyLimit");
+        }
+        BigDecimal value = body.dailyLimit().decimalValue();
+        if (value.signum() < 0 || value.stripTrailingZeros().scale() > 0
+            || value.compareTo(BigDecimal.valueOf(Integer.MAX_VALUE)) > 0) {
+            throw new IllegalArgumentException("Invalid dailyLimit");
+        }
+        return AccountView.of(service.changeDailyLimit(accountId, value.intValueExact()));
+    }
