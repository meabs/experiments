@@ -0,0 +1,58 @@
+package com.example.accounts.cases;
+
+import java.time.Instant;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotBlank;
+import jakarta.validation.constraints.Size;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.NotFoundException;
+
+/** Back-office operations on support cases. */
+@RestController
+@RequestMapping("/api/support/cases")
+public class SupportCaseController {
+
+    public record AssigneeUpdate(@NotBlank @Size(max = 200) String assigneeUserId) {
+    }
+
+    public record CaseView(String id, Long accountId, String subject, String status, String assigneeUserId,
+                           Instant openedAt) {
+        static CaseView of(SupportCase c) {
+            return new CaseView(c.getId(), c.getAccountId(), c.getSubject(), c.getStatus(), c.getAssigneeUserId(),
+                c.getOpenedAt());
+        }
+    }
+
+    private final SupportCaseRepository cases;
+    private final CurrentUserProvider users;
+
+    public SupportCaseController(SupportCaseRepository cases, CurrentUserProvider users) {
+        this.cases = cases;
+        this.users = users;
+    }
+
+    @PutMapping("/{caseId}/assignee")
+    @PreAuthorize("hasAnyRole('SUPPORT', 'ADMIN') && hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public CaseView assign(@PathVariable String caseId, @Valid @RequestBody AssigneeUpdate body) {
+        CurrentUser user = users.current();
+        SupportCase supportCase = cases.findByIdAndTenantId(caseId, user.tenantId())
+            .orElseThrow(() -> new NotFoundException("Case not found"));
+        if (!user.isAdmin() && !user.id().equals(supportCase.getAssigneeUserId())) {
+            throw new NotFoundException("Case not found");
+        }
+        supportCase.assignTo(body.assigneeUserId().trim());
+        return CaseView.of(cases.save(supportCase));
+    }
+}
