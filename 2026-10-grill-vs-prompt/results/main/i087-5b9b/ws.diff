+
+    @Transactional
+    public GoodwillCredit createGoodwillCredit(Long accountId, BigDecimal amount, String reason) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (!access.isAssignedSupport(user, account) && !access.isTenantAdmin(user, account.getTenantId())) {
+            throw new ForbiddenException("Only assigned support or a tenant admin can issue a goodwill credit");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Cannot credit a closed account");
+        }
+        BigDecimal normalizedAmount = amount.setScale(2);
+        String normalizedReason = reason.trim();
+        GoodwillCredit credit = new GoodwillCredit(account.getId(), normalizedAmount, normalizedReason, user.id(), Instant.now());
+        account.addToBalance(normalizedAmount);
+        transactions.save(new Transaction(account.getId(), normalizedAmount, "Goodwill credit", LocalDate.now()));
+        accounts.save(account);
+        return goodwillCredits.save(credit);
+    }
 }
diff --git a/src/main/java/com/example/accounts/account/GoodwillCredit.java b/src/main/java/com/example/accounts/account/GoodwillCredit.java
new file mode 100644
index 0000000..aba9663
--- /dev/null
+++ b/src/main/java/com/example/accounts/account/GoodwillCredit.java
@@ -0,0 +1,52 @@
+package com.example.accounts.account;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.GeneratedValue;
+import jakarta.persistence.GenerationType;
+import jakarta.persistence.Id;
+import jakarta.persistence.Table;
+
+@Entity
+@Table(name = "goodwill_credits")
+public class GoodwillCredit {
+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
+    private Long id;
+
+    @Column(nullable = false)
+    private Long accountId;
+
+    @Column(nullable = false, precision = 19, scale = 2)
+    private BigDecimal amount;
+
+    @Column(nullable = false, length = 500)
+    private String reason;
+
+    @Column(nullable = false)
+    private String createdBy;
+
+    @Column(nullable = false)
+    private Instant createdAt;
+
+    protected GoodwillCredit() { }
+
+    public GoodwillCredit(Long accountId, BigDecimal amount, String reason, String createdBy, Instant createdAt) {
+        this.accountId = accountId;
+        this.amount = amount;
+        this.reason = reason;
+        this.createdBy = createdBy;
+        this.createdAt = createdAt;
+    }
+
+    public Long getId() { return id; }
+    public Long getAccountId() { return accountId; }
+    public BigDecimal getAmount() { return amount; }
+    public String getReason() { return reason; }
+    public String getCreatedBy() { return createdBy; }
+    public Instant getCreatedAt() { return createdAt; }
+}
