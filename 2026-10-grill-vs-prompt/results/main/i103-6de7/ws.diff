+    /** Reassign a case within the caller's tenant. Admins may reassign any case; the current assignee may hand it over. */
+    @PutMapping("/support/cases/{caseId}/assignee")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public AssignedCase reassign(@PathVariable String caseId, @Valid @RequestBody ReassignCase body) {
+        CurrentUser user = users.current();
+        SupportCase c = cases.findById(caseId)
+            .filter(found -> user.inTenant(found.getTenantId()))
+            .orElseThrow(() -> new NotFoundException("Case not found"));
+
+        boolean allowed = user.isAdmin() || (user.isSupport() && user.id().equals(c.getAssigneeUserId()));
+        if (!allowed) {
+            throw new NotFoundException("Case not found");
+        }
+        String assignee = body.assigneeUserId().trim();
+        if (assignee.isEmpty() || !assignments.existsByTenantIdAndSupportUserIdAndAccountId(c.getTenantId(), assignee,
+            c.getAccountId())) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        c.assignTo(assignee);
+        return AssignedCase.of(cases.save(c));
+    }
