+    @PutMapping("/{accountId}/daily-limit")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    public AccountView changeDailyLimit(@PathVariable Long accountId, @RequestBody JsonNode body) {
+        if (body == null || !body.isObject()) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        JsonNode value = body.get("dailyLimit");
+        if (value == null || !value.isIntegralNumber() || !value.canConvertToInt()
+            || value.intValue() < 0 || value.intValue() > 5000) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        return AccountView.of(service.changeDailyLimit(accountId, value.intValue()));
+    }
