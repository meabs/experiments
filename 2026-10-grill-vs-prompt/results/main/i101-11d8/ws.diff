+
+    @Transactional
+    public Account changeDailyLimit(Long accountId, int newLimit) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        boolean admin = access.isTenantAdmin(user, account.getTenantId());
+        boolean support = access.isAssignedSupport(user, account);
+        if (!admin && !support) {
+            throw new ForbiddenException("Only an account admin or assigned support can change the daily limit");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+        int oldLimit = account.getDailyLimit();
+        if (support && newLimit >= oldLimit) {
+            throw new ForbiddenException("Support can only lower the daily limit");
+        }
+        if (newLimit != oldLimit) {
+            account.setDailyLimit(newLimit);
+            notes.save(new AccountNote(account.getId(), user.id(),
+                "Daily limit changed from " + oldLimit + " to " + newLimit + ".", true, Instant.now()));
+        }
+        return account;
+    }
 }
