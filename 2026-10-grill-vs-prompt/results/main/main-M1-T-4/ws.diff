+    @PutMapping("/{accountId}/daily-limit")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    public AccountView updateDailyLimit(@PathVariable Long accountId, @Valid @RequestBody DailyLimitRequest request) {
+        CurrentUser user = users.current();
+        Account account = service.getVisible(accountId);
+        if (!access.isAssignedSupport(user, account) && !access.isTenantAdmin(user, account.getTenantId())) {
+            throw new ForbiddenException("Only staff can change an account's daily limit");
+        }
+        if (request.dailyLimit().compareTo(BigDecimal.valueOf(Integer.MAX_VALUE)) > 0) {
+            throw new IllegalArgumentException("Daily limit is too large");
+        }
+        int dailyLimit = request.dailyLimit().toBigIntegerExact().intValue();
+        return AccountView.of(service.updateDailyLimit(account, dailyLimit));
+    }
