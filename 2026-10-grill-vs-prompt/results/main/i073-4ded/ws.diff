+            throw new IllegalArgumentException("Invalid request");
+        }
+        CurrentUser user = users.current();
+        Account account = service.getVisible(accountId);
+        if (!access.isAssignedSupport(user, account) && !access.isTenantAdmin(user, account.getTenantId())) {
+            throw new ForbiddenException("Only assigned support staff or an admin can freeze an account");
+        }
+        if (account.getStatus() != Account.Status.OPEN) {
+            throw new ConflictException("Only open accounts can be frozen");
+        }
+        account.setStatus(Account.Status.FROZEN);
+        account.setFreezeReason(reason);
+        return AccountView.of(account);
+    }
