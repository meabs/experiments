 package com.example.accounts.account;
 
 import java.util.List;
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.time.ZoneOffset;
 
 import org.springframework.stereotype.Service;
 import org.springframework.transaction.annotation.Transactional;
@@ -19,19 +22,40 @@ public class AccountService {
     private final CustomerRepository customers;
     private final SupportAssignmentRepository assignments;
     private final TransactionRepository transactions;
+    private final GoodwillCreditRepository goodwillCredits;
     private final AccessPolicy access;
     private final CurrentUserProvider users;
 
     public AccountService(AccountRepository accounts, CustomerRepository customers, SupportAssignmentRepository assignments,
-                          TransactionRepository transactions, AccessPolicy access, CurrentUserProvider users) {
+                          TransactionRepository transactions, GoodwillCreditRepository goodwillCredits,
+                          AccessPolicy access, CurrentUserProvider users) {
         this.accounts = accounts;
         this.customers = customers;
         this.assignments = assignments;
         this.transactions = transactions;
+        this.goodwillCredits = goodwillCredits;
         this.access = access;
         this.users = users;
     }
 
+    @Transactional
+    public GoodwillCredit addGoodwillCredit(Long accountId, BigDecimal amount, String reason, CurrentUser user) {
+        Account account = accounts.findByIdForUpdate(accountId)
+            .filter(a -> access.isTenantAdmin(user, a.getTenantId()) || access.isAssignedSupport(user, a))
+            .orElseThrow(() -> new NotFoundException("Account not found"));
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new com.example.accounts.web.ConflictException("Account is closed");
+        }
+        Instant now = Instant.now();
+        BigDecimal normalized = amount.setScale(2);
+        GoodwillCredit credit = goodwillCredits.save(
+            new GoodwillCredit(account.getId(), normalized, reason, user.id(), now));
+        account.addToBalance(normalized);
+        transactions.save(new Transaction(account.getId(), normalized, "Goodwill credit",
+            now.atZone(ZoneOffset.UTC).toLocalDate()));
+        return credit;
+    }
+
