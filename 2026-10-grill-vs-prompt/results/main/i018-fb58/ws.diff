+
+    @Transactional
+    public Account updateDailyLimit(Long accountId, BigDecimal requestedLimit) {
+        if (requestedLimit == null || requestedLimit.stripTrailingZeros().scale() > 0) {
+            throw new IllegalArgumentException("Daily limit must be a whole number");
+        }
+        final int newLimit;
+        try {
+            newLimit = requestedLimit.intValueExact();
+        } catch (ArithmeticException e) {
+            throw new IllegalArgumentException("Daily limit is out of range", e);
+        }
+
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId); // 404 unless the caller may see it
+        if (user.isAdmin() && user.inTenant(account.getTenantId())) {
+            account.setDailyLimit(newLimit);
+            return account;
+        }
+        if (access.isAssignedSupport(user, account)) {
+            if (newLimit > account.getDailyLimit()) {
+                throw new ForbiddenException("Support users can only lower a daily limit");
+            }
+            account.setDailyLimit(newLimit);
+            return account;
+        }
+        throw new ForbiddenException("Only bank staff can change a daily limit");
+    }
 }
