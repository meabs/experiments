@@ -0,0 +1,70 @@
+package com.example.accounts.cases;
+
+import java.time.Instant;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotBlank;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.ConflictException;
+import com.example.accounts.web.ForbiddenException;
+import com.example.accounts.web.NotFoundException;
+
+@RestController
+@RequestMapping("/api/support/cases")
+public class SupportCaseCloseController {
+
+    public record CloseCase(@NotBlank String resolution) {
+    }
+
+    private final SupportCaseRepository cases;
+    private final CaseCommentRepository comments;
+    private final CurrentUserProvider users;
+
+    public SupportCaseCloseController(SupportCaseRepository cases, CaseCommentRepository comments,
+                                      CurrentUserProvider users) {
+        this.cases = cases;
+        this.comments = comments;
+        this.users = users;
+    }
+
+    @PostMapping("/{caseId}/close")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write') and (hasRole('SUPPORT') or hasRole('ADMIN'))")
+    @ResponseStatus(HttpStatus.OK)
+    @Transactional
+    public CaseController.CaseSummary close(@PathVariable String caseId, @Valid @RequestBody CloseCase body) {
+        CurrentUser user = users.current();
+        SupportCase supportCase = cases.findById(caseId)
+            .filter(c -> user.inTenant(c.getTenantId()))
+            .orElseThrow(() -> new NotFoundException("Case not found"));
+
+        if (user.isSupport() && !user.isAdmin() && !user.id().equals(supportCase.getAssigneeUserId())) {
+            throw new ForbiddenException("Only the assigned support user can close this case");
+        }
+        if (!user.isSupport() && !user.isAdmin()) {
+            throw new ForbiddenException("Only support users and admins can close cases");
+        }
+        if (!"OPEN".equals(supportCase.getStatus())) {
+            throw new ConflictException("Case is not open");
+        }
+
+        String resolution = body.resolution().trim();
+        if (resolution.length() < 1 || resolution.length() > 2000) {
+            throw new IllegalArgumentException("Invalid resolution");
+        }
+        supportCase.close();
+        comments.save(new CaseComment(caseId, user.id(), resolution, false, Instant.now()));
+        return CaseController.CaseSummary.of(supportCase);
+    }
+}
