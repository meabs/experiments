+
+    @Transactional
+    public Account changeDailyLimit(Long accountId, BigDecimal proposedLimit) {
+        Account account = getVisible(accountId);
+        CurrentUser user = users.current();
+        boolean admin = access.isTenantAdmin(user, account.getTenantId());
+        boolean support = access.isAssignedSupport(user, account);
+        if (!admin && !support) {
+            throw new ForbiddenException("Only an admin or assigned support user can change the daily limit");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+
+        int limit;
+        try {
+            limit = proposedLimit.intValueExact();
+        } catch (ArithmeticException e) {
+            throw new IllegalArgumentException("Invalid daily limit", e);
+        }
+        if (support && limit > account.getDailyLimit()) {
+            throw new ForbiddenException("Assigned support users may only lower the daily limit");
+        }
+        account.setDailyLimit(limit);
+        return account;
+    }
 }
