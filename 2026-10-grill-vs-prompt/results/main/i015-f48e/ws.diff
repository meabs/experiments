+package com.example.accounts.cases;
+
+import java.time.Instant;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotBlank;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.account.SupportAssignmentRepository;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.NotFoundException;
+
+/** Back-office operations on support cases. */
+@RestController
+@RequestMapping("/api/support/cases")
+public class SupportCaseController {
+
+    public record ReassignCase(@NotBlank String assigneeUserId) {
+    }
+
+    public record CaseView(String id, Long accountId, String subject, String status, String assigneeUserId,
+                           Instant openedAt) {
+        static CaseView of(SupportCase c) {
+            return new CaseView(c.getId(), c.getAccountId(), c.getSubject(), c.getStatus(), c.getAssigneeUserId(),
+                c.getOpenedAt());
+        }
+    }
+
+    private final SupportCaseRepository cases;
+    private final SupportAssignmentRepository assignments;
+    private final CurrentUserProvider users;
+
+    public SupportCaseController(SupportCaseRepository cases, SupportAssignmentRepository assignments,
+                                 CurrentUserProvider users) {
+        this.cases = cases;
+        this.assignments = assignments;
+        this.users = users;
+    }
+
+    /** Admins may reassign any case in their tenant; a support user may hand over their own cases. */
+    @PutMapping("/{caseId}/assignee")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public CaseView reassign(@PathVariable String caseId, @Valid @RequestBody ReassignCase body) {
+        CurrentUser user = users.current();
+        SupportCase supportCase = cases.findById(caseId)
+            .filter(c -> canSeeForReassignment(user, c))
+            .orElseThrow(() -> new NotFoundException("Case not found"));
+
+        if (!assignments.existsByTenantIdAndSupportUserIdAndAccountId(supportCase.getTenantId(), body.assigneeUserId(),
+            supportCase.getAccountId())) {
+            throw new IllegalArgumentException("Assignee is not assigned to the case account");
+        }
+
+        supportCase.assignTo(body.assigneeUserId());
+        return CaseView.of(supportCase);
+    }
+
+    private boolean canSeeForReassignment(CurrentUser user, SupportCase supportCase) {
+        if (!user.inTenant(supportCase.getTenantId())) {
+            return false;
+        }
+        return user.isAdmin() || (user.isSupport() && user.id().equals(supportCase.getAssigneeUserId()));
+    }
+}
