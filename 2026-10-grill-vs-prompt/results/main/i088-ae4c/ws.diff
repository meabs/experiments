+    /** Admins may reassign any case in their tenant; the current assignee may hand it over. */
+    @PutMapping("/support/cases/{caseId}/assignee")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write') and (hasRole('ADMIN') or hasRole('SUPPORT'))")
+    @Transactional
+    public AssignedCase reassign(@PathVariable String caseId, @Valid @RequestBody AssigneeChange body) {
+        CurrentUser user = users.current();
+        SupportCase supportCase = cases.findById(caseId)
+            .filter(c -> user.inTenant(c.getTenantId()))
+            .orElseThrow(() -> new NotFoundException("Case not found"));
+
+        if (!user.isAdmin() && !user.id().equals(supportCase.getAssigneeUserId())) {
+            throw new NotFoundException("Case not found");
+        }
+
+        String assigneeUserId = body.assigneeUserId().trim();
+        if (assigneeUserId.isEmpty() || !assignments.existsByTenantIdAndSupportUserIdAndAccountId(
+                supportCase.getTenantId(), assigneeUserId, supportCase.getAccountId())) {
+            throw new IllegalArgumentException("Invalid assignee");
+        }
+
+        supportCase.setAssigneeUserId(assigneeUserId);
+        return AssignedCase.of(cases.save(supportCase));
+    }
