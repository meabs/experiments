+package com.example.accounts.cases;
+
+import java.time.Instant;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotBlank;
+import jakarta.validation.constraints.Size;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.NotFoundException;
+
+/** Back-office operations on support cases. */
+@RestController
+@RequestMapping("/api/support/cases")
+public class SupportCaseController {
+
+    public record AssigneeChange(@NotBlank @Size(max = 200) String assigneeUserId) {
+    }
+
+    public record SupportCaseView(String id, Long accountId, String subject, String status, String assigneeUserId,
+                                  Instant openedAt) {
+        static SupportCaseView of(SupportCase c) {
+            return new SupportCaseView(c.getId(), c.getAccountId(), c.getSubject(), c.getStatus(),
+                c.getAssigneeUserId(), c.getOpenedAt());
+        }
+    }
+
+    private final SupportCaseRepository cases;
+    private final CurrentUserProvider users;
+
+    public SupportCaseController(SupportCaseRepository cases, CurrentUserProvider users) {
+        this.cases = cases;
+        this.users = users;
+    }
+
+    /** Staff reassign a case within their own tenant. Customers cannot access the support endpoint. */
+    @PutMapping("/{caseId}/assignee")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write') and (hasRole('SUPPORT') or hasRole('ADMIN'))")
+    @Transactional
+    public SupportCaseView reassign(@PathVariable String caseId, @Valid @RequestBody AssigneeChange body) {
+        CurrentUser user = users.current();
+        SupportCase c = cases.findById(caseId)
+            .filter(found -> user.inTenant(found.getTenantId()))
+            .orElseThrow(() -> new NotFoundException("Case not found"));
+
+        // A support user can only operate on cases already assigned to them; admins can operate on all cases in-tenant.
+        if (!user.isAdmin() && (!user.isSupport() || !user.id().equals(c.getAssigneeUserId()))) {
+            throw new NotFoundException("Case not found");
+        }
+        c.setAssigneeUserId(body.assigneeUserId().trim());
+        return SupportCaseView.of(cases.save(c));
+    }
+}
