+    /** Changes an account limit: tenant admins may set any value; assigned support may only lower it. */
+    @Transactional
+    public Account updateDailyLimit(Long accountId, int dailyLimit) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (access.isTenantAdmin(user, account.getTenantId())) {
+            account.setDailyLimit(dailyLimit);
+            return account;
+        }
+        if (access.isAssignedSupport(user, account) && dailyLimit <= account.getDailyLimit()) {
+            account.setDailyLimit(dailyLimit);
+            return account;
+        }
+        throw new ForbiddenException("Only an admin or assigned support user may change this account's daily limit");
+    }
