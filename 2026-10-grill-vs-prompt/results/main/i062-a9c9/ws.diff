+    @PutMapping("/{accountId}/daily-limit")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    public AccountView updateDailyLimit(@PathVariable Long accountId, @Valid @RequestBody DailyLimitRequest request) {
+        if (request.dailyLimit().stripTrailingZeros().scale() > 0) {
+            throw new IllegalArgumentException("dailyLimit must be a whole number");
+        }
+        final int dailyLimit;
+        try {
+            dailyLimit = request.dailyLimit().intValueExact();
+        } catch (ArithmeticException e) {
+            throw new IllegalArgumentException("dailyLimit is out of range", e);
+        }
+        return AccountView.of(service.updateDailyLimit(accountId, dailyLimit));
+    }
