+
+    @Transactional
+    public Account changeDailyLimit(Long accountId, int dailyLimit) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Closed accounts cannot have their daily limit changed");
+        }
+        if (access.isTenantAdmin(user, account.getTenantId())) {
+            account.setDailyLimit(dailyLimit);
+            return account;
+        }
+        if (!access.isAssignedSupport(user, account)) {
+            throw new ForbiddenException("Only assigned support or an admin can change an account's daily limit");
+        }
+        if (dailyLimit > account.getDailyLimit()) {
+            throw new ForbiddenException("Support users can only lower an account's daily limit");
+        }
+        account.setDailyLimit(dailyLimit);
+        return account;
+    }
