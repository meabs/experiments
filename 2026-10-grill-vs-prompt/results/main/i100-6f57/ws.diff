+    public record DailyLimitRequest(BigDecimal dailyLimit) {
+        int value() {
+            if (dailyLimit == null || dailyLimit.signum() < 0) {
+                throw new IllegalArgumentException("dailyLimit must be a non-negative whole number");
+            }
+            BigInteger whole;
+            try {
+                whole = dailyLimit.toBigIntegerExact();
+            } catch (ArithmeticException e) {
+                throw new IllegalArgumentException("dailyLimit must be a non-negative whole number", e);
+            }
+            if (whole.compareTo(BigInteger.valueOf(Integer.MAX_VALUE)) > 0) {
+                throw new IllegalArgumentException("dailyLimit is too large");
+            }
+            return whole.intValue();
+        }
+    }
