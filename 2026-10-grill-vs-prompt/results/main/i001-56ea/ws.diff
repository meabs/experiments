+
+    @Transactional
+    public Account changeDailyLimit(Long accountId, BigDecimal requestedLimit) {
+        Account account = getVisible(accountId);
+        CurrentUser user = users.current();
+        int newLimit = toDailyLimit(requestedLimit);
+
+        boolean admin = access.isTenantAdmin(user, account.getTenantId());
+        boolean assignedSupport = access.isAssignedSupport(user, account);
+        if (!admin && !assignedSupport) {
+            throw new ForbiddenException("Only assigned support or a bank admin can change the daily limit");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+        if (admin) {
+            account.setDailyLimit(newLimit);
+            return account;
+        }
+        if (newLimit > account.getDailyLimit()) {
+            throw new ForbiddenException("Assigned support can only lower the daily limit");
+        }
+        account.setDailyLimit(newLimit);
+        return account;
+    }
+
+    private static int toDailyLimit(BigDecimal value) {
+        try {
+            if (value.signum() < 0) {
+                throw new IllegalArgumentException("Invalid daily limit");
+            }
+            return value.toBigIntegerExact().intValueExact();
+        } catch (ArithmeticException e) {
+            throw new IllegalArgumentException("Invalid daily limit", e);
+        }
+    }
 }
