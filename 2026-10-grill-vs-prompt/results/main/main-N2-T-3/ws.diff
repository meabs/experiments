+    /** An approver approves a pending request in their own tenant and closes the associated account. */
+    @PostMapping("/api/closure-requests/{requestId}/approve")
+    @PreAuthorize("hasRole('APPROVER') and hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public ClosureView approve(@PathVariable Long requestId) {
+        CurrentUser user = users.current();
+        ClosureRequest request = requests.findById(requestId)
+            .filter(r -> user.tenantId() != null && user.tenantId().equals(r.getTenantId()))
+            .orElseThrow(() -> new NotFoundException("Closure request not found"));
+        if (request.getStatus() != ClosureRequest.Status.PENDING) {
+            throw new ConflictException("Closure request is not pending");
+        }
+        if (user.id().equals(request.getRequestedBy())) {
+            throw new ForbiddenException("An approver cannot approve their own closure request");
+        }
+
+        Account account = accounts.getInTenant(request.getAccountId(), user.tenantId());
+        account.setStatus(Account.Status.CLOSED);
+        request.setStatus(ClosureRequest.Status.APPROVED);
+        request.setDecidedBy(user.id());
+        request.setDecidedAt(Instant.now());
+        return ClosureView.of(requests.save(request));
+    }
