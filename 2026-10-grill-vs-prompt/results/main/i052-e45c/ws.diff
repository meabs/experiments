@@ -10,6 +10,8 @@ import com.example.accounts.security.AccessPolicy;
 import com.example.accounts.security.CurrentUser;
 import com.example.accounts.security.CurrentUserProvider;
 import com.example.accounts.web.NotFoundException;
+import com.example.accounts.web.ConflictException;
+import com.example.accounts.web.ForbiddenException;
 
 @Service
 @Transactional(readOnly = true)
@@ -66,4 +68,23 @@ public class AccountService {
     public List<Transaction> transactions(Long accountId) {
         return transactions.findByAccountIdOrderByBookedOnDescIdDesc(getVisible(accountId).getId());
     }
+
+    @Transactional
+    public Account changeDailyLimit(Long accountId, int dailyLimit) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        boolean admin = access.isTenantAdmin(user, account.getTenantId());
+        boolean assignedSupport = access.isAssignedSupport(user, account);
+        if (!admin && !assignedSupport) {
+            throw new ForbiddenException("Only an account bank admin or assigned support user can change the daily limit");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Cannot change the limit of a closed account");
+        }
+        if (assignedSupport && !admin && dailyLimit > account.getDailyLimit()) {
+            throw new ForbiddenException("Support users may not raise the daily limit");
+        }
+        account.setDailyLimit(dailyLimit);
+        return accounts.save(account);
+    }
 }
