@@ -0,0 +1,56 @@
+package com.example.accounts.cases;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotBlank;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.account.SupportAssignmentRepository;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.NotFoundException;
+
+/** Back-office operations on support cases. */
+@RestController
+public class SupportCaseController {
+
+    public record AssigneeRequest(@NotBlank String assigneeUserId) {
+    }
+
+    private final SupportCaseRepository cases;
+    private final SupportAssignmentRepository assignments;
+    private final CurrentUserProvider users;
+
+    public SupportCaseController(SupportCaseRepository cases, SupportAssignmentRepository assignments,
+                                 CurrentUserProvider users) {
+        this.cases = cases;
+        this.assignments = assignments;
+        this.users = users;
+    }
+
+    /** Support staff may reassign their own cases; tenant admins may reassign any case in their tenant. */
+    @PutMapping("/api/support/cases/{caseId}/assignee")
+    @PreAuthorize("hasAnyRole('SUPPORT', 'ADMIN') and hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public CaseController.AssignedCase reassign(@PathVariable String caseId,
+                                                @Valid @RequestBody AssigneeRequest body) {
+        CurrentUser user = users.current();
+        SupportCase supportCase = cases.findById(caseId)
+            .filter(c -> user.inTenant(c.getTenantId()))
+            .filter(c -> user.isAdmin() || user.id().equals(c.getAssigneeUserId()))
+            .orElseThrow(() -> new NotFoundException("Case not found"));
+
+        if (!assignments.existsByTenantIdAndSupportUserIdAndAccountId(
+                supportCase.getTenantId(), body.assigneeUserId(), supportCase.getAccountId())) {
+            throw new IllegalArgumentException("Assignee is not assigned to the case's account");
+        }
+
+        supportCase.setAssigneeUserId(body.assigneeUserId());
+        return CaseController.AssignedCase.of(supportCase);
+    }
+}
