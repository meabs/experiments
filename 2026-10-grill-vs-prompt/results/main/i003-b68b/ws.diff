+
+    @Transactional
+    public Account updateDailyLimit(Long accountId, int dailyLimit) {
+        CurrentUser user = users.current();
+        Account account = accounts.findLockedById(accountId)
+            .filter(a -> access.canViewAccount(user, a))
+            .orElseThrow(() -> new NotFoundException("Account not found"));
+
+        if (access.isTenantAdmin(user, account.getTenantId())) {
+            account.setDailyLimit(dailyLimit);
+            return account;
+        }
+        if (access.isAssignedSupport(user, account) && dailyLimit < account.getDailyLimit()) {
+            account.setDailyLimit(dailyLimit);
+            return account;
+        }
+        throw new ForbiddenException("Only a bank admin can raise an account's daily limit");
+    }
 }
