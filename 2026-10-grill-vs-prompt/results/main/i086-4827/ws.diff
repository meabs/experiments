+
+    /** Approve a pending closure request and close its account atomically. */
+    @PostMapping("/api/closure-requests/{requestId}/approve")
+    @PreAuthorize("hasRole('APPROVER') and hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public ClosureView approve(@PathVariable Long requestId) {
+        CurrentUser user = users.current();
+        ClosureRequest request = requests.findByIdAndTenantId(requestId, user.tenantId())
+            .orElseThrow(() -> new NotFoundException("Closure request not found"));
+
+        if (request.getStatus() != ClosureRequest.Status.PENDING) {
+            throw new ConflictException("Closure request is already decided");
+        }
+        if (request.getRequestedBy().equals(user.id())) {
+            throw new ForbiddenException("An approver cannot approve their own closure request");
+        }
+
+        Account account = accountRepository.findById(request.getAccountId())
+            .filter(a -> user.inTenant(a.getTenantId()) && request.getTenantId().equals(a.getTenantId()))
+            .orElseThrow(() -> new NotFoundException("Account not found"));
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is already closed");
+        }
+
+        request.setStatus(ClosureRequest.Status.APPROVED);
+        request.setDecidedBy(user.id());
+        request.setDecidedAt(Instant.now());
+        account.setStatus(Account.Status.CLOSED);
+        return ClosureView.of(request);
+    }
 }
