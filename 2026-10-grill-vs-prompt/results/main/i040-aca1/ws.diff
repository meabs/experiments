     public List<Transaction> transactions(Long accountId) {
         return transactions.findByAccountIdOrderByBookedOnDescIdDesc(getVisible(accountId).getId());
     }
+
+    @Transactional
+    public Account updateDailyLimit(Long accountId, int dailyLimit) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (access.isTenantAdmin(user, account.getTenantId())) {
+            account.setDailyLimit(dailyLimit);
+            return account;
+        }
+        if (access.isAssignedSupport(user, account)) {
+            if (dailyLimit > account.getDailyLimit()) {
+                throw new ForbiddenException("Support users may only lower an account's daily limit");
+            }
+            account.setDailyLimit(dailyLimit);
+            return account;
+        }
+        throw new ForbiddenException("Only bank admins or assigned support users may change the daily limit");
+    }
 }
