+    @PutMapping("/{accountId}/daily-limit")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public AccountView updateDailyLimit(@PathVariable Long accountId, @RequestBody DailyLimitRequest body) {
+        if (body == null || body.dailyLimit() == null || !body.dailyLimit().isNumber()) {
+            throw new IllegalArgumentException("dailyLimit must be a number");
+        }
+        BigDecimal value = body.dailyLimit().decimalValue();
+        if (value.signum() < 0 || value.stripTrailingZeros().scale() > 0) {
+            throw new IllegalArgumentException("dailyLimit must be a non-negative whole number");
+        }
+        final int limit;
+        try {
+            limit = value.intValueExact();
+        } catch (ArithmeticException e) {
+            throw new IllegalArgumentException("dailyLimit is out of range", e);
+        }
+        if (limit > 5000) {
+            throw new IllegalArgumentException("dailyLimit exceeds the maximum");
+        }
+        return AccountView.of(service.updateDailyLimit(accountId, limit));
+    }
