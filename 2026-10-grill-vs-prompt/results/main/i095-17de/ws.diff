+    @PutMapping("/{accountId}/daily-limit")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    public AccountView changeDailyLimit(@PathVariable Long accountId, @RequestBody DailyLimitRequest request) {
+        if (request == null || request.dailyLimit() == null) {
+            throw new IllegalArgumentException("Invalid daily limit");
+        }
+        BigDecimal limit = request.dailyLimit();
+        try {
+            int value = limit.intValueExact();
+            if (value < 0 || value > 5000) {
+                throw new IllegalArgumentException("Invalid daily limit");
+            }
+            return AccountView.of(service.changeDailyLimit(accountId, value));
+        } catch (ArithmeticException e) {
+            throw new IllegalArgumentException("Invalid daily limit", e);
+        }
+    }
