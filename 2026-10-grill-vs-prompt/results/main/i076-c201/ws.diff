+    @Transactional
+    public GoodwillCredit createGoodwillCredit(Long accountId, BigDecimal amount, String reason) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (!access.isAssignedSupport(user, account) && !access.isTenantAdmin(user, account.getTenantId())) {
+            throw new ForbiddenException("Only assigned support users or tenant admins can create goodwill credits");
+        }
+        if (account.getStatus() != Account.Status.OPEN) {
+            throw new ConflictException("Account is closed");
+        }
+        Instant now = Instant.now();
+        GoodwillCredit credit = new GoodwillCredit(UUID.randomUUID().toString(), account.getId(), amount, reason,
+            user.id(), now);
+        account.credit(amount);
+        transactions.save(new Transaction(account.getId(), amount, "Goodwill credit", LocalDate.now()));
+        return credits.save(credit);
+    }
 }
diff --git a/src/main/java/com/example/accounts/account/GoodwillCredit.java b/src/main/java/com/example/accounts/account/GoodwillCredit.java
new file mode 100644
index 0000000..1f1a4e4
--- /dev/null
