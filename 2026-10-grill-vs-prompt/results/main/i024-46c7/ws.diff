diff --git a/src/main/java/com/example/accounts/cases/SupportCaseController.java b/src/main/java/com/example/accounts/cases/SupportCaseController.java
new file mode 100644
index 0000000..0f422e9
--- /dev/null
+++ b/src/main/java/com/example/accounts/cases/SupportCaseController.java
@@ -0,0 +1,92 @@
+package com.example.accounts.cases;
+
+import java.time.Instant;
+
+import jakarta.validation.Valid;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.account.SupportAssignmentRepository;
+import com.example.accounts.customer.CustomerRepository;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.ForbiddenException;
+import com.example.accounts.web.NotFoundException;
+
+/** Back-office operations on support cases. */
+@RestController
+@RequestMapping("/api/support/cases")
+public class SupportCaseController {
+
+    public record AssigneeChange(String assigneeUserId) {
+    }
+
+    public record CaseResponse(String id, Long accountId, String subject, String status, String assigneeUserId,
+                               Instant openedAt) {
+        static CaseResponse of(SupportCase c) {
+            return new CaseResponse(c.getId(), c.getAccountId(), c.getSubject(), c.getStatus(),
+                c.getAssigneeUserId(), c.getOpenedAt());
+        }
+    }
+
+    private final SupportCaseRepository cases;
+    private final SupportAssignmentRepository assignments;
+    private final CustomerRepository customers;
+    private final CurrentUserProvider users;
+
+    public SupportCaseController(SupportCaseRepository cases, SupportAssignmentRepository assignments,
+                                 CustomerRepository customers, CurrentUserProvider users) {
+        this.cases = cases;
+        this.assignments = assignments;
+        this.customers = customers;
+        this.users = users;
+    }
+
+    @PutMapping("/{caseId}/assignee")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @ResponseStatus(HttpStatus.OK)
+    @Transactional
+    public CaseResponse reassign(@PathVariable String caseId, @Valid @RequestBody AssigneeChange body) {
+        CurrentUser user = users.current();
+        SupportCase supportCase = cases.findById(caseId)
+            .filter(c -> user.inTenant(c.getTenantId()))
+            .orElseThrow(() -> new NotFoundException("Case not found"));
+
+        if (!canChange(user, supportCase)) {
+            // Customers can see their own cases, so preserve the documented 403 distinction for them.
+            if (user.isCustomer() && customers.findById(supportCase.getCustomerId())
+                    .map(c -> user.inTenant(c.getTenantId()) && user.id().equals(c.getUserId())).orElse(false)) {
+                throw new ForbiddenException("Only support staff can reassign cases");
+            }
+            throw new NotFoundException("Case not found");
+        }
+
+        if (body == null) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        String assignee = body.assigneeUserId();
+        if (assignee != null) {
+            if (assignee.isBlank() || !assignments.existsByTenantIdAndSupportUserIdAndAccountId(
+                    supportCase.getTenantId(), assignee, supportCase.getAccountId())) {
+                throw new IllegalArgumentException("Invalid assignee");
+            }
+        }
+        supportCase.setAssigneeUserId(assignee);
+        return CaseResponse.of(supportCase);
+    }
+
+    private boolean canChange(CurrentUser user, SupportCase supportCase) {
+        if (user.isAdmin()) {
+            return true;
+        }
+        return user.isSupport() && user.id().equals(supportCase.getAssigneeUserId());
+    }
+}
diff --git a/src/test/java/com/example/accounts/CaseApiTest.java b/src/test/java/com/example/accounts/CaseApiTest.java
index 8a799bf..348210f 100644
--- a/src/test/java/com/example/accounts/CaseApiTest.java
+++ b/src/test/java/com/example/accounts/CaseApiTest.java
@@ -40,4 +40,31 @@ class CaseApiTest extends ApiTest {
     void supportCannotRaiseCases() throws Exception {
         postAs(SAM, "/api/cases", "{\"accountId\":1,\"subject\":\"Lost card\"}").andExpect(status().isForbidden());
     }
+
+    @Test
+    void adminReassignsCaseAndReturnsAssignee() throws Exception {
+        putAs(ADA, "/api/support/cases/k-3/assignee", "{\"assigneeUserId\":\"u-ana\"}")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$.id").value("k-3"))
+            .andExpect(jsonPath("$.assigneeUserId").value("u-ana"));
+    }
+
+    @Test
+    void currentAssigneeMayUnassignCase() throws Exception {
+        putAs(SUE, "/api/support/cases/k-3/assignee", "{\"assigneeUserId\":null}")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$.assigneeUserId").value((Object) null));
+    }
+
+    @Test
+    void otherSupportUserCannotSeeCaseToReassign() throws Exception {
+        putAs(SAM, "/api/support/cases/k-3/assignee", "{\"assigneeUserId\":\"u-ana\"}")
+            .andExpect(status().isNotFound());
+    }
+
+    @Test
+    void customerCannotReassignOwnCase() throws Exception {
+        putAs(BOB, "/api/support/cases/k-3/assignee", "{\"assigneeUserId\":null}")
+            .andExpect(status().isForbidden());
+    }
 }
