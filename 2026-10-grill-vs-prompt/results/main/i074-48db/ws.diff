+
+    @Transactional
+    public Account updateDailyLimit(Long accountId, int dailyLimit) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+        if (access.isTenantAdmin(user, account.getTenantId())) {
+            account.setDailyLimit(dailyLimit);
+            return account;
+        }
+        if (!access.isAssignedSupport(user, account)) {
+            throw new ForbiddenException("Only assigned support or an admin can change the daily limit");
+        }
+        if (dailyLimit > account.getDailyLimit()) {
+            throw new ForbiddenException("Support users may only lower the daily limit");
+        }
+        account.setDailyLimit(dailyLimit);
+        return account;
+    }
