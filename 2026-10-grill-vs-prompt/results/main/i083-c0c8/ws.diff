@@ -0,0 +1,78 @@
+package com.example.accounts.goodwill;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.time.LocalDate;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.account.Account;
+import com.example.accounts.account.AccountService;
+import com.example.accounts.account.Transaction;
+import com.example.accounts.account.TransactionRepository;
+import com.example.accounts.security.AccessPolicy;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.ConflictException;
+import com.example.accounts.web.ForbiddenException;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotNull;
+
+@RestController
+public class GoodwillCreditController {
+    public record GoodwillCreditRequest(@NotNull BigDecimal amount, @NotNull String reason) { }
+    public record GoodwillCreditView(Long id, Long accountId, BigDecimal amount, String reason, String createdBy,
+                                     Instant createdAt) {
+        static GoodwillCreditView of(GoodwillCredit c) {
+            return new GoodwillCreditView(c.getId(), c.getAccountId(), c.getAmount(), c.getReason(), c.getCreatedBy(), c.getCreatedAt());
+        }
+    }
+
+    private final GoodwillCreditRepository credits;
+    private final TransactionRepository transactions;
+    private final AccountService accounts;
+    private final AccessPolicy access;
+    private final CurrentUserProvider users;
+
+    public GoodwillCreditController(GoodwillCreditRepository credits,
+                                    TransactionRepository transactions, AccountService accounts,
+                                    AccessPolicy access, CurrentUserProvider users) {
+        this.credits = credits; this.transactions = transactions;
+        this.accounts = accounts; this.access = access; this.users = users;
+    }
+
+    @PostMapping("/api/accounts/{accountId}/goodwill-credits")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @ResponseStatus(HttpStatus.CREATED)
+    @Transactional
+    public GoodwillCreditView create(@PathVariable Long accountId, @Valid @RequestBody GoodwillCreditRequest request) {
+        CurrentUser user = users.current();
+        Account visible = accounts.getVisibleForUpdate(accountId);
+        if (!access.isAssignedSupport(user, visible) && !access.isTenantAdmin(user, visible.getTenantId())) {
+            throw new ForbiddenException("Only assigned support staff or a tenant admin can create a goodwill credit");
+        }
+        if (visible.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+        if (request.amount().signum() <= 0 || request.amount().scale() > 2) {
+            throw new IllegalArgumentException("Invalid amount");
+        }
+        String reason = request.reason().trim();
+        if (reason.isEmpty() || reason.length() > 500) {
+            throw new IllegalArgumentException("Invalid reason");
+        }
+        BigDecimal amount = request.amount().setScale(2);
+        visible.credit(amount);
+        transactions.save(new Transaction(accountId, amount, "Goodwill credit", LocalDate.now()));
+        GoodwillCredit credit = credits.save(new GoodwillCredit(accountId, amount, reason, user.id(), Instant.now()));
+        return GoodwillCreditView.of(credit);
+    }
+}
