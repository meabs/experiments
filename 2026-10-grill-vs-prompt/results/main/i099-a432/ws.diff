@@ -0,0 +1,54 @@
+package com.example.accounts.account;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+
+import jakarta.persistence.Column;
+import jakarta.persistence.Entity;
+import jakarta.persistence.GeneratedValue;
+import jakarta.persistence.GenerationType;
+import jakarta.persistence.Id;
+import jakarta.persistence.Table;
+
+/** A staff-issued credit added to an account as a goodwill payment. */
+@Entity
+@Table(name = "goodwill_credits")
+public class GoodwillCredit {
+
+    @Id
+    @GeneratedValue(strategy = GenerationType.IDENTITY)
+    private Long id;
+
+    @Column(nullable = false)
+    private Long accountId;
+
+    @Column(nullable = false)
+    private BigDecimal amount;
+
+    @Column(nullable = false, length = 500)
+    private String reason;
+
+    @Column(nullable = false)
+    private String createdBy;
+
+    @Column(nullable = false)
+    private Instant createdAt;
+
+    protected GoodwillCredit() {
+    }
+
+    public GoodwillCredit(Long accountId, BigDecimal amount, String reason, String createdBy) {
+        this.accountId = accountId;
+        this.amount = amount;
+        this.reason = reason;
+        this.createdBy = createdBy;
+        this.createdAt = Instant.now();
+    }
+
+    public Long getId() { return id; }
+    public Long getAccountId() { return accountId; }
+    public BigDecimal getAmount() { return amount; }
+    public String getReason() { return reason; }
+    public String getCreatedBy() { return createdBy; }
+    public Instant getCreatedAt() { return createdAt; }
+}
diff --git a/src/main/java/com/example/accounts/account/GoodwillCreditController.java b/src/main/java/com/example/accounts/account/GoodwillCreditController.java
