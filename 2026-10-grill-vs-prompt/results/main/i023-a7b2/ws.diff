+    @Transactional
+    public Account setDailyLimit(Long accountId, JsonNode value) {
+        Account account = getVisible(accountId);
+        CurrentUser user = users.current();
+        int dailyLimit = parseDailyLimit(value);
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Closed accounts cannot have their daily limit changed");
+        }
+        if (!access.isTenantAdmin(user, account.getTenantId())
+            && (!access.isAssignedSupport(user, account) || dailyLimit > account.getDailyLimit())) {
+            throw new ForbiddenException("You cannot set this account's daily limit");
+        }
+        account.setDailyLimit(dailyLimit);
+        return account;
+    }
+
+    private int parseDailyLimit(JsonNode value) {
+        if (value == null || !value.isNumber()) {
+            throw new IllegalArgumentException("dailyLimit must be a whole number");
+        }
+        BigDecimal limit;
+        try {
+            limit = value.decimalValue();
+        } catch (ArithmeticException e) {
+            throw new IllegalArgumentException("dailyLimit must be a whole number", e);
+        }
+        if (limit.scale() > 0 && limit.stripTrailingZeros().scale() > 0) {
+            throw new IllegalArgumentException("dailyLimit must be a whole number");
+        }
+        if (limit.signum() < 0 || limit.compareTo(BigDecimal.valueOf(5000)) > 0) {
+            throw new IllegalArgumentException("dailyLimit is outside the allowed range");
+        }
+        try {
+            return limit.intValueExact();
+        } catch (ArithmeticException e) {
+            throw new IllegalArgumentException("dailyLimit must be a whole number", e);
+        }
+    }
