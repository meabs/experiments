@@ -0,0 +1,35 @@
+package com.example.accounts.account;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+@RestController
+public class GoodwillCreditController {
+    public record Request(BigDecimal amount, String reason) { }
+    public record View(Long id, Long accountId, BigDecimal amount, String reason, String createdBy, Instant createdAt,
+                       GoodwillCredit.Status status) {
+        static View of(GoodwillCredit c) { return new View(c.getId(), c.getAccountId(), c.getAmount(), c.getReason(),
+            c.getCreatedBy(), c.getCreatedAt(), c.getStatus()); }
+    }
+    private final GoodwillCreditService service;
+    public GoodwillCreditController(GoodwillCreditService service) { this.service = service; }
+
+    @PostMapping("/api/accounts/{accountId}/goodwill-credits")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @ResponseStatus(HttpStatus.CREATED)
+    public View create(@PathVariable Long accountId, @RequestBody Request request) {
+        return View.of(service.create(accountId, request.amount(), request.reason()));
+    }
+
+    @PostMapping("/api/goodwill-credits/{creditId}/approve")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write') and hasRole('APPROVER')")
+    public View approve(@PathVariable Long creditId) { return View.of(service.approve(creditId)); }
+}
