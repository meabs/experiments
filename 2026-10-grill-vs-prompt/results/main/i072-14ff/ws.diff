diff --git a/src/main/java/com/example/accounts/account/GoodwillCreditService.java b/src/main/java/com/example/accounts/account/GoodwillCreditService.java
new file mode 100644
index 0000000..1069541
--- /dev/null
+++ b/src/main/java/com/example/accounts/account/GoodwillCreditService.java
@@ -0,0 +1,75 @@
+package com.example.accounts.account;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDate;
+
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.example.accounts.security.AccessPolicy;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.ConflictException;
+import com.example.accounts.web.ForbiddenException;
+import com.example.accounts.web.NotFoundException;
+
+@Service
+public class GoodwillCreditService {
+    private final GoodwillCreditRepository credits;
+    private final AccountService accounts;
+    private final AccountRepository accountRepository;
+    private final TransactionRepository transactions;
+    private final AccessPolicy access;
+    private final CurrentUserProvider users;
+
+    public GoodwillCreditService(GoodwillCreditRepository credits, AccountService accounts, AccountRepository accountRepository,
+                                 TransactionRepository transactions, AccessPolicy access, CurrentUserProvider users) {
+        this.credits = credits; this.accounts = accounts; this.accountRepository = accountRepository;
+        this.transactions = transactions; this.access = access; this.users = users;
+    }
+
+    @Transactional
+    public GoodwillCredit create(Long accountId, BigDecimal rawAmount, String rawReason) {
+        validate(rawAmount, rawReason);
+        CurrentUser user = users.current();
+        Account account = accounts.getVisible(accountId);
+        if (!access.isAssignedSupport(user, account) && !access.isTenantAdmin(user, account.getTenantId())) {
+            throw new ForbiddenException("Only assigned staff or an admin can give goodwill credit");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) throw new ConflictException("Account is closed");
+        BigDecimal amount = rawAmount.setScale(2, RoundingMode.UNNECESSARY);
+        GoodwillCredit.Status status = amount.compareTo(new BigDecimal("100.00")) > 0
+            ? GoodwillCredit.Status.PENDING : GoodwillCredit.Status.PAID;
+        GoodwillCredit credit = credits.save(new GoodwillCredit(account.getTenantId(), accountId, amount,
+            rawReason.trim(), user.id(), status));
+        if (status == GoodwillCredit.Status.PAID) pay(account, amount);
+        return credit;
+    }
+
+    @Transactional
+    public GoodwillCredit approve(Long creditId) {
+        CurrentUser user = users.current();
+        GoodwillCredit credit = credits.findById(creditId)
+            .orElseThrow(() -> new NotFoundException("Goodwill credit not found"));
+        if (!user.inTenant(credit.getTenantId())) throw new NotFoundException("Goodwill credit not found");
+        if (credit.getStatus() != GoodwillCredit.Status.PENDING) throw new ConflictException("Credit is already paid");
+        if (user.id().equals(credit.getCreatedBy())) throw new ForbiddenException("The requester cannot approve this credit");
+        Account account = accountRepository.findById(credit.getAccountId())
+            .filter(a -> user.inTenant(a.getTenantId())).orElseThrow(() -> new NotFoundException("Goodwill credit not found"));
+        if (account.getStatus() == Account.Status.CLOSED) throw new ConflictException("Account is closed");
+        pay(account, credit.getAmount());
+        credit.setStatus(GoodwillCredit.Status.PAID);
+        return credit;
+    }
+
+    private void pay(Account account, BigDecimal amount) {
+        account.addToBalance(amount);
+        transactions.save(new Transaction(account.getId(), amount, "Goodwill credit", LocalDate.now()));
+    }
+
+    private static void validate(BigDecimal amount, String reason) {
+        if (amount == null || amount.signum() <= 0 || amount.scale() > 2 || reason == null
+            || reason.trim().length() < 1 || reason.trim().length() > 500) throw new IllegalArgumentException();
+    }
+}
