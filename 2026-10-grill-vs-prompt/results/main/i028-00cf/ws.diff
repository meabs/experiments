+    public record DailyLimitRequest(JsonNode dailyLimit) {
+        int value() {
+            if (!(dailyLimit instanceof NumericNode) || dailyLimit.isNull() || !dailyLimit.isNumber()) {
+                throw new IllegalArgumentException("Invalid dailyLimit");
+            }
+            BigDecimal value = dailyLimit.decimalValue();
+            if (value.signum() < 0 || value.compareTo(BigDecimal.valueOf(5000)) > 0
+                || value.stripTrailingZeros().scale() > 0
+                || value.compareTo(BigDecimal.valueOf(Integer.MAX_VALUE)) > 0) {
+                throw new IllegalArgumentException("Invalid dailyLimit");
+            }
+            return value.setScale(0, RoundingMode.UNNECESSARY).intValueExact();
+        }
+    }
