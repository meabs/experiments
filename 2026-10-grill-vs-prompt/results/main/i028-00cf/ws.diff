+
+    @Transactional
+    public Account changeDailyLimit(Long accountId, int dailyLimit) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+        if (user.isSupport() && !access.isTenantAdmin(user, account.getTenantId())) {
+            if (!access.isAssignedSupport(user, account)) {
+                throw new ForbiddenException("Only assigned support can change this account");
+            }
+            if (dailyLimit > account.getDailyLimit()) {
+                throw new ForbiddenException("Support can only lower the daily limit");
+            }
+        } else if (!access.isTenantAdmin(user, account.getTenantId())) {
+            throw new ForbiddenException("Only staff can change an account's daily limit");
+        }
+        int oldLimit = account.getDailyLimit();
+        account.setDailyLimit(dailyLimit);
+        notes.save(new AccountNote(account.getId(), user.id(),
+            "Daily limit changed from " + oldLimit + " to " + dailyLimit, true, Instant.now()));
+        return account;
+    }
 }
