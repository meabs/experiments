+    @PutMapping("/{accountId}/daily-limit")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    public AccountView setDailyLimit(@PathVariable Long accountId, @Valid @RequestBody DailyLimitRequest body) {
+        BigDecimal limit = body.dailyLimit();
+        if (limit.signum() < 0 || limit.stripTrailingZeros().scale() > 0
+            || limit.compareTo(BigDecimal.valueOf(Integer.MAX_VALUE)) > 0) {
+            throw new IllegalArgumentException("Daily limit must be a non-negative whole number");
+        }
+        return AccountView.of(service.setDailyLimit(accountId, limit.intValueExact()));
+    }
