+    @PostMapping("/{accountId}/freeze")
+    @PreAuthorize("hasAnyRole('SUPPORT', 'ADMIN') and hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public AccountView freeze(@PathVariable Long accountId, @RequestBody FreezeRequest body) {
+        Account account = staffAccount(accountId);
+        if (body == null || body.reason() == null || body.reason().trim().length() < 1
+            || body.reason().trim().length() > 500) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        if (account.getStatus() != Account.Status.OPEN) {
+            throw new ConflictException("Account is not open");
+        }
+        account.setStatus(Account.Status.FROZEN);
+        return AccountView.of(account);
+    }
+
+    @PostMapping("/{accountId}/unfreeze")
+    @PreAuthorize("hasAnyRole('SUPPORT', 'ADMIN') and hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public AccountView unfreeze(@PathVariable Long accountId) {
+        Account account = staffAccount(accountId);
+        if (account.getStatus() != Account.Status.FROZEN) {
+            throw new ConflictException("Account is not frozen");
+        }
+        account.setStatus(Account.Status.OPEN);
+        return AccountView.of(account);
+    }
+
+    private Account staffAccount(Long accountId) {
+        CurrentUser user = users.current();
+        Account account = service.getVisible(accountId);
+        if (!access.isAssignedSupport(user, account) && !access.isTenantAdmin(user, account.getTenantId())) {
+            throw new ForbiddenException("Only assigned support staff or a tenant admin can change account status");
+        }
+        return account;
+    }
