+
+    @Transactional
+    public Account updateDailyLimit(Long accountId, java.math.BigDecimal dailyLimit) {
+        Account account = getVisible(accountId);
+        if (dailyLimit == null || dailyLimit.signum() < 0) {
+            throw new IllegalArgumentException("Invalid daily limit");
+        }
+        try {
+            account.setDailyLimit(dailyLimit.intValueExact());
+        } catch (ArithmeticException e) {
+            throw new IllegalArgumentException("Invalid daily limit", e);
+        }
+        return account;
+    }
