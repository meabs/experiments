new file mode 100644
index 0000000..70dfb77
--- /dev/null
+++ b/src/main/java/com/example/accounts/account/FreezeRequest.java
@@ -0,0 +1,15 @@
+package com.example.accounts.account;
+
+/** The reason supplied by back-office staff when freezing an account. */
+public record FreezeRequest(String reason) {
+
+    public FreezeRequest {
+        if (reason == null) {
+            throw new IllegalArgumentException("Freeze reason is required");
+        }
+        reason = reason.trim();
+        if (reason.length() < 1 || reason.length() > 500) {
+            throw new IllegalArgumentException("Freeze reason must be between 1 and 500 characters");
+        }
+    }
+}
