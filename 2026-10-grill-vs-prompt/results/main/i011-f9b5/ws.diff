+package com.example.accounts.cases;
+
+import java.time.Instant;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotBlank;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.account.SupportAssignmentRepository;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.ConflictException;
+import com.example.accounts.web.ForbiddenException;
+import com.example.accounts.web.NotFoundException;
+
+/** Back-office reassignment of support cases. */
+@RestController
+@RequestMapping("/api/support/cases")
+public class SupportCaseAssignmentController {
+
+    public record AssigneeChange(@NotBlank String assigneeUserId) {
+    }
+
+    public record AssignedCase(String id, Long accountId, String subject, String status, String assigneeUserId,
+                               Instant openedAt) {
+        static AssignedCase of(SupportCase c) {
+            return new AssignedCase(c.getId(), c.getAccountId(), c.getSubject(), c.getStatus(), c.getAssigneeUserId(),
+                c.getOpenedAt());
+        }
+    }
+
+    private final SupportCaseRepository cases;
+    private final SupportAssignmentRepository assignments;
+    private final CurrentUserProvider users;
+
+    public SupportCaseAssignmentController(SupportCaseRepository cases, SupportAssignmentRepository assignments,
+                                            CurrentUserProvider users) {
+        this.cases = cases;
+        this.assignments = assignments;
+        this.users = users;
+    }
+
+    @PutMapping("/{caseId}/assignee")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public AssignedCase reassign(@PathVariable String caseId, @Valid @RequestBody AssigneeChange body) {
+        CurrentUser user = users.current();
+        SupportCase c = cases.findById(caseId)
+            .filter(found -> user.inTenant(found.getTenantId()))
+            .orElseThrow(() -> new NotFoundException("Case not found"));
+
+        if (!user.isAdmin() && !(user.isSupport() && user.id().equals(c.getAssigneeUserId()))) {
+            if (user.isSupport()) {
+                throw new NotFoundException("Case not found");
+            }
+            throw new ForbiddenException("Only support users and admins can reassign cases");
+        }
+        if (!"OPEN".equals(c.getStatus())) {
+            throw new ConflictException("Case cannot be reassigned in its current state");
+        }
+
+        String assigneeUserId = body.assigneeUserId().trim();
+        if (assigneeUserId.isEmpty()
+            || !assignments.existsByTenantIdAndSupportUserIdAndAccountId(c.getTenantId(), assigneeUserId, c.getAccountId())) {
+            throw new IllegalArgumentException("Assignee is not assigned to the case account");
+        }
+        c.assignTo(assigneeUserId);
+        return AssignedCase.of(c);
+    }
+}
