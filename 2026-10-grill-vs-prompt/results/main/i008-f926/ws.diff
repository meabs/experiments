@@ -0,0 +1,85 @@
+package com.example.accounts.account;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.ZoneOffset;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.DecimalMin;
+import jakarta.validation.constraints.NotNull;
+import jakarta.validation.constraints.Size;
+import jakarta.validation.constraints.AssertTrue;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.security.AccessPolicy;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.ConflictException;
+import com.example.accounts.web.ForbiddenException;
+
+@RestController
+public class GoodwillCreditController {
+
+    public record NewCredit(@NotNull @DecimalMin(value = "0.00", inclusive = false) BigDecimal amount,
+                             @NotNull @Size(min = 1, max = 500) String reason) {
+        public NewCredit {
+            if (reason != null) reason = reason.trim();
+        }
+
+        @AssertTrue
+        public boolean hasAtMostTwoDecimalPlaces() {
+            return amount == null || amount.scale() <= 2;
+        }
+    }
+
+    public record CreditView(Long id, Long accountId, BigDecimal amount, String reason, String createdBy,
+                             Instant createdAt) {
+        static CreditView of(GoodwillCredit c) {
+            return new CreditView(c.getId(), c.getAccountId(), c.getAmount(), c.getReason(), c.getCreatedBy(), c.getCreatedAt());
+        }
+    }
+
+    private final AccountService accounts;
+    private final GoodwillCreditRepository credits;
+    private final TransactionRepository transactions;
+    private final AccessPolicy access;
+    private final CurrentUserProvider users;
+
+    public GoodwillCreditController(AccountService accounts, GoodwillCreditRepository credits,
+                                    TransactionRepository transactions, AccessPolicy access,
+                                    CurrentUserProvider users) {
+        this.accounts = accounts;
+        this.credits = credits;
+        this.transactions = transactions;
+        this.access = access;
+        this.users = users;
+    }
+
+    @PostMapping("/api/accounts/{accountId}/goodwill-credits")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @ResponseStatus(HttpStatus.CREATED)
+    @Transactional
+    public CreditView create(@PathVariable Long accountId, @Valid @RequestBody NewCredit body) {
+        CurrentUser user = users.current();
+        Account account = accounts.getVisible(accountId);
+        if (!access.isAssignedSupport(user, account) && !access.isTenantAdmin(user, account.getTenantId())) {
+            throw new ForbiddenException("Only assigned support staff or an admin can create a goodwill credit");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+        GoodwillCredit credit = credits.save(new GoodwillCredit(account.getId(), body.amount(), body.reason(), user.id(), Instant.now()));
+        account.credit(body.amount());
+        transactions.save(new Transaction(account.getId(), body.amount(), "Goodwill credit", LocalDate.now(ZoneOffset.UTC)));
+        return CreditView.of(credit);
+    }
+}
