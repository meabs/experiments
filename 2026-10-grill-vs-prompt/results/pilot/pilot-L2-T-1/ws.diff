@@ -0,0 +1,56 @@
+package com.example.accounts.cases;
+
+import java.time.Instant;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotBlank;
+import jakarta.validation.constraints.Size;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.NotFoundException;
+
+/** Back-office operations on support cases. */
+@RestController
+@RequestMapping("/api/support/cases")
+public class SupportCaseController {
+
+    public record AssigneeCaseView(String id, Long accountId, String subject, String status, String assigneeUserId,
+                                   Instant openedAt) {
+        static AssigneeCaseView of(SupportCase c) {
+            return new AssigneeCaseView(c.getId(), c.getAccountId(), c.getSubject(), c.getStatus(),
+                c.getAssigneeUserId(), c.getOpenedAt());
+        }
+    }
+
+    public record ReassignCase(@NotBlank @Size(max = 200) String assigneeUserId) {
+    }
+
+    private final SupportCaseRepository cases;
+    private final CurrentUserProvider users;
+
+    public SupportCaseController(SupportCaseRepository cases, CurrentUserProvider users) {
+        this.cases = cases;
+        this.users = users;
+    }
+
+    @PutMapping("/{caseId}/assignee")
+    @PreAuthorize("hasAnyRole('SUPPORT', 'ADMIN') and hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public AssigneeCaseView reassign(@PathVariable String caseId, @Valid @RequestBody ReassignCase body) {
+        CurrentUser user = users.current();
+        SupportCase supportCase = cases.findByIdAndTenantId(caseId, user.tenantId())
+            .filter(c -> user.isAdmin() || user.id().equals(c.getAssigneeUserId()))
+            .orElseThrow(() -> new NotFoundException("Case not found"));
+        supportCase.setAssigneeUserId(body.assigneeUserId().trim());
+        return AssigneeCaseView.of(supportCase);
+    }
+}
