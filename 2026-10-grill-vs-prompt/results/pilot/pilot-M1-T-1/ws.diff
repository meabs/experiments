+    public record DailyLimitRequest(
+        @NotNull @DecimalMin("0") @DecimalMax("2147483647") BigDecimal dailyLimit) {
+
+        int value() {
+            // A decimal representation such as 750.0 is still a whole-pound value, but 750.50 is not.
+            if (dailyLimit.stripTrailingZeros().scale() > 0) {
+                throw new IllegalArgumentException("Daily limit must be a whole number");
+            }
+            try {
+                return dailyLimit.intValueExact();
+            } catch (ArithmeticException e) {
+                throw new IllegalArgumentException("Daily limit must be a whole number", e);
+            }
+        }
+    }
