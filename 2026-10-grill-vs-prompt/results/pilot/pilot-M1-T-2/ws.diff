+    /** Changes are a staff operation; customers may view their accounts but cannot alter them. */
+    @Transactional
+    public Account changeDailyLimit(Long accountId, BigDecimal dailyLimit) {
+        Account account = getVisible(accountId);
+        CurrentUser user = users.current();
+        if (!user.isSupport() && !user.isAdmin()) {
+            throw new ForbiddenException("Only staff can change an account's daily limit");
+        }
+        account.setDailyLimit(dailyLimit.intValueExact());
+        return account;
+    }
