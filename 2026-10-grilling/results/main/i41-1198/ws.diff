-    public List<AccountView> list() {
-        return service.listVisible().stream().map(AccountView::of).toList();
+    public List<AccountView> list(HttpServletRequest request) {
+        String[] statuses = request.getParameterValues("status");
+        if (statuses != null && statuses.length > 1) {
+            throw new IllegalArgumentException("Only one status may be specified");
+        }
+        Account.Status status = statuses == null ? null : parseStatus(statuses[0]);
+        return service.listVisible(status).stream().map(AccountView::of).toList();
+    }
+
+    private static Account.Status parseStatus(String value) {
+        try {
+            return Account.Status.valueOf(value);
+        } catch (IllegalArgumentException e) {
+            throw new IllegalArgumentException("Invalid account status", e);
+        }
     }
 
