+    /** The assigned support user or an admin of the case's tenant closes a resolved case. */
+    @PostMapping("/api/support/cases/{caseId}/close")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public CaseSummary close(@PathVariable String caseId, @Valid @RequestBody CloseCase body) {
+        CurrentUser user = users.current();
+        SupportCase c = cases.findById(caseId).orElseThrow(() -> new NotFoundException("Case not found"));
+        boolean allowed = user.isAdmin() ? user.inTenant(c.getTenantId())
+            : user.isSupport() && user.inTenant(c.getTenantId()) && user.id().equals(c.getAssigneeUserId());
+        if (!allowed) {
+            throw new ForbiddenException("Only the case assignee or a tenant admin can close a case");
+        }
+        String resolution = body.resolution() == null ? null : body.resolution().trim();
+        if (resolution == null || resolution.isEmpty() || resolution.length() > 2000) {
+            throw new IllegalArgumentException("Invalid resolution");
+        }
+        if ("CLOSED".equals(c.getStatus())) {
+            throw new ConflictException("Case is already closed");
+        }
+        c.close(resolution);
+        return CaseSummary.of(cases.save(c));
+    }
 }
