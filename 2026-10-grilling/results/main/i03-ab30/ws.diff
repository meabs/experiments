+package com.example.accounts.account;
+
+import java.time.Instant;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotNull;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.security.AccessPolicy;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.ForbiddenException;
+
+@RestController
+@RequestMapping("/api/accounts/{accountId}/notes")
+public class AccountNoteController {
+
+    public record NewNote(@NotNull String body, @NotNull Boolean internal) {
+    }
+
+    public record NoteView(Long id, String author, String body, boolean internal, Instant createdAt) {
+        static NoteView of(AccountNote note) {
+            return new NoteView(note.getId(), note.getAuthor(), note.getBody(), note.isInternal(), note.getCreatedAt());
+        }
+    }
+
+    private final AccountService accounts;
+    private final AccountNoteRepository notes;
+    private final AccessPolicy access;
+    private final CurrentUserProvider users;
+
+    public AccountNoteController(AccountService accounts, AccountNoteRepository notes, AccessPolicy access,
+                                 CurrentUserProvider users) {
+        this.accounts = accounts;
+        this.notes = notes;
+        this.access = access;
+        this.users = users;
+    }
+
+    @PostMapping
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @ResponseStatus(HttpStatus.CREATED)
+    @Transactional
+    public NoteView add(@PathVariable Long accountId, @Valid @RequestBody NewNote body) {
+        String trimmed = body.body().trim();
+        if (trimmed.isEmpty() || trimmed.length() > 2000) {
+            throw new IllegalArgumentException("Invalid note body");
+        }
+
+        CurrentUser user = users.current();
+        Account account = accounts.getVisible(accountId);
+        if (!access.isTenantAdmin(user, account.getTenantId())) {
+            if (!access.isAssignedSupport(user, account)) {
+                throw new ForbiddenException("Only assigned support staff or tenant admins can add notes");
+            }
+            if (!body.internal()) {
+                throw new ForbiddenException("Support staff can only add internal notes");
+            }
+        }
+
+        AccountNote note = new AccountNote(account.getId(), user.id(), trimmed, body.internal(), Instant.now());
+        return NoteView.of(notes.save(note));
+    }
+}
