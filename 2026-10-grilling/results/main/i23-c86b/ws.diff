+package com.example.accounts.account;
+
+import java.time.Instant;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.security.AccessPolicy;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.ConflictException;
+import com.example.accounts.web.ForbiddenException;
+
+@RestController
+public class AccountStatusController {
+
+    public record FreezeRequest(String reason) {
+    }
+
+    private final AccountService accounts;
+    private final AccountNoteRepository notes;
+    private final AccessPolicy access;
+    private final CurrentUserProvider users;
+
+    public AccountStatusController(AccountService accounts, AccountNoteRepository notes, AccessPolicy access,
+                                   CurrentUserProvider users) {
+        this.accounts = accounts;
+        this.notes = notes;
+        this.access = access;
+        this.users = users;
+    }
+
+    @PostMapping("/api/accounts/{accountId}/freeze")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public AccountController.AccountView freeze(@PathVariable Long accountId, @RequestBody FreezeRequest request) {
+        CurrentUser user = users.current();
+        Account account = accounts.getVisible(accountId);
+        if (!access.isAssignedSupport(user, account) && !access.isTenantAdmin(user, account.getTenantId())) {
+            throw new ForbiddenException("Only assigned support or an admin can freeze an account");
+        }
+        if (account.getStatus() != Account.Status.OPEN) {
+            throw new ConflictException("Only an open account can be frozen");
+        }
+        String reason = request == null ? null : request.reason();
+        if (reason == null) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        reason = reason.trim();
+        if (reason.length() < 1 || reason.length() > 500) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        account.setStatus(Account.Status.FROZEN);
+        notes.save(new AccountNote(account.getId(), user.id(), "Account frozen: " + reason, true, Instant.now()));
+        return AccountController.AccountView.of(account);
+    }
+
+    @PostMapping("/api/accounts/{accountId}/unfreeze")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public AccountController.AccountView unfreeze(@PathVariable Long accountId) {
+        CurrentUser user = users.current();
+        Account account = accounts.getVisible(accountId);
+        if (!access.isTenantAdmin(user, account.getTenantId())) {
+            throw new ForbiddenException("Only an admin can unfreeze an account");
+        }
+        if (account.getStatus() != Account.Status.FROZEN) {
+            throw new ConflictException("Only a frozen account can be unfrozen");
+        }
+        account.setStatus(Account.Status.OPEN);
+        notes.save(new AccountNote(account.getId(), user.id(), "Account unfrozen", true, Instant.now()));
+        return AccountController.AccountView.of(account);
+    }
+}
