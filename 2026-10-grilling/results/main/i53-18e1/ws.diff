+
+    @Transactional
+    public Account freeze(Long accountId, String reason) {
+        String trimmed = reason == null ? null : reason.trim();
+        if (trimmed == null || trimmed.length() < 1 || trimmed.length() > 500) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (!user.isAdmin() && !access.isAssignedSupport(user, account)) {
+            throw new ForbiddenException("Only assigned support or tenant admins can freeze an account");
+        }
+        if (account.getStatus() != Account.Status.OPEN) {
+            throw new ConflictException("Account is not open");
+        }
+        account.setStatus(Account.Status.FROZEN);
+        notes.save(new AccountNote(account.getId(), user.id(), "Account frozen: " + trimmed, true, Instant.now()));
+        return account;
+    }
+
+    @Transactional
+    public Account unfreeze(Long accountId) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (!user.isAdmin()) {
+            throw new ForbiddenException("Only tenant admins can unfreeze an account");
+        }
+        if (account.getStatus() != Account.Status.FROZEN) {
+            throw new ConflictException("Account is not frozen");
+        }
+        account.setStatus(Account.Status.OPEN);
+        notes.save(new AccountNote(account.getId(), user.id(), "Account unfrozen", true, Instant.now()));
+        return account;
+    }
 }
