+    /** An admin assigns all the requested cases in their tenant to one support user. */
+    @PostMapping("/support/cases/assign")
+    @PreAuthorize("hasRole('ADMIN') && hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public List<AssignedCaseSummary> assign(@Valid @RequestBody AssignCases body) {
+        CurrentUser user = users.current();
+
+        // Load and validate every case before mutating any of them, so a bad request is all-or-nothing.
+        Map<String, SupportCase> found = new LinkedHashMap<>();
+        for (String id : body.caseIds()) {
+            SupportCase c = cases.findById(id)
+                .filter(candidate -> user.inTenant(candidate.getTenantId()))
+                .orElseThrow(() -> new NotFoundException("Case not found"));
+            found.putIfAbsent(id, c);
+        }
+
+        found.values().forEach(c -> c.assignTo(body.assigneeUserId().trim()));
+        return found.values().stream().map(AssignedCaseSummary::of).toList();
+    }
