+    @PatchMapping("/{accountId}/notes/{noteId}")
+    @PreAuthorize("(hasRole('SUPPORT') or hasRole('ADMIN')) and hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public NoteView updateNote(@PathVariable Long accountId, @PathVariable Long noteId, @RequestBody JsonNode request) {
+        if (request == null || !request.isObject() || (!request.has("body") && !request.has("internal"))) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+
+        String updatedBody = null;
+        if (request.has("body")) {
+            JsonNode body = request.get("body");
+            if (!body.isTextual()) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+            updatedBody = body.textValue().trim();
+            if (updatedBody.length() < 1 || updatedBody.length() > 2000) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+        }
+        Boolean updatedInternal = null;
+        if (request.has("internal")) {
+            JsonNode internal = request.get("internal");
+            if (!internal.isBoolean()) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+            updatedInternal = internal.booleanValue();
+        }
+
+        Account account = service.getVisible(accountId);
+        AccountNote note = notes.findById(noteId)
+            .filter(n -> n.getAccountId().equals(account.getId()))
+            .orElseThrow(() -> new NotFoundException("Note not found"));
+        if (updatedBody != null) {
+            note.setBody(updatedBody);
+        }
+        if (updatedInternal != null) {
+            note.setInternal(updatedInternal);
+        }
+        return NoteView.of(note);
+    }
