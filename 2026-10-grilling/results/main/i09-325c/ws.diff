+package com.example.accounts.cases;
+
+import java.time.Instant;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotBlank;
+import jakarta.validation.constraints.Size;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.account.SupportAssignmentRepository;
+import com.example.accounts.customer.CustomerRepository;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.ForbiddenException;
+import com.example.accounts.web.NotFoundException;
+
+/** Back-office reassignment of support cases. */
+@RestController
+@RequestMapping("/api/support/cases")
+public class SupportCaseAssignmentController {
+
+    public record AssigneeChange(@NotBlank @Size(max = 100) String assigneeUserId) {
+    }
+
+    public record CaseAssignmentResponse(String id, Long accountId, String subject, String status,
+                                         String assigneeUserId, Instant openedAt) {
+        static CaseAssignmentResponse of(SupportCase c) {
+            return new CaseAssignmentResponse(c.getId(), c.getAccountId(), c.getSubject(), c.getStatus(),
+                c.getAssigneeUserId(), c.getOpenedAt());
+        }
+    }
+
+    private final SupportCaseRepository cases;
+    private final SupportAssignmentRepository assignments;
+    private final CustomerRepository customers;
+    private final CurrentUserProvider users;
+
+    public SupportCaseAssignmentController(SupportCaseRepository cases, SupportAssignmentRepository assignments,
+                                           CustomerRepository customers, CurrentUserProvider users) {
+        this.cases = cases;
+        this.assignments = assignments;
+        this.customers = customers;
+        this.users = users;
+    }
+
+    @PutMapping("/{caseId}/assignee")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public CaseAssignmentResponse reassign(@PathVariable String caseId, @Valid @RequestBody AssigneeChange body) {
+        SupportCase c = cases.findById(caseId).orElseThrow(() -> new NotFoundException("Case not found"));
+        CurrentUser user = users.current();
+
+        if (user.isAdmin()) {
+            if (!user.inTenant(c.getTenantId())) {
+                throw new NotFoundException("Case not found");
+            }
+        } else if (user.isSupport()) {
+            if (!user.inTenant(c.getTenantId()) || !user.id().equals(c.getAssigneeUserId())) {
+                throw new NotFoundException("Case not found");
+            }
+        } else if (user.isCustomer()) {
+            boolean ownsCase = customers.findByUserId(user.id())
+                .filter(customer -> user.inTenant(customer.getTenantId()))
+                .map(customer -> customer.getId().equals(c.getCustomerId()))
+                .orElse(false);
+            if (!ownsCase) {
+                throw new NotFoundException("Case not found");
+            }
+            throw new ForbiddenException("Only support users and admins can reassign cases");
+        } else {
+            throw new ForbiddenException("Only support users and admins can reassign cases");
+        }
+
+        String assignee = body.assigneeUserId().trim();
+        if (!assignments.existsByTenantIdAndSupportUserIdAndAccountId(c.getTenantId(), assignee, c.getAccountId())) {
+            throw new IllegalArgumentException("Invalid assignee");
+        }
+        c.setAssigneeUserId(assignee);
+        return CaseAssignmentResponse.of(cases.save(c));
+    }
+}
