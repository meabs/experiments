+    /** Back-office support operation: move a case to another support user in the same tenant. */
+    @PutMapping("/api/support/cases/{caseId}/assignee")
+    @PreAuthorize("hasAnyRole('SUPPORT', 'ADMIN') && hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public CaseAssignment reassign(@PathVariable String caseId, @Valid @RequestBody AssigneeUpdate body) {
+        CurrentUser user = users.current();
+        SupportCase c = cases.findById(caseId)
+            .filter(found -> user.inTenant(found.getTenantId()))
+            .orElseThrow(() -> new NotFoundException("Case not found"));
+        c.setAssigneeUserId(body.assigneeUserId().trim());
+        return CaseAssignment.of(cases.save(c));
+    }
