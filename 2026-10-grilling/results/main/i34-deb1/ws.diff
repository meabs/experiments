+package com.example.accounts.cases;
+
+import java.time.Instant;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotBlank;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.NotFoundException;
+
+/** Back-office operations on support cases. */
+@RestController
+@RequestMapping("/api/support/cases")
+public class SupportCaseController {
+
+    public record AssigneeRequest(@NotBlank String assigneeUserId) {
+    }
+
+    public record CaseAssignment(String id, Long accountId, String subject, String status, String assigneeUserId,
+                                 Instant openedAt) {
+        static CaseAssignment of(SupportCase c) {
+            return new CaseAssignment(c.getId(), c.getAccountId(), c.getSubject(), c.getStatus(),
+                c.getAssigneeUserId(), c.getOpenedAt());
+        }
+    }
+
+    private final SupportCaseRepository cases;
+    private final CurrentUserProvider users;
+
+    public SupportCaseController(SupportCaseRepository cases, CurrentUserProvider users) {
+        this.cases = cases;
+        this.users = users;
+    }
+
+    @PutMapping("/{caseId}/assignee")
+    @PreAuthorize("(hasRole('SUPPORT') or hasRole('ADMIN')) and hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public CaseAssignment reassign(@PathVariable String caseId, @Valid @RequestBody AssigneeRequest body) {
+        CurrentUser user = users.current();
+        SupportCase c = cases.findById(caseId)
+            .filter(found -> user.inTenant(found.getTenantId())
+                && (user.isAdmin() || user.id().equals(found.getAssigneeUserId())))
+            .orElseThrow(() -> new NotFoundException("Case not found"));
+        c.assignTo(body.assigneeUserId().trim());
+        return CaseAssignment.of(cases.save(c));
+    }
+}
