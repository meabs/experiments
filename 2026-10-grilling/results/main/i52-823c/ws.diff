+            .andExpect(jsonPath("$[0].id").value(1));
+    }
+
+    @Test
+    void transactionsAcceptOneSidedDateFilters() throws Exception {
+        getWith(TestTokens.of(ALICE).scopes("transactions:read"), "/api/accounts/1/transactions?from=2026-09-30")
+            .andExpect(status().isOk()).andExpect(jsonPath("$[*].id", containsInAnyOrder(2)));
