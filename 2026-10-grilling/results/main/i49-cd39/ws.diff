+    public List<AccountView> list(@RequestParam MultiValueMap<String, String> queryParams) {
+        Account.Status status = parseStatus(queryParams.get("status"));
+        return service.listVisible().stream()
+            .filter(a -> status == null || a.getStatus() == status)
+            .map(AccountView::of)
+            .toList();
+    }
+
+    private static Account.Status parseStatus(List<String> statuses) {
+        if (statuses == null || statuses.isEmpty()) {
+            return null;
+        }
+        if (statuses.size() != 1) {
+            throw new IllegalArgumentException("status must be specified once");
+        }
+        try {
+            return Account.Status.valueOf(statuses.get(0));
+        } catch (IllegalArgumentException e) {
+            throw new IllegalArgumentException("status must be OPEN or CLOSED", e);
+        }
     }
 
