+        Account account = service.getVisible(accountId);
+        if (!access.isAssignedSupport(user, account) && !access.isTenantAdmin(user, account.getTenantId())) {
+            throw new ForbiddenException("Only assigned support or an admin can freeze an account");
+        }
+        if (body == null) {
+            throw new IllegalArgumentException("Invalid reason");
+        }
+        return AccountView.of(service.freeze(account, body.trimmedReason(), user.id()));
+    }
