+
+    @Transactional
+    public Account freeze(Account account, String reason, String author) {
+        if (account.getStatus() != Account.Status.OPEN) {
+            throw new ConflictException("Account is not open");
+        }
+        account.setStatus(Account.Status.FROZEN);
+        accounts.save(account);
+        notes.save(new AccountNote(account.getId(), author, "Account frozen: " + reason, true, Instant.now()));
+        return account;
+    }
+
+    @Transactional
+    public Account unfreeze(Account account, String author) {
+        if (account.getStatus() != Account.Status.FROZEN) {
+            throw new ConflictException("Account is not frozen");
+        }
+        account.setStatus(Account.Status.OPEN);
+        accounts.save(account);
+        notes.save(new AccountNote(account.getId(), author, "Account unfrozen", true, Instant.now()));
+        return account;
+    }
 }
