     public List<TransactionView> transactions(@PathVariable Long accountId) {
         return service.transactions(accountId).stream().map(TransactionView::of).toList();
     }
+
+    @PatchMapping("/{accountId}/notes/{noteId}")
+    @PreAuthorize("hasAnyRole('SUPPORT', 'ADMIN') and hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public NoteView updateNote(@PathVariable Long accountId, @PathVariable Long noteId,
+                               @RequestBody JsonNode patch) {
+        // getVisible deliberately gives 404 for accounts outside the caller's permitted scope.
+        service.getVisible(accountId);
+        if (patch == null || !patch.isObject() || patch.isEmpty()
+            || !patch.fieldNames().hasNext()
+            || !allPatchFields(patch)) {
+            throw new IllegalArgumentException("A note update must contain body or internal");
+        }
+        boolean hasBody = patch.has("body");
+        boolean hasInternal = patch.has("internal");
+        if (!hasBody && !hasInternal) {
+            throw new IllegalArgumentException("A note update must contain body or internal");
+        }
+        JsonNode bodyNode = patch.get("body");
+        String body = null;
+        if (hasBody) {
+            if (!bodyNode.isTextual()) {
+                throw new IllegalArgumentException("Invalid note body");
+            }
+            body = bodyNode.textValue().trim();
+            if (body.isEmpty() || body.length() > 2000) {
+                throw new IllegalArgumentException("Invalid note body");
+            }
+        }
+        JsonNode internalNode = patch.get("internal");
+        if (hasInternal && !internalNode.isBoolean()) {
+            throw new IllegalArgumentException("Invalid internal value");
+        }
+        AccountNote note = notes.findByIdAndAccountId(noteId, accountId)
+            .orElseThrow(() -> new NotFoundException("Note not found"));
+        if (body != null) {
+            note.updateBody(body);
+        }
+        if (hasInternal) {
+            note.updateInternal(internalNode.booleanValue());
+        }
+        return NoteView.of(note);
+    }
+
+    private static boolean allPatchFields(JsonNode patch) {
+        var fields = patch.fieldNames();
+        while (fields.hasNext()) {
+            String name = fields.next();
+            if (!Set.of("body", "internal").contains(name)) {
+                return false;
+            }
+        }
+        return true;
+    }
 }
