+package com.example.accounts.cases;
+
+import java.time.Instant;
+import java.util.List;
+import java.util.Map;
+import java.util.function.Function;
+import java.util.stream.Collectors;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotBlank;
+import jakarta.validation.constraints.NotEmpty;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.NotFoundException;
+
+/** Admin operations on the support-case inbox. */
+@RestController
+@RequestMapping("/api/support/cases")
+public class SupportCaseAssignmentController {
+
+    public record AssignCasesRequest(@NotEmpty List<@NotBlank String> caseIds, @NotBlank String assigneeUserId) {
+    }
+
+    public record AssignedCase(String id, Long accountId, String subject, String status, String assigneeUserId,
+                               Instant openedAt) {
+        static AssignedCase of(SupportCase c) {
+            return new AssignedCase(c.getId(), c.getAccountId(), c.getSubject(), c.getStatus(),
+                c.getAssigneeUserId(), c.getOpenedAt());
+        }
+    }
+
+    private final SupportCaseRepository cases;
+    private final CurrentUserProvider users;
+
+    public SupportCaseAssignmentController(SupportCaseRepository cases, CurrentUserProvider users) {
+        this.cases = cases;
+        this.users = users;
+    }
+
+    @PostMapping("/assign")
+    @PreAuthorize("hasRole('ADMIN') and hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public List<AssignedCase> assign(@Valid @RequestBody AssignCasesRequest body) {
+        String tenantId = users.current().tenantId();
+        List<SupportCase> found = cases.findAllById(body.caseIds());
+        Map<String, SupportCase> byId = found.stream()
+            .collect(Collectors.toMap(SupportCase::getId, Function.identity()));
+
+        // Preflight every case before changing any of them (including tenant visibility).
+        if (byId.size() != body.caseIds().stream().distinct().count()
+                || tenantId == null
+                || body.caseIds().stream().anyMatch(id -> !byId.containsKey(id)
+                    || !tenantId.equals(byId.get(id).getTenantId()))) {
+            throw new NotFoundException("Case not found");
+        }
+
+        body.caseIds().stream().distinct().map(byId::get)
+            .forEach(c -> c.assignTo(body.assigneeUserId().trim()));
+        return body.caseIds().stream().distinct().map(byId::get).map(AssignedCase::of).toList();
+    }
+}
