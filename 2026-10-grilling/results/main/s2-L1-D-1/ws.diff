     public List<Transaction> transactions(Long accountId) {
         return transactions.findByAccountIdOrderByBookedOnDescIdDesc(getVisible(accountId).getId());
     }
+
+    @Transactional
+    public List<Account> freezeCustomer(String customerId, String reason) {
+        CurrentUser user = users.current();
+        customers.findByIdAndTenantId(customerId, user.tenantId())
+            .orElseThrow(() -> new NotFoundException("Customer not found"));
+        List<Account> customerAccounts = accounts.findByTenantIdAndCustomerIdOrderById(user.tenantId(), customerId);
+        for (Account account : customerAccounts) {
+            if (account.getStatus() == Account.Status.OPEN) {
+                account.setStatus(Account.Status.FROZEN);
+                notes.save(new AccountNote(account.getId(), user.id(), "Account frozen: " + reason, true));
+            }
+        }
+        return customerAccounts;
+    }
 }
