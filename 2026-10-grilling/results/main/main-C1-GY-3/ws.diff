diff --git a/src/main/java/com/example/accounts/account/AccountController.java b/src/main/java/com/example/accounts/account/AccountController.java
index bc6eb2e..bcb79db 100644
--- a/src/main/java/com/example/accounts/account/AccountController.java
+++ b/src/main/java/com/example/accounts/account/AccountController.java
@@ -8,6 +8,7 @@ import org.springframework.security.access.prepost.PreAuthorize;
 import org.springframework.web.bind.annotation.GetMapping;
 import org.springframework.web.bind.annotation.PathVariable;
 import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
 import org.springframework.web.bind.annotation.RestController;
 
 @RestController
@@ -47,7 +48,25 @@ public class AccountController {
     /** Needs the transactions:read scope as well as access to the account. */
     @GetMapping("/{accountId}/transactions")
     @PreAuthorize("hasAuthority('SCOPE_transactions:read')")
-    public List<TransactionView> transactions(@PathVariable Long accountId) {
-        return service.transactions(accountId).stream().map(TransactionView::of).toList();
+    public List<TransactionView> transactions(@PathVariable Long accountId,
+                                              @RequestParam(required = false) String from,
+                                              @RequestParam(required = false) String to) {
+        LocalDate fromDate = parseDate(from);
+        LocalDate toDate = parseDate(to);
+        if (fromDate != null && toDate != null && fromDate.isAfter(toDate)) {
+            throw new IllegalArgumentException("from must not be later than to");
+        }
+        return service.transactions(accountId, fromDate, toDate).stream().map(TransactionView::of).toList();
+    }
+
+    private static LocalDate parseDate(String value) {
+        if (value == null) {
+            return null;
+        }
+        try {
+            return LocalDate.parse(value);
+        } catch (RuntimeException e) {
+            throw new IllegalArgumentException("Invalid date");
+        }
     }
 }
diff --git a/src/main/java/com/example/accounts/account/AccountService.java b/src/main/java/com/example/accounts/account/AccountService.java
index c1dfaa8..d591e8d 100644
--- a/src/main/java/com/example/accounts/account/AccountService.java
+++ b/src/main/java/com/example/accounts/account/AccountService.java
@@ -1,5 +1,6 @@
 package com.example.accounts.account;
 
+import java.time.LocalDate;
 import java.util.List;
 
 import org.springframework.stereotype.Service;
@@ -66,4 +67,19 @@ public class AccountService {
     public List<Transaction> transactions(Long accountId) {
         return transactions.findByAccountIdOrderByBookedOnDescIdDesc(getVisible(accountId).getId());
     }
+
+    public List<Transaction> transactions(Long accountId, LocalDate from, LocalDate to) {
+        Long visibleAccountId = getVisible(accountId).getId();
+        if (from != null && to != null) {
+            return transactions.findByAccountIdAndBookedOnBetweenOrderByBookedOnDescIdDesc(visibleAccountId, from, to);
+        }
+        if (from != null) {
+            return transactions.findByAccountIdAndBookedOnGreaterThanEqualOrderByBookedOnDescIdDesc(visibleAccountId,
+                from);
+        }
+        if (to != null) {
+            return transactions.findByAccountIdAndBookedOnLessThanEqualOrderByBookedOnDescIdDesc(visibleAccountId, to);
+        }
+        return transactions.findByAccountIdOrderByBookedOnDescIdDesc(visibleAccountId);
+    }
 }
