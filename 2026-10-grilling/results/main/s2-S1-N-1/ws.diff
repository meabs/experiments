+
+    @Transactional
+    public AccountNote updateNote(Long accountId, Long noteId, String body, Boolean internal) {
+        Account account = getVisible(accountId);
+        AccountNote note = notes.findById(noteId)
+            .filter(n -> account.getId().equals(n.getAccountId()))
+            .orElseThrow(() -> new NotFoundException("Note not found"));
+        if (body != null) {
+            note.setBody(body);
+        }
+        if (internal != null) {
+            note.setInternal(internal);
+        }
