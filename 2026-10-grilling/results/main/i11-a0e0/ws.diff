+    /** The assigned support user or a tenant admin closes a case with its resolution. */
+    @PostMapping("/api/support/cases/{caseId}/close")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public CaseSummary close(@PathVariable String caseId, @Valid @RequestBody CloseCase body) {
+        String resolution = body.resolution().trim();
+        if (resolution.isEmpty() || resolution.length() > 2000) {
+            throw new IllegalArgumentException("Invalid resolution");
+        }
+
+        CurrentUser user = users.current();
+        SupportCase supportCase = cases.findById(caseId)
+            .orElseThrow(() -> new NotFoundException("Case not found"));
+
+        boolean admin = access.isTenantAdmin(user, supportCase.getTenantId());
+        boolean assignee = user.isSupport() && user.inTenant(supportCase.getTenantId())
+            && user.id().equals(supportCase.getAssigneeUserId());
+        if (!admin && !assignee) {
+            boolean customerCanSee = user.isCustomer() && user.inTenant(supportCase.getTenantId())
+                && customers.findById(supportCase.getCustomerId())
+                    .map(c -> user.id().equals(c.getUserId())).orElse(false);
+            if (customerCanSee) {
+                throw new ForbiddenException("Only the assigned support user or an admin can close a case");
+            }
+            throw new NotFoundException("Case not found");
+        }
+        if ("CLOSED".equals(supportCase.getStatus())) {
+            throw new ConflictException("Case is already closed");
+        }
+        supportCase.close(resolution);
+        return CaseSummary.of(supportCase);
+    }
