+    @PostMapping("/{accountId}/notes")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @ResponseStatus(HttpStatus.CREATED)
+    @Transactional
+    public NoteView addNote(@PathVariable Long accountId, @Valid @RequestBody NewNote body) {
+        CurrentUser user = users.current();
+        Account account = service.getVisible(accountId);
+        if (!access.isAssignedSupport(user, account) && !access.isTenantAdmin(user, account.getTenantId())) {
+            throw new ForbiddenException("Only support staff can add account notes");
+        }
+        if (!body.internal().isBoolean()) {
+            throw new IllegalArgumentException("Invalid internal flag");
+        }
+        String trimmed = body.body().trim();
+        if (trimmed.length() < 1 || trimmed.length() > 2000) {
+            throw new IllegalArgumentException("Invalid note body");
+        }
+        AccountNote note = new AccountNote(account.getId(), user.id(), trimmed, body.internal().booleanValue(), Instant.now());
+        return NoteView.of(notes.save(note));
+    }
