+package com.example.accounts.cases;
+
+import java.time.Instant;
+import java.util.ArrayList;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.function.Function;
+import java.util.stream.Collectors;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotBlank;
+import jakarta.validation.constraints.NotEmpty;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.NotFoundException;
+
+/** Administrative bulk assignment of support cases. */
+@RestController
+@RequestMapping("/api/support/cases")
+public class CaseAssignmentController {
+
+    public record AssignCasesRequest(@NotEmpty List<@NotBlank String> caseIds, @NotBlank String assigneeUserId) {
+    }
+
+    public record AssignedCase(String id, Long accountId, String subject, String status, String assigneeUserId,
+                               Instant openedAt) {
+        static AssignedCase of(SupportCase c) {
+            return new AssignedCase(c.getId(), c.getAccountId(), c.getSubject(), c.getStatus(), c.getAssigneeUserId(),
+                c.getOpenedAt());
+        }
+    }
+
+    private final SupportCaseRepository cases;
+    private final CurrentUserProvider users;
+
+    public CaseAssignmentController(SupportCaseRepository cases, CurrentUserProvider users) {
+        this.cases = cases;
+        this.users = users;
+    }
+
+    @PostMapping("/assign")
+    @PreAuthorize("hasRole('ADMIN') && hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public List<AssignedCase> assign(@Valid @RequestBody AssignCasesRequest body) {
+        CurrentUser user = users.current();
+        List<String> requestedIds = new ArrayList<>(new LinkedHashSet<>(body.caseIds()));
+        Map<String, SupportCase> found = cases.findAllById(requestedIds).stream()
+            .collect(Collectors.toMap(SupportCase::getId, Function.identity()));
+
+        // A bulk update is all-or-nothing: do not reveal or modify cases outside the admin's tenant.
+        for (String id : requestedIds) {
+            SupportCase supportCase = found.get(id);
+            if (supportCase == null || !user.inTenant(supportCase.getTenantId())) {
+                throw new NotFoundException("Case not found");
+            }
+        }
+
+        List<AssignedCase> result = new ArrayList<>(requestedIds.size());
+        for (String id : requestedIds) {
+            SupportCase supportCase = found.get(id);
+            supportCase.assignTo(body.assigneeUserId().trim());
+            result.add(AssignedCase.of(supportCase));
+        }
+        return result;
+    }
+}
