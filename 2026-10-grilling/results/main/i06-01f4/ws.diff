+package com.example.accounts.cases;
+
+import java.time.Instant;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotBlank;
+import jakarta.validation.constraints.Size;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.account.SupportAssignmentRepository;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.NotFoundException;
+
+/** Back-office operations on support cases. */
+@RestController
+@RequestMapping("/api/support/cases")
+public class SupportCaseAssignmentController {
+
+    public record ReassignRequest(@NotBlank @Size(max = 200) String assigneeUserId) {
+    }
+
+    public record CaseAssignment(String id, Long accountId, String subject, String status, String assigneeUserId,
+                                 Instant openedAt) {
+        static CaseAssignment of(SupportCase c) {
+            return new CaseAssignment(c.getId(), c.getAccountId(), c.getSubject(), c.getStatus(),
+                c.getAssigneeUserId(), c.getOpenedAt());
+        }
+    }
+
+    private final SupportCaseRepository cases;
+    private final SupportAssignmentRepository assignments;
+    private final CurrentUserProvider users;
+
+    public SupportCaseAssignmentController(SupportCaseRepository cases, SupportAssignmentRepository assignments,
+                                           CurrentUserProvider users) {
+        this.cases = cases;
+        this.assignments = assignments;
+        this.users = users;
+    }
+
+    @PutMapping("/{caseId}/assignee")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @ResponseStatus(HttpStatus.OK)
+    @Transactional
+    public CaseAssignment reassign(@PathVariable String caseId, @Valid @RequestBody ReassignRequest body) {
+        CurrentUser user = users.current();
+        SupportCase supportCase = cases.findById(caseId)
+            .filter(c -> canSee(user, c))
+            .orElseThrow(() -> new NotFoundException("Case not found"));
+
+        if (!assignments.existsByTenantIdAndSupportUserIdAndAccountId(supportCase.getTenantId(), body.assigneeUserId(),
+            supportCase.getAccountId())) {
+            throw new IllegalArgumentException("Invalid assignee");
+        }
+
+        supportCase.reassignTo(body.assigneeUserId());
+        return CaseAssignment.of(cases.save(supportCase));
+    }
+
+    private static boolean canSee(CurrentUser user, SupportCase supportCase) {
+        if (!user.inTenant(supportCase.getTenantId())) {
+            return false;
+        }
+        return user.isAdmin() || (user.isSupport() && user.id().equals(supportCase.getAssigneeUserId()));
+    }
+}
