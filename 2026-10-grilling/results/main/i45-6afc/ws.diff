+package com.example.accounts.cases;
+
+import java.time.Instant;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotBlank;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.account.AccountRepository;
+import com.example.accounts.account.SupportAssignmentRepository;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.ConflictException;
+import com.example.accounts.web.NotFoundException;
+
+/** Back-office reassignment of support cases. */
+@RestController
+@RequestMapping("/api/support/cases")
+public class CaseAssignmentController {
+
+    public record AssigneeRequest(@NotBlank String assigneeUserId) {
+    }
+
+    public record CaseAssignmentResponse(String id, Long accountId, String subject, String status,
+                                         String assigneeUserId, Instant openedAt) {
+        static CaseAssignmentResponse of(SupportCase c) {
+            return new CaseAssignmentResponse(c.getId(), c.getAccountId(), c.getSubject(), c.getStatus(),
+                c.getAssigneeUserId(), c.getOpenedAt());
+        }
+    }
+
+    private final SupportCaseRepository cases;
+    private final AccountRepository accounts;
+    private final SupportAssignmentRepository assignments;
+    private final CurrentUserProvider users;
+
+    public CaseAssignmentController(SupportCaseRepository cases, AccountRepository accounts,
+                                    SupportAssignmentRepository assignments, CurrentUserProvider users) {
+        this.cases = cases;
+        this.accounts = accounts;
+        this.assignments = assignments;
+        this.users = users;
+    }
+
+    @PutMapping("/{caseId}/assignee")
+    @PreAuthorize("hasAnyRole('ADMIN', 'SUPPORT') and hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public CaseAssignmentResponse reassign(@PathVariable String caseId, @Valid @RequestBody AssigneeRequest body) {
+        CurrentUser user = users.current();
+        SupportCase supportCase = cases.findById(caseId)
+            .filter(c -> user.inTenant(c.getTenantId()))
+            .orElseThrow(() -> new NotFoundException("Case not found"));
+
+        if (!user.isAdmin() && !user.id().equals(supportCase.getAssigneeUserId())) {
+            throw new NotFoundException("Case not found");
+        }
+        if ("CLOSED".equals(supportCase.getStatus())) {
+            throw new ConflictException("Case is closed");
+        }
+        if (accounts.findById(supportCase.getAccountId())
+                .filter(a -> supportCase.getTenantId().equals(a.getTenantId())).isEmpty()) {
+            throw new ConflictException("Case account is not available");
+        }
+        String assigneeId = body.assigneeUserId().trim();
+        if (!assignments.existsByTenantIdAndSupportUserIdAndAccountId(
+                supportCase.getTenantId(), assigneeId, supportCase.getAccountId())) {
+            throw new IllegalArgumentException("Invalid assignee");
+        }
+
+        supportCase.assignTo(assigneeId);
+        return CaseAssignmentResponse.of(supportCase);
+    }
+}
