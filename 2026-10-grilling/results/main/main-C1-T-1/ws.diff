diff --git a/src/test/java/com/example/accounts/AccountApiTest.java b/src/test/java/com/example/accounts/AccountApiTest.java
index 7f7cf0b..3d5e34e 100644
--- a/src/test/java/com/example/accounts/AccountApiTest.java
