@@ -71,4 +71,28 @@ class AccountApiTest extends ApiTest {
         getWith(TestTokens.of(BOB).scopes("transactions:read"), "/api/accounts/1/transactions")
             .andExpect(status().isNotFound());
     }
+
+    @Test
+    void transactionsCanBeFilteredByInclusiveDateRange() throws Exception {
+        getWith(TestTokens.of(ALICE).scopes("transactions:read"),
+                "/api/accounts/1/transactions?from=2026-09-29&to=2026-09-30")
+            .andExpect(status().isOk()).andExpect(jsonPath("$[*].id", containsInAnyOrder(2)));
+    }
+
+    @Test
+    void transactionsAllowOneSidedDateFilters() throws Exception {
+        getWith(TestTokens.of(ALICE).scopes("transactions:read"), "/api/accounts/1/transactions?to=2026-09-28")
+            .andExpect(status().isOk()).andExpect(jsonPath("$[*].id", containsInAnyOrder(1)));
+        getWith(TestTokens.of(ALICE).scopes("transactions:read"), "/api/accounts/1/transactions?from=2026-09-30")
+            .andExpect(status().isOk()).andExpect(jsonPath("$[*].id", containsInAnyOrder(2)));
+    }
+
+    @Test
+    void invalidTransactionDateFiltersAreRejected() throws Exception {
+        getWith(TestTokens.of(ALICE).scopes("transactions:read"), "/api/accounts/1/transactions?from=not-a-date")
+            .andExpect(status().isBadRequest());
+        getWith(TestTokens.of(ALICE).scopes("transactions:read"),
+                "/api/accounts/1/transactions?from=2026-10-01&to=2026-09-01")
+            .andExpect(status().isBadRequest());
+    }
 }
