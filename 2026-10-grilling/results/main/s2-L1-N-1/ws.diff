+
+    /** Freeze every open account belonging to a customer in the specified tenant. */
+    @Transactional
+    public List<Account> freezeCustomer(String customerId, String tenantId) {
+        List<Account> found = accounts.findByTenantIdAndCustomerIdOrderById(tenantId, customerId);
+        found.stream()
+            .filter(account -> account.getStatus() == Account.Status.OPEN)
+            .forEach(account -> account.setStatus(Account.Status.FROZEN));
+        return found;
+    }
 }
