+package com.example.accounts.customer;
+
+import java.util.List;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.account.Account;
+import com.example.accounts.account.AccountController.AccountView;
+import com.example.accounts.account.AccountService;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.NotFoundException;
+
+/** Back-office actions on all accounts belonging to a customer. */
+@RestController
+public class CustomerFreezeController {
+
+    public record FreezeRequest(String reason) {
+    }
+
+    private final CustomerRepository customers;
+    private final AccountService accounts;
+    private final CurrentUserProvider users;
+
+    public CustomerFreezeController(CustomerRepository customers, AccountService accounts, CurrentUserProvider users) {
+        this.customers = customers;
+        this.accounts = accounts;
+        this.users = users;
+    }
+
+    @PostMapping("/api/customers/{customerId}/freeze")
+    @PreAuthorize("hasRole('ADMIN') and hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public List<AccountView> freeze(@PathVariable String customerId, @RequestBody FreezeRequest request) {
+        if (request == null || request.reason() == null) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        String reason = request.reason().trim();
+        if (reason.length() < 1 || reason.length() > 500) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+
+        CurrentUser user = users.current();
+        Customer customer = customers.findByIdAndTenantId(customerId, user.tenantId())
+            .orElseThrow(() -> new NotFoundException("Customer not found"));
+        return accounts.freezeCustomer(customer.getId(), customer.getTenantId()).stream().map(AccountView::of).toList();
+    }
+}
