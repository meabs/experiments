+++ b/src/test/java/com/example/accounts/CaseApiTest.java
@@ -40,4 +40,54 @@ class CaseApiTest extends ApiTest {
     void supportCannotRaiseCases() throws Exception {
         postAs(SAM, "/api/cases", "{\"accountId\":1,\"subject\":\"Lost card\"}").andExpect(status().isForbidden());
     }
+
+    @Test
+    void assignedSupportClosesCaseAndReturnsSummary() throws Exception {
+        postAs(SUE, "/api/support/cases/k-2/close", "{\"resolution\":\"  Merchant refunded the payment.  \"}")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$.id").value("k-2"))
+            .andExpect(jsonPath("$.status").value("CLOSED"))
+            .andExpect(jsonPath("$.subject").value("Disputed card payment"))
+            .andExpect(jsonPath("$.resolution").doesNotExist());
+    }
+
+    @Test
+    void nonAssigneeCannotCloseCase() throws Exception {
+        postAs(SAM, "/api/support/cases/k-2/close", "{\"resolution\":\"No\"}")
+            .andExpect(status().isForbidden());
+    }
+
+    @Test
+    void customerCannotCloseCase() throws Exception {
+        postAs(ALICE, "/api/support/cases/k-1/close", "{\"resolution\":\"No\"}")
+            .andExpect(status().isForbidden());
+    }
+
+    @Test
+    void otherTenantCannotCloseCase() throws Exception {
+        postAs(GIL, "/api/support/cases/k-1/close", "{\"resolution\":\"No\"}")
+            .andExpect(status().isNotFound());
+    }
+
+    @Test
+    void resolutionMustBeOneToTwoThousandTrimmedCharacters() throws Exception {
+        postAs(SUE, "/api/support/cases/k-2/close", "{\"resolution\":\"   \"}")
+            .andExpect(status().isBadRequest());
+        postAs(SUE, "/api/support/cases/k-2/close", "{\"resolution\":\"" + "x".repeat(2001) + "\"}")
+            .andExpect(status().isBadRequest());
+    }
+
+    @Test
+    void adminCanCloseUnassignedCase() throws Exception {
+        postAs(ADA, "/api/support/cases/k-5/close", "{\"resolution\":\"Resolved by email.\"}")
+            .andExpect(status().isOk());
+    }
+
+    @Test
+    void closingAnAlreadyClosedCaseConflicts() throws Exception {
+        postAs(SUE, "/api/support/cases/k-2/close", "{\"resolution\":\"Resolved.\"}")
+            .andExpect(status().isOk());
+        postAs(SUE, "/api/support/cases/k-2/close", "{\"resolution\":\"Again.\"}")
+            .andExpect(status().isConflict());
+    }
 }
