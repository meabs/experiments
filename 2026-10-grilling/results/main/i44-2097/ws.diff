+
+    @Test
+    void transactionsCanBeFilteredByInclusiveDateRange() throws Exception {
+        getWith(TestTokens.of(ALICE).scopes("transactions:read"),
+            "/api/accounts/1/transactions?from=2026-09-28&to=2026-09-28")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$", hasSize(1)))
+            .andExpect(jsonPath("$[0].bookedOn").value("2026-09-28"));
+    }
+
+    @Test
+    void transactionsCanUseEitherDateBound() throws Exception {
+        getWith(TestTokens.of(ALICE).scopes("transactions:read"),
+            "/api/accounts/1/transactions?from=2026-09-30")
+            .andExpect(status().isOk()).andExpect(jsonPath("$", hasSize(1)))
+            .andExpect(jsonPath("$[0].bookedOn").value("2026-09-30"));
+
+        getWith(TestTokens.of(ALICE).scopes("transactions:read"),
+            "/api/accounts/1/transactions?to=2026-09-28")
+            .andExpect(status().isOk()).andExpect(jsonPath("$", hasSize(1)))
+            .andExpect(jsonPath("$[0].bookedOn").value("2026-09-28"));
+    }
+
+    @Test
+    void invalidTransactionDateFiltersAreBadRequests() throws Exception {
+        getWith(TestTokens.of(ALICE).scopes("transactions:read"),
+            "/api/accounts/1/transactions?from=not-a-date")
+            .andExpect(status().isBadRequest()).andExpect(jsonPath("$.error").value("Invalid request"));
+
+        getWith(TestTokens.of(ALICE).scopes("transactions:read"),
+            "/api/accounts/1/transactions?from=2026-10-01&to=2026-09-01")
+            .andExpect(status().isBadRequest()).andExpect(jsonPath("$.error").value("Invalid request"));
+    }
 }
