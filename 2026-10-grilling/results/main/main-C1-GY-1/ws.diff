         getWith(TestTokens.of(BOB).scopes("transactions:read"), "/api/accounts/1/transactions")
             .andExpect(status().isNotFound());
     }
+
+    @Test
+    void transactionsCanBeFilteredByInclusiveDateRange() throws Exception {
+        var token = TestTokens.of(ALICE).scopes("transactions:read");
+        getWith(token, "/api/accounts/1/transactions?from=2026-09-28&to=2026-09-28")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$[*].id", containsInAnyOrder(1)));
+        getWith(token, "/api/accounts/1/transactions?from=2026-09-29")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$[*].id", containsInAnyOrder(2)));
+        getWith(token, "/api/accounts/1/transactions?to=2026-09-28")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$[*].id", containsInAnyOrder(1)));
+    }
+
+    @Test
+    void invalidTransactionDateFiltersAreBadRequest() throws Exception {
+        var token = TestTokens.of(ALICE).scopes("transactions:read");
+        getWith(token, "/api/accounts/1/transactions?from=2026-02-30")
+            .andExpect(status().isBadRequest());
+        getWith(token, "/api/accounts/1/transactions?from=2026-09-29&to=2026-09-28")
+            .andExpect(status().isBadRequest());
+    }
 }
