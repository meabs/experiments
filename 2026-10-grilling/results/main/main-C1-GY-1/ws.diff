@@ -1,5 +1,8 @@
 package com.example.accounts.account;
 
+import java.time.LocalDate;
+import java.time.format.DateTimeFormatter;
+import java.time.format.DateTimeParseException;
 import java.util.List;
 
 import org.springframework.stereotype.Service;
@@ -63,7 +66,40 @@ public class AccountService {
         return List.of();
     }
 
+    public List<Transaction> transactions(Long accountId, String fromValue, String toValue) {
+        Long visibleAccountId = getVisible(accountId).getId();
+        LocalDate from = parseDate(fromValue);
+        LocalDate to = parseDate(toValue);
+        if (from != null && to != null && from.isAfter(to)) {
+            throw new IllegalArgumentException("from must not be after to");
+        }
+        if (from != null && to != null) {
+            return transactions.findByAccountIdAndBookedOnBetweenOrderByBookedOnDescIdDesc(visibleAccountId, from, to);
+        }
+        if (from != null) {
+            return transactions.findByAccountIdAndBookedOnGreaterThanEqualOrderByBookedOnDescIdDesc(visibleAccountId, from);
+        }
+        if (to != null) {
+            return transactions.findByAccountIdAndBookedOnLessThanEqualOrderByBookedOnDescIdDesc(visibleAccountId, to);
+        }
+        return transactions.findByAccountIdOrderByBookedOnDescIdDesc(visibleAccountId);
+    }
+
     public List<Transaction> transactions(Long accountId) {
-        return transactions.findByAccountIdOrderByBookedOnDescIdDesc(getVisible(accountId).getId());
+        return transactions(accountId, null, null);
+    }
+
+    private static LocalDate parseDate(String value) {
+        if (value == null) {
+            return null;
+        }
+        if (!value.matches("\\d{4}-\\d{2}-\\d{2}")) {
+            throw new IllegalArgumentException("Invalid date");
+        }
+        try {
+            return LocalDate.parse(value, DateTimeFormatter.ISO_LOCAL_DATE);
+        } catch (DateTimeParseException e) {
+            throw new IllegalArgumentException("Invalid date", e);
+        }
     }
 }
