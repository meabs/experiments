+package com.example.accounts.customer;
+
+import java.util.List;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.account.AccountController.AccountView;
+import com.example.accounts.account.AccountService;
+
+/** Customer operations performed by back-office staff. */
+@RestController
+@RequestMapping("/api/customers")
+public class CustomerController {
+
+    public record FreezeRequest(String reason) {
+    }
+
+    private final AccountService accounts;
+
+    public CustomerController(AccountService accounts) {
+        this.accounts = accounts;
+    }
+
+    @PostMapping("/{customerId}/freeze")
+    @PreAuthorize("hasRole('ADMIN') and hasAuthority('SCOPE_accounts:write')")
+    public List<AccountView> freeze(@PathVariable String customerId, @RequestBody FreezeRequest body) {
+        if (body == null || body.reason() == null) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        String reason = body.reason().trim();
+        if (reason.length() < 1 || reason.length() > 500) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        return accounts.freezeCustomer(customerId).stream().map(AccountView::of).toList();
+    }
+}
