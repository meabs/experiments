     public List<Transaction> transactions(Long accountId) {
         return transactions.findByAccountIdOrderByBookedOnDescIdDesc(getVisible(accountId).getId());
     }
+
+    /** Freeze all open accounts belonging to a customer in the caller's tenant. */
+    @Transactional
+    public List<Account> freezeCustomer(String customerId) {
+        CurrentUser user = users.current();
+        var customer = customers.findByIdAndTenantId(customerId, user.tenantId())
+            .orElseThrow(() -> new NotFoundException("Customer not found"));
+        List<Account> found = accounts.findByTenantIdAndCustomerIdOrderById(customer.getTenantId(), customer.getId());
+        found.stream()
+            .filter(a -> a.getStatus() == Account.Status.OPEN)
+            .forEach(a -> a.setStatus(Account.Status.FROZEN));
+        return found;
+    }
 }
