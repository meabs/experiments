+package com.example.accounts.account;
+
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.example.accounts.security.AccessPolicy;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.ForbiddenException;
+import com.example.accounts.web.NotFoundException;
+
+@Service
+public class AccountNoteService {
+
+    private final AccountNoteRepository notes;
+    private final AccountService accounts;
+    private final AccessPolicy access;
+    private final CurrentUserProvider users;
+
+    public AccountNoteService(AccountNoteRepository notes, AccountService accounts, AccessPolicy access,
+                              CurrentUserProvider users) {
+        this.notes = notes;
+        this.accounts = accounts;
+        this.access = access;
+        this.users = users;
+    }
+
+    @Transactional
+    public AccountNote update(Long accountId, Long noteId, String body, Boolean internal,
+                              boolean bodyPresent, boolean internalPresent) {
+        Account account = accounts.getVisible(accountId);
+        CurrentUser user = users.current();
+        if (!access.isAssignedSupport(user, account) && !access.isTenantAdmin(user, account.getTenantId())) {
+            throw new ForbiddenException("Only staff can edit account notes");
+        }
+
+        AccountNote note = notes.findById(noteId)
+            .filter(n -> accountId.equals(n.getAccountId()))
+            .orElseThrow(() -> new NotFoundException("Note not found"));
+        if (bodyPresent) {
+            note.setBody(body);
+        }
+        if (internalPresent) {
+            note.setInternal(internal);
+        }
+        return note;
+    }
+}
