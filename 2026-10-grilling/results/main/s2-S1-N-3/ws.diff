+package com.example.accounts.account;
+
+import java.time.Instant;
+import java.util.Iterator;
+import java.util.Set;
+
+import com.fasterxml.jackson.databind.JsonNode;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.web.bind.annotation.PatchMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+@RestController
+@RequestMapping("/api/accounts")
+public class AccountNoteController {
+
+    public record NoteView(Long id, String author, String body, boolean internal, Instant createdAt) {
+        static NoteView of(AccountNote note) {
+            return new NoteView(note.getId(), note.getAuthor(), note.getBody(), note.isInternal(), note.getCreatedAt());
+        }
+    }
+
+    private record UpdateFields(String body, Boolean internal, boolean bodyPresent, boolean internalPresent) {
+    }
+
+    private static final Set<String> ALLOWED_FIELDS = Set.of("body", "internal");
+
+    private final AccountNoteService notes;
+
+    public AccountNoteController(AccountNoteService notes) {
+        this.notes = notes;
+    }
+
+    @PatchMapping("/{accountId}/notes/{noteId}")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    public NoteView update(@PathVariable Long accountId, @PathVariable Long noteId, @RequestBody JsonNode request) {
+        UpdateFields fields = parse(request);
+        return NoteView.of(notes.update(accountId, noteId, fields.body(), fields.internal(),
+            fields.bodyPresent(), fields.internalPresent()));
+    }
+
+    private static UpdateFields parse(JsonNode request) {
+        if (request == null || !request.isObject()) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        Iterator<String> names = request.fieldNames();
+        while (names.hasNext()) {
+            if (!ALLOWED_FIELDS.contains(names.next())) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+        }
+
+        boolean bodyPresent = request.has("body");
+        boolean internalPresent = request.has("internal");
+        if (!bodyPresent && !internalPresent) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+
+        String body = null;
+        if (bodyPresent) {
+            JsonNode value = request.get("body");
+            if (value == null || !value.isTextual()) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+            body = value.textValue().trim();
+            if (body.isEmpty() || body.length() > 2000) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+        }
+
+        Boolean internal = null;
+        if (internalPresent) {
+            JsonNode value = request.get("internal");
+            if (value == null || !value.isBoolean()) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+            internal = value.booleanValue();
+        }
+        return new UpdateFields(body, internal, bodyPresent, internalPresent);
+    }
+}
