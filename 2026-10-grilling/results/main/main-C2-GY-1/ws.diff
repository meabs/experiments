+    public List<AccountView> list(@RequestParam MultiValueMap<String, String> parameters) {
+        Account.Status status = parseStatus(parameters.get("status"));
+        return service.listVisible().stream()
+            .filter(account -> status == null || account.getStatus() == status)
+            .map(AccountView::of).toList();
+    }
+
+    private static Account.Status parseStatus(List<String> statuses) {
+        if (statuses == null) {
+            return null;
+        }
+        if (statuses.size() != 1) {
+            throw new IllegalArgumentException("Only one status may be specified");
+        }
+        return Account.Status.valueOf(statuses.get(0));
     }
 
