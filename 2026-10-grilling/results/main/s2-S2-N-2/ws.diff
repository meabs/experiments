+package com.example.accounts.cases;
+
+import jakarta.validation.Valid;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.customer.CustomerRepository;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.ConflictException;
+import com.example.accounts.web.ForbiddenException;
+import com.example.accounts.web.NotFoundException;
+
+/** Staff operations on support cases. */
+@RestController
+@RequestMapping("/api/support/cases")
+public class SupportCaseController {
+
+    public record ReopenRequest(String reason) {
+    }
+
+    private final SupportCaseRepository cases;
+    private final CustomerRepository customers;
+    private final CurrentUserProvider users;
+
+    public SupportCaseController(SupportCaseRepository cases, CustomerRepository customers,
+                                 CurrentUserProvider users) {
+        this.cases = cases;
+        this.customers = customers;
+        this.users = users;
+    }
+
+    @PostMapping("/{caseId}/reopen")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @ResponseStatus(HttpStatus.OK)
+    @Transactional
+    public CaseController.CaseSummary reopen(@PathVariable String caseId,
+                                              @Valid @RequestBody ReopenRequest body) {
+        CurrentUser user = users.current();
+        SupportCase supportCase = cases.findById(caseId)
+            .filter(c -> user.inTenant(c.getTenantId()))
+            .orElseThrow(() -> new NotFoundException("Case not found"));
+
+        boolean admin = user.isAdmin();
+        boolean assignedSupport = user.isSupport() && user.id().equals(supportCase.getAssigneeUserId());
+        if (!admin && !assignedSupport) {
+            boolean ownCustomerCase = user.isCustomer() && customers.findById(supportCase.getCustomerId())
+                .map(customer -> user.id().equals(customer.getUserId()))
+                .orElse(false);
+            if (ownCustomerCase) {
+                throw new ForbiddenException("Only the assigned support user or an admin can reopen a case");
+            }
+            // A support user can only see cases assigned to them; other staff and other tenants get an opaque 404.
+            throw new NotFoundException("Case not found");
+        }
+
+        if (body == null || body.reason() == null) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        String reason = body.reason().trim();
+        if (reason.length() < 1 || reason.length() > 2000) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        if (!"CLOSED".equals(supportCase.getStatus())) {
+            throw new ConflictException("Case is not closed");
+        }
+
+        supportCase.reopen();
+        return CaseController.CaseSummary.of(cases.save(supportCase));
+    }
+}
