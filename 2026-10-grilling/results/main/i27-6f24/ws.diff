+    @PostMapping("/{accountId}/freeze")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write') and (hasRole('SUPPORT') or hasRole('ADMIN'))")
+    public AccountView freeze(@PathVariable Long accountId, @RequestBody FreezeRequest request) {
+        if (request == null || request.reason() == null) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        String reason = request.reason().trim();
+        if (reason.length() < 1 || reason.length() > 500) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        return AccountView.of(service.freeze(accountId, reason));
+    }
+
