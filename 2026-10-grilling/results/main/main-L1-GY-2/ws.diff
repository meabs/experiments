 import com.example.accounts.security.CurrentUser;
 import com.example.accounts.security.CurrentUserProvider;
 import com.example.accounts.web.NotFoundException;
+import com.example.accounts.web.ConflictException;
 
 @Service
 @Transactional(readOnly = true)
@@ -66,4 +67,39 @@ public class AccountService {
     public List<Transaction> transactions(Long accountId) {
         return transactions.findByAccountIdOrderByBookedOnDescIdDesc(getVisible(accountId).getId());
     }
+
+    @Transactional
+    public Account freeze(Long accountId, String reason) {
+        if (reason == null) {
+            throw new IllegalArgumentException("Freeze reason is required");
+        }
+        String trimmed = reason.trim();
+        if (trimmed.isEmpty() || trimmed.length() > 500) {
+            throw new IllegalArgumentException("Freeze reason must be between 1 and 500 characters");
+        }
+        Account account = getVisible(accountId);
+        if (account.getStatus() == Account.Status.FROZEN) {
+            return account;
+        }
+        if (account.getStatus() != Account.Status.OPEN) {
+            throw new ConflictException("Account is not open");
+        }
+        account.setStatus(Account.Status.FROZEN);
+        account.setFreezeReason(trimmed);
+        return account;
+    }
+
+    @Transactional
+    public Account unfreeze(Long accountId) {
+        Account account = getVisible(accountId);
+        if (account.getStatus() == Account.Status.OPEN) {
+            return account;
+        }
+        if (account.getStatus() != Account.Status.FROZEN) {
+            throw new ConflictException("Account is not frozen");
+        }
+        account.setStatus(Account.Status.OPEN);
+        account.setFreezeReason(null);
+        return account;
+    }
 }
