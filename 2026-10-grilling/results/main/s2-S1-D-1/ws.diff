+
+    @Transactional
+    public AccountNote updateNote(Long accountId, Long noteId, String body, Boolean internal) {
+        // Resolving the account first preserves the API's 404-for-invisible-resource convention.
+        Account account = getVisible(accountId);
+        AccountNote note = notes.findByIdAndAccountId(noteId, account.getId())
+            .orElseThrow(() -> new NotFoundException("Note not found"));
+        if (body != null) {
+            note.updateBody(body);
+        }
+        if (internal != null) {
+            note.updateInternal(internal);
+        }
