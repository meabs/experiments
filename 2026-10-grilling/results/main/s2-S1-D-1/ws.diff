+    /** Staff may correct note text and/or its internal classification. */
+    @PatchMapping("/{accountId}/notes/{noteId}")
+    @PreAuthorize("hasAnyRole('SUPPORT', 'ADMIN') && hasAuthority('SCOPE_accounts:write')")
+    public NoteView updateNote(@PathVariable Long accountId, @PathVariable Long noteId, @RequestBody JsonNode request) {
+        if (request == null || !request.isObject()) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        JsonNode bodyNode = request.get("body");
+        JsonNode internalNode = request.get("internal");
+        if (bodyNode == null && internalNode == null) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        String body = null;
+        if (bodyNode != null) {
+            if (!bodyNode.isTextual()) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+            body = bodyNode.textValue().trim();
+            if (body.length() < 1 || body.length() > 2000) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+        }
+        Boolean internal = null;
+        if (internalNode != null) {
+            if (!internalNode.isBoolean()) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+            internal = internalNode.booleanValue();
+        }
+        return NoteView.of(service.updateNote(accountId, noteId, body, internal));
