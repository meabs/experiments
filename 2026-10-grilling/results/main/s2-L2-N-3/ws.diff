+package com.example.accounts.cases;
+
+import java.time.Instant;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotBlank;
+import jakarta.validation.constraints.NotEmpty;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.NotFoundException;
+
+/** Administrative operations on the support-case inbox. */
+@RestController
+@RequestMapping("/api/support/cases")
+public class AdminCaseController {
+
+    public record AssignCasesRequest(
+        @NotEmpty List<@NotBlank String> caseIds,
+        @NotBlank String assigneeUserId) {
+    }
+
+    public record AssignedCase(String id, Long accountId, String subject, String status,
+                               String assigneeUserId, Instant openedAt) {
+        static AssignedCase of(SupportCase c) {
+            return new AssignedCase(c.getId(), c.getAccountId(), c.getSubject(), c.getStatus(),
+                c.getAssigneeUserId(), c.getOpenedAt());
+        }
+    }
+
+    private final SupportCaseRepository cases;
+    private final CurrentUserProvider users;
+
+    public AdminCaseController(SupportCaseRepository cases, CurrentUserProvider users) {
+        this.cases = cases;
+        this.users = users;
+    }
+
+    @PostMapping("/assign")
+    @PreAuthorize("hasRole('ADMIN') and hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public List<AssignedCase> assign(@Valid @RequestBody AssignCasesRequest body) {
+        String tenantId = users.current().tenantId();
+        List<String> requestedIds = body.caseIds();
+
+        Map<String, SupportCase> found = new LinkedHashMap<>();
+        cases.findAllById(requestedIds).forEach(c -> found.put(c.getId(), c));
+        if (found.size() != requestedIds.stream().distinct().count()
+                || found.values().stream().anyMatch(c -> !tenantId.equals(c.getTenantId()))) {
+            throw new NotFoundException("Case not found");
+        }
+
+        found.values().forEach(c -> c.assignTo(body.assigneeUserId().trim()));
+        // Keep the request's order in the response while avoiding duplicate entries.
+        return requestedIds.stream().distinct().map(found::get).map(AssignedCase::of).toList();
+    }
+}
