@@ -47,7 +49,28 @@ public class AccountController {
     /** Needs the transactions:read scope as well as access to the account. */
     @GetMapping("/{accountId}/transactions")
     @PreAuthorize("hasAuthority('SCOPE_transactions:read')")
-    public List<TransactionView> transactions(@PathVariable Long accountId) {
-        return service.transactions(accountId).stream().map(TransactionView::of).toList();
+    public List<TransactionView> transactions(@PathVariable Long accountId,
+                                              @RequestParam(required = false) List<String> from,
+                                              @RequestParam(required = false) List<String> to) {
+        LocalDate fromDate = parseDate(from, "from");
+        LocalDate toDate = parseDate(to, "to");
+        if (fromDate != null && toDate != null && fromDate.isAfter(toDate)) {
+            throw new IllegalArgumentException("from must not be later than to");
+        }
+        return service.transactions(accountId, fromDate, toDate).stream().map(TransactionView::of).toList();
+    }
+
+    private static LocalDate parseDate(List<String> values, String name) {
+        if (values == null || values.isEmpty()) {
+            return null;
+        }
+        if (values.size() != 1 || values.get(0).isBlank()) {
+            throw new IllegalArgumentException("Invalid " + name + " date");
+        }
+        try {
+            return LocalDate.parse(values.get(0));
+        } catch (DateTimeParseException e) {
+            throw new IllegalArgumentException("Invalid " + name + " date", e);
+        }
     }
 }
