+    @PatchMapping("/{accountId}/notes/{noteId}")
+    @PreAuthorize("hasAnyRole('SUPPORT', 'ADMIN') && hasAuthority('SCOPE_accounts:write')")
+    public NoteView updateNote(@PathVariable Long accountId, @PathVariable Long noteId,
+                               @RequestBody JsonNode patch) {
+        if (patch == null || !patch.isObject()) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        boolean hasBody = patch.has("body");
+        boolean hasInternal = patch.has("internal");
+        if (!hasBody && !hasInternal) {
+            throw new IllegalArgumentException("No note fields supplied");
+        }
+        if (hasBody && !patch.get("body").isTextual()) {
+            throw new IllegalArgumentException("Invalid note body");
+        }
+        if (hasInternal && !patch.get("internal").isBoolean()) {
+            throw new IllegalArgumentException("Invalid internal flag");
+        }
+        String body = hasBody ? patch.get("body").textValue() : null;
+        Boolean internal = hasInternal ? patch.get("internal").booleanValue() : null;
+        return NoteView.of(service.updateNote(accountId, noteId, body, internal));
+    }
