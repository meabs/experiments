+
+    @Transactional
+    public Account patch(Long accountId, AccountController.AccountPatch request) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (request == null || (!request.hasNickname() && !request.hasDailyLimit())) {
+            throw new IllegalArgumentException("Patch must contain at least one field");
+        }
+        String nickname = request.getNickname();
+        if (request.hasNickname() && (nickname == null || nickname.trim().length() < 1 || nickname.trim().length() > 40)) {
+            throw new IllegalArgumentException("Invalid nickname");
+        }
+        Integer dailyLimit = request.getDailyLimit();
+        if (request.hasDailyLimit() && (dailyLimit == null || dailyLimit < 0 || dailyLimit > 5000)) {
+            throw new IllegalArgumentException("Invalid daily limit");
+        }
+
+        boolean admin = access.isTenantAdmin(user, account.getTenantId());
+        boolean owner = access.ownsAccount(user, account);
+        if ((request.hasNickname() && !admin && !owner) || (request.hasDailyLimit() && !admin)) {
+            throw new ForbiddenException("You may not change these account fields");
+        }
+        if (dailyLimit != null && dailyLimit > 2000 && (!admin || !user.hasRole(CurrentUser.APPROVER))) {
+            throw new ForbiddenException("An approver is required for daily limits above 2000");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Closed accounts cannot be changed");
+        }
+        if (request.hasNickname()) {
+            account.setNickname(nickname.trim());
+        }
+        if (request.hasDailyLimit()) {
+            account.setDailyLimit(dailyLimit);
+        }
+        return account;
+    }
