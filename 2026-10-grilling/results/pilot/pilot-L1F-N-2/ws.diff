+
+    /** Freeze every open account belonging to a customer in the caller's tenant. */
+    @Transactional
+    public List<Account> freezeCustomer(String customerId, String reason) {
+        CurrentUser user = users.current();
+        String tenantId = customers.findByIdAndTenantId(customerId, user.tenantId())
+            .orElseThrow(() -> new NotFoundException("Customer not found"))
+            .getTenantId();
+        List<Account> found = accounts.findByTenantIdAndCustomerIdOrderById(tenantId, customerId);
+        found.stream().filter(a -> a.getStatus() == Account.Status.OPEN)
+            .forEach(a -> a.setStatus(Account.Status.FROZEN));
+        return found;
+    }
 }
