     public List<Transaction> transactions(Long accountId) {
         return transactions.findByAccountIdOrderByBookedOnDescIdDesc(getVisible(accountId).getId());
     }
+
+    @Transactional
+    public AccountNote updateNote(Long accountId, Long noteId, JsonNode patch) {
+        Account account = getVisible(accountId);
+        if (patch == null || !patch.isObject()) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        boolean hasBody = patch.has("body");
+        boolean hasInternal = patch.has("internal");
+        if (!hasBody && !hasInternal) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        if (hasBody) {
+            JsonNode body = patch.get("body");
+            if (body == null || !body.isTextual()) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+            String trimmed = body.textValue().trim();
+            if (trimmed.length() < 1 || trimmed.length() > 2000) {
+                throw new IllegalArgumentException("Invalid request");
+            }
+        }
+        if (hasInternal && (patch.get("internal") == null || !patch.get("internal").isBoolean())) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        AccountNote note = notes.findByIdAndAccountId(noteId, account.getId())
+            .orElseThrow(() -> new NotFoundException("Note not found"));
+        if (hasBody) {
+            note.setBody(patch.get("body").textValue().trim());
+        }
+        if (hasInternal) {
+            note.setInternal(patch.get("internal").booleanValue());
+        }
+        return notes.save(note);
+    }
 }
