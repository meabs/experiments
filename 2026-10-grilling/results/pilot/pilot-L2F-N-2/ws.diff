+++ b/src/main/java/com/example/accounts/cases/SupportCaseAssignmentController.java
@@ -0,0 +1,59 @@
+package com.example.accounts.cases;
+
+import java.time.Instant;
+import java.util.List;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotBlank;
+import jakarta.validation.constraints.NotEmpty;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.NotFoundException;
+
+/** Administrative operations on the support-case inbox. */
+@RestController
+@RequestMapping("/api/support/cases")
+public class SupportCaseAssignmentController {
+
+    public record AssignCasesRequest(@NotEmpty List<@NotBlank String> caseIds, @NotBlank String assigneeUserId) {
+    }
+
+    public record AssignedCase(String id, Long accountId, String subject, String status, String assigneeUserId,
+                               Instant openedAt) {
+        static AssignedCase of(SupportCase c) {
+            return new AssignedCase(c.getId(), c.getAccountId(), c.getSubject(), c.getStatus(), c.getAssigneeUserId(),
+                c.getOpenedAt());
+        }
+    }
+
+    private final SupportCaseRepository cases;
+    private final CurrentUserProvider users;
+
+    public SupportCaseAssignmentController(SupportCaseRepository cases, CurrentUserProvider users) {
+        this.cases = cases;
+        this.users = users;
+    }
+
+    @PostMapping("/assign")
+    @PreAuthorize("hasRole('ADMIN') and hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public List<AssignedCase> assign(@Valid @RequestBody AssignCasesRequest body) {
+        CurrentUser user = users.current();
+        // Resolve every case before changing any, so a bad or cross-tenant id leaves the batch untouched.
+        List<SupportCase> found = body.caseIds().stream()
+            .map(id -> cases.findByIdAndTenantId(id, user.tenantId())
+                .orElseThrow(() -> new NotFoundException("Case not found")))
+            .toList();
+        String assignee = body.assigneeUserId().trim();
+        found.forEach(c -> c.assignTo(assignee));
+        return found.stream().map(AssignedCase::of).toList();
+    }
+}
