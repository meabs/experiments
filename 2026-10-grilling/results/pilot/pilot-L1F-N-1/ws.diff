+package com.example.accounts.customer;
+
+import java.util.List;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotBlank;
+import jakarta.validation.constraints.Size;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.account.AccountController.AccountView;
+import com.example.accounts.account.AccountService;
+
+/** Back-office actions on all accounts belonging to a customer. */
+@RestController
+public class CustomerFreezeController {
+
+    public record FreezeRequest(@NotBlank @Size(min = 1, max = 500) String reason) {
+        public FreezeRequest {
+            if (reason != null) {
+                reason = reason.trim();
+            }
+        }
+    }
+
+    private final AccountService accounts;
+
+    public CustomerFreezeController(AccountService accounts) {
+        this.accounts = accounts;
+    }
+
+    @PostMapping("/api/customers/{customerId}/freeze")
+    @PreAuthorize("hasRole('ADMIN') and hasAuthority('SCOPE_accounts:write')")
+    public List<AccountView> freeze(@PathVariable String customerId, @Valid @RequestBody FreezeRequest body) {
+        return accounts.freezeCustomer(customerId, body.reason()).stream().map(AccountView::of).toList();
+    }
+}
