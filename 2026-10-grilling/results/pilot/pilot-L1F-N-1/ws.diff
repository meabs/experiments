     }
+
+    /** Freezes all open accounts belonging to a customer in the caller's tenant. */
+    @Transactional
+    public List<Account> freezeCustomer(String customerId, String reason) {
+        CurrentUser user = users.current();
+        customers.findByIdAndTenantId(customerId, user.tenantId())
+            .orElseThrow(() -> new NotFoundException("Customer not found"));
+
+        List<Account> customerAccounts = accounts.findByTenantIdAndCustomerIdOrderById(user.tenantId(), customerId);
+        customerAccounts.stream()
+            .filter(account -> account.getStatus() == Account.Status.OPEN)
+            .forEach(account -> account.setStatus(Account.Status.FROZEN));
+        return customerAccounts;
+    }
 }
