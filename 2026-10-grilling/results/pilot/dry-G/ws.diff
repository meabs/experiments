+    @Transactional
+    public Account update(Long accountId, boolean hasNickname, String nickname, boolean hasDailyLimit,
+                          Integer dailyLimit) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        boolean admin = access.isTenantAdmin(user, account.getTenantId());
+        boolean owner = access.ownsAccount(user, account);
+
+        if ((hasNickname && !admin && !owner) || (hasDailyLimit && !admin)) {
+            throw new ForbiddenException("Account cannot be changed");
+        }
+        if (hasDailyLimit && dailyLimit > 2000 && !user.hasRole(CurrentUser.APPROVER)) {
+            throw new ForbiddenException("Account cannot be changed");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+        if (hasNickname) {
+            account.setNickname(nickname);
+        }
+        if (hasDailyLimit) {
+            account.setDailyLimit(dailyLimit);
+        }
+        return account;
+    }
