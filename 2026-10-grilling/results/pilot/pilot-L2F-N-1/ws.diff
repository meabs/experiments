+package com.example.accounts.cases;
+
+import java.time.Instant;
+import java.util.ArrayList;
+import java.util.List;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotBlank;
+import jakarta.validation.constraints.NotEmpty;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.NotFoundException;
+
+/** Administrative operations on support cases. */
+@RestController
+@RequestMapping("/api/support/cases")
+public class SupportCaseAdminController {
+
+    public record AssignCasesRequest(@NotEmpty List<@NotBlank String> caseIds, @NotBlank String assigneeUserId) {
+    }
+
+    public record AssignedCaseSummary(String id, Long accountId, String subject, String status,
+                                      String assigneeUserId, Instant openedAt) {
+        static AssignedCaseSummary of(SupportCase c) {
+            return new AssignedCaseSummary(c.getId(), c.getAccountId(), c.getSubject(), c.getStatus(),
+                c.getAssigneeUserId(), c.getOpenedAt());
+        }
+    }
+
+    private final SupportCaseRepository cases;
+    private final CurrentUserProvider users;
+
+    public SupportCaseAdminController(SupportCaseRepository cases, CurrentUserProvider users) {
+        this.cases = cases;
+        this.users = users;
+    }
+
+    @PostMapping("/assign")
+    @PreAuthorize("hasRole('ADMIN') and hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public List<AssignedCaseSummary> assign(@Valid @RequestBody AssignCasesRequest body) {
+        String tenantId = users.current().tenantId();
+        List<SupportCase> found = new ArrayList<>(body.caseIds().size());
+        for (String id : body.caseIds()) {
+            SupportCase supportCase = cases.findById(id)
+                .filter(c -> tenantId != null && tenantId.equals(c.getTenantId()))
+                .orElseThrow(() -> new NotFoundException("Case not found"));
+            found.add(supportCase);
+        }
+
+        found.forEach(c -> c.assignTo(body.assigneeUserId().trim()));
+        return found.stream().map(AssignedCaseSummary::of).toList();
+    }
+}
