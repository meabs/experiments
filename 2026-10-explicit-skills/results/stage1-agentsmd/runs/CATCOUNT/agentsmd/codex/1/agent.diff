+	private boolean isInCategoryTree(Category root, Category candidate) {
+		if (root.getId().equals(candidate.getId())) {
+			return true;
+		}
+		String prefix = (root.getLineage() == null ? "" : root.getLineage()) + root.getId() + "/";
+		return candidate.getLineage() != null && candidate.getLineage().startsWith(prefix);
+	}
