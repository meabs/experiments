+	@Override
+	public long countDistinctProductsByCategories(MerchantStore store, List<Long> categoryIds) {
+		if (categoryIds.isEmpty()) return 0;
+		Query q = this.em.createQuery("select count(distinct product.id) from Product product "
+				+ "inner join product.categories category where category.id in (:cid) "
+				+ "and product.available=true and product.dateAvailable<=:dt");
+		q.setParameter("cid", categoryIds);
+		q.setParameter("dt", new Date());
+		return ((Number) q.getSingleResult()).longValue();
+	}
 	
