+	@Override
+	public List<Object[]> countProductsByCategoriesIncludingChildren(MerchantStore store, List<Long> categoryIds) {
+		String hql = "select target.id, count(distinct product.id) from Product product "
+				+ "join product.categories productCategory, Category target "
+				+ "where target.id in (:cid) "
+				+ "and (productCategory.id = target.id or productCategory.lineage like concat(target.lineage, target.id, '/%')) "
+				+ "and product.merchantStore.id = :mid "
+				+ "and product.available=true and product.dateAvailable<=:dt "
+				+ "group by target.id";
+		Query q = this.em.createQuery(hql);
+		q.setParameter("cid", categoryIds);
+		q.setParameter("mid", store.getId());
+		q.setParameter("dt", new Date());
+		return q.getResultList();
+	}
 	
