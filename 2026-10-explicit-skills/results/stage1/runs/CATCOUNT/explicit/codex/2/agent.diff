+	@Override
+	public List<Object[]> listProductIdsByCategories(MerchantStore store, List<Long> categoryIds) {
+		Query q = this.em.createQuery("select category.id, product.id from Product product "
+				+ "join product.categories category join product.merchantStore merchant "
+				+ "where merchant.id=:mid and category.id in (:cid) "
+				+ "and product.available=true and product.dateAvailable<=:dt");
+		q.setParameter("mid", store.getId());
+		q.setParameter("cid", categoryIds);
+		q.setParameter("dt", new Date());
+		return q.getResultList();
+	}
 	
