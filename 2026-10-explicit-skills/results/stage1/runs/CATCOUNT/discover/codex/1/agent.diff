+	private void populateProductCounts(MerchantStore store, List<Category> categories,
+			List<ReadableCategory> readableCategories) throws ServiceException {
+		Map<Long, Set<Long>> productsByCategory = new HashMap<>();
+		List<Long> ids = categories.stream().map(Category::getId).collect(Collectors.toList());
+		for (Object[] row : categoryService.findProductIdsByCategories(store, ids)) {
