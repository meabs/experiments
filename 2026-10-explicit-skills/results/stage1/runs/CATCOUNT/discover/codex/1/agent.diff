+				.collect(Collectors.toMap(ReadableCategory::getId, Function.identity()));
+		for (Category category : categories) {
+			Set<Long> products = new HashSet<>(productsByCategory.getOrDefault(category.getId(), new HashSet<>()));
+			for (Category descendant : categories) {
+				if (descendant.getLineage() != null && descendant.getLineage().contains("/" + category.getId() + "/")) {
+					products.addAll(productsByCategory.getOrDefault(descendant.getId(), new HashSet<>()));
+				}
+			}
+			byId.get(category.getId()).setProductCount(products.size());
+		}
+	}
