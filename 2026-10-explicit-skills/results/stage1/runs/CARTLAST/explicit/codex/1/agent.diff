+    @Test
+    @Order(8)
+    public void emptyCartCanBeReadAndReused() throws Exception {
+        String cartUrl = String.format("/api/v1/cart/%s", data.getCartId());
+        String productSku = data.getProducts().get(0).getSku();
+
+        ResponseEntity<ReadableShoppingCart> deleteResponse = testRestTemplate.exchange(
+                cartUrl + "/product/" + productSku + "?body=true", HttpMethod.DELETE, null,
+                ReadableShoppingCart.class);
+        assertThat(deleteResponse.getStatusCode(), is(OK));
+
+        ResponseEntity<ReadableShoppingCart> getResponse = testRestTemplate.getForEntity(cartUrl,
+                ReadableShoppingCart.class);
+        assertThat(getResponse.getStatusCode(), is(OK));
+        assertEquals(0, getResponse.getBody().getQuantity());
+
+        PersistableShoppingCartItem cartItem = new PersistableShoppingCartItem();
+        cartItem.setProduct(productSku);
+        cartItem.setQuantity(1);
+        ResponseEntity<ReadableShoppingCart> addResponse = testRestTemplate.exchange(cartUrl, HttpMethod.PUT,
+                new HttpEntity<>(cartItem, getHeader()), ReadableShoppingCart.class);
+        assertThat(addResponse.getStatusCode(), is(CREATED));
+        assertEquals(1, addResponse.getBody().getQuantity());
+    }
+
