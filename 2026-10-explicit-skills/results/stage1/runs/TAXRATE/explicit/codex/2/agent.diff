+    public void rejectInvalidTaxRatesWithoutPersistingOrChangingThem() throws Exception {
+        for (BigDecimal invalidRate : new BigDecimal[] { new BigDecimal("150"), new BigDecimal("-1"), null }) {
+            PersistableTaxRate invalid = new PersistableTaxRate();
+            invalid.setCode("invalid-tax-" + (invalidRate == null ? "null" : invalidRate.toPlainString()));
+            invalid.setRate(invalidRate);
+
+            ResponseEntity<Entity> response = testRestTemplate.postForEntity(
+                    "/api/v1/private/tax/rate/", new HttpEntity<>(invalid, getHeader()), Entity.class);
+
+            assertEquals(HttpStatus.BAD_REQUEST, response.getStatusCode());
+            ResponseEntity<EntityExists> exists = testRestTemplate.exchange(
+                    "/api/v1/private/tax/rate/unique?code=" + invalid.getCode(), HttpMethod.GET,
+                    new HttpEntity<>(getHeader()), EntityExists.class);
+            assertTrue(!exists.getBody().isExists());
+        }
+
+        PersistableTaxRate valid = new PersistableTaxRate();
+        valid.setCode("tax-rate-update-validation");
+        valid.setRate(new BigDecimal("5"));
+        valid.setCountry("US");
+        valid.setStore("DEFAULT");
+        valid.setTaxClass("DEFAULT");
+        valid.setZone("NY");
+        TaxRateDescription description = new TaxRateDescription();
+        description.setLanguage("en");
+        description.setName("Validation rate");
+        description.setDescription("Validation rate");
+        valid.getDescriptions().add(description);
+
+        ResponseEntity<Entity> created = testRestTemplate.postForEntity(
+                "/api/v1/private/tax/rate/", new HttpEntity<>(valid, getHeader()), Entity.class);
+        assertEquals(HttpStatus.OK, created.getStatusCode());
+
+        valid.setRate(new BigDecimal("150"));
+        ResponseEntity<Void> updated = testRestTemplate.exchange(
+                "/api/v1/private/tax/rate/" + created.getBody().getId(), HttpMethod.PUT,
+                new HttpEntity<>(valid, getHeader()), Void.class);
+        assertEquals(HttpStatus.BAD_REQUEST, updated.getStatusCode());
+
+        ResponseEntity<ReadableTaxRate> unchanged = testRestTemplate.exchange(
+                "/api/v1/private/tax/rate/" + created.getBody().getId(), HttpMethod.GET,
+                new HttpEntity<>(getHeader()), ReadableTaxRate.class);
+        assertEquals(HttpStatus.OK, unchanged.getStatusCode());
+        assertEquals("5.0000", unchanged.getBody().getRate());
