+	private void recalculateRating(Product product) throws ServiceException {
+		List<ProductReview> reviews = productReviewRepository.findByProductNoCustomers(product.getId());
+		BigDecimal total = BigDecimal.ZERO;
+		for (ProductReview current : reviews) total = total.add(BigDecimal.valueOf(current.getReviewRating()));
+		int count = reviews.size();
+		product.setProductReviewCount(count);
+		product.setProductReviewAvg(count == 0 ? BigDecimal.ZERO : total.divide(BigDecimal.valueOf(count), 6, java.math.RoundingMode.HALF_UP));
+		productService.update(product);
+	}
+
+	@Override
+	public ProductReview getById(Long id) { return productReviewRepository.findOne(id); }
+
+	@Override
+	public void delete(ProductReview review) throws ServiceException {
+		Long productId = review.getProduct().getId();
+		super.delete(review);
+		productReviewRepository.flush();
+		recalculateRating(productService.getById(productId));
+	}
+
