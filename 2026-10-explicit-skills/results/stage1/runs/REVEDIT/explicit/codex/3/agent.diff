+	@Override
+	public void delete(ProductReview review) throws ServiceException {
+		Product product = review.getProduct();
+		super.delete(review);
+		recalculateRating(product);
+		productService.update(product);
+	}
+
+	private void recalculateRating(Product product) {
+		List<ProductReview> reviews = productReviewRepository.findByProductNoCustomers(product.getId());
+		int count = reviews.size();
+		BigDecimal total = BigDecimal.ZERO;
+		for (ProductReview current : reviews) {
+			total = total.add(BigDecimal.valueOf(current.getReviewRating()));
+		}
+		product.setProductReviewCount(count);
+		product.setProductReviewAvg(count == 0 ? BigDecimal.ZERO : total.divide(BigDecimal.valueOf(count), 2, java.math.RoundingMode.HALF_UP));
+	}
