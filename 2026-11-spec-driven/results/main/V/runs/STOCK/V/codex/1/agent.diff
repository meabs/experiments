@@ -0,0 +1,78 @@
+package com.salesmanager.shop.store.controller.inventory;
+
+import com.salesmanager.core.business.constants.Constants;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.availability.ProductAvailabilityService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.Order;
+import com.salesmanager.core.model.order.orderproduct.OrderProduct;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+import com.salesmanager.shop.store.api.exception.StockConflictException;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import javax.inject.Inject;
+
+@Service
+public class StockService {
+
+    @Inject private ProductService productService;
+    @Inject private ProductAvailabilityService availabilityService;
+
+    public void validateCart(ShoppingCart cart, MerchantStore store) throws ServiceException {
+        for (ShoppingCartItem item : cart.getLineItems()) {
+            Product product = productService.getBySku(item.getSku(), store);
+            ProductAvailability availability = defaultAvailability(product);
+            int stock = availability == null || availability.getProductQuantity() == null
+                    ? 0 : availability.getProductQuantity();
+            if (item.getQuantity() <= 0 || item.getQuantity() > stock) {
+                throw conflict("Insufficient stock for product " + item.getSku());
+            }
+        }
+    }
+
+    @Transactional
+    public void decrease(ShoppingCart cart, MerchantStore store) throws ServiceException {
+        validateCart(cart, store);
+        for (ShoppingCartItem item : cart.getLineItems()) {
+            ProductAvailability availability = defaultAvailability(productService.getBySku(item.getSku(), store));
+            availability.setProductQuantity(availability.getProductQuantity() - item.getQuantity());
+            availabilityService.saveOrUpdate(availability);
+        }
+    }
+
+    @Transactional
+    public void restore(Order order, MerchantStore store) throws ServiceException {
+        for (OrderProduct item : order.getOrderProducts()) {
+            Product product = productService.getBySku(item.getSku(), store);
+            ProductAvailability availability = defaultAvailability(product);
+            if (availability == null) {
+                throw conflict("No stock record for product " + item.getSku());
+            }
+            int current = availability.getProductQuantity() == null ? 0 : availability.getProductQuantity();
+            availability.setProductQuantity(current + item.getProductQuantity());
+            availabilityService.saveOrUpdate(availability);
+        }
+    }
+
+    private ProductAvailability defaultAvailability(Product product) {
+        if (product == null || product.getAvailabilities() == null) return null;
+        ProductAvailability fallback = null;
+        for (ProductAvailability availability : product.getAvailabilities()) {
+            if (fallback == null) fallback = availability;
+            if (availability.getProductVariant() == null
+                    && (availability.getRegionVariant() == null || availability.getRegionVariant().isEmpty())) {
+                return availability;
+            }
+        }
+        return fallback;
+    }
+
+    private StockConflictException conflict(String message) {
+        return new StockConflictException(message);
+    }
+}
