+	private void validateCartStock(ShoppingCart cart) {
+		if (cart.getLineItems() == null) return;
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem item : cart.getLineItems()) {
+			if (item.getQuantity() <= 0) continue;
+			ProductAvailability availability = item.getProduct().getAvailabilities().stream().findFirst().orElse(null);
+			int stock = availability == null || availability.getProductQuantity() == null ? 0 : availability.getProductQuantity();
+			if (stock < item.getQuantity()) throw new StockConflictException("Insufficient stock for product " + item.getProduct().getSku());
+		}
+	}
