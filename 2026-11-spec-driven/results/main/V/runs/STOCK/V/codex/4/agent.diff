@@ -0,0 +1,85 @@
+package com.salesmanager.shop.store.service;
+
+import java.util.List;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.availability.ProductAvailabilityService;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.Order;
+import com.salesmanager.core.model.order.orderproduct.OrderProduct;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+import com.salesmanager.shop.store.api.exception.StockConflictException;
+
+@Service
+public class StockService {
+
+    @Inject
+    private ProductAvailabilityService availabilityService;
+
+    public void validateCart(ShoppingCart cart, MerchantStore store) throws ServiceException {
+        Map<String, Integer> requested = requested(cart);
+        for (Map.Entry<String, Integer> entry : requested.entrySet()) {
+            if (quantity(entry.getKey(), store) < entry.getValue()) {
+                throw conflict("Insufficient stock for " + entry.getKey());
+            }
+        }
+    }
+
+    @Transactional(rollbackFor = Exception.class)
+    public void decrementCart(ShoppingCart cart, MerchantStore store) throws ServiceException {
+        validateCart(cart, store);
+        for (Map.Entry<String, Integer> entry : requested(cart).entrySet()) {
+            ProductAvailability availability = availability(entry.getKey(), store);
+            availability.setProductQuantity(availability.getProductQuantity() - entry.getValue());
+            availabilityService.saveOrUpdate(availability);
+        }
+    }
+
+    @Transactional(rollbackFor = Exception.class)
+    public void restoreOrder(Order order, MerchantStore store) throws ServiceException {
+        for (OrderProduct item : order.getOrderProducts()) {
+            ProductAvailability availability = availability(item.getSku(), store);
+            availability.setProductQuantity(availability.getProductQuantity() + item.getProductQuantity());
+            availabilityService.saveOrUpdate(availability);
+        }
+    }
+
+    private int quantity(String sku, MerchantStore store) throws ServiceException {
+        return availability(sku, store).getProductQuantity();
+    }
+
+    private Map<String, Integer> requested(ShoppingCart cart) {
+        Map<String, Integer> requested = new LinkedHashMap<>();
+        for (ShoppingCartItem item : cart.getLineItems()) {
+            if (item.getQuantity() > 0) {
+                requested.merge(item.getSku(), item.getQuantity(), Integer::sum);
+            }
+        }
+        return requested;
+    }
+
+    private ProductAvailability availability(String sku, MerchantStore store) throws ServiceException {
+        List<ProductAvailability> rows = availabilityService.getBySku(sku, store);
+        ProductAvailability fallback = null;
+        for (ProductAvailability row : rows) {
+            if (row.getProductVariant() != null && sku.equals(row.getProductVariant().getSku())) return row;
+            if (row.getProductVariant() == null && row.getProduct() != null && sku.equals(row.getProduct().getSku())) fallback = row;
+        }
+        if (fallback != null) return fallback;
+        if (!rows.isEmpty()) return rows.get(0);
+        throw conflict("No stock record for " + sku);
+    }
+
+    private StockConflictException conflict(String message) {
+        return new StockConflictException(message);
+    }
+}
