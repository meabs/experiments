+	@Override
+	public void delete(ProductReview review) throws ServiceException {
+		Product product = productService.getById(review.getProduct().getId());
+		super.delete(review);
+		refreshProductRating(product);
+		productService.update(product);
+	}
+
+	private void refreshProductRating(Product product) {
+		List<Double> ratings = productReviewRepository.findRatingsByProduct(product.getId());
+		if (ratings.isEmpty()) {
+			product.setProductReviewAvg(BigDecimal.ZERO.setScale(1));
+			product.setProductReviewCount(0);
+			return;
+		}
+		BigDecimal total = ratings.stream().map(BigDecimal::valueOf).reduce(BigDecimal.ZERO, BigDecimal::add);
+		product.setProductReviewAvg(total.divide(BigDecimal.valueOf(ratings.size()), 1, RoundingMode.HALF_UP));
+		product.setProductReviewCount(ratings.size());
+	}
