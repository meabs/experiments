+	private void validateInventory(Set<OrderProduct> products, MerchantStore store) throws ServiceException {
+		Map<String, Integer> orderedQuantities = new HashMap<>();
+		for (OrderProduct orderProduct : products) {
+			orderedQuantities.merge(orderProduct.getSku(), orderProduct.getProductQuantity(), Integer::sum);
+		}
+		for (Map.Entry<String, Integer> orderedQuantity : orderedQuantities.entrySet()) {
+			Product product = productService.getBySku(orderedQuantity.getKey(), store, store.getDefaultLanguage());
+			if (product == null || CollectionUtils.isEmpty(product.getAvailabilities())) {
+				throw new ServiceException(ServiceException.EXCEPTION_INVENTORY_MISMATCH);
+			}
+			ProductAvailability availability = product.getAvailabilities().iterator().next();
+			if (orderedQuantity.getValue() < 0 || availability.getProductQuantity() == null
+					|| orderedQuantity.getValue() > availability.getProductQuantity()) {
+				throw new ServiceException(ServiceException.EXCEPTION_INVENTORY_MISMATCH);
+			}
+		}
+	}
