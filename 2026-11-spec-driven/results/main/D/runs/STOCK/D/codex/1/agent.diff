+package com.salesmanager.test.catalog;
+
+import static org.junit.Assert.assertEquals;
+
+import java.util.HashSet;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.services.catalog.inventory.ProductInventoryServiceImpl;
+import com.salesmanager.core.business.constants.Constants;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+
+public class ProductInventoryServiceTest {
+
+    @Test
+    public void quantityUsesDefaultAvailabilityAndChangesOnlyThatStock() throws Exception {
+        Product product = new Product();
+        ProductAvailability defaultAvailability = new ProductAvailability();
+        defaultAvailability.setProductQuantity(5);
+        defaultAvailability.setRegion(Constants.ALL_REGIONS);
+        ProductAvailability regionalAvailability = new ProductAvailability();
+        regionalAvailability.setProductQuantity(99);
+        regionalAvailability.setRegion("US");
+        HashSet<ProductAvailability> availabilities = new HashSet<>();
+        availabilities.add(defaultAvailability);
+        availabilities.add(regionalAvailability);
+        product.setAvailabilities(availabilities);
+
+        ProductInventoryServiceImpl service = new ProductInventoryServiceImpl();
+        assertEquals(5, service.quantity(product));
+        service.changeQuantity(product, -2);
+
+        assertEquals(3, defaultAvailability.getProductQuantity().intValue());
+        assertEquals(99, regionalAvailability.getProductQuantity().intValue());
+    }
+}
