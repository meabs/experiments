@@ -0,0 +1,77 @@
+package com.salesmanager.test.shoppingcart;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import java.util.HashSet;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.repositories.shoppingcart.ShoppingCartAttributeRepository;
+import com.salesmanager.core.business.repositories.shoppingcart.ShoppingCartItemRepository;
+import com.salesmanager.core.business.repositories.shoppingcart.ShoppingCartRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.shoppingcart.ShoppingCartServiceImpl;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+public class DeletedProductShoppingCartTest {
+
+	@Test
+	public void removesDeletedProductButKeepsCart() throws Exception {
+		ShoppingCartRepository cartRepository = mock(ShoppingCartRepository.class);
+		ShoppingCartItemRepository itemRepository = mock(ShoppingCartItemRepository.class);
+		ShoppingCartAttributeRepository attributeRepository = mock(ShoppingCartAttributeRepository.class);
+		ProductService productService = mock(ProductService.class);
+		ShoppingCartServiceImpl service = new ShoppingCartServiceImpl(cartRepository);
+		setField(service, "shoppingCartItemRepository", itemRepository);
+		setField(service, "shoppingCartAttributeItemRepository", attributeRepository);
+		setField(service, "productService", productService);
+
+		MerchantStore store = new MerchantStore();
+		store.setId(7);
+		ShoppingCart cart = new ShoppingCart();
+		cart.setId(11L);
+		cart.setLineItems(new HashSet<>());
+		ShoppingCartItem item = new ShoppingCartItem();
+		item.setId(12L);
+		item.setSku("deleted-sku");
+		item.setShoppingCart(cart);
+		cart.getLineItems().add(item);
+		when(cartRepository.findByCode(7, "cart-code")).thenReturn(cart);
+		when(itemRepository.findOne(12L)).thenReturn(item);
+		when(productService.getBySku("deleted-sku", store, store.getDefaultLanguage())).thenReturn(null);
+
+		ShoppingCart result = service.getByCode("cart-code", store);
+
+		assertTrue(result.getLineItems().isEmpty());
+		assertFalse(result.isObsolete());
+		verify(itemRepository).deleteById(12L);
+	}
+
+	@Test
+	public void keepsAnAlreadyEmptyCart() throws Exception {
+		ShoppingCartRepository cartRepository = mock(ShoppingCartRepository.class);
+		ShoppingCartServiceImpl service = new ShoppingCartServiceImpl(cartRepository);
+		MerchantStore store = new MerchantStore();
+		store.setId(7);
+		ShoppingCart cart = new ShoppingCart();
+		cart.setLineItems(new HashSet<>());
+		when(cartRepository.findByCode(7, "cart-code")).thenReturn(cart);
+
+		ShoppingCart result = service.getByCode("cart-code", store);
+
+		assertTrue(result.getLineItems().isEmpty());
+		assertFalse(result.isObsolete());
+	}
+
+	private static void setField(Object target, String name, Object value) throws ReflectiveOperationException {
+		var field = target.getClass().getDeclaredField(name);
+		field.setAccessible(true);
+		field.set(target, value);
+	}
+}
