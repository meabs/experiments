+package com.salesmanager.test.shoppingcart;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.Mockito.doThrow;
+import static org.mockito.Mockito.verify;
+
+import java.util.HashSet;
+import java.lang.reflect.Field;
+
+import org.junit.Test;
+import org.mockito.InjectMocks;
+import org.mockito.Mock;
+import org.mockito.MockitoAnnotations;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.shoppingcart.ShoppingCartAttributeRepository;
+import com.salesmanager.core.business.repositories.shoppingcart.ShoppingCartItemRepository;
+import com.salesmanager.core.business.repositories.shoppingcart.ShoppingCartRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.shoppingcart.ShoppingCartServiceImpl;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+public class ShoppingCartServiceImplTest {
+	@Mock
+	private ShoppingCartRepository cartRepository;
+	@Mock
+	private ShoppingCartItemRepository itemRepository;
+	@Mock
+	private ShoppingCartAttributeRepository attributeRepository;
+	@Mock
+	private ProductService productService;
+	@InjectMocks
+	private ShoppingCartServiceImpl service;
+
+	@Test
+	public void deletedProductIsRemovedWithoutInvalidatingCart() throws Exception {
+		MockitoAnnotations.initMocks(this);
+		inject(service, "productService", productService);
+		inject(service, "shoppingCartItemRepository", itemRepository);
+		inject(service, "shoppingCartAttributeItemRepository", attributeRepository);
+
+		MerchantStore store = new MerchantStore();
+		store.setId(1);
+		ShoppingCart cart = new ShoppingCart();
+		cart.setShoppingCartCode("cart-code");
+		cart.setMerchantStore(store);
+		ShoppingCartItem item = new ShoppingCartItem();
+		item.setId(42L);
+		item.setSku("deleted-sku");
+		item.setShoppingCart(cart);
+		cart.setLineItems(new HashSet<ShoppingCartItem>());
+		cart.getLineItems().add(item);
+
+		org.mockito.Mockito.when(cartRepository.findByCode(1, "cart-code")).thenReturn(cart);
+		doThrow(new ServiceException("missing")).when(productService)
+				.getBySku(anyString(), any(MerchantStore.class), any());
+
+		ShoppingCart result = service.getByCode("cart-code", store);
+
+		assertTrue(result != null);
+		assertTrue(result.getLineItems().isEmpty());
+		assertFalse(result.isObsolete());
+		verify(itemRepository).deleteById(42L);
+	}
+
+	private static void inject(Object target, String name, Object value) throws Exception {
+		Field field = target.getClass().getDeclaredField(name);
+		field.setAccessible(true);
+		field.set(target, value);
+	}
+}
