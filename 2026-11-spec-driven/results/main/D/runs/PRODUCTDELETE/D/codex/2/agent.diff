+package com.salesmanager.test.shop.order;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyString;
+import static org.mockito.Mockito.when;
+
+import java.math.BigDecimal;
+
+import org.junit.Test;
+import org.mockito.InjectMocks;
+import org.mockito.Mock;
+import org.mockito.MockitoAnnotations;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.pricing.PricingService;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.orderproduct.OrderProduct;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.mapper.catalog.product.ReadableProductMapper;
+import com.salesmanager.shop.mapper.order.ReadableOrderProductMapper;
+import com.salesmanager.shop.model.order.ReadableOrderProduct;
+
+public class ReadableOrderProductMapperTest {
+	@Mock
+	private PricingService pricingService;
+	@Mock
+	private ProductService productService;
+	@Mock
+	private ReadableProductMapper readableProductMapper;
+	@InjectMocks
+	private ReadableOrderProductMapper mapper;
+
+	@Test
+	public void deletedProductStillUsesOrderSnapshot() throws Exception {
+		MockitoAnnotations.initMocks(this);
+
+		MerchantStore store = new MerchantStore();
+		Language language = new Language();
+		OrderProduct source = new OrderProduct();
+		source.setId(7L);
+		source.setSku("deleted-sku");
+		source.setProductName("Bought name");
+		source.setProductQuantity(2);
+		source.setOneTimeCharge(new BigDecimal("12.50"));
+		when(pricingService.getDisplayAmount(any(BigDecimal.class), any(MerchantStore.class)))
+				.thenAnswer(invocation -> invocation.getArgument(0, BigDecimal.class).toPlainString());
+		when(productService.getBySku(anyString(), any(MerchantStore.class), any(Language.class)))
+				.thenThrow(new ServiceException("missing"));
+
+		ReadableOrderProduct result = mapper.convert(source, store, language);
+
+		assertEquals("deleted-sku", result.getSku());
+		assertEquals("Bought name", result.getProductName());
+		assertTrue(result.getOrderedQuantity() == 2);
+		assertEquals("12.50", result.getPrice());
+		assertEquals("25.00", result.getSubTotal());
+	}
+}
