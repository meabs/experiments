diff --git a/sm-core/src/test/java/com/salesmanager/test/business/utils/RepositoryHelperTest.java b/sm-core/src/test/java/com/salesmanager/test/business/utils/RepositoryHelperTest.java
new file mode 100644
index 0000000..22e1681
--- /dev/null
+++ b/sm-core/src/test/java/com/salesmanager/test/business/utils/RepositoryHelperTest.java
@@ -0,0 +1,57 @@
+package com.salesmanager.test.business.utils;
+
+import static org.junit.Assert.assertEquals;
+import static org.mockito.ArgumentMatchers.anyInt;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import javax.persistence.Query;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.utils.RepositoryHelper;
+import com.salesmanager.core.model.common.Criteria;
+import com.salesmanager.core.model.common.GenericEntityList;
+
+public class RepositoryHelperTest {
+
+    @Test
+    public void paginatesFromZeroBasedPageAndReportsCeilingPageCount() {
+        Query query = mock(Query.class);
+        when(query.setFirstResult(anyInt())).thenReturn(query);
+        when(query.setMaxResults(anyInt())).thenReturn(query);
+
+        Criteria criteria = new Criteria();
+        criteria.setLegacyPagination(false);
+        criteria.setStartPage(1);
+        criteria.setPageSize(2);
+        GenericEntityList<Object> results = new GenericEntityList<>();
+
+        RepositoryHelper.paginateQuery(query, 5, results, criteria);
+
+        verify(query).setFirstResult(2);
+        verify(query).setMaxResults(2);
+        assertEquals(3, results.getTotalPages());
+        assertEquals(5, results.getTotalCount());
+    }
+
+    @Test
+    public void outOfRangePageKeepsTotals() {
+        Query query = mock(Query.class);
+        when(query.setFirstResult(anyInt())).thenReturn(query);
+        when(query.setMaxResults(anyInt())).thenReturn(query);
+
+        Criteria criteria = new Criteria();
+        criteria.setLegacyPagination(false);
+        criteria.setStartPage(3);
+        criteria.setPageSize(2);
+        GenericEntityList<Object> results = new GenericEntityList<>();
+
+        RepositoryHelper.paginateQuery(query, 5, results, criteria);
+
+        verify(query).setFirstResult(6);
+        assertEquals(3, results.getTotalPages());
+        assertEquals(5, results.getTotalCount());
+    }
+}
