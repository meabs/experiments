--- /dev/null
+++ b/sm-core/src/test/java/com/salesmanager/test/common/RepositoryHelperTest.java
@@ -0,0 +1,55 @@
+package com.salesmanager.test.common;
+
+import static org.junit.Assert.assertEquals;
+
+import java.lang.reflect.Proxy;
+
+import javax.persistence.Query;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.utils.RepositoryHelper;
+import com.salesmanager.core.model.common.Criteria;
+import com.salesmanager.core.model.common.GenericEntityList;
+
+public class RepositoryHelperTest {
+
+    @Test
+    public void calculatesExactNumberOfPagesForZeroBasedPagination() {
+        int[] firstResult = new int[1];
+        int[] maxResults = new int[1];
+        Query query = (Query) Proxy.newProxyInstance(
+                Query.class.getClassLoader(),
+                new Class<?>[] { Query.class },
+                (proxy, method, args) -> {
+                    if ("setFirstResult".equals(method.getName())) {
+                        firstResult[0] = (Integer) args[0];
+                        return proxy;
+                    }
+                    if ("setMaxResults".equals(method.getName())) {
+                        maxResults[0] = (Integer) args[0];
+                        return proxy;
+                    }
+                    if (method.getReturnType() == boolean.class) {
+                        return false;
+                    }
+                    if (method.getReturnType() == int.class) {
+                        return 0;
+                    }
+                    return null;
+                });
+
+        Criteria criteria = new Criteria();
+        criteria.setLegacyPagination(false);
+        criteria.setPageSize(10);
+        criteria.setStartPage(1);
+        GenericEntityList<?> entityList = new GenericEntityList<>();
+
+        RepositoryHelper.paginateQuery(query, 20, entityList, criteria);
+
+        assertEquals(10, firstResult[0]);
+        assertEquals(10, maxResults[0]);
+        assertEquals(2, entityList.getTotalPages());
+        assertEquals(20, entityList.getTotalCount());
+    }
+}
