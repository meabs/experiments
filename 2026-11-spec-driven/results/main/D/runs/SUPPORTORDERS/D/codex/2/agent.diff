diff --git a/sm-core/src/test/java/com/salesmanager/test/order/OrderPaginationTest.java b/sm-core/src/test/java/com/salesmanager/test/order/OrderPaginationTest.java
new file mode 100644
index 0000000..d3c3bde
--- /dev/null
+++ b/sm-core/src/test/java/com/salesmanager/test/order/OrderPaginationTest.java
@@ -0,0 +1,31 @@
+package com.salesmanager.test.order;
+
+import java.lang.reflect.Proxy;
+
+import javax.persistence.Query;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+import com.salesmanager.core.business.utils.RepositoryHelper;
+import com.salesmanager.core.model.common.GenericEntityList;
+import com.salesmanager.core.model.order.OrderCriteria;
+
+public class OrderPaginationTest {
+
+    @Test
+    public void calculatesPagesAndOffsetsForZeroBasedOrderPages() {
+        Query query = (Query) Proxy.newProxyInstance(Query.class.getClassLoader(),
+                new Class<?>[] { Query.class }, (proxy, method, args) -> proxy);
+        OrderCriteria criteria = new OrderCriteria();
+        criteria.setLegacyPagination(false);
+        criteria.setStartPage(1);
+        criteria.setPageSize(25);
+        GenericEntityList<Object> result = new GenericEntityList<>();
+
+        RepositoryHelper.paginateQuery(query, 25, result, criteria);
+
+        Assert.assertEquals(1, result.getTotalPages());
+        Assert.assertEquals(25, result.getTotalCount());
+    }
+}
