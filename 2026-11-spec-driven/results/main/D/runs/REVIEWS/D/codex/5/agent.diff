@@ -0,0 +1,81 @@
+package com.salesmanager.test.business.services.catalog.product.review;
+
+import static org.junit.Assert.assertEquals;
+import static org.mockito.Mockito.when;
+
+import java.math.BigDecimal;
+import java.util.Collections;
+import java.util.List;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.InjectMocks;
+import org.mockito.Mock;
+import org.mockito.junit.MockitoJUnitRunner;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import com.salesmanager.core.business.repositories.catalog.product.review.ProductReviewRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.review.ProductReviewServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.review.ProductReview;
+import com.salesmanager.core.model.customer.Customer;
+
+@RunWith(MockitoJUnitRunner.class)
+public class ProductReviewServiceImplTest {
+
+    @Mock
+    private ProductReviewRepository reviewRepository;
+
+    @Mock
+    private ProductService productService;
+
+    @InjectMocks
+    private ProductReviewServiceImpl service;
+
+    @org.junit.Before
+    public void injectDependencies() {
+        ReflectionTestUtils.setField(service, "productService", productService);
+    }
+
+    @Test
+    public void recalculatesRoundedAverageWhenReviewIsUpdated() throws Exception {
+        Product product = product(10L);
+        ProductReview first = review(product, 4D);
+        ProductReview second = review(product, 5D);
+        when(productService.getById(10L)).thenReturn(product);
+        when(reviewRepository.findByProduct(10L)).thenReturn(List.of(first, second));
+
+        service.update(first);
+
+        assertEquals(new BigDecimal("4.5"), product.getProductReviewAvg());
+        assertEquals(Integer.valueOf(2), product.getProductReviewCount());
+    }
+
+    @Test
+    public void resetsRatingAfterLastReviewIsDeleted() throws Exception {
+        Product product = product(10L);
+        ProductReview review = review(product, 4D);
+        when(productService.getById(10L)).thenReturn(product);
+        when(reviewRepository.findByProduct(10L)).thenReturn(Collections.emptyList());
+
+        service.delete(review);
+
+        assertEquals(BigDecimal.ZERO, product.getProductReviewAvg());
+        assertEquals(Integer.valueOf(0), product.getProductReviewCount());
+    }
+
+    private Product product(Long id) {
+        Product product = new Product();
+        product.setId(id);
+        return product;
+    }
+
+    private ProductReview review(Product product, Double rating) {
+        ProductReview review = new ProductReview();
+        review.setProduct(product);
+        review.setCustomer(new Customer());
+        review.setReviewRating(rating);
+        return review;
+    }
+}
