+package com.salesmanager.test.catalog;
+
+import static org.junit.Assert.assertFalse;
+import static org.mockito.ArgumentMatchers.anyLong;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.HashSet;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.Mock;
+import org.mockito.junit.MockitoJUnitRunner;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import com.salesmanager.core.business.repositories.catalog.category.CategoryDescriptionRepository;
+import com.salesmanager.core.business.repositories.catalog.category.CategoryRepository;
+import com.salesmanager.core.business.services.catalog.category.CategoryServiceImpl;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@RunWith(MockitoJUnitRunner.class)
+public class CategoryDeletionTest {
+
+    @Mock
+    private CategoryRepository categoryRepository;
+
+    @Mock
+    private CategoryDescriptionRepository categoryDescriptionRepository;
+
+    @Mock
+    private ProductService productService;
+
+    private CategoryServiceImpl categoryService;
+
+    @Before
+    public void setUp() {
+        categoryService = new CategoryServiceImpl(categoryRepository);
+        ReflectionTestUtils.setField(categoryService, "categoryDescriptionRepository", categoryDescriptionRepository);
+        ReflectionTestUtils.setField(categoryService, "productService", productService);
+    }
+
+    @Test
+    public void deleteCategoryKeepsProductAndRemovesSubtreeLinks() throws Exception {
+        MerchantStore store = new MerchantStore();
+        store.setId(7);
+
+        Category root = category(10L, "/", store);
+        Category child = category(11L, "/10/", store);
+        Product product = new Product();
+        product.setId(20L);
+        product.setCategories(new HashSet<>(Arrays.asList(root, child)));
+
+        when(categoryRepository.findByLineage(7, "/10/"))
+                .thenReturn(new ArrayList<>(Collections.singletonList(child)));
+        when(categoryRepository.findByIdAndStore(10L, 7)).thenReturn(root);
+        when(categoryDescriptionRepository.listByCategoryId(anyLong()))
+                .thenReturn(Collections.emptyList());
+        when(productService.getProducts(Arrays.asList(11L, 10L)))
+                .thenReturn(Collections.singletonList(product));
+        when(productService.getById(20L)).thenReturn(product);
+
+        categoryService.delete(root);
+
+        assertFalse(product.getCategories().contains(root));
+        assertFalse(product.getCategories().contains(child));
+        verify(productService).update(product);
+        verify(productService, never()).delete(product);
+        verify(categoryRepository).delete(root);
+    }
+
+    private Category category(Long id, String lineage, MerchantStore store) {
+        Category category = new Category();
+        category.setId(id);
+        category.setLineage(lineage);
+        category.setMerchantStore(store);
+        return category;
+    }
+}
