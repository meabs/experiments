+	private boolean isInventoryConflict(Throwable exception) {
+		Throwable current = exception;
+		while (current != null) {
+			if (current instanceof ServiceException
+					&& ((ServiceException) current).getExceptionType() == ServiceException.EXCEPTION_INVENTORY_MISMATCH) {
+				return true;
+			}
+			current = current.getCause();
+		}
+		return false;
+	}
 }
