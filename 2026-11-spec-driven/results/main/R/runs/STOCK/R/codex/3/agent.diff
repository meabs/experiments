+	private void restoreInventory(Order order, MerchantStore store) {
+		for (OrderProduct orderProduct : order.getOrderProducts()) {
+			try {
+				Product product = productService.getBySku(orderProduct.getSku(), store, store.getDefaultLanguage());
+				if (product == null) {
+					throw new StockConflictException("Product " + orderProduct.getSku() + " no longer exists");
+				}
+				for (ProductAvailability availability : product.getAvailabilities()) {
+					availability.setProductQuantity(availability.getProductQuantity() + orderProduct.getProductQuantity());
+				}
+				productService.update(product);
+			} catch (ServiceException e) {
+				throw new ServiceRuntimeException("Unable to restore inventory", e);
+			}
+		}
+	}
