@@ -0,0 +1,26 @@
+package com.salesmanager.core.business.utils;
+
+import com.salesmanager.core.constants.SchemaConstant;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+
+public final class InventoryUtils {
+    private InventoryUtils() { }
+
+    public static ProductAvailability stockAvailability(Product product) {
+        if (product == null || product.getAvailabilities() == null) return null;
+        ProductAvailability fallback = null;
+        for (ProductAvailability a : product.getAvailabilities()) {
+            if (a.getProductVariant() == null) {
+                if (fallback == null) fallback = a;
+                if (SchemaConstant.ALL_REGIONS.equals(a.getRegion()) && a.getRegionVariant() == null) return a;
+            }
+        }
+        return fallback;
+    }
+
+    public static int stock(Product product) {
+        ProductAvailability a = stockAvailability(product);
+        return a == null || a.getProductQuantity() == null ? 0 : Math.max(0, a.getProductQuantity());
+    }
+}
