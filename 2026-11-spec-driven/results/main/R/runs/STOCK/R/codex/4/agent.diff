+	private ProductAvailability availability(Product product, String sku) {
+		if (product == null || product.getAvailabilities() == null) return null;
+		for (ProductAvailability candidate : product.getAvailabilities()) {
+			if (candidate.getProductVariant() == null && (sku == null || sku.equals(product.getSku()))) return candidate;
+			if (sku != null && sku.equals(candidate.getSku())) return candidate;
+		}
+		return null;
+	}
 
