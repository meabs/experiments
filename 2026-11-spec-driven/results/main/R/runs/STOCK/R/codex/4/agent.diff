+	private void restoreInventory(Order order, MerchantStore store) {
+		for (OrderProduct line : order.getOrderProducts()) {
+			try {
+				Product product = productService.getBySku(line.getSku(), store);
+				if (product == null || product.getAvailabilities() == null) {
+					throw new StockConflictException("Product " + line.getSku() + " no longer exists");
+				}
+				ProductAvailability target = null;
+				for (ProductAvailability candidate : product.getAvailabilities()) {
+					if (line.getSku() != null && line.getSku().equals(candidate.getSku())) {
+						target = candidate;
+						break;
+					}
+					if (target == null && candidate.getProductVariant() == null) target = candidate;
+				}
+				if (target == null) throw new StockConflictException("Product " + line.getSku() + " has no stock record");
+				target.setProductQuantity(target.getProductQuantity() + line.getProductQuantity());
+				productService.update(product);
+			} catch (ServiceException e) {
+				throw new StockConflictException("Unable to restore stock for " + line.getSku());
+			}
+		}
+	}
