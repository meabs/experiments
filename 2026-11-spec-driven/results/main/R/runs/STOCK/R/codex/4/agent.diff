+	private void validateInventory(Order order, MerchantStore store) throws ServiceException {
+		for (OrderProduct line : order.getOrderProducts()) {
+			Product product = productService.getBySku(line.getSku(), store);
+			ProductAvailability availability = availability(product, line.getSku());
+			if (product == null || availability == null || availability.getProductQuantity() == null
+					|| line.getProductQuantity() > availability.getProductQuantity()) {
+				throw new ServiceException(ServiceException.EXCEPTION_INVENTORY_MISMATCH);
+			}
+		}
+	}
 
+	private void decrementInventory(Order order, MerchantStore store) throws ServiceException {
+		for (OrderProduct line : order.getOrderProducts()) {
+			Product product = productService.getBySku(line.getSku(), store);
+			ProductAvailability availability = availability(product, line.getSku());
+			availability.setProductQuantity(availability.getProductQuantity() - line.getProductQuantity());
+			productService.update(product);
+		}
+	}
 
-    	return order;
