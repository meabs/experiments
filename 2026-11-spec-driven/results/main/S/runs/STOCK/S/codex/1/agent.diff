+	/** Validate the complete prospective cart before it is persisted. */
+	private void validateCartInventory(ShoppingCart cart) {
+		if (CollectionUtils.isEmpty(cart.getLineItems())) {
+			return;
+		}
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem item : cart.getLineItems()) {
+			int stock = effectiveStock(item.getProduct());
+			if (item.getQuantity() > stock) {
+				throw new InventoryConflictException("Insufficient stock for product " + item.getProduct().getSku());
+			}
+		}
+	}
+
+	private int effectiveStock(Product product) {
+		if (CollectionUtils.isEmpty(product.getAvailabilities())) {
+			return 0;
+		}
+		ProductAvailability fallback = null;
+		for (ProductAvailability availability : product.getAvailabilities()) {
+			if (fallback == null) {
+				fallback = availability;
+			}
+			if (availability.getProductVariant() == null && StringUtils.isEmpty(availability.getRegionVariant())) {
+				return availability.getProductQuantity() == null ? 0 : availability.getProductQuantity();
+			}
+		}
+		return fallback.getProductQuantity() == null ? 0 : fallback.getProductQuantity();
+	}
+
