+    private void validateInventory(List<ShoppingCartItem> items, MerchantStore store) throws ServiceException {
+        Map<String, Integer> requested = new HashMap<>();
+        for (ShoppingCartItem item : items) {
+            requested.merge(item.getSku(), item.getQuantity(), Integer::sum);
+        }
+        for (Map.Entry<String, Integer> entry : requested.entrySet()) {
+            Product product = productService.getBySku(entry.getKey(), store);
+            if (product == null || defaultAvailability(product) == null
+                    || defaultStock(product) < entry.getValue()) {
+                throw new InventoryConflictException("Insufficient stock for product " + entry.getKey());
+            }
+        }
+    }
