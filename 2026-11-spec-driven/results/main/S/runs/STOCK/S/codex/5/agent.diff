+	private void validateCartStock(ShoppingCart cart) {
+		if (cart == null || cart.getLineItems() == null) {
+			return;
+		}
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem item : cart.getLineItems()) {
+			if (item.getQuantity() == null || item.getQuantity() <= 0) {
+				continue;
+			}
+			Set<ProductAvailability> availabilities = item.getProduct().getAvailabilities();
+			if (CollectionUtils.isEmpty(availabilities)) {
+				throw new InventoryConflictException("Product " + item.getSku() + " has no stock");
+			}
+			ProductAvailability availability = availabilities.iterator().next();
+			int stock = availability.getProductQuantity() == null ? 0 : availability.getProductQuantity();
+			if (item.getQuantity() > stock) {
+				throw new InventoryConflictException("Insufficient stock for product " + item.getSku());
+			}
+		}
+	}
