+package com.salesmanager.test.business.utils;
+
+import static org.junit.Assert.assertEquals;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import javax.persistence.Query;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.utils.RepositoryHelper;
+import com.salesmanager.core.model.common.GenericEntityList;
+import com.salesmanager.core.model.order.OrderCriteria;
+
+public class RepositoryHelperTest {
+
+    @Test
+    public void paginatesZeroBasedPagesAndCalculatesCeilingPageCount() {
+        Query query = org.mockito.Mockito.mock(Query.class);
+        when(query.setFirstResult(25)).thenReturn(query);
+        when(query.setMaxResults(25)).thenReturn(query);
+
+        OrderCriteria criteria = new OrderCriteria();
+        criteria.setLegacyPagination(false);
+        criteria.setStartPage(1);
+        criteria.setPageSize(25);
+        GenericEntityList<?> entityList = new GenericEntityList<>();
+
+        RepositoryHelper.paginateQuery(query, 26, entityList, criteria);
+
+        verify(query).setFirstResult(25);
+        verify(query).setMaxResults(25);
+        assertEquals(2, entityList.getTotalPages());
+        assertEquals(26, entityList.getTotalCount());
+    }
+
+    @Test
+    public void keepsZeroTotalsForAnEmptyResultSet() {
+        Query query = org.mockito.Mockito.mock(Query.class);
+        when(query.setFirstResult(0)).thenReturn(query);
+        when(query.setMaxResults(25)).thenReturn(query);
+
+        OrderCriteria criteria = new OrderCriteria();
+        criteria.setLegacyPagination(false);
+        criteria.setPageSize(25);
+        GenericEntityList<?> entityList = new GenericEntityList<>();
+
+        RepositoryHelper.paginateQuery(query, 0, entityList, criteria);
+
+        assertEquals(0, entityList.getTotalPages());
+        assertEquals(0, entityList.getTotalCount());
+    }
+}
