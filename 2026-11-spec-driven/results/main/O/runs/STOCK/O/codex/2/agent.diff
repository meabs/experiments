+    @Override
+    @Transactional
+    public void restoreInventory(Order order, MerchantStore store) throws ServiceException {
+        Map<String, Integer> quantities = new HashMap<>();
+        for (OrderProduct item : order.getOrderProducts()) {
+            quantities.merge(item.getSku(), item.getProductQuantity(), Integer::sum);
+        }
+        for (Map.Entry<String, Integer> entry : quantities.entrySet()) {
+            Product product = productService.getBySku(entry.getKey(), store, store.getDefaultLanguage());
+            ProductAvailability availability = defaultAvailability(product);
+            if (availability == null) {
+                throw new ServiceException(ServiceException.EXCEPTION_INVENTORY_MISMATCH,
+                        "Inventory not found for product " + entry.getKey());
+            }
+            availability.setProductQuantity(availability.getProductQuantity() + entry.getValue());
+            productService.update(product);
+        }
+    }
+
+    private ProductAvailability defaultAvailability(Product product) {
+        if (product == null || product.getAvailabilities() == null) return null;
+        for (ProductAvailability availability : product.getAvailabilities()) {
+            if (availability.getProductVariant() == null && availability.getRegionVariant() == null) {
+                return availability;
+            }
+        }
+        return product.getAvailabilities().stream().findFirst().orElse(null);
+    }
