+	private void validateRequestedQuantity(Product product, int requested, ShoppingCart cart,
+			com.salesmanager.core.model.shoppingcart.ShoppingCartItem incoming) {
+		int existing = 0;
+		if (cart.getLineItems() != null) {
+			for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem line : cart.getLineItems()) {
+				if (line != incoming && line.getProduct().getId().equals(product.getId())
+						&& CollectionUtils.isEmpty(line.getAttributes()) && CollectionUtils.isEmpty(incoming.getAttributes())) {
+					existing += line.getQuantity();
+				}
+			}
+		}
+		ProductAvailability stock = product.getAvailabilities().stream()
+				.filter(a -> a.getProductVariant() == null && "*".equals(a.getRegion()) && StringUtils.isEmpty(a.getRegionVariant()))
+				.findFirst().orElse(product.getAvailabilities().iterator().next());
+		if (stock.getProductQuantity() == null || existing + requested > stock.getProductQuantity()) {
+			throw new StockConflictException("Insufficient stock for product " + product.getSku());
+		}
+	}
+
+	private void validateCartStock(ShoppingCart cart) {
+		if (cart.getLineItems() == null) return;
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem line : cart.getLineItems()) {
+			ProductAvailability stock = line.getProduct().getAvailabilities().stream()
+					.filter(a -> a.getProductVariant() == null && "*".equals(a.getRegion()) && StringUtils.isEmpty(a.getRegionVariant()))
+					.findFirst().orElse(line.getProduct().getAvailabilities().iterator().next());
+			if (stock.getProductQuantity() == null || line.getQuantity() > stock.getProductQuantity()) {
+				throw new StockConflictException("Insufficient stock for product " + line.getProduct().getSku());
+			}
+		}
+	}
