+	private void validateAndChangeStock(Order order, MerchantStore store, boolean decrement) throws ServiceException {
+		if (order.getOrderProducts() == null) {
+			throw new ServiceException(ServiceException.EXCEPTION_INVENTORY_MISMATCH);
+		}
+		Map<ProductAvailability, Integer> changes = new HashMap<>();
+		for (OrderProduct line : order.getOrderProducts()) {
+			Product product = productService.getBySku(line.getSku(), store);
+			if (product == null || product.getAvailabilities() == null) {
+				throw new ServiceException(ServiceException.EXCEPTION_INVENTORY_MISMATCH);
+			}
+			ProductAvailability availability = product.getAvailabilities().stream().findFirst().orElse(null);
+			int requested = changes.getOrDefault(availability, 0) + line.getProductQuantity();
+			if (availability == null || availability.getProductQuantity() == null
+					|| availability.getProductQuantity() < requested) {
+				throw new ServiceException(ServiceException.EXCEPTION_INVENTORY_MISMATCH);
+			}
+			changes.put(availability, requested);
+		}
+		if (decrement) {
+			for (Map.Entry<ProductAvailability, Integer> change : changes.entrySet()) {
+				ProductAvailability availability = change.getKey();
+				availability.setProductQuantity(availability.getProductQuantity() - change.getValue());
+				productService.update(availability.getProduct());
+			}
+		}
+	}
