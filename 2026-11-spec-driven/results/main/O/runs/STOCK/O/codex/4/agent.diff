+	private void validateCartStock(ShoppingCart cart) {
+		if (cart.getLineItems() == null) {
+			return;
+		}
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem line : cart.getLineItems()) {
+			if (line.getQuantity() <= 0 || line.getProduct() == null) {
+				continue;
+			}
+			ProductAvailability availability = line.getProduct().getAvailabilities().stream().findFirst().orElse(null);
+			if (availability == null || availability.getProductQuantity() == null
+					|| availability.getProductQuantity() < line.getQuantity()) {
+				throw new StockConflictException("Insufficient stock for product " + line.getSku());
+			}
+		}
+	}
