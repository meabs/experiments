+package com.salesmanager.shop.store.facade.stock;
+
+import java.util.Collection;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.availability.ProductAvailabilityService;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.variant.ProductVariant;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.orderproduct.OrderProduct;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+import com.salesmanager.core.constants.SchemaConstant;
+
+@Service("stockService")
+public class StockServiceImpl implements StockService {
+    @Inject private ProductService productService;
+    @Inject private ProductAvailabilityService availabilityService;
+
+    @Override
+    public void validateCart(Collection<ShoppingCartItem> items, MerchantStore store) {
+        if (items == null) return;
+        for (ShoppingCartItem item : items) {
+            validateProduct(item.getProduct(), item.getQuantity());
+        }
+    }
+
+    @Override
+    @Transactional
+    public void consume(Collection<ShoppingCartItem> items, MerchantStore store) {
+        validateCart(items, store);
+        if (items == null) return;
+        for (ShoppingCartItem item : items) {
+            ProductAvailability availability = availability(item.getProduct());
+            availability.setProductQuantity(availability.getProductQuantity() - item.getQuantity());
+            save(availability);
+        }
+    }
+
+    @Override
+    @Transactional
+    public void restore(Collection<OrderProduct> items, MerchantStore store) {
+        if (items == null) return;
+        for (OrderProduct item : items) {
+            try {
+                Product product = productService.getBySku(item.getSku(), store, store.getDefaultLanguage());
+                if (product != null) {
+                    ProductAvailability availability = availability(product);
+                    availability.setProductQuantity(availability.getProductQuantity() + item.getProductQuantity());
+                    save(availability);
+                }
+            } catch (ServiceException e) {
+                throw new StockConflictException("Unable to restore stock for " + item.getSku());
+            }
+        }
+    }
+
+    @Override
+    public void validateProduct(Product product, int quantity) {
+        if (product == null || quantity < 0) {
+            throw new StockConflictException("Product stock is unavailable");
+        }
+        ProductAvailability availability = availability(product);
+        if (!product.isAvailable() || quantity > availability.getProductQuantity()) {
+            throw new StockConflictException("Insufficient stock for product " + product.getSku());
+        }
+    }
+
+    private ProductAvailability availability(Product product) {
+        if (product.getAvailabilities() != null) {
+            for (ProductAvailability candidate : product.getAvailabilities()) {
+                ProductVariant variant = candidate.getProductVariant();
+                if (variant == null && (candidate.getRegion() == null || SchemaConstant.ALL_REGIONS.equals(candidate.getRegion()))) {
+                    return candidate;
+                }
+            }
+        }
+        throw new StockConflictException("No stock configured for product " + product.getSku());
+    }
+
+    private void save(ProductAvailability availability) {
+        try {
+            availabilityService.saveOrUpdate(availability);
+        } catch (ServiceException e) {
+            throw new StockConflictException("Unable to update stock");
+        }
+    }
+}
