+
+public interface StockService {
+    void validateCart(Collection<ShoppingCartItem> items, MerchantStore store);
+    void consume(Collection<ShoppingCartItem> items, MerchantStore store);
+    void restore(Collection<OrderProduct> items, MerchantStore store);
+    void validateProduct(Product product, int quantity);
+}
