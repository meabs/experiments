+package com.salesmanager.shop.store.controller.inventory;
+
+import java.util.Collection;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.orderproduct.OrderProduct;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service
+public class StockService {
+
+    @Inject
+    private ProductService productService;
+
+    public void assertQuantity(Product product, int quantity) {
+        if (quantity <= 0) {
+            return;
+        }
+        int stock = stock(product);
+        if (stock < quantity) {
+            throw new StockConflictException("Insufficient stock for product " + product.getSku());
+        }
+    }
+
+    public void assertCart(ShoppingCart cart) {
+        if (cart == null || cart.getLineItems() == null) {
+            return;
+        }
+        for (ShoppingCartItem item : cart.getLineItems()) {
+            Product product = item.getProduct();
+            if (product != null) {
+                assertQuantity(product, item.getQuantity());
+            }
+        }
+    }
+
+    @Transactional
+    public void reserve(Collection<OrderProduct> orderProducts, MerchantStore store) throws ServiceException {
+        Map<String, Integer> requested = quantities(orderProducts);
+        Map<String, Product> products = new LinkedHashMap<>();
+        for (Map.Entry<String, Integer> entry : requested.entrySet()) {
+            Product product = productService.getBySku(entry.getKey(), store, store.getDefaultLanguage());
+            if (product == null) {
+                throw new StockConflictException("Product " + entry.getKey() + " no longer exists");
+            }
+            assertQuantity(product, entry.getValue());
+            products.put(entry.getKey(), product);
+        }
+        for (Map.Entry<String, Product> entry : products.entrySet()) {
+            ProductAvailability availability = availability(entry.getValue());
+            availability.setProductQuantity(availability.getProductQuantity() - requested.get(entry.getKey()));
+            productService.update(entry.getValue());
+        }
+    }
+
+    @Transactional
+    public void restore(Collection<OrderProduct> orderProducts, MerchantStore store) throws ServiceException {
+        Map<String, Integer> requested = quantities(orderProducts);
+        for (Map.Entry<String, Integer> entry : requested.entrySet()) {
+            Product product = productService.getBySku(entry.getKey(), store, store.getDefaultLanguage());
+            if (product == null) {
+                throw new StockConflictException("Product " + entry.getKey() + " no longer exists");
+            }
+            ProductAvailability availability = availability(product);
+            availability.setProductQuantity(availability.getProductQuantity() + entry.getValue());
+            productService.update(product);
+        }
+    }
+
+    public int stock(Product product) {
+        return availability(product).getProductQuantity() == null ? 0 : availability(product).getProductQuantity();
+    }
+
+    private ProductAvailability availability(Product product) {
+        if (product == null || product.getAvailabilities() == null || product.getAvailabilities().isEmpty()) {
+            throw new StockConflictException("Product has no inventory");
+        }
+        return product.getAvailabilities().stream()
+                .filter(a -> a.getProductVariant() == null)
+                .findFirst().orElse(product.getAvailabilities().iterator().next());
+    }
+
+    private Map<String, Integer> quantities(Collection<OrderProduct> orderProducts) {
+        Map<String, Integer> quantities = new LinkedHashMap<>();
+        for (OrderProduct product : orderProducts) {
+            quantities.merge(product.getSku(), product.getProductQuantity(), Integer::sum);
+        }
+        return quantities;
+    }
+}
