+package com.salesmanager.test.shop.inventory;
+
+import static org.junit.Assert.assertEquals;
+import java.util.Collections;
+
+import org.junit.Test;
+
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.shop.store.controller.inventory.StockConflictException;
+import com.salesmanager.shop.store.controller.inventory.StockService;
+
+public class StockServiceTest {
+
+    @Test
+    public void quantityIsTheAuthoritativeStock() {
+        Product product = productWithStock(3);
+        StockService service = new StockService();
+
+        service.assertQuantity(product, 3);
+        assertEquals(3, service.stock(product));
+    }
+
+    @Test(expected = StockConflictException.class)
+    public void quantityAboveStockIsRejected() {
+        new StockService().assertQuantity(productWithStock(2), 3);
+    }
+
+    private Product productWithStock(int quantity) {
+        Product product = new Product();
+        ProductAvailability availability = new ProductAvailability();
+        availability.setProduct(product);
+        availability.setProductQuantity(quantity);
+        product.setAvailabilities(Collections.singleton(availability));
+        product.setSku("TEST");
+        return product;
+    }
+}
