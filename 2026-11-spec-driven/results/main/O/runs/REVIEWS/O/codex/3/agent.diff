+import com.salesmanager.shop.model.catalog.product.ReadableProductReview;
+
+public class ReadableProductReviewSerializationTest {
+
+  @Test
+  public void serializesOnlyPublicReviewFields() throws Exception {
+    ReadableProductReview review = new ReadableProductReview();
+    review.setId(7L);
+    review.setRating(4D);
+    review.setDescription("Good");
+    review.setDate("2026-11-18");
+    review.setFirstName("Ada");
+    review.setProductId(12L);
+    review.setLanguage("en");
+
+    String json = new ObjectMapper().writeValueAsString(review);
+    assertTrue(json.contains("\"id\""));
+    assertTrue(json.contains("\"rating\""));
+    assertTrue(json.contains("\"description\""));
+    assertTrue(json.contains("\"date\""));
+    assertTrue(json.contains("\"firstName\""));
+    assertFalse(json.contains("productId"));
+    assertFalse(json.contains("language"));
+    assertFalse(json.contains("customer"));
+    assertFalse(json.contains("email"));
+    assertFalse(json.contains("address"));
+  }
+}
