+	private void refreshProductRating(Product product) throws ServiceException {
+		List<ProductReview> reviews = productReviewRepository.findByProductNoCustomers(product.getId());
+		int count = reviews.size();
+		BigDecimal average = BigDecimal.ZERO;
+		if (count > 0) {
+			BigDecimal total = BigDecimal.ZERO;
+			for (ProductReview existing : reviews) {
+				total = total.add(BigDecimal.valueOf(existing.getReviewRating()));
+			}
+			average = total.divide(BigDecimal.valueOf(count), 1, RoundingMode.HALF_UP);
+		}
+		product.setProductReviewAvg(average);
+		product.setProductReviewCount(count);
+		productService.update(product);
+	}
