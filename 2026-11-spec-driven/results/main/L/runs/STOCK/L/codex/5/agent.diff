+	private void validateCartStock(ShoppingCart cart) {
+		if (cart == null || cart.getLineItems() == null) {
+			return;
+		}
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem item : cart.getLineItems()) {
+			ProductAvailability availability = defaultAvailability(item.getProduct());
+			if (item.getQuantity() > 0 && (availability == null || availability.getProductQuantity() == null
+					|| item.getQuantity() > availability.getProductQuantity())) {
+				throw new StockConflictException("Insufficient stock for product " + item.getProduct().getSku());
+			}
+		}
+	}
+
+	private ProductAvailability defaultAvailability(Product product) {
+		if (product == null || product.getAvailabilities() == null) {
+			return null;
+		}
+		for (ProductAvailability availability : product.getAvailabilities()) {
+			if (availability.getProductVariant() == null && SchemaConstant.ALL_REGIONS.equals(availability.getRegion())
+					&& StringUtils.isEmpty(availability.getRegionVariant())) {
+				return availability;
+			}
+		}
+		for (ProductAvailability availability : product.getAvailabilities()) {
+			if (availability.getProductVariant() == null) {
+				return availability;
+			}
+		}
+		return null;
+	}
