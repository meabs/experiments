+	private void validateCartStock(ShoppingCart cart) {
+		if (cart.getLineItems() == null) {
+			return;
+		}
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem item : cart.getLineItems()) {
+			if (item.getQuantity() < 0 || item.getProduct().getAvailabilities() == null
+					|| item.getProduct().getAvailabilities().isEmpty()) {
+				throw new ConflictException("Insufficient stock for product " + item.getProduct().getSku());
+			}
+			ProductAvailability availability = defaultAvailability(item.getProduct().getAvailabilities());
+			if (availability == null || availability.getProductQuantity() == null
+					|| item.getQuantity() > availability.getProductQuantity()) {
+				throw new ConflictException("Insufficient stock for product " + item.getProduct().getSku());
+			}
+		}
+	}
+
+	private ProductAvailability defaultAvailability(Set<ProductAvailability> availabilities) {
+		if (CollectionUtils.isEmpty(availabilities)) {
+			return null;
+		}
+		for (ProductAvailability availability : availabilities) {
+			if (availability.getProductVariant() == null && StringUtils.isEmpty(availability.getRegionVariant())) {
+				return availability;
+			}
+		}
+		return availabilities.iterator().next();
+	}
