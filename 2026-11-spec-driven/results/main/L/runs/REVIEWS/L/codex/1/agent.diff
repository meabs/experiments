+	@Override
+	public ProductReview getById(Long id) {
+		if (id == null) {
+			return null;
+		}
+		return productReviewRepository.findById(id).orElse(null);
+	}
+
+	@Override
+	@Transactional
+	public void delete(ProductReview review) throws ServiceException {
+		Product product = review.getProduct();
+		super.delete(review);
+		productReviewRepository.flush();
+		recalculateProductRating(product);
+		productService.update(product);
+	}
+
+	private void recalculateProductRating(Product product) {
+		List<ProductReview> reviews = productReviewRepository.findByProductNoCustomers(product.getId());
+		BigDecimal total = BigDecimal.ZERO;
+		for (ProductReview existing : reviews) {
+			if (existing.getReviewRating() != null) {
+				total = total.add(BigDecimal.valueOf(existing.getReviewRating()));
+			}
+		}
+		int count = reviews.size();
+		product.setProductReviewCount(count);
+		product.setProductReviewAvg(count == 0 ? BigDecimal.ZERO.setScale(1) :
+				total.divide(BigDecimal.valueOf(count), 1, RoundingMode.HALF_UP));
+	}
