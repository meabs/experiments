+	private void addDescendants(Category category, List<Category> categories) {
+		for (Category child : category.getCategories()) {
+			if (categories.stream().noneMatch(existing -> existing.getId().equals(child.getId()))) {
+				categories.add(child);
+			}
+			addDescendants(child, categories);
+		}
+	}
