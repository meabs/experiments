+	private int maxLineQuantity(MerchantStore store) {
+		try {
+			com.salesmanager.core.model.system.MerchantConfiguration c = merchantConfigurationService
+					.getMerchantConfiguration("CART_MAX_LINE_QUANTITY", store);
+			if (c != null && StringUtils.isNotBlank(c.getValue())) {
+				return Integer.parseInt(c.getValue().trim());
+			}
+		} catch (Exception e) {
+			LOG.warn("Invalid CART_MAX_LINE_QUANTITY, using " + DEFAULT_MAX_LINE_QUANTITY, e);
+		}
+		return DEFAULT_MAX_LINE_QUANTITY;
+	}
+
+	private void checkLineQuantity(long quantity, MerchantStore store) {
+		int max = maxLineQuantity(store);
