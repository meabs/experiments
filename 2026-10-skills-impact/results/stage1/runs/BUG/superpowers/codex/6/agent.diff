+package com.salesmanager.test.shop.mapper.catalog.product;
+
+import static org.junit.Assert.assertEquals;
+
+import java.util.Date;
+
+import org.junit.Test;
+
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.mapper.catalog.product.PersistableProductAvailabilityMapper;
+import com.salesmanager.shop.model.catalog.product.PersistableProductPrice;
+import com.salesmanager.shop.model.catalog.product.product.PersistableProductInventory;
+import com.salesmanager.shop.utils.DateUtil;
+
+public class PersistableProductAvailabilityMapperTest {
+
+	@Test
+	public void mapsDiscountEndDateToSpecialEndDate() throws Exception {
+		PersistableProductPrice sourcePrice = new PersistableProductPrice();
+		sourcePrice.setPrice(new java.math.BigDecimal("10.00"));
+		sourcePrice.setDiscountedPrice(new java.math.BigDecimal("8.00"));
+		sourcePrice.setDiscountStartDate("2026-10-01");
+		sourcePrice.setDiscountEndDate("2026-10-31");
+
+		PersistableProductInventory source = new PersistableProductInventory();
+		source.setPrice(sourcePrice);
+
+		ProductAvailability result = new PersistableProductAvailabilityMapper().convert(source,
+				new MerchantStore(1, MerchantStore.DEFAULT_STORE, "Default"), null);
+		ProductPrice resultPrice = result.getPrices().iterator().next();
+
+		Date expectedStart = DateUtil.getDate("2026-10-01");
+		Date expectedEnd = DateUtil.getDate("2026-10-31");
+		assertEquals(expectedStart, resultPrice.getProductPriceSpecialStartDate());
+		assertEquals(expectedEnd, resultPrice.getProductPriceSpecialEndDate());
+	}
+}
