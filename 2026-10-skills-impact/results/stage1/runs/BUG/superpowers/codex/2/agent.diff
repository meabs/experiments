+package com.salesmanager.test.shop.mapper.catalog.product;
+
+import static org.hamcrest.CoreMatchers.equalTo;
+import static org.hamcrest.CoreMatchers.nullValue;
+import static org.hamcrest.MatcherAssert.assertThat;
+
+import java.math.BigDecimal;
+import java.util.Date;
+
+import org.junit.Test;
+
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.mapper.catalog.product.PersistableProductAvailabilityMapper;
+import com.salesmanager.shop.model.catalog.product.PersistableProductPrice;
+import com.salesmanager.shop.model.catalog.product.product.PersistableProductInventory;
+import com.salesmanager.shop.utils.DateUtil;
+
+public class PersistableProductAvailabilityMapperTest {
+
+	@Test
+	public void mapsDiscountEndDateToEndDateWithoutOverwritingStartDate() throws Exception {
+		PersistableProductPrice sourcePrice = new PersistableProductPrice();
+		sourcePrice.setPrice(new BigDecimal("250"));
+		sourcePrice.setDiscountedPrice(new BigDecimal("125"));
+		sourcePrice.setDiscountStartDate("2099-01-01");
+		sourcePrice.setDiscountEndDate("2099-12-31");
+
+		PersistableProductInventory source = new PersistableProductInventory();
+		source.setPrice(sourcePrice);
+
+		ProductAvailability mapped = new PersistableProductAvailabilityMapper().convert(source,
+				new MerchantStore(), new Language());
+		ProductPrice mappedPrice = mapped.getPrices().iterator().next();
+
+		Date expectedStartDate = DateUtil.getDate("2099-01-01");
+		Date expectedEndDate = DateUtil.getDate("2099-12-31");
+		assertThat(mappedPrice.getProductPriceSpecialStartDate(), equalTo(expectedStartDate));
+		assertThat(mappedPrice.getProductPriceSpecialEndDate(), equalTo(expectedEndDate));
+	}
+
+	@Test
+	public void leavesStartDateUnsetWhenOnlyDiscountEndDateIsProvided() throws Exception {
+		PersistableProductPrice sourcePrice = new PersistableProductPrice();
+		sourcePrice.setPrice(new BigDecimal("250"));
+		sourcePrice.setDiscountedPrice(new BigDecimal("125"));
+		sourcePrice.setDiscountEndDate("2099-12-31");
+
+		PersistableProductInventory source = new PersistableProductInventory();
+		source.setPrice(sourcePrice);
+
+		ProductAvailability mapped = new PersistableProductAvailabilityMapper().convert(source,
+				new MerchantStore(), new Language());
+		ProductPrice mappedPrice = mapped.getPrices().iterator().next();
+
+		assertThat(mappedPrice.getProductPriceSpecialStartDate(), nullValue());
+		assertThat(mappedPrice.getProductPriceSpecialEndDate(), equalTo(DateUtil.getDate("2099-12-31")));
+	}
+}
