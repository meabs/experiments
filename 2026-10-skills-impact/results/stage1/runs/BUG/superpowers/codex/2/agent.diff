+package com.salesmanager.test.business.utils;
+
+import static org.hamcrest.CoreMatchers.equalTo;
+import static org.hamcrest.MatcherAssert.assertThat;
+import static org.junit.Assert.assertTrue;
+
+import java.math.BigDecimal;
+import java.util.Calendar;
+import java.util.Date;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.utils.ProductPriceUtils;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.FinalPrice;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+
+public class ProductPriceUtilsTest {
+
+	@Test
+	public void appliesDiscountWhenCurrentDateIsBetweenStartAndEnd() throws Exception {
+		ProductPrice price = new ProductPrice();
+		price.setDefaultPrice(true);
+		price.setProductPriceAmount(new BigDecimal("250"));
+		price.setProductPriceSpecialAmount(new BigDecimal("125"));
+		price.setProductPriceSpecialStartDate(addDaysToCurrentDate(-1));
+		price.setProductPriceSpecialEndDate(addDaysToCurrentDate(1));
+
+		ProductAvailability availability = new ProductAvailability();
+		availability.getPrices().add(price);
+		price.setProductAvailability(availability);
+
+		FinalPrice finalPrice = new ProductPriceUtils().getFinalPrice(availability);
+
+		assertTrue(finalPrice.isDiscounted());
+		assertThat(finalPrice.getFinalPrice(), equalTo(new BigDecimal("125")));
+	}
+
+	private Date addDaysToCurrentDate(int days) {
+		Calendar calendar = Calendar.getInstance();
+		calendar.add(Calendar.DATE, days);
+		return calendar.getTime();
+	}
+}
