diff --git a/sm-core/src/test/java/com/salesmanager/test/business/utils/ProductPriceUtilsSpecialPriceTest.java b/sm-core/src/test/java/com/salesmanager/test/business/utils/ProductPriceUtilsSpecialPriceTest.java
