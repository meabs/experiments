+package com.salesmanager.test.shop.mapper;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+
+import org.junit.Test;
+
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.mapper.catalog.product.PersistableProductAvailabilityMapper;
+import com.salesmanager.shop.model.catalog.product.PersistableProductPrice;
+import com.salesmanager.shop.model.catalog.product.product.PersistableProductInventory;
+import com.salesmanager.shop.utils.DateUtil;
+
+public class PersistableProductAvailabilityMapperTest {
+
+	@Test
+	public void mapsSpecialEndDateOntoEndDate() throws Exception {
+		PersistableProductPrice price = new PersistableProductPrice();
+		price.setPrice(new BigDecimal("100"));
+		price.setDiscountedPrice(new BigDecimal("80"));
+		price.setDefaultPrice(true);
+		price.setDiscountStartDate("2026-01-01");
+		price.setDiscountEndDate("2026-12-31");
+
+		PersistableProductInventory inventory = new PersistableProductInventory();
+		inventory.setQuantity(1);
+		inventory.setPrice(price);
+
+		MerchantStore store = new MerchantStore();
+		store.setLanguages(new ArrayList<Language>());
+
+		ProductAvailability availability = new PersistableProductAvailabilityMapper().convert(inventory, store,
+				new Language());
+
+		ProductPrice mapped = availability.getPrices().iterator().next();
+		assertEquals(DateUtil.getDate("2026-01-01"), mapped.getProductPriceSpecialStartDate());
+		assertNotNull(mapped.getProductPriceSpecialEndDate());
+		assertEquals(DateUtil.getDate("2026-12-31"), mapped.getProductPriceSpecialEndDate());
+	}
+
+	@Test
+	public void endDateAloneDoesNotBecomeTheStartDate() throws Exception {
+		PersistableProductPrice price = new PersistableProductPrice();
+		price.setPrice(new BigDecimal("100"));
+		price.setDiscountedPrice(new BigDecimal("80"));
+		price.setDefaultPrice(true);
+		price.setDiscountEndDate("2026-12-31");
+
+		PersistableProductInventory inventory = new PersistableProductInventory();
+		inventory.setQuantity(1);
+		inventory.setPrice(price);
+
+		MerchantStore store = new MerchantStore();
+		store.setLanguages(new ArrayList<Language>());
+
+		ProductAvailability availability = new PersistableProductAvailabilityMapper().convert(inventory, store,
+				new Language());
+
+		ProductPrice mapped = availability.getPrices().iterator().next();
+		assertNull(mapped.getProductPriceSpecialStartDate());
+		assertEquals(DateUtil.getDate("2026-12-31"), mapped.getProductPriceSpecialEndDate());
+	}
+}
