+package com.salesmanager.test.utils;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import java.math.BigDecimal;
+import java.util.Calendar;
+import java.util.Date;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.constants.Constants;
+import com.salesmanager.core.business.utils.ProductPriceUtils;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.FinalPrice;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+
+public class ProductPriceUtilsSpecialPriceTest {
+
+	private final ProductPriceUtils priceUtils = new ProductPriceUtils();
+
+	@Test
+	public void specialWithNoDatesIsDiscounted() throws Exception {
+		FinalPrice finalPrice = priceUtils.getFinalPrice(product(null, null));
+
+		assertTrue(finalPrice.isDiscounted());
+		assertEquals(new BigDecimal("80"), finalPrice.getFinalPrice());
+	}
+
+	@Test
+	public void specialWithStartAndEndDateIsDiscountedWhileActive() throws Exception {
+		FinalPrice finalPrice = priceUtils.getFinalPrice(product(daysFromToday(-2), daysFromToday(10)));
+
+		assertTrue(finalPrice.isDiscounted());
+		assertEquals(new BigDecimal("80"), finalPrice.getFinalPrice());
+	}
+
+	@Test
+	public void specialWithOnlyEndDateIsDiscountedWhileActive() throws Exception {
+		FinalPrice finalPrice = priceUtils.getFinalPrice(product(null, daysFromToday(10)));
+
+		assertTrue(finalPrice.isDiscounted());
+		assertEquals(new BigDecimal("80"), finalPrice.getFinalPrice());
+	}
+
+	@Test
+	public void specialWithEndDateInThePastIsNotDiscounted() throws Exception {
+		FinalPrice finalPrice = priceUtils.getFinalPrice(product(daysFromToday(-10), daysFromToday(-1)));
+
+		assertFalse(finalPrice.isDiscounted());
+		assertEquals(new BigDecimal("100"), finalPrice.getFinalPrice());
+	}
+
+	private Product product(Date start, Date end) {
+		ProductPrice price = new ProductPrice();
+		price.setDefaultPrice(true);
+		price.setProductPriceAmount(new BigDecimal("100"));
+		price.setProductPriceSpecialAmount(new BigDecimal("80"));
+		price.setProductPriceSpecialStartDate(start);
+		price.setProductPriceSpecialEndDate(end);
+
+		ProductAvailability availability = new ProductAvailability();
+		availability.setRegion(Constants.ALL_REGIONS);
+		availability.getPrices().add(price);
+
+		Product product = new Product();
+		product.getAvailabilities().add(availability);
+		return product;
+	}
+
+	private Date daysFromToday(int days) {
+		Calendar calendar = Calendar.getInstance();
+		calendar.add(Calendar.DATE, days);
+		return calendar.getTime();
+	}
+}
