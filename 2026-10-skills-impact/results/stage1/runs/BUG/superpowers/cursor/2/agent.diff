+package com.salesmanager.shop.mapper.catalog.product;
+
+import java.util.Calendar;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.catalog.product.PersistableProductPrice;
+import com.salesmanager.shop.model.catalog.product.product.PersistableProductInventory;
+import com.salesmanager.shop.utils.DateUtil;
+
+public class PersistableProductAvailabilityMapperTest {
+
+	@Test
+	public void endDateIsStoredAsSpecialEndDate() throws Exception {
+		PersistableProductPrice price = new PersistableProductPrice();
+		price.setPrice(new java.math.BigDecimal("20.00"));
+		price.setDiscountedPrice(new java.math.BigDecimal("10.00"));
+		price.setDiscountEndDate(DateUtil.formatDate(tomorrow()));
+
+		PersistableProductInventory inventory = new PersistableProductInventory();
+		inventory.setQuantity(1);
+		inventory.setPrice(price);
+
+		Language language = new Language();
+		language.setCode("en");
+		MerchantStore store = new MerchantStore();
+		store.setDefaultLanguage(language);
+
+		ProductAvailability availability = new PersistableProductAvailabilityMapper().convert(inventory, store,
+				language);
+		ProductPrice stored = availability.getPrices().iterator().next();
+
+		Assert.assertNull(stored.getProductPriceSpecialStartDate());
+		Assert.assertNotNull(stored.getProductPriceSpecialEndDate());
+	}
+
+	private java.util.Date tomorrow() {
+		Calendar calendar = Calendar.getInstance();
+		calendar.add(Calendar.DATE, 1);
+		return calendar.getTime();
+	}
+}
