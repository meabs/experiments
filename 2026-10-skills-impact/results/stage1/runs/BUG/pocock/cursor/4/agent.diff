+package com.salesmanager.test.utils;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import java.math.BigDecimal;
+import java.util.Calendar;
+import java.util.Date;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.utils.ProductPriceUtils;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.FinalPrice;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+
+public class ProductPriceUtilsSpecialPriceTest {
+
+	private final ProductPriceUtils utils = new ProductPriceUtils();
+
+	@Test
+	public void specialWithStartAndEndDateIsAppliedWhileActive() throws Exception {
+		FinalPrice price = utils.getFinalPrice(availability(daysFromToday(-1), daysFromToday(10)));
+		assertTrue(price.isDiscounted());
+		assertEquals(0, new BigDecimal("8.00").compareTo(price.getFinalPrice()));
+	}
+
+	@Test
+	public void specialWithOnlyEndDateIsAppliedWhileActive() throws Exception {
+		FinalPrice price = utils.getFinalPrice(availability(null, daysFromToday(10)));
+		assertTrue(price.isDiscounted());
+		assertEquals(0, new BigDecimal("8.00").compareTo(price.getFinalPrice()));
+	}
+
+	@Test
+	public void specialWithNoDatesUsesSpecialAmount() throws Exception {
+		FinalPrice price = utils.getFinalPrice(availability(null, null));
+		assertTrue(price.isDiscounted());
+		assertEquals(0, new BigDecimal("8.00").compareTo(price.getFinalPrice()));
+	}
+
+	private ProductAvailability availability(Date start, Date end) {
+		ProductPrice price = new ProductPrice();
+		price.setDefaultPrice(true);
+		price.setProductPriceAmount(new BigDecimal("10.00"));
+		price.setProductPriceSpecialAmount(new BigDecimal("8.00"));
+		price.setProductPriceSpecialStartDate(start);
+		price.setProductPriceSpecialEndDate(end);
+
+		ProductAvailability availability = new ProductAvailability();
+		availability.getPrices().add(price);
+		return availability;
+	}
+
+	private Date daysFromToday(int days) {
+		Calendar calendar = Calendar.getInstance();
+		calendar.add(Calendar.DATE, days);
+		return calendar.getTime();
+	}
+}
