+package com.salesmanager.test.utils;
+
+import java.math.BigDecimal;
+import java.util.Calendar;
+import java.util.Date;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.utils.ProductPriceUtils;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.FinalPrice;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+
+public class ProductPriceUtilsSpecialTest {
+
+	private final ProductPriceUtils priceUtils = new ProductPriceUtils();
+
+	@Test
+	public void specialWithEndDateOnlyIsDiscountedThroughThatDay() throws ServiceException {
+		FinalPrice price = finalPrice(null, today());
+		Assert.assertTrue(price.isDiscounted());
+		Assert.assertEquals(0, new BigDecimal("15.00").compareTo(price.getFinalPrice()));
+	}
+
+	@Test
+	public void specialWithStartAndEndDateIsDiscounted() throws ServiceException {
+		FinalPrice price = finalPrice(daysFromToday(-2), daysFromToday(10));
+		Assert.assertTrue(price.isDiscounted());
+		Assert.assertEquals(0, new BigDecimal("15.00").compareTo(price.getFinalPrice()));
+	}
+
+	@Test
+	public void specialEndingYesterdayIsNotDiscounted() throws ServiceException {
+		FinalPrice price = finalPrice(daysFromToday(-5), daysFromToday(-1));
+		Assert.assertFalse(price.isDiscounted());
+		Assert.assertEquals(0, new BigDecimal("20.00").compareTo(price.getFinalPrice()));
+	}
+
+	@Test
+	public void specialWithNoDatesUsesSpecialAmount() throws ServiceException {
+		FinalPrice price = finalPrice(null, null);
+		Assert.assertTrue(price.isDiscounted());
+		Assert.assertEquals(0, new BigDecimal("15.00").compareTo(price.getFinalPrice()));
+	}
+
+	private FinalPrice finalPrice(Date start, Date end) throws ServiceException {
+		ProductPrice price = new ProductPrice();
+		price.setDefaultPrice(true);
+		price.setProductPriceAmount(new BigDecimal("20.00"));
+		price.setProductPriceSpecialAmount(new BigDecimal("15.00"));
+		price.setProductPriceSpecialStartDate(start);
+		price.setProductPriceSpecialEndDate(end);
+
+		ProductAvailability availability = new ProductAvailability();
+		availability.getPrices().add(price);
+		return priceUtils.getFinalPrice(availability);
+	}
+
+	private static Date today() {
+		return daysFromToday(0);
+	}
+
+	private static Date daysFromToday(int days) {
+		Calendar calendar = Calendar.getInstance();
+		calendar.set(Calendar.HOUR_OF_DAY, 0);
+		calendar.set(Calendar.MINUTE, 0);
+		calendar.set(Calendar.SECOND, 0);
+		calendar.set(Calendar.MILLISECOND, 0);
+		calendar.add(Calendar.DATE, days);
+		return calendar.getTime();
+	}
+}
