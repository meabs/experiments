+package com.salesmanager.test.shop.util;
+
+import static org.junit.Assert.assertEquals;
+
+import java.math.BigDecimal;
+
+import org.junit.Test;
+
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.mapper.catalog.product.PersistableProductAvailabilityMapper;
+import com.salesmanager.shop.model.catalog.product.PersistableProductPrice;
+import com.salesmanager.shop.model.catalog.product.product.PersistableProductInventory;
+
+public class PersistableProductAvailabilityMapperTest {
+
+	@Test
+	public void mapsDiscountEndDateOntoSpecialEndDate() throws Exception {
+		PersistableProductPrice price = new PersistableProductPrice();
+		price.setDefaultPrice(true);
+		price.setPrice(new BigDecimal("100.00"));
+		price.setDiscountedPrice(new BigDecimal("80.00"));
+		price.setDiscountStartDate("2020-01-01");
+		price.setDiscountEndDate("2030-01-01");
+
+		PersistableProductInventory inventory = new PersistableProductInventory();
+		inventory.setQuantity(1);
+		inventory.setPrice(price);
+
+		Language language = new Language();
+		language.setCode("en");
+		MerchantStore store = new MerchantStore();
+		store.getLanguages().add(language);
+
+		ProductAvailability availability = new PersistableProductAvailabilityMapper()
+				.convert(inventory, store, language);
+
+		ProductPrice mapped = availability.getPrices().iterator().next();
+		assertEquals(com.salesmanager.shop.utils.DateUtil.getDate("2020-01-01"), mapped.getProductPriceSpecialStartDate());
+		assertEquals(com.salesmanager.shop.utils.DateUtil.getDate("2030-01-01"), mapped.getProductPriceSpecialEndDate());
+	}
+}
