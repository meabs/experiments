+package com.salesmanager.test.shop.mapper.catalog.product;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+
+import java.math.BigDecimal;
+
+import org.junit.Test;
+
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.mapper.catalog.product.PersistableProductAvailabilityMapper;
+import com.salesmanager.shop.model.catalog.product.PersistableProductPrice;
+import com.salesmanager.shop.model.catalog.product.product.PersistableProductInventory;
+import com.salesmanager.shop.utils.DateUtil;
+
+public class PersistableProductAvailabilityMapperTest {
+
+	private final PersistableProductAvailabilityMapper mapper = new PersistableProductAvailabilityMapper();
+
+	@Test
+	public void mapsDiscountEndDateToSpecialEndDateWhenStartDateIsAbsent() throws Exception {
+		final String endDate = "2099-12-31";
+		final PersistableProductPrice price = new PersistableProductPrice();
+		price.setPrice(new BigDecimal("100.00"));
+		price.setDiscountedPrice(new BigDecimal("75.00"));
+		price.setDiscountEndDate(endDate);
+
+		final PersistableProductInventory inventory = new PersistableProductInventory();
+		inventory.setPrice(price);
+
+		final ProductAvailability mapped = mapper.convert(inventory, new MerchantStore(1, "DEFAULT", "Default"), null);
+		final ProductPrice mappedPrice = mapped.getPrices().iterator().next();
+
+		assertNull(mappedPrice.getProductPriceSpecialStartDate());
+		assertEquals(DateUtil.getDate(endDate), mappedPrice.getProductPriceSpecialEndDate());
+	}
+}
