+package com.salesmanager.test.catalog;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import java.math.BigDecimal;
+import java.text.SimpleDateFormat;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.constants.Constants;
+import com.salesmanager.core.business.utils.ProductPriceUtils;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.FinalPrice;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+
+public class ProductPriceUtilsTest {
+
+	@Test
+	public void appliesSpecialPriceWhenStartAndEndDatesContainToday() throws Exception {
+		final SimpleDateFormat dateFormat = new SimpleDateFormat("yyyy-MM-dd");
+		final BigDecimal specialPrice = new BigDecimal("75.00");
+		final ProductPrice price = new ProductPrice();
+		price.setDefaultPrice(true);
+		price.setProductPriceAmount(new BigDecimal("100.00"));
+		price.setProductPriceSpecialAmount(specialPrice);
+		price.setProductPriceSpecialStartDate(dateFormat.parse("2020-01-01"));
+		price.setProductPriceSpecialEndDate(dateFormat.parse("2099-12-31"));
+
+		final ProductAvailability availability = new ProductAvailability();
+		availability.setRegion(Constants.ALL_REGIONS);
+		availability.getPrices().add(price);
+
+		final FinalPrice finalPrice = new ProductPriceUtils().getFinalPrice(availability);
+
+		assertTrue(finalPrice.isDiscounted());
+		assertEquals(specialPrice, finalPrice.getFinalPrice());
+	}
+}
