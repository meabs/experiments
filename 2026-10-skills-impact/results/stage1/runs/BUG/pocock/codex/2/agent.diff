+package com.salesmanager.test.catalog;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import java.math.BigDecimal;
+import java.util.Date;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.utils.ProductPriceUtils;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+import com.salesmanager.core.model.catalog.product.price.FinalPrice;
+
+public class ProductPriceUtilsTest {
+
+	private static final BigDecimal REGULAR_PRICE = new BigDecimal("100.00");
+	private static final BigDecimal SPECIAL_PRICE = new BigDecimal("80.00");
+
+	@Test
+	public void appliesSpecialWithStartAndEndDates() throws Exception {
+		FinalPrice finalPrice = priceWithSpecialDates(new Date(0), new Date(Long.MAX_VALUE));
+
+		assertTrue(finalPrice.isDiscounted());
+		assertEquals(SPECIAL_PRICE, finalPrice.getFinalPrice());
+	}
+
+	@Test
+	public void appliesSpecialWithEndDateOnly() throws Exception {
+		FinalPrice finalPrice = priceWithSpecialDates(null, new Date(Long.MAX_VALUE));
+
+		assertTrue(finalPrice.isDiscounted());
+		assertEquals(SPECIAL_PRICE, finalPrice.getFinalPrice());
+	}
+
+	@Test
+	public void appliesSpecialWithoutDates() throws Exception {
+		FinalPrice finalPrice = priceWithSpecialDates(null, null);
+
+		assertTrue(finalPrice.isDiscounted());
+		assertEquals(SPECIAL_PRICE, finalPrice.getFinalPrice());
+	}
+
+	private FinalPrice priceWithSpecialDates(Date startDate, Date endDate) throws Exception {
+		Product product = new Product();
+		ProductAvailability availability = new ProductAvailability();
+		availability.setRegion("*");
+		availability.setProduct(product);
+		product.getAvailabilities().add(availability);
+
+		ProductPrice price = new ProductPrice();
+		price.setDefaultPrice(true);
+		price.setProductPriceAmount(REGULAR_PRICE);
+		price.setProductPriceSpecialAmount(SPECIAL_PRICE);
+		price.setProductPriceSpecialStartDate(startDate);
+		price.setProductPriceSpecialEndDate(endDate);
+		price.setProductAvailability(availability);
+		availability.getPrices().add(price);
+
+		return new ProductPriceUtils().getFinalPrice(product);
+	}
+}
