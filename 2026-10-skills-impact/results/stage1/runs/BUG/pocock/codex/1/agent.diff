+package com.salesmanager.test.shop.mapper;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import java.math.BigDecimal;
+import java.text.SimpleDateFormat;
+import java.util.Calendar;
+import java.util.Date;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.utils.ProductPriceUtils;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.FinalPrice;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.mapper.catalog.product.PersistableProductAvailabilityMapper;
+import com.salesmanager.shop.model.catalog.product.PersistableProductPrice;
+import com.salesmanager.shop.model.catalog.product.product.PersistableProductInventory;
+
+public class PersistableProductAvailabilityMapperTest {
+
+	private static final String DATE_FORMAT = "yyyy-MM-dd";
+
+	@Test
+	public void mapsEndDateOnlySpecialAndAppliesItToStorefrontPrice() throws Exception {
+		ProductAvailability availability = mapPrice(null, daysFromNow(1));
+		FinalPrice finalPrice = new ProductPriceUtils().getFinalPrice(product(availability));
+
+		assertNull(availability.defaultPrice().getProductPriceSpecialStartDate());
+		assertTrue(finalPrice.isDiscounted());
+		assertEquals(50, finalPrice.getFinalPrice().intValue());
+	}
+
+	@Test
+	public void mapsBoundedSpecialAndAppliesItToStorefrontPrice() throws Exception {
+		ProductAvailability availability = mapPrice(daysFromNow(-1), daysFromNow(1));
+		FinalPrice finalPrice = new ProductPriceUtils().getFinalPrice(product(availability));
+
+		assertTrue(finalPrice.isDiscounted());
+		assertEquals(50, finalPrice.getFinalPrice().intValue());
+	}
+
+	private ProductAvailability mapPrice(Date startDate, Date endDate) {
+		PersistableProductPrice price = new PersistableProductPrice();
+		price.setDefaultPrice(true);
+		price.setPrice(new BigDecimal("100"));
+		price.setDiscountedPrice(new BigDecimal("50"));
+		price.setDiscountStartDate(format(startDate));
+		price.setDiscountEndDate(format(endDate));
+
+		PersistableProductInventory inventory = new PersistableProductInventory();
+		inventory.setQuantity(1);
+		inventory.setPrice(price);
+
+		return new PersistableProductAvailabilityMapper().convert(inventory, new MerchantStore(), null);
+	}
+
+	private Product product(ProductAvailability availability) {
+		Product product = new Product();
+		product.getAvailabilities().add(availability);
+		availability.setProduct(product);
+		return product;
+	}
+
+	private Date daysFromNow(int days) {
+		Calendar calendar = Calendar.getInstance();
+		calendar.add(Calendar.DATE, days);
+		return calendar.getTime();
+	}
+
+	private String format(Date date) {
+		return date == null ? null : new SimpleDateFormat(DATE_FORMAT).format(date);
+	}
+}
