+package com.salesmanager.test.business.utils;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import java.math.BigDecimal;
+import java.util.Calendar;
+import java.util.Date;
+import java.util.HashSet;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.constants.Constants;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.utils.ProductPriceUtils;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.FinalPrice;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+
+public class ProductPriceUtilsSpecialPriceTest {
+
+	@Test
+	public void specialWithStartAndEndDateIsApplied() throws ServiceException {
+		FinalPrice price = priceWithSpecial(daysFromNow(-2), daysFromNow(10));
+		assertTrue(price.isDiscounted());
+		assertEquals(0, new BigDecimal("8.00").compareTo(price.getFinalPrice()));
+	}
+
+	@Test
+	public void specialWithOnlyEndDateIsApplied() throws ServiceException {
+		FinalPrice price = priceWithSpecial(null, daysFromNow(10));
+		assertTrue(price.isDiscounted());
+		assertEquals(0, new BigDecimal("8.00").compareTo(price.getFinalPrice()));
+	}
+
+	@Test
+	public void specialWithNoDatesIsApplied() throws ServiceException {
+		FinalPrice price = priceWithSpecial(null, null);
+		assertTrue(price.isDiscounted());
+		assertEquals(0, new BigDecimal("8.00").compareTo(price.getFinalPrice()));
+	}
+
+	private FinalPrice priceWithSpecial(Date start, Date end) throws ServiceException {
+		ProductPrice productPrice = new ProductPrice();
+		productPrice.setDefaultPrice(true);
+		productPrice.setProductPriceAmount(new BigDecimal("10.00"));
+		productPrice.setProductPriceSpecialAmount(new BigDecimal("8.00"));
+		productPrice.setProductPriceSpecialStartDate(start);
+		productPrice.setProductPriceSpecialEndDate(end);
+
+		ProductAvailability availability = new ProductAvailability();
+		availability.setRegion(Constants.ALL_REGIONS);
+		HashSet<ProductPrice> prices = new HashSet<ProductPrice>();
+		prices.add(productPrice);
+		availability.setPrices(prices);
+
+		Product product = new Product();
+		HashSet<ProductAvailability> availabilities = new HashSet<ProductAvailability>();
+		availabilities.add(availability);
+		product.setAvailabilities(availabilities);
+
+		return new ProductPriceUtils().getFinalPrice(product);
+	}
+
+	private Date daysFromNow(int days) {
+		Calendar calendar = Calendar.getInstance();
+		calendar.add(Calendar.DATE, days);
+		return calendar.getTime();
+	}
+}
