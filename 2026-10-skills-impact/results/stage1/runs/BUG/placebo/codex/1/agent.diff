+package com.salesmanager.test.business.utils;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import java.math.BigDecimal;
+import java.util.Calendar;
+import java.util.Date;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.utils.ProductPriceUtils;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+import com.salesmanager.core.model.catalog.product.price.FinalPrice;
+
+public class ProductPriceUtilsTest {
+
+	private final ProductPriceUtils priceUtils = new ProductPriceUtils();
+
+	@Test
+	public void appliesSpecialWithStartAndEndDatesWhenCurrentlyActive() throws Exception {
+		ProductPrice price = priceWithSpecialAmount();
+		price.setProductPriceSpecialStartDate(daysFromNow(-1));
+		price.setProductPriceSpecialEndDate(daysFromNow(1));
+
+		FinalPrice finalPrice = priceUtils.getFinalPrice(availabilityWith(price));
+
+		assertDiscountApplied(finalPrice);
+	}
+
+	@Test
+	public void appliesSpecialWithEndDateOnlyWhenCurrentlyActive() throws Exception {
+		ProductPrice price = priceWithSpecialAmount();
+		price.setProductPriceSpecialEndDate(daysFromNow(1));
+
+		FinalPrice finalPrice = priceUtils.getFinalPrice(availabilityWith(price));
+
+		assertDiscountApplied(finalPrice);
+	}
+
+	@Test
+	public void appliesUndatedSpecial() throws Exception {
+		FinalPrice finalPrice = priceUtils.getFinalPrice(availabilityWith(priceWithSpecialAmount()));
+
+		assertDiscountApplied(finalPrice);
+	}
+
+	private ProductPrice priceWithSpecialAmount() {
+		ProductPrice price = new ProductPrice();
+		price.setDefaultPrice(true);
+		price.setProductPriceAmount(new BigDecimal("20.00"));
+		price.setProductPriceSpecialAmount(new BigDecimal("10.00"));
+		return price;
+	}
+
+	private ProductAvailability availabilityWith(ProductPrice price) {
+		ProductAvailability availability = new ProductAvailability();
+		availability.getPrices().add(price);
+		return availability;
+	}
+
+	private Date daysFromNow(int days) {
+		Calendar date = Calendar.getInstance();
+		date.add(Calendar.DATE, days);
+		return date.getTime();
+	}
+
+	private void assertDiscountApplied(FinalPrice finalPrice) {
+		assertTrue(finalPrice.isDiscounted());
+		assertEquals(new BigDecimal("10.00"), finalPrice.getFinalPrice());
+	}
+}
