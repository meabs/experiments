+package com.salesmanager.test.business.utils;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import java.math.BigDecimal;
+import java.util.Calendar;
+import java.util.Collections;
+import java.util.Date;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.utils.ProductPriceUtils;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.FinalPrice;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+
+public class ProductPriceUtilsTest {
+
+	@Test
+	public void activeDiscountWithStartAndEndDatesUsesSpecialPrice() throws Exception {
+		ProductPrice price = priceWithDates(true);
+
+		FinalPrice finalPrice = calculate(price);
+
+		assertTrue(finalPrice.isDiscounted());
+		assertEquals(new BigDecimal("50"), finalPrice.getFinalPrice());
+	}
+
+	@Test
+	public void activeDiscountWithEndDateOnlyUsesSpecialPrice() throws Exception {
+		ProductPrice price = priceWithDates(false);
+
+		FinalPrice finalPrice = calculate(price);
+
+		assertTrue(finalPrice.isDiscounted());
+		assertEquals(new BigDecimal("50"), finalPrice.getFinalPrice());
+	}
+
+	private FinalPrice calculate(ProductPrice price) throws Exception {
+		ProductAvailability availability = new ProductAvailability();
+		availability.setPrices(Collections.singleton(price));
+		price.setProductAvailability(availability);
+
+		Product product = new Product();
+		product.setAvailabilities(Collections.singleton(availability));
+
+		return new ProductPriceUtils().getFinalPrice(product);
+	}
+
+	private ProductPrice priceWithDates(boolean includeStartDate) {
+		Calendar calendar = Calendar.getInstance();
+		Date today = calendar.getTime();
+		calendar.add(Calendar.DATE, 1);
+		Date tomorrow = calendar.getTime();
+
+		ProductPrice price = new ProductPrice();
+		price.setDefaultPrice(true);
+		price.setProductPriceAmount(new BigDecimal("100"));
+		price.setProductPriceSpecialAmount(new BigDecimal("50"));
+		price.setProductPriceSpecialEndDate(tomorrow);
+		if (includeStartDate) {
+			calendar.setTime(today);
+			calendar.add(Calendar.DATE, -1);
+			price.setProductPriceSpecialStartDate(calendar.getTime());
+		}
+		return price;
+	}
+}
