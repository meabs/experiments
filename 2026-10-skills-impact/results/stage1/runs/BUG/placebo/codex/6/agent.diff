+package com.salesmanager.shop.mapper.catalog.product;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+
+import org.junit.Test;
+
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.PersistableProductPrice;
+import com.salesmanager.shop.model.catalog.product.product.PersistableProductInventory;
+import com.salesmanager.shop.utils.DateUtil;
+
+public class PersistableProductAvailabilityMapperTest {
+
+	private final PersistableProductAvailabilityMapper mapper = new PersistableProductAvailabilityMapper();
+	private final MerchantStore store = new MerchantStore(1, "test", "Test");
+
+	@Test
+	public void mapsDiscountEndDateWithoutStartDate() throws Exception {
+		PersistableProductPrice sourcePrice = new PersistableProductPrice();
+		sourcePrice.setDiscountEndDate("2026-10-31");
+
+		PersistableProductInventory source = new PersistableProductInventory();
+		source.setPrice(sourcePrice);
+
+		ProductAvailability availability = mapper.convert(source, store, null);
+		ProductPrice mappedPrice = availability.getPrices().iterator().next();
+
+		assertNull(mappedPrice.getProductPriceSpecialStartDate());
+		assertEquals(DateUtil.getDate("2026-10-31"), mappedPrice.getProductPriceSpecialEndDate());
+	}
+
+	@Test
+	public void mapsDiscountStartAndEndDatesToTheirOwnFields() throws Exception {
+		PersistableProductPrice sourcePrice = new PersistableProductPrice();
+		sourcePrice.setDiscountStartDate("2026-10-01");
+		sourcePrice.setDiscountEndDate("2026-10-31");
+
+		PersistableProductInventory source = new PersistableProductInventory();
+		source.setPrice(sourcePrice);
+
+		ProductAvailability availability = mapper.convert(source, store, null);
+		ProductPrice mappedPrice = availability.getPrices().iterator().next();
+
+		assertEquals(DateUtil.getDate("2026-10-01"), mappedPrice.getProductPriceSpecialStartDate());
+		assertEquals(DateUtil.getDate("2026-10-31"), mappedPrice.getProductPriceSpecialEndDate());
+	}
+}
