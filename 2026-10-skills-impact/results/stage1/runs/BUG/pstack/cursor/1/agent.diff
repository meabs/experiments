+package com.salesmanager.test.shop.mapper;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+
+import java.math.BigDecimal;
+
+import org.junit.Test;
+
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.mapper.catalog.product.PersistableProductAvailabilityMapper;
+import com.salesmanager.shop.model.catalog.product.PersistableProductPrice;
+import com.salesmanager.shop.model.catalog.product.product.PersistableProductInventory;
+import com.salesmanager.shop.utils.DateUtil;
+
+public class PersistableProductAvailabilityMapperTest {
+
+	private final PersistableProductAvailabilityMapper mapper = new PersistableProductAvailabilityMapper();
+
+	@Test
+	public void endDateAloneIsStoredAsTheSpecialEndDate() throws Exception {
+		ProductPrice price = map(null, "2026-12-31");
+
+		assertNull(price.getProductPriceSpecialStartDate());
+		assertNotNull(price.getProductPriceSpecialEndDate());
+		assertEquals(DateUtil.getDate("2026-12-31"), price.getProductPriceSpecialEndDate());
+	}
+
+	@Test
+	public void startAndEndDatesStayOnTheirOwnFields() throws Exception {
+		ProductPrice price = map("2026-01-01", "2026-12-31");
+
+		assertEquals(DateUtil.getDate("2026-01-01"), price.getProductPriceSpecialStartDate());
+		assertEquals(DateUtil.getDate("2026-12-31"), price.getProductPriceSpecialEndDate());
+	}
+
+	private ProductPrice map(String start, String end) {
+		PersistableProductPrice price = new PersistableProductPrice();
+		price.setDefaultPrice(true);
+		price.setPrice(new BigDecimal("10.00"));
+		price.setDiscountedPrice(new BigDecimal("8.00"));
+		price.setDiscountStartDate(start);
+		price.setDiscountEndDate(end);
+
+		PersistableProductInventory inventory = new PersistableProductInventory();
+		inventory.setQuantity(1);
+		inventory.setPrice(price);
+
+		MerchantStore store = new MerchantStore();
+		Language language = new Language();
+		language.setCode("en");
+		store.getLanguages().add(language);
+
+		ProductAvailability availability = mapper.merge(inventory, new ProductAvailability(), store, language);
+		return availability.getPrices().iterator().next();
+	}
+}
