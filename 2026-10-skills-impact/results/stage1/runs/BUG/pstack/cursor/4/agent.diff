+package com.salesmanager.test.shop.product;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import java.math.BigDecimal;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.utils.ProductPriceUtils;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.FinalPrice;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.mapper.catalog.product.PersistableProductAvailabilityMapper;
+import com.salesmanager.shop.model.catalog.product.PersistableProductPrice;
+import com.salesmanager.shop.model.catalog.product.product.PersistableProductInventory;
+
+public class SpecialPriceDateTest {
+
+	@Test
+	public void endDateAloneIsStoredAndDiscounted() throws Exception {
+		ProductAvailability availability = map("2099-12-31", null);
+		ProductPrice price = availability.getPrices().iterator().next();
+		assertNotNull(price.getProductPriceSpecialEndDate());
+		assertNull(price.getProductPriceSpecialStartDate());
+
+		FinalPrice finalPrice = new ProductPriceUtils().getFinalPrice(availability);
+		assertTrue(finalPrice.isDiscounted());
+		assertEquals(0, new BigDecimal("10.00").compareTo(finalPrice.getFinalPrice()));
+	}
+
+	@Test
+	public void startAndEndDatesAreStoredAndDiscounted() throws Exception {
+		ProductAvailability availability = map("2099-12-31", "2000-01-01");
+		ProductPrice price = availability.getPrices().iterator().next();
+		assertNotNull(price.getProductPriceSpecialEndDate());
+		assertNotNull(price.getProductPriceSpecialStartDate());
+
+		FinalPrice finalPrice = new ProductPriceUtils().getFinalPrice(availability);
+		assertTrue(finalPrice.isDiscounted());
+		assertEquals(0, new BigDecimal("10.00").compareTo(finalPrice.getFinalPrice()));
+	}
+
+	@Test
+	public void undatedSpecialStaysDiscounted() throws Exception {
+		ProductAvailability availability = map(null, null);
+		FinalPrice finalPrice = new ProductPriceUtils().getFinalPrice(availability);
+		assertTrue(finalPrice.isDiscounted());
+		assertEquals(0, new BigDecimal("10.00").compareTo(finalPrice.getFinalPrice()));
+	}
+
+	private ProductAvailability map(String endDate, String startDate) {
+		Language language = new Language();
+		language.setCode("en");
+		MerchantStore store = new MerchantStore();
+		store.getLanguages().add(language);
+
+		PersistableProductPrice price = new PersistableProductPrice();
+		price.setPrice(new BigDecimal("20.00"));
+		price.setDiscountedPrice(new BigDecimal("10.00"));
+		price.setDefaultPrice(true);
+		price.setDiscountStartDate(startDate);
+		price.setDiscountEndDate(endDate);
+
+		PersistableProductInventory inventory = new PersistableProductInventory();
+		inventory.setQuantity(1);
+		inventory.setPrice(price);
+
+		return new PersistableProductAvailabilityMapper().merge(inventory, new ProductAvailability(), store, language);
+	}
+}
