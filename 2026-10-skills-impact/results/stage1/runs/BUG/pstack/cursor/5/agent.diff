+package com.salesmanager.test.shop.product;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.assertTrue;
+
+import java.math.BigDecimal;
+import java.util.Collections;
+import java.util.Date;
+import java.util.HashSet;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.constants.Constants;
+import com.salesmanager.core.business.utils.ProductPriceUtils;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.FinalPrice;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.mapper.catalog.product.PersistableProductAvailabilityMapper;
+import com.salesmanager.shop.model.catalog.product.PersistableProductPrice;
+import com.salesmanager.shop.model.catalog.product.product.PersistableProductInventory;
+
+public class DatedSpecialPriceTest {
+
+	private static final BigDecimal LIST = new BigDecimal("20.00");
+	private static final BigDecimal SPECIAL = new BigDecimal("15.00");
+
+	@Test
+	public void endDateOnlySpecialIsShown() throws Exception {
+		ProductAvailability availability = map("2099-12-31", null);
+		ProductPrice stored = availability.getPrices().iterator().next();
+		assertNotNull(stored.getProductPriceSpecialEndDate());
+		assertNull(stored.getProductPriceSpecialStartDate());
+		assertSpecial(new ProductPriceUtils().getFinalPrice(availability));
+	}
+
+	@Test
+	public void startAndEndDateSpecialIsShown() throws Exception {
+		ProductAvailability availability = map("2099-12-31", "2000-01-01");
+		ProductPrice stored = availability.getPrices().iterator().next();
+		assertNotNull(stored.getProductPriceSpecialEndDate());
+		assertNotNull(stored.getProductPriceSpecialStartDate());
+		assertSpecial(new ProductPriceUtils().getFinalPrice(availability));
+	}
+
+	@Test
+	public void activeWindowOnStoredPriceIsShown() throws Exception {
+		ProductPrice price = new ProductPrice();
+		price.setDefaultPrice(true);
+		price.setProductPriceAmount(LIST);
+		price.setProductPriceSpecialAmount(SPECIAL);
+		price.setProductPriceSpecialStartDate(new Date(0L));
+		price.setProductPriceSpecialEndDate(new Date(4102444800000L));
+		ProductAvailability availability = new ProductAvailability();
+		availability.setRegion(Constants.ALL_REGIONS);
+		availability.setPrices(new HashSet<ProductPrice>());
+		availability.getPrices().add(price);
+		assertSpecial(new ProductPriceUtils().getFinalPrice(availability));
+	}
+
+	private static ProductAvailability map(String end, String start) {
+		PersistableProductPrice price = new PersistableProductPrice();
+		price.setDefaultPrice(true);
+		price.setPrice(LIST);
+		price.setDiscountedPrice(SPECIAL);
+		price.setDiscountEndDate(end);
+		price.setDiscountStartDate(start);
+		PersistableProductInventory inventory = new PersistableProductInventory();
+		inventory.setQuantity(3);
+		inventory.setPrice(price);
+		MerchantStore store = new MerchantStore();
+		store.setLanguages(Collections.emptyList());
+		return new PersistableProductAvailabilityMapper().merge(inventory, new ProductAvailability(), store, null);
+	}
+
+	private static void assertSpecial(FinalPrice finalPrice) {
+		assertTrue(finalPrice.isDiscounted());
+		assertEquals(0, SPECIAL.compareTo(finalPrice.getFinalPrice()));
+	}
+}
