+package com.salesmanager.test.shop.product;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.mapper.catalog.product.PersistableProductAvailabilityMapper;
+import com.salesmanager.shop.model.catalog.product.PersistableProductPrice;
+import com.salesmanager.shop.model.catalog.product.product.PersistableProductInventory;
+
+public class PersistableProductAvailabilityMapperTest {
+
+	@Test
+	public void endDateIsStoredOnTheEndField() throws Exception {
+		ProductPrice price = map("2020-01-01", "2099-01-01");
+		Assert.assertNotNull(price.getProductPriceSpecialStartDate());
+		Assert.assertNotNull(price.getProductPriceSpecialEndDate());
+		Assert.assertTrue(price.getProductPriceSpecialEndDate().after(price.getProductPriceSpecialStartDate()));
+	}
+
+	@Test
+	public void endDateAloneDoesNotBecomeTheStartDate() throws Exception {
+		ProductPrice price = map(null, "2099-01-01");
+		Assert.assertNull(price.getProductPriceSpecialStartDate());
+		Assert.assertNotNull(price.getProductPriceSpecialEndDate());
+	}
+
+	private static ProductPrice map(String start, String end) {
+		PersistableProductPrice sourcePrice = new PersistableProductPrice();
+		sourcePrice.setPrice(new BigDecimal("40.00"));
+		sourcePrice.setDiscountedPrice(new BigDecimal("15.00"));
+		sourcePrice.setDefaultPrice(true);
+		sourcePrice.setDiscountStartDate(start);
+		sourcePrice.setDiscountEndDate(end);
+
+		PersistableProductInventory inventory = new PersistableProductInventory();
+		inventory.setQuantity(3);
+		inventory.setPrice(sourcePrice);
+
+		Language language = new Language();
+		language.setCode("en");
+		MerchantStore store = new MerchantStore();
+		store.setLanguages(new ArrayList<Language>());
+		store.getLanguages().add(language);
+
+		ProductAvailability availability = new PersistableProductAvailabilityMapper().convert(inventory, store, language);
+		Assert.assertEquals(1, availability.getPrices().size());
+		return availability.getPrices().iterator().next();
+	}
+}
