+package com.salesmanager.test.catalog;
+
+import java.math.BigDecimal;
+import java.util.Calendar;
+import java.util.Date;
+import java.util.HashSet;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+import com.salesmanager.core.business.constants.Constants;
+import com.salesmanager.core.business.utils.ProductPriceUtils;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.FinalPrice;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+
+public class ProductPriceDiscountWindowTest {
+
+	@Test
+	public void specialWithStartAndEndDateIsTheFinalPrice() throws Exception {
+		FinalPrice price = price(daysFromToday(-2), daysFromToday(30), new BigDecimal("15.00"));
+		Assert.assertTrue(price.isDiscounted());
+		Assert.assertEquals(0, new BigDecimal("15.00").compareTo(price.getFinalPrice()));
+	}
+
+	@Test
+	public void specialWithOnlyEndDateIsTheFinalPrice() throws Exception {
+		FinalPrice price = price(null, daysFromToday(30), new BigDecimal("15.00"));
+		Assert.assertTrue(price.isDiscounted());
+		Assert.assertEquals(0, new BigDecimal("15.00").compareTo(price.getFinalPrice()));
+	}
+
+	@Test
+	public void specialWithNoDatesIsTheFinalPrice() throws Exception {
+		FinalPrice price = price(null, null, new BigDecimal("15.00"));
+		Assert.assertTrue(price.isDiscounted());
+		Assert.assertEquals(0, new BigDecimal("15.00").compareTo(price.getFinalPrice()));
+	}
+
+	private static FinalPrice price(Date start, Date end, BigDecimal special) throws Exception {
+		ProductPrice productPrice = new ProductPrice();
+		productPrice.setDefaultPrice(true);
+		productPrice.setProductPriceAmount(new BigDecimal("40.00"));
+		productPrice.setProductPriceSpecialAmount(special);
+		productPrice.setProductPriceSpecialStartDate(start);
+		productPrice.setProductPriceSpecialEndDate(end);
+
+		ProductAvailability availability = new ProductAvailability();
+		availability.setRegion(Constants.ALL_REGIONS);
+		availability.setPrices(new HashSet<ProductPrice>());
+		availability.getPrices().add(productPrice);
+
+		return new ProductPriceUtils().getFinalPrice(availability);
+	}
+
+	private static Date daysFromToday(int days) {
+		Calendar calendar = Calendar.getInstance();
+		calendar.add(Calendar.DATE, days);
+		return calendar.getTime();
+	}
+}
