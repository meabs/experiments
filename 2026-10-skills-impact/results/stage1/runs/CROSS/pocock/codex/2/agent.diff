@@ -0,0 +1,91 @@
+package com.salesmanager.test.shop.integration.manufacturer;
+
+import static org.hamcrest.core.Is.is;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertThat;
+import static org.springframework.http.HttpStatus.BAD_REQUEST;
+import static org.springframework.http.HttpStatus.CREATED;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.boot.test.web.client.TestRestTemplate;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.catalog.manufacturer.PersistableManufacturer;
+import com.salesmanager.shop.model.catalog.manufacturer.ReadableManufacturer;
+import com.salesmanager.shop.model.catalog.manufacturer.ReadableManufacturerList;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class ManufacturerWebsiteIntegrationTest extends ServicesTestSupport {
+
+    @Autowired
+    private TestRestTemplate testRestTemplate;
+
+    @Test
+    public void websiteIsStoredAndReturned() {
+        PersistableManufacturer manufacturer = manufacturer("WEBSITE_BRAND");
+        manufacturer.setWebsite("https://example.com/manufacturer");
+
+        ResponseEntity<PersistableManufacturer> createResponse = testRestTemplate.postForEntity(
+                "/api/v1/private/manufacturer", new HttpEntity<>(manufacturer, getHeader()),
+                PersistableManufacturer.class);
+
+        assertThat(createResponse.getStatusCode(), is(CREATED));
+        assertNotNull(createResponse.getBody());
+        assertThat(createResponse.getBody().getWebsite(), is(manufacturer.getWebsite()));
+
+        ResponseEntity<ReadableManufacturer> detailResponse = testRestTemplate.exchange(
+                "/api/v1/manufacturer/" + createResponse.getBody().getId(), HttpMethod.GET,
+                new HttpEntity<>(getHeader()), ReadableManufacturer.class);
+
+        assertThat(detailResponse.getBody().getWebsite(), is(manufacturer.getWebsite()));
+
+        ResponseEntity<ReadableManufacturerList> listResponse = testRestTemplate.exchange(
+                "/api/v1/private/manufacturers?name=WEBSITE_BRAND&page=0&count=10", HttpMethod.GET,
+                new HttpEntity<>(getHeader()), ReadableManufacturerList.class);
+
+        assertThat(listResponse.getBody().getManufacturers().stream()
+                .anyMatch(item -> manufacturer.getWebsite().equals(item.getWebsite())), is(true));
+
+        manufacturer.setWebsite("http://updated.example.com/manufacturer");
+        ResponseEntity<Void> updateResponse = testRestTemplate.exchange(
+                "/api/v1/private/manufacturer/" + createResponse.getBody().getId(), HttpMethod.PUT,
+                new HttpEntity<>(manufacturer, getHeader()), Void.class);
+
+        assertThat(updateResponse.getStatusCode().is2xxSuccessful(), is(true));
+
+        detailResponse = testRestTemplate.exchange(
+                "/api/v1/manufacturer/" + createResponse.getBody().getId(), HttpMethod.GET,
+                new HttpEntity<>(getHeader()), ReadableManufacturer.class);
+
+        assertThat(detailResponse.getBody().getWebsite(), is(manufacturer.getWebsite()));
+    }
+
+    @Test
+    public void websiteWithoutHttpSchemeIsRejectedBeforeStorage() {
+        PersistableManufacturer manufacturer = manufacturer("INVALID_WEBSITE_BRAND");
+        manufacturer.setWebsite("www.example.com");
+
+        ResponseEntity<String> response = testRestTemplate.postForEntity(
+                "/api/v1/private/manufacturer", new HttpEntity<>(manufacturer, getHeader()), String.class);
+
+        assertThat(response.getStatusCode(), is(BAD_REQUEST));
+
+        ResponseEntity<ReadableManufacturerList> listResponse = testRestTemplate.exchange(
+                "/api/v1/private/manufacturers?name=INVALID_WEBSITE_BRAND&page=0&count=10", HttpMethod.GET,
+                new HttpEntity<>(getHeader()), ReadableManufacturerList.class);
+
+        assertFalse(listResponse.getBody().getManufacturers().stream()
+                .anyMatch(item -> "INVALID_WEBSITE_BRAND".equals(item.getCode())));
+    }
+}
