+    @Test
+    public void storesAndReturnsManufacturerWebsiteAndRejectsInvalidUpdate() throws Exception {
+        PersistableManufacturer manufacturer = super.manufacturer("WEBSITE_MANUFACTURER");
+        manufacturer.setWebsite("https://example.com/manufacturer");
+
+        ResponseEntity<PersistableManufacturer> createResponse = testRestTemplate.postForEntity(
+                "/api/v1/private/manufacturer",
+                new HttpEntity<>(manufacturer, getHeader()),
+                PersistableManufacturer.class);
+
+        assertThat(createResponse.getStatusCode(), is(HttpStatus.CREATED));
+        PersistableManufacturer created = createResponse.getBody();
+        assertThat(created.getWebsite(), is("https://example.com/manufacturer"));
+
+        ResponseEntity<ReadableManufacturer> detailResponse = testRestTemplate.exchange(
+                "/api/v1/manufacturer/" + created.getId(),
+                HttpMethod.GET,
+                new HttpEntity<>(getHeader()),
+                ReadableManufacturer.class);
+        assertThat(detailResponse.getBody().getWebsite(), is("https://example.com/manufacturer"));
+
+        ResponseEntity<ReadableManufacturerList> listResponse = testRestTemplate.exchange(
+                "/api/v1/private/manufacturers?name=WEBSITE_MANUFACTURER",
+                HttpMethod.GET,
+                new HttpEntity<>(getHeader()),
+                ReadableManufacturerList.class);
+        assertThat(listResponse.getBody().getManufacturers().get(0).getWebsite(),
+                is("https://example.com/manufacturer"));
+
+        manufacturer.setWebsite("www.example.com");
+        ResponseEntity<Void> updateResponse = testRestTemplate.exchange(
+                "/api/v1/private/manufacturer/" + created.getId(),
+                HttpMethod.PUT,
+                new HttpEntity<>(manufacturer, getHeader()),
+                Void.class);
+        assertThat(updateResponse.getStatusCode(), is(HttpStatus.BAD_REQUEST));
+
+        detailResponse = testRestTemplate.exchange(
+                "/api/v1/manufacturer/" + created.getId(),
+                HttpMethod.GET,
+                new HttpEntity<>(getHeader()),
+                ReadableManufacturer.class);
+        assertThat(detailResponse.getBody().getWebsite(), is("https://example.com/manufacturer"));
+    }
