@@ -0,0 +1,34 @@
+package com.salesmanager.shop.store.api.v1.product;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.salesmanager.shop.model.catalog.manufacturer.ReadableManufacturer;
+
+public class ProductManufacturerApiTest {
+
+	@Test
+	public void websiteIsOptionalOrHttp() {
+		assertTrue(ProductManufacturerApi.acceptableWebsite(null));
+		assertTrue(ProductManufacturerApi.acceptableWebsite(""));
+		assertTrue(ProductManufacturerApi.acceptableWebsite("http://example.com"));
+		assertTrue(ProductManufacturerApi.acceptableWebsite("https://example.com/path"));
+		assertFalse(ProductManufacturerApi.acceptableWebsite("ftp://example.com"));
+		assertFalse(ProductManufacturerApi.acceptableWebsite("example.com"));
+		assertFalse(ProductManufacturerApi.acceptableWebsite("HTTP://example.com"));
+	}
+
+	@Test
+	public void readableManufacturerJsonUsesWebsite() throws Exception {
+		ReadableManufacturer manufacturer = new ReadableManufacturer();
+		manufacturer.setWebsite("https://example.com");
+		String json = new ObjectMapper().writeValueAsString(manufacturer);
+		assertTrue(json.contains("\"website\":\"https://example.com\""));
+		assertEquals("https://example.com",
+				new ObjectMapper().readTree(json).get("website").asText());
+	}
+}
