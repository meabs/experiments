diff --git a/sm-shop/src/test/java/com/salesmanager/test/shop/integration/manufacturer/ManufacturerWebsiteAPIIntegrationTest.java b/sm-shop/src/test/java/com/salesmanager/test/shop/integration/manufacturer/ManufacturerWebsiteAPIIntegrationTest.java
