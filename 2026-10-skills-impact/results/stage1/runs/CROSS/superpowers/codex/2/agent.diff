@@ -0,0 +1,78 @@
+package com.salesmanager.test.shop.integration.manufacturer;
+
+import static org.hamcrest.core.Is.is;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertThat;
+import static org.springframework.http.HttpStatus.BAD_REQUEST;
+import static org.springframework.http.HttpStatus.CREATED;
+import static org.springframework.http.HttpStatus.OK;
+
+import java.util.UUID;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.catalog.manufacturer.PersistableManufacturer;
+import com.salesmanager.shop.model.catalog.manufacturer.ReadableManufacturer;
+import com.salesmanager.shop.model.catalog.manufacturer.ReadableManufacturerList;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class ManufacturerWebsiteApiIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void createsAndUpdatesManufacturerWebsite() {
+        String code = "website-" + UUID.randomUUID().toString().replace("-", "");
+        PersistableManufacturer manufacturer = manufacturer(code);
+        manufacturer.setWebsite("https://manufacturer.example");
+        HttpEntity<PersistableManufacturer> createRequest = new HttpEntity<>(manufacturer, getHeader());
+
+        ResponseEntity<PersistableManufacturer> created = testRestTemplate.postForEntity(
+                "/api/v1/private/manufacturer", createRequest, PersistableManufacturer.class);
+
+        assertThat(created.getStatusCode(), is(CREATED));
+        assertNotNull(created.getBody().getId());
+        assertThat(created.getBody().getWebsite(), is("https://manufacturer.example"));
+
+        manufacturer.setWebsite("http://updated.example");
+        ResponseEntity<Void> updated = testRestTemplate.exchange(
+                "/api/v1/private/manufacturer/" + created.getBody().getId(), HttpMethod.PUT,
+                new HttpEntity<>(manufacturer, getHeader()), Void.class);
+
+        assertThat(updated.getStatusCode(), is(OK));
+
+        ResponseEntity<ReadableManufacturer> detail = testRestTemplate.exchange(
+                "/api/v1/manufacturer/" + created.getBody().getId(), HttpMethod.GET,
+                new HttpEntity<>(getHeader()), ReadableManufacturer.class);
+
+        assertThat(detail.getStatusCode(), is(OK));
+        assertThat(detail.getBody().getWebsite(), is("http://updated.example"));
+    }
+
+    @Test
+    public void rejectsInvalidWebsiteWithoutStoringManufacturer() {
+        String code = "invalid-website-" + UUID.randomUUID().toString().replace("-", "");
+        PersistableManufacturer manufacturer = manufacturer(code);
+        manufacturer.setWebsite("manufacturer.example");
+
+        ResponseEntity<String> response = testRestTemplate.postForEntity(
+                "/api/v1/private/manufacturer", new HttpEntity<>(manufacturer, getHeader()), String.class);
+
+        assertThat(response.getStatusCode(), is(BAD_REQUEST));
+
+        ResponseEntity<ReadableManufacturerList> list = testRestTemplate.exchange(
+                "/api/v1/private/manufacturers", HttpMethod.GET, new HttpEntity<>(getHeader()),
+                ReadableManufacturerList.class);
+
+        assertThat(list.getStatusCode(), is(OK));
+        assertThat(list.getBody().getManufacturers().stream().noneMatch(item -> code.equals(item.getCode())), is(true));
+    }
+}
