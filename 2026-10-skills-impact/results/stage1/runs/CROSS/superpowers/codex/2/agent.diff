+package com.salesmanager.test.shop.manufacturer;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+import org.mockito.Mockito;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.salesmanager.core.model.catalog.product.manufacturer.Manufacturer;
+import com.salesmanager.shop.model.catalog.manufacturer.PersistableManufacturer;
+import com.salesmanager.shop.model.catalog.manufacturer.ReadableManufacturer;
+import com.salesmanager.shop.mapper.catalog.ReadableManufacturerMapper;
+import com.salesmanager.shop.populator.manufacturer.PersistableManufacturerPopulator;
+import com.salesmanager.shop.populator.manufacturer.ReadableManufacturerPopulator;
+import com.salesmanager.core.business.services.reference.language.LanguageService;
+
+public class ManufacturerWebsiteContractTest {
+
+    @Test
+    public void manufacturerJsonIncludesWebsite() throws Exception {
+        JsonNode json = new ObjectMapper().valueToTree(new ReadableManufacturer());
+
+        assertTrue(json.has("website"));
+    }
+
+    @Test
+    public void validWebsiteIsCopiedToThePersistentManufacturer() throws Exception {
+        PersistableManufacturer source = new PersistableManufacturer();
+        source.setWebsite("https://manufacturer.example");
+        Manufacturer target = new Manufacturer();
+
+        PersistableManufacturerPopulator populator = new PersistableManufacturerPopulator();
+        populator.setLanguageService(Mockito.mock(LanguageService.class));
+        populator.populate(source, target, null, null);
+
+        assertEquals("https://manufacturer.example", target.getWebsite());
+    }
+
+    @Test
+    public void websiteIsCopiedToReadableManufacturerResponses() throws Exception {
+        Manufacturer source = new Manufacturer();
+        source.setWebsite("http://manufacturer.example");
+        ReadableManufacturer target = new ReadableManufacturer();
+
+        target = new ReadableManufacturerPopulator().populate(source, target, null, null);
+
+        assertEquals("http://manufacturer.example", target.getWebsite());
+    }
+
+    @Test
+    public void websiteIsCopiedToMappedManufacturerResponses() {
+        Manufacturer source = new Manufacturer();
+        source.setWebsite("https://manufacturer.example");
+
+        ReadableManufacturer target = new ReadableManufacturerMapper().convert(source, null, new com.salesmanager.core.model.reference.language.Language("en"));
+
+        assertEquals("https://manufacturer.example", target.getWebsite());
+    }
+
+}
