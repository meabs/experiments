diff --git a/sm-shop/src/test/java/com/salesmanager/test/shop/integration/manufacturer/ManufacturerWebsiteIntegrationTest.java b/sm-shop/src/test/java/com/salesmanager/test/shop/integration/manufacturer/ManufacturerWebsiteIntegrationTest.java
new file mode 100644
index 0000000..ed667da
--- /dev/null
+++ b/sm-shop/src/test/java/com/salesmanager/test/shop/integration/manufacturer/ManufacturerWebsiteIntegrationTest.java
@@ -0,0 +1,117 @@
+package com.salesmanager.test.shop.integration.manufacturer;
+
+import static org.hamcrest.CoreMatchers.containsString;
+import static org.hamcrest.CoreMatchers.not;
+import static org.hamcrest.MatcherAssert.assertThat;
+import static org.hamcrest.core.Is.is;
+import static org.springframework.http.HttpStatus.BAD_REQUEST;
+import static org.springframework.http.HttpStatus.CREATED;
+import static org.springframework.http.HttpStatus.OK;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class ManufacturerWebsiteIntegrationTest extends ServicesTestSupport {
+
+    @Test
+    public void createsAndReturnsManufacturerWebsite() throws Exception {
+        String code = "website-manufacturer-create";
+        String website = "https://manufacturer.example.com";
+        HttpEntity<String> request = new HttpEntity<>(manufacturerJson(code, website), getHeader());
+
+        ResponseEntity<String> response = testRestTemplate.postForEntity(
+                "/api/v1/private/manufacturer?store=DEFAULT&lang=en", request, String.class);
+
+        assertThat(response.getStatusCode(), is(CREATED));
+        assertThat(response.getBody(), containsString("\"website\":\"" + website + "\""));
+
+        String id = new ObjectMapper().readTree(response.getBody()).get("id").asText();
+        HttpEntity<String> authenticatedRequest = new HttpEntity<>(getHeader());
+        assertThat(testRestTemplate.exchange("/api/v1/manufacturer/" + id + "?store=DEFAULT&lang=en",
+                HttpMethod.GET, authenticatedRequest, String.class).getBody(),
+                containsString("\"website\":\"" + website + "\""));
+        assertThat(testRestTemplate.exchange("/api/v1/private/manufacturers?store=DEFAULT&lang=en&name=" + code,
+                HttpMethod.GET, authenticatedRequest, String.class).getBody(),
+                containsString("\"website\":\"" + website + "\""));
+        assertThat(testRestTemplate.exchange("/api/v1/manufacturers?store=DEFAULT&lang=en&name=" + code,
+                HttpMethod.GET, authenticatedRequest, String.class).getBody(),
+                containsString("\"website\":\"" + website + "\""));
+    }
+
+    @Test
+    public void updatesManufacturerWebsite() throws Exception {
+        String code = "website-manufacturer-update";
+        String originalWebsite = "http://manufacturer.example.com";
+        String updatedWebsite = "https://updated-manufacturer.example.com";
+        HttpHeaders headers = getHeader();
+        ResponseEntity<String> created = testRestTemplate.postForEntity(
+                "/api/v1/private/manufacturer?store=DEFAULT&lang=en",
+                new HttpEntity<>(manufacturerJson(code, originalWebsite), headers), String.class);
+        String id = new ObjectMapper().readTree(created.getBody()).get("id").asText();
+
+        ResponseEntity<String> update = testRestTemplate.exchange("/api/v1/private/manufacturer/" + id
+                + "?store=DEFAULT&lang=en", HttpMethod.PUT,
+                new HttpEntity<>(manufacturerJson(code, updatedWebsite), headers), String.class);
+
+        assertThat(update.getStatusCode(), is(OK));
+        String detail = testRestTemplate.exchange("/api/v1/manufacturer/" + id + "?store=DEFAULT&lang=en",
+                HttpMethod.GET, new HttpEntity<>(headers), String.class).getBody();
+        assertThat(detail, containsString("\"website\":\"" + updatedWebsite + "\""));
+    }
+
+    @Test
+    public void rejectsInvalidManufacturerWebsiteWithoutCreatingManufacturer() throws Exception {
+        String code = "invalid-create-no-store";
+        HttpHeaders headers = getHeader();
+        HttpEntity<String> request = new HttpEntity<>(manufacturerJson(code, "www.manufacturer.example.com"), headers);
+
+        ResponseEntity<String> response = testRestTemplate.postForEntity(
+                "/api/v1/private/manufacturer?store=DEFAULT&lang=en", request, String.class);
+
+        assertThat(response.getStatusCode(), is(BAD_REQUEST));
+
+        ResponseEntity<String> manufacturers = testRestTemplate.exchange(
+                "/api/v1/private/manufacturers?store=DEFAULT&lang=en&name=" + code,
+                org.springframework.http.HttpMethod.GET, new HttpEntity<>(headers), String.class);
+        assertThat(manufacturers.getBody(), not(containsString(code)));
+    }
+
+    @Test
+    public void rejectsInvalidManufacturerWebsiteWithoutUpdatingManufacturer() throws Exception {
+        String code = "website-manufacturer-invalid-update";
+        String originalWebsite = "https://manufacturer.example.com";
+        HttpHeaders headers = getHeader();
+        ResponseEntity<String> created = testRestTemplate.postForEntity(
+                "/api/v1/private/manufacturer?store=DEFAULT&lang=en",
+                new HttpEntity<>(manufacturerJson(code, originalWebsite), headers), String.class);
+        String id = new ObjectMapper().readTree(created.getBody()).get("id").asText();
+
+        ResponseEntity<String> response = testRestTemplate.exchange("/api/v1/private/manufacturer/" + id
+                + "?store=DEFAULT&lang=en", HttpMethod.PUT,
+                new HttpEntity<>(manufacturerJson(code, "manufacturer.example.com"), headers), String.class);
+
+        assertThat(response.getStatusCode(), is(BAD_REQUEST));
+        String detail = testRestTemplate.exchange("/api/v1/manufacturer/" + id + "?store=DEFAULT&lang=en",
+                HttpMethod.GET, new HttpEntity<>(headers), String.class).getBody();
+        assertThat(detail, containsString("\"website\":\"" + originalWebsite + "\""));
+    }
+
+    private String manufacturerJson(String code, String website) {
+        return "{\"code\":\"" + code
+                + "\",\"website\":\"" + website
+                + "\",\"descriptions\":[{\"language\":\"en\",\"name\":\"" + code + "\"}]}";
+    }
+}
