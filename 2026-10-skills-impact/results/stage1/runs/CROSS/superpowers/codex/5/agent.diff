+package com.salesmanager.test.shop.integration.manufacturer;
+
+import static org.hamcrest.CoreMatchers.is;
+import static org.junit.Assert.assertThat;
+import static org.mockito.Mockito.mock;
+
+import org.junit.Test;
+
+import com.salesmanager.core.model.catalog.product.manufacturer.Manufacturer;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.mapper.catalog.ReadableManufacturerMapper;
+import com.salesmanager.shop.model.catalog.manufacturer.PersistableManufacturer;
+import com.salesmanager.shop.model.catalog.manufacturer.ReadableManufacturer;
+import com.salesmanager.shop.populator.manufacturer.PersistableManufacturerPopulator;
+import com.salesmanager.shop.populator.manufacturer.ReadableManufacturerPopulator;
+
+public class ManufacturerWebsiteMappingTest {
+
+    private static final String WEBSITE = "https://acme.example";
+
+    @Test
+    public void persistableManufacturerCopiesWebsiteToEntity() throws Exception {
+        PersistableManufacturer source = new PersistableManufacturer();
+        source.setWebsite(WEBSITE);
+        Manufacturer target = new Manufacturer();
+
+        PersistableManufacturerPopulator populator = new PersistableManufacturerPopulator();
+        populator.setLanguageService(mock(com.salesmanager.core.business.services.reference.language.LanguageService.class));
+        populator.populate(source, target, null, null);
+
+        assertThat(target.getWebsite(), is(WEBSITE));
+    }
+
+    @Test
+    public void readableManufacturerPopulatorCopiesWebsite() throws Exception {
+        Manufacturer source = new Manufacturer();
+        source.setWebsite(WEBSITE);
+
+        ReadableManufacturer target = new ReadableManufacturer();
+        ReadableManufacturer result = new ReadableManufacturerPopulator().populate(source, target, null, null);
+
+        assertThat(result.getWebsite(), is(WEBSITE));
+    }
+
+    @Test
+    public void readableManufacturerMapperCopiesWebsite() {
+        Manufacturer source = new Manufacturer();
+        source.setWebsite(WEBSITE);
+        Language language = new Language();
+        language.setCode("en");
+
+        ReadableManufacturer result = new ReadableManufacturerMapper().convert(source, null, language);
+
+        assertThat(result.getWebsite(), is(WEBSITE));
+    }
+}
