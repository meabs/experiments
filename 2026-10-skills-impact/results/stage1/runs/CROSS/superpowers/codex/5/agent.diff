@@ -0,0 +1,71 @@
+package com.salesmanager.test.shop.integration.manufacturer;
+
+import static org.mockito.Mockito.doNothing;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verifyNoInteractions;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.put;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.jsonPath;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.springframework.validation.beanvalidation.LocalValidatorFactoryBean;
+import org.springframework.test.util.ReflectionTestUtils;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.setup.MockMvcBuilders;
+
+import com.salesmanager.shop.store.api.v1.product.ProductManufacturerApi;
+import com.salesmanager.shop.store.controller.manufacturer.facade.ManufacturerFacade;
+
+public class ManufacturerWebsiteApiTest {
+
+    private static final String VALID_MANUFACTURER = "{\"code\":\"acme\",\"website\":\"https://acme.example\"}";
+    private static final String INVALID_MANUFACTURER = "{\"code\":\"acme\",\"website\":\"ftp://acme.example\"}";
+
+    private MockMvc mockMvc;
+    private ManufacturerFacade manufacturerFacade;
+
+    @Before
+    public void setUp() throws Exception {
+        manufacturerFacade = mock(ManufacturerFacade.class);
+        ProductManufacturerApi api = new ProductManufacturerApi();
+        ReflectionTestUtils.setField(api, "manufacturerFacade", manufacturerFacade);
+        doNothing().when(manufacturerFacade).saveOrUpdateManufacturer(
+                org.mockito.ArgumentMatchers.any(), org.mockito.ArgumentMatchers.any(),
+                org.mockito.ArgumentMatchers.any());
+
+        LocalValidatorFactoryBean validator = new LocalValidatorFactoryBean();
+        validator.afterPropertiesSet();
+        mockMvc = MockMvcBuilders.standaloneSetup(api).setValidator(validator).build();
+    }
+
+    @Test
+    public void createReturnsWebsiteInTheJsonResponse() throws Exception {
+        mockMvc.perform(post("/api/v1/private/manufacturer")
+                .contentType("application/json")
+                .content(VALID_MANUFACTURER))
+                .andExpect(status().isCreated())
+                .andExpect(jsonPath("$.website").value("https://acme.example"));
+    }
+
+    @Test
+    public void createRejectsWebsiteWithoutHttpScheme() throws Exception {
+        mockMvc.perform(post("/api/v1/private/manufacturer")
+                .contentType("application/json")
+                .content(INVALID_MANUFACTURER))
+                .andExpect(status().isBadRequest());
+
+        verifyNoInteractions(manufacturerFacade);
+    }
+
+    @Test
+    public void updateRejectsWebsiteWithoutHttpScheme() throws Exception {
+        mockMvc.perform(put("/api/v1/private/manufacturer/1")
+                .contentType("application/json")
+                .content(INVALID_MANUFACTURER))
+                .andExpect(status().isBadRequest());
+
+        verifyNoInteractions(manufacturerFacade);
+    }
+}
