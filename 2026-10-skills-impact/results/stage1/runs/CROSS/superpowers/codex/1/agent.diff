+package com.salesmanager.test.shop.integration.manufacturer;
+
+import static org.hamcrest.CoreMatchers.equalTo;
+import static org.hamcrest.CoreMatchers.is;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertThat;
+
+import java.lang.reflect.Field;
+
+import javax.persistence.Column;
+
+import org.junit.Test;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.salesmanager.core.model.catalog.product.manufacturer.Manufacturer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.mapper.catalog.ReadableManufacturerMapper;
+import com.salesmanager.shop.model.catalog.manufacturer.PersistableManufacturer;
+import com.salesmanager.shop.model.catalog.manufacturer.ReadableManufacturer;
+import com.salesmanager.shop.populator.manufacturer.ReadableManufacturerPopulator;
+
+public class ManufacturerWebsiteTest {
+
+    private static final String WEBSITE = "https://manufacturer.example.com";
+
+    private final ObjectMapper objectMapper = new ObjectMapper();
+
+    @Test
+    public void manufacturerWebsiteIsStoredInItsOwnDatabaseColumn() {
+        Field website = null;
+        try {
+            website = Manufacturer.class.getDeclaredField("website");
+        } catch (NoSuchFieldException ignored) {
+            // The assertion below reports the missing persistence property.
+        }
+
+        assertNotNull("Manufacturer must have a website persistence property", website);
+        assertThat(website.getAnnotation(Column.class).name(), is("MANUFACTURER_WEBSITE"));
+    }
+
+    @Test
+    public void persistableManufacturerRoundTripsWebsiteAsJson() throws Exception {
+        PersistableManufacturer manufacturer = objectMapper.readValue(
+                "{\"code\":\"ACME\",\"website\":\"" + WEBSITE + "\"}",
+                PersistableManufacturer.class);
+
+        JsonNode json = objectMapper.valueToTree(manufacturer);
+
+        assertThat(json.get("website").asText(), equalTo(WEBSITE));
+    }
+
+    @Test
+    public void readableManufacturerPopulatorReturnsWebsite() throws Exception {
+        Manufacturer manufacturer = new Manufacturer();
+        Field website = Manufacturer.class.getDeclaredField("website");
+        website.setAccessible(true);
+        website.set(manufacturer, WEBSITE);
+
+        ReadableManufacturer readable = new ReadableManufacturerPopulator()
+                .populate(manufacturer, new ReadableManufacturer(), null, null);
+
+        JsonNode json = objectMapper.valueToTree(readable);
+
+        assertThat(json.get("website").asText(), equalTo(WEBSITE));
+    }
+
+    @Test
+    public void readableManufacturerMapperReturnsWebsiteForProducts() {
+        Manufacturer manufacturer = new Manufacturer();
+        manufacturer.setWebsite(WEBSITE);
+
+        ReadableManufacturer readable = new ReadableManufacturerMapper()
+                .convert(manufacturer, new MerchantStore(), new Language("en"));
+
+        JsonNode json = objectMapper.valueToTree(readable);
+
+        assertThat(json.get("website").asText(), equalTo(WEBSITE));
+    }
+}
