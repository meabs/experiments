@@ -0,0 +1,109 @@
+package com.salesmanager.test.shop.integration.manufacturer;
+
+import static org.hamcrest.CoreMatchers.containsString;
+import static org.hamcrest.CoreMatchers.is;
+import static org.junit.Assert.assertThat;
+import static org.springframework.http.HttpStatus.BAD_REQUEST;
+import static org.springframework.http.HttpStatus.CREATED;
+import static org.springframework.http.HttpStatus.OK;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class ManufacturerWebsiteApiIntegrationTest extends ServicesTestSupport {
+
+    private static final String WEBSITE = "https://manufacturer.example.com";
+    private static final String UPDATED_WEBSITE = "http://updated-manufacturer.example.com";
+
+    private final ObjectMapper objectMapper = new ObjectMapper();
+
+    @Test
+    public void privateManufacturerApiStoresUpdatesAndReturnsWebsite() throws Exception {
+        String code = "WEBSITE_API_TEST_" + System.nanoTime();
+        String createJson = manufacturerJson(code, WEBSITE);
+        HttpEntity<String> request = new HttpEntity<>(createJson, getHeader());
+
+        ResponseEntity<String> createResponse = testRestTemplate.postForEntity(
+                "/api/v1/private/manufacturer", request, String.class);
+
+        assertThat(createResponse.getStatusCode(), is(CREATED));
+        JsonNode created = objectMapper.readTree(createResponse.getBody());
+        assertThat(created.get("website").asText(), is(WEBSITE));
+        long id = created.get("id").asLong();
+
+        ResponseEntity<Void> updateResponse = testRestTemplate.exchange(
+                "/api/v1/private/manufacturer/" + id,
+                HttpMethod.PUT,
+                new HttpEntity<>(manufacturerJson(code, UPDATED_WEBSITE), getHeader()),
+                Void.class);
+
+        assertThat(updateResponse.getStatusCode(), is(OK));
+
+        ResponseEntity<String> detailResponse = testRestTemplate.exchange(
+                "/api/v1/manufacturer/" + id,
+                HttpMethod.GET,
+                new HttpEntity<>(getHeader()),
+                String.class);
+        assertThat(detailResponse.getStatusCode(), is(OK));
+        assertThat(detailResponse.getBody(), containsString(UPDATED_WEBSITE));
+
+        ResponseEntity<String> listResponse = testRestTemplate.exchange(
+                "/api/v1/private/manufacturers?name=" + code + "&page=0&count=10",
+                HttpMethod.GET,
+                new HttpEntity<>(getHeader()),
+                String.class);
+        assertThat(listResponse.getStatusCode(), is(OK));
+        assertThat(listResponse.getBody(), containsString(UPDATED_WEBSITE));
+    }
+
+    @Test
+    public void privateManufacturerApiRejectsInvalidWebsiteWithoutChangingStoredValue() throws Exception {
+        String code = "INVALID_WEBSITE_TEST_" + System.nanoTime();
+        ResponseEntity<String> invalidCreateResponse = testRestTemplate.postForEntity(
+                "/api/v1/private/manufacturer",
+                new HttpEntity<>(manufacturerJson(code, "manufacturer.example.com"), getHeader()),
+                String.class);
+
+        assertThat(invalidCreateResponse.getStatusCode(), is(BAD_REQUEST));
+
+        String validCreateJson = manufacturerJson(code, WEBSITE);
+        ResponseEntity<String> createResponse = testRestTemplate.postForEntity(
+                "/api/v1/private/manufacturer",
+                new HttpEntity<>(validCreateJson, getHeader()),
+                String.class);
+        long id = objectMapper.readTree(createResponse.getBody()).get("id").asLong();
+
+        ResponseEntity<String> invalidUpdateResponse = testRestTemplate.exchange(
+                "/api/v1/private/manufacturer/" + id,
+                HttpMethod.PUT,
+                new HttpEntity<>(manufacturerJson(code, "manufacturer.example.com"), getHeader()),
+                String.class);
+
+        assertThat(invalidUpdateResponse.getStatusCode(), is(BAD_REQUEST));
+
+        ResponseEntity<String> detailResponse = testRestTemplate.exchange(
+                "/api/v1/manufacturer/" + id,
+                HttpMethod.GET,
+                new HttpEntity<>(getHeader()),
+                String.class);
+        assertThat(detailResponse.getBody(), containsString(WEBSITE));
+    }
+
+    private String manufacturerJson(String code, String website) {
+        return "{\"code\":\"" + code + "\",\"order\":0,\"website\":\"" + website
+                + "\",\"descriptions\":[{\"language\":\"en\",\"name\":\"" + code + "\"}]}";
+    }
+}
