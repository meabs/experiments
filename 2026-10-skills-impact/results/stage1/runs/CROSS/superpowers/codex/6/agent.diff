index 0000000..20988dd
--- /dev/null
+++ b/sm-shop/src/test/java/com/salesmanager/test/shop/integration/manufacturer/ManufacturerWebsiteIntegrationTest.java
@@ -0,0 +1,152 @@
+package com.salesmanager.test.shop.integration.manufacturer;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertTrue;
+import static org.springframework.http.HttpMethod.GET;
+import static org.springframework.http.HttpMethod.PUT;
+import static org.springframework.http.HttpStatus.BAD_REQUEST;
+import static org.springframework.http.HttpStatus.CREATED;
+import static org.springframework.http.HttpStatus.OK;
+
+import java.math.BigDecimal;
+import java.util.UUID;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpEntity;
+import org.springframework.http.ResponseEntity;
+import org.springframework.test.context.junit4.SpringRunner;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.salesmanager.core.business.constants.Constants;
+import com.salesmanager.shop.application.ShopApplication;
+import com.salesmanager.shop.model.catalog.product.product.PersistableProduct;
+import com.salesmanager.shop.model.catalog.product.product.ProductSpecification;
+import com.salesmanager.test.shop.common.ServicesTestSupport;
+
+@SpringBootTest(classes = ShopApplication.class, webEnvironment = WebEnvironment.RANDOM_PORT)
+@RunWith(SpringRunner.class)
+public class ManufacturerWebsiteIntegrationTest extends ServicesTestSupport {
+
+    private final ObjectMapper objectMapper = new ObjectMapper();
+
+    @Test
+    public void websiteIsPersistedAndReturnedByManufacturerAndProductEndpoints() throws Exception {
+        String code = "WEBSITE_" + UUID.randomUUID().toString().replace("-", "");
+        String website = "https://manufacturer.example.com";
+        HttpEntity<String> createRequest = new HttpEntity<>(manufacturerJson(code, website), getHeader());
+
+        ResponseEntity<JsonNode> createResponse = testRestTemplate.postForEntity(
+                "/api/v1/private/manufacturer", createRequest, JsonNode.class);
+
+        assertEquals(CREATED, createResponse.getStatusCode());
+        Long manufacturerId = createResponse.getBody().get("id").asLong();
+        assertEquals(website, createResponse.getBody().get("website").asText());
+
+        HttpEntity<String> readRequest = new HttpEntity<>(getHeader());
+        ResponseEntity<JsonNode> detailResponse = testRestTemplate.exchange(
+                "/api/v1/manufacturer/" + manufacturerId, GET, readRequest, JsonNode.class);
+        assertEquals(OK, detailResponse.getStatusCode());
+        assertEquals(website, detailResponse.getBody().get("website").asText());
+
+        assertWebsiteInManufacturerList("/api/v1/manufacturers", code, website);
+        assertWebsiteInManufacturerList("/api/v1/private/manufacturers", code, website);
+
+        String updatedWebsite = "http://updated.example.com";
+        HttpEntity<String> updateRequest = new HttpEntity<>(manufacturerJson(code, updatedWebsite), getHeader());
+        ResponseEntity<Void> updateResponse = testRestTemplate.exchange(
+                "/api/v1/private/manufacturer/" + manufacturerId, PUT, updateRequest, Void.class);
+        assertEquals(OK, updateResponse.getStatusCode());
+
+        detailResponse = testRestTemplate.exchange(
+                "/api/v1/manufacturer/" + manufacturerId, GET, readRequest, JsonNode.class);
+        assertEquals(updatedWebsite, detailResponse.getBody().get("website").asText());
+
+        PersistableProduct product = product(code + "_PRODUCT");
+        product.setSku(code + "_PRODUCT");
+        product.setAvailable(true);
+        product.setPrice(BigDecimal.TEN);
+        product.setQuantity(10);
+        ProductSpecification specifications = new ProductSpecification();
+        specifications.setManufacturer(code);
+        product.setProductSpecifications(specifications);
+
+        ResponseEntity<JsonNode> productCreateResponse = testRestTemplate.postForEntity(
+                "/api/v1/private/product?store=" + Constants.DEFAULT_STORE,
+                new HttpEntity<>(product, getHeader()), JsonNode.class);
+        assertEquals(CREATED, productCreateResponse.getStatusCode());
+
+        ResponseEntity<JsonNode> productListResponse = testRestTemplate.exchange(
+                "/api/v1/products?sku=" + product.getSku(), GET, readRequest, JsonNode.class);
+        assertEquals(OK, productListResponse.getStatusCode());
+        JsonNode products = productListResponse.getBody().get("products");
+        assertNotNull(products);
+        assertTrue(products.elements().hasNext());
+        assertEquals(updatedWebsite, products.elements().next().get("manufacturer").get("website").asText());
+
+        ResponseEntity<JsonNode> productV2Response = testRestTemplate.exchange(
+                "/api/v2/product/" + product.getSku(), GET, readRequest, JsonNode.class);
+        assertEquals(OK, productV2Response.getStatusCode());
+        assertEquals(updatedWebsite, productV2Response.getBody().get("manufacturer").get("website").asText());
+    }
+
+    @Test
+    public void invalidWebsiteIsRejectedWithoutCreatingManufacturer() throws Exception {
+        String code = "INVALID_WEBSITE_" + UUID.randomUUID().toString().replace("-", "");
+        ResponseEntity<JsonNode> response = testRestTemplate.postForEntity(
+                "/api/v1/private/manufacturer",
+                new HttpEntity<>(manufacturerJson(code, "manufacturer.example.com"), getHeader()),
+                JsonNode.class);
+
+        assertEquals(BAD_REQUEST, response.getStatusCode());
+
+        ResponseEntity<JsonNode> listResponse = testRestTemplate.exchange(
+                "/api/v1/private/manufacturers?name=" + code, GET,
+                new HttpEntity<>(getHeader()), JsonNode.class);
+        assertEquals(OK, listResponse.getStatusCode());
+        assertEquals(0, listResponse.getBody().get("manufacturers").size());
+    }
+
+    @Test
+    public void invalidWebsiteIsRejectedWithoutChangingExistingManufacturer() throws Exception {
+        String code = "INVALID_UPDATE_" + UUID.randomUUID().toString().replace("-", "");
+        String website = "https://manufacturer.example.com";
+        ResponseEntity<JsonNode> createResponse = testRestTemplate.postForEntity(
+                "/api/v1/private/manufacturer",
+                new HttpEntity<>(manufacturerJson(code, website), getHeader()), JsonNode.class);
+        Long manufacturerId = createResponse.getBody().get("id").asLong();
+
+        ResponseEntity<JsonNode> updateResponse = testRestTemplate.exchange(
+                "/api/v1/private/manufacturer/" + manufacturerId, PUT,
+                new HttpEntity<>(manufacturerJson(code, "manufacturer.example.com"), getHeader()), JsonNode.class);
+        assertEquals(BAD_REQUEST, updateResponse.getStatusCode());
+
+        ResponseEntity<JsonNode> detailResponse = testRestTemplate.exchange(
+                "/api/v1/manufacturer/" + manufacturerId, GET,
+                new HttpEntity<>(getHeader()), JsonNode.class);
+        assertEquals(website, detailResponse.getBody().get("website").asText());
+    }
+
+    private void assertWebsiteInManufacturerList(String path, String code, String website) throws Exception {
+        ResponseEntity<JsonNode> response = testRestTemplate.exchange(path + "?name=" + code, GET,
+                new HttpEntity<>(getHeader()), JsonNode.class);
+        assertEquals(OK, response.getStatusCode());
+        JsonNode manufacturers = response.getBody().get("manufacturers");
+        assertEquals(1, manufacturers.size());
+        assertEquals(code, manufacturers.get(0).get("code").asText());
+        assertEquals(website, manufacturers.get(0).get("website").asText());
+    }
+
+    private String manufacturerJson(String code, String website) throws Exception {
+        return objectMapper.writeValueAsString(objectMapper.createObjectNode()
+                .put("code", code)
+                .put("website", website)
+                .put("order", 0)
+                .set("descriptions", objectMapper.createArrayNode()
+                        .add(objectMapper.createObjectNode().put("language", "en").put("name", code))));
+    }
+}
