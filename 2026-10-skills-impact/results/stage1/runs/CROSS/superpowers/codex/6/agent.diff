diff --git a/sm-shop/src/test/java/com/salesmanager/test/shop/integration/manufacturer/ManufacturerWebsiteIntegrationTest.java b/sm-shop/src/test/java/com/salesmanager/test/shop/integration/manufacturer/ManufacturerWebsiteIntegrationTest.java
