@@ -0,0 +1,22 @@
+package com.salesmanager.shop.store.api.v1.product;
+
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+/**
+ * Optional manufacturer website. Null is allowed. Any other value must be an http or https URL.
+ */
+public final class ManufacturerWebsite {
+
+	private ManufacturerWebsite() {
+	}
+
+	public static void validate(String website) {
+		if (website == null) {
+			return;
+		}
+		if (website.startsWith("http://") || website.startsWith("https://")) {
+			return;
+		}
+		throw new RestApiException("400", "website must start with http:// or https://");
+	}
+}
