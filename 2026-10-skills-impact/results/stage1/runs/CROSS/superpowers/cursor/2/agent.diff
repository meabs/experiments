+package com.salesmanager.test.shop.controller.manufacturer;
+
+import org.junit.Test;
+
+import com.salesmanager.shop.store.facade.manufacturer.ManufacturerFacadeImpl;
+
+public class ManufacturerWebsiteTest {
+
+	@Test
+	public void acceptsMissingWebsite() {
+		ManufacturerFacadeImpl.validateWebsite(null);
+		ManufacturerFacadeImpl.validateWebsite("");
+	}
+
+	@Test
+	public void acceptsHttpAndHttps() {
+		ManufacturerFacadeImpl.validateWebsite("http://example.com");
+		ManufacturerFacadeImpl.validateWebsite("https://example.com/brand");
+	}
+
+	@Test(expected = IllegalArgumentException.class)
+	public void rejectsWebsiteWithoutHttpScheme() {
+		ManufacturerFacadeImpl.validateWebsite("www.example.com");
+	}
+
+	@Test(expected = IllegalArgumentException.class)
+	public void rejectsFtpWebsite() {
+		ManufacturerFacadeImpl.validateWebsite("ftp://example.com");
+	}
+}
