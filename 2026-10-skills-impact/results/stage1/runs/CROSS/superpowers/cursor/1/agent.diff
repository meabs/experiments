@@ -0,0 +1,76 @@
+package com.salesmanager.test.shop.manufacturer;
+
+import java.lang.reflect.Proxy;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+import com.salesmanager.core.business.services.reference.language.LanguageService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.mapper.catalog.ReadableManufacturerMapper;
+import com.salesmanager.shop.model.catalog.manufacturer.PersistableManufacturer;
+import com.salesmanager.shop.model.catalog.manufacturer.ReadableManufacturer;
+import com.salesmanager.shop.populator.manufacturer.PersistableManufacturerPopulator;
+import com.salesmanager.shop.populator.manufacturer.ReadableManufacturerPopulator;
+import com.salesmanager.core.model.catalog.product.manufacturer.Manufacturer;
+
+public class ManufacturerWebsiteTest {
+
+	@Test
+	public void copiesWebsiteFromPersistableManufacturer() throws Exception {
+		PersistableManufacturer source = new PersistableManufacturer();
+		source.setCode("ACME");
+		source.setWebsite("https://acme.example");
+
+		LanguageService languageService = (LanguageService) Proxy.newProxyInstance(
+				LanguageService.class.getClassLoader(),
+				new Class<?>[] { LanguageService.class },
+				(proxy, method, args) -> null);
+
+		PersistableManufacturerPopulator populator = new PersistableManufacturerPopulator();
+		populator.setLanguageService(languageService);
+
+		Manufacturer target = populator.populate(source, new Manufacturer(), new MerchantStore(), new Language());
+
+		Assert.assertEquals("https://acme.example", target.getWebsite());
+	}
+
+	@Test
+	public void readableManufacturerIncludesWebsite() throws Exception {
+		Manufacturer source = new Manufacturer();
+		source.setId(4L);
+		source.setCode("ACME");
+		source.setOrder(1);
+		source.setWebsite("http://acme.example");
+
+		ReadableManufacturer target = new ReadableManufacturerPopulator()
+				.populate(source, new ReadableManufacturer(), new MerchantStore(), new Language());
+
+		Assert.assertEquals("http://acme.example", target.getWebsite());
+	}
+
+	@Test
+	public void mapperCopiesWebsite() {
+		Manufacturer source = new Manufacturer();
+		source.setId(4L);
+		source.setCode("ACME");
+		source.setOrder(1);
+		source.setWebsite("https://acme.example");
+
+		MerchantStore store = new MerchantStore();
+		Language language = new Language();
+		language.setCode("en");
+		store.setDefaultLanguage(language);
+
+		ReadableManufacturer readable = new ReadableManufacturerMapper().convert(source, store, language);
+
+		Assert.assertEquals("https://acme.example", readable.getWebsite());
+	}
+
+	@Test
+	public void missingWebsiteIsAllowed() {
+		PersistableManufacturer manufacturer = new PersistableManufacturer();
+		Assert.assertNull(manufacturer.getWebsite());
+	}
+}
