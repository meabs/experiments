+	/**
+	 * Reads CART_MAX_LINE_QUANTITY from the store on every call so a configuration
+	 * change applies without a restart. Missing or blank values use the default.
+	 */
+	private int cartMaxLineQuantity(MerchantStore store) {
+		try {
+			MerchantConfiguration configuration = merchantConfigurationService
+					.getMerchantConfiguration(Constants.CART_MAX_LINE_QUANTITY, store);
+			if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+				return Constants.DEFAULT_CART_MAX_LINE_QUANTITY;
+			}
+			return Integer.parseInt(configuration.getValue().trim());
+		} catch (ServiceException | NumberFormatException e) {
+			LOG.warn("Unreadable {} for store {}, using {}", Constants.CART_MAX_LINE_QUANTITY,
+					store != null ? store.getCode() : null, Constants.DEFAULT_CART_MAX_LINE_QUANTITY);
+			return Constants.DEFAULT_CART_MAX_LINE_QUANTITY;
+		}
+	}
+
+	/**
+	 * A quantity of 0 means remove the line and is not limited. A positive quantity
+	 * above the store maximum is rejected before the cart is written.
+	 */
+	private void rejectIfLineQuantityAboveMax(int quantity, int maxLineQuantity) {
+		if (quantity <= 0) {
+			return;
+		}
+		if (quantity > maxLineQuantity) {
+			throw new RestApiException("400", "Cart line quantity " + quantity + " exceeds the maximum of "
+					+ maxLineQuantity);
+		}
+	}
