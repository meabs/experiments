+	/**
+	 * Reads CART_MAX_LINE_QUANTITY from the store on every call so a configuration
+	 * change applies without a restart. Missing or unreadable values use 99.
+	 * A quantity of 0 is left alone; callers use it to remove a line.
+	 */
+	private void assertLineQuantity(int quantity, MerchantStore store) {
+		if (quantity <= 0) {
+			return;
+		}
+		int max = maxLineQuantity(store);
+		if (quantity > max) {
+			throw new RestApiException("400",
+					"Cart line quantity " + quantity + " exceeds the maximum of " + max);
+		}
+	}
+
+	private int maxLineQuantity(MerchantStore store) {
+		try {
+			MerchantConfiguration configuration = merchantConfigurationService
+					.getMerchantConfiguration(Constants.CART_MAX_LINE_QUANTITY, store);
+			if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+				return Constants.DEFAULT_CART_MAX_LINE_QUANTITY;
+			}
+			return Integer.parseInt(configuration.getValue().trim());
+		} catch (Exception e) {
+			LOG.warn("Unreadable {} for store {}, using default {}", Constants.CART_MAX_LINE_QUANTITY,
+					store != null ? store.getCode() : null, Constants.DEFAULT_CART_MAX_LINE_QUANTITY);
+			return Constants.DEFAULT_CART_MAX_LINE_QUANTITY;
+		}
+	}
+
 	private String uniqueShoppingCartCode() {
