+public class CartLineQuantityLimitTest {
+
+	@Test
+	public void defaultsTo99WhenStoreHasNoConfiguration() throws Exception {
+		CartLineQuantityLimit limit = new CartLineQuantityLimit(config(null));
+		assertEquals(99, limit.maxFor(new MerchantStore()));
+		limit.check(99, new MerchantStore());
+	}
+
+	@Test
+	public void readsWholeNumberFromStoreConfiguration() throws Exception {
+		MerchantConfiguration configuration = new MerchantConfiguration();
+		configuration.setKey(CartLineQuantityLimit.CONFIG_KEY);
+		configuration.setValue("5");
+		CartLineQuantityLimit limit = new CartLineQuantityLimit(config(configuration));
+		assertEquals(5, limit.maxFor(new MerchantStore()));
+		limit.check(5, new MerchantStore());
+		try {
+			limit.check(6, new MerchantStore());
+			fail("quantity above the store limit must be rejected");
+		} catch (ServiceRuntimeException expected) {
+			assertEquals("400", expected.getErrorCode());
+		}
+	}
