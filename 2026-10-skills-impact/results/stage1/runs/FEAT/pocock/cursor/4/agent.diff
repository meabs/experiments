+package com.salesmanager.shop.store.controller.shoppingCart;
+
+import org.junit.Test;
+
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.fail;
+
+public class CartLineQuantityLimitTest {
+
+	@Test
+	public void missingConfigurationDefaultsTo99() {
+		assertEquals(99, CartLineQuantityLimit.resolveMax(null));
+		assertEquals(99, CartLineQuantityLimit.resolveMax("  "));
+		assertEquals(Constants.DEFAULT_CART_MAX_LINE_QUANTITY, CartLineQuantityLimit.resolveMax(null));
+	}
+
+	@Test
+	public void configuredWholeNumberIsUsed() {
+		assertEquals(5, CartLineQuantityLimit.resolveMax("5"));
+		assertEquals(12, CartLineQuantityLimit.resolveMax(" 12 "));
+	}
+
+	@Test
+	public void quantityAtTheLimitIsAllowed() {
+		CartLineQuantityLimit.rejectIfAbove(99, 99, 99);
+		CartLineQuantityLimit.rejectIfAbove(5, 5, 5);
+	}
+
+	@Test
+	public void quantityAboveTheLimitIsRejected() {
+		try {
+			CartLineQuantityLimit.rejectIfAbove(100, 100, 99);
+			fail("expected RestApiException");
+		} catch (RestApiException expected) {
+			assertEquals("400", expected.getErrorCode());
+		}
+	}
+
+	@Test
+	public void incrementedLineAboveTheLimitIsRejected() {
+		try {
+			CartLineQuantityLimit.rejectIfAbove(2, 100, 99);
+			fail("expected RestApiException");
+		} catch (RestApiException expected) {
+			assertEquals("400", expected.getErrorCode());
+		}
+	}
+
+	@Test
+	public void zeroQuantityIsNotCapped() {
+		CartLineQuantityLimit.rejectIfAbove(0, 0, 99);
+		CartLineQuantityLimit.rejectIfAbove(0, 500, 99);
+	}
+}
