@@ -0,0 +1,36 @@
+package com.salesmanager.shop.store.controller.shoppingCart;
+
+import org.apache.commons.lang3.StringUtils;
+
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+/**
+ * Per-store cap on how many units one cart line may hold.
+ * Quantity 0 is left alone: callers use it to remove a line.
+ */
+public final class CartLineQuantityLimit {
+
+	private CartLineQuantityLimit() {
+	}
+
+	public static int resolveMax(String configuredValue) {
+		if (StringUtils.isBlank(configuredValue)) {
+			return com.salesmanager.shop.constants.Constants.DEFAULT_CART_MAX_LINE_QUANTITY;
+		}
+		return Integer.parseInt(configuredValue.trim());
+	}
+
+	/**
+	 * @param requestedQuantity quantity on the request; 0 means remove and is not capped
+	 * @param resultingQuantity quantity the line would have after the request
+	 */
+	public static void rejectIfAbove(int requestedQuantity, int resultingQuantity, int max) {
+		if (requestedQuantity == 0) {
+			return;
+		}
+		if (resultingQuantity > max) {
+			throw new RestApiException("400",
+					"Cart line quantity " + resultingQuantity + " exceeds the maximum of " + max);
+		}
+	}
+}
