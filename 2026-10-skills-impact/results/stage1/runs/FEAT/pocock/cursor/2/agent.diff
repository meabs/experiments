+	/**
+	 * Read on every cart write so a configuration change applies without a restart.
+	 */
+	private int cartMaxLineQuantity(MerchantStore store) {
+		try {
+			MerchantConfiguration configuration = merchantConfigurationService
+					.getMerchantConfiguration(Constants.CART_MAX_LINE_QUANTITY, store);
+			String value = configuration == null ? null : configuration.getValue();
+			return CartLineQuantityLimit.resolve(value);
+		} catch (ServiceException e) {
+			throw new ServiceRuntimeException("Cannot read cart line quantity limit", e);
+		}
+	}
