+package com.salesmanager.test.shop.controller.shoppingCart;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.controller.shoppingCart.CartLineQuantityLimit;
+
+public class CartLineQuantityLimitTest {
+
+	@Test
+	public void missingConfigurationDefaultsTo99() {
+		Assert.assertEquals(99, CartLineQuantityLimit.resolve(null));
+		Assert.assertEquals(99, CartLineQuantityLimit.resolve("  "));
+		Assert.assertEquals(Constants.DEFAULT_CART_MAX_LINE_QUANTITY, 99);
+	}
+
+	@Test
+	public void readsWholeNumberFromConfiguration() {
+		Assert.assertEquals(4, CartLineQuantityLimit.resolve("4"));
+		Assert.assertEquals(12, CartLineQuantityLimit.resolve(" 12 "));
+	}
+
+	@Test
+	public void quantityAtTheLimitIsAllowedAndZeroIsNotAViolation() {
+		CartLineQuantityLimit.rejectIfAbove(4, 4);
+		CartLineQuantityLimit.rejectIfAbove(0, 4);
+	}
+
+	@Test
+	public void quantityAboveTheLimitIsRejected() {
+		try {
+			CartLineQuantityLimit.rejectIfAbove(5, 4);
+			Assert.fail("expected rejection");
+		} catch (ServiceRuntimeException ex) {
+			Assert.assertTrue(ex.getErrorMessage().contains("5"));
+			Assert.assertTrue(ex.getErrorMessage().contains("4"));
+		}
+	}
+}
