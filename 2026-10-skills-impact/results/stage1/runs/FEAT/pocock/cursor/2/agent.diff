+package com.salesmanager.shop.store.controller.shoppingCart;
+
+import org.apache.commons.lang3.StringUtils;
+
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+
+/**
+ * Per-store cap on how many units one cart line may hold.
+ * A quantity of zero is a removal and is never rejected here.
+ */
+public final class CartLineQuantityLimit {
+
+	private CartLineQuantityLimit() {
+	}
+
+	public static int resolve(String configuredValue) {
+		if (StringUtils.isBlank(configuredValue)) {
+			return Constants.DEFAULT_CART_MAX_LINE_QUANTITY;
+		}
+		try {
+			return Integer.parseInt(configuredValue.trim());
+		} catch (NumberFormatException ex) {
+			throw new ServiceRuntimeException(
+					"CART_MAX_LINE_QUANTITY must be a whole number",
+					new IllegalArgumentException(configuredValue));
+		}
+	}
+
+	/**
+	 * @param quantity resulting units on the line (not the delta). Zero is allowed.
+	 */
+	public static void rejectIfAbove(int quantity, int max) {
+		rejectIfAbove((long) quantity, max);
+	}
+
+	public static void rejectIfAbove(long quantity, int max) {
+		if (quantity > 0 && quantity > max) {
+			String message = "Cart line quantity " + quantity + " exceeds the maximum of " + max;
+			throw new ServiceRuntimeException(message, new IllegalArgumentException(message));
+		}
+	}
+}
