+	private void validateAddedLineQuantity(ShoppingCart cart,
+			com.salesmanager.core.model.shoppingcart.ShoppingCartItem item, MerchantStore store) {
+		if (item.getQuantity() <= 0) {
+			return;
+		}
+
+		long resultingQuantity = item.getQuantity();
+		if (CollectionUtils.isEmpty(item.getAttributes())) {
+			for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem existingItem : cart.getLineItems()) {
+				if (existingItem.getProduct().getId().longValue() == item.getProduct().getId().longValue()
+						&& CollectionUtils.isEmpty(existingItem.getAttributes())) {
+					resultingQuantity += existingItem.getQuantity();
+					break;
+				}
+			}
+		}
+
+		validateLineQuantity(resultingQuantity, getCartMaxLineQuantity(store));
+	}
+
+	private void validateSetLineQuantities(
+			List<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> items, MerchantStore store) {
+		int maxLineQuantity = getCartMaxLineQuantity(store);
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem item : items) {
+			validateSetLineQuantity(item, maxLineQuantity);
+		}
+	}
+
+	private void validateSetLineQuantity(com.salesmanager.core.model.shoppingcart.ShoppingCartItem item,
+			MerchantStore store) {
+		if (item.getQuantity() > 0) {
+			validateLineQuantity(item.getQuantity(), getCartMaxLineQuantity(store));
+		}
+	}
+
+	private void validateSetLineQuantity(com.salesmanager.core.model.shoppingcart.ShoppingCartItem item,
+			int maxLineQuantity) {
+		if (item.getQuantity() > 0) {
+			validateLineQuantity(item.getQuantity(), maxLineQuantity);
+		}
+	}
+
+	private void validateLineQuantity(long quantity, int maxLineQuantity) {
+		if (quantity > maxLineQuantity) {
+			throw new RestApiException("400", "Cart line quantity cannot exceed " + maxLineQuantity);
+		}
+	}
+
+	private int getCartMaxLineQuantity(MerchantStore store) {
+		final MerchantConfiguration configuration;
+		try {
+			configuration = merchantConfigurationService
+					.getMerchantConfiguration(Constants.CART_MAX_LINE_QUANTITY, store);
+		} catch (ServiceException e) {
+			throw new ServiceRuntimeException("Unable to read cart line quantity limit", e);
+		}
+
+		if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+			return DEFAULT_CART_MAX_LINE_QUANTITY;
+		}
+
+		try {
+			int maxLineQuantity = Integer.parseInt(configuration.getValue().trim());
+			if (maxLineQuantity < 0) {
+				throw new RestApiException("400", "Cart line quantity limit must be a whole number");
+			}
+			return maxLineQuantity;
+		} catch (NumberFormatException e) {
+			throw new RestApiException("400", "Cart line quantity limit must be a whole number", e);
+		}
+	}
+
