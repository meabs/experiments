+	private int getCartMaxLineQuantity(final MerchantStore store) {
+		try {
+			MerchantConfiguration configuration = merchantConfigurationService
+					.getMerchantConfiguration(Constants.CART_MAX_LINE_QUANTITY, store);
+			if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+				return DEFAULT_CART_MAX_LINE_QUANTITY;
+			}
+
+			int maxLineQuantity = Integer.parseInt(configuration.getValue().trim());
+			if (maxLineQuantity < 0) {
+				throw new NumberFormatException("must not be negative");
+			}
+			return maxLineQuantity;
+		} catch (NumberFormatException e) {
+			throw new ServiceRuntimeException("400",
+					"Configuration " + Constants.CART_MAX_LINE_QUANTITY + " must be a whole number", e);
+		} catch (ServiceException e) {
+			throw new ServiceRuntimeException("Unable to read cart quantity configuration", e);
+		}
+	}
+
+	private void validateCartLineQuantity(final long quantity, final int maxLineQuantity) {
+		if (quantity > maxLineQuantity) {
+			String message = "Cart line quantity must not exceed " + maxLineQuantity;
+			throw new ServiceRuntimeException("400", message, new IllegalArgumentException(message));
+		}
+	}
