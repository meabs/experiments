+package com.salesmanager.test.shop.integration.cart;
+
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.shoppingcart.ShoppingCartService;
+import com.salesmanager.core.business.services.system.MerchantConfigurationService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.system.MerchantConfiguration;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacadeImpl;
+
+class ShoppingCartQuantityLimitTest {
+
+    private final MerchantStore store = new MerchantStore();
+    private final MerchantConfigurationService configurationService = mock(MerchantConfigurationService.class);
+    private final ShoppingCartService shoppingCartService = mock(ShoppingCartService.class);
+    private final ProductService productService = mock(ProductService.class);
+    private final ShoppingCartFacadeImpl facade = new ShoppingCartFacadeImpl();
+
+    @BeforeEach
+    void setUp() throws Exception {
+        when(configurationService.getMerchantConfiguration("CART_MAX_LINE_QUANTITY", store)).thenReturn(null);
+        when(shoppingCartService.getByCode("cart-code", store)).thenReturn(null);
+        ReflectionTestUtils.setField(facade, "merchantConfigurationService", configurationService);
+        ReflectionTestUtils.setField(facade, "shoppingCartService", shoppingCartService);
+        ReflectionTestUtils.setField(facade, "productService", productService);
+    }
+
+    @Test
+    void defaultsTo99AndRejectsCreateAboveTheDefault() throws Exception {
+        PersistableShoppingCartItem item = itemWithQuantity(100);
+
+        ServiceRuntimeException exception = assertThrows(ServiceRuntimeException.class,
+                () -> facade.addToCart(item, store, null));
+
+        assertTrue(exception.getMessage().contains("99"));
+        verify(productService, never()).getBySku(any(), any(), any());
+    }
+
+    @Test
+    void rejectsSingleItemUpdateBeforeLoadingTheCart() throws Exception {
+        PersistableShoppingCartItem item = itemWithQuantity(6);
+        MerchantConfiguration configuration = configuration("5");
+        when(configurationService.getMerchantConfiguration("CART_MAX_LINE_QUANTITY", store)).thenReturn(configuration);
+
+        assertThrows(ServiceRuntimeException.class, () -> facade.modifyCart("cart-code", item, store, null));
+
+        verify(shoppingCartService, never()).getByCode("cart-code", store);
+    }
+
+    @Test
+    void rejectsMultiItemUpdateBeforeLoadingTheCart() throws Exception {
+        PersistableShoppingCartItem item = itemWithQuantity(6);
+        MerchantConfiguration configuration = configuration("5");
+        when(configurationService.getMerchantConfiguration("CART_MAX_LINE_QUANTITY", store)).thenReturn(configuration);
+
+        assertThrows(ServiceRuntimeException.class,
+                () -> facade.modifyCartMulti("cart-code", java.util.List.of(item), store, null));
+
+        verify(shoppingCartService, never()).getByCode("cart-code", store);
+    }
+
+    @Test
+    void readsTheSettingForEachRequestAndAllowsZero() throws Exception {
+        MerchantConfiguration configuration = configuration("5");
+        when(configurationService.getMerchantConfiguration("CART_MAX_LINE_QUANTITY", store)).thenReturn(configuration);
+
+        assertThrows(ResourceNotFoundException.class,
+                () -> facade.modifyCart("cart-code", itemWithQuantity(5), store, null));
+
+        configuration.setValue("4");
+        assertThrows(ServiceRuntimeException.class,
+                () -> facade.modifyCart("cart-code", itemWithQuantity(5), store, null));
+
+        assertThrows(ResourceNotFoundException.class,
+                () -> facade.modifyCart("cart-code", itemWithQuantity(0), store, null));
+    }
+
+    private PersistableShoppingCartItem itemWithQuantity(int quantity) {
+        PersistableShoppingCartItem item = new PersistableShoppingCartItem();
+        item.setProduct("product-sku");
+        item.setQuantity(quantity);
+        return item;
+    }
+
+    private MerchantConfiguration configuration(String value) {
+        MerchantConfiguration configuration = new MerchantConfiguration();
+        configuration.setValue(value);
+        return configuration;
+    }
+}
