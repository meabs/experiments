+package com.salesmanager.test.shop.integration.cart;
+
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import java.util.Collections;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.InjectMocks;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+
+import com.salesmanager.core.business.services.shoppingcart.ShoppingCartService;
+import com.salesmanager.core.business.services.system.MerchantConfigurationService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.system.MerchantConfiguration;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacadeImpl;
+
+@ExtendWith(MockitoExtension.class)
+class ShoppingCartQuantityLimitTest {
+
+    private static final String CART_MAX_LINE_QUANTITY = "CART_MAX_LINE_QUANTITY";
+
+    @Mock
+    private MerchantConfigurationService merchantConfigurationService;
+
+    @Mock
+    private ShoppingCartService shoppingCartService;
+
+    @Mock
+    private MerchantStore merchantStore;
+
+    @InjectMocks
+    private ShoppingCartFacadeImpl shoppingCartFacade;
+
+    @BeforeEach
+    void configureStore() throws Exception {
+        MerchantConfiguration configuration = new MerchantConfiguration();
+        configuration.setKey(CART_MAX_LINE_QUANTITY);
+        configuration.setValue("2");
+        when(merchantConfigurationService.getMerchantConfiguration(CART_MAX_LINE_QUANTITY, merchantStore))
+                .thenReturn(configuration);
+    }
+
+    @Test
+    void rejectsNewCartLineAboveConfiguredLimitBeforeCreatingCart() throws Exception {
+        PersistableShoppingCartItem item = itemWithQuantity(3);
+
+        assertThrows(RestApiException.class,
+                () -> shoppingCartFacade.addToCart(item, merchantStore, null));
+
+        verify(shoppingCartService, never()).saveOrUpdate(org.mockito.ArgumentMatchers.any());
+        verify(shoppingCartService, never()).getByCode(org.mockito.ArgumentMatchers.anyString(),
+                org.mockito.ArgumentMatchers.eq(merchantStore));
+    }
+
+    @Test
+    void rejectsSingleItemUpdateBeforeReadingCart() throws Exception {
+        PersistableShoppingCartItem item = itemWithQuantity(3);
+
+        assertThrows(RestApiException.class,
+                () -> shoppingCartFacade.modifyCart("cart-code", item, merchantStore, null));
+
+        verify(shoppingCartService, never()).getByCode(org.mockito.ArgumentMatchers.anyString(),
+                org.mockito.ArgumentMatchers.eq(merchantStore));
+    }
+
+    @Test
+    void rejectsMultiItemUpdateBeforeReadingCart() throws Exception {
+        PersistableShoppingCartItem item = itemWithQuantity(3);
+
+        assertThrows(RestApiException.class,
+                () -> shoppingCartFacade.modifyCartMulti("cart-code", Collections.singletonList(item),
+                        merchantStore, null));
+
+        verify(shoppingCartService, never()).getByCode(org.mockito.ArgumentMatchers.anyString(),
+                org.mockito.ArgumentMatchers.eq(merchantStore));
+    }
+
+    @Test
+    void usesDefaultLimitWhenConfigurationIsMissing() throws Exception {
+        when(merchantConfigurationService.getMerchantConfiguration(CART_MAX_LINE_QUANTITY, merchantStore))
+                .thenReturn(null);
+
+        PersistableShoppingCartItem item = itemWithQuantity(100);
+
+        assertThrows(RestApiException.class,
+                () -> shoppingCartFacade.addToCart(item, merchantStore, null));
+
+        verify(shoppingCartService, never()).saveOrUpdate(org.mockito.ArgumentMatchers.any());
+    }
+
+    @Test
+    void readsUpdatedConfigurationWithoutRestarting() throws Exception {
+        PersistableShoppingCartItem item = itemWithQuantity(3);
+
+        assertThrows(RestApiException.class,
+                () -> shoppingCartFacade.modifyCart("cart-code", item, merchantStore, null));
+
+        MerchantConfiguration configuration = new MerchantConfiguration();
+        configuration.setKey(CART_MAX_LINE_QUANTITY);
+        configuration.setValue("3");
+        when(merchantConfigurationService.getMerchantConfiguration(CART_MAX_LINE_QUANTITY, merchantStore))
+                .thenReturn(configuration);
+        when(shoppingCartService.getByCode("cart-code", merchantStore)).thenReturn(null);
+
+        assertThrows(ResourceNotFoundException.class,
+                () -> shoppingCartFacade.modifyCart("cart-code", item, merchantStore, null));
+
+        verify(shoppingCartService).getByCode("cart-code", merchantStore);
+    }
+
+    private PersistableShoppingCartItem itemWithQuantity(int quantity) {
+        PersistableShoppingCartItem item = new PersistableShoppingCartItem();
+        item.setProduct("product-sku");
+        item.setQuantity(quantity);
+        return item;
+    }
+}
