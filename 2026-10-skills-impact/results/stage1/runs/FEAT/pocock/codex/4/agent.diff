+	private int getCartMaxLineQuantity(MerchantStore store) {
+		try {
+			MerchantConfiguration configuration = merchantConfigurationService
+					.getMerchantConfiguration(CART_MAX_LINE_QUANTITY, store);
+			if (configuration == null) {
+				return DEFAULT_CART_MAX_LINE_QUANTITY;
+			}
+
+			if (StringUtils.isBlank(configuration.getValue())) {
+				throw new NumberFormatException("blank value");
+			}
+			int maxLineQuantity = Integer.parseInt(configuration.getValue().trim());
+			if (maxLineQuantity < 0) {
+				throw new NumberFormatException("negative value");
+			}
+			return maxLineQuantity;
+		} catch (NumberFormatException e) {
+			throw new RestApiException("400", "Merchant configuration " + CART_MAX_LINE_QUANTITY
+					+ " must be a non-negative whole number", e);
+		} catch (ServiceException e) {
+			throw new ServiceRuntimeException("Unable to read merchant configuration " + CART_MAX_LINE_QUANTITY, e);
+		}
+	}
+
+	private void validateLineQuantity(long quantity, int maxLineQuantity) {
+		if (quantity > maxLineQuantity) {
+			throw new RestApiException("400", "Cart line quantity must not exceed " + maxLineQuantity);
+		}
+	}
+
 	private String uniqueShoppingCartCode() {
 		return UUID.randomUUID().toString().replaceAll("-", "");
 	}
