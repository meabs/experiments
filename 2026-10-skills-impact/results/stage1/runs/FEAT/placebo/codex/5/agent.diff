+	private void validateLineQuantities(List<PersistableShoppingCartItem> items, MerchantStore store) {
+		int maximumQuantity = getMaximumLineQuantity(store);
+		for (PersistableShoppingCartItem item : items) {
+			validateLineQuantity(item.getQuantity(), maximumQuantity);
+		}
+	}
+
+	private void validateLineQuantity(int quantity, MerchantStore store) {
+		validateLineQuantity(quantity, getMaximumLineQuantity(store));
+	}
+
+	private void validateLineQuantity(long quantity, MerchantStore store) {
+		validateLineQuantity(quantity, getMaximumLineQuantity(store));
+	}
+
+	private void validateLineQuantity(int quantity, int maximumQuantity) {
+		validateLineQuantity((long) quantity, maximumQuantity);
+	}
+
+	private void validateLineQuantity(long quantity, int maximumQuantity) {
+		if (quantity > 0 && quantity > maximumQuantity) {
+			throw new ServiceRuntimeException("400",
+					"Cart line quantity " + quantity + " exceeds the maximum of " + maximumQuantity,
+					new IllegalArgumentException("Cart line quantity exceeds configured maximum"));
+		}
+	}
+
+	private int getMaximumLineQuantity(MerchantStore store) {
+		try {
+			MerchantConfiguration configuration = merchantConfigurationService
+					.getMerchantConfiguration(CART_MAX_LINE_QUANTITY, store);
+			if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+				return DEFAULT_CART_MAX_LINE_QUANTITY;
+			}
+			return Integer.parseInt(configuration.getValue().trim());
+		} catch (ServiceException e) {
+			throw new ServiceRuntimeException("Unable to read cart line quantity configuration", e);
+		} catch (NumberFormatException e) {
+			throw new ServiceRuntimeException("Invalid " + CART_MAX_LINE_QUANTITY + " configuration", e);
+		}
+	}
