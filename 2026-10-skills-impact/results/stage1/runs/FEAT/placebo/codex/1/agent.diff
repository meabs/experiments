+	private void validateMergedCartQuantities(final ShoppingCart userShoppingModel, final ShoppingCart sessionCart,
+			final MerchantStore store) throws ServiceException {
+		int maxLineQuantity = getCartMaxLineQuantity(store);
+		if (CollectionUtils.isEmpty(sessionCart.getLineItems())) {
+			return;
+		}
+
+		for (ShoppingCartItem sessionItem : sessionCart.getLineItems()) {
+			validateLineQuantity(sessionItem.getQuantity(), maxLineQuantity);
+			if (CollectionUtils.isEmpty(userShoppingModel.getLineItems())) {
+				continue;
+			}
+
+			for (ShoppingCartItem userItem : userShoppingModel.getLineItems()) {
+				if (userItem.getProduct().getId().longValue() == sessionItem.getProduct().getId().longValue()
+						&& CollectionUtils.isNotEmpty(userItem.getAttributes())) {
+					validateLineQuantity((long) userItem.getQuantity() + sessionItem.getQuantity(), maxLineQuantity);
+					break;
+				}
+			}
+		}
+	}
+
+	private int getCartMaxLineQuantity(MerchantStore store) throws ServiceException {
+		MerchantConfiguration configuration = merchantConfigurationService
+				.getMerchantConfiguration(CART_MAX_LINE_QUANTITY, store);
+		if (configuration == null || configuration.getValue() == null
+				|| configuration.getValue().trim().isEmpty()) {
+			return DEFAULT_CART_MAX_LINE_QUANTITY;
+		}
+
+		try {
+			int maxLineQuantity = Integer.parseInt(configuration.getValue().trim());
+			if (maxLineQuantity < 0) {
+				throw new NumberFormatException("negative value");
+			}
+			return maxLineQuantity;
+		} catch (NumberFormatException e) {
+			throw new ServiceException("Invalid CART_MAX_LINE_QUANTITY configuration", e);
+		}
+	}
+
+	private void validateLineQuantity(long quantity, int maxLineQuantity) throws ServiceException {
+		if (quantity > maxLineQuantity) {
+			throw new ServiceException(
+					"Cart line quantity " + quantity + " exceeds the maximum of " + maxLineQuantity);
+		}
+	}
