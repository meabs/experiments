+	private void validateRequestedQuantities(List<PersistableShoppingCartItem> items, MerchantStore store)
+			throws ServiceException {
+		Integer maxQuantity = null;
+		for (PersistableShoppingCartItem item : items) {
+			if (item.getQuantity() > 0) {
+				if (maxQuantity == null) {
+					maxQuantity = getCartMaxLineQuantity(store);
+				}
+				validateRequestedQuantity(item.getQuantity(), maxQuantity);
+			}
+		}
+	}
+
+	private void validateRequestedQuantity(int quantity, MerchantStore store) throws ServiceException {
+		if (quantity > 0) {
+			validateRequestedQuantity(quantity, getCartMaxLineQuantity(store));
+		}
+	}
+
+	private void validateRequestedQuantity(int quantity, int maxQuantity) {
+		if (quantity > maxQuantity) {
+			throw new RestApiException("400",
+					"Cart line quantity cannot exceed " + maxQuantity + " units");
+		}
+	}
+
+	private void validateCartLineQuantityForAdd(ShoppingCart cartModel,
+			com.salesmanager.core.model.shoppingcart.ShoppingCartItem item, int quantity,
+			boolean withoutAttributes, MerchantStore store) throws ServiceException {
+		if (quantity <= 0) {
+			return;
+		}
+
+		int maxQuantity = getCartMaxLineQuantity(store);
+		validateRequestedQuantity(quantity, maxQuantity);
+
+		if (!withoutAttributes) {
+			return;
+		}
+
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem existingItem : cartModel.getLineItems()) {
+			if (existingItem.getProduct().getId().longValue() == item.getProduct().getId().longValue()
+					&& CollectionUtils.isEmpty(existingItem.getAttributes())) {
+				if (!item.isProductVirtual()
+						&& ((long) existingItem.getQuantity() + quantity) > maxQuantity) {
+					throw new RestApiException("400",
+							"Cart line quantity cannot exceed " + maxQuantity + " units");
+				}
+				return;
+			}
+		}
+	}
+
+	private int getCartMaxLineQuantity(MerchantStore store) throws ServiceException {
+		MerchantConfiguration configuration = merchantConfigurationService
+				.getMerchantConfiguration(CART_MAX_LINE_QUANTITY, store);
+		if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+			return DEFAULT_CART_MAX_LINE_QUANTITY;
+		}
+
+		try {
+			int configuredQuantity = Integer.parseInt(configuration.getValue().trim());
+			if (configuredQuantity >= 0) {
+				return configuredQuantity;
+			}
+		} catch (NumberFormatException e) {
+			LOG.warn("Invalid {} configuration for store {}. Using default {}", CART_MAX_LINE_QUANTITY,
+					store.getId(), DEFAULT_CART_MAX_LINE_QUANTITY);
+		}
+		return DEFAULT_CART_MAX_LINE_QUANTITY;
+	}
+
