+	private void validateAddedItemQuantity(ShoppingCart cartModel, PersistableShoppingCartItem requestedItem,
+			com.salesmanager.core.model.shoppingcart.ShoppingCartItem itemModel, MerchantStore store) {
+		int maxQuantity = getCartMaxLineQuantity(store);
+		validateLineQuantity(itemModel.getQuantity(), maxQuantity);
+
+		if (CollectionUtils.isEmpty(requestedItem.getAttributes()) && !itemModel.isProductVirtual()
+				&& CollectionUtils.isNotEmpty(cartModel.getLineItems())) {
+			long resultingQuantity = itemModel.getQuantity();
+			for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem existingItem : cartModel.getLineItems()) {
+				if (existingItem.getProduct().getId().longValue() == itemModel.getProduct().getId().longValue()
+						&& CollectionUtils.isEmpty(existingItem.getAttributes())) {
+					resultingQuantity += existingItem.getQuantity();
+					break;
+				}
+			}
+			if (resultingQuantity > maxQuantity) {
+				throw quantityLimitExceeded(maxQuantity);
+			}
+		}
+	}
+
+	private void validateLineQuantity(int quantity, int maxQuantity) {
+		if (quantity > maxQuantity) {
+			throw quantityLimitExceeded(maxQuantity);
+		}
+	}
+
+	private RestApiException quantityLimitExceeded(int maxQuantity) {
+		return new RestApiException("400", "Cart line quantity must not exceed " + maxQuantity);
+	}
+
+	private int getCartMaxLineQuantity(MerchantStore store) {
+		try {
+			MerchantConfiguration configuration = merchantConfigurationService
+					.getMerchantConfiguration(Constants.CART_MAX_LINE_QUANTITY, store);
+			if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+				return Constants.DEFAULT_CART_MAX_LINE_QUANTITY;
+			}
+			return Integer.parseInt(configuration.getValue().trim());
+		} catch (ServiceException e) {
+			throw new ServiceRuntimeException("Unable to read cart line quantity configuration", e);
+		} catch (NumberFormatException e) {
+			throw new ServiceRuntimeException("Cart line quantity configuration must be a whole number", e);
+		}
+	}
+
 	private String uniqueShoppingCartCode() {
 		return UUID.randomUUID().toString().replaceAll("-", "");
 	}
