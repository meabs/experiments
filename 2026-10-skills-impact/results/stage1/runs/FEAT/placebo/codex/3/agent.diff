+    public void enforcesLiveCartLineQuantityConfiguration() throws Exception {
+
+        MerchantStore store = merchantStoreService.getByCode(Constants.DEFAULT_STORE);
+        MerchantConfiguration configuration = new MerchantConfiguration();
+        configuration.setMerchantStore(store);
+        configuration.setKey(com.salesmanager.shop.constants.Constants.CART_MAX_LINE_QUANTITY);
+        configuration.setValue("1");
+        merchantConfigurationService.saveOrUpdate(configuration);
+
+        try {
+            ReadableProduct product = sampleProduct("cartMaxLineQuantity");
+            PersistableShoppingCartItem cartItem = new PersistableShoppingCartItem();
+            cartItem.setProduct(product.getSku());
+            cartItem.setQuantity(1);
+
+            ResponseEntity<ReadableShoppingCart> created = testRestTemplate.postForEntity("/api/v1/cart/",
+                    new HttpEntity<>(cartItem, getHeader()), ReadableShoppingCart.class);
+            assertThat(created.getStatusCode(), is(CREATED));
+
+            configuration.setValue("2");
+            merchantConfigurationService.saveOrUpdate(configuration);
+            cartItem.setQuantity(2);
+            ResponseEntity<ReadableShoppingCart> updated = testRestTemplate.exchange(
+                    "/api/v1/cart/" + created.getBody().getCode(), HttpMethod.PUT,
+                    new HttpEntity<>(cartItem, getHeader()), ReadableShoppingCart.class);
+            assertThat(updated.getStatusCode(), is(CREATED));
+
+            configuration.setValue("1");
+            merchantConfigurationService.saveOrUpdate(configuration);
+            ResponseEntity<String> rejected = testRestTemplate.exchange(
+                    "/api/v1/cart/" + created.getBody().getCode(), HttpMethod.PUT,
+                    new HttpEntity<>(cartItem, getHeader()), String.class);
+            assertThat(rejected.getStatusCode(), is(BAD_REQUEST));
+
+            ResponseEntity<ReadableShoppingCart> unchanged = testRestTemplate.getForEntity(
+                    "/api/v1/cart/" + created.getBody().getCode(), ReadableShoppingCart.class);
+            assertEquals(2, unchanged.getBody().getQuantity());
+        } finally {
+            merchantConfigurationService.delete(configuration);
+        }
+    }
