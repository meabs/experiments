+	private int getCartMaxLineQuantity(MerchantStore store) throws ServiceException {
+		MerchantConfiguration configuration = merchantConfigurationService
+				.getMerchantConfiguration(Constants.CART_MAX_LINE_QUANTITY, store);
+		if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+			return DEFAULT_CART_MAX_LINE_QUANTITY;
+		}
+
+		try {
+			return Integer.parseInt(configuration.getValue().trim());
+		} catch (NumberFormatException e) {
+			throw new RestApiException("400", "Configuration " + Constants.CART_MAX_LINE_QUANTITY
+					+ " must be a whole number");
+		}
+	}
+
+	private void validateRequestedLineQuantity(long quantity, int maxLineQuantity) {
+		if (quantity > maxLineQuantity) {
+			throw new RestApiException("400", "Cart line quantity cannot exceed " + maxLineQuantity);
+		}
+	}
+
+	private void validateAddLineQuantity(ShoppingCart cart, com.salesmanager.core.model.shoppingcart.ShoppingCartItem item,
+			int maxLineQuantity) {
+		if (item.getQuantity() == 0) {
+			return;
+		}
+
+		long resultingQuantity = item.getQuantity();
+		if (!item.isProductVirtual() && CollectionUtils.isEmpty(item.getAttributes())
+				&& CollectionUtils.isNotEmpty(cart.getLineItems())) {
+			for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem existingItem : cart.getLineItems()) {
+				if (existingItem.getProduct().getId().longValue() == item.getProduct().getId().longValue()
+						&& CollectionUtils.isEmpty(existingItem.getAttributes())) {
+					resultingQuantity += existingItem.getQuantity();
+					break;
+				}
+			}
+		}
+		validateRequestedLineQuantity(resultingQuantity, maxLineQuantity);
+	}
