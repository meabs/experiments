+package com.salesmanager.shop.store.controller.shoppingCart.facade;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.fail;
+
+import java.lang.reflect.Proxy;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.services.system.MerchantConfigurationService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.system.MerchantConfiguration;
+
+public class CartLineQuantityPolicyTest {
+
+	@Test
+	public void missingConfigurationUsesDefault() {
+		CartLineQuantityPolicy policy = policy(null);
+		assertEquals(CartLineQuantityPolicy.DEFAULT_MAX_LINE_QUANTITY, policy.maxLineQuantity(new MerchantStore()));
+		policy.check(99, new MerchantStore());
+	}
+
+	@Test
+	public void configuredMaximumIsReadEachCall() {
+		MerchantConfiguration configuration = new MerchantConfiguration();
+		configuration.setValue("4");
+		CartLineQuantityPolicy policy = policy(configuration);
+		assertEquals(4, policy.maxLineQuantity(new MerchantStore()));
+		policy.check(4, new MerchantStore());
+		policy.check(0, new MerchantStore());
+		try {
+			policy.check(5, new MerchantStore());
+			fail("quantity above the store maximum should be rejected");
+		} catch (IllegalArgumentException expected) {
+			assertEquals("Cart line quantity 5 exceeds the maximum of 4", expected.getMessage());
+		}
+	}
+
+	private CartLineQuantityPolicy policy(MerchantConfiguration configuration) {
+		MerchantConfigurationService service = (MerchantConfigurationService) Proxy.newProxyInstance(
+				MerchantConfigurationService.class.getClassLoader(),
+				new Class<?>[] { MerchantConfigurationService.class },
+				(proxy, method, args) -> {
+					if ("getMerchantConfiguration".equals(method.getName())) {
+						return configuration;
+					}
+					return null;
+				});
+		return new CartLineQuantityPolicy(service);
+	}
+}
