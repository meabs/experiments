+package com.salesmanager.shop.store.controller.shoppingCart.facade;
+
+import javax.inject.Inject;
+
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.stereotype.Component;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.system.MerchantConfigurationService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.system.MerchantConfiguration;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+
+/**
+ * Per-store cap on how many units a single cart line may hold.
+ * The value is read from merchant configuration on each check so a change
+ * applies without an application restart.
+ */
+@Component
+public class CartLineQuantityPolicy {
+
+	public static final String CONFIG_KEY = "CART_MAX_LINE_QUANTITY";
+
+	public static final int DEFAULT_MAX_LINE_QUANTITY = 99;
+
+	private final MerchantConfigurationService merchantConfigurationService;
+
+	@Inject
+	public CartLineQuantityPolicy(MerchantConfigurationService merchantConfigurationService) {
+		this.merchantConfigurationService = merchantConfigurationService;
+	}
+
+	/**
+	 * Quantity 0 is left alone: callers use it to remove a line.
+	 * A quantity above the store maximum is rejected before the cart is saved.
+	 */
+	public void check(int quantity, MerchantStore store) {
+		if (quantity <= 0) {
+			return;
+		}
+		int max = maxLineQuantity(store);
+		if (quantity > max) {
+			throw new IllegalArgumentException(
+					"Cart line quantity " + quantity + " exceeds the maximum of " + max);
+		}
+	}
+
+	public int maxLineQuantity(MerchantStore store) {
+		MerchantConfiguration configuration;
+		try {
+			configuration = merchantConfigurationService.getMerchantConfiguration(CONFIG_KEY, store);
+		} catch (ServiceException e) {
+			throw new ServiceRuntimeException("Cannot read " + CONFIG_KEY, e);
+		}
+		if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+			return DEFAULT_MAX_LINE_QUANTITY;
+		}
+		try {
+			return Integer.parseInt(configuration.getValue().trim());
+		} catch (NumberFormatException e) {
+			throw new IllegalArgumentException(
+					CONFIG_KEY + " must be a whole number but was '" + configuration.getValue() + "'");
+		}
+	}
+}
