+	/**
+	 * Storefront line cap. Read on each call so a configuration change applies
+	 * without a restart. Missing or non-numeric values use {@link #DEFAULT_CART_MAX_LINE_QUANTITY}.
+	 * A quantity of 0 is a line removal and is not limited.
+	 */
+	int cartMaxLineQuantity(MerchantStore store) throws ServiceException {
+		MerchantConfiguration configuration = merchantConfigurationService
+				.getMerchantConfiguration(CART_MAX_LINE_QUANTITY, store);
+		if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+			return DEFAULT_CART_MAX_LINE_QUANTITY;
+		}
+		try {
+			return Integer.parseInt(configuration.getValue().trim());
+		} catch (NumberFormatException ex) {
+			LOG.warn("Merchant configuration {} for store {} is not a whole number: {}",
+					CART_MAX_LINE_QUANTITY, store.getCode(), configuration.getValue());
+			return DEFAULT_CART_MAX_LINE_QUANTITY;
+		}
+	}
+
+	private void assertLineQuantity(int quantity, int maxLineQuantity) {
+		if (quantity > maxLineQuantity) {
+			throw new RestApiException("400",
+					"Cart line quantity cannot exceed " + maxLineQuantity);
+		}
+	}
+
