+	/**
+	 * Rejects a line quantity above the store maximum. Zero and negative quantities
+	 * are left to the existing cart behaviour (zero removes a line on modify).
+	 * The maximum is read from merchant configuration on every call.
+	 */
+	private void assertLineQuantityAllowed(int quantity, MerchantStore store) {
+		if (quantity <= 0) {
+			return;
+		}
+		int max = cartMaxLineQuantity(store);
+		if (quantity > max) {
+			throw new RestApiException("400",
+					"Cart line quantity " + quantity + " exceeds the maximum of " + max);
+		}
+	}
+
+	private int cartMaxLineQuantity(MerchantStore store) {
+		try {
+			MerchantConfiguration configuration = merchantConfigurationService
+					.getMerchantConfiguration(Constants.CART_MAX_LINE_QUANTITY, store);
+			if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+				return Constants.DEFAULT_CART_MAX_LINE_QUANTITY;
+			}
+			return Integer.parseInt(configuration.getValue().trim());
+		} catch (ServiceException | NumberFormatException e) {
+			LOG.warn("CART_MAX_LINE_QUANTITY for store {} is missing or not a whole number, using {}",
+					store.getCode(), Constants.DEFAULT_CART_MAX_LINE_QUANTITY);
+			return Constants.DEFAULT_CART_MAX_LINE_QUANTITY;
+		}
+	}
