+	/**
+	 * A line may hold at most the store's CART_MAX_LINE_QUANTITY (default 99).
+	 * Quantity 0 is left to the caller: it removes a line and is not a limit violation.
+	 * Read on each call so a configuration change applies without a restart.
+	 */
+	private void assertLineQuantity(long quantity, MerchantStore store) throws Exception {
+		if (quantity <= 0) {
+			return;
+		}
+		int max = maxLineQuantity(store);
+		if (quantity > max) {
+			throw new RestApiException("400", "A cart line cannot contain more than " + max + " units");
+		}
+	}
+
+	private int maxLineQuantity(MerchantStore store) throws ServiceException {
+		MerchantConfiguration configuration = merchantConfigurationService
+				.getMerchantConfiguration(Constants.CART_MAX_LINE_QUANTITY, store);
+		if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+			return Constants.DEFAULT_CART_MAX_LINE_QUANTITY;
+		}
+		try {
+			int parsed = Integer.parseInt(configuration.getValue().trim());
+			if (parsed < 0) {
+				return Constants.DEFAULT_CART_MAX_LINE_QUANTITY;
+			}
+			return parsed;
+		} catch (NumberFormatException e) {
+			return Constants.DEFAULT_CART_MAX_LINE_QUANTITY;
+		}
+	}
+
 	private String uniqueShoppingCartCode() {
 		return UUID.randomUUID().toString().replaceAll("-", "");
