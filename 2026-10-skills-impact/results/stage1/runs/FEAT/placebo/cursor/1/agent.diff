+	/**
+	 * A line may hold at most N units. N is the store merchant configuration
+	 * CART_MAX_LINE_QUANTITY, read on each call. When the key is absent, N is 99.
+	 * Quantity 0 removes a line and is not limited.
+	 */
+	private void assertLineQuantityWithinLimit(int quantity, MerchantStore store) {
+		if (quantity <= 0) {
+			return;
+		}
+		int max = cartMaxLineQuantity(store);
+		if (quantity > max) {
+			throw new RestApiException("400",
+					"Cart line quantity " + quantity + " exceeds the maximum of " + max);
+		}
+	}
+
+	private int cartMaxLineQuantity(MerchantStore store) {
+		try {
+			MerchantConfiguration configuration = merchantConfigurationService
+					.getMerchantConfiguration(CART_MAX_LINE_QUANTITY, store);
+			if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+				return DEFAULT_CART_MAX_LINE_QUANTITY;
+			}
+			return Integer.parseInt(configuration.getValue().trim());
+		} catch (ServiceException e) {
+			throw new ServiceRuntimeException("Cannot read " + CART_MAX_LINE_QUANTITY, e);
+		} catch (NumberFormatException e) {
+			throw new RestApiException("400",
+					CART_MAX_LINE_QUANTITY + " must be a whole number");
+		}
+	}
+
