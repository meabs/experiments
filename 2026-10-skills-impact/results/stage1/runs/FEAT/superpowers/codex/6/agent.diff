+package com.salesmanager.shop.store.controller.shoppingCart.facade;
+
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.system.MerchantConfigurationService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.system.MerchantConfiguration;
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+
+@Service
+public class ShoppingCartQuantityValidator {
+
+    private static final int DEFAULT_MAX_LINE_QUANTITY = 99;
+
+    private final MerchantConfigurationService merchantConfigurationService;
+
+    @Inject
+    public ShoppingCartQuantityValidator(MerchantConfigurationService merchantConfigurationService) {
+        this.merchantConfigurationService = merchantConfigurationService;
+    }
+
+    public void validate(MerchantStore store, PersistableShoppingCartItem item) throws ServiceException {
+        validate(store, List.of(item));
+    }
+
+    public void validate(MerchantStore store, List<PersistableShoppingCartItem> items) throws ServiceException {
+        int maxLineQuantity = getMaxLineQuantity(store);
+        for (PersistableShoppingCartItem item : items) {
+            if (item != null && item.getQuantity() > maxLineQuantity) {
+                throw new IllegalArgumentException("Cart line quantity for product [" + item.getProduct()
+                        + "] cannot exceed " + maxLineQuantity);
+            }
+        }
+    }
+
+    private int getMaxLineQuantity(MerchantStore store) throws ServiceException {
+        MerchantConfiguration configuration = merchantConfigurationService
+                .getMerchantConfiguration(Constants.CART_MAX_LINE_QUANTITY, store);
+        if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+            return DEFAULT_MAX_LINE_QUANTITY;
+        }
+
+        try {
+            int configuredLimit = Integer.parseInt(configuration.getValue().trim());
+            return configuredLimit >= 0 ? configuredLimit : DEFAULT_MAX_LINE_QUANTITY;
+        } catch (NumberFormatException e) {
+            return DEFAULT_MAX_LINE_QUANTITY;
+        }
+    }
+}
