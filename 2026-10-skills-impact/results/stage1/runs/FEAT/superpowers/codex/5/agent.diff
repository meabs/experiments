+package com.salesmanager.shop.store.controller.shoppingCart.facade;
+
+import javax.inject.Inject;
+
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.system.MerchantConfigurationService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.system.MerchantConfiguration;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+
+@Service
+public class ShoppingCartLineQuantityValidator {
+
+    public static final String CONFIGURATION_KEY = "CART_MAX_LINE_QUANTITY";
+    private static final int DEFAULT_MAXIMUM = 99;
+
+    private final MerchantConfigurationService merchantConfigurationService;
+
+    @Inject
+    public ShoppingCartLineQuantityValidator(MerchantConfigurationService merchantConfigurationService) {
+        this.merchantConfigurationService = merchantConfigurationService;
+    }
+
+    public int getMaximum(MerchantStore store) {
+        try {
+            MerchantConfiguration configuration = merchantConfigurationService
+                    .getMerchantConfiguration(CONFIGURATION_KEY, store);
+            if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+                return DEFAULT_MAXIMUM;
+            }
+
+            int maximum = Integer.parseInt(configuration.getValue().trim());
+            if (maximum < 0) {
+                throw new NumberFormatException("negative value");
+            }
+            return maximum;
+        } catch (ServiceException | NumberFormatException exception) {
+            throw new ServiceRuntimeException("Invalid cart line quantity configuration", exception);
+        }
+    }
+
+    public void validate(long quantity, MerchantStore store) {
+        if (quantity == 0) {
+            return;
+        }
+
+        int maximum = getMaximum(store);
+        if (quantity < 0 || quantity > maximum) {
+            throw new ServiceRuntimeException(
+                    "Cart line quantity must be between 0 and " + maximum,
+                    new IllegalArgumentException("Requested quantity: " + quantity));
+        }
+    }
+}
