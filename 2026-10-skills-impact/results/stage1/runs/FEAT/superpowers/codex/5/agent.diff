+package com.salesmanager.shop.store.controller.shoppingCart.facade;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.mockito.Mockito.doThrow;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.verifyNoInteractions;
+import static org.mockito.Mockito.when;
+
+import java.util.Collections;
+import java.util.Arrays;
+import java.util.Date;
+
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.shoppingcart.ShoppingCartCalculationService;
+import com.salesmanager.core.business.services.shoppingcart.ShoppingCartService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+
+class ShoppingCartFacadeQuantityValidationTest {
+
+    private final ShoppingCartService shoppingCartService = mock(ShoppingCartService.class);
+    private final ShoppingCartLineQuantityValidator quantityValidator = mock(ShoppingCartLineQuantityValidator.class);
+    private final ShoppingCartFacadeImpl facade = new ShoppingCartFacadeImpl();
+    private final MerchantStore store = new MerchantStore(1, "store", "Store");
+
+    @BeforeEach
+    void setUp() {
+        ReflectionTestUtils.setField(facade, "shoppingCartService", shoppingCartService);
+        ReflectionTestUtils.setField(facade, "shoppingCartCalculationService", mock(ShoppingCartCalculationService.class));
+        ReflectionTestUtils.setField(facade, "shoppingCartLineQuantityValidator", quantityValidator);
+        ReflectionTestUtils.setField(facade, "productService", mock(ProductService.class));
+    }
+
+    @Test
+    void rejectsPutBeforeReadingOrChangingTheCart() throws Exception {
+        PersistableShoppingCartItem item = item(4);
+        rejectQuantity(4);
+
+        assertThrows(ServiceRuntimeException.class, () -> facade.modifyCart("cart", item, store, mock(Language.class)));
+
+        verifyNoInteractions(shoppingCartService);
+    }
+
+    @Test
+    void rejectsMultiUpdateBeforeReadingOrChangingTheCart() throws Exception {
+        rejectQuantity(4);
+
+        assertThrows(ServiceRuntimeException.class, () -> facade.modifyCartMulti(
+                "cart", Arrays.asList(item(1), item(4)), store, mock(Language.class)));
+
+        verifyNoInteractions(shoppingCartService);
+    }
+
+    @Test
+    void rejectsAnAddThatWouldPutAnExistingLineAboveTheMaximumWithoutChangingIt() throws Exception {
+        Product product = product();
+        ShoppingCart cart = new ShoppingCart();
+        cart.setId(1L);
+        cart.setMerchantStore(store);
+        cart.setShoppingCartCode("cart");
+
+        com.salesmanager.core.model.shoppingcart.ShoppingCartItem existingItem =
+                new com.salesmanager.core.model.shoppingcart.ShoppingCartItem(product);
+        existingItem.setQuantity(2);
+        cart.getLineItems().add(existingItem);
+
+        Customer customer = mock(Customer.class);
+        when(customer.getId()).thenReturn(1L);
+        when(shoppingCartService.getShoppingCart(customer, store)).thenReturn(cart);
+        when(shoppingCartService.populateShoppingCartItem(product, store))
+                .thenReturn(new com.salesmanager.core.model.shoppingcart.ShoppingCartItem(product));
+        when(shoppingCartService.getById(1L, store)).thenReturn(cart);
+        when(((ProductService) ReflectionTestUtils.getField(facade, "productService"))
+                .getBySku("sku", store, store.getDefaultLanguage())).thenReturn(product);
+        rejectQuantity(4);
+
+        assertThrows(ServiceRuntimeException.class,
+                () -> facade.addToCart(customer, item(2), store, mock(Language.class)));
+
+        assertEquals(2, existingItem.getQuantity());
+        verify(shoppingCartService, never()).save(org.mockito.ArgumentMatchers.any(ShoppingCart.class));
+    }
+
+    private Product product() {
+        Product product = new Product();
+        product.setId(1L);
+        product.setSku("sku");
+        product.setMerchantStore(store);
+        product.setAvailable(true);
+        product.setDateAvailable(new Date(0));
+        ProductAvailability availability = new ProductAvailability();
+        availability.setProductQuantity(10);
+        product.setAvailabilities(Collections.singleton(availability));
+        return product;
+    }
+
+    private void rejectQuantity(int quantity) {
+        doThrow(new ServiceRuntimeException("Cart line quantity is too high",
+                new IllegalArgumentException("quantity")))
+                .when(quantityValidator).validate(quantity, store);
+    }
+
+    private PersistableShoppingCartItem item(int quantity) {
+        PersistableShoppingCartItem item = new PersistableShoppingCartItem();
+        item.setProduct("sku");
+        item.setQuantity(quantity);
+        return item;
+    }
+}
