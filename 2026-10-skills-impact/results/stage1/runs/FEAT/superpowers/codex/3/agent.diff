+package com.salesmanager.shop.store.controller.shoppingCart;
+
+import javax.inject.Inject;
+
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.system.MerchantConfigurationService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.system.MerchantConfiguration;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+@Service
+public class CartLineQuantityValidator {
+
+    static final String CART_MAX_LINE_QUANTITY = "CART_MAX_LINE_QUANTITY";
+    static final int DEFAULT_MAX_LINE_QUANTITY = 99;
+
+    private final MerchantConfigurationService merchantConfigurationService;
+
+    @Inject
+    public CartLineQuantityValidator(MerchantConfigurationService merchantConfigurationService) {
+        this.merchantConfigurationService = merchantConfigurationService;
+    }
+
+    public int getMaxLineQuantity(MerchantStore store) throws ServiceException {
+        MerchantConfiguration configuration = merchantConfigurationService
+                .getMerchantConfiguration(CART_MAX_LINE_QUANTITY, store);
+        if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+            return DEFAULT_MAX_LINE_QUANTITY;
+        }
+
+        try {
+            int maxQuantity = Integer.parseInt(configuration.getValue().trim());
+            if (maxQuantity < 0) {
+                throw new NumberFormatException("negative quantity");
+            }
+            return maxQuantity;
+        } catch (NumberFormatException e) {
+            throw new RestApiException("Invalid " + CART_MAX_LINE_QUANTITY + " configuration");
+        }
+    }
+
+    public void validate(long quantity, MerchantStore store) throws ServiceException {
+        if (quantity < 0) {
+            throw new CartLineQuantityInvalidException();
+        }
+        if (quantity == 0) {
+            return;
+        }
+
+        int maxQuantity = getMaxLineQuantity(store);
+        if (quantity > maxQuantity) {
+            throw new CartLineQuantityExceededException(maxQuantity);
+        }
+    }
+
+    public static class CartLineQuantityExceededException extends RestApiException {
+
+        private static final long serialVersionUID = 1L;
+
+        CartLineQuantityExceededException(int maxQuantity) {
+            super("Cart line quantity cannot exceed " + maxQuantity);
+        }
+    }
+
+    public static class CartLineQuantityInvalidException extends RestApiException {
+
+        private static final long serialVersionUID = 1L;
+
+        CartLineQuantityInvalidException() {
+            super("Cart line quantity cannot be negative");
+        }
+    }
+}
