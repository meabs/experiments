+package com.salesmanager.test.shop.cart;
+
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.mockito.Mockito.doThrow;
+import static org.mockito.Mockito.doNothing;
+import static org.mockito.Mockito.verifyNoInteractions;
+
+import java.util.Arrays;
+
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.api.extension.ExtendWith;
+import org.mockito.InjectMocks;
+import org.mockito.Mock;
+import org.mockito.junit.jupiter.MockitoExtension;
+
+import com.salesmanager.core.business.services.shoppingcart.ShoppingCartService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.controller.shoppingCart.CartLineQuantityValidator;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacadeImpl;
+
+@ExtendWith(MockitoExtension.class)
+class ShoppingCartFacadeQuantityValidationTest {
+
+    @Mock
+    private ShoppingCartService shoppingCartService;
+
+    @Mock
+    private CartLineQuantityValidator cartLineQuantityValidator;
+
+    @InjectMocks
+    private ShoppingCartFacadeImpl shoppingCartFacade;
+
+    private final MerchantStore store = new MerchantStore(1, "store", "Store");
+
+    @Test
+    void rejectsAnOverLimitSingleUpdateBeforeLoadingTheCart() throws Exception {
+        doThrow(new RestApiException("Cart line quantity cannot exceed 99"))
+                .when(cartLineQuantityValidator).validate(100, store);
+
+        PersistableShoppingCartItem item = item("sku", 100);
+
+        assertThrows(RestApiException.class,
+                () -> shoppingCartFacade.modifyCart("cart-code", item, store, null));
+
+        verifyNoInteractions(shoppingCartService);
+    }
+
+    @Test
+    void rejectsEveryOverLimitMultiItemBeforeLoadingTheCart() throws Exception {
+        doNothing().when(cartLineQuantityValidator).validate(1, store);
+        doThrow(new RestApiException("Cart line quantity cannot exceed 99"))
+                .when(cartLineQuantityValidator).validate(100, store);
+
+        PersistableShoppingCartItem first = item("duplicate-sku", 1);
+        PersistableShoppingCartItem second = item("duplicate-sku", 100);
+
+        assertThrows(RestApiException.class,
+                () -> shoppingCartFacade.modifyCartMulti("cart-code", Arrays.asList(first, second), store, null));
+
+        verifyNoInteractions(shoppingCartService);
+    }
+
+    private PersistableShoppingCartItem item(String sku, int quantity) {
+        PersistableShoppingCartItem item = new PersistableShoppingCartItem();
+        item.setProduct(sku);
+        item.setQuantity(quantity);
+        return item;
+    }
+}
