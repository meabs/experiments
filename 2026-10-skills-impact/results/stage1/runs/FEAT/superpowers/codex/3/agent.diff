+package com.salesmanager.test.shop.cart;
+
+import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import org.junit.jupiter.api.Test;
+
+import com.salesmanager.core.business.services.system.MerchantConfigurationService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.system.MerchantConfiguration;
+import com.salesmanager.shop.store.controller.shoppingCart.CartLineQuantityValidator;
+
+class CartLineQuantityValidatorTest {
+
+    private final MerchantConfigurationService merchantConfigurationService = mock(MerchantConfigurationService.class);
+    private final MerchantStore store = new MerchantStore(1, "store", "Store");
+    private final CartLineQuantityValidator validator = new CartLineQuantityValidator(merchantConfigurationService);
+
+    @Test
+    void usesNinetyNineWhenConfigurationIsAbsent() throws Exception {
+        when(merchantConfigurationService.getMerchantConfiguration("CART_MAX_LINE_QUANTITY", store))
+                .thenReturn(null);
+
+        assertEquals(99, validator.getMaxLineQuantity(store));
+    }
+
+    @Test
+    void readsTheCurrentConfigurationOnEveryValidation() throws Exception {
+        MerchantConfiguration configuration = new MerchantConfiguration();
+        configuration.setKey("CART_MAX_LINE_QUANTITY");
+        configuration.setValue("4");
+        when(merchantConfigurationService.getMerchantConfiguration("CART_MAX_LINE_QUANTITY", store))
+                .thenReturn(configuration);
+
+        assertDoesNotThrow(() -> validator.validate(4, store));
+
+        configuration.setValue("2");
+
+        assertThrows(CartLineQuantityValidator.CartLineQuantityExceededException.class,
+                () -> validator.validate(3, store));
+    }
+
+    @Test
+    void allowsTheLimitAndZeroButRejectsQuantitiesAboveIt() throws Exception {
+        MerchantConfiguration configuration = new MerchantConfiguration();
+        configuration.setKey("CART_MAX_LINE_QUANTITY");
+        configuration.setValue("3");
+        when(merchantConfigurationService.getMerchantConfiguration("CART_MAX_LINE_QUANTITY", store))
+                .thenReturn(configuration);
+
+        assertDoesNotThrow(() -> validator.validate(0, store));
+        assertDoesNotThrow(() -> validator.validate(3, store));
+        assertThrows(CartLineQuantityValidator.CartLineQuantityExceededException.class,
+                () -> validator.validate(4, store));
+    }
+
+    @Test
+    void rejectsNegativeQuantities() throws Exception {
+        assertThrows(CartLineQuantityValidator.CartLineQuantityInvalidException.class,
+                () -> validator.validate(-1, store));
+    }
+}
