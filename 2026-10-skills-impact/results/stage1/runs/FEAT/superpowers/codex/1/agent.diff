+package com.salesmanager.shop.store.controller.shoppingCart;
+
+import javax.inject.Inject;
+
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.system.MerchantConfigurationService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+import com.salesmanager.core.model.system.MerchantConfiguration;
+import com.salesmanager.shop.model.shoppingcart.CartModificationException;
+
+@Service
+public class CartQuantityLimitService {
+
+    public static final String CART_MAX_LINE_QUANTITY = "CART_MAX_LINE_QUANTITY";
+    private static final int DEFAULT_MAX_LINE_QUANTITY = 99;
+
+    private final MerchantConfigurationService merchantConfigurationService;
+
+    @Inject
+    public CartQuantityLimitService(MerchantConfigurationService merchantConfigurationService) {
+        this.merchantConfigurationService = merchantConfigurationService;
+    }
+
+    public void validate(long quantity, MerchantStore store) throws ServiceException, CartModificationException {
+        if (quantity <= 0) {
+            return;
+        }
+
+        validateAgainstMaximum(quantity, getMaximum(store));
+    }
+
+    public void validateAddition(long quantity, String productSku, boolean hasAttributes, ShoppingCart cart,
+            MerchantStore store) throws ServiceException, CartModificationException {
+        if (quantity <= 0) {
+            return;
+        }
+
+        int maximum = getMaximum(store);
+        validateAgainstMaximum(quantity, maximum);
+
+        if (hasAttributes || cart == null || cart.getLineItems() == null) {
+            return;
+        }
+
+        for (ShoppingCartItem existingItem : cart.getLineItems()) {
+            if (StringUtils.equals(existingItem.getSku(), productSku)
+                    && (existingItem.getAttributes() == null || existingItem.getAttributes().isEmpty())) {
+                int existingQuantity = existingItem.getQuantity() == null ? 0 : existingItem.getQuantity();
+                if (existingQuantity > maximum || quantity > maximum - existingQuantity) {
+                    throw new CartModificationException(
+                            "Quantity must not exceed " + maximum + " units for a cart line");
+                }
+                break;
+            }
+        }
+    }
+
+    private void validateAgainstMaximum(long quantity, int maximum) throws CartModificationException {
+        if (quantity > maximum) {
+            throw new CartModificationException(
+                    "Quantity must not exceed " + maximum + " units for a cart line");
+        }
+    }
+
+    private int getMaximum(MerchantStore store) throws ServiceException {
+        MerchantConfiguration configuration = merchantConfigurationService
+                .getMerchantConfiguration(CART_MAX_LINE_QUANTITY, store);
+        if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+            return DEFAULT_MAX_LINE_QUANTITY;
+        }
+
+        try {
+            int maximum = Integer.parseInt(configuration.getValue().trim());
+            return maximum >= 0 ? maximum : DEFAULT_MAX_LINE_QUANTITY;
+        } catch (NumberFormatException e) {
+            return DEFAULT_MAX_LINE_QUANTITY;
+        }
+    }
+}
