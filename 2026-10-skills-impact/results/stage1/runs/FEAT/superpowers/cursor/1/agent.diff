+	/**
+	 * Reads CART_MAX_LINE_QUANTITY from the store on every call. Quantity 0 is a removal.
+	 */
+	private void assertLineQuantity(int quantity, MerchantStore store) {
+		CartMaxLineQuantity.rejectIfLineWouldExceed(quantity, maxLineQuantity(store));
+	}
+
+	private int maxLineQuantity(MerchantStore store) {
+		try {
+			MerchantConfiguration configuration = merchantConfigurationService
+					.getMerchantConfiguration(CartMaxLineQuantity.CONFIG_KEY, store);
+			if (configuration == null) {
+				return CartMaxLineQuantity.DEFAULT_MAX;
+			}
+			return CartMaxLineQuantity.resolve(configuration.getValue());
+		} catch (ServiceException e) {
+			throw new ServiceRuntimeException("Unable to read cart line quantity limit", e);
+		}
+	}
