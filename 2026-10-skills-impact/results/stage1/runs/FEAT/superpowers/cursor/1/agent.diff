+package com.salesmanager.shop.store.controller.shoppingCart;
+
+import org.apache.commons.lang3.StringUtils;
+
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+/**
+ * Per-store maximum units on one shopping-cart line.
+ * The value is read from merchant configuration on each check so a change applies without a restart.
+ */
+public final class CartMaxLineQuantity {
+
+	public static final String CONFIG_KEY = "CART_MAX_LINE_QUANTITY";
+	public static final int DEFAULT_MAX = 99;
+
+	private CartMaxLineQuantity() {
+	}
+
+	public static int resolve(String configuredValue) {
+		if (StringUtils.isBlank(configuredValue)) {
+			return DEFAULT_MAX;
+		}
+		try {
+			return Integer.parseInt(configuredValue.trim());
+		} catch (NumberFormatException ex) {
+			return DEFAULT_MAX;
+		}
+	}
+
+	/**
+	 * A quantity of 0 removes the line and is always allowed.
+	 * A positive quantity above {@code max} is rejected.
+	 */
+	public static void rejectIfLineWouldExceed(int quantity, int max) {
+		if (quantity > 0 && quantity > max) {
+			throw new RestApiException("400",
+					"Cart line quantity " + quantity + " exceeds the maximum of " + max);
+		}
+	}
+}
