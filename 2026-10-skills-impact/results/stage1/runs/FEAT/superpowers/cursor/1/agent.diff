+package com.salesmanager.shop.store.controller.shoppingCart;
+
+import org.junit.Test;
+
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.fail;
+
+public class CartMaxLineQuantityTest {
+
+	@Test
+	public void missingConfigurationDefaultsTo99() {
+		assertEquals(99, CartMaxLineQuantity.resolve(null));
+		assertEquals(99, CartMaxLineQuantity.resolve("  "));
+	}
+
+	@Test
+	public void readsWholeNumberFromConfiguration() {
+		assertEquals(5, CartMaxLineQuantity.resolve("5"));
+		assertEquals(12, CartMaxLineQuantity.resolve(" 12 "));
+	}
+
+	@Test
+	public void quantityAboveMaxIsRejected() {
+		try {
+			CartMaxLineQuantity.rejectIfLineWouldExceed(100, 99);
+			fail("expected rejection");
+		} catch (RestApiException expected) {
+			assertEquals("400", expected.getErrorCode());
+		}
+	}
+
+	@Test
+	public void quantityAtMaxIsAllowed() {
+		CartMaxLineQuantity.rejectIfLineWouldExceed(99, 99);
+	}
+
+	@Test
+	public void zeroQuantityIsRemovalAndIsAllowed() {
+		CartMaxLineQuantity.rejectIfLineWouldExceed(0, 99);
+		CartMaxLineQuantity.rejectIfLineWouldExceed(0, 1);
+	}
+}
