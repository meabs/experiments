+package com.salesmanager.shop.store.controller.shoppingCart;
+
+import org.junit.Test;
+
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+public class CartLineQuantityLimitTest {
+
+	@Test
+	public void missingConfigurationDefaultsTo99() {
+		org.junit.Assert.assertEquals(99, CartLineQuantityLimit.maxFrom(null));
+		org.junit.Assert.assertEquals(99, CartLineQuantityLimit.maxFrom("  "));
+	}
+
+	@Test
+	public void readsWholeNumberFromConfiguration() {
+		org.junit.Assert.assertEquals(5, CartLineQuantityLimit.maxFrom("5"));
+		org.junit.Assert.assertEquals(12, CartLineQuantityLimit.maxFrom(" 12 "));
+	}
+
+	@Test
+	public void quantityZeroIsAllowed() {
+		CartLineQuantityLimit.rejectIfAbove(0, 5);
+	}
+
+	@Test
+	public void quantityAtLimitIsAllowed() {
+		CartLineQuantityLimit.rejectIfAbove(5, 5);
+	}
+
+	@Test(expected = RestApiException.class)
+	public void quantityAboveLimitIsRejected() {
+		CartLineQuantityLimit.rejectIfAbove(6, 5);
+	}
+}
