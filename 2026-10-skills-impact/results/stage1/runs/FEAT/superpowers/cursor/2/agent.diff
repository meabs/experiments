+package com.salesmanager.shop.store.controller.shoppingCart;
+
+import org.apache.commons.lang3.StringUtils;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.system.MerchantConfigurationService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.system.MerchantConfiguration;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+
+/**
+ * Per-store maximum units on one shopping-cart line.
+ * Read from merchant configuration on each call so a change applies without a restart.
+ */
+public final class CartLineQuantityLimit {
+
+	public static final String CONFIG_KEY = "CART_MAX_LINE_QUANTITY";
+	public static final int DEFAULT_MAX = 99;
+
+	private CartLineQuantityLimit() {
+	}
+
+	public static int maxFrom(String configuredValue) {
+		if (StringUtils.isBlank(configuredValue)) {
+			return DEFAULT_MAX;
+		}
+		return Integer.parseInt(configuredValue.trim());
+	}
+
+	public static int maxFor(MerchantStore store, MerchantConfigurationService merchantConfigurationService) {
+		MerchantConfiguration configuration;
+		try {
+			configuration = merchantConfigurationService.getMerchantConfiguration(CONFIG_KEY, store);
+		} catch (ServiceException e) {
+			throw new ServiceRuntimeException("Cannot read " + CONFIG_KEY, e);
+		}
+		if (configuration == null) {
+			return DEFAULT_MAX;
+		}
+		return maxFrom(configuration.getValue());
+	}
+
+	/**
+	 * Quantity 0 is left alone: callers use it to remove a line.
+	 */
+	public static void rejectIfAbove(int quantity, int max) {
+		if (quantity <= 0) {
+			return;
+		}
+		if (quantity > max) {
+			throw new RestApiException("400",
+					"A cart line cannot contain more than " + max + " units");
+		}
+	}
+}
