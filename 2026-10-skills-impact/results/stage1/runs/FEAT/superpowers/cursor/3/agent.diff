+package com.salesmanager.shop.store.controller.shoppingCart;
+
+import javax.inject.Inject;
+
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.stereotype.Component;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.system.MerchantConfigurationService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.system.MerchantConfiguration;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+
+/**
+ * Per-store cap on units in one cart line. Read on each call so a configuration
+ * change applies without a restart.
+ */
+@Component
+public class CartLineQuantityLimit {
+
+	public static final String KEY = "CART_MAX_LINE_QUANTITY";
+
+	public static final int DEFAULT_MAX = 99;
+
+	private final MerchantConfigurationService merchantConfigurationService;
+
+	@Inject
+	public CartLineQuantityLimit(MerchantConfigurationService merchantConfigurationService) {
+		this.merchantConfigurationService = merchantConfigurationService;
+	}
+
+	public int maxFor(MerchantStore store) {
+		try {
+			MerchantConfiguration configuration = merchantConfigurationService.getMerchantConfiguration(KEY, store);
+			if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+				return DEFAULT_MAX;
+			}
+			return Integer.parseInt(configuration.getValue().trim());
+		} catch (NumberFormatException e) {
+			return DEFAULT_MAX;
+		} catch (ServiceException e) {
+			throw new ServiceRuntimeException("Cannot read cart line quantity limit", e);
+		}
+	}
+
+	/**
+	 * Quantity 0 is a line removal and is always allowed.
+	 */
+	public void rejectIfAbove(MerchantStore store, long quantity) {
+		if (quantity <= 0) {
+			return;
+		}
+		int max = maxFor(store);
+		if (quantity > max) {
+			throw new RestApiException("Cart line quantity " + quantity + " exceeds the maximum of " + max);
+		}
+	}
+}
