+		configuration.value = "2";
+		CartLineQuantityLimit limit = new CartLineQuantityLimit(configuration);
+		MerchantStore store = new MerchantStore();
+
+		assertEquals(2, limit.maxFor(store));
+		configuration.value = "8";
+		assertEquals(8, limit.maxFor(store));
+	}
