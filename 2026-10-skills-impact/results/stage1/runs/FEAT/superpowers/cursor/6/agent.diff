+
+	@Test
+	public void usesNinetyNineWhenStoreHasNoConfiguration() throws Exception {
+		CartLineQuantityLimit limit = new CartLineQuantityLimit(configuration(null));
+		MerchantStore store = new MerchantStore();
+
+		assertEquals(99, limit.maxFor(store));
+		limit.rejectIfAboveMax(99, store);
+	}
+
+	@Test
+	public void rejectsALineAboveTheConfiguredMaximum() throws Exception {
+		CartLineQuantityLimit limit = new CartLineQuantityLimit(configuration("5"));
+		MerchantStore store = new MerchantStore();
+
+		assertEquals(5, limit.maxFor(store));
+		limit.rejectIfAboveMax(5, store);
+		try {
+			limit.rejectIfAboveMax(6, store);
+			fail("quantity above the store maximum must be rejected");
+		} catch (RestApiException expected) {
+			assertEquals("Cart line quantity 6 exceeds the maximum of 5", expected.getErrorMessage());
+		}
+	}
