+	/**
+	 * Quantity that will be stored on the matching cart line. Adding the same
+	 * product without attributes increases the existing line. A quantity of 0 is
+	 * left unchanged so removal keeps its current meaning.
+	 */
+	private int resultingLineQuantity(ShoppingCart cartModel,
+			com.salesmanager.core.model.shoppingcart.ShoppingCartItem incoming) {
+		if (cartModel.getLineItems() != null && CollectionUtils.isEmpty(incoming.getAttributes())
+				&& !incoming.isProductVirtual()) {
+			for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem existing : cartModel.getLineItems()) {
+				if (existing.getProduct() != null && incoming.getProduct() != null
+						&& existing.getProduct().getId().longValue() == incoming.getProduct().getId().longValue()
+						&& CollectionUtils.isEmpty(existing.getAttributes())) {
+					return existing.getQuantity() + incoming.getQuantity();
+				}
+			}
+		}
+		return incoming.getQuantity();
+	}
+
