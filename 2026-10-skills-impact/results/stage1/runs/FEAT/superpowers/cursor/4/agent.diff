+package com.salesmanager.shop.store.controller.shoppingCart;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.fail;
+import static org.mockito.Mockito.when;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.mockito.Mockito;
+
+import com.salesmanager.core.business.services.system.MerchantConfigurationService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.system.MerchantConfiguration;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+public class CartLineQuantityLimitTest {
+
+	private MerchantConfigurationService merchantConfigurationService;
+	private CartLineQuantityLimit limit;
+	private MerchantStore store;
+
+	@Before
+	public void setUp() {
+		merchantConfigurationService = Mockito.mock(MerchantConfigurationService.class);
+		limit = new CartLineQuantityLimit(merchantConfigurationService);
+		store = new MerchantStore();
+		store.setId(1);
+	}
+
+	@Test
+	public void defaultsTo99WhenStoreHasNoConfiguration() throws Exception {
+		when(merchantConfigurationService.getMerchantConfiguration(CartLineQuantityLimit.CONFIG_KEY, store))
+				.thenReturn(null);
+
+		assertEquals(99, limit.maxUnits(store));
+	}
+
+	@Test
+	public void readsWholeNumberFromMerchantConfiguration() throws Exception {
+		MerchantConfiguration configuration = new MerchantConfiguration();
+		configuration.setKey(CartLineQuantityLimit.CONFIG_KEY);
+		configuration.setValue("5");
+		when(merchantConfigurationService.getMerchantConfiguration(CartLineQuantityLimit.CONFIG_KEY, store))
+				.thenReturn(configuration);
+
+		assertEquals(5, limit.maxUnits(store));
+	}
+
+	@Test
+	public void rejectsALineAboveTheConfiguredMaximum() throws Exception {
+		MerchantConfiguration configuration = new MerchantConfiguration();
+		configuration.setValue("5");
+		when(merchantConfigurationService.getMerchantConfiguration(CartLineQuantityLimit.CONFIG_KEY, store))
+				.thenReturn(configuration);
+
+		try {
+			limit.assertAllowed(6, store);
+			fail("expected rejection");
+		} catch (RestApiException expected) {
+			assertEquals("400", expected.getErrorCode());
+		}
+	}
+
+	@Test
+	public void allowsTheMaximumAndARemovalQuantity() throws Exception {
+		when(merchantConfigurationService.getMerchantConfiguration(CartLineQuantityLimit.CONFIG_KEY, store))
+				.thenReturn(null);
+
+		limit.assertAllowed(99, store);
+		limit.assertAllowed(0, store);
+	}
+}
