+	private int getCartMaxLineQuantity(MerchantStore store) {
+		try {
+			MerchantConfiguration configuration = merchantConfigurationService
+					.getMerchantConfiguration(Constants.CART_MAX_LINE_QUANTITY, store);
+			if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+				return 99;
+			}
+
+			int maximumQuantity = Integer.parseInt(configuration.getValue().trim());
+			if (maximumQuantity < 0) {
+				throw new NumberFormatException("negative quantity limit");
+			}
+			return maximumQuantity;
+		} catch (NumberFormatException e) {
+			throw new ServiceRuntimeException("Invalid " + Constants.CART_MAX_LINE_QUANTITY + " configuration", e);
+		} catch (ServiceException e) {
+			throw new ServiceRuntimeException("Unable to read " + Constants.CART_MAX_LINE_QUANTITY + " configuration", e);
+		}
+	}
+
+	private void validateQuantity(long quantity, int maximumQuantity) {
+		if (quantity > maximumQuantity) {
+			throw new CartQuantityExceededException(quantity, maximumQuantity);
+		}
+	}
+
