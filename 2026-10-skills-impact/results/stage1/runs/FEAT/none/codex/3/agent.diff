+public class CartQuantityExceededException extends ServiceRuntimeException {
+
+    private static final long serialVersionUID = 1L;
+
+    public CartQuantityExceededException(long quantity, int maximum) {
+        super("400", "Cart line quantity " + quantity + " exceeds the maximum of " + maximum,
+                new IllegalArgumentException("Cart line quantity exceeds the configured maximum"));
+    }
+}
