+	private void validateCartLineQuantity(int quantity, MerchantStore store) {
+		long maxQuantity = getCartMaxLineQuantity(store);
+		if (quantity > maxQuantity) {
+			throw new RestApiException("400", "Cart line quantity cannot exceed "
+					+ maxQuantity + " units");
+		}
+	}
+
+	private void validateCartLineQuantity(ShoppingCart cart, com.salesmanager.core.model.shoppingcart.ShoppingCartItem item,
+			int quantity, boolean attributesEmpty, MerchantStore store) {
+		long maxQuantity = getCartMaxLineQuantity(store);
+		long resultingQuantity = quantity;
+		if (quantity > 0 && attributesEmpty && !item.isProductVirtual() && cart != null
+				&& CollectionUtils.isNotEmpty(cart.getLineItems())) {
+			for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem existingItem : cart.getLineItems()) {
+				if (existingItem.getProduct().getId().longValue() == item.getProduct().getId().longValue()
+						&& CollectionUtils.isEmpty(existingItem.getAttributes())) {
+					resultingQuantity += existingItem.getQuantity();
+					break;
+				}
+			}
+		}
+		if (resultingQuantity > maxQuantity) {
+			throw new RestApiException("400", "Cart line quantity cannot exceed " + maxQuantity + " units");
+		}
+	}
+
+	private long getCartMaxLineQuantity(MerchantStore store) {
+		try {
+			MerchantConfiguration configuration = merchantConfigurationService
+					.getMerchantConfiguration(Constants.CART_MAX_LINE_QUANTITY, store);
+			if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+				return DEFAULT_CART_MAX_LINE_QUANTITY;
+			}
+
+			String value = configuration.getValue().trim();
+			if (!value.matches("\\d+")) {
+				throw new ServiceRuntimeException("Invalid " + Constants.CART_MAX_LINE_QUANTITY
+						+ " configuration value: " + configuration.getValue());
+			}
+			long maxQuantity = Long.parseLong(value);
+			if (maxQuantity < 0) {
+				throw new ServiceRuntimeException("Invalid " + Constants.CART_MAX_LINE_QUANTITY
+						+ " configuration value: " + configuration.getValue());
+			}
+			return maxQuantity;
+		} catch (ServiceException e) {
+			throw new ServiceRuntimeException("Unable to read " + Constants.CART_MAX_LINE_QUANTITY
+					+ " configuration", e);
+		} catch (NumberFormatException e) {
+			throw new ServiceRuntimeException("Invalid " + Constants.CART_MAX_LINE_QUANTITY
+					+ " configuration value", e);
+		}
+	}
+
