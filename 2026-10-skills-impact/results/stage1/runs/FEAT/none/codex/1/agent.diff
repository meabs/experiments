+	/**
+	 * Read the setting for every cart mutation so an administrator change is
+	 * effective for the next request without an application restart.
+	 */
+	private long getCartMaxLineQuantity(MerchantStore store) {
+		try {
+			MerchantConfiguration configuration = merchantConfigurationService
+					.getMerchantConfiguration(CART_MAX_LINE_QUANTITY, store);
+			if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+				return DEFAULT_CART_MAX_LINE_QUANTITY;
+			}
+
+			long maxLineQuantity = Long.parseLong(configuration.getValue().trim());
+			if (maxLineQuantity < 0) {
+				throw new NumberFormatException("negative quantity limit");
+			}
+			return maxLineQuantity;
+		} catch (ServiceException e) {
+			throw new ServiceRuntimeException("500",
+					"Unable to read cart quantity configuration for store " + store.getId(), e);
+		} catch (NumberFormatException e) {
+			throw new ServiceRuntimeException("500",
+					"Invalid " + CART_MAX_LINE_QUANTITY + " configuration for store " + store.getId(), e);
+		}
+	}
+
+	private void validateCartLineQuantity(long quantity, long maxLineQuantity) {
+		if (quantity > maxLineQuantity) {
+			throw new CartLineQuantityExceededException(
+					"Cart line quantity " + quantity + " exceeds the maximum of " + maxLineQuantity);
+		}
+	}
+
