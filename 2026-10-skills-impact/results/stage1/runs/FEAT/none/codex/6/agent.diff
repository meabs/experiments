+	/**
+	 * Read the setting for every cart mutation so changes made in merchant
+	 * configuration are effective without restarting the application.
+	 */
+	private long getCartMaxLineQuantity(MerchantStore store) {
+		try {
+			MerchantConfiguration configuration = merchantConfigurationService
+					.getMerchantConfiguration(Constants.CART_MAX_LINE_QUANTITY, store);
+			if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+				return DEFAULT_CART_MAX_LINE_QUANTITY;
+			}
+
+			long maximumQuantity = Long.parseLong(configuration.getValue().trim());
+			if (maximumQuantity < 0) {
+				throw new NumberFormatException("The value must not be negative");
+			}
+			return maximumQuantity;
+		} catch (ServiceException e) {
+			throw new ServiceRuntimeException("Unable to read cart quantity limit", e);
+		} catch (NumberFormatException e) {
+			throw new ServiceRuntimeException("Invalid " + Constants.CART_MAX_LINE_QUANTITY
+					+ " merchant configuration", e);
+		}
+	}
+
+	private void validateQuantity(long quantity, long maximumQuantity) {
+		if (quantity > maximumQuantity) {
+			throw new CartQuantityLimitException(maximumQuantity);
+		}
+	}
+
 	private String uniqueShoppingCartCode() {
