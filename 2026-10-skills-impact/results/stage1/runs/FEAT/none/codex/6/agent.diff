+package com.salesmanager.shop.store.api.exception;
+
+/**
+ * Raised when a cart mutation would put a product line over the store limit.
+ */
+public class CartQuantityLimitException extends RestApiException {
+
+    private static final long serialVersionUID = 1L;
+
+    public CartQuantityLimitException(long maximumQuantity) {
+        super("400", "Cart line quantity cannot exceed " + maximumQuantity);
+    }
+}
