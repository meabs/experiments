+	/**
+	 * A line may hold at most N units. N is the store merchant configuration
+	 * CART_MAX_LINE_QUANTITY, read on each call so a change applies without a restart.
+	 * When the store has no such configuration, N is 99. Quantity 0 is a removal and is allowed.
+	 */
+	private void enforceLineQuantity(int quantity, MerchantStore store) {
+		if (quantity <= 0) {
+			return;
+		}
+		int max = cartMaxLineQuantity(store);
+		if (quantity > max) {
+			throw new RestApiException("400",
+					"Cart line quantity " + quantity + " exceeds the maximum of " + max);
+		}
+	}
+
+	private int cartMaxLineQuantity(MerchantStore store) {
+		MerchantConfiguration configuration;
+		try {
+			configuration = merchantConfigurationService.getMerchantConfiguration(Constants.CART_MAX_LINE_QUANTITY,
+					store);
+		} catch (ServiceException e) {
+			throw new ServiceRuntimeException("Cannot read cart line quantity limit", e);
+		}
+		if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+			return Constants.DEFAULT_CART_MAX_LINE_QUANTITY;
+		}
+		try {
+			return Integer.parseInt(configuration.getValue().trim());
+		} catch (NumberFormatException e) {
+			throw new RestApiException("400", "CART_MAX_LINE_QUANTITY must be a whole number");
+		}
+	}
+
