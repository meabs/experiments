+	/**
+	 * Reads CART_MAX_LINE_QUANTITY from the store on every call so a configuration
+	 * change applies without a restart. Missing or unreadable values use 99.
+	 */
+	int cartMaxLineQuantity(MerchantStore store) {
+		try {
+			MerchantConfiguration configuration = merchantConfigurationService
+					.getMerchantConfiguration(CART_MAX_LINE_QUANTITY, store);
+			if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+				return DEFAULT_CART_MAX_LINE_QUANTITY;
+			}
+			return Integer.parseInt(configuration.getValue().trim());
+		} catch (Exception e) {
+			LOG.warn("Cannot read " + CART_MAX_LINE_QUANTITY + " for store " + store.getCode() + ", using "
+					+ DEFAULT_CART_MAX_LINE_QUANTITY, e);
+			return DEFAULT_CART_MAX_LINE_QUANTITY;
+		}
+	}
+
+	private void assertLineQuantityAllowed(int quantity, MerchantStore store) {
+		if (quantity == 0) {
+			return;
+		}
+		int max = cartMaxLineQuantity(store);
+		if (quantity > max) {
+			throw new IllegalArgumentException(
+					"Cart line quantity " + quantity + " exceeds the maximum of " + max);
+		}
+	}
+
+	/**
+	 * Quantity the matching line will have after an add. A duplicate virtual
+	 * product is left unchanged. Attribute lines are stored separately.
+	 */
+	private int resultingAddQuantity(ShoppingCart cartModel, List<?> attributes, String sku, int quantity,
+			boolean productVirtual) {
+		if (quantity == 0 || cartModel.getLineItems() == null) {
+			return quantity;
+		}
+		if (CollectionUtils.isEmpty(attributes)) {
+			for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem cartItem : cartModel.getLineItems()) {
+				if (cartItem.getProduct() != null && sku != null && sku.equals(cartItem.getProduct().getSku())
+						&& CollectionUtils.isEmpty(cartItem.getAttributes())) {
+					if (productVirtual) {
+						return cartItem.getQuantity();
+					}
+					return cartItem.getQuantity() + quantity;
+				}
+			}
+		}
+		return quantity;
+	}
+
 	private String uniqueShoppingCartCode() {
 		return UUID.randomUUID().toString().replaceAll("-", "");
