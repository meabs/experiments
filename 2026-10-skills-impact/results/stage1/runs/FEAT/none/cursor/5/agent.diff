+	/**
+	 * A line may hold at most the store's CART_MAX_LINE_QUANTITY (default 99).
+	 * Zero and negative quantities are left to existing cart behaviour (zero removes a line).
+	 */
+	private void assertLineQuantityWithinLimit(int quantity, MerchantStore store) {
+		if (quantity <= 0) {
+			return;
+		}
+		int max = cartMaxLineQuantity(store);
+		if (quantity > max) {
+			String message = "Cart line quantity " + quantity + " exceeds the maximum of " + max;
+			throw new ServiceRuntimeException("400", message, new IllegalArgumentException(message));
+		}
+	}
+
+	private int cartMaxLineQuantity(MerchantStore store) {
+		try {
+			MerchantConfiguration configuration = merchantConfigurationService
+					.getMerchantConfiguration(CART_MAX_LINE_QUANTITY, store);
+			if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+				return DEFAULT_CART_MAX_LINE_QUANTITY;
+			}
+			return Integer.parseInt(configuration.getValue().trim());
+		} catch (NumberFormatException e) {
+			LOG.warn("CART_MAX_LINE_QUANTITY for store {} is not a whole number, using {}", store.getCode(),
+					DEFAULT_CART_MAX_LINE_QUANTITY);
+			return DEFAULT_CART_MAX_LINE_QUANTITY;
+		} catch (ServiceException e) {
+			throw new ServiceRuntimeException("400", "Unable to read cart line quantity limit", e);
+		}
+	}
+
