+	/**
+	 * Per-store line cap. Read on each call so a configuration change applies
+	 * without a restart. Missing or blank values use {@link #DEFAULT_CART_MAX_LINE_QUANTITY}.
+	 */
+	private int cartMaxLineQuantity(MerchantStore store) {
+		try {
+			MerchantConfiguration configuration = merchantConfigurationService
+					.getMerchantConfiguration(CART_MAX_LINE_QUANTITY, store);
+			if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+				return DEFAULT_CART_MAX_LINE_QUANTITY;
+			}
+			return Integer.parseInt(configuration.getValue().trim());
+		} catch (ServiceException | NumberFormatException e) {
+			LOG.warn("Cannot read " + CART_MAX_LINE_QUANTITY + " for store " + store.getCode()
+					+ ", using " + DEFAULT_CART_MAX_LINE_QUANTITY, e);
+			return DEFAULT_CART_MAX_LINE_QUANTITY;
+		}
+	}
+
+	private void rejectLineQuantityAboveMax(long quantity, int maxLineQuantity) {
+		if (quantity > maxLineQuantity) {
+			throw new IllegalArgumentException("Cart line quantity " + quantity
+					+ " exceeds the maximum of " + maxLineQuantity);
+		}
+	}
