+package com.salesmanager.shop.store.controller.shoppingCart.facade;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.fail;
+
+import org.junit.Test;
+
+public class CartLineQuantityLimitTest {
+
+	@Test
+	public void missingOrBlankConfigUsesDefault() {
+		assertEquals(99, CartLineQuantityLimit.parseMax(null));
+		assertEquals(99, CartLineQuantityLimit.parseMax(""));
+		assertEquals(99, CartLineQuantityLimit.parseMax("  "));
+		assertEquals(99, CartLineQuantityLimit.parseMax("nope"));
+		assertEquals(99, CartLineQuantityLimit.parseMax("-1"));
+	}
+
+	@Test
+	public void wholeNumberConfigIsTheCap() {
+		assertEquals(5, CartLineQuantityLimit.parseMax("5"));
+		assertEquals(0, CartLineQuantityLimit.parseMax(" 0 "));
+	}
+
+	@Test
+	public void zeroIsRemovalAndDoesNotExceed() {
+		CartLineQuantityLimit.rejectIfAbove(0, 99);
+		CartLineQuantityLimit.rejectIfAbove(99, 99);
+	}
+
+	@Test
+	public void quantityAboveCapIsRejected() {
+		try {
+			CartLineQuantityLimit.rejectIfAbove(100, 99);
+			fail("expected rejection");
+		} catch (IllegalArgumentException expected) {
+			assertEquals("Cart line quantity 100 exceeds the maximum of 99", expected.getMessage());
+		}
+	}
+
+	@Test
+	public void addMergesOntoTheExistingLine() {
+		assertEquals(12, CartLineQuantityLimit.resultingQuantity(10, 2, true, true));
+		assertEquals(2, CartLineQuantityLimit.resultingQuantity(null, 2, false, true));
+		assertEquals(10, CartLineQuantityLimit.resultingQuantity(10, 50, true, false));
+	}
+}
