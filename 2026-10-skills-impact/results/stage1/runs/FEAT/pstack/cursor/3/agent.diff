+package com.salesmanager.shop.store.controller.shoppingCart.facade;
+
+/**
+ * Per-store cap on how many units one cart line may hold.
+ * A quantity of 0 is a removal and is never over the cap.
+ */
+public final class CartLineQuantityLimit {
+
+	public static final int DEFAULT_MAX = 99;
+
+	private CartLineQuantityLimit() {
+	}
+
+	public static int parseMax(String configuredValue) {
+		if (configuredValue == null) {
+			return DEFAULT_MAX;
+		}
+		String trimmed = configuredValue.trim();
+		if (trimmed.isEmpty()) {
+			return DEFAULT_MAX;
+		}
+		try {
+			int parsed = Integer.parseInt(trimmed);
+			if (parsed < 0) {
+				return DEFAULT_MAX;
+			}
+			return parsed;
+		} catch (NumberFormatException ex) {
+			return DEFAULT_MAX;
+		}
+	}
+
+	/**
+	 * Quantity the line would hold after this request.
+	 * When the line merges, non-virtual products add the request onto the current quantity.
+	 */
+	public static int resultingQuantity(Integer currentQuantity, int requestedQuantity, boolean merges,
+			boolean quantityChanges) {
+		if (!merges) {
+			return requestedQuantity;
+		}
+		int current = currentQuantity == null ? 0 : currentQuantity;
+		if (!quantityChanges) {
+			return current;
+		}
+		long sum = (long) current + requestedQuantity;
+		if (sum > Integer.MAX_VALUE) {
+			return Integer.MAX_VALUE;
+		}
+		if (sum < Integer.MIN_VALUE) {
+			return Integer.MIN_VALUE;
+		}
+		return (int) sum;
+	}
+
+	public static void rejectIfAbove(int resultingQuantity, int max) {
+		if (resultingQuantity > max) {
+			throw new IllegalArgumentException(
+					"Cart line quantity " + resultingQuantity + " exceeds the maximum of " + max);
+		}
+	}
+}
