+package com.salesmanager.shop.store.controller.shoppingCart;
+
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+
+/**
+ * Per-store cap on units of one product on one cart line.
+ * A missing or non-numeric merchant configuration means {@link #DEFAULT_MAX}.
+ */
+public final class CartLineQuantityLimit {
+
+	public static final int DEFAULT_MAX = 99;
+
+	private final int maxUnits;
+
+	private CartLineQuantityLimit(int maxUnits) {
+		this.maxUnits = maxUnits;
+	}
+
+	public static CartLineQuantityLimit fromConfiguredValue(String raw) {
+		if (raw == null || raw.trim().isEmpty()) {
+			return new CartLineQuantityLimit(DEFAULT_MAX);
+		}
+		try {
+			return new CartLineQuantityLimit(Integer.parseInt(raw.trim()));
+		} catch (NumberFormatException ex) {
+			return new CartLineQuantityLimit(DEFAULT_MAX);
+		}
+	}
+
+	public int maxUnits() {
+		return maxUnits;
+	}
+
+	public void rejectIfAboveMax(long resultingUnits) {
+		if (resultingUnits <= 0) {
+			return;
+		}
+		if (resultingUnits > maxUnits) {
+			throw new ServiceRuntimeException("Cart line quantity " + resultingUnits
+					+ " exceeds the store maximum of " + maxUnits + " (" + Constants.CART_MAX_LINE_QUANTITY + ")");
+		}
+	}
+}
