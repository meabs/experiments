+package com.salesmanager.shop.store.controller.shoppingCart;
+
+import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import org.junit.jupiter.api.Test;
+
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+
+public class CartLineQuantityLimitTest {
+
+	@Test
+	public void missingConfigurationAllowsUpTo99() {
+		CartLineQuantityLimit limit = CartLineQuantityLimit.fromConfiguredValue(null);
+		assertEquals(99, limit.maxUnits());
+		assertDoesNotThrow(() -> limit.rejectIfAboveMax(99));
+		assertThrows(ServiceRuntimeException.class, () -> limit.rejectIfAboveMax(100));
+	}
+
+	@Test
+	public void blankOrNonNumericConfigurationUsesTheDefault() {
+		assertEquals(99, CartLineQuantityLimit.fromConfiguredValue("  ").maxUnits());
+		assertEquals(99, CartLineQuantityLimit.fromConfiguredValue("lots").maxUnits());
+	}
+
+	@Test
+	public void configuredWholeNumberIsTheCap() {
+		CartLineQuantityLimit limit = CartLineQuantityLimit.fromConfiguredValue(" 3 ");
+		assertEquals(3, limit.maxUnits());
+		assertDoesNotThrow(() -> limit.rejectIfAboveMax(3));
+		assertThrows(ServiceRuntimeException.class, () -> limit.rejectIfAboveMax(4));
+	}
+
+	@Test
+	public void zeroQuantityIsNotCapped() {
+		assertDoesNotThrow(() -> CartLineQuantityLimit.fromConfiguredValue("1").rejectIfAboveMax(0));
+	}
+}
