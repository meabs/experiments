+package com.salesmanager.shop.store.controller.shoppingCart;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Component;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.system.MerchantConfigurationService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.system.MerchantConfiguration;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+
+/**
+ * Per-store cap on units of one cart line. Read on each cart write so a
+ * configuration change applies without a restart.
+ */
+@Component
+public class CartLineQuantityLimits {
+
+	public static final String CONFIG_KEY = "CART_MAX_LINE_QUANTITY";
+
+	public static final int DEFAULT_MAX = 99;
+
+	private final MerchantConfigurationService merchantConfigurationService;
+
+	@Inject
+	public CartLineQuantityLimits(MerchantConfigurationService merchantConfigurationService) {
+		this.merchantConfigurationService = merchantConfigurationService;
+	}
+
+	public int maxFor(MerchantStore store) {
+		try {
+			MerchantConfiguration configuration = merchantConfigurationService.getMerchantConfiguration(CONFIG_KEY, store);
+			if (configuration == null) {
+				return DEFAULT_MAX;
+			}
+			return parse(configuration.getValue());
+		} catch (ServiceException e) {
+			throw new ServiceRuntimeException("Cannot read " + CONFIG_KEY, e);
+		}
+	}
+
+	/**
+	 * A missing or non-numeric value uses {@link #DEFAULT_MAX}. A stored whole number is used as-is.
+	 */
+	public static int parse(String raw) {
+		if (raw == null) {
+			return DEFAULT_MAX;
+		}
+		String trimmed = raw.trim();
+		if (trimmed.isEmpty()) {
+			return DEFAULT_MAX;
+		}
+		try {
+			return Integer.parseInt(trimmed);
+		} catch (NumberFormatException ex) {
+			return DEFAULT_MAX;
+		}
+	}
+
+	public void rejectIfAboveMax(MerchantStore store, int quantity) {
+		reject(maxFor(store), quantity);
+	}
+
+	public void reject(int maxUnits, int quantity) {
+		if (quantity > maxUnits) {
+			throw new RestApiException("400",
+					"Cart line quantity " + quantity + " exceeds the store maximum of " + maxUnits);
+		}
+	}
+}
