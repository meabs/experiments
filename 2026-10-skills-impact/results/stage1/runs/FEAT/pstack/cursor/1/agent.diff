+package com.salesmanager.shop.store.controller.shoppingCart;
+
+import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import org.junit.jupiter.api.Test;
+
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+public class CartLineQuantityLimitsTest {
+
+	@Test
+	public void missingOrNonNumericValueUsesDefault() {
+		assertEquals(CartLineQuantityLimits.DEFAULT_MAX, CartLineQuantityLimits.parse(null));
+		assertEquals(CartLineQuantityLimits.DEFAULT_MAX, CartLineQuantityLimits.parse("  "));
+		assertEquals(CartLineQuantityLimits.DEFAULT_MAX, CartLineQuantityLimits.parse("99.5"));
+		assertEquals(99, CartLineQuantityLimits.DEFAULT_MAX);
+	}
+
+	@Test
+	public void storedWholeNumberIsUsed() {
+		assertEquals(5, CartLineQuantityLimits.parse("5"));
+		assertEquals(5, CartLineQuantityLimits.parse(" 5 "));
+		assertEquals(0, CartLineQuantityLimits.parse("0"));
+	}
+
+	@Test
+	public void quantityAboveMaxIsRejectedAndZeroIsAllowed() {
+		CartLineQuantityLimits limits = new CartLineQuantityLimits(null);
+		assertDoesNotThrow(() -> limits.reject(99, 0));
+		assertDoesNotThrow(() -> limits.reject(99, 99));
+		assertThrows(RestApiException.class, () -> limits.reject(99, 100));
+		assertThrows(RestApiException.class, () -> limits.reject(3, 4));
+	}
+}
