+	private void enforceLineQuantity(long quantity, MerchantStore store) throws ServiceException {
+		if (quantity <= 0) {
+			return;
+		}
+		MerchantConfiguration configuration = merchantConfigurationService
+				.getMerchantConfiguration(CartLineQuantity.CONFIG_KEY, store);
+		String configured = configuration == null ? null : configuration.getValue();
+		CartLineQuantity.rejectIfAbove(quantity, CartLineQuantity.maxFromConfigurationValue(configured));
+	}
