+package com.salesmanager.test.shop.cart;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import org.junit.jupiter.api.Test;
+
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.controller.shoppingCart.CartLineQuantity;
+
+public class CartLineQuantityTest {
+
+	@Test
+	public void missingConfigurationUsesNinetyNine() {
+		assertEquals(99, CartLineQuantity.maxFromConfigurationValue(null));
+		assertEquals(99, CartLineQuantity.maxFromConfigurationValue("  "));
+		assertEquals(99, CartLineQuantity.maxFromConfigurationValue("nope"));
+	}
+
+	@Test
+	public void configuredWholeNumberIsTheLimit() {
+		assertEquals(3, CartLineQuantity.maxFromConfigurationValue(" 3 "));
+	}
+
+	@Test
+	public void quantityAboveTheLimitIsRejected() {
+		RestApiException ex = assertThrows(RestApiException.class, () -> CartLineQuantity.rejectIfAbove(4, 3));
+		assertEquals("400", ex.getErrorCode());
+	}
+
+	@Test
+	public void quantityAtTheLimitIsAllowed() {
+		CartLineQuantity.rejectIfAbove(3, 3);
+		CartLineQuantity.rejectIfAbove(0, 3);
+	}
+}
