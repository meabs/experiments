+package com.salesmanager.shop.store.controller.shoppingCart;
+
+import org.apache.commons.lang3.StringUtils;
+
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+/**
+ * Per-store cap on how many units one cart line may hold.
+ * A missing or blank configuration uses {@link #DEFAULT_MAX}.
+ * Quantity 0 is not a line size. Callers skip this check when the request removes the line.
+ */
+public final class CartLineQuantity {
+
+	public static final String CONFIG_KEY = "CART_MAX_LINE_QUANTITY";
+
+	public static final int DEFAULT_MAX = 99;
+
+	private CartLineQuantity() {
+	}
+
+	public static int maxFromConfigurationValue(String value) {
+		if (StringUtils.isBlank(value)) {
+			return DEFAULT_MAX;
+		}
+		try {
+			return Integer.parseInt(value.trim());
+		} catch (NumberFormatException ex) {
+			return DEFAULT_MAX;
+		}
+	}
+
+	public static void rejectIfAbove(long quantity, int max) {
+		if (quantity > max) {
+			throw new RestApiException("400",
+					"Cart line quantity " + quantity + " exceeds the maximum of " + max);
+		}
+	}
+}
