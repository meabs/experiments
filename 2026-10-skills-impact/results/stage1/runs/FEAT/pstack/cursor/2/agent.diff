+package com.salesmanager.shop.store.controller.shoppingCart;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import org.junit.jupiter.api.Test;
+
+public class CartLineQuantityPolicyTest {
+
+	@Test
+	public void missingConfigurationIs99() {
+		assertEquals(99, CartLineQuantityPolicy.maxOrDefault(null));
+		assertEquals(99, CartLineQuantityPolicy.maxOrDefault("  "));
+		assertEquals(99, CartLineQuantityPolicy.maxOrDefault("nope"));
+	}
+
+	@Test
+	public void configuredWholeNumberIsUsed() {
+		assertEquals(4, CartLineQuantityPolicy.maxOrDefault(" 4 "));
+	}
+
+	@Test
+	public void zeroRemovesAndDoesNotExceed() {
+		assertFalse(CartLineQuantityPolicy.exceeds(0, 99));
+		assertFalse(CartLineQuantityPolicy.exceeds(99, 99));
+		assertTrue(CartLineQuantityPolicy.exceeds(100, 99));
+	}
+
+	@Test
+	public void addSumsOntoTheExistingLine() {
+		assertEquals(12, CartLineQuantityPolicy.quantityAfterAdd(3, 9, false));
+		assertTrue(CartLineQuantityPolicy.exceeds(CartLineQuantityPolicy.quantityAfterAdd(2, 98, false), 99));
+	}
+
+	@Test
+	public void virtualDuplicateKeepsTheStoredQuantity() {
+		assertEquals(2, CartLineQuantityPolicy.quantityAfterAdd(50, 2, true));
+		assertFalse(CartLineQuantityPolicy.exceeds(CartLineQuantityPolicy.quantityAfterAdd(50, 2, true), 99));
+	}
+}
