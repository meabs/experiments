+package com.salesmanager.shop.store.controller.shoppingCart;
+
+/**
+ * Per-store cap on how many units one cart line may hold.
+ * A missing or unreadable configuration means {@link #DEFAULT_MAX}.
+ * Quantity 0 is a removal and is never over the cap.
+ */
+public final class CartLineQuantityPolicy {
+
+	public static final String CONFIG_KEY = "CART_MAX_LINE_QUANTITY";
+
+	public static final int DEFAULT_MAX = 99;
+
+	private CartLineQuantityPolicy() {
+	}
+
+	public static int maxOrDefault(String raw) {
+		if (raw == null || raw.trim().isEmpty()) {
+			return DEFAULT_MAX;
+		}
+		try {
+			return Integer.parseInt(raw.trim());
+		} catch (NumberFormatException ex) {
+			return DEFAULT_MAX;
+		}
+	}
+
+	public static boolean exceeds(long quantity, int max) {
+		return quantity != 0 && quantity > max;
+	}
+
+	/**
+	 * Quantity that will be stored for an add. When the product is already on the
+	 * cart without attributes, the request is added to the current line. A virtual
+	 * duplicate leaves the line quantity unchanged.
+	 */
+	public static long quantityAfterAdd(int requested, Integer existingQuantity, boolean virtualDuplicate) {
+		if (virtualDuplicate) {
+			return existingQuantity == null ? requested : existingQuantity;
+		}
+		if (existingQuantity == null) {
+			return requested;
+		}
+		return (long) existingQuantity + requested;
+	}
+}
