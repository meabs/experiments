+package com.salesmanager.shop.store.controller.shoppingCart;
+
+import org.apache.commons.lang3.StringUtils;
+
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+/**
+ * Per-store maximum units on one cart line. Missing configuration means {@link #DEFAULT_MAX}.
+ * A quantity of 0 is not a line size. Callers still use it to remove the line.
+ */
+public final class CartLineQuantityLimit {
+
+	public static final int DEFAULT_MAX = 99;
+
+	private CartLineQuantityLimit() {
+	}
+
+	public static int parse(String configuredValue) {
+		if (StringUtils.isBlank(configuredValue)) {
+			return DEFAULT_MAX;
+		}
+		try {
+			return Integer.parseInt(configuredValue.trim());
+		} catch (NumberFormatException ex) {
+			throw new RestApiException("400", "CART_MAX_LINE_QUANTITY must be a whole number");
+		}
+	}
+
+	public static void rejectIfLineWouldExceed(long quantity, int max) {
+		if (quantity <= 0) {
+			return;
+		}
+		if (quantity > max) {
+			throw new RestApiException("400",
+					"Cart line quantity " + quantity + " exceeds the maximum of " + max);
+		}
+	}
+}
