+package com.salesmanager.test.shop.cart;
+
+import org.junit.Test;
+
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.controller.shoppingCart.CartLineQuantityLimit;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.fail;
+
+public class CartLineQuantityLimitTest {
+
+	@Test
+	public void missingConfigurationAllowsUpTo99() {
+		int max = CartLineQuantityLimit.parse(null);
+		assertEquals(99, max);
+		CartLineQuantityLimit.rejectIfLineWouldExceed(99, max);
+		CartLineQuantityLimit.rejectIfLineWouldExceed(0, max);
+	}
+
+	@Test
+	public void blankConfigurationAllowsUpTo99() {
+		assertEquals(99, CartLineQuantityLimit.parse("  "));
+	}
+
+	@Test
+	public void configuredMaximumRejectsALargerLine() {
+		int max = CartLineQuantityLimit.parse(" 3 ");
+		assertEquals(3, max);
+		CartLineQuantityLimit.rejectIfLineWouldExceed(3, max);
+		try {
+			CartLineQuantityLimit.rejectIfLineWouldExceed(4, max);
+			fail("quantity above the store maximum must be rejected");
+		} catch (RestApiException ex) {
+			assertEquals("400", ex.getErrorCode());
+		}
+	}
+
+	@Test
+	public void zeroQuantityIsNotALineSize() {
+		CartLineQuantityLimit.rejectIfLineWouldExceed(0, 1);
+	}
+
+	@Test
+	public void nonNumericConfigurationIsRejected() {
+		try {
+			CartLineQuantityLimit.parse("many");
+			fail("a non-numeric limit must be rejected");
+		} catch (RestApiException ex) {
+			assertEquals("400", ex.getErrorCode());
+		}
+	}
+}
