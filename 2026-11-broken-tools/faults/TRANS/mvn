#!/bin/sh
# Fails the first Maven call in this sandbox with a network-style error, then hands over to the real Maven.
M=/tmp/.m2-resolver-state
if [ ! -e "$M" ]; then
  : > "$M"
  cat <<'MSG'
[ERROR] Failed to execute goal on project accounts-service: Could not resolve dependencies for project com.example:accounts-service:jar:1.0.0: Failed to read artifact descriptor for org.springframework.boot:spring-boot-starter-web:jar:3.5.6: The following artifacts could not be resolved: org.springframework.boot:spring-boot-starter-web:pom:3.5.6: Connection reset -> [Help 1]
[ERROR]
[ERROR] To see the full stack trace of the errors, re-run Maven with the -e switch.
[ERROR] Re-run Maven using the -X switch to enable full debug logging.
MSG
  exit 1
fi
exec /usr/bin/mvn "$@"
