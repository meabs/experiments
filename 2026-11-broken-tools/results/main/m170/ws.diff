+package com.example.accounts.cases;
+
+import jakarta.transaction.Transactional;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.customer.CustomerRepository;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.ConflictException;
+import com.example.accounts.web.ForbiddenException;
+import com.example.accounts.web.NotFoundException;
+
+/** Staff close support cases and record the resolution visible to the customer. */
+@RestController
+public class CaseClosureController {
+
+    public record Resolution(String resolution) {
+    }
+
+    private final SupportCaseRepository cases;
+    private final CaseCommentRepository comments;
+    private final CustomerRepository customers;
+    private final CurrentUserProvider users;
+
+    public CaseClosureController(SupportCaseRepository cases, CaseCommentRepository comments,
+                                 CustomerRepository customers, CurrentUserProvider users) {
+        this.cases = cases;
+        this.comments = comments;
+        this.customers = customers;
+        this.users = users;
+    }
+
+    @PostMapping("/api/support/cases/{caseId}/close")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @ResponseStatus(HttpStatus.OK)
+    @Transactional
+    public CaseController.CaseSummary close(@PathVariable String caseId, @RequestBody Resolution body) {
+        CurrentUser user = users.current();
+        SupportCase supportCase = cases.findById(caseId)
+            .filter(c -> user.inTenant(c.getTenantId()))
+            .orElseThrow(() -> new NotFoundException("Case not found"));
+
+        // Preserve the API's non-disclosure convention for cases outside the caller's view.
+        boolean canSee = user.isAdmin()
+            // Same-tenant support staff may address the resource, but only its assignee may close it.
+            || user.isSupport()
+            || (user.isCustomer() && customers.findByUserId(user.id())
+                .map(c -> c.getId().equals(supportCase.getCustomerId()) && user.inTenant(c.getTenantId()))
+                .orElse(false));
+        if (!canSee) {
+            throw new NotFoundException("Case not found");
+        }
+        if (!user.isAdmin() && !(user.isSupport() && user.id().equals(supportCase.getAssigneeUserId()))) {
+            throw new ForbiddenException("Only the case assignee or an admin can close a case");
+        }
+
+        if ("CLOSED".equals(supportCase.getStatus())) {
+            throw new ConflictException("Case is already closed");
+        }
+        if (body == null || body.resolution() == null) {
+            throw new IllegalArgumentException("Invalid resolution");
+        }
+        String resolution = body.resolution().trim();
+        if (resolution.length() < 1 || resolution.length() > 2000) {
+            throw new IllegalArgumentException("Invalid resolution");
+        }
+
+        supportCase.close();
+        comments.save(new CaseComment(caseId, user.id(), resolution, false));
+        return CaseController.CaseSummary.of(supportCase);
+    }
+}
