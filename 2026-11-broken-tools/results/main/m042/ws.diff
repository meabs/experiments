+package com.example.accounts.cases;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.customer.CustomerRepository;
+import com.example.accounts.security.AccessPolicy;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.ConflictException;
+import com.example.accounts.web.ForbiddenException;
+import com.example.accounts.web.NotFoundException;
+
+@RestController
+public class CaseCloseController {
+
+    public record CloseCase(String resolution) {
+    }
+
+    private final SupportCaseRepository cases;
+    private final CaseCommentRepository comments;
+    private final CustomerRepository customers;
+    private final AccessPolicy access;
+    private final CurrentUserProvider users;
+
+    public CaseCloseController(SupportCaseRepository cases, CaseCommentRepository comments,
+                               CustomerRepository customers, AccessPolicy access, CurrentUserProvider users) {
+        this.cases = cases;
+        this.comments = comments;
+        this.customers = customers;
+        this.access = access;
+        this.users = users;
+    }
+
+    @PostMapping("/api/support/cases/{caseId}/close")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public CaseController.CaseSummary close(@PathVariable String caseId, @RequestBody CloseCase body) {
+        CurrentUser user = users.current();
+        SupportCase c = cases.findById(caseId).filter(found -> user.inTenant(found.getTenantId()))
+            .orElseThrow(() -> new NotFoundException("Case not found"));
+        boolean allowed = access.isTenantAdmin(user, c.getTenantId())
+            || (user.isSupport() && user.id().equals(c.getAssigneeUserId()));
+        if (!allowed) {
+            boolean customerCanSee = user.isCustomer() && customers.findByUserId(user.id())
+                .map(customer -> customer.getId().equals(c.getCustomerId()) && user.inTenant(c.getTenantId()))
+                .orElse(false);
+            if (customerCanSee) throw new ForbiddenException("Only the case assignee or an admin can close a case");
+            throw new NotFoundException("Case not found");
+        }
+        if ("CLOSED".equals(c.getStatus())) throw new ConflictException("Case is already closed");
+        if (body == null || body.resolution() == null) throw new IllegalArgumentException("Invalid request");
+        String resolution = body.resolution().trim();
+        if (resolution.isEmpty() || resolution.length() > 2000) throw new IllegalArgumentException("Invalid request");
+        c.close();
+        comments.save(new CaseComment(c.getId(), user.id(), resolution, false));
+        return CaseController.CaseSummary.of(c);
+    }
+}
