+
+    @Transactional
+    public Account freeze(Long accountId, String reason) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (!user.isAdmin() && !access.isAssignedSupport(user, account)) {
+            throw new ForbiddenException("Only assigned support or admins may freeze an account");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Closed accounts cannot be frozen");
+        }
+        String trimmed = reason == null ? "" : reason.strip();
+        if (trimmed.isEmpty() || trimmed.length() > 500) {
+            throw new IllegalArgumentException("Invalid freeze reason");
+        }
+        account.setStatus(Account.Status.FROZEN);
+        notes.save(new AccountNote(account.getId(), user.id(), "Account frozen: " + trimmed, true, Instant.now()));
+        return account;
+    }
+
+    @Transactional
+    public Account unfreeze(Long accountId) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (!user.isAdmin()) {
+            throw new ForbiddenException("Only admins may unfreeze an account");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Closed accounts cannot be unfrozen");
+        }
+        account.setStatus(Account.Status.OPEN);
+        notes.save(new AccountNote(account.getId(), user.id(), "Account unfrozen.", true, Instant.now()));
+        return account;
+    }
 }
