+++ b/src/main/java/com/example/accounts/account/AccountService.java
@@ -1,5 +1,7 @@
 package com.example.accounts.account;
 
+import java.time.LocalDate;
+import java.time.format.DateTimeParseException;
 import java.util.List;
 
 import org.springframework.stereotype.Service;
@@ -64,6 +66,42 @@ public class AccountService {
     }
 
     public List<Transaction> transactions(Long accountId) {
-        return transactions.findByAccountIdOrderByBookedOnDescIdDesc(getVisible(accountId).getId());
+        return transactions(accountId, null, null);
+    }
+
+    public List<Transaction> transactions(Long accountId, String from, String to) {
+        Long visibleAccountId = getVisible(accountId).getId();
+        LocalDate fromDate = parseDate(from);
+        LocalDate toDate = parseDate(to);
+        if (fromDate != null && toDate != null && fromDate.isAfter(toDate)) {
+            throw new IllegalArgumentException("Invalid date range");
+        }
+        if (fromDate != null && toDate != null) {
+            return transactions.findByAccountIdAndBookedOnBetweenOrderByBookedOnDescIdDesc(visibleAccountId,
+                fromDate, toDate);
+        }
+        if (fromDate != null) {
+            return transactions.findByAccountIdAndBookedOnGreaterThanEqualOrderByBookedOnDescIdDesc(visibleAccountId,
+                fromDate);
+        }
+        if (toDate != null) {
+            return transactions.findByAccountIdAndBookedOnLessThanEqualOrderByBookedOnDescIdDesc(visibleAccountId,
+                toDate);
+        }
+        return transactions.findByAccountIdOrderByBookedOnDescIdDesc(visibleAccountId);
+    }
+
+    private static LocalDate parseDate(String value) {
+        if (value == null) {
+            return null;
+        }
+        if (!value.matches("\\d{4}-\\d{2}-\\d{2}")) {
+            throw new IllegalArgumentException("Invalid date");
+        }
+        try {
+            return LocalDate.parse(value);
+        } catch (DateTimeParseException e) {
+            throw new IllegalArgumentException("Invalid date", e);
+        }
     }
 }
