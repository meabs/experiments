+    public List<AccountView> list(@RequestParam(required = false) String status) {
+        Account.Status requestedStatus = parseStatus(status);
+        return service.listVisible().stream()
+            .filter(account -> requestedStatus == null || account.getStatus() == requestedStatus)
+            .map(AccountView::of).toList();
+    }
+
+    private static Account.Status parseStatus(String status) {
+        if (status == null) {
+            return null;
+        }
+        try {
+            return Account.Status.valueOf(status);
+        } catch (IllegalArgumentException e) {
+            throw new IllegalArgumentException("Invalid account status", e);
+        }
     }
 
