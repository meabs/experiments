+package com.example.accounts.cases;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.customer.CustomerRepository;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.ConflictException;
+import com.example.accounts.web.ForbiddenException;
+import com.example.accounts.web.NotFoundException;
+
+@RestController
+@RequestMapping("/api/support/cases")
+public class CaseClosureController {
+
+    public record CloseCaseRequest(String resolution) {
+    }
+
+    private final SupportCaseRepository cases;
+    private final CaseCommentRepository comments;
+    private final CustomerRepository customers;
+    private final CurrentUserProvider users;
+
+    public CaseClosureController(SupportCaseRepository cases, CaseCommentRepository comments,
+                                 CustomerRepository customers, CurrentUserProvider users) {
+        this.cases = cases;
+        this.comments = comments;
+        this.customers = customers;
+        this.users = users;
+    }
+
+    @PostMapping("/{caseId}/close")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public CaseController.CaseSummary close(@PathVariable String caseId, @RequestBody CloseCaseRequest body) {
+        SupportCase c = cases.findById(caseId).orElseThrow(() -> new NotFoundException("Case not found"));
+        CurrentUser user = users.current();
+        checkMayClose(user, c);
+        if ("CLOSED".equals(c.getStatus())) {
+            throw new ConflictException("Case is already closed");
+        }
+        String resolution = body == null || body.resolution() == null ? null : body.resolution().trim();
+        if (resolution == null || resolution.length() < 1 || resolution.length() > 2000) {
+            throw new IllegalArgumentException("Invalid resolution");
+        }
+        c.close();
+        comments.save(new CaseComment(c.getId(), user.id(), resolution, false));
+        return CaseController.CaseSummary.of(cases.save(c));
+    }
+
+    private void checkMayClose(CurrentUser user, SupportCase c) {
+        if (!user.inTenant(c.getTenantId())) throw new NotFoundException("Case not found");
+        if (user.isAdmin()) return;
+        if (user.isSupport()) {
+            if (!user.id().equals(c.getAssigneeUserId())) throw new NotFoundException("Case not found");
+            return;
+        }
+        if (user.isCustomer()) {
+            boolean own = customers.findById(c.getCustomerId()).map(customer -> user.id().equals(customer.getUserId())).orElse(false);
+            if (!own) throw new NotFoundException("Case not found");
+        }
+        throw new ForbiddenException("You may not close this case");
+    }
+}
