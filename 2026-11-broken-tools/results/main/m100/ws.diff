+package com.example.accounts.cases;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.ConflictException;
+import com.example.accounts.web.ForbiddenException;
+import com.example.accounts.web.NotFoundException;
+
+/** Actions available to staff handling support cases. */
+@RestController
+@RequestMapping("/api/support/cases")
+public class SupportCaseController {
+
+    public record CloseRequest(String resolution) {
+    }
+
+    private final SupportCaseRepository cases;
+    private final CaseCommentRepository comments;
+    private final CurrentUserProvider users;
+
+    public SupportCaseController(SupportCaseRepository cases, CaseCommentRepository comments,
+                                 CurrentUserProvider users) {
+        this.cases = cases;
+        this.comments = comments;
+        this.users = users;
+    }
+
+    @PostMapping("/{caseId}/close")
+    @PreAuthorize("hasAnyRole('SUPPORT', 'ADMIN') and hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public CaseController.CaseSummary close(@PathVariable String caseId, @RequestBody CloseRequest body) {
+        String resolution = body == null || body.resolution() == null ? null : body.resolution().trim();
+        if (resolution == null || resolution.isEmpty() || resolution.length() > 2000) {
+            throw new IllegalArgumentException("Invalid resolution");
+        }
+
+        CurrentUser user = users.current();
+        SupportCase supportCase = cases.findById(caseId).orElseThrow(() -> new NotFoundException("Case not found"));
+        boolean canClose = user.inTenant(supportCase.getTenantId())
+            && (user.isAdmin() || (user.isSupport() && user.id().equals(supportCase.getAssigneeUserId())));
+        if (!canClose) {
+            // Cases outside a staff member's tenant or assignment are deliberately indistinguishable from missing.
+            if (user.isAdmin() || user.isSupport()) {
+                throw new NotFoundException("Case not found");
+            }
+            throw new ForbiddenException("Only the assigned support user or a tenant admin can close a case");
+        }
+        if ("CLOSED".equals(supportCase.getStatus())) {
+            throw new ConflictException("Case is already closed");
+        }
+
+        supportCase.close();
+        cases.save(supportCase);
+        comments.save(new CaseComment(caseId, user.id(), resolution, false));
+        return CaseController.CaseSummary.of(supportCase);
+    }
+}
