+
+    /** The case assignee or an admin of the case's tenant closes a case with a customer-visible resolution. */
+    @PostMapping("/api/support/cases/{caseId}/close")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public CaseSummary close(@PathVariable String caseId, @RequestBody Resolution body) {
+        CurrentUser user = users.current();
+        SupportCase c = cases.findById(caseId)
+            .filter(found -> canSee(user, found))
+            .orElseThrow(() -> new NotFoundException("Case not found"));
+        if (!access.isTenantAdmin(user, c.getTenantId())
+            && !(user.isSupport() && user.id().equals(c.getAssigneeUserId()))) {
+            throw new ForbiddenException("Only the case assignee or an admin can close a case");
+        }
+        if (c.getStatus().equals("CLOSED")) {
+            throw new ConflictException("Case is already closed");
+        }
+        if (body == null || body.resolution() == null) {
+            throw new IllegalArgumentException("Invalid resolution");
+        }
+        String resolution = body.resolution().trim();
+        if (resolution.isEmpty() || resolution.length() > 2000) {
+            throw new IllegalArgumentException("Invalid resolution");
+        }
+        c.close();
+        comments.save(new CaseComment(c.getId(), user.id(), resolution, false));
+        return CaseSummary.of(c);
+    }
+
+    private boolean canSee(CurrentUser user, SupportCase c) {
+        if (!user.inTenant(c.getTenantId())) {
+            return false;
+        }
+        if (user.isAdmin() || (user.isSupport() && user.id().equals(c.getAssigneeUserId()))) {
+            return true;
+        }
+        return user.isCustomer() && customers.findByUserId(user.id())
+            .map(customer -> customer.getId().equals(c.getCustomerId()))
+            .orElse(false);
+    }
 }
