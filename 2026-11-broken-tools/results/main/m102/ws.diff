+            .andExpect(jsonPath("$", hasSize(1)))
+            .andExpect(jsonPath("$[0].id").value(2));
+        getWith(token, "/api/accounts/1/transactions?from=2026-09-28")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$", hasSize(2)));
+        getWith(token, "/api/accounts/1/transactions?to=2026-09-28")
+            .andExpect(status().isOk())
+            .andExpect(jsonPath("$", hasSize(1)))
+            .andExpect(jsonPath("$[0].id").value(1));
+    }
+
+    @Test
+    void invalidTransactionDateRangeIsRejected() throws Exception {
+        var token = TestTokens.of(ALICE).scopes("transactions:read");
+        getWith(token, "/api/accounts/1/transactions?from=not-a-date")
+            .andExpect(status().isBadRequest());
+        getWith(token, "/api/accounts/1/transactions?from=2026-10-01&to=2026-09-01")
+            .andExpect(status().isBadRequest());
+    }
