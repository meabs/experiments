+
+    public List<Transaction> transactions(Long accountId, LocalDate from, LocalDate to) {
+        Account account = getVisible(accountId);
+        if (from == null && to == null) {
+            return transactions.findByAccountIdOrderByBookedOnDescIdDesc(account.getId());
+        }
+        return transactions.findByAccountIdAndBookedOnBetween(account.getId(), from, to);
+    }
 }
diff --git a/src/main/java/com/example/accounts/account/TransactionRepository.java b/src/main/java/com/example/accounts/account/TransactionRepository.java
index 5d8a4c9..b04ff0b 100644
--- a/src/main/java/com/example/accounts/account/TransactionRepository.java
+++ b/src/main/java/com/example/accounts/account/TransactionRepository.java
@@ -1,10 +1,26 @@
 package com.example.accounts.account;
 
+import java.time.LocalDate;
 import java.util.List;
 
+import org.springframework.data.jpa.repository.Query;
+import org.springframework.data.repository.query.Param;
+
 import org.springframework.data.jpa.repository.JpaRepository;
 
 public interface TransactionRepository extends JpaRepository<Transaction, Long> {
 
     List<Transaction> findByAccountIdOrderByBookedOnDescIdDesc(Long accountId);
+
+    @Query("""
+        select t from Transaction t
+        where t.accountId = :accountId
+          and (:from is null or t.bookedOn >= :from)
+          and (:to is null or t.bookedOn <= :to)
+        order by t.bookedOn desc, t.id desc
+        """)
+    List<Transaction> findByAccountIdAndBookedOnBetween(
+        @Param("accountId") Long accountId,
+        @Param("from") LocalDate from,
+        @Param("to") LocalDate to);
 }
