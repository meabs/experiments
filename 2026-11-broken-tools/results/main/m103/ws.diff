+package com.example.accounts.cases;
+
+import jakarta.validation.Valid;
+import jakarta.validation.constraints.NotNull;
+
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.security.AccessPolicy;
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.web.ConflictException;
+import com.example.accounts.web.ForbiddenException;
+import com.example.accounts.web.NotFoundException;
+
+/** Closing support cases, restricted to the case assignee and tenant admins. */
+@RestController
+public class CaseClosureController {
+
+    public record CloseCase(@NotNull String resolution) {
+    }
+
+    private final SupportCaseRepository cases;
+    private final CaseCommentRepository comments;
+    private final AccessPolicy access;
+    private final CurrentUserProvider users;
+
+    public CaseClosureController(SupportCaseRepository cases, CaseCommentRepository comments, AccessPolicy access,
+                                 CurrentUserProvider users) {
+        this.cases = cases;
+        this.comments = comments;
+        this.access = access;
+        this.users = users;
+    }
+
+    @PostMapping("/api/support/cases/{caseId}/close")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public CaseController.CaseSummary close(@PathVariable String caseId, @Valid @RequestBody CloseCase body) {
+        CurrentUser user = users.current();
+        SupportCase c = cases.findById(caseId)
+            .filter(found -> user.inTenant(found.getTenantId()))
+            .orElseThrow(() -> new NotFoundException("Case not found"));
+
+        if (!access.isTenantAdmin(user, c.getTenantId())
+            && !(user.isSupport() && user.id().equals(c.getAssigneeUserId()))) {
+            throw new ForbiddenException("Only the case assignee or an admin can close a case");
+        }
+        if ("CLOSED".equals(c.getStatus())) {
+            throw new ConflictException("Case is already closed");
+        }
+
+        String resolution = body.resolution().trim();
+        if (resolution.length() < 1 || resolution.length() > 2000) {
+            throw new IllegalArgumentException("Invalid resolution");
+        }
+        c.close();
+        cases.save(c);
+        comments.save(new CaseComment(c.getId(), user.id(), resolution, false));
+        return CaseController.CaseSummary.of(c);
+    }
+}
