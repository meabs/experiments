+
+    @Transactional
+    public Account freeze(Long accountId, String reason) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (!access.isTenantAdmin(user, account.getTenantId()) && !access.isAssignedSupport(user, account)) {
+            throw new ForbiddenException("Only assigned support or an admin can freeze an account");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("A closed account cannot be frozen or unfrozen");
+        }
+        account.setStatus(Account.Status.FROZEN);
+        notes.save(new AccountNote(account.getId(), user.id(), "Account frozen: " + reason, true));
+        return account;
+    }
+
+    @Transactional
+    public Account unfreeze(Long accountId) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (!access.isTenantAdmin(user, account.getTenantId())) {
+            throw new ForbiddenException("Only an admin can unfreeze an account");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("A closed account cannot be frozen or unfrozen");
+        }
+        account.setStatus(Account.Status.OPEN);
+        notes.save(new AccountNote(account.getId(), user.id(), "Account unfrozen.", true));
+        return account;
+    }
 }
