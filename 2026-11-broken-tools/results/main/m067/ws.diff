     public List<Transaction> transactions(Long accountId) {
         return transactions.findByAccountIdOrderByBookedOnDescIdDesc(getVisible(accountId).getId());
     }
+
+    @Transactional
+    public Account freeze(Long accountId, String reason) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (!access.isAssignedSupport(user, account) && !access.isTenantAdmin(user, account.getTenantId())) {
+            throw new ForbiddenException("Only assigned support users or admins can freeze an account");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Closed accounts cannot be frozen or unfrozen");
+        }
+        account.setStatus(Account.Status.FROZEN);
+        notes.save(new AccountNote(account.getId(), user.id(), "Account frozen: " + reason, true, Instant.now()));
+        return account;
+    }
+
+    @Transactional
+    public Account unfreeze(Long accountId) {
+        CurrentUser user = users.current();
+        Account account = getVisible(accountId);
+        if (!access.isTenantAdmin(user, account.getTenantId())) {
+            throw new ForbiddenException("Only admins can unfreeze an account");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Closed accounts cannot be frozen or unfrozen");
+        }
+        account.setStatus(Account.Status.OPEN);
+        notes.save(new AccountNote(account.getId(), user.id(), "Account unfrozen", true, Instant.now()));
+        return account;
+    }
 }
