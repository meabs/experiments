+package com.example.accounts.cases;
+
+import java.time.Instant;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.example.accounts.security.CurrentUser;
+import com.example.accounts.security.CurrentUserProvider;
+import com.example.accounts.customer.CustomerRepository;
+import com.example.accounts.web.ConflictException;
+import com.example.accounts.web.ForbiddenException;
+import com.example.accounts.web.NotFoundException;
+
+/** Staff actions on support cases. */
+@RestController
+@RequestMapping("/api/support/cases")
+public class SupportCaseController {
+
+    public record CloseCaseRequest(String resolution) {
+    }
+
+    public record CaseSummary(String id, Long accountId, String subject, String status, Instant openedAt) {
+        static CaseSummary of(SupportCase c) {
+            return new CaseSummary(c.getId(), c.getAccountId(), c.getSubject(), c.getStatus(), c.getOpenedAt());
+        }
+    }
+
+    private final SupportCaseRepository cases;
+    private final CaseCommentRepository comments;
+    private final CustomerRepository customers;
+    private final CurrentUserProvider users;
+
+    public SupportCaseController(SupportCaseRepository cases, CaseCommentRepository comments,
+                                 CustomerRepository customers, CurrentUserProvider users) {
+        this.cases = cases;
+        this.comments = comments;
+        this.customers = customers;
+        this.users = users;
+    }
+
+    @PostMapping("/{caseId}/close")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @ResponseStatus(HttpStatus.OK)
+    @Transactional
+    public CaseSummary close(@PathVariable String caseId, @RequestBody CloseCaseRequest body) {
+        CurrentUser user = users.current();
+        SupportCase supportCase = cases.findById(caseId)
+            .filter(c -> user.inTenant(c.getTenantId()))
+            .orElseThrow(() -> new NotFoundException("Case not found"));
+
+        // Customers may only see their own cases; do not reveal another customer's case id.
+        if (user.isCustomer() && !user.isAdmin() && customers.findByUserId(user.id())
+                .filter(c -> user.inTenant(c.getTenantId()) && c.getId().equals(supportCase.getCustomerId()))
+                .isEmpty()) {
+            throw new NotFoundException("Case not found");
+        }
+
+        if (!(user.isAdmin() || (user.isSupport() && user.id().equals(supportCase.getAssigneeUserId())))) {
+            throw new ForbiddenException("Only the case assignee or a tenant admin can close a case");
+        }
+        if ("CLOSED".equals(supportCase.getStatus())) {
+            throw new ConflictException("Case is already closed");
+        }
+
+        String resolution = body == null || body.resolution() == null ? null : body.resolution().trim();
+        if (resolution == null || resolution.length() < 1 || resolution.length() > 2000) {
+            throw new IllegalArgumentException("Invalid resolution");
+        }
+
+        supportCase.close();
+        cases.save(supportCase);
+        comments.save(new CaseComment(supportCase.getId(), user.id(), resolution, false));
+        return CaseSummary.of(supportCase);
+    }
+}
