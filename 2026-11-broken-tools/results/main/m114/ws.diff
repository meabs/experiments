+    /** The assigned support user or an admin of the case's tenant closes a case with a customer-visible resolution. */
+    @PostMapping("/api/support/cases/{caseId}/close")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public CaseSummary close(@PathVariable String caseId, @Valid @RequestBody CloseCase body) {
+        CurrentUser user = users.current();
+        SupportCase c = cases.findById(caseId).orElseThrow(() -> new NotFoundException("Case not found"));
+        if (!user.inTenant(c.getTenantId())) {
+            throw new NotFoundException("Case not found");
+        }
+        if (!user.isAdmin() && !(user.isSupport() && user.id().equals(c.getAssigneeUserId()))) {
+            throw new ForbiddenException("Only the assigned support user or an admin can close a case");
+        }
+
+        if (c.getStatus().equals("CLOSED")) {
+            throw new ConflictException("Case is already closed");
+        }
+        String resolution = body.resolution().trim();
+        if (resolution.isEmpty() || resolution.length() > 2000) {
+            throw new IllegalArgumentException("Invalid resolution");
+        }
+        c.close();
+        caseComments.save(new CaseComment(c.getId(), user.id(), resolution, false));
+        return CaseSummary.of(cases.save(c));
+    }
 }
