+    public List<Transaction> transactions(Long accountId, LocalDate from, LocalDate to) {
+        Long visibleAccountId = getVisible(accountId).getId();
+        if (from != null && to != null && from.isAfter(to)) {
+            throw new IllegalArgumentException("from must not be later than to");
+        }
+        if (from == null && to == null) {
+            return transactions.findByAccountIdOrderByBookedOnDescIdDesc(visibleAccountId);
+        }
+        if (from == null) {
+            return transactions.findByAccountIdAndBookedOnLessThanEqualOrderByBookedOnDescIdDesc(visibleAccountId, to);
+        }
+        if (to == null) {
+            return transactions.findByAccountIdAndBookedOnGreaterThanEqualOrderByBookedOnDescIdDesc(visibleAccountId, from);
+        }
+        return transactions.findByAccountIdAndBookedOnGreaterThanEqualAndBookedOnLessThanEqualOrderByBookedOnDescIdDesc(
+            visibleAccountId, from, to);
+    }
+
+    /** Transactions without date bounds, retained for callers that need the original unfiltered operation. */
     public List<Transaction> transactions(Long accountId) {
-        return transactions.findByAccountIdOrderByBookedOnDescIdDesc(getVisible(accountId).getId());
+        return transactions(accountId, null, null);
     }
 }
