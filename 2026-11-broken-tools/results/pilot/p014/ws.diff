+    @PostMapping("/{accountId}/freeze")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public AccountView freeze(@PathVariable Long accountId, @RequestBody FreezeRequest body) {
+        if (body == null || body.reason() == null) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        String reason = body.reason().trim();
+        if (reason.isEmpty() || reason.length() > 500) {
+            throw new IllegalArgumentException("Invalid request");
+        }
+        CurrentUser user = users.current();
+        Account account = service.getVisible(accountId);
+        if (!access.isTenantAdmin(user, account.getTenantId()) && !access.isAssignedSupport(user, account)) {
+            throw new ForbiddenException("Only assigned support users or admins can freeze an account");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+        return AccountView.of(service.freeze(account, reason, user));
+    }
+
+    @PostMapping("/{accountId}/unfreeze")
+    @PreAuthorize("hasAuthority('SCOPE_accounts:write')")
+    @Transactional
+    public AccountView unfreeze(@PathVariable Long accountId) {
+        CurrentUser user = users.current();
+        Account account = service.getVisible(accountId);
+        if (!access.isTenantAdmin(user, account.getTenantId())) {
+            throw new ForbiddenException("Only admins can unfreeze an account");
+        }
+        if (account.getStatus() == Account.Status.CLOSED) {
+            throw new ConflictException("Account is closed");
+        }
+        return AccountView.of(service.unfreeze(account, user));
+    }
