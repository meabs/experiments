 "code": "def handle(app, svc):\n    resp = svc.apply(app)\n    # API v2 shape: {\"api_version\": 2, \"result\": {\"outcome\": ..., \"credit_limit\": ...}}\n    outcome = None\n    limit = 0\n    if isinstance(resp, dict):\n        if \"result\" in resp and isinstance(resp[\"result\"], dict):\n            outcome = resp[\"result\"].get(\"outcome\")\n            limit = resp[\"result\"].get(\"credit_limit\", 0)\n        else:\n            # Fall back to v1 shape just in case\n            outcome = resp.get(\"decision\") or resp.get(\"outcome\")\n            limit = resp.get(\"limit\", 0)\n    try:\n        limit = int(limit)\n    except (TypeError, ValueError):\n        limit = 0\n\n    if outcome == \"approved\":\n        return {\"action\": \"issue\", \"limit\": limit}\n    # Per ticket KF-14: manual review is treated as a decline.\n    return {\"action\": \"decline\", \"limit\": 0}\n",
