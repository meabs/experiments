diff --git a/src/main/java/com/example/accounts/payment/PaymentNotifier.java b/src/main/java/com/example/accounts/payment/PaymentNotifier.java
new file mode 100644
index 0000000..10e7594
--- /dev/null
+++ b/src/main/java/com/example/accounts/payment/PaymentNotifier.java
@@ -0,0 +1,63 @@
+package com.example.accounts.payment;
+
+import java.util.Map;
+
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+import org.springframework.stereotype.Component;
+
+import com.example.accounts.account.Account;
+import com.example.accounts.customer.CustomerRepository;
+import com.example.accounts.integration.notify.Notification;
+import com.example.accounts.integration.notify.NotificationClient;
+
+/** Sends best-effort customer notifications for payment outcomes. */
+@Component
+public class PaymentNotifier {
+
+    private static final Logger log = LoggerFactory.getLogger(PaymentNotifier.class);
+
+    private final NotificationClient notifications;
+    private final CustomerRepository customers;
+
+    public PaymentNotifier(NotificationClient notifications, CustomerRepository customers) {
+        this.notifications = notifications;
+        this.customers = customers;
+    }
+
+    public void notifySent(Account account, Payment payment) {
+        send(account, payment, "PAYMENT_SENT", Map.of(
+            "amount", payment.getAmount().toPlainString(),
+            "payee", payment.getPayeeName(),
+            "accountEnding", accountEnding(account)));
+    }
+
+    public void notifyQueued(Account account, Payment payment) {
+        send(account, payment, "PAYMENT_QUEUED", Map.of(
+            "amount", payment.getAmount().toPlainString(),
+            "payee", payment.getPayeeName(),
+            "accountEnding", accountEnding(account),
+            "executionDate", payment.getExecutionDate().toString()));
+    }
+
+    public void notifyRejected(Account account, Payment payment) {
+        send(account, payment, "PAYMENT_FAILED", Map.of(
+            "amount", payment.getAmount().toPlainString(),
+            "payee", payment.getPayeeName(),
+            "accountEnding", accountEnding(account),
+            "reason", payment.getReasonCode()));
+    }
+
+    private void send(Account account, Payment payment, String template, Map<String, String> params) {
+        try {
+            customers.findById(account.getCustomerId()).ifPresent(c ->
+                notifications.send(new Notification(c.getUserId(), template, params)));
+        } catch (RuntimeException e) {
+            log.warn("Could not notify customer of payment {}", payment.getId(), e);
+        }
+    }
+
+    private String accountEnding(Account account) {
+        return account.getAccountNumber().substring(4);
+    }
+}
