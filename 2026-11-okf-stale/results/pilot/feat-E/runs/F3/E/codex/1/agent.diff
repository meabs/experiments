+    /** Returns the same daily-limit accounting used when accepting a payment. */
+    @Transactional(readOnly = true)
+    public PaymentAllowance allowance(Long accountId) {
+        Account account = accounts.getVisible(accountId);
+        BigDecimal paidToday = paidToday(account.getId());
+        BigDecimal limit = BigDecimal.valueOf(account.getDailyLimit());
+        return new PaymentAllowance(account.getDailyLimit(), paidToday, limit.subtract(paidToday).max(BigDecimal.ZERO));
+    }
