+    /** The amount still available under the account's daily payment limit. */
+    @Transactional(readOnly = true)
+    public PaymentAllowance allowance(Long accountId) {
+        Account account = accounts.getVisible(accountId);
+        BigDecimal paidToday = paidToday(accountId);
+        BigDecimal remaining = BigDecimal.valueOf(account.getDailyLimit()).subtract(paidToday).max(BigDecimal.ZERO);
+        return new PaymentAllowance(account.getDailyLimit(), paidToday, remaining);
+    }
