diff --git a/src/main/java/com/example/accounts/payment/SchemeRetryJob.java b/src/main/java/com/example/accounts/payment/SchemeRetryJob.java
new file mode 100644
index 0000000..4a131a1
--- /dev/null
+++ b/src/main/java/com/example/accounts/payment/SchemeRetryJob.java
@@ -0,0 +1,26 @@
+package com.example.accounts.payment;
+
+import org.springframework.scheduling.annotation.Scheduled;
+import org.springframework.stereotype.Component;
+import org.springframework.transaction.annotation.Transactional;
+
+/** Resubmits payments whose scheme instruction timed out, every five minutes. */
+@Component
+public class SchemeRetryJob {
+
+    private final PaymentRepository payments;
+    private final PaymentDispatcher dispatcher;
+
+    public SchemeRetryJob(PaymentRepository payments, PaymentDispatcher dispatcher) {
+        this.payments = payments;
+        this.dispatcher = dispatcher;
+    }
+
+    @Scheduled(fixedRate = 300_000)
+    @Transactional
+    public void resubmit() {
+        for (Payment payment : payments.findByStatusOrderById(PaymentStatus.RECEIVED.name())) {
+            dispatcher.resubmit(payment);
+        }
+    }
+}
