         } catch (SchemeRejectedException e) {
             payment.setStatus(PaymentStatus.REJECTED);
             payment.setReasonCode(e.getCode());
-            return payments.save(payment);
+            Payment rejected = payments.save(payment);
+            notifyFailed(account, rejected);
+            return rejected;
         }
         account.debit(payment.getAmount());
         payment.setLedgerReference(UUID.randomUUID().toString());
@@ -87,4 +89,25 @@ public class PaymentDispatcher {
             log.warn("Could not notify customer of payment {}", payment.getId(), e);
         }
     }
+
+    public void notifyQueued(Account account, Payment payment) {
+        try {
+            customers.findById(account.getCustomerId()).ifPresent(c -> notifications.send(new Notification(c.getUserId(),
+                "PAYMENT_QUEUED", Map.of("amount", payment.getAmount().toPlainString(), "payee", payment.getPayeeName(),
+                    "accountEnding", account.getAccountNumber().substring(4),
+                    "executionDate", payment.getExecutionDate().toString()))));
+        } catch (RuntimeException e) {
+            log.warn("Could not notify customer of payment {}", payment.getId(), e);
+        }
+    }
+
+    private void notifyFailed(Account account, Payment payment) {
+        try {
+            customers.findById(account.getCustomerId()).ifPresent(c -> notifications.send(new Notification(c.getUserId(),
+                "PAYMENT_FAILED", Map.of("amount", payment.getAmount().toPlainString(), "payee", payment.getPayeeName(),
+                    "accountEnding", account.getAccountNumber().substring(4), "reason", payment.getReasonCode()))));
+        } catch (RuntimeException e) {
+            log.warn("Could not notify customer of payment {}", payment.getId(), e);
+        }
+    }
 }
