+        BigDecimal remaining = BigDecimal.valueOf(account.getDailyLimit()).subtract(paidToday)
+            .max(BigDecimal.ZERO);
+        return new PaymentAllowance(account.getDailyLimit(), paidToday, remaining);
+    }
