+    /** The portion of the account's daily payment limit still available to the caller. */
+    @Transactional(readOnly = true)
+    public PaymentAllowance allowance(Long accountId) {
+        Account account = accounts.getVisible(accountId);
+        BigDecimal paid = paidToday(accountId);
+        BigDecimal remaining = BigDecimal.valueOf(account.getDailyLimit()).subtract(paid).max(BigDecimal.ZERO);
+        return new PaymentAllowance(account.getDailyLimit(), paid, remaining);
+    }
