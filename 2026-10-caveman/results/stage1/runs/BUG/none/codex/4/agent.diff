+package com.salesmanager.test.shop.mapper.catalog.product;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import java.math.BigDecimal;
+import java.text.SimpleDateFormat;
+import java.util.Collections;
+
+import org.junit.Test;
+
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.mapper.catalog.product.PersistableProductAvailabilityMapper;
+import com.salesmanager.shop.model.catalog.product.PersistableProductPrice;
+import com.salesmanager.shop.model.catalog.product.product.PersistableProductInventory;
+
+public class PersistableProductAvailabilityMapperTest {
+
+	@Test
+	public void mapsDiscountEndDateToEndDate() {
+		PersistableProductPrice sourcePrice = new PersistableProductPrice();
+		sourcePrice.setPrice(new BigDecimal("25.00"));
+		sourcePrice.setDiscountedPrice(new BigDecimal("12.50"));
+		sourcePrice.setDiscountEndDate("2099-12-31");
+
+		PersistableProductInventory inventory = new PersistableProductInventory();
+		inventory.setPrice(sourcePrice);
+
+		MerchantStore store = mock(MerchantStore.class);
+		when(store.getLanguages()).thenReturn(Collections.emptyList());
+
+		ProductAvailability availability = new PersistableProductAvailabilityMapper().convert(inventory, store, null);
+		ProductPrice mappedPrice = availability.getPrices().iterator().next();
+
+		assertNull(mappedPrice.getProductPriceSpecialStartDate());
+		assertEquals("2099-12-31", new SimpleDateFormat("yyyy-MM-dd")
+				.format(mappedPrice.getProductPriceSpecialEndDate()));
+	}
+
+	@Test
+	public void preservesStartDateWhenMappingBothDiscountDates() {
+		PersistableProductPrice sourcePrice = new PersistableProductPrice();
+		sourcePrice.setPrice(new BigDecimal("25.00"));
+		sourcePrice.setDiscountedPrice(new BigDecimal("12.50"));
+		sourcePrice.setDiscountStartDate("2099-01-01");
+		sourcePrice.setDiscountEndDate("2099-12-31");
+
+		PersistableProductInventory inventory = new PersistableProductInventory();
+		inventory.setPrice(sourcePrice);
+
+		MerchantStore store = mock(MerchantStore.class);
+		when(store.getLanguages()).thenReturn(Collections.emptyList());
+
+		ProductPrice mappedPrice = new PersistableProductAvailabilityMapper()
+				.convert(inventory, store, null).getPrices().iterator().next();
+
+		SimpleDateFormat dateFormat = new SimpleDateFormat("yyyy-MM-dd");
+		assertEquals("2099-01-01", dateFormat.format(mappedPrice.getProductPriceSpecialStartDate()));
+		assertEquals("2099-12-31", dateFormat.format(mappedPrice.getProductPriceSpecialEndDate()));
+	}
+}
