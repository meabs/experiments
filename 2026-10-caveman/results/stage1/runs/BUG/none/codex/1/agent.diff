+package com.salesmanager.test.shop.mapper.catalog.product;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+
+import java.math.BigDecimal;
+
+import org.junit.Test;
+
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.mapper.catalog.product.PersistableProductAvailabilityMapper;
+import com.salesmanager.shop.model.catalog.product.PersistableProductPrice;
+import com.salesmanager.shop.model.catalog.product.product.PersistableProductInventory;
+import com.salesmanager.shop.utils.DateUtil;
+
+public class PersistableProductAvailabilityMapperTest {
+
+	@Test
+	public void mapsDiscountEndDateToEndDate() throws Exception {
+		PersistableProductPrice sourcePrice = new PersistableProductPrice();
+		sourcePrice.setPrice(new BigDecimal("100.00"));
+		sourcePrice.setDiscountedPrice(new BigDecimal("80.00"));
+		sourcePrice.setDiscountEndDate("2099-12-31");
+
+		PersistableProductInventory source = new PersistableProductInventory();
+		source.setPrice(sourcePrice);
+
+		ProductAvailability availability = new PersistableProductAvailabilityMapper().convert(source,
+				new MerchantStore(1, "store", "Store"), null);
+
+		assertNull(availability.defaultPrice().getProductPriceSpecialStartDate());
+		assertEquals(DateUtil.getDate("2099-12-31"),
+				availability.defaultPrice().getProductPriceSpecialEndDate());
+	}
+}
