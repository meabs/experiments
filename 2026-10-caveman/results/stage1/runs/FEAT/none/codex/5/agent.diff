+	private int getMaximumLineQuantity(MerchantStore store) {
+		try {
+			MerchantConfiguration configuration = merchantConfigurationService
+					.getMerchantConfiguration(Constants.CART_MAX_LINE_QUANTITY, store);
+			if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+				return Constants.DEFAULT_CART_MAX_LINE_QUANTITY;
+			}
+
+			int maximum = Integer.parseInt(configuration.getValue().trim());
+			if (maximum < 0) {
+				throw new NumberFormatException("negative value");
+			}
+			return maximum;
+		} catch (ServiceException e) {
+			throw new ServiceRuntimeException("Unable to read cart line quantity limit", e);
+		} catch (NumberFormatException e) {
+			throw new ServiceRuntimeException("Invalid " + Constants.CART_MAX_LINE_QUANTITY + " configuration", e);
+		}
+	}
+
