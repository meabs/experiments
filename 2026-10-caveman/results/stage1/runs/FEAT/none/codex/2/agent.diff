+	private long getCartMaxLineQuantity(MerchantStore store) {
+		try {
+			com.salesmanager.core.model.system.MerchantConfiguration configuration = merchantConfigurationService
+					.getMerchantConfiguration(Constants.CART_MAX_LINE_QUANTITY, store);
+			if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+				return 99L;
+			}
+			long configuredLimit = Long.parseLong(configuration.getValue().trim());
+			if (configuredLimit < 0) {
+				throw new RestApiException("400", "The " + Constants.CART_MAX_LINE_QUANTITY
+						+ " configuration must not be negative");
+			}
+			return configuredLimit;
+		} catch (ServiceException e) {
+			throw new ServiceRuntimeException("Unable to read cart quantity configuration", e);
+		} catch (NumberFormatException e) {
+			throw new RestApiException("400", "The " + Constants.CART_MAX_LINE_QUANTITY
+					+ " configuration must be a whole number", e);
+		}
+	}
+
+	private void validateAddedLineQuantity(ShoppingCart cartModel,
+			com.salesmanager.core.model.shoppingcart.ShoppingCartItem itemModel, int requestedQuantity,
+			long maxLineQuantity) {
+		if (requestedQuantity == 0) {
+			return;
+		}
+
+		long resultingQuantity = requestedQuantity;
+		if (CollectionUtils.isEmpty(itemModel.getAttributes())) {
+			for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem existingItem : cartModel.getLineItems()) {
+				if (existingItem.getProduct().getId().longValue() == itemModel.getProduct().getId().longValue()
+						&& CollectionUtils.isEmpty(existingItem.getAttributes())) {
+					resultingQuantity = itemModel.isProductVirtual() ? existingItem.getQuantity()
+							: (long) existingItem.getQuantity() + requestedQuantity;
+					break;
+				}
+			}
+		}
+
+		validateQuantity(resultingQuantity, maxLineQuantity);
+	}
+
+	private void validateQuantity(long quantity, long maxLineQuantity) {
+		if (quantity > maxLineQuantity) {
+			throw new RestApiException("400", "Cart line quantity must not exceed " + maxLineQuantity);
+		}
+	}
+
 	private String uniqueShoppingCartCode() {
