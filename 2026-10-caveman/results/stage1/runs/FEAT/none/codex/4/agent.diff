+	private int getCartMaxLineQuantity(final MerchantStore store) throws ServiceException {
+		MerchantConfiguration configuration = merchantConfigurationService
+				.getMerchantConfiguration(CART_MAX_LINE_QUANTITY, store);
+		if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+			return DEFAULT_CART_MAX_LINE_QUANTITY;
+		}
+
+		try {
+			int maxLineQuantity = Integer.parseInt(configuration.getValue().trim());
+			if (maxLineQuantity < 0) {
+				throw new NumberFormatException("negative value");
+			}
+			return maxLineQuantity;
+		} catch (NumberFormatException e) {
+			throw new ServiceRuntimeException("400",
+					"Configuration " + CART_MAX_LINE_QUANTITY + " must be a non-negative whole number", e);
+		}
+	}
+
+	private void validateLineQuantity(final long quantity, final int maxLineQuantity) {
+		if (quantity > maxLineQuantity) {
+			throw new ServiceRuntimeException("400",
+					"Cart line quantity " + quantity + " exceeds the maximum of " + maxLineQuantity,
+					new IllegalArgumentException("Cart line quantity exceeds configured maximum"));
+		}
+	}
+
