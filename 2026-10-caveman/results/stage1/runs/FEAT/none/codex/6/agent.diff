+    private void saveCartLineQuantity(MerchantStore store, String value) throws Exception {
+        MerchantConfiguration configuration = merchantConfigurationService
+                .getMerchantConfiguration(com.salesmanager.shop.constants.Constants.CART_MAX_LINE_QUANTITY, store);
+        if (configuration == null) {
