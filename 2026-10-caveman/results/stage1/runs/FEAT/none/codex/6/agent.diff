+	private void validateAddedLineQuantity(ShoppingCart cartModel,
+			com.salesmanager.core.model.shoppingcart.ShoppingCartItem itemModel,
+			PersistableShoppingCartItem item, MerchantStore store) throws ServiceException {
+		long resultingQuantity = itemModel.getQuantity();
+		if (CollectionUtils.isEmpty(item.getAttributes())) {
+			for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem existingItem : cartModel.getLineItems()) {
+				if (existingItem.getProduct().getId().longValue() == itemModel.getProduct().getId().longValue()
+						&& CollectionUtils.isEmpty(existingItem.getAttributes())) {
+					if (!itemModel.isProductVirtual()) {
+						resultingQuantity += existingItem.getQuantity();
+					}
+					break;
+				}
+			}
+		}
+		validateLineQuantity(resultingQuantity, getMaxLineQuantity(store));
+	}
+
+	private void validateLineQuantity(long quantity, MerchantStore store) throws ServiceException {
+		validateLineQuantity(quantity, getMaxLineQuantity(store));
+	}
+
+	private void validateLineQuantity(long quantity, long maxLineQuantity) {
+		if (quantity > maxLineQuantity) {
+			throw new ServiceRuntimeException("Cart line quantity must not exceed " + maxLineQuantity);
+		}
+	}
+
+	private long getMaxLineQuantity(MerchantStore store) throws ServiceException {
+		MerchantConfiguration configuration = merchantConfigurationService
+				.getMerchantConfiguration(Constants.CART_MAX_LINE_QUANTITY, store);
+		if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+			return Constants.DEFAULT_CART_MAX_LINE_QUANTITY;
+		}
+
+		try {
+			long maxLineQuantity = Long.parseLong(configuration.getValue().trim());
+			if (maxLineQuantity < 0) {
+				throw new NumberFormatException("negative value");
+			}
+			return maxLineQuantity;
+		} catch (NumberFormatException e) {
+			throw new ServiceRuntimeException("Configuration " + Constants.CART_MAX_LINE_QUANTITY
+					+ " must be a whole number", e);
+		}
+	}
+
