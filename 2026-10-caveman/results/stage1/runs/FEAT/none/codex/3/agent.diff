+	private void validateAddedItemQuantity(ShoppingCart cartModel,
+			com.salesmanager.core.model.shoppingcart.ShoppingCartItem item, MerchantStore store) throws Exception {
+		long maxLineQuantity = getCartMaxLineQuantity(store);
+		long quantity = item.getQuantity();
+		if (!item.isProductVirtual() && CollectionUtils.isNotEmpty(cartModel.getLineItems())
+				&& CollectionUtils.isEmpty(item.getAttributes())) {
+			for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem cartItem : cartModel.getLineItems()) {
+				if (item.getProduct().getSku().equals(cartItem.getProduct().getSku())
+						&& CollectionUtils.isEmpty(cartItem.getAttributes())) {
+					quantity += cartItem.getQuantity();
+					break;
+				}
+			}
+		}
+		validateLineQuantity(quantity, maxLineQuantity);
+	}
+
+	private void validateLineQuantity(long quantity, MerchantStore store) throws Exception {
+		validateLineQuantity(quantity, getCartMaxLineQuantity(store));
+	}
+
+	private void validateLineQuantity(long quantity, long maxLineQuantity) {
+		if (quantity > maxLineQuantity) {
+			throw new IllegalArgumentException("Cart line quantity cannot exceed " + maxLineQuantity);
+		}
+	}
+
+	private long getCartMaxLineQuantity(MerchantStore store) throws Exception {
+		MerchantConfiguration configuration = merchantConfigurationService
+				.getMerchantConfiguration(CART_MAX_LINE_QUANTITY, store);
+		if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+			return DEFAULT_CART_MAX_LINE_QUANTITY;
+		}
+		try {
+			long maxLineQuantity = Long.parseLong(configuration.getValue().trim());
+			if (maxLineQuantity < 0) {
+				throw new IllegalArgumentException("Invalid " + CART_MAX_LINE_QUANTITY + " configuration");
+			}
+			return maxLineQuantity;
+		} catch (NumberFormatException e) {
+			throw new IllegalArgumentException("Invalid " + CART_MAX_LINE_QUANTITY + " configuration", e);
+		}
+	}
+
