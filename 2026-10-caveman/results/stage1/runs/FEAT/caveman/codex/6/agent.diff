+	private void validateMergedCartQuantities(ShoppingCart userCart, ShoppingCart sessionCart,
+			MerchantStore store) throws ServiceException {
+		MerchantConfiguration configuration = merchantConfigurationService
+				.getMerchantConfiguration(CART_MAX_LINE_QUANTITY, store);
+		long maxLineQuantity = DEFAULT_CART_MAX_LINE_QUANTITY;
+		if (configuration != null && configuration.getValue() != null
+				&& !configuration.getValue().trim().isEmpty()) {
+			try {
+				maxLineQuantity = Long.parseLong(configuration.getValue().trim());
+				if (maxLineQuantity < 0) {
+					throw new NumberFormatException("negative value");
+				}
+			} catch (NumberFormatException e) {
+				throw new ServiceException("Invalid " + CART_MAX_LINE_QUANTITY + " configuration", e);
+			}
+		}
+
+		if (CollectionUtils.isNotEmpty(userCart.getLineItems())) {
+			for (ShoppingCartItem userItem : userCart.getLineItems()) {
+				validateLineQuantity(userItem.getQuantity(), maxLineQuantity);
+			}
+		}
+		if (CollectionUtils.isNotEmpty(sessionCart.getLineItems())) {
+			for (ShoppingCartItem sessionItem : sessionCart.getLineItems()) {
+				validateLineQuantity(sessionItem.getQuantity(), maxLineQuantity);
+				if (CollectionUtils.isNotEmpty(userCart.getLineItems())) {
+					for (ShoppingCartItem userItem : userCart.getLineItems()) {
+						if (userItem.getProduct().getId().longValue() == sessionItem.getProduct().getId().longValue()
+								&& CollectionUtils.isNotEmpty(userItem.getAttributes())) {
+							validateLineQuantity((long) userItem.getQuantity() + sessionItem.getQuantity(),
+									maxLineQuantity);
+						}
+					}
+				}
+			}
+		}
+	}
+
+	private void validateLineQuantity(long quantity, long maxLineQuantity) throws ServiceException {
+		if (quantity > maxLineQuantity) {
+			throw new ServiceException("Cart line quantity must not exceed " + maxLineQuantity);
+		}
+	}
