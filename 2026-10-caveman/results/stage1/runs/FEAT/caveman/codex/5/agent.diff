+	private long getMaxLineQuantity(final MerchantStore store) throws Exception {
+		MerchantConfiguration configuration = merchantConfigurationService
+				.getMerchantConfiguration(CART_MAX_LINE_QUANTITY, store);
+		if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+			return DEFAULT_CART_MAX_LINE_QUANTITY;
+		}
+
+		try {
+			long maxLineQuantity = Long.parseLong(configuration.getValue().trim());
+			if (maxLineQuantity < 0) {
+				throw new NumberFormatException("negative value");
+			}
+			return maxLineQuantity;
+		} catch (NumberFormatException e) {
+			throw new CartModificationException("Configuration " + CART_MAX_LINE_QUANTITY
+					+ " must be a non-negative whole number", e);
+		}
+	}
+
+	private void validateQuantity(final int quantity, final long maxLineQuantity)
+			throws CartModificationException {
+		if (quantity > maxLineQuantity) {
+			throw new CartModificationException("Cart line quantity " + quantity
+					+ " exceeds maximum " + maxLineQuantity);
+		}
+	}
+
+	private void validateAddQuantity(final ShoppingCart cartModel,
+			final com.salesmanager.core.model.shoppingcart.ShoppingCartItem itemModel,
+			final boolean mergeUnattributedItem, final long maxLineQuantity)
+			throws CartModificationException {
+		validateQuantity(itemModel.getQuantity(), maxLineQuantity);
+
+		if (!mergeUnattributedItem || CollectionUtils.isEmpty(cartModel.getLineItems())) {
+			return;
+		}
+
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem existingItem : cartModel.getLineItems()) {
+			if (existingItem.getProduct().getId().longValue() == itemModel.getProduct().getId().longValue()
+					&& CollectionUtils.isEmpty(existingItem.getAttributes())) {
+				long resultingQuantity = (long) existingItem.getQuantity() + itemModel.getQuantity();
+				if (!itemModel.isProductVirtual() && resultingQuantity > maxLineQuantity) {
+					throw new CartModificationException("Cart line quantity " + resultingQuantity
+							+ " exceeds maximum " + maxLineQuantity);
+				}
+				return;
+			}
+		}
+	}
