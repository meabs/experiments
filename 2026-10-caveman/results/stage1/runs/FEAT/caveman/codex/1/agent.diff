+	private void validateAddedQuantity(ShoppingCart cartModel,
+			com.salesmanager.core.model.shoppingcart.ShoppingCartItem item, int requestedQuantity,
+			boolean incrementExistingLine) throws CartModificationException {
+		if (requestedQuantity <= 0) {
+			return;
+		}
+
+		long resultingQuantity = requestedQuantity;
+		if (incrementExistingLine && !item.isProductVirtual() && cartModel != null
+				&& CollectionUtils.isNotEmpty(cartModel.getLineItems())) {
+			for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem existingItem : cartModel.getLineItems()) {
+				if (existingItem.getProduct().getId().equals(item.getProduct().getId())
+						&& CollectionUtils.isEmpty(existingItem.getAttributes())) {
+					resultingQuantity += existingItem.getQuantity();
+					break;
+				}
+			}
+		}
+
+		validateRequestedQuantity(resultingQuantity, item.getProduct().getSku(), cartModel.getMerchantStore());
+	}
+
+	private void validateRequestedQuantities(List<PersistableShoppingCartItem> items, MerchantStore store)
+			throws CartModificationException {
+		for (PersistableShoppingCartItem item : items) {
+			validateRequestedQuantity(item.getQuantity(), store);
+		}
+	}
+
+	private void validateRequestedQuantity(long quantity, MerchantStore store) throws CartModificationException {
+		validateRequestedQuantity(quantity, null, store);
+	}
+
+	private void validateRequestedQuantity(long quantity, String product, MerchantStore store)
+			throws CartModificationException {
+		if (quantity <= 0) {
+			return;
+		}
+
+		long maxQuantity = getMaxLineQuantity(store);
+		if (quantity > maxQuantity) {
+			String productText = product == null ? "" : " for product " + product;
+			throw new CartModificationException(
+					"Cart line quantity" + productText + " cannot exceed " + maxQuantity);
+		}
+	}
+
+	private long getMaxLineQuantity(MerchantStore store) throws CartModificationException {
+		try {
+			MerchantConfiguration configuration = merchantConfigurationService
+					.getMerchantConfiguration(CART_MAX_LINE_QUANTITY, store);
+			if (configuration == null) {
+				return DEFAULT_CART_MAX_LINE_QUANTITY;
+			}
+
+			long maxQuantity = Long.parseLong(configuration.getValue().trim());
+			if (maxQuantity < 0) {
+				throw new NumberFormatException("negative quantity");
+			}
+			return maxQuantity;
+		} catch (ServiceException | NumberFormatException e) {
+			throw new CartModificationException("Invalid " + CART_MAX_LINE_QUANTITY + " configuration", e);
+		}
+	}
+
 	private String uniqueShoppingCartCode() {
