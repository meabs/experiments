+	private void validateAddedLineQuantity(
+			ShoppingCart cartModel,
+			com.salesmanager.core.model.shoppingcart.ShoppingCartItem item,
+			int requestedQuantity,
+			MerchantStore store) throws Exception {
+		if (requestedQuantity <= 0) {
+			return;
+		}
+
+		long lineQuantity = requestedQuantity;
+		if (!item.isProductVirtual() && CollectionUtils.isEmpty(item.getAttributes())
+				&& CollectionUtils.isNotEmpty(cartModel.getLineItems())) {
+			for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem cartItem : cartModel.getLineItems()) {
+				if (cartItem.getProduct().getId().longValue() == item.getProduct().getId().longValue()
+						&& CollectionUtils.isEmpty(cartItem.getAttributes())) {
+					lineQuantity += cartItem.getQuantity();
+					break;
+				}
+			}
+		}
+
+		validateCartLineQuantity(lineQuantity, store);
+	}
+
+	private void validateCartLineQuantity(long quantity, MerchantStore store) throws Exception {
+		if (quantity > 0) {
+			int maxQuantity = getCartMaxLineQuantity(store);
+			if (quantity > maxQuantity) {
+				throw new CartModificationException(
+						"Cart line quantity must not exceed " + maxQuantity);
+			}
+		}
+	}
+
+	private int getCartMaxLineQuantity(MerchantStore store) throws Exception {
+		MerchantConfiguration configuration = merchantConfigurationService
+				.getMerchantConfiguration(CART_MAX_LINE_QUANTITY, store);
+		if (configuration == null || StringUtils.isBlank(configuration.getValue())) {
+			return DEFAULT_CART_MAX_LINE_QUANTITY;
+		}
+
+		try {
+			int maxQuantity = Integer.parseInt(configuration.getValue().trim());
+			if (maxQuantity < 0) {
+				throw new NumberFormatException("negative value");
+			}
+			return maxQuantity;
+		} catch (NumberFormatException e) {
+			throw new ServiceRuntimeException(
+					"Invalid " + CART_MAX_LINE_QUANTITY + " merchant configuration", e);
+		}
+	}
