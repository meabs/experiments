@@ -351,4 +351,22 @@ public class TaxFacadeImpl implements TaxFacade {
 
 	}
 
+
+	@Override
+	public ReadableEntityList<ReadableTaxRate> taxRates(MerchantStore store, Language language, int page, int count) {
+		ReadableEntityList<ReadableTaxRate> all = taxRates(store, language);
+		List<ReadableTaxRate> sorted = all.getItems().stream()
+				.sorted(java.util.Comparator.comparing(ReadableTaxRate::getCode))
+				.collect(Collectors.toList());
+		int total = sorted.size();
+		int size = count > 0 ? count : Math.max(total, 1);
+		int from = Math.min(Math.max(page, 0) * size, total);
+		int to = Math.min(from + size, total);
+		ReadableEntityList<ReadableTaxRate> result = new ReadableEntityList<ReadableTaxRate>();
+		result.setItems(sorted.subList(from, to));
+		result.setNumber(to - from);
+		result.setRecordsTotal(total);
+		result.setTotalPages((total + size - 1) / size);
+		return result;
+	}
 }
