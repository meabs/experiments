--- /dev/null
+++ b/sm-core/src/test/java/com/salesmanager/test/catalog/ProductReviewServiceTest.java
@@ -0,0 +1,78 @@
+package com.salesmanager.test.catalog;
+
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+import static org.junit.Assert.assertEquals;
+
+import java.util.Arrays;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.Mock;
+import org.mockito.junit.MockitoJUnitRunner;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import com.salesmanager.core.business.repositories.catalog.product.review.ProductReviewRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.review.ProductReviewServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.review.ProductReview;
+import com.salesmanager.core.model.customer.Customer;
+
+@RunWith(MockitoJUnitRunner.class)
+public class ProductReviewServiceTest {
+
+    @Mock private ProductReviewRepository reviewRepository;
+    @Mock private ProductService productService;
+
+    private ProductReviewServiceImpl service;
+    private Product product;
+    private Customer customer;
+
+    @Before
+    public void setUp() {
+        service = new ProductReviewServiceImpl(reviewRepository);
+        ReflectionTestUtils.setField(service, "productService", productService);
+        product = new Product();
+        product.setId(1L);
+        customer = new Customer();
+        customer.setId(2L);
+        when(productService.getById(1L)).thenReturn(product);
+    }
+
+    @Test
+    public void updateRecalculatesAverageAndCountFromCurrentReviews() throws Exception {
+        ProductReview first = review(10L, 5D);
+        ProductReview second = review(11L, 1D);
+        when(reviewRepository.findByProduct(1L)).thenReturn(Arrays.asList(first, second));
+
+        service.update(first);
+
+        assertEquals(3D, product.getProductReviewAvg().doubleValue(), 0.001D);
+        assertEquals(Integer.valueOf(2), product.getProductReviewCount());
+    }
+
+    @Test
+    public void deleteRecalculatesAverageAndCountFromRemainingReviews() throws Exception {
+        ProductReview deleted = review(10L, 5D);
+        ProductReview remaining = review(11L, 3D);
+        when(reviewRepository.findByProduct(1L)).thenReturn(Arrays.asList(remaining));
+
+        service.delete(deleted);
+
+        assertEquals(3D, product.getProductReviewAvg().doubleValue(), 0.001D);
+        assertEquals(Integer.valueOf(1), product.getProductReviewCount());
+        verify(reviewRepository).delete(deleted);
+    }
+
+    private ProductReview review(Long id, Double rating) {
+        ProductReview review = new ProductReview();
+        review.setId(id);
+        review.setProduct(product);
+        review.setCustomer(customer);
+        review.setReviewRating(rating);
+        return review;
+    }
+}
