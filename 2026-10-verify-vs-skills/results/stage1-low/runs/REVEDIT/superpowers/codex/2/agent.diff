+package com.salesmanager.test.catalog;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import java.util.Arrays;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import com.salesmanager.core.business.repositories.catalog.product.review.ProductReviewRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.review.ProductReviewServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.review.ProductReview;
+import com.salesmanager.core.model.customer.Customer;
+
+public class ProductReviewServiceTest {
+
+    private ProductReviewRepository repository;
+    private ProductService productService;
+    private ProductReviewServiceImpl service;
+    private Product product;
+
+    @Before
+    public void setUp() {
+        repository = mock(ProductReviewRepository.class);
+        productService = mock(ProductService.class);
+        service = new ProductReviewServiceImpl(repository);
+        ReflectionTestUtils.setField(service, "productService", productService);
+        product = new Product();
+        product.setId(7L);
+        when(productService.getById(7L)).thenReturn(product);
+    }
+
+    @Test
+    public void recalculatesRatingFromCurrentReviewsWhenUpdatingAndDeleting() throws Exception {
+        ProductReview first = review(1L, 2D);
+        ProductReview second = review(2L, 4D);
+        when(repository.findByProduct(7L)).thenReturn(Arrays.asList(first, second));
+
+        service.update(first);
+        assertEquals(3D, product.getProductReviewAvg().doubleValue(), 0.001D);
+        assertEquals(Integer.valueOf(2), product.getProductReviewCount());
+
+        when(repository.findByProduct(7L)).thenReturn(Arrays.asList(second));
+        service.delete(first);
+        assertEquals(4D, product.getProductReviewAvg().doubleValue(), 0.001D);
+        assertEquals(Integer.valueOf(1), product.getProductReviewCount());
+    }
+
+    @Test
+    public void missingReviewIdReturnsNull() {
+        when(repository.findOne(99L)).thenReturn(null);
+        assertNull(service.getById(99L));
+    }
+
+    private ProductReview review(Long id, Double rating) {
+        ProductReview review = new ProductReview();
+        review.setId(id);
+        review.setProduct(product);
+        review.setCustomer(new Customer());
+        review.setReviewRating(rating);
+        return review;
+    }
+}
