+package com.salesmanager.test.shop.customer;
+
+import static org.junit.Assert.assertEquals;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import java.lang.reflect.Field;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.Mock;
+import org.mockito.junit.MockitoJUnitRunner;
+
+import com.salesmanager.core.business.services.customer.review.CustomerReviewService;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.review.CustomerReview;
+import com.salesmanager.core.model.customer.review.CustomerReviewDescription;
+import com.salesmanager.shop.model.customer.PersistableCustomerReview;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacadeImpl;
+
+@RunWith(MockitoJUnitRunner.class)
+public class CustomerReviewFacadeTest {
+
+  @Mock
+  private CustomerReviewService customerReviewService;
+
+  private CustomerFacadeImpl facade;
+
+  @Before
+  public void setUp() throws Exception {
+    facade = new CustomerFacadeImpl();
+    Field field = CustomerFacadeImpl.class.getDeclaredField("customerReviewService");
+    field.setAccessible(true);
+    field.set(facade, customerReviewService);
+  }
+
+  @Test
+  public void updateChangesRatingAndDescription() throws Exception {
+    Customer reviewed = new Customer();
+    reviewed.setId(7L);
+    CustomerReview existing = new CustomerReview();
+    existing.setId(11L);
+    existing.setReviewedCustomer(reviewed);
+    CustomerReviewDescription description = new CustomerReviewDescription();
+    existing.getDescriptions().add(description);
+    when(customerReviewService.getById(11L)).thenReturn(existing);
+
+    PersistableCustomerReview request = new PersistableCustomerReview();
+    request.setRating(4D);
+    request.setDescription("Corrected text");
+
+    facade.updateCustomerReview(7L, 11L, request, null, null);
+
+    assertEquals(Double.valueOf(4D), existing.getReviewRating());
+    assertEquals("Corrected text", description.getDescription());
+    verify(customerReviewService).update(existing);
+  }
+
+  @Test(expected = ResourceNotFoundException.class)
+  public void updateMissingReviewReturnsNotFound() {
+    when(customerReviewService.getById(11L)).thenReturn(null);
+    facade.updateCustomerReview(7L, 11L, new PersistableCustomerReview(), null, null);
+  }
+
+  @Test(expected = ResourceNotFoundException.class)
+  public void deleteMissingReviewReturnsNotFound() {
+    when(customerReviewService.getById(11L)).thenReturn(null);
+    facade.deleteCustomerReview(7L, 11L, null, null);
+  }
+}
