+package com.salesmanager.test.shop.store.controller.customer.facade;
+
+import static org.junit.Assert.assertEquals;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.Mock;
+import org.mockito.junit.MockitoJUnitRunner;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import com.salesmanager.core.business.services.customer.review.CustomerReviewService;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.review.CustomerReview;
+import com.salesmanager.shop.model.customer.PersistableCustomerReview;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacadeImpl;
+
+@RunWith(MockitoJUnitRunner.class)
+public class CustomerFacadeImplReviewTest {
+
+  @Mock
+  private CustomerReviewService customerReviewService;
+
+  private CustomerFacadeImpl facade;
+
+  @Before
+  public void setUp() {
+    facade = new CustomerFacadeImpl();
+    ReflectionTestUtils.setField(facade, "customerReviewService", customerReviewService);
+  }
+
+  @Test
+  public void updateCustomerReviewPersistsRatingAndDescription() throws Exception {
+    Customer reviewed = customer(20L);
+    CustomerReview existing = new CustomerReview();
+    existing.setId(7L);
+    existing.setReviewedCustomer(reviewed);
+
+    PersistableCustomerReview update = new PersistableCustomerReview();
+    update.setRating(4D);
+    update.setDescription("corrected text");
+
+    when(customerReviewService.getById(7L)).thenReturn(existing);
+
+    facade.updateCustomerReview(20L, 7L, update, null, null);
+
+    assertEquals(Double.valueOf(4D), existing.getReviewRating());
+    assertEquals("corrected text", existing.getDescriptions().iterator().next().getDescription());
+    verify(customerReviewService).update(existing);
+  }
+
+  @Test(expected = ResourceNotFoundException.class)
+  public void updateCustomerReviewReturnsNotFoundWhenReviewDoesNotExist() {
+    when(customerReviewService.getById(7L)).thenReturn(null);
+    facade.updateCustomerReview(20L, 7L, new PersistableCustomerReview(), null, null);
+  }
+
+  @Test(expected = ResourceNotFoundException.class)
+  public void deleteCustomerReviewReturnsNotFoundWhenReviewDoesNotExist() {
+    when(customerReviewService.getById(7L)).thenReturn(null);
+    facade.deleteCustomerReview(20L, 7L, null, null);
+  }
+
+  private Customer customer(Long id) {
+    Customer customer = new Customer();
+    customer.setId(id);
+    return customer;
+  }
+}
