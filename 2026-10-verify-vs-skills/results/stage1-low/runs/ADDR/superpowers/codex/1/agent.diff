+package com.salesmanager.test.shop.populator.customer;
+
+import static org.junit.Assert.assertEquals;
+
+import org.junit.Test;
+
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.shop.model.customer.address.Address;
+import com.salesmanager.shop.populator.customer.PersistableCustomerShippingAddressPopulator;
+
+public class PersistableCustomerShippingAddressPopulatorTest {
+
+    @Test
+    public void preservesDeliveryStateAndPostalCode() throws Exception {
+        Customer customer = new Customer();
+        Address address = new Address();
+        address.setAddress("Delivery street");
+        address.setCity("Delivery city");
+        address.setPostalCode("DEL-123");
+        address.setStateProvince("Delivery state");
+
+        new PersistableCustomerShippingAddressPopulator().populate(address, customer, null, null);
+
+        assertEquals("Delivery street", customer.getDelivery().getAddress());
+        assertEquals("Delivery city", customer.getDelivery().getCity());
+        assertEquals("DEL-123", customer.getDelivery().getPostalCode());
+        assertEquals("Delivery state", customer.getDelivery().getState());
+    }
+}
