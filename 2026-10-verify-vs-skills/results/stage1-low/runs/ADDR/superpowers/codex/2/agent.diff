+package com.salesmanager.test.shop.populator.customer;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import org.junit.jupiter.api.Test;
+
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.shop.model.customer.address.Address;
+import com.salesmanager.shop.populator.customer.PersistableCustomerShippingAddressPopulator;
+
+class PersistableCustomerShippingAddressPopulatorTest {
+
+    @Test
+    void preservesDeliveryStateAndPostalCode() throws Exception {
+        Address source = new Address();
+        source.setAddress("Delivery street");
+        source.setCity("Delivery city");
+        source.setPostalCode("D1 2AB");
+        source.setStateProvince("DEL");
+
+        Customer customer = new PersistableCustomerShippingAddressPopulator()
+                .populate(source, new Customer(), null, null);
+
+        assertEquals("Delivery street", customer.getDelivery().getAddress());
+        assertEquals("Delivery city", customer.getDelivery().getCity());
+        assertEquals("D1 2AB", customer.getDelivery().getPostalCode());
+        assertEquals("DEL", customer.getDelivery().getState());
+    }
+}
