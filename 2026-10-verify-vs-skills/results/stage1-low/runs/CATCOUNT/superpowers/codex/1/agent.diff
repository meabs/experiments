@@ -43,6 +43,23 @@ public class CategoryRepositoryImpl implements CategoryRepositoryCustom {
 		
 		
 	}
+
+	@Override
+	public List<Object[]> countProductsByCategoryTrees(MerchantStore store, List<Long> categoryIds) {
+		String hql = "select target.id, count(distinct product.id) "
+				+ "from Product product join product.categories assigned, Category target "
+				+ "where target.id in (:cid) "
+				+ "and target.merchantStore = :store "
+				+ "and (assigned.id = target.id or assigned.lineage like concat(target.lineage, target.id, '/%')) "
+				+ "and product.available=true and product.dateAvailable<=:dt "
+				+ "group by target.id";
+
+		Query q = this.em.createQuery(hql);
+		q.setParameter("cid", categoryIds);
+		q.setParameter("store", store);
+		q.setParameter("dt", new Date());
+		return q.getResultList();
+	}
 	
 	@SuppressWarnings("unchecked")
 	@Override
