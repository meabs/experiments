+package com.salesmanager.shop.store.facade.category;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.reference.language.Language;
+
+final class CategoryProductCountCalculator {
+
+    private final CategoryService categoryService;
+    private final ProductService productService;
+
+    CategoryProductCountCalculator(CategoryService categoryService, ProductService productService) {
+        this.categoryService = categoryService;
+        this.productService = productService;
+    }
+
+    int count(Category category, Language language) throws ServiceException {
+        List<Long> categoryIds = new ArrayList<>();
+        categoryIds.add(category.getId());
+        categoryIds.addAll(categoryService.getListByLineage(category.getMerchantStore(),
+                category.getLineage() + category.getId() + "/").stream()
+                .map(Category::getId)
+                .collect(Collectors.toList()));
+
+        Set<Long> productIds = productService.getProducts(categoryIds, language).stream()
+                .map(product -> product.getId())
+                .collect(Collectors.toSet());
+        return productIds.size();
+    }
+}
