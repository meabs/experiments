+package com.salesmanager.shop.store.facade.category;
+
+import static org.junit.Assert.assertEquals;
+import static org.mockito.Mockito.when;
+
+import java.util.Arrays;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.reference.language.Language;
+
+public class CategoryProductCountCalculatorTest {
+
+    @Test
+    public void countsEachProductOnceAcrossCategoryDescendants() throws Exception {
+        CategoryService categoryService = org.mockito.Mockito.mock(CategoryService.class);
+        ProductService productService = org.mockito.Mockito.mock(ProductService.class);
+        Category root = category(1L, "1/");
+        Category child = category(2L, "1/2/");
+        Product shared = product(10L);
+        Product another = product(11L);
+
+        when(categoryService.getListByLineage((com.salesmanager.core.model.merchant.MerchantStore) null, "1/1/")).thenReturn(Arrays.asList(child));
+        when(productService.getProducts(Arrays.asList(1L, 2L), null))
+                .thenReturn(Arrays.asList(shared, shared, another));
+
+        CategoryProductCountCalculator calculator = new CategoryProductCountCalculator(categoryService, productService);
+
+        assertEquals(2, calculator.count(root, null));
+    }
+
+    private static Category category(Long id, String lineage) {
+        Category category = new Category();
+        category.setId(id);
+        category.setLineage(lineage);
+        return category;
+    }
+
+    private static Product product(Long id) {
+        Product product = new Product();
+        product.setId(id);
+        return product;
+    }
+}
