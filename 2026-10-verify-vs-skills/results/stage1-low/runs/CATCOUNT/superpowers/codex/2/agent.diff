+	@Override
+	public List<Object[]> countProductsByCategorySubtrees(MerchantStore store, List<Long> categoryIds) {
+		String hql = "select root.id, count(distinct product.id) from Product product "
+				+ "join product.categories assigned join Category root "
+				+ "where root.id in (:cid) and assigned.lineage like concat('%/', root.id, '/%') "
+				+ "and product.merchantStore.id = :mid and product.available=true and product.dateAvailable<=:dt "
+				+ "group by root.id";
+		Query q = this.em.createQuery(hql);
+		q.setParameter("cid", categoryIds);
+		q.setParameter("mid", store.getId());
+		q.setParameter("dt", new Date());
+		return q.getResultList();
+	}
 	
