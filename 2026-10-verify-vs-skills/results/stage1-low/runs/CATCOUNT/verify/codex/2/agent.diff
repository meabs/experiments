+	@Override
+	public List<Object[]> countProductsByCategoryLineage(MerchantStore store, List<Long> categoryIds) {
+		String hql = "select target.id, count(distinct product.id) from Product product join product.categories assigned join Category target "
+				+ "where target.id in (:cid) and target.merchantStore.id = :mid and assigned.lineage like concat('%/', target.id, '/%') "
+				+ "and product.available=true and product.dateAvailable<=:dt group by target.id";
+		Query q = this.em.createQuery(hql);
+		q.setParameter("cid", categoryIds);
+		q.setParameter("mid", store.getId());
+		q.setParameter("dt", new Date());
+		@SuppressWarnings("unchecked") List<Object[]> counts = q.getResultList();
+		return counts;
+	}
 	
