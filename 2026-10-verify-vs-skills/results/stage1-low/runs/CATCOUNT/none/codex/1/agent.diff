+	public List<Object[]> listProductCategoryIds(MerchantStore store, List<Long> categoryIds) {
+		String hql = "select distinct product.id, category.id from Product product "
+				+ "join product.categories category where product.merchantStore.id=:mid "
+				+ "and category.id in (:cid) and product.available=true and product.dateAvailable<=:dt";
+		Query q = em.createQuery(hql);
+		q.setParameter("mid", store.getId());
+		q.setParameter("cid", categoryIds);
+		q.setParameter("dt", new Date());
+		return q.getResultList();
+	}
 	
