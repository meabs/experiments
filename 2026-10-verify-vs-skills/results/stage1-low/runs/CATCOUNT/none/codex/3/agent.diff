+	@Override
+	public List<Object[]> countProductsInCategoryTrees(MerchantStore store, List<Long> categoryIds) {
+		String hql = "select target.id, count(distinct product.id) from Category target "
+				+ "left join Product product with product.merchantStore.id = :mid "
+				+ "left join product.categories assigned "
+				+ "where target.merchantStore.id = :mid and target.id in (:cid) "
+				+ "and (assigned.id is null or assigned.lineage like concat(target.lineage, '%')) "
+				+ "and (product.id is null or (product.available=true and product.dateAvailable<=:dt)) "
+				+ "group by target.id";
+		Query q = em.createQuery(hql);
+		q.setParameter("mid", store.getId());
+		q.setParameter("cid", categoryIds);
+		q.setParameter("dt", new Date());
+		return q.getResultList();
+	}
 	
