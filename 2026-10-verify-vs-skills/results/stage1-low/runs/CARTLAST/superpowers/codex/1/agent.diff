+    public void emptyCartRemainsAvailableAndCanBeReused() throws Exception {
+        ResponseEntity<ReadableShoppingCart> emptyCart = testRestTemplate.getForEntity(
+                "/api/v1/cart/" + data.getCartId(), ReadableShoppingCart.class);
+
+        assertThat(emptyCart.getStatusCode(), is(OK));
+        assertThat(emptyCart.getBody().getProducts().size(), is(0));
+        assertThat(emptyCart.getBody().getSubtotal(), is(java.math.BigDecimal.ZERO));
+
+        PersistableShoppingCartItem cartItem = new PersistableShoppingCartItem();
+        cartItem.setProduct(data.getProducts().get(0).getSku());
+        cartItem.setQuantity(1);
+
+        ResponseEntity<ReadableShoppingCart> reusedCart = testRestTemplate.exchange(
+                "/api/v1/cart/" + data.getCartId(), HttpMethod.PUT,
+                new HttpEntity<>(cartItem, getHeader()), ReadableShoppingCart.class);
+
+        assertThat(reusedCart.getStatusCode(), is(CREATED));
+        assertThat(reusedCart.getBody().getCode(), is(data.getCartId()));
+        assertThat(reusedCart.getBody().getQuantity(), is(1));
+    }
