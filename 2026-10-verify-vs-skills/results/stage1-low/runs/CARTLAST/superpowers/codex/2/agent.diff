+    public void emptyCartCanBeReadAndReused() throws Exception {
+        final ResponseEntity<ReadableShoppingCart> emptyCart = testRestTemplate.getForEntity(
+                String.format("/api/v1/cart/%s", data.getCartId()), ReadableShoppingCart.class);
+
+        assertThat(emptyCart.getStatusCode(), is(OK));
