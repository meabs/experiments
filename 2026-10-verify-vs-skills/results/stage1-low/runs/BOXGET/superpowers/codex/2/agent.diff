+package com.salesmanager.test.shop.facade.content;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import java.util.Collections;
+
+import org.junit.jupiter.api.Test;
+
+import com.salesmanager.core.business.services.content.ContentService;
+import com.salesmanager.core.model.content.Content;
+import com.salesmanager.core.model.content.ContentDescription;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.content.box.ReadableContentBox;
+import com.salesmanager.shop.store.facade.content.ContentFacadeImpl;
+
+class ContentFacadeImplTest {
+
+    @Test
+    void getContentBoxReturnsStoredMetadataAndDescriptionVerbatim() throws Exception {
+        ContentService contentService = mock(ContentService.class);
+        ContentFacadeImpl facade = new ContentFacadeImpl();
+        setContentService(facade, contentService);
+
+        Language language = new Language("en");
+        MerchantStore store = new MerchantStore();
+        store.setCode("store");
+        Content content = new Content();
+        content.setId(42L);
+        content.setCode("footer_note");
+        content.setVisible(false);
+        ContentDescription description = new ContentDescription("Footer", language);
+        description.setDescription("  Save 10%\r\n\t today  ");
+        content.setDescriptions(Collections.singletonList(description));
+        when(contentService.getByCode("footer_note", store, language)).thenReturn(content);
+
+        ReadableContentBox result = facade.getContentBox("footer_note", store, language);
+
+        assertEquals("footer_note", result.getCode());
+        assertEquals(42L, result.getId());
+        assertFalse(result.isVisible());
+        assertEquals("  Save 10%\r\n\t today  ", result.getDescription().getDescription());
+    }
+
+    private static void setContentService(ContentFacadeImpl facade, ContentService contentService) throws Exception {
+        var field = ContentFacadeImpl.class.getDeclaredField("contentService");
+        field.setAccessible(true);
+        field.set(facade, contentService);
+    }
+}
