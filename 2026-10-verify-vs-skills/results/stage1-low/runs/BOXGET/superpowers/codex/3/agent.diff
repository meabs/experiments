+package com.salesmanager.test.shop.facade.content;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertNotNull;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import java.util.Collections;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.InjectMocks;
+import org.mockito.Mock;
+import org.mockito.junit.MockitoJUnitRunner;
+
+import com.salesmanager.core.business.services.content.ContentService;
+import com.salesmanager.core.model.content.ContentDescription;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.content.Content;
+import com.salesmanager.shop.model.content.box.ReadableContentBox;
+import com.salesmanager.shop.store.facade.content.ContentFacadeImpl;
+
+@RunWith(MockitoJUnitRunner.class)
+public class ContentFacadeImplTest {
+
+    @Mock
+    private ContentService contentService;
+
+    @InjectMocks
+    private ContentFacadeImpl contentFacade;
+
+    private MerchantStore store;
+    private Language language;
+
+    @Before
+    public void setUp() {
+        store = new MerchantStore(1, "DEFAULT", "Default");
+        language = new Language("en");
+    }
+
+    @Test
+    public void getContentBoxReturnsStoredMetadataAndDescription() throws Exception {
+        Content content = new Content();
+        content.setId(42L);
+        content.setCode("footer_note");
+        content.setVisible(true);
+
+        ContentDescription description = new ContentDescription();
+        description.setLanguage(language);
+        description.setDescription("  Keep this text\nexactly.  ");
+        content.setDescriptions(Collections.singletonList(description));
+        when(contentService.getByCode("footer_note", store, language)).thenReturn(content);
+
+        ReadableContentBox result = contentFacade.getContentBox("footer_note", store, language);
+
+        assertEquals("footer_note", result.getCode());
+        assertEquals(Long.valueOf(42L), result.getId());
+        assertFalse("visibility should come from the stored content", !result.isVisible());
+        assertNotNull(result.getDescription());
+        assertEquals("  Keep this text\nexactly.  ", result.getDescription().getDescription());
+    }
+}
