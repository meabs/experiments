+package com.salesmanager.test.shop.security;
+
+import static org.junit.Assert.assertNotNull;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assert.fail;
+
+import java.lang.reflect.Field;
+import java.util.Collections;
+
+import org.junit.Test;
+import org.springframework.security.core.userdetails.UserDetails;
+import org.springframework.security.crypto.bcrypt.BCryptPasswordEncoder;
+
+import com.salesmanager.shop.store.security.customer.JWTCustomerAuthenticationProvider;
+import com.salesmanager.shop.store.security.user.JWTUser;
+
+public class JWTCustomerAuthenticationProviderTest {
+
+    @Test
+    public void authenticatesUsingLoadedCustomerPasswordHash() throws Exception {
+        BCryptPasswordEncoder encoder = new BCryptPasswordEncoder();
+        String encodedPassword = encoder.encode("new-password");
+        UserDetails customer = new JWTUser(1L, "new@example.com", "First", "Last", "new@example.com",
+                encodedPassword, Collections.emptyList(), true, null);
+
+        JWTCustomerAuthenticationProvider provider = new JWTCustomerAuthenticationProvider();
+        provider.setJwtCustomerDetailsService(username -> customer);
+        Field passwordEncoder = JWTCustomerAuthenticationProvider.class.getDeclaredField("passwordEncoder");
+        passwordEncoder.setAccessible(true);
+        passwordEncoder.set(provider, encoder);
+
+        assertNotNull(provider.authenticate(new org.springframework.security.authentication.UsernamePasswordAuthenticationToken(
+                "new@example.com", "new-password")));
+        assertTrue(provider.authenticate(new org.springframework.security.authentication.UsernamePasswordAuthenticationToken(
+                "new@example.com", "new-password")).isAuthenticated());
+        try {
+            provider.authenticate(new org.springframework.security.authentication.UsernamePasswordAuthenticationToken(
+                    "new@example.com", "old-password"));
+            fail("old password must not authenticate");
+        } catch (org.springframework.security.authentication.BadCredentialsException expected) {
+            // expected
+        }
+    }
+}
