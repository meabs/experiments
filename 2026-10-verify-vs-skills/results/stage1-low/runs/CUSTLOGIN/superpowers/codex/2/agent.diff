+package com.salesmanager.test.shop.customer;
+
+import static org.junit.Assert.assertEquals;
+import static org.mockito.Mockito.when;
+
+import java.util.Collections;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.mockito.Mock;
+import org.mockito.MockitoAnnotations;
+import org.springframework.security.crypto.password.PasswordEncoder;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import com.salesmanager.core.business.services.customer.attribute.CustomerOptionService;
+import com.salesmanager.core.business.services.customer.attribute.CustomerOptionValueService;
+import com.salesmanager.core.business.services.reference.country.CountryService;
+import com.salesmanager.core.business.services.reference.language.LanguageService;
+import com.salesmanager.core.business.services.reference.zone.ZoneService;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.customer.PersistableCustomer;
+import com.salesmanager.shop.populator.customer.CustomerPopulator;
+
+public class CustomerPopulatorTest {
+
+    @Mock private PasswordEncoder passwordEncoder;
+    @Mock private CountryService countryService;
+    @Mock private ZoneService zoneService;
+    @Mock private LanguageService languageService;
+    @Mock private CustomerOptionService customerOptionService;
+    @Mock private CustomerOptionValueService customerOptionValueService;
+
+    private CustomerPopulator populator;
+
+    @Before
+    public void setUp() {
+        MockitoAnnotations.openMocks(this);
+        populator = new CustomerPopulator();
+        ReflectionTestUtils.setField(populator, "passwordEncoder", passwordEncoder);
+        ReflectionTestUtils.setField(populator, "countryService", countryService);
+        ReflectionTestUtils.setField(populator, "zoneService", zoneService);
+        ReflectionTestUtils.setField(populator, "languageService", languageService);
+        ReflectionTestUtils.setField(populator, "customerOptionService", customerOptionService);
+        ReflectionTestUtils.setField(populator, "customerOptionValueService", customerOptionValueService);
+    }
+
+    @Test
+    public void updateEmailAndPasswordChangesBothLoginCredentials() throws Exception {
+        MerchantStore store = new MerchantStore();
+        Language language = new Language();
+        when(countryService.getCountriesMap(language)).thenReturn(Collections.emptyMap());
+        when(zoneService.getZones(language)).thenReturn(Collections.emptyMap());
+        when(passwordEncoder.encode("new-password")).thenReturn("encoded-password");
+
+        Customer existing = new Customer();
+        existing.setNick("old@example.com");
+        existing.setPassword("old-hash");
+
+        PersistableCustomer update = new PersistableCustomer();
+        update.setId(1L);
+        update.setEmailAddress("new@example.com");
+        update.setPassword("new-password");
+
+        populator.populate(update, existing, store, language);
+
+        assertEquals("new@example.com", existing.getNick());
+        assertEquals("new@example.com", existing.getEmailAddress());
+        assertEquals("encoded-password", existing.getPassword());
+    }
+}
