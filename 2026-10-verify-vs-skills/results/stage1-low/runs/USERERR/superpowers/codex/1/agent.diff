+package com.salesmanager.test.shop.api;
+
+import static org.junit.Assert.assertEquals;
+
+import java.lang.reflect.Method;
+
+import org.junit.Test;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.ResponseStatus;
+
+import com.salesmanager.shop.store.api.exception.ConflictException;
+import com.salesmanager.shop.store.api.exception.RestErrorHandler;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+
+public class RestErrorHandlerTest {
+
+    @Test
+    public void duplicateUserExceptionIsConflict() throws Exception {
+        Method method = RestErrorHandler.class.getMethod("handleConflictException", ConflictException.class);
+
+        assertEquals(HttpStatus.CONFLICT, method.getAnnotation(ResponseStatus.class).value());
+    }
+
+    @Test
+    public void missingUserExceptionIsNotFound() throws Exception {
+        Method method = RestErrorHandler.class.getMethod("handleServiceException", ResourceNotFoundException.class);
+
+        assertEquals(HttpStatus.NOT_FOUND, method.getAnnotation(ResponseStatus.class).value());
+    }
+
+    @Test
+    public void serviceErrorsWithoutCauseRemainBadRequest() throws Exception {
+        RestErrorHandler handler = new RestErrorHandler();
+
+        assertEquals("bad password", handler.handleServiceException(new ServiceRuntimeException("bad password")).getMessage());
+    }
+}
