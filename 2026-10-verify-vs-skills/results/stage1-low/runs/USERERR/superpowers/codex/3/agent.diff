+package com.salesmanager.test.shop.api;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNotNull;
+
+import org.junit.Test;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.ResponseStatus;
+
+import com.salesmanager.shop.store.api.exception.ConflictException;
+import com.salesmanager.shop.store.api.exception.RestErrorHandler;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+
+public class RestErrorHandlerTest {
+
+    private final RestErrorHandler handler = new RestErrorHandler();
+
+    @Test
+    public void handlesServiceErrorsWithoutCausesAsBadRequest() throws Exception {
+        assertNotNull(handler.handleServiceException(new ServiceRuntimeException("bad request")));
+        assertEquals(HttpStatus.BAD_REQUEST,
+                RestErrorHandler.class.getMethod("handleServiceException", ServiceRuntimeException.class)
+                        .getAnnotation(ResponseStatus.class).value());
+    }
+
+    @Test
+    public void handlesConflictsAsConflict() throws Exception {
+        assertNotNull(handler.handleServiceException(new ConflictException("already exists")));
+        assertEquals(HttpStatus.CONFLICT,
+                RestErrorHandler.class.getMethod("handleServiceException", ConflictException.class)
+                        .getAnnotation(ResponseStatus.class).value());
+    }
+}
