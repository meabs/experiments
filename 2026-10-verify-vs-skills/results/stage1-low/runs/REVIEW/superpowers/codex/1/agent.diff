+package com.salesmanager.test.shop.api.v1.product;
+
+import static org.junit.Assert.assertEquals;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import javax.servlet.http.HttpServletResponse;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.springframework.mock.web.MockHttpServletResponse;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import com.salesmanager.core.business.services.catalog.product.review.ProductReviewService;
+import com.salesmanager.shop.model.catalog.product.PersistableProductReview;
+import com.salesmanager.shop.store.api.v1.product.ProductReviewApi;
+import com.salesmanager.shop.store.controller.product.facade.ProductCommonFacade;
+
+public class ProductReviewApiTest {
+
+  private ProductReviewApi api;
+  private ProductReviewService reviewService;
+  private ProductCommonFacade productCommonFacade;
+
+  @Before
+  public void setUp() {
+    api = new ProductReviewApi();
+    reviewService = mock(ProductReviewService.class);
+    productCommonFacade = mock(ProductCommonFacade.class);
+    ReflectionTestUtils.setField(api, "productReviewService", reviewService);
+    ReflectionTestUtils.setField(api, "productCommonFacade", productCommonFacade);
+  }
+
+  @Test
+  public void createRejectsRatingBelowOneWithBadRequest() throws Exception {
+    PersistableProductReview review = review(0D);
+    MockHttpServletResponse response = new MockHttpServletResponse();
+
+    api.create(7L, review, null, null, null, response);
+
+    assertEquals(HttpServletResponse.SC_BAD_REQUEST, response.getStatus());
+  }
+
+  @Test
+  public void createRejectsDuplicateWithConflict() throws Exception {
+    PersistableProductReview review = review(4D);
+    MockHttpServletResponse response = new MockHttpServletResponse();
+    when(reviewService.getByProductAndCustomer(7L, 11L)).thenReturn(new com.salesmanager.core.model.catalog.product.review.ProductReview());
+
+    api.create(7L, review, null, null, null, response);
+
+    assertEquals(HttpServletResponse.SC_CONFLICT, response.getStatus());
+  }
+
+  private PersistableProductReview review(Double rating) {
+    PersistableProductReview review = new PersistableProductReview();
+    review.setProductId(7L);
+    review.setCustomerId(11L);
+    review.setRating(rating);
+    review.setDescription("review");
+    return review;
+  }
+}
