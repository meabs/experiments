+	private void populateProductCounts(MerchantStore store, List<Category> returnedCategories,
+			List<ReadableCategory> readableCategories) throws ServiceException {
+		List<Category> allCategories = categoryService.listByStore(store);
+		if (allCategories.isEmpty()) {
+			return;
+		}
+
+		Map<Long, Category> categoriesById = allCategories.stream()
+				.collect(Collectors.toMap(Category::getId, Function.identity()));
+		List<Long> categoryIds = allCategories.stream().map(Category::getId).collect(Collectors.toList());
+		Map<Long, Set<Long>> productsByCategory = new HashMap<>();
+		for (Object[] productCategory : categoryService.findProductCategoryIds(store, categoryIds)) {
+			Long productId = ((Number) productCategory[0]).longValue();
+			Long categoryId = ((Number) productCategory[1]).longValue();
+			Category category = categoriesById.get(categoryId);
+			if (category == null) {
+				continue;
+			}
+
+			String lineage = category.getLineage();
+			if (lineage != null) {
+				for (String ancestorId : lineage.split("/")) {
+					if (!ancestorId.isEmpty()) {
+						productsByCategory.computeIfAbsent(Long.valueOf(ancestorId), ignored -> new HashSet<>())
+								.add(productId);
+					}
+				}
+			}
+			productsByCategory.computeIfAbsent(categoryId, ignored -> new HashSet<>()).add(productId);
+		}
+
