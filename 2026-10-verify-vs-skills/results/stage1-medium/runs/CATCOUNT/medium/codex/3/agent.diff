+	@Override
+	public List<Object[]> countProductsByCategoryDescendants(MerchantStore store, List<Long> categoryIds) {
+		String hql = "select target.id, count(distinct product.id) "
+				+ "from Category target, Product product join product.categories productCategory "
+				+ "where target.id in (:cid) "
+				+ "and target.merchantStore = :store "
+				+ "and product.merchantStore = :store "
+				+ "and product.available=true and product.dateAvailable<=:dt "
+				+ "and productCategory.lineage like concat(target.lineage, '%') "
+				+ "group by target.id";
+
+		Query query = this.em.createQuery(hql);
+		query.setParameter("cid", categoryIds);
+		query.setParameter("store", store);
+		query.setParameter("dt", new Date());
+
+		@SuppressWarnings("unchecked")
+		List<Object[]> counts = query.getResultList();
+		return counts;
+	}
 	
