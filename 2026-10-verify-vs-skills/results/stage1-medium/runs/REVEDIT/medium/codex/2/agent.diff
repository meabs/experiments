+	private void refreshProductRating(Product product) throws ServiceException {
+		List<ProductReview> reviews = productReviewRepository.findByProductNoCustomers(product.getId());
+		BigDecimal totalRating = BigDecimal.ZERO;
+		for (ProductReview review : reviews) {
+			if (review.getReviewRating() != null) {
+				totalRating = totalRating.add(BigDecimal.valueOf(review.getReviewRating()));
+			}
+		}
+		int count = reviews.size();
+		product.setProductReviewCount(count);
+		product.setProductReviewAvg(count == 0 ? BigDecimal.ZERO
+				: totalRating.divide(BigDecimal.valueOf(count), 10, java.math.RoundingMode.HALF_UP));
+		productService.update(product);
+	}
