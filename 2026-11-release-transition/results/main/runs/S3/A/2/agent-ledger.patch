+                        + "AND tc.CONSTRAINT_NAME = kcu.CONSTRAINT_NAME "
+                        + "WHERE tc.TABLE_NAME = 'POSTINGS' AND tc.CONSTRAINT_TYPE = 'UNIQUE' "
+                        + "AND kcu.COLUMN_NAME = 'REQUEST_ID'")) {
+            while (rs.next()) {
+                names.add(rs.getString(1));
