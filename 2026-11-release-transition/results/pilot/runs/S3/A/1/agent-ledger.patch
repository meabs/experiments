+    private void migrateToV2(Statement s) throws SQLException {
+        // requestId is a trace id once an idempotency key is supplied, so it
+        // must not remain a database-wide uniqueness constraint.
+        try (PreparedStatement q = db.prepareStatement(
+                "SELECT tc.CONSTRAINT_NAME FROM INFORMATION_SCHEMA.TABLE_CONSTRAINTS tc "
+                        + "JOIN INFORMATION_SCHEMA.CONSTRAINT_COLUMN_USAGE ccu "
+                        + "ON tc.CONSTRAINT_SCHEMA = ccu.CONSTRAINT_SCHEMA "
+                        + "AND tc.CONSTRAINT_NAME = ccu.CONSTRAINT_NAME "
+                        + "WHERE tc.TABLE_NAME = 'POSTINGS' AND tc.CONSTRAINT_TYPE = 'UNIQUE' "
+                        + "AND ccu.COLUMN_NAME = 'REQUEST_ID'")) {
+            try (ResultSet rs = q.executeQuery()) {
+                while (rs.next()) {
+                    s.execute("ALTER TABLE postings DROP CONSTRAINT " + rs.getString(1));
+                }
             }
         }
+        s.execute("ALTER TABLE postings ADD COLUMN idempotency_key VARCHAR(80)");
+        s.execute("CREATE UNIQUE INDEX uq_postings_idempotency_key ON postings(idempotency_key)");
+        s.execute("INSERT INTO schema_version(v) VALUES (2)");
     }
 
