@@ -0,0 +1,42 @@
+package com.salesmanager.test.shop.product;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import java.lang.reflect.Field;
+
+import javax.validation.constraints.Digits;
+import javax.validation.constraints.Max;
+import javax.validation.constraints.Min;
+
+import org.junit.Test;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.salesmanager.shop.model.catalog.product.ProductReviewEntity;
+import com.salesmanager.shop.model.catalog.product.ReadableProductReview;
+import com.salesmanager.shop.model.catalog.product.ReadableProductReviewCustomer;
+
+public class ProductReviewContractTest {
+
+    @Test
+    public void ratingDeclaresWholeNumberOneToFiveConstraint() throws Exception {
+        Field rating = ProductReviewEntity.class.getDeclaredField("rating");
+        assertTrue(rating.getAnnotation(Min.class).value() == 1);
+        assertTrue(rating.getAnnotation(Max.class).value() == 5);
+        assertTrue(rating.getAnnotation(Digits.class).fraction() == 0);
+    }
+
+    @Test
+    public void readableReviewOnlyExposesReviewAuthorFirstName() throws Exception {
+        ReadableProductReview review = new ReadableProductReview();
+        ReadableProductReviewCustomer customer = new ReadableProductReviewCustomer();
+        customer.setFirstName("Ada");
+        review.setCustomer(customer);
+
+        String json = new ObjectMapper().writeValueAsString(review);
+        assertTrue(json.contains("\"firstName\":\"Ada\""));
+        assertFalse(json.contains("email"));
+        assertFalse(json.contains("billing"));
+        assertFalse(json.contains("delivery"));
+    }
+}
