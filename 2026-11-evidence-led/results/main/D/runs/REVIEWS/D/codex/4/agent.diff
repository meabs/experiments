+import com.salesmanager.shop.model.catalog.product.ReadableProductReview;
+
+public class ProductReviewContractTest {
+
+	@Test
+	public void publicReviewHidesProductId() throws Exception {
+		Method productId = ReadableProductReview.class.getMethod("getProductId");
+		assertTrue(productId.isAnnotationPresent(JsonIgnore.class));
+		assertTrue(ReadableProductReview.class.getMethod("getCustomer").getReturnType().getSimpleName()
+				.equals("ReadableProductReviewCustomer"));
+	}
