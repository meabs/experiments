+package com.salesmanager.test.shop.order;
+
+import static org.junit.Assert.assertEquals;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+
+import java.math.BigDecimal;
+
+import org.junit.Test;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.pricing.PricingService;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.orderproduct.OrderProduct;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.mapper.catalog.product.ReadableProductMapper;
+import com.salesmanager.shop.mapper.order.ReadableOrderProductMapper;
+import com.salesmanager.shop.model.order.ReadableOrderProduct;
+
+public class ReadableOrderProductMapperDeletedProductTest {
+
+    @Test
+    public void mapsStoredOrderSnapshotWhenProductWasDeleted() throws Exception {
+        PricingService pricingService = mock(PricingService.class);
+        ProductService productService = mock(ProductService.class);
+        ReadableProductMapper readableProductMapper = mock(ReadableProductMapper.class);
+        MerchantStore store = new MerchantStore();
+        Language language = new Language();
+        OrderProduct orderProduct = new OrderProduct();
+        orderProduct.setSku("deleted-sku");
+        orderProduct.setProductName("Bought before deletion");
+        orderProduct.setProductQuantity(2);
+        orderProduct.setOneTimeCharge(new BigDecimal("12.50"));
+
+        when(pricingService.getDisplayAmount(orderProduct.getOneTimeCharge(), store)).thenReturn("12.50");
+        when(pricingService.getDisplayAmount(new BigDecimal("25.00"), store)).thenReturn("25.00");
+        when(productService.getBySku("deleted-sku", store, language))
+                .thenThrow(new ServiceException("product no longer exists"));
+
+        ReadableOrderProductMapper mapper = new ReadableOrderProductMapper();
+        ReflectionTestUtils.setField(mapper, "pricingService", pricingService);
+        ReflectionTestUtils.setField(mapper, "productService", productService);
+        ReflectionTestUtils.setField(mapper, "readableProductMapper", readableProductMapper);
+
+        ReadableOrderProduct result = mapper.convert(orderProduct, store, language);
+
+        assertEquals("deleted-sku", result.getSku());
+        assertEquals("Bought before deletion", result.getProductName());
+        assertEquals(2, result.getOrderedQuantity());
+        assertEquals("12.50", result.getPrice());
+        assertEquals("25.00", result.getSubTotal());
+    }
+}
