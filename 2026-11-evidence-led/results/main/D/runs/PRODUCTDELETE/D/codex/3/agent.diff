+package com.salesmanager.test.shop.unit;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertNull;
+import static org.junit.Assert.fail;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.when;
+import static org.mockito.ArgumentMatchers.any;
+
+import java.math.BigDecimal;
+
+import org.junit.Test;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.orderproduct.OrderProduct;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.mapper.catalog.product.ReadableProductMapper;
+import com.salesmanager.shop.mapper.order.ReadableOrderProductMapper;
+import com.salesmanager.shop.model.order.ReadableOrderProduct;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.facade.product.ProductFacadeV2Impl;
+
+public class DeletedProductCompatibilityTest {
+
+    @Test
+    public void orderProductUsesSnapshotWhenCatalogProductIsDeleted() throws Exception {
+        ProductService productService = mock(ProductService.class);
+        MerchantStore store = new MerchantStore();
+        Language language = new Language();
+        when(productService.getBySku("deleted-sku", store, language)).thenThrow(new ServiceException("missing"));
+
+        ReadableOrderProductMapper mapper = new ReadableOrderProductMapper();
+        ReflectionTestUtils.setField(mapper, "productService", productService);
+        com.salesmanager.core.business.services.catalog.pricing.PricingService pricingService = mock(com.salesmanager.core.business.services.catalog.pricing.PricingService.class);
+        when(pricingService.getDisplayAmount(any(BigDecimal.class), any(MerchantStore.class))).thenAnswer(invocation -> invocation.getArgument(0, BigDecimal.class).toPlainString());
+        ReflectionTestUtils.setField(mapper, "pricingService", pricingService);
+        ReflectionTestUtils.setField(mapper, "readableProductMapper", mock(ReadableProductMapper.class));
+
+        OrderProduct source = new OrderProduct();
+        source.setSku("deleted-sku");
+        source.setProductName("Historical name");
+        source.setProductQuantity(2);
+        source.setOneTimeCharge(BigDecimal.TEN);
+
+        ReadableOrderProduct result = mapper.convert(source, store, language);
+
+        assertEquals("deleted-sku", result.getSku());
+        assertEquals("Historical name", result.getProductName());
+        assertEquals("20", result.getSubTotal());
+        assertNull(result.getProduct());
+    }
+
+    @Test
+    public void v2LookupReturns404WhenSkuIsMissing() throws Exception {
+        ProductService productService = mock(ProductService.class);
+        MerchantStore store = mock(MerchantStore.class);
+        Language language = new Language();
+        when(store.getCode()).thenReturn("DEFAULT");
+        when(productService.getBySku("deleted-sku", store, language)).thenThrow(new ServiceException("missing"));
+        ProductFacadeV2Impl facade = new ProductFacadeV2Impl();
+        ReflectionTestUtils.setField(facade, "productService", productService);
+
+        try {
+            facade.getProductByCode(store, "deleted-sku", language);
+            fail("Expected a not-found response");
+        } catch (ResourceNotFoundException ex) {
+            assertEquals("404", ex.getErrorCode());
+        }
+    }
+}
