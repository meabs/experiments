@@ -0,0 +1,62 @@
+package com.salesmanager.test.shoppingcart;
+
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import java.util.HashSet;
+
+import org.junit.Assert;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.Mock;
+import org.mockito.junit.MockitoJUnitRunner;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import com.salesmanager.core.business.repositories.shoppingcart.ShoppingCartItemRepository;
+import com.salesmanager.core.business.repositories.shoppingcart.ShoppingCartRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.shoppingcart.ShoppingCartServiceImpl;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@RunWith(MockitoJUnitRunner.class)
+public class ShoppingCartServiceDeletedProductTest {
+
+    @Mock
+    private ShoppingCartRepository shoppingCartRepository;
+
+    @Mock
+    private ShoppingCartItemRepository shoppingCartItemRepository;
+
+    @Mock
+    private ProductService productService;
+
+    @Test
+    public void removesDeletedProductButKeepsCart() throws Exception {
+        MerchantStore store = new MerchantStore();
+        store.setId(1);
+        ShoppingCart cart = new ShoppingCart();
+        cart.setShoppingCartCode("cart-code");
+        cart.setMerchantStore(store);
+        ShoppingCartItem deletedItem = new ShoppingCartItem();
+        deletedItem.setSku("deleted-sku");
+        cart.setLineItems(new HashSet<ShoppingCartItem>());
+        cart.getLineItems().add(deletedItem);
+
+        when(shoppingCartRepository.findByCode(1, "cart-code")).thenReturn(cart);
+        when(productService.getBySku("deleted-sku", store, store.getDefaultLanguage())).thenReturn(null);
+
+        ShoppingCartServiceImpl service = new ShoppingCartServiceImpl(shoppingCartRepository);
+        ReflectionTestUtils.setField(service, "productService", productService);
+        ReflectionTestUtils.setField(service, "shoppingCartItemRepository", shoppingCartItemRepository);
+
+        ShoppingCart result = service.getByCode("cart-code", store);
+
+        Assert.assertSame(cart, result);
+        Assert.assertTrue(result.getLineItems().isEmpty());
+        Assert.assertFalse(result.isObsolete());
+        verify(shoppingCartItemRepository).delete(deletedItem);
+        verify(shoppingCartRepository).saveAndFlush(cart);
+    }
+}
