diff --git a/sm-core/src/test/java/com/salesmanager/test/shoppingcart/ShoppingCartServiceDeletedProductTest.java b/sm-core/src/test/java/com/salesmanager/test/shoppingcart/ShoppingCartServiceDeletedProductTest.java
