+package com.salesmanager.test.common;
+
+import static org.junit.Assert.assertEquals;
+
+import java.lang.reflect.Proxy;
+
+import javax.persistence.Query;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.utils.RepositoryHelper;
+import com.salesmanager.core.model.common.Criteria;
+import com.salesmanager.core.model.common.GenericEntityList;
+
+public class RepositoryHelperTest {
+
+    @Test
+    public void calculatesCeilingPageCountForPagedResults() {
+        int[] firstResult = new int[1];
+        int[] maxResults = new int[1];
+        Query query = (Query) Proxy.newProxyInstance(
+                Query.class.getClassLoader(), new Class<?>[] { Query.class },
+                (proxy, method, args) -> {
+                    if ("setFirstResult".equals(method.getName())) {
+                        firstResult[0] = (Integer) args[0];
+                        return proxy;
+                    }
+                    if ("setMaxResults".equals(method.getName())) {
+                        maxResults[0] = (Integer) args[0];
+                        return proxy;
+                    }
+                    if ("toString".equals(method.getName())) {
+                        return "query";
+                    }
+                    return null;
+                });
+
+        Criteria criteria = new Criteria();
+        criteria.setLegacyPagination(false);
+        criteria.setStartPage(1);
+        criteria.setPageSize(2);
+        GenericEntityList<Object> results = new GenericEntityList<>();
+
+        RepositoryHelper.paginateQuery(query, 5, results, criteria);
+
+        assertEquals(2, firstResult[0]);
+        assertEquals(2, maxResults[0]);
+        assertEquals(3, results.getTotalPages());
+        assertEquals(5, results.getTotalCount());
+    }
+}
