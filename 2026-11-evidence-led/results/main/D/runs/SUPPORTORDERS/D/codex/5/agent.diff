+++ b/sm-core/src/test/java/com/salesmanager/test/business/utils/RepositoryHelperTest.java
@@ -0,0 +1,47 @@
+package com.salesmanager.test.business.utils;
+
+import static org.junit.Assert.assertEquals;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+
+import javax.persistence.Query;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.utils.RepositoryHelper;
+import com.salesmanager.core.model.common.Criteria;
+import com.salesmanager.core.model.common.GenericEntityList;
+
+public class RepositoryHelperTest {
+
+    @Test
+    public void pageCountUsesCeilingAndZeroBasedOffset() {
+        Query query = mock(Query.class);
+        Criteria criteria = new Criteria();
+        criteria.setLegacyPagination(false);
+        criteria.setPageSize(10);
+        criteria.setStartPage(1);
+        GenericEntityList<Object> result = new GenericEntityList<>();
+
+        RepositoryHelper.paginateQuery(query, 21, result, criteria);
+
+        assertEquals(21, result.getTotalCount());
+        assertEquals(3, result.getTotalPages());
+        verify(query).setFirstResult(10);
+        verify(query).setMaxResults(10);
+    }
+
+    @Test
+    public void zeroPageSizeDoesNotFailOrLoseTotals() {
+        Query query = mock(Query.class);
+        Criteria criteria = new Criteria();
+        criteria.setLegacyPagination(false);
+        criteria.setPageSize(0);
+        GenericEntityList<Object> result = new GenericEntityList<>();
+
+        RepositoryHelper.paginateQuery(query, 4, result, criteria);
+
+        assertEquals(4, result.getTotalCount());
+        assertEquals(1, result.getTotalPages());
+    }
+}
