diff --git a/sm-core/src/test/java/com/salesmanager/test/core/business/utils/RepositoryHelperTest.java b/sm-core/src/test/java/com/salesmanager/test/core/business/utils/RepositoryHelperTest.java
new file mode 100644
index 0000000..5dc4a50
--- /dev/null
+++ b/sm-core/src/test/java/com/salesmanager/test/core/business/utils/RepositoryHelperTest.java
@@ -0,0 +1,43 @@
+package com.salesmanager.test.core.business.utils;
+
+import static org.junit.Assert.assertEquals;
+
+import java.lang.reflect.Proxy;
+
+import javax.persistence.Query;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.utils.RepositoryHelper;
+import com.salesmanager.core.model.common.GenericEntityList;
+import com.salesmanager.core.model.order.OrderCriteria;
+
+public class RepositoryHelperTest {
+
+    @Test
+    public void newPaginationUsesRequestedPageAndCeilingPageCount() {
+        Query query = (Query) Proxy.newProxyInstance(Query.class.getClassLoader(),
+                new Class<?>[] { Query.class }, (proxy, method, args) -> {
+                    if (method.getName().equals("setFirstResult") || method.getName().equals("setMaxResults")) {
+                        return proxy;
+                    }
+                    if (method.getReturnType().equals(boolean.class)) {
+                        return false;
+                    }
+                    if (method.getReturnType().equals(int.class)) {
+                        return 0;
+                    }
+                    return null;
+                });
+        OrderCriteria criteria = new OrderCriteria();
+        criteria.setLegacyPagination(false);
+        criteria.setStartPage(2);
+        criteria.setPageSize(10);
+        GenericEntityList<Object> entityList = new GenericEntityList<>();
+
+        RepositoryHelper.paginateQuery(query, 20, entityList, criteria);
+
+        assertEquals(2, entityList.getTotalPages());
+        assertEquals(20, entityList.getTotalCount());
+    }
+}
