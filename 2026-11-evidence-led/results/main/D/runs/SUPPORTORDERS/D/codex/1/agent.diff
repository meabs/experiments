--- /dev/null
+++ b/sm-core/src/test/java/com/salesmanager/test/utils/RepositoryHelperTest.java
@@ -0,0 +1,33 @@
+package com.salesmanager.test.utils;
+
+import static org.junit.Assert.assertEquals;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+
+import javax.persistence.Query;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.utils.RepositoryHelper;
+import com.salesmanager.core.model.common.Criteria;
+import com.salesmanager.core.model.common.GenericEntityList;
+
+public class RepositoryHelperTest {
+
+    @Test
+    public void calculatesCeilingPageCountAndZeroBasedOffset() {
+        Query query = mock(Query.class);
+        Criteria criteria = new Criteria();
+        criteria.setLegacyPagination(false);
+        criteria.setPageSize(2);
+        criteria.setStartPage(2);
+        GenericEntityList<?> result = new GenericEntityList<>();
+
+        RepositoryHelper.paginateQuery(query, 5, result, criteria);
+
+        assertEquals(3, result.getTotalPages());
+        assertEquals(5, result.getTotalCount());
+        verify(query).setFirstResult(4);
+        verify(query).setMaxResults(2);
+    }
+}
