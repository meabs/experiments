index 0000000..c66d61b
--- /dev/null
+++ b/sm-core/src/test/java/com/salesmanager/test/business/utils/RepositoryHelperTest.java
@@ -0,0 +1,33 @@
+package com.salesmanager.test.business.utils;
+
+import static org.junit.Assert.assertEquals;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.verify;
+
+import javax.persistence.Query;
+
+import org.junit.Test;
+
+import com.salesmanager.core.business.utils.RepositoryHelper;
+import com.salesmanager.core.model.common.GenericEntityList;
+import com.salesmanager.core.model.order.OrderCriteria;
+
+public class RepositoryHelperTest {
+
+    @Test
+    public void paginatesZeroBasedAndReportsCeilingPageCount() {
+        Query query = mock(Query.class);
+        OrderCriteria criteria = new OrderCriteria();
+        criteria.setLegacyPagination(false);
+        criteria.setStartPage(1);
+        criteria.setPageSize(25);
+        GenericEntityList<Object> result = new GenericEntityList<>();
+
+        RepositoryHelper.paginateQuery(query, 50, result, criteria);
+
+        verify(query).setFirstResult(25);
+        verify(query).setMaxResults(25);
+        assertEquals(2, result.getTotalPages());
+        assertEquals(50, result.getTotalCount());
+    }
+}
