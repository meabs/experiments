@@ -0,0 +1,63 @@
+package com.salesmanager.core.business.services.catalog.product.availability;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+
+@Service("stockService")
+public class StockServiceImpl implements StockService {
+
+    @Inject
+    private ProductAvailabilityService productAvailabilityService;
+
+    @Override
+    public int getStock(Product product) {
+        Integer quantity = availability(product).getProductQuantity();
+        return quantity == null ? 0 : quantity;
+    }
+
+    @Override
+    public void requireStock(Product product, int quantity) {
+        if (quantity < 0 || getStock(product) < quantity) {
+            throw new IllegalArgumentException("Insufficient stock for product " + product.getSku());
+        }
+    }
+
+    @Override
+    public void decrement(Product product, int quantity) {
+        requireStock(product, quantity);
+        change(product, -quantity);
+    }
+
+    @Override
+    public void increment(Product product, int quantity) {
+        if (quantity < 0) {
+            throw new IllegalArgumentException("Quantity must not be negative");
+        }
+        change(product, quantity);
+    }
+
+    private void change(Product product, int amount) {
+        ProductAvailability availability = availability(product);
+        availability.setProductQuantity(getStock(product) + amount);
+        try {
+            productAvailabilityService.saveOrUpdate(availability);
+        } catch (ServiceException e) {
+            throw new IllegalStateException("Unable to update stock for product " + product.getSku(), e);
+        }
+    }
+
+    private ProductAvailability availability(Product product) {
+        if (product == null || product.getAvailabilities() == null || product.getAvailabilities().isEmpty()) {
+            throw new IllegalArgumentException("Product has no stock");
+        }
+        return product.getAvailabilities().stream()
+                .filter(a -> a.getProductVariant() == null && a.getRegionVariant() == null)
+                .findFirst()
+                .orElseGet(() -> product.getAvailabilities().iterator().next());
+    }
+}
