+package com.salesmanager.core.model.catalog.product.inventory;
+
+import java.util.Collection;
+
+import org.apache.commons.lang3.StringUtils;
+
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.variant.ProductVariant;
+
+public final class StockUtils {
+
+    private StockUtils() {
+    }
+
+    public static ProductAvailability availability(Product product, String sku) {
+        Collection<ProductAvailability> availabilities = product.getAvailabilities();
+        ProductVariant variant = product.getVariants().stream()
+                .filter(v -> StringUtils.equals(v.getSku(), sku))
+                .findFirst().orElse(null);
+        if (variant != null && variant.getAvailabilities() != null && !variant.getAvailabilities().isEmpty()) {
+            availabilities = variant.getAvailabilities();
+        }
+        if (availabilities == null || availabilities.isEmpty()) {
+            return null;
+        }
+        for (ProductAvailability availability : availabilities) {
+            if (availability.getProductVariant() == null
+                    && StringUtils.isBlank(availability.getRegionVariant())) {
+                return availability;
+            }
+        }
+        return availabilities.iterator().next();
+    }
+
+    public static int quantity(Product product, String sku) {
+        ProductAvailability availability = availability(product, sku);
+        return availability == null || availability.getProductQuantity() == null
+                ? 0 : availability.getProductQuantity();
+    }
+}
