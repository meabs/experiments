+package com.salesmanager.test.catalog;
+
+import java.util.HashSet;
+
+import org.junit.Assert;
+import org.junit.Test;
+
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.inventory.StockUtils;
+
+public class StockUtilsTest {
+
+    @Test
+    public void selectsDefaultStockAndTreatsMissingStockAsZero() {
+        Product product = new Product();
+        product.setSku("SKU-1");
+        ProductAvailability regional = new ProductAvailability();
+        regional.setRegionVariant("REGION");
+        regional.setProductQuantity(99);
+        ProductAvailability defaultAvailability = new ProductAvailability();
+        defaultAvailability.setProductQuantity(4);
+        product.setAvailabilities(new HashSet<>());
+        product.getAvailabilities().add(regional);
+        product.getAvailabilities().add(defaultAvailability);
+
+        Assert.assertEquals(4, StockUtils.quantity(product, "SKU-1"));
+
+        Product empty = new Product();
+        empty.setAvailabilities(new HashSet<>());
+        Assert.assertEquals(0, StockUtils.quantity(empty, "SKU-2"));
+    }
+}
