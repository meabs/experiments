+	private void reserveInventory(Set<OrderProduct> products, MerchantStore store) throws ServiceException {
+		if (CollectionUtils.isEmpty(products)) {
+			throw new ServiceException(ServiceException.EXCEPTION_INVENTORY_MISMATCH);
+		}
+		for (OrderProduct orderProduct : products) {
+			Product product;
+			try {
+				product = productService.getBySku(orderProduct.getSku(), store);
+			} catch (Exception e) {
+				throw new ServiceException(ServiceException.EXCEPTION_INVENTORY_MISMATCH, e.getMessage());
+			}
+			ProductAvailability availability = defaultAvailability(product);
+			int stock = availability == null || availability.getProductQuantity() == null ? 0
+					: availability.getProductQuantity();
+			if (orderProduct.getProductQuantity() <= 0 || stock < orderProduct.getProductQuantity()) {
+				throw new ServiceException(ServiceException.EXCEPTION_INVENTORY_MISMATCH);
+			}
+		}
+		for (OrderProduct orderProduct : products) {
+			Product product = productService.getBySku(orderProduct.getSku(), store);
+			ProductAvailability availability = defaultAvailability(product);
+			availability.setProductQuantity(availability.getProductQuantity() - orderProduct.getProductQuantity());
+			productService.update(product);
+		}
+	}
+
+	private ProductAvailability defaultAvailability(Product product) {
+		return product.getAvailabilities().stream()
+				.filter(a -> a.getProductVariant() == null && Constants.ALL_REGIONS.equals(a.getRegion()))
+				.findFirst().orElse(product.getAvailabilities().stream().findFirst().orElse(null));
+	}
