+package com.salesmanager.test.catalog;
+
+import static org.junit.Assert.assertFalse;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashSet;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.Mock;
+import org.mockito.junit.MockitoJUnitRunner;
+
+import com.salesmanager.core.business.repositories.catalog.category.CategoryDescriptionRepository;
+import com.salesmanager.core.business.repositories.catalog.category.CategoryRepository;
+import com.salesmanager.core.business.repositories.catalog.category.PageableCategoryRepository;
+import com.salesmanager.core.business.services.catalog.category.CategoryServiceImpl;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@RunWith(MockitoJUnitRunner.class)
+public class CategoryDeletionTest {
+
+	@Mock
+	private CategoryRepository categoryRepository;
+
+	@Mock
+	private ProductService productService;
+
+	@Mock
+	private PageableCategoryRepository pageableCategoryRepository;
+
+	@Mock
+	private CategoryDescriptionRepository categoryDescriptionRepository;
+
+	private CategoryServiceImpl categoryService;
+
+	@Before
+	public void setUp() {
+		categoryService = new CategoryServiceImpl(categoryRepository);
+		org.springframework.test.util.ReflectionTestUtils.setField(categoryService, "productService", productService);
+		org.springframework.test.util.ReflectionTestUtils.setField(categoryService, "pageableCategoryRepository",
+				pageableCategoryRepository);
+		org.springframework.test.util.ReflectionTestUtils.setField(categoryService, "categoryDescriptionRepository",
+				categoryDescriptionRepository);
+	}
+
+	@Test
+	public void deleteCategoryKeepsProductAndRemovesOnlyDeletedCategoryMemberships() throws Exception {
+		MerchantStore store = new MerchantStore();
+		store.setId(1);
+
+		Category deletedCategory = category(10L, "/", store);
+		Category childCategory = category(11L, "/10/", store);
+		Category retainedCategory = category(12L, "/", store);
+
+		Product product = new Product();
+		product.setId(20L);
+		product.setCategories(new HashSet<>(Arrays.asList(deletedCategory, childCategory, retainedCategory)));
+
+		when(categoryRepository.findByLineage(store.getId(), "/10/")).thenReturn(new ArrayList<>(Arrays.asList(childCategory)));
+		when(categoryRepository.findByIdAndStore(10L, store.getId())).thenReturn(deletedCategory);
+		when(productService.getProducts(Arrays.asList(10L, 11L))).thenReturn(Arrays.asList(product));
+		when(productService.getById(20L)).thenReturn(product);
+
+		categoryService.delete(deletedCategory);
+
+		assertFalse(product.getCategories().contains(deletedCategory));
+		assertFalse(product.getCategories().contains(childCategory));
+		verify(productService).update(product);
+		verify(productService, never()).delete(product);
+		verify(categoryRepository).delete(deletedCategory);
+	}
+
+	private Category category(Long id, String lineage, MerchantStore store) {
+		Category category = new Category();
+		category.setId(id);
+		category.setLineage(lineage);
+		category.setMerchantStore(store);
+		return category;
+	}
+}
