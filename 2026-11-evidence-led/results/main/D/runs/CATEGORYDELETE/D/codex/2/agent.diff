+package com.salesmanager.test.catalog;
+
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import java.util.Arrays;
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+
+import org.junit.Test;
+import org.junit.Before;
+import org.junit.runner.RunWith;
+import org.mockito.InjectMocks;
+import org.mockito.Mock;
+import org.mockito.junit.MockitoJUnitRunner;
+
+import com.salesmanager.core.business.repositories.catalog.category.CategoryDescriptionRepository;
+import com.salesmanager.core.business.repositories.catalog.category.CategoryRepository;
+import com.salesmanager.core.business.repositories.catalog.category.PageableCategoryRepository;
+import com.salesmanager.core.business.services.catalog.category.CategoryServiceImpl;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@RunWith(MockitoJUnitRunner.class)
+public class CategoryServiceDeleteTest {
+
+    @Mock
+    private CategoryRepository categoryRepository;
+
+    @Mock
+    private ProductService productService;
+
+    @Mock
+    private PageableCategoryRepository pageableCategoryRepository;
+
+    @Mock
+    private CategoryDescriptionRepository categoryDescriptionRepository;
+
+    @InjectMocks
+    private CategoryServiceImpl categoryService;
+
+    @Before
+    public void injectDependencies() {
+        org.springframework.test.util.ReflectionTestUtils.setField(categoryService, "productService", productService);
+        org.springframework.test.util.ReflectionTestUtils.setField(categoryService, "categoryDescriptionRepository",
+                categoryDescriptionRepository);
+        org.springframework.test.util.ReflectionTestUtils.setField(categoryService, "pageableCategoryRepository",
+                pageableCategoryRepository);
+    }
+
+    @Test
+    public void deleteRemovesCategoryLinksButKeepsProducts() throws Exception {
+        MerchantStore store = new MerchantStore();
+        store.setId(1);
+
+        Category deleted = category(10L, "/", store);
+        Category child = category(11L, "/10/", store);
+        Category other = category(12L, "/", store);
+
+        Product onlyInDeletedCategory = product(20L, deleted);
+        Product inDeletedAndOtherCategory = product(21L, deleted, other);
+        Product onlyInDeletedChildCategory = product(22L, child);
+
+        when(categoryRepository.findByLineage(store.getId(), "/10/"))
+                .thenReturn(new ArrayList<>(List.of(child)));
+        when(categoryRepository.findByIdAndStore(10L, store.getId()))
+                .thenReturn(deleted);
+        when(productService.getProducts(Arrays.asList(10L, 11L)))
+                .thenReturn(Arrays.asList(onlyInDeletedCategory, inDeletedAndOtherCategory,
+                        onlyInDeletedChildCategory));
+        when(productService.getById(20L)).thenReturn(onlyInDeletedCategory);
+        when(productService.getById(21L)).thenReturn(inDeletedAndOtherCategory);
+        when(productService.getById(22L)).thenReturn(onlyInDeletedChildCategory);
+
+        categoryService.delete(deleted);
+
+        org.junit.Assert.assertTrue(onlyInDeletedCategory.getCategories().isEmpty());
+        org.junit.Assert.assertTrue(onlyInDeletedChildCategory.getCategories().isEmpty());
+        org.junit.Assert.assertEquals(new HashSet<>(Arrays.asList(other)),
+                inDeletedAndOtherCategory.getCategories());
+        verify(productService).update(onlyInDeletedCategory);
+        verify(productService).update(inDeletedAndOtherCategory);
+        verify(productService).update(onlyInDeletedChildCategory);
+        verify(productService, never()).delete(org.mockito.ArgumentMatchers.any(Product.class));
+        verify(categoryRepository).delete(deleted);
+    }
+
+    private Category category(Long id, String lineage, MerchantStore store) {
+        Category category = new Category();
+        category.setId(id);
+        category.setLineage(lineage);
+        category.setMerchantStore(store);
+        return category;
+    }
+
+    private Product product(Long id, Category... categories) {
+        Product product = new Product();
+        product.setId(id);
+        product.setCategories(new HashSet<>(Arrays.asList(categories)));
+        return product;
+    }
+}
