@@ -0,0 +1,74 @@
+package com.salesmanager.test.catalog;
+
+import static org.junit.Assert.assertTrue;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.ArgumentMatchers.anyList;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import java.util.Arrays;
+import java.util.HashSet;
+
+import org.junit.Test;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import com.salesmanager.core.business.repositories.catalog.category.CategoryDescriptionRepository;
+import com.salesmanager.core.business.repositories.catalog.category.CategoryRepository;
+import com.salesmanager.core.business.repositories.catalog.category.PageableCategoryRepository;
+import com.salesmanager.core.business.services.catalog.category.CategoryServiceImpl;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+import static org.mockito.Mockito.mock;
+
+public class CategoryServiceDeleteTest {
+
+    @Test
+    public void deleteRemovesCategoryLinksButKeepsProducts() throws Exception {
+        CategoryRepository categoryRepository = mock(CategoryRepository.class);
+        CategoryDescriptionRepository descriptionRepository = mock(CategoryDescriptionRepository.class);
+        PageableCategoryRepository pageableCategoryRepository = mock(PageableCategoryRepository.class);
+        ProductService productService = mock(ProductService.class);
+
+        CategoryServiceImpl service = new CategoryServiceImpl(categoryRepository);
+        ReflectionTestUtils.setField(service, "categoryDescriptionRepository", descriptionRepository);
+        ReflectionTestUtils.setField(service, "pageableCategoryRepository", pageableCategoryRepository);
+        ReflectionTestUtils.setField(service, "productService", productService);
+
+        MerchantStore store = new MerchantStore();
+        store.setId(7);
+
+        Category root = category(10L, "/10/", store);
+        Category child = category(11L, "/10/11/", store);
+        Category other = category(20L, "/20/", store);
+        Product product = new Product();
+        product.setId(30L);
+        product.setCategories(new HashSet<>(Arrays.asList(root, child, other)));
+
+        when(categoryRepository.findByLineage(store.getId(), root.getLineage())).thenReturn(Arrays.asList(child));
+        when(categoryRepository.findByIdAndStore(root.getId(), store.getId())).thenReturn(root);
+        when(descriptionRepository.listByCategoryId(root.getId())).thenReturn(Arrays.asList());
+        when(productService.getProducts(anyList())).thenReturn(Arrays.asList(product));
+        when(productService.getById(product.getId())).thenReturn(product);
+
+        service.delete(root);
+
+        assertTrue(product.getCategories().contains(other));
+        assertTrue(!product.getCategories().contains(root));
+        assertTrue(!product.getCategories().contains(child));
+        verify(productService).update(product);
+        verify(productService, never()).delete(any(Product.class));
+        verify(categoryRepository).delete(root);
+    }
+
+    private Category category(Long id, String lineage, MerchantStore store) {
+        Category category = new Category();
+        category.setId(id);
+        category.setLineage(lineage);
+        category.setMerchantStore(store);
+        return category;
+    }
+}
