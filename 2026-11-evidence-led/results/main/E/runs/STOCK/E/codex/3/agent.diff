+	private void validateStock(Product product, int quantity) {
+		if (quantity > stock(product)) {
+			throw new InventoryConflictException("Insufficient stock for product " + product.getSku());
+		}
+	}
+
+	private int stock(Product product) {
+		if (CollectionUtils.isEmpty(product.getAvailabilities())) return 0;
+		ProductAvailability selected = product.getAvailabilities().iterator().next();
+		for (ProductAvailability availability : product.getAvailabilities()) {
+			if (com.salesmanager.core.business.constants.Constants.ALL_REGIONS.equals(availability.getRegion())) {
+				selected = availability;
+				break;
+			}
+		}
+		return selected.getProductQuantity() == null ? 0 : selected.getProductQuantity();
+	}
