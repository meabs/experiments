@@ -0,0 +1,28 @@
+package com.salesmanager.core.business.utils;
+
+import java.util.Set;
+
+import com.salesmanager.core.business.constants.Constants;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+
+/** The stock used by the storefront: the product's all-regions/default row. */
+public final class InventoryUtils {
+    private InventoryUtils() { }
+
+    public static ProductAvailability stockAvailability(Product product) {
+        Set<ProductAvailability> rows = product.getAvailabilities();
+        if (rows == null || rows.isEmpty()) return null;
+        ProductAvailability first = rows.iterator().next();
+        for (ProductAvailability row : rows) {
+            if (Constants.ALL_REGIONS.equals(row.getRegion()) && row.getProductVariant() == null
+                    && row.getRegionVariant() == null) return row;
+        }
+        return first;
+    }
+
+    public static int stock(Product product) {
+        ProductAvailability row = stockAvailability(product);
+        return row == null || row.getProductQuantity() == null ? 0 : row.getProductQuantity();
+    }
+}
