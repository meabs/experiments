+package com.salesmanager.core.business.services.catalog.inventory;
+
+import java.util.Collection;
+import java.util.HashMap;
+import java.util.Map;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.salesmanager.core.business.exception.InventoryMismatchException;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.availability.ProductAvailabilityService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.Order;
+import com.salesmanager.core.model.order.orderproduct.OrderProduct;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service("inventoryService")
+public class InventoryServiceImpl implements InventoryService {
+    @Inject private ProductService productService;
+    @Inject private ProductAvailabilityService availabilityService;
+
+    @Override
+    public void validate(Collection<ShoppingCartItem> items, MerchantStore store) {
+        Map<Product, Integer> quantities = new HashMap<>();
+        for (ShoppingCartItem item : items) {
+            quantities.merge(item.getProduct(), item.getQuantity(), Integer::sum);
+        }
+        validate(quantities);
+    }
+
+    @Override
+    public void validate(Map<Product, Integer> quantities) {
+        for (Map.Entry<Product, Integer> entry : quantities.entrySet()) {
+            ProductAvailability availability = defaultAvailability(entry.getKey());
+            if (availability == null || availability.getProductQuantity() == null
+                    || availability.getProductQuantity() < entry.getValue()) {
+                throw new InventoryMismatchException("Insufficient stock for product " + entry.getKey().getSku());
+            }
+        }
+    }
+
+    @Override
+    @Transactional
+    public void decrement(Collection<ShoppingCartItem> items, MerchantStore store) {
+        Map<Product, Integer> quantities = new HashMap<>();
+        for (ShoppingCartItem item : items) {
+            quantities.merge(item.getProduct(), item.getQuantity(), Integer::sum);
+        }
+        validate(quantities);
+        for (Map.Entry<Product, Integer> entry : quantities.entrySet()) {
+            ProductAvailability availability = defaultAvailability(entry.getKey());
+            availability.setProductQuantity(availability.getProductQuantity() - entry.getValue());
+            save(availability);
+        }
+    }
+
+    @Override
+    @Transactional
+    public void restore(Order order, MerchantStore store) {
+        for (OrderProduct orderProduct : order.getOrderProducts()) {
+            Product product;
+            try {
+                product = productService.getBySku(orderProduct.getSku(), store);
+            } catch (ServiceException e) {
+                throw new InventoryMismatchException("Unable to load product " + orderProduct.getSku());
+            }
+            if (product == null) {
+                throw new InventoryMismatchException("Product not found for order item " + orderProduct.getSku());
+            }
+            ProductAvailability availability = defaultAvailability(product);
+            if (availability == null) {
+                throw new InventoryMismatchException("No stock record for product " + orderProduct.getSku());
+            }
+            availability.setProductQuantity(availability.getProductQuantity() + orderProduct.getProductQuantity());
+            save(availability);
+        }
+    }
+
+    private ProductAvailability defaultAvailability(Product product) {
+        return product.getAvailabilities().stream()
+                .filter(a -> a.getProductVariant() == null)
+                .filter(a -> a.getRegionVariant() == null || a.getRegionVariant().isEmpty())
+                .filter(a -> a.getRegion() == null || "*".equals(a.getRegion()))
+                .findFirst()
+                .orElse(product.getAvailabilities().stream().findFirst().orElse(null));
+    }
+
+    private void save(ProductAvailability availability) {
+        try {
+            availabilityService.saveOrUpdate(availability);
+        } catch (ServiceException e) {
+            throw new InventoryMismatchException("Unable to update stock");
+        }
+    }
+}
