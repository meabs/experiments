--- /dev/null
+++ b/sm-shop/src/main/java/com/salesmanager/shop/store/service/StockService.java
@@ -0,0 +1,92 @@
+package com.salesmanager.shop.store.service;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+import org.springframework.stereotype.Service;
+
+import javax.inject.Inject;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.List;
+
+@Service
+public class StockService {
+    @Inject
+    private ProductService productService;
+
+    public int stock(Product product, String sku) {
+        ProductAvailability availability = availability(product, sku);
+        return availability == null || availability.getProductQuantity() == null ? 0 : availability.getProductQuantity();
+    }
+
+    public void validate(Product product, String sku, int quantity) {
+        if (quantity < 0 || stock(product, sku) < quantity) {
+            throw new StockConflictException("Insufficient stock for product " + sku);
+        }
+    }
+
+    public void reserve(Collection<ShoppingCartItem> items, MerchantStore store) {
+        List<ProductAvailability> changed = new ArrayList<>();
+        for (ShoppingCartItem item : items) {
+            Product product;
+            try {
+                product = productService.getBySku(item.getSku(), store, store.getDefaultLanguage());
+            } catch (Exception e) {
+                throw new StockConflictException("Unable to find product " + item.getSku());
+            }
+            validate(product, item.getSku(), item.getQuantity());
+            for (ProductAvailability availability : matching(product, item.getSku())) {
+                availability.setProductQuantity(availability.getProductQuantity() - item.getQuantity());
+                changed.add(availability);
+            }
+        }
+        // Product availability is cascaded from Product. Saving each product also
+        // keeps the quantity returned by the product APIs in sync.
+        for (ProductAvailability availability : changed) {
+            try {
+                productService.saveProduct(availability.getProduct());
+            } catch (Exception e) {
+                throw new StockConflictException("Unable to update stock");
+            }
+        }
+    }
+
+    public void release(com.salesmanager.core.model.order.Order order) {
+        for (com.salesmanager.core.model.order.orderproduct.OrderProduct item : order.getOrderProducts()) {
+            Product product;
+            try {
+                product = productService.getBySku(item.getSku(), order.getMerchant(), order.getMerchant().getDefaultLanguage());
+            } catch (Exception e) {
+                throw new StockConflictException("Unable to find product " + item.getSku());
+            }
+            for (ProductAvailability availability : matching(product, item.getSku())) {
+                availability.setProductQuantity(availability.getProductQuantity() + item.getProductQuantity());
+                try {
+                    productService.saveProduct(product);
+                } catch (Exception e) {
+                    throw new StockConflictException("Unable to update stock");
+                }
+            }
+        }
+    }
+
+    private ProductAvailability availability(Product product, String sku) {
+        if (product == null) return null;
+        return matching(product, sku).stream().findFirst().orElse(null);
+    }
+
+    private List<ProductAvailability> matching(Product product, String sku) {
+        List<ProductAvailability> result = new ArrayList<>();
+        if (product == null || product.getAvailabilities() == null) return result;
+        for (ProductAvailability a : product.getAvailabilities()) {
+            boolean variant = a.getProductVariant() != null;
+            if ((variant && sku.equals(a.getSku())) || (!variant && (sku.equals(product.getSku()) || a.getSku() == null))) {
+                result.add(a);
+            }
+        }
+        return result;
+    }
+}
