+package com.salesmanager.shop.store.service;
+
+public class StockConflictException extends RuntimeException {
+    private static final long serialVersionUID = 1L;
+
+    public StockConflictException(String message) {
+        super(message);
+    }
+}
diff --git a/sm-shop/src/main/java/com/salesmanager/shop/store/service/StockService.java b/sm-shop/src/main/java/com/salesmanager/shop/store/service/StockService.java
new file mode 100644
