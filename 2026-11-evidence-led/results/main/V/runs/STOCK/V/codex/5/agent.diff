+	private void validateCartStock(ShoppingCart cart) throws Exception {
+		if (CollectionUtils.isEmpty(cart.getLineItems())) return;
+		Map<String, Integer> requested = new java.util.HashMap<>();
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem item : cart.getLineItems()) {
+			if (item.getQuantity() > 0) requested.merge(item.getSku(), item.getQuantity(), Integer::sum);
+		}
+		for (Map.Entry<String, Integer> entry : requested.entrySet()) {
+			Product product = productService.getBySku(entry.getKey(), cart.getMerchantStore(),
+					cart.getMerchantStore().getDefaultLanguage());
+			if (product == null || CollectionUtils.isEmpty(product.getAvailabilities()))
+				throw new GenericRuntimeException("409", "Product " + entry.getKey() + " has no stock");
+			ProductAvailability availability = product.getAvailabilities().iterator().next();
+			int stock = availability.getProductQuantity() == null ? 0 : availability.getProductQuantity();
+			if (entry.getValue() > stock)
+				throw new GenericRuntimeException("409", "Insufficient stock for product " + entry.getKey());
+		}
+	}
+
