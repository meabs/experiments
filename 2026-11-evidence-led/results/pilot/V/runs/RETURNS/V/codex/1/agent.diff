+package com.salesmanager.shop.store.api.v1.order;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Collectors;
+import java.util.stream.Stream;
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestMethod;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.order.OrderService;
+import com.salesmanager.core.business.services.payments.TransactionService;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.Order;
+import com.salesmanager.core.model.order.orderproduct.OrderProduct;
+import com.salesmanager.core.model.order.OrderReturn;
+import com.salesmanager.core.model.order.OrderReturnLine;
+import com.salesmanager.core.model.order.OrderTotal;
+import com.salesmanager.core.model.order.OrderTotalType;
+import com.salesmanager.core.model.order.orderstatus.OrderStatus;
+import com.salesmanager.core.model.order.orderstatus.OrderStatusHistory;
+import com.salesmanager.core.model.payments.Transaction;
+import com.salesmanager.core.model.payments.TransactionType;
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.model.order.PersistableReturn;
+import com.salesmanager.shop.model.order.ReadableReturn;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.utils.AuthorizationUtils;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController @RequestMapping("/api/v1")
+public class OrderReturnApi {
+    @Inject private OrderService orderService; @Inject private TransactionService transactionService;
+    @Inject private ProductService productService; @Inject private AuthorizationUtils authorizationUtils;
+    private void authorize(MerchantStore s){authorizationUtils.authorizeUser(authorizationUtils.authenticatedUser(),Stream.of(Constants.GROUP_SUPERADMIN,Constants.GROUP_ADMIN,Constants.GROUP_ADMIN_ORDER,Constants.GROUP_ADMIN_RETAIL).collect(Collectors.toList()),s);}
+    @RequestMapping(value="/private/orders/{id}/returns",method=RequestMethod.GET) @ResponseBody
+    public List<ReadableReturn> list(@PathVariable Long id,@ApiIgnore MerchantStore s){authorize(s);return order(id,s).getReturns().stream().map(this::read).collect(Collectors.toList());}
+    @RequestMapping(value="/private/orders/{id}/returns",method=RequestMethod.POST) @ResponseStatus(HttpStatus.CREATED) @ResponseBody
+    public ReadableReturn create(@PathVariable Long id,@RequestBody PersistableReturn body,@ApiIgnore MerchantStore s) throws Exception {authorize(s);return read(make(order(id,s),body,s));}
+    @RequestMapping(value="/private/orders/{id}/refund",method=RequestMethod.POST) @ResponseStatus(HttpStatus.CREATED) @ResponseBody
+    public ReadableReturn refund(@PathVariable Long id,@ApiIgnore MerchantStore s) throws Exception {Order o=order(id,s);Map<String,Integer> used=new LinkedHashMap<>();for(OrderReturn r:o.getReturns())for(OrderReturnLine l:r.getLines())used.merge(l.getSku(),l.getQuantity(),Integer::sum);PersistableReturn b=new PersistableReturn();b.setRestock(false);b.setReason("refund");b.setLines(o.getOrderProducts().stream().filter(p->p.getProductQuantity()>used.getOrDefault(p.getSku(),0)).map(p->{PersistableReturn.Line l=new PersistableReturn.Line();l.setSku(p.getSku());l.setQuantity(p.getProductQuantity()-used.getOrDefault(p.getSku(),0));return l;}).collect(Collectors.toList()));return read(make(o,b,s));}
+    private Order order(Long id,MerchantStore s){Order o=orderService.getOrder(id,s);if(o==null)throw new ResourceNotFoundException("Order id ["+id+"] not found");return o;}
+    private OrderReturn make(Order o,PersistableReturn b,MerchantStore store) throws Exception {
+        if(o.getStatus()==OrderStatus.CANCELED||o.getStatus()==OrderStatus.REFUNDED)throw new ReturnConflictException("Order cannot be returned");
+        if(b==null||b.getLines()==null||b.getLines().isEmpty())throw new RestApiException("400","At least one return line is required");
+        Map<String,Integer> q=new LinkedHashMap<>();for(PersistableReturn.Line l:b.getLines()){if(l==null||l.getSku()==null||l.getQuantity()<=0)throw new RestApiException("400","Invalid return line");q.merge(l.getSku(),l.getQuantity(),Integer::sum);}
+        Map<String,Integer> used=new LinkedHashMap<>();for(OrderReturn r:o.getReturns())for(OrderReturnLine l:r.getLines())used.merge(l.getSku(),l.getQuantity(),Integer::sum);
+        Map<String,OrderProduct> ps=o.getOrderProducts().stream().collect(Collectors.toMap(OrderProduct::getSku,p->p,(a,c)->a));
+        for(Map.Entry<String,Integer> e:q.entrySet()){OrderProduct p=ps.get(e.getKey());if(p==null||used.getOrDefault(e.getKey(),0)+e.getValue()>p.getProductQuantity())throw new RestApiException("400","Invalid return quantity for sku "+e.getKey());}
+        BigDecimal subtotal=o.getOrderProducts().stream().map(p->price(p).multiply(BigDecimal.valueOf(p.getProductQuantity()))).reduce(BigDecimal.ZERO,BigDecimal::add);
+        BigDecimal lineTotal=q.entrySet().stream().map(e->price(ps.get(e.getKey())).multiply(BigDecimal.valueOf(e.getValue()))).reduce(BigDecimal.ZERO,BigDecimal::add);
+        BigDecimal tax=o.getOrderTotal().stream().filter(t->t.getOrderTotalType()==OrderTotalType.TAX).map(OrderTotal::getValue).reduce(BigDecimal.ZERO,BigDecimal::add);
+        BigDecimal priorTax=o.getReturns().stream().map(OrderReturn::getTax).reduce(BigDecimal.ZERO,BigDecimal::add);BigDecimal refundTax=lineTotal.multiply(tax).divide(subtotal,2,RoundingMode.HALF_UP);
+        boolean complete=true;for(OrderProduct p:o.getOrderProducts())if(used.getOrDefault(p.getSku(),0)+q.getOrDefault(p.getSku(),0)<p.getProductQuantity())complete=false;if(complete)refundTax=tax.subtract(priorTax).setScale(2,RoundingMode.HALF_UP);
+        OrderReturn r=new OrderReturn();r.setOrder(o);r.setTax(refundTax);r.setAmount(lineTotal.add(refundTax));r.setRestocked(Boolean.TRUE.equals(b.getRestock()));r.setReason(b.getReason());r.setDate(new Date());
+        for(Map.Entry<String,Integer> e:q.entrySet()){OrderReturnLine l=new OrderReturnLine();l.setOrderReturn(r);l.setSku(e.getKey());l.setQuantity(e.getValue());l.setAmount(price(ps.get(e.getKey())).multiply(BigDecimal.valueOf(e.getValue())));r.getLines().add(l);if(r.isRestocked())restock(e.getKey(),store,e.getValue());}
+        o.getReturns().add(r);if(complete)o.setStatus(OrderStatus.REFUNDED);OrderStatusHistory h=new OrderStatusHistory();h.setOrder(o);h.setStatus(o.getStatus());h.setDateAdded(new Date());h.setComments("Refunded "+r.getAmount());o.getOrderHistory().add(h);
+        BigDecimal priorAmount=o.getReturns().stream().filter(v->v!=r).map(OrderReturn::getAmount).reduce(BigDecimal.ZERO,BigDecimal::add);OrderTotal rt=o.getOrderTotal().stream().filter(t->"order.total.refunded".equals(t.getOrderTotalCode())).findFirst().orElse(null);if(rt==null){rt=new OrderTotal();rt.setOrder(o);rt.setOrderTotalCode("order.total.refunded");rt.setModule("refund");rt.setOrderTotalType(OrderTotalType.REFUND);rt.setSortOrder(101);o.getOrderTotal().add(rt);}rt.setValue(priorAmount.add(r.getAmount()));
+        Transaction t=new Transaction();t.setOrder(o);t.setAmount(r.getAmount());t.setTransactionType(TransactionType.REFUND);t.setTransactionDate(new Date());transactionService.create(t);orderService.saveOrUpdate(o);return r;
+    }
+    private BigDecimal price(OrderProduct p){return p.getOneTimeCharge()==null?BigDecimal.ZERO:p.getOneTimeCharge();}
+    private void restock(String sku,MerchantStore s,int n){try{com.salesmanager.core.model.catalog.product.Product p=productService.getBySku(sku,s);if(p!=null)for(ProductAvailability a:p.getAvailabilities())if(a.getProductVariant()==null){a.setProductQuantity(a.getProductQuantity()+n);break;}if(p!=null)productService.update(p);}catch(Exception e){throw new RestApiException("Unable to restock product",e);}}
+    private ReadableReturn read(OrderReturn r){ReadableReturn x=new ReadableReturn();x.setId(r.getId());x.setOrderId(r.getOrder().getId());x.setTax(r.getTax());x.setAmount(r.getAmount());x.setRestocked(r.isRestocked());x.setReason(r.getReason());x.setDate(new SimpleDateFormat("yyyy-MM-dd").format(r.getDate()));for(OrderReturnLine l:r.getLines()){ReadableReturn.Line z=new ReadableReturn.Line();z.setSku(l.getSku());z.setQuantity(l.getQuantity());z.setAmount(l.getAmount());x.getLines().add(z);}return x;}
+}
