+package com.salesmanager.core.business.services.catalog.inventory;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.availability.ProductAvailabilityService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+/** The single stock quantity used by storefront operations. */
+@Service("stockService")
+public class StockService {
+    @Inject private ProductAvailabilityService availabilityService;
+    @Inject private ProductService productService;
+
+    public ProductAvailability availability(Product product) {
+        ProductAvailability fallback = null;
+        for (ProductAvailability candidate : product.getAvailabilities()) {
+            if (candidate.getProductVariant() == null && candidate.getRegionVariant() == null) {
+                if ("*".equals(candidate.getRegion()) || "ALL".equalsIgnoreCase(candidate.getRegion())) return candidate;
+                fallback = candidate;
+            }
+        }
+        return fallback != null ? fallback : product.getAvailabilities().stream().findFirst().orElse(null);
+    }
+
+    public int quantity(Product product) {
+        ProductAvailability a = availability(product);
+        return a == null || a.getProductQuantity() == null ? 0 : a.getProductQuantity();
+    }
+
+    public void require(Product product, int quantity) throws ServiceException {
+        if (quantity < 0 || quantity > quantity(product)) throw new ServiceException(ServiceException.EXCEPTION_INVENTORY_MISMATCH);
+    }
+
+    public void change(Product product, int delta) throws ServiceException {
+        ProductAvailability a = availability(product);
+        if (a == null) throw new ServiceException(ServiceException.EXCEPTION_INVENTORY_MISMATCH);
+        int next = quantity(product) + delta;
+        if (next < 0) throw new ServiceException(ServiceException.EXCEPTION_INVENTORY_MISMATCH);
+        a.setProductQuantity(next);
+        availabilityService.saveOrUpdate(a);
+    }
+
+    public Map<Product, Integer> quantitiesForCart(Iterable<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> items,
+            MerchantStore store) throws ServiceException {
+        Map<Product, Integer> result = new LinkedHashMap<>();
+        for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem item : items) {
+            Product product = productService.getBySku(item.getSku(), store, store.getDefaultLanguage());
+            if (product == null) throw new ServiceException(ServiceException.EXCEPTION_INVENTORY_MISMATCH);
+            result.merge(product, item.getQuantity(), Integer::sum);
+        }
+        for (Map.Entry<Product, Integer> entry : result.entrySet()) require(entry.getKey(), entry.getValue());
+        return result;
+    }
+}
