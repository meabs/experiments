--- /dev/null
+++ b/sm-shop/src/main/java/com/salesmanager/shop/store/api/exception/ConflictException.java
@@ -0,0 +1,21 @@
+package com.salesmanager.shop.store.api.exception;
+
+/** The request can't be done in the current state (for example, not enough stock): HTTP 409 Conflict. */
+public class ConflictException extends RuntimeException {
+
+	private static final long serialVersionUID = 1L;
+
+	public ConflictException(String message) {
+		super(message);
+	}
+
+	/** The ConflictException in the cause chain of t, or null. */
+	public static ConflictException in(Throwable t) {
+		for (Throwable c = t; c != null; c = c.getCause() == c ? null : c.getCause()) {
+			if (c instanceof ConflictException) {
+				return (ConflictException) c;
+			}
+		}
+		return null;
+	}
+}
