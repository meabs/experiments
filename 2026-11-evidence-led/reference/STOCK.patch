+	/**
+	 * A cart change can't leave the cart holding more of a product than its stock (all-or-nothing for several items).
+	 * Lowering a quantity, or keeping it, is always allowed.
+	 */
+	private void checkStock(ShoppingCart cart, List<PersistableShoppingCartItem> items, MerchantStore store)
+			throws ConflictException {
+		if (items == null) {
+			return;
+		}
+		for (PersistableShoppingCartItem i : items) {
+			if (i == null || i.getProduct() == null || i.getQuantity() <= 0) {
+				continue;
+			}
+			int inCart = 0;
+			if (cart != null && cart.getLineItems() != null) {
+				for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem line : cart.getLineItems()) {
+					if (i.getProduct().equals(line.getSku())) {
+						inCart += line.getQuantity();
+					}
+				}
+			}
+			if (i.getQuantity() <= inCart) {
+				continue;
+			}
+			Product product;
+			try {
+				product = productService.getBySku(i.getProduct(), store);
+			} catch (Exception e) {
+				continue;
+			}
+			if (product == null) {
+				continue;
+			}
+			int stock = stockOf(product);
+			if (i.getQuantity() > stock) {
+				throw new ConflictException("Only " + stock + " of " + i.getProduct() + " in stock");
+			}
+		}
+	}
+
+	/** The product's stock: its default availability (no variant). */
+	static int stockOf(Product product) {
+		if (product.getAvailabilities() == null) {
+			return 0;
+		}
+		ProductAvailability any = null;
+		for (ProductAvailability a : product.getAvailabilities()) {
+			if (a.getProductVariant() == null) {
+				return a.getProductQuantity() == null ? 0 : a.getProductQuantity();
+			}
+			any = a;
+		}
+		return any == null || any.getProductQuantity() == null ? 0 : any.getProductQuantity();
+	}
 }
