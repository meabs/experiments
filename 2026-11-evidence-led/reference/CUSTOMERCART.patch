+	@Inject
+	private com.salesmanager.shop.store.security.JWTTokenUtil jwtTokenUtil;
+
+	@Inject
+	private com.salesmanager.core.business.services.shoppingcart.ShoppingCartService shoppingCartServiceForOwner;
+
+	/**
+	 * If the request carries a customer's token, the cart becomes (or stays) that customer's, and is marked as changed
+	 * now. A cart that already belongs to another customer is left alone.
+	 */
+	private void claim(ReadableShoppingCart cart, HttpServletRequest request, MerchantStore store) {
+		if (cart == null || cart.getCode() == null || request == null) {
+			return;
+		}
+		String header = request.getHeader("Authorization");
+		if (header == null || !header.startsWith("Bearer ")) {
+			return;
+		}
+		try {
+			String userName = jwtTokenUtil.getUsernameFromToken(header.substring(7));
+			Customer customer = userName == null ? null : customerService.getByNick(userName, store.getId());
+			if (customer == null) {
+				return;
+			}
+			com.salesmanager.core.model.shoppingcart.ShoppingCart model = shoppingCartServiceForOwner.getByCode(cart.getCode(), store);
+			if (model == null || (model.getCustomerId() != null && !model.getCustomerId().equals(customer.getId()))) {
+				return;
+			}
+			model.setCustomerId(customer.getId());
+			model.getAuditSection().setDateModified(new java.util.Date());
+			shoppingCartServiceForOwner.saveOrUpdate(model);
+		} catch (Exception e) {
+			LOGGER.warn("Could not link cart " + cart.getCode() + " to its customer", e);
+		}
+	}
 }
