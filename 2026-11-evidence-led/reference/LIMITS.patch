+	/** A cart can't hold a product below its minimum or above its maximum order quantity (0 removes it). */
+	private void checkLimits(List<PersistableShoppingCartItem> items, MerchantStore store) {
+		if (items == null) {
+			return;
+		}
+		for (PersistableShoppingCartItem i : items) {
+			if (i == null || i.getProduct() == null || i.getQuantity() <= 0) {
+				continue;
+			}
+			Product product;
+			try {
+				product = productService.getBySku(i.getProduct(), store);
+			} catch (Exception e) {
+				continue;
+			}
+			if (product == null) {
+				continue;
+			}
+			String broken = brokenLimit(product, i.getQuantity());
+			if (broken != null) {
+				throw new ServiceRuntimeException(broken, new IllegalArgumentException(broken));
+			}
+		}
+	}
+
+	/** Why this quantity breaks the product's limits, or null. */
+	public static String brokenLimit(Product product, int quantity) {
+		for (ProductAvailability a : product.getAvailabilities()) {
+			if (a.getProductVariant() != null) {
+				continue;
+			}
+			Integer min = a.getProductQuantityOrderMin();
+			Integer max = a.getProductQuantityOrderMax();
+			if (min != null && quantity < min) {
+				return "At least " + min + " of " + product.getSku() + " must be ordered";
+			}
+			if (max != null && max != -1 && quantity > max) {
+				return "At most " + max + " of " + product.getSku() + " can be ordered";
+			}
+			return null;
+		}
+		return null;
+	}
 }
