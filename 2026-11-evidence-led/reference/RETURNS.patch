+package com.salesmanager.core.business.services.order.returns;
+
+import java.math.BigDecimal;
+import java.util.List;
+import java.util.Map;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.Order;
+import com.salesmanager.core.model.order.returns.OrderReturn;
+
+public interface OrderReturnService {
+
+	/** The order's returns, oldest first. */
+	List<OrderReturn> list(Order order);
+
+	/** Total refunded on the order so far (zero if nothing). */
+	BigDecimal totalRefunded(Order order);
+
+	/** Records a return of the given quantities by sku, refunds it, and restocks if asked. */
+	OrderReturn create(Order order, Map<String, Integer> quantities, boolean restock, String reason, MerchantStore store)
+			throws OrderReturnException, ServiceException;
+
+	/** Refunds everything not returned yet, as one return without restocking. */
+	OrderReturn refundRemaining(Order order, MerchantStore store) throws OrderReturnException, ServiceException;
+}
diff --git a/sm-core/src/main/java/com/salesmanager/core/business/services/order/returns/OrderReturnServiceImpl.java b/sm-core/src/main/java/com/salesmanager/core/business/services/order/returns/OrderReturnServiceImpl.java
new file mode 100644
index 000000000..ea5553d96
--- /dev/null
+++ b/sm-core/src/main/java/com/salesmanager/core/business/services/order/returns/OrderReturnServiceImpl.java
@@ -0,0 +1,258 @@
+package com.salesmanager.core.business.services.order.returns;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.util.Date;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import javax.inject.Inject;
+
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.salesmanager.core.business.constants.Constants;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.order.returns.OrderReturnRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.availability.ProductAvailabilityService;
+import com.salesmanager.core.business.services.order.OrderService;
+import com.salesmanager.core.business.services.payments.TransactionService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.Order;
+import com.salesmanager.core.model.order.OrderTotal;
+import com.salesmanager.core.model.order.orderproduct.OrderProduct;
+import com.salesmanager.core.model.order.orderstatus.OrderStatus;
+import com.salesmanager.core.model.order.orderstatus.OrderStatusHistory;
+import com.salesmanager.core.model.order.returns.OrderReturn;
+import com.salesmanager.core.model.order.returns.OrderReturnLine;
+import com.salesmanager.core.model.payments.Transaction;
+import com.salesmanager.core.model.payments.TransactionType;
+
+@Service("orderReturnService")
+public class OrderReturnServiceImpl implements OrderReturnService {
+
+	private static final BigDecimal ZERO = BigDecimal.ZERO.setScale(2);
+
+	@Inject
+	private OrderReturnRepository orderReturnRepository;
+
+	@Inject
+	private OrderService orderService;
+
+	@Inject
+	private TransactionService transactionService;
+
+	@Inject
+	private ProductService productService;
+
+	@Inject
+	private ProductAvailabilityService productAvailabilityService;
+
+	@Override
+	public List<OrderReturn> list(Order order) {
+		return orderReturnRepository.findByOrder(order.getId());
+	}
+
+	@Override
+	public BigDecimal totalRefunded(Order order) {
+		BigDecimal sum = ZERO;
+		for (OrderReturn r : list(order)) {
+			sum = sum.add(r.getAmount());
+		}
+		return sum;
+	}
+
+	@Override
+	@Transactional
+	public OrderReturn create(Order order, Map<String, Integer> quantities, boolean restock, String reason,
+			MerchantStore store) throws OrderReturnException, ServiceException {
+		checkReturnable(order);
+		if (quantities == null || quantities.isEmpty()) {
+			throw new OrderReturnException(OrderReturnException.Kind.INVALID, "A return needs at least one line");
+		}
+		Map<String, Integer> ordered = ordered(order);
+		Map<String, Integer> returned = returnedSoFar(order);
+		for (Map.Entry<String, Integer> e : quantities.entrySet()) {
+			if (!ordered.containsKey(e.getKey())) {
+				throw new OrderReturnException(OrderReturnException.Kind.INVALID, "Product " + e.getKey() + " is not on the order");
+			}
+			if (e.getValue() == null || e.getValue() <= 0) {
+				throw new OrderReturnException(OrderReturnException.Kind.INVALID, "Quantity must be more than 0");
+			}
+			int left = ordered.get(e.getKey()) - returned.getOrDefault(e.getKey(), 0);
+			if (e.getValue() > left) {
+				throw new OrderReturnException(OrderReturnException.Kind.INVALID,
+						"Only " + left + " of " + e.getKey() + " can still be returned");
+			}
+		}
+		return record(order, quantities, restock, reason, store);
+	}
+
+	@Override
+	@Transactional
+	public OrderReturn refundRemaining(Order order, MerchantStore store) throws OrderReturnException, ServiceException {
+		checkReturnable(order);
+		Map<String, Integer> ordered = ordered(order);
+		Map<String, Integer> returned = returnedSoFar(order);
+		Map<String, Integer> rest = new LinkedHashMap<>();
+		for (Map.Entry<String, Integer> e : ordered.entrySet()) {
+			int left = e.getValue() - returned.getOrDefault(e.getKey(), 0);
+			if (left > 0) {
+				rest.put(e.getKey(), left);
+			}
+		}
+		if (rest.isEmpty()) {
+			throw new OrderReturnException(OrderReturnException.Kind.CONFLICT, "Nothing left to refund");
+		}
+		return record(order, rest, false, "refund", store);
+	}
+
+	private void checkReturnable(Order order) throws OrderReturnException {
+		if (order.getStatus() == OrderStatus.CANCELED || order.getStatus() == OrderStatus.REFUNDED) {
+			throw new OrderReturnException(OrderReturnException.Kind.CONFLICT,
+					"Order " + order.getId() + " is " + order.getStatus().name());
+		}
+	}
+
+	private OrderReturn record(Order order, Map<String, Integer> quantities, boolean restock, String reason,
+			MerchantStore store) throws ServiceException {
+		Map<String, BigDecimal> unitPrice = new HashMap<>();
+		for (OrderProduct p : order.getOrderProducts()) {
+			unitPrice.putIfAbsent(p.getSku(), p.getOneTimeCharge());
+		}
+
+		OrderReturn ret = new OrderReturn();
+		ret.setOrder(order);
+		ret.setDateReturned(new Date());
+		ret.setRestocked(restock);
+		ret.setReason(StringUtils.isBlank(reason) ? null : reason);
+		BigDecimal linesTotal = ZERO;
+		for (Map.Entry<String, Integer> e : quantities.entrySet()) {
+			OrderReturnLine line = new OrderReturnLine();
+			line.setOrderReturn(ret);
+			line.setSku(e.getKey());
+			line.setQuantity(e.getValue());
+			line.setAmount(unitPrice.get(e.getKey()).multiply(new BigDecimal(e.getValue())).setScale(2, RoundingMode.HALF_UP));
+			linesTotal = linesTotal.add(line.getAmount());
+			ret.getLines().add(line);
+		}
+
+		BigDecimal orderTax = orderTax(order);
+		boolean completes = completes(order, quantities);
+		BigDecimal tax;
+		if (completes) {
+			BigDecimal refundedTax = ZERO;
+			for (OrderReturn r : list(order)) {
+				refundedTax = refundedTax.add(r.getTax());
+			}
+			tax = orderTax.subtract(refundedTax);
+		} else {
+			BigDecimal subtotal = productsSubtotal(order);
+			tax = subtotal.signum() == 0 ? ZERO
+					: orderTax.multiply(linesTotal).divide(subtotal, 2, RoundingMode.HALF_UP);
+		}
+		ret.setTax(tax);
+		ret.setAmount(linesTotal.add(tax));
+		ret = orderReturnRepository.save(ret);
+
+		if (restock) {
+			for (Map.Entry<String, Integer> e : quantities.entrySet()) {
+				restock(e.getKey(), e.getValue(), store);
+			}
+		}
+
+		Transaction t = new Transaction();
+		t.setOrder(order);
+		t.setAmount(ret.getAmount());
+		t.setTransactionDate(new Date());
+		t.setTransactionType(TransactionType.REFUND);
+		t.setPaymentType(order.getPaymentType());
+		t.getTransactionDetails().put("RETURN_ID", String.valueOf(ret.getId()));
+		t.setDetails(t.toJSONString());
+		transactionService.create(t);
+
+		if (completes) {
+			order.setStatus(OrderStatus.REFUNDED);
+		}
+		OrderStatusHistory h = new OrderStatusHistory();
+		h.setStatus(order.getStatus());
+		h.setDateAdded(new Date());
+		h.setCustomerNotified(0);
+		h.setComments("Return " + ret.getId() + ": refunded " + ret.getAmount().toPlainString());
+		orderService.addOrderStatusHistory(order, h);
+		return ret;
+	}
+
+	private void restock(String sku, int quantity, MerchantStore store) throws ServiceException {
+		Product product = productService.getBySku(sku, store);
+		if (product == null) {
+			return;
+		}
+		for (ProductAvailability a : product.getAvailabilities()) {
+			if (a.getProductVariant() == null) {
+				a.setProductQuantity((a.getProductQuantity() == null ? 0 : a.getProductQuantity()) + quantity);
+				productAvailabilityService.saveOrUpdate(a);
+				return;
+			}
+		}
+	}
+
+	private boolean completes(Order order, Map<String, Integer> now) {
+		Map<String, Integer> ordered = ordered(order);
+		Map<String, Integer> returned = returnedSoFar(order);
+		for (Map.Entry<String, Integer> e : ordered.entrySet()) {
+			int total = returned.getOrDefault(e.getKey(), 0) + now.getOrDefault(e.getKey(), 0);
+			if (total < e.getValue()) {
+				return false;
+			}
+		}
+		return true;
+	}
+
+	private Map<String, Integer> ordered(Order order) {
+		Map<String, Integer> m = new LinkedHashMap<>();
+		for (OrderProduct p : order.getOrderProducts()) {
+			m.merge(p.getSku(), p.getProductQuantity(), Integer::sum);
+		}
+		return m;
+	}
+
+	private Map<String, Integer> returnedSoFar(Order order) {
+		Map<String, Integer> m = new HashMap<>();
+		for (OrderReturn r : list(order)) {
+			for (OrderReturnLine l : r.getLines()) {
+				m.merge(l.getSku(), l.getQuantity(), Integer::sum);
+			}
+		}
+		return m;
+	}
+
+	private BigDecimal orderTax(Order order) {
+		BigDecimal sum = ZERO;
+		for (OrderTotal t : order.getOrderTotal()) {
+			if (Constants.OT_TAX_MODULE_CODE.equals(t.getModule()) && t.getValue() != null) {
+				sum = sum.add(t.getValue());
+			}
+		}
+		return sum.setScale(2, RoundingMode.HALF_UP);
+	}
+
+	private BigDecimal productsSubtotal(Order order) {
+		for (OrderTotal t : order.getOrderTotal()) {
+			if (Constants.OT_SUBTOTAL_MODULE_CODE.equals(t.getModule()) && t.getValue() != null) {
+				return t.getValue().setScale(2, RoundingMode.HALF_UP);
+			}
+		}
+		BigDecimal sum = ZERO;
+		for (OrderProduct p : order.getOrderProducts()) {
+			sum = sum.add(p.getOneTimeCharge().multiply(new BigDecimal(p.getProductQuantity())));
+		}
+		return sum.setScale(2, RoundingMode.HALF_UP);
+	}
+}
