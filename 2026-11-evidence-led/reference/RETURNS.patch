+package com.salesmanager.core.business.services.order.returns;
+
+/** A return that can't be recorded: either the request is wrong, or the order's state doesn't allow it. */
+public class OrderReturnException extends Exception {
+
+	private static final long serialVersionUID = 1L;
+
+	public enum Kind { INVALID, CONFLICT }
+
+	private final Kind kind;
+
+	public OrderReturnException(Kind kind, String message) {
+		super(message);
+		this.kind = kind;
+	}
+
+	public Kind getKind() {
+		return kind;
+	}
+}
