index 000000000..8a2e0e9fe
--- /dev/null
+++ b/sm-shop/src/main/java/com/salesmanager/shop/store/api/v1/order/OrderReturnApi.java
@@ -0,0 +1,142 @@
+package com.salesmanager.shop.store.api.v1.order;
+
+import java.time.ZoneId;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.stream.Collectors;
+import java.util.stream.Stream;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.order.OrderService;
+import com.salesmanager.core.business.services.order.returns.OrderReturnException;
+import com.salesmanager.core.business.services.order.returns.OrderReturnService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.Order;
+import com.salesmanager.core.model.order.returns.OrderReturn;
+import com.salesmanager.core.model.order.returns.OrderReturnLine;
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.model.order.returns.PersistableOrderReturn;
+import com.salesmanager.shop.model.order.returns.ReadableOrderReturn;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.utils.AuthorizationUtils;
+
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Returns and refunds of orders. */
+@RestController
+@RequestMapping("/api/v1")
+public class OrderReturnApi {
+
+	@Inject
+	private OrderService orderService;
+
+	@Inject
+	private OrderReturnService orderReturnService;
+
+	@Inject
+	private AuthorizationUtils authorizationUtils;
+
+	@PostMapping("/private/orders/{id}/returns")
+	@ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT"),
+			@ApiImplicitParam(name = "lang", dataType = "string", defaultValue = "en") })
+	public ResponseEntity<ReadableOrderReturn> create(@PathVariable Long id, @RequestBody PersistableOrderReturn body,
+			@ApiIgnore MerchantStore merchantStore) {
+		authorize(merchantStore);
+		Order order = order(id, merchantStore);
+		Map<String, Integer> quantities = new LinkedHashMap<>();
+		if (body != null && body.getLines() != null) {
+			for (PersistableOrderReturn.Line l : body.getLines()) {
+				if (l == null || l.getSku() == null || l.getQuantity() == null || l.getQuantity() <= 0) {
+					return new ResponseEntity<>(HttpStatus.BAD_REQUEST);
+				}
+				quantities.merge(l.getSku(), l.getQuantity(), Integer::sum);
+			}
+		}
+		try {
+			OrderReturn r = orderReturnService.create(order, quantities, body != null && body.isRestock(),
+					body == null ? null : body.getReason(), merchantStore);
+			return new ResponseEntity<>(readable(r, id), HttpStatus.CREATED);
+		} catch (OrderReturnException e) {
+			return new ResponseEntity<>(status(e));
+		} catch (ServiceException e) {
+			throw new ServiceRuntimeException("Error while recording return", e);
+		}
+	}
+
+	@GetMapping("/private/orders/{id}/returns")
+	@ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT"),
+			@ApiImplicitParam(name = "lang", dataType = "string", defaultValue = "en") })
+	public List<ReadableOrderReturn> list(@PathVariable Long id, @ApiIgnore MerchantStore merchantStore) {
+		authorize(merchantStore);
+		Order order = order(id, merchantStore);
+		return orderReturnService.list(order).stream().map(r -> readable(r, id)).collect(Collectors.toList());
+	}
+
+	@PostMapping("/private/orders/{id}/refund")
+	@ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT"),
+			@ApiImplicitParam(name = "lang", dataType = "string", defaultValue = "en") })
+	public ResponseEntity<ReadableOrderReturn> refund(@PathVariable Long id, @ApiIgnore MerchantStore merchantStore) {
+		authorize(merchantStore);
+		Order order = order(id, merchantStore);
+		try {
+			return new ResponseEntity<>(readable(orderReturnService.refundRemaining(order, merchantStore), id),
+					HttpStatus.CREATED);
+		} catch (OrderReturnException e) {
+			return new ResponseEntity<>(status(e));
+		} catch (ServiceException e) {
+			throw new ServiceRuntimeException("Error while refunding order", e);
+		}
+	}
+
+	private void authorize(MerchantStore store) {
+		String user = authorizationUtils.authenticatedUser();
+		authorizationUtils.authorizeUser(user, Stream.of(Constants.GROUP_SUPERADMIN, Constants.GROUP_ADMIN,
+				Constants.GROUP_ADMIN_ORDER, Constants.GROUP_ADMIN_RETAIL).collect(Collectors.toList()), store);
+	}
+
+	private Order order(Long id, MerchantStore store) {
+		Order order = orderService.getOrder(id, store);
+		if (order == null) {
+			throw new ResourceNotFoundException("Order " + id + " not found");
+		}
+		return order;
+	}
+
+	private static HttpStatus status(OrderReturnException e) {
+		return e.getKind() == OrderReturnException.Kind.CONFLICT ? HttpStatus.CONFLICT : HttpStatus.BAD_REQUEST;
+	}
+
+	private static ReadableOrderReturn readable(OrderReturn r, Long orderId) {
+		ReadableOrderReturn out = new ReadableOrderReturn();
+		out.setId(r.getId());
+		out.setOrderId(orderId);
+		out.setTax(r.getTax());
+		out.setAmount(r.getAmount());
+		out.setRestocked(r.isRestocked());
+		out.setReason(r.getReason());
+		out.setDate(r.getDateReturned().toInstant().atZone(ZoneId.systemDefault()).toLocalDate().toString());
+		for (OrderReturnLine l : r.getLines()) {
+			ReadableOrderReturn.Line line = new ReadableOrderReturn.Line();
+			line.setSku(l.getSku());
+			line.setQuantity(l.getQuantity());
+			line.setAmount(l.getAmount());
+			out.getLines().add(line);
+		}
+		return out;
+	}
+}
