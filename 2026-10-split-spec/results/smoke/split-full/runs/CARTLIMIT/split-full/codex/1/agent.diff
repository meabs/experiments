+package com.salesmanager.shop.store.api.v1.limits;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestMethod;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Administration endpoints for product purchase limits and cart caps. */
+@Controller
+@RequestMapping("/api/v1")
+public class CartLimitsApi {
+
+    @Inject
+    private ProductService productService;
+
+    @Inject
+    private MerchantStoreService merchantStoreService;
+
+    @RequestMapping(value = "/private/product/{id}/limits", method = RequestMethod.GET)
+    @ResponseStatus(HttpStatus.OK)
+    @ResponseBody
+    public ProductLimits getProductLimits(@PathVariable Long id, @ApiIgnore MerchantStore merchantStore) {
+        Product product = productService.findOne(id, merchantStore);
+        if (product == null) throw new ResourceNotFoundException("Product not found");
+        return new ProductLimits(product.getMinPerCart(), product.getMaxPerCart(), product.getPackSize());
+    }
+
+    @RequestMapping(value = "/private/product/{id}/limits", method = RequestMethod.PUT)
+    @ResponseStatus(HttpStatus.OK)
+    @ResponseBody
+    public ProductLimits updateProductLimits(@PathVariable Long id, @RequestBody ProductLimits limits,
+            @ApiIgnore MerchantStore merchantStore) {
+        if (limits == null) throw invalid("Request body is required");
+        try {
+            Product product = productService.updateProductLimits(id, merchantStore,
+                    limits.getMinPerCart(), limits.getMaxPerCart(), limits.getPackSize());
+            if (product == null) throw new ResourceNotFoundException("Product not found");
+            return new ProductLimits(product.getMinPerCart(), product.getMaxPerCart(), product.getPackSize());
+        } catch (IllegalArgumentException e) {
+            throw invalid(e.getMessage());
+        }
+    }
+
+    @RequestMapping(value = "/private/cart-rules", method = RequestMethod.GET)
+    @ResponseStatus(HttpStatus.OK)
+    @ResponseBody
+    public CartRules getCartRules(@ApiIgnore MerchantStore merchantStore) {
+        return new CartRules(merchantStore == null ? null : merchantStore.getMaxLines(),
+                merchantStore == null ? null : merchantStore.getMaxUnits());
+    }
+
+    @RequestMapping(value = "/private/cart-rules", method = RequestMethod.PUT)
+    @ResponseStatus(HttpStatus.OK)
+    @ResponseBody
+    public CartRules updateCartRules(@RequestBody CartRules rules, @ApiIgnore MerchantStore merchantStore) {
+        if (rules == null) throw invalid("Request body is required");
+        try {
+            MerchantStore updated = merchantStoreService.updateCartRules(merchantStore,
+                    rules.getMaxLines(), rules.getMaxUnits());
+            if (updated == null) throw new ResourceNotFoundException("Store not found");
+            return new CartRules(updated.getMaxLines(), updated.getMaxUnits());
+        } catch (IllegalArgumentException e) {
+            throw invalid(e.getMessage());
+        }
+    }
+
+    private RestApiException invalid(String message) {
+        return new RestApiException("400", message == null ? "Invalid limits" : message);
+    }
+}
