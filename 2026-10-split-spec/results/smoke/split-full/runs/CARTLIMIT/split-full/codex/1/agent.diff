+package com.salesmanager.shop.store.controller.shoppingCart;
+
+import java.lang.reflect.Method;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+
+/** Cart limit validation shared by mutations and the cart response mapper. */
+public final class CartLimitSupport {
+    private CartLimitSupport() {}
+
+    public static final class Warning {
+        private final String sku;
+        private final String rule;
+        public Warning(String sku, String rule) { this.sku = sku; this.rule = rule; }
+        public String getSku() { return sku; }
+        public String getRule() { return rule; }
+    }
+
+    public static void validate(ShoppingCart cart, MerchantStore store,
+            Map<String, Integer> proposed, boolean checkCaps) {
+        Map<String, com.salesmanager.core.model.catalog.product.Product> products = new LinkedHashMap<>();
+        if (cart.getLineItems() != null) for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : cart.getLineItems())
+            products.put(i.getProduct().getSku(), i.getProduct());
+        if (proposed != null) for (Map.Entry<String,Integer> e : proposed.entrySet()) {
+            for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : cart.getLineItems())
+                if (i.getProduct().getSku().equals(e.getKey())) products.put(e.getKey(), i.getProduct());
+        }
+        int lines = 0, units = 0;
+        for (Map.Entry<String,Integer> e : proposed.entrySet()) {
+            int q = e.getValue() == null ? 0 : e.getValue();
+            if (q <= 0) continue;
+            lines++; units += q;
+            com.salesmanager.core.model.catalog.product.Product p = products.get(e.getKey());
+            if (p == null) continue;
+            Integer min = number(p, "getMinPerCart", "getPurchaseMin", "getMinimumPerCart");
+            Integer max = number(p, "getMaxPerCart", "getPurchaseMax", "getMaximumPerCart");
+            Integer pack = number(p, "getPackSize", "getPurchasePackSize");
+            if (min != null && q < min) fail("MIN_PER_CART", e.getKey());
+            if (max != null && q > max) fail("MAX_PER_CART", e.getKey());
+            if (pack != null && q % pack != 0) fail("PACK_SIZE", e.getKey());
+        }
+        if (checkCaps) {
+            Integer maxLines = number(store, "getMaxLines", "getCartMaxLines");
+            Integer maxUnits = number(store, "getMaxUnits", "getCartMaxUnits");
+            if (maxLines != null && lines > maxLines) fail("MAX_LINES", null);
+            if (maxUnits != null && units > maxUnits) fail("MAX_UNITS", null);
+        }
+    }
+
+    public static void validateItems(ShoppingCart cart, MerchantStore store,
+            Iterable<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> additions,
+            boolean checkCaps) {
+        validateItems(cart, store, additions, null, checkCaps);
+    }
+
+    public static void validateItems(ShoppingCart cart, MerchantStore store,
+            Iterable<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> additions,
+            Set<String> changedSkus, boolean checkCaps) {
+        Map<String, com.salesmanager.core.model.catalog.product.Product> products = new LinkedHashMap<>();
+        Map<String,Integer> quantities = new LinkedHashMap<>();
+        if (cart.getLineItems() != null) for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : cart.getLineItems()) {
+            products.put(i.getProduct().getSku(), i.getProduct()); quantities.put(i.getProduct().getSku(), i.getQuantity());
+        }
+        for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : additions) {
+            products.put(i.getProduct().getSku(), i.getProduct()); quantities.put(i.getProduct().getSku(), i.getQuantity());
+        }
+        validateValues(store, products, quantities, changedSkus, checkCaps);
+    }
+
+    public static List<Warning> warnings(ShoppingCart cart, MerchantStore store) {
+        List<Warning> out = new ArrayList<>();
+        Map<String,Integer> quantities = new LinkedHashMap<>();
+        if (cart.getLineItems() != null) for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : cart.getLineItems()) {
+            String sku = i.getProduct().getSku(); quantities.put(sku, i.getQuantity());
+            int q = i.getQuantity();
+            Integer min = number(i.getProduct(), "getMinPerCart", "getPurchaseMin", "getMinimumPerCart");
+            Integer max = number(i.getProduct(), "getMaxPerCart", "getPurchaseMax", "getMaximumPerCart");
+            Integer pack = number(i.getProduct(), "getPackSize", "getPurchasePackSize");
+            if (min != null && q < min) out.add(new Warning(sku, "MIN_PER_CART"));
+            if (max != null && q > max) out.add(new Warning(sku, "MAX_PER_CART"));
+            if (pack != null && q % pack != 0) out.add(new Warning(sku, "PACK_SIZE"));
+        }
+        Integer maxLines = number(store, "getMaxLines", "getCartMaxLines");
+        Integer maxUnits = number(store, "getMaxUnits", "getCartMaxUnits");
+        if (maxLines != null && quantities.size() > maxLines) out.add(new Warning(null, "MAX_LINES"));
+        int units = quantities.values().stream().mapToInt(Integer::intValue).sum();
+        if (maxUnits != null && units > maxUnits) out.add(new Warning(null, "MAX_UNITS"));
+        return out;
+    }
+
+    private static void fail(String code, String sku) {
+        throw new ServiceRuntimeException(code, "Cart violates " + code + (sku == null ? "" : " for " + sku));
+    }
+    private static void validateValues(MerchantStore store,
+            Map<String, com.salesmanager.core.model.catalog.product.Product> products,
+            Map<String,Integer> quantities, Set<String> changedSkus, boolean checkCaps) {
+        int lines = 0, units = 0;
+        for (Map.Entry<String,Integer> e : quantities.entrySet()) {
+            int q = e.getValue() == null ? 0 : e.getValue();
+            if (q < 0) fail("INVALID_QUANTITY", e.getKey());
+            if (q == 0) continue;
+            lines++; units += q;
+            Object p = products.get(e.getKey());
+            if (changedSkus != null && !changedSkus.contains(e.getKey())) continue;
+            Integer min = number(p, "getMinPerCart", "getPurchaseMin", "getMinimumPerCart");
+            Integer max = number(p, "getMaxPerCart", "getPurchaseMax", "getMaximumPerCart");
+            Integer pack = number(p, "getPackSize", "getPurchasePackSize");
+            if (min != null && q < min) fail("MIN_PER_CART", e.getKey());
+            if (max != null && q > max) fail("MAX_PER_CART", e.getKey());
+            if (pack != null && q % pack != 0) fail("PACK_SIZE", e.getKey());
+        }
+        if (checkCaps) {
+            Integer maxLines = number(store, "getMaxLines", "getCartMaxLines");
+            Integer maxUnits = number(store, "getMaxUnits", "getCartMaxUnits");
+            if (maxLines != null && lines > maxLines) fail("MAX_LINES", null);
+            if (maxUnits != null && units > maxUnits) fail("MAX_UNITS", null);
+        }
+    }
+    private static Integer number(Object target, String... names) {
+        if (target == null) return null;
+        for (String n : names) try {
+            Method m = target.getClass().getMethod(n); Object v = m.invoke(target);
+            if (v instanceof Number && ((Number)v).intValue() > 0) return ((Number)v).intValue();
+        } catch (Exception ignored) { }
+        return null;
+    }
+}
