+package com.salesmanager.core.business.services.catalog.product.question;
+
+import java.util.Date;
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.ProductRepository;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl implements ProductQuestionService {
+    private final ProductQuestionRepository repository;
+    private final ProductRepository productRepository;
+
+    @Inject
+    public ProductQuestionServiceImpl(ProductQuestionRepository repository, ProductRepository productRepository) {
+        this.repository = repository;
+        this.productRepository = productRepository;
+    }
+
+    private Product product(String sku, MerchantStore store) {
+        if (sku == null || store == null) throw new IllegalArgumentException("Product and store are required");
+        List<Object> ids = productRepository.findBySku(sku, store.getId());
+        if (ids == null || ids.isEmpty()) throw new IllegalArgumentException("Unknown product SKU: " + sku);
+        return productRepository.getOne(((Number) ids.get(0)).longValue());
+    }
+
+    private String required(String value, int min, int max, String field) {
+        String normalized = value == null ? "" : value.trim();
+        if (normalized.length() < min || normalized.length() > max) throw new IllegalArgumentException(field + " length is invalid");
+        return normalized;
+    }
+
+    @Override
+    @Transactional
+    public ProductQuestion ask(String sku, String text, Customer customer, MerchantStore store) throws ServiceException {
+        if (customer == null) throw new IllegalArgumentException("Customer is required");
+        if (repository.countByCustomerIdAndStatus(customer.getId(), ProductQuestionStatus.PENDING) >= 3)
+            throw new IllegalArgumentException("Customer has reached the pending question limit");
+        ProductQuestion question = new ProductQuestion();
+        question.setProduct(product(sku, store));
+        question.setCustomer(customer);
+        question.setMerchantStore(store);
+        question.setText(required(text, 10, 500, "Question"));
+        question.setStatus(ProductQuestionStatus.PENDING);
+        question.setAskedAt(new Date());
+        return repository.saveAndFlush(question);
+    }
+
+    public List<ProductQuestion> listByCustomer(Customer customer) {
+        return repository.findByCustomerIdOrderByAskedAtDesc(customer.getId());
+    }
+
+    public List<ProductQuestion> listPublic(String sku, MerchantStore store) {
+        return repository.findByProductIdAndStatusOrderByAnsweredAtDesc(product(sku, store).getId(), ProductQuestionStatus.PUBLISHED);
+    }
+
+    public List<ProductQuestion> listForStore(MerchantStore store, ProductQuestionStatus status) {
+        if (status == null) status = ProductQuestionStatus.PENDING;
+        return repository.findByMerchantStoreIdAndStatusOrderByAskedAtAsc(store.getId(), status);
+    }
+
+    private ProductQuestion scoped(Long id, MerchantStore store) {
+        ProductQuestion q = repository.findById(id).orElseThrow(() -> new IllegalArgumentException("Unknown question id: " + id));
+        if (store == null || q.getMerchantStore() == null || !store.getId().equals(q.getMerchantStore().getId()))
+            throw new IllegalArgumentException("Question does not belong to store");
+        return q;
+    }
+
+    @Transactional
+    public ProductQuestion answer(Long id, String answer, MerchantStore store) throws ServiceException {
+        ProductQuestion q = scoped(id, store);
+        if (q.getStatus() == ProductQuestionStatus.REJECTED) throw new IllegalStateException("Rejected question cannot be answered");
+        q.setAnswer(required(answer, 1, 2000, "Answer"));
+        q.setStatus(ProductQuestionStatus.PUBLISHED);
+        q.setAnsweredAt(new Date());
+        return repository.saveAndFlush(q);
+    }
+
+    @Transactional
+    public ProductQuestion reject(Long id, MerchantStore store) throws ServiceException {
+        ProductQuestion q = scoped(id, store);
+        q.setStatus(ProductQuestionStatus.REJECTED);
+        return repository.saveAndFlush(q);
+    }
+}
