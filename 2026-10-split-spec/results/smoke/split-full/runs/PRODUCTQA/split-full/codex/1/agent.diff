+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletResponse;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.question.ReadableProductQuestion;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Store-admin endpoints for moderating product questions. */
+@RestController
+@RequestMapping("/api/v1/private/questions")
+public class ProductQuestionAdminApi {
+
+    @Inject
+    private ProductQuestionService productQuestionService;
+
+    @GetMapping
+    @ResponseStatus(HttpStatus.OK)
+    public List<ReadableProductQuestion> list(
+            @RequestParam(value = "status", required = false) String status,
+            @ApiIgnore MerchantStore merchantStore, HttpServletResponse response) {
+        ProductQuestionStatus questionStatus;
+        try {
+            questionStatus = status == null ? ProductQuestionStatus.PENDING
+                    : ProductQuestionStatus.valueOf(status);
+        } catch (IllegalArgumentException e) {
+            sendError(response, HttpServletResponse.SC_BAD_REQUEST, "Invalid question status");
+            return new ArrayList<ReadableProductQuestion>();
+        }
+        return map(productQuestionService.listForStore(merchantStore, questionStatus));
+    }
+
+    @PutMapping("/{id}/answer")
+    @ResponseStatus(HttpStatus.OK)
+    public ReadableProductQuestion answer(@PathVariable Long id, @RequestBody AnswerRequest request,
+            @ApiIgnore MerchantStore merchantStore, HttpServletResponse response) {
+        try {
+            return map(productQuestionService.answer(id, request == null ? null : request.getAnswer(), merchantStore));
+        } catch (IllegalStateException e) {
+            sendError(response, HttpServletResponse.SC_CONFLICT, e.getMessage());
+        } catch (IllegalArgumentException e) {
+            sendError(response, messageCode(e.getMessage()) == 404 ? 404 : 400, e.getMessage());
+        } catch (Exception e) {
+            sendError(response, HttpServletResponse.SC_BAD_REQUEST, e.getMessage());
+        }
+        return null;
+    }
+
+    @PutMapping("/{id}/reject")
+    @ResponseStatus(HttpStatus.OK)
+    public ReadableProductQuestion reject(@PathVariable Long id, @ApiIgnore MerchantStore merchantStore,
+            HttpServletResponse response) {
+        try {
+            return map(productQuestionService.reject(id, merchantStore));
+        } catch (IllegalArgumentException e) {
+            sendError(response, messageCode(e.getMessage()) == 404 ? 404 : 400, e.getMessage());
+        } catch (Exception e) {
+            sendError(response, HttpServletResponse.SC_BAD_REQUEST, e.getMessage());
+        }
+        return null;
+    }
+
+    private int messageCode(String message) {
+        return message != null && (message.toLowerCase().contains("unknown question")
+                || message.toLowerCase().contains("not found")) ? 404 : 400;
+    }
+
+    private void sendError(HttpServletResponse response, int code, String message) {
+        try { response.sendError(code, message); } catch (Exception ignored) { }
+    }
+
+    private List<ReadableProductQuestion> map(List<ProductQuestion> questions) {
+        List<ReadableProductQuestion> result = new ArrayList<ReadableProductQuestion>();
+        if (questions != null) for (ProductQuestion q : questions) result.add(map(q));
+        return result;
+    }
+
+    private ReadableProductQuestion map(ProductQuestion q) {
+        if (q == null) return null;
+        ReadableProductQuestion result = new ReadableProductQuestion();
+        result.setId(q.getId());
+        result.setSku(q.getProduct() == null ? null : q.getProduct().getSku());
+        result.setText(q.getText());
+        result.setStatus(q.getStatus() == null ? null : q.getStatus().name());
+        result.setAnswer(q.getAnswer());
+        result.setAskedBy(q.getAskedBy());
+        result.setAskedAt(q.getAskedAt());
+        result.setAnsweredAt(q.getAnsweredAt());
+        return result;
+    }
+
+    public static class AnswerRequest {
+        private String answer;
+        public String getAnswer() { return answer; }
+        public void setAnswer(String answer) { this.answer = answer; }
+    }
+}
