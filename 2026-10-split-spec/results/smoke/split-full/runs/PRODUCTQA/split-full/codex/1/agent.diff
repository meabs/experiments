+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.ArrayList;
+import java.util.List;
+
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestMethod;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.question.ProductQuestionRequest;
+import com.salesmanager.shop.model.catalog.product.question.ReadableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.question.ReadableProductQuestionList;
+import com.salesmanager.shop.model.catalog.product.question.ReadablePublicProductQuestion;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Customer-authenticated and public product question endpoints. */
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+    @Inject private ProductQuestionService productQuestionService;
+    @Inject private CustomerFacade customerFacade;
+
+    @RequestMapping(value = "/auth/products/{sku}/questions", method = RequestMethod.POST)
+    @ResponseStatus(HttpStatus.CREATED)
+    public ReadableProductQuestion ask(@PathVariable String sku, @RequestBody ProductQuestionRequest body,
+            @ApiIgnore MerchantStore store, HttpServletRequest request) {
+        Customer customer = customer(request, store);
+        try {
+            return read(productQuestionService.ask(sku, body == null ? null : body.getText(), customer, store));
+        } catch (IllegalArgumentException e) {
+            if (e.getMessage() != null && e.getMessage().toLowerCase().contains("unknown product"))
+                throw new ResourceNotFoundException(e.getMessage());
+            throw new RestApiException("400", e.getMessage());
+        } catch (Exception e) {
+            throw new RestApiException("400", e.getMessage(), e);
+        }
+    }
+
+    @RequestMapping(value = "/auth/customer/questions", method = RequestMethod.GET)
+    public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store, HttpServletRequest request) {
+        return read(productQuestionService.listByCustomer(customer(request, store)));
+    }
+
+    @RequestMapping(value = "/products/{sku}/questions", method = RequestMethod.GET)
+    public ReadableProductQuestionList published(@PathVariable String sku, @ApiIgnore MerchantStore store) {
+        try {
+            List<ReadablePublicProductQuestion> items = readPublic(productQuestionService.listPublic(sku, store));
+            ReadableProductQuestionList result = new ReadableProductQuestionList();
+            result.setItems(items);
+            result.setCount(items.size());
+            return result;
+        } catch (IllegalArgumentException e) {
+            throw new ResourceNotFoundException(e.getMessage());
+        }
+    }
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal principal = request.getUserPrincipal();
+        if (principal == null) throw new RestApiException("401", "Customer authentication required");
+        Customer customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (customer == null) throw new ResourceNotFoundException("Customer not found");
+        return customer;
+    }
+
+    private ReadableProductQuestion read(ProductQuestion q) {
+        ReadableProductQuestion result = new ReadableProductQuestion();
+        result.setId(q.getId());
+        result.setSku(q.getProduct() == null ? null : q.getProduct().getSku());
+        result.setText(q.getText());
+        result.setStatus(q.getStatus() == null ? null : q.getStatus().name());
+        result.setAnswer(q.getAnswer());
+        result.setAskedBy(q.getAskedBy());
+        result.setAskedAt(q.getAskedAt());
+        result.setAnsweredAt(q.getAnsweredAt());
+        return result;
+    }
+
+    private List<ReadableProductQuestion> read(List<ProductQuestion> questions) {
+        List<ReadableProductQuestion> result = new ArrayList<>();
+        if (questions != null) for (ProductQuestion q : questions) result.add(read(q));
+        return result;
+    }
+
+    private ReadablePublicProductQuestion readPublic(ProductQuestion q) {
+        ReadablePublicProductQuestion result = new ReadablePublicProductQuestion();
+        result.setId(q.getId());
+        result.setText(q.getText());
+        result.setAnswer(q.getAnswer());
+        result.setAskedBy(q.getAskedBy());
+        result.setAnsweredAt(q.getAnsweredAt());
+        return result;
+    }
+
+    private List<ReadablePublicProductQuestion> readPublic(List<ProductQuestion> questions) {
+        List<ReadablePublicProductQuestion> result = new ArrayList<>();
+        if (questions != null) for (ProductQuestion q : questions) result.add(readPublic(q));
+        return result;
+    }
+}
