+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.List;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletResponse;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestMethod;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestion;
+
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Store administrator endpoints for moderating product questions. */
+@RestController
+@RequestMapping("/api/v1/private/questions")
+public class ProductQuestionAdministrationApi {
+
+    @Inject
+    private ProductQuestionService questionService;
+
+    @RequestMapping(method = RequestMethod.GET)
+    @ResponseStatus(HttpStatus.OK)
+    @ApiImplicitParams(@ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT"))
+    public @ResponseBody List<ReadableProductQuestion> list(
+            String status, @ApiIgnore MerchantStore merchantStore, HttpServletResponse response) {
+        ProductQuestionStatus questionStatus;
+        try {
+            questionStatus = status == null || status.trim().isEmpty()
+                    ? ProductQuestionStatus.PENDING
+                    : ProductQuestionStatus.valueOf(status.trim().toUpperCase());
+        } catch (IllegalArgumentException e) {
+            sendError(response, HttpServletResponse.SC_BAD_REQUEST, "Unknown question status");
+            return null;
+        }
+        try {
+            return questionService.listByStoreAndStatus(merchantStore, questionStatus).stream()
+                    .map(ProductQuestionAdministrationApi::toReadable).collect(Collectors.toList());
+        } catch (ServiceException e) {
+            sendServiceError(response, e);
+            return null;
+        }
+    }
+
+    @RequestMapping(value = "/{id}/answer", method = RequestMethod.PUT)
+    @ResponseStatus(HttpStatus.OK)
+    public @ResponseBody ReadableProductQuestion answer(@PathVariable Long id,
+            @RequestBody AnswerRequest request, @ApiIgnore MerchantStore merchantStore,
+            HttpServletResponse response) {
+        try {
+            String answer = request == null ? null : request.getAnswer();
+            return toReadable(questionService.answer(id, answer, merchantStore));
+        } catch (ServiceException e) {
+            sendServiceError(response, e);
+            return null;
+        }
+    }
+
+    @RequestMapping(value = "/{id}/reject", method = RequestMethod.PUT)
+    @ResponseStatus(HttpStatus.OK)
+    public @ResponseBody ReadableProductQuestion reject(@PathVariable Long id,
+            @ApiIgnore MerchantStore merchantStore, HttpServletResponse response) {
+        try {
+            return toReadable(questionService.reject(id, merchantStore));
+        } catch (ServiceException e) {
+            sendServiceError(response, e);
+            return null;
+        }
+    }
+
+    private static ReadableProductQuestion toReadable(ProductQuestion source) {
+        ReadableProductQuestion target = new ReadableProductQuestion();
+        target.setId(source.getId());
+        target.setSku(source.getSku());
+        target.setText(source.getText());
+        target.setStatus(source.getStatus() == null ? null : source.getStatus().name());
+        target.setAnswer(source.getAnswer());
+        target.setAskedBy(source.getAskedBy());
+        target.setAskedAt(source.getAskedAt());
+        target.setAnsweredAt(source.getAnsweredAt());
+        return target;
+    }
+
+    private static void sendServiceError(HttpServletResponse response, ServiceException exception) {
+        int type = exception.getExceptionType();
+        int status = type == 404 || type == 409 ? type
+                : (type == ServiceException.EXCEPTION_VALIDATION ? 400 : 500);
+        sendError(response, status, exception.getMessage());
+    }
+
+    private static void sendError(HttpServletResponse response, int status, String message) {
+        try {
+            if (!response.isCommitted()) response.sendError(status, message);
+        } catch (Exception ignored) {
+            // The response status is still represented by the servlet container.
+        }
+    }
+
+    public static class AnswerRequest {
+        private String answer;
+        public String getAnswer() { return answer; }
+        public void setAnswer(String answer) { this.answer = answer; }
+    }
+}
