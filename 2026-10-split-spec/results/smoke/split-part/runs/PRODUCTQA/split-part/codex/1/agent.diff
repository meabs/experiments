+package com.salesmanager.core.business.services.catalog.product.question;
+
+import java.util.Date;
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.ProductRepository;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl implements ProductQuestionService {
+    private final ProductQuestionRepository repository;
+    private final ProductRepository productRepository;
+
+    @Inject
+    public ProductQuestionServiceImpl(ProductQuestionRepository repository, ProductRepository productRepository) {
+        this.repository = repository;
+        this.productRepository = productRepository;
+    }
+
+    @Override
+    @Transactional
+    public ProductQuestion ask(String sku, Customer customer, MerchantStore store, String text) throws ServiceException {
+        String normalizedSku = sku == null ? null : sku.trim();
+        String normalizedText = text == null ? null : text.trim();
+        if (normalizedText == null || normalizedText.length() < 10 || normalizedText.length() > 500) {
+            throw validation("Question text must contain between 10 and 500 characters");
+        }
+        if (customer == null || store == null || normalizedSku == null || normalizedSku.isEmpty()) {
+            throw validation("Customer, store and SKU are required");
+        }
+        Product product = productRepository.findBySkuAndMerchantStoreId(normalizedSku, store.getId());
+        if (product == null) throw notFound("Unknown SKU");
+        if (repository.countByCustomerIdAndMerchantStoreIdAndStatus(customer.getId(), store.getId(), ProductQuestionStatus.PENDING) >= 3) {
+            throw validation("A customer may have at most three pending questions");
+        }
+        ProductQuestion question = new ProductQuestion();
+        question.setProduct(product);
+        question.setCustomer(customer);
+        question.setMerchantStore(store);
+        question.setSku(product.getSku());
+        question.setText(normalizedText);
+        question.setStatus(ProductQuestionStatus.PENDING);
+        question.setAskedAt(new Date());
+        return repository.saveAndFlush(question);
+    }
+
+    @Override public List<ProductQuestion> listByCustomer(Long customerId, MerchantStore store) {
+        return repository.findByCustomerIdAndMerchantStoreIdOrderByAskedAtDesc(customerId, store.getId());
+    }
+
+    @Override
+    public List<ProductQuestion> listPublicBySku(String sku, MerchantStore store) throws ServiceException {
+        Product product = productRepository.findBySkuAndMerchantStoreId(sku == null ? null : sku.trim(), store.getId());
+        if (product == null) throw notFound("Unknown SKU");
+        return repository.findBySkuAndMerchantStoreIdAndStatusOrderByAnsweredAtDesc(product.getSku(), store.getId(), ProductQuestionStatus.PUBLISHED);
+    }
+
+    @Override public List<ProductQuestion> listByStoreAndStatus(MerchantStore store, ProductQuestionStatus status) {
+        return repository.findByMerchantStoreIdAndStatusOrderByAskedAtAsc(store.getId(), status);
+    }
+
+    @Override @Transactional
+    public ProductQuestion answer(Long id, String answer, MerchantStore store) throws ServiceException {
+        ProductQuestion question = findForStore(id, store);
+        if (question.getStatus() == ProductQuestionStatus.REJECTED) throw new ServiceException(409, "Rejected questions cannot be answered");
+        String normalized = answer == null ? null : answer.trim();
+        if (normalized == null || normalized.length() < 1 || normalized.length() > 2000) throw validation("Answer must contain between 1 and 2000 characters");
+        question.setAnswer(normalized);
+        question.setStatus(ProductQuestionStatus.PUBLISHED);
+        question.setAnsweredAt(new Date());
+        return repository.saveAndFlush(question);
+    }
+
+    @Override @Transactional
+    public ProductQuestion reject(Long id, MerchantStore store) throws ServiceException {
+        ProductQuestion question = findForStore(id, store);
+        question.setStatus(ProductQuestionStatus.REJECTED);
+        return repository.saveAndFlush(question);
+    }
+
+    @Override public ProductQuestion getById(Long id) throws ServiceException {
+        ProductQuestion question = repository.findById(id).orElse(null);
+        if (question == null) throw notFound("Unknown question");
+        return question;
+    }
+
+    private ProductQuestion findForStore(Long id, MerchantStore store) throws ServiceException {
+        ProductQuestion question = repository.findByIdAndMerchantStoreId(id, store.getId());
+        if (question == null) throw notFound("Unknown question");
+        return question;
+    }
+    private ServiceException validation(String message) { return new ServiceException(ServiceException.EXCEPTION_VALIDATION, message); }
+    private ServiceException notFound(String message) { return new ServiceException(404, message); }
+}
