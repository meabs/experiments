+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.ArrayList;
+import java.util.List;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import javax.validation.Valid;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.shop.model.catalog.product.PersistableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestionList;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestionPublic;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Customer and unauthenticated product-question endpoints. */
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+    @Inject private ProductQuestionService questionService;
+    @Inject private CustomerFacade customerFacade;
+
+    @PostMapping("/auth/products/{sku}/questions")
+    @ResponseStatus(HttpStatus.CREATED)
+    public ReadableProductQuestion ask(@PathVariable String sku,
+            @Valid @RequestBody PersistableProductQuestion payload,
+            @ApiIgnore MerchantStore store, HttpServletRequest request) {
+        try {
+            Principal principal = request.getUserPrincipal();
+            Customer customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+            return map(questionService.ask(sku, customer, store, payload.getText()));
+        } catch (ServiceException e) { throw serviceError(e); }
+    }
+
+    @GetMapping("/auth/customer/questions")
+    public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store, HttpServletRequest request) {
+        try {
+            Customer customer = customerFacade.getCustomerByUserName(request.getUserPrincipal().getName(), store);
+            List<ReadableProductQuestion> result = new ArrayList<>();
+            for (ProductQuestion question : questionService.listByCustomer(customer.getId(), store)) result.add(map(question));
+            return result;
+        } catch (ServiceException e) { throw serviceError(e); }
+    }
+
+    @GetMapping("/products/{sku}/questions")
+    public ReadableProductQuestionList published(@PathVariable String sku, @ApiIgnore MerchantStore store) {
+        try {
+            List<ReadableProductQuestionPublic> result = new ArrayList<>();
+            for (ProductQuestion question : questionService.listPublicBySku(sku, store)) result.add(mapPublic(question));
+            return new ReadableProductQuestionList(result);
+        } catch (ServiceException e) { throw serviceError(e); }
+    }
+
+    private ReadableProductQuestion map(ProductQuestion q) {
+        ReadableProductQuestion r = new ReadableProductQuestion();
+        r.setId(q.getId()); r.setSku(q.getSku()); r.setText(q.getText());
+        r.setStatus(q.getStatus() == null ? null : q.getStatus().name()); r.setAnswer(q.getAnswer());
+        r.setAskedBy(q.getAskedBy()); r.setAskedAt(q.getAskedAt()); r.setAnsweredAt(q.getAnsweredAt());
+        return r;
+    }
+    private ReadableProductQuestionPublic mapPublic(ProductQuestion q) {
+        ReadableProductQuestionPublic r = new ReadableProductQuestionPublic();
+        r.setId(q.getId()); r.setText(q.getText()); r.setAnswer(q.getAnswer());
+        r.setAskedBy(q.getAskedBy()); r.setAnsweredAt(q.getAnsweredAt()); return r;
+    }
+    private RuntimeException serviceError(ServiceException e) {
+        String message = e.getMessage();
+        if (message != null && message.toLowerCase().contains("unknown sku")) return new ResourceNotFoundException(message);
+        return new ServiceRuntimeException("400", message == null ? "Question service error" : message, e);
+    }
+}
