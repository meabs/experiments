+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.Optional;
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductLimits;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/product/{id}/limits")
+public class ProductLimitsApi {
+    @Inject private ProductService productService;
+
+    @GetMapping
+    @ResponseStatus(HttpStatus.OK)
+    public ProductLimits get(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        return toDto(product(id, store));
+    }
+
+    @PutMapping
+    @ResponseStatus(HttpStatus.OK)
+    public ProductLimits put(@PathVariable Long id, @RequestBody ProductLimits limits,
+                             @ApiIgnore MerchantStore store) {
+        validate(limits);
+        Product product = product(id, store);
+        product.setMinPerCart(limits.getMinPerCart());
+        product.setMaxPerCart(limits.getMaxPerCart());
+        product.setPackSize(limits.getPackSize());
+        try { productService.update(product); }
+        catch (ServiceException e) { throw new RestApiException("Unable to save product limits", e); }
+        return toDto(product);
+    }
+
+    private Product product(Long id, MerchantStore store) {
+        Optional<Product> found = productService.retrieveById(id, store);
+        if (!found.isPresent()) throw new ResourceNotFoundException("Product not found");
+        return found.get();
+    }
+    private static ProductLimits toDto(Product p) {
+        ProductLimits d = new ProductLimits();
+        d.setMinPerCart(p.getMinPerCart()); d.setMaxPerCart(p.getMaxPerCart()); d.setPackSize(p.getPackSize());
+        return d;
+    }
+    private static void validate(ProductLimits d) {
+        if (d == null || invalid(d.getMinPerCart()) || invalid(d.getMaxPerCart()) || invalid(d.getPackSize())
+            || (d.getMinPerCart() != null && d.getMaxPerCart() != null && d.getMinPerCart() > d.getMaxPerCart())
+            || (d.getMaxPerCart() != null && d.getPackSize() != null && d.getMaxPerCart() < d.getPackSize()))
+            throw new RestApiException("Invalid product limits");
+    }
+    private static boolean invalid(Integer n) { return n != null && n < 1; }
+}
