+	private void addLimitWarnings(ShoppingCart source, MerchantStore store, ReadableShoppingCart destination) {
+		Set<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> items = source.getLineItems();
+		int units = 0;
+		Set<Object> distinctProducts = new HashSet<>();
+		if (items != null) {
+			for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem item : items) {
+				int quantity = item.getQuantity(); units += quantity;
+				com.salesmanager.core.model.catalog.product.Product product = item.getProduct();
+				if (product != null) {
+					distinctProducts.add(product.getId() != null ? product.getId() : product.getSku());
+				}
+				if (quantity > 0 && product != null) {
+					if (product.getMinPerCart() != null && quantity < product.getMinPerCart()) destination.getLimitWarnings().add(new CartLimitWarning(product.getSku(), "MIN_PER_CART"));
+					if (product.getMaxPerCart() != null && quantity > product.getMaxPerCart()) destination.getLimitWarnings().add(new CartLimitWarning(product.getSku(), "MAX_PER_CART"));
+					if (product.getPackSize() != null && product.getPackSize() > 0 && quantity % product.getPackSize() != 0) destination.getLimitWarnings().add(new CartLimitWarning(product.getSku(), "PACK_SIZE"));
+				}
+			}
+		}
+		if (store.getMaxLines() != null && distinctProducts.size() > store.getMaxLines()) destination.getLimitWarnings().add(new CartLimitWarning(null, "MAX_LINES"));
+		if (store.getMaxUnits() != null && units > store.getMaxUnits()) destination.getLimitWarnings().add(new CartLimitWarning(null, "MAX_UNITS"));
+	}
 	
 
 
