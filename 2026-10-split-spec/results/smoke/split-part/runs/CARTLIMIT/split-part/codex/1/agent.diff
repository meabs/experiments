+package com.salesmanager.shop.store.api.v1;
+
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.store.CartRules;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/cart-rules")
+public class CartRulesApi {
+    @Inject private MerchantStoreService merchantStoreService;
+    @GetMapping @ResponseStatus(HttpStatus.OK)
+    public CartRules get(@ApiIgnore MerchantStore store) { return toDto(store); }
+    @PutMapping @ResponseStatus(HttpStatus.OK)
+    public CartRules put(@RequestBody CartRules rules, @ApiIgnore MerchantStore store) {
+        validate(rules);
+        store.setMaxLines(rules.getMaxLines()); store.setMaxUnits(rules.getMaxUnits());
+        try { merchantStoreService.update(store); }
+        catch (ServiceException e) { throw new RestApiException("Unable to save cart rules", e); }
+        return toDto(store);
+    }
+    private static CartRules toDto(MerchantStore s) { CartRules d = new CartRules(); d.setMaxLines(s.getMaxLines()); d.setMaxUnits(s.getMaxUnits()); return d; }
+    private static void validate(CartRules d) {
+        if (d == null || invalid(d.getMaxLines()) || invalid(d.getMaxUnits())) throw new RestApiException("Invalid cart rules");
+    }
+    private static boolean invalid(Integer n) { return n != null && n < 1; }
+}
