@@ -0,0 +1,48 @@
+package com.salesmanager.core.business.services.shoppingcart;
+
+import java.lang.reflect.Method;
+import java.util.Collection;
+import java.util.HashMap;
+import java.util.Map;
+
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+/** Limit checks kept separate so callers can stage a complete cart first. */
+public class ShoppingCartMutationValidator {
+    public void validateLine(Product product, int quantity) {
+        if (quantity == 0) return;
+        int min = number(product, 1, "getMinPerCart");
+        int max = number(product, Integer.MAX_VALUE, "getMaxPerCart");
+        int pack = number(product, 1, "getPackSize");
+        if (quantity < min) fail("MIN_PER_CART");
+        if (quantity > max) fail("MAX_PER_CART");
+        if (pack > 1 && quantity % pack != 0) fail("PACK_SIZE");
+    }
+
+    public void validateCart(Collection<? extends Object[]> lines, MerchantStore store,
+            boolean checkLineCap, boolean checkUnitCap) {
+        int count = 0, units = 0;
+        for (Object[] line : lines) {
+            Product product = (Product) line[0];
+            int quantity = ((Number) line[1]).intValue();
+            validateLine(product, quantity);
+            if (quantity > 0) { count++; units += quantity; }
+        }
+        Object rules = invoke(store, "getCartRules");
+        if (rules == null) rules = store;
+        if (checkLineCap && count > number(rules, Integer.MAX_VALUE, "getMaxLines")) fail("MAX_LINES");
+        if (checkUnitCap && units > number(rules, Integer.MAX_VALUE, "getMaxUnits")) fail("MAX_UNITS");
+    }
+
+    private static void fail(String code) { throw new CartMutationValidationException(code); }
+    private static int number(Object target, int fallback, String name) {
+        Object value = invoke(target, name);
+        return value instanceof Number ? ((Number)value).intValue() : fallback;
+    }
+    private static Object invoke(Object target, String name) {
+        if (target == null) return null;
+        try { Method m = target.getClass().getMethod(name); return m.invoke(target); }
+        catch (Exception ignored) { return null; }
+    }
+}
