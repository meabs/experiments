+	/* Validate a proposed state before changing the persistent entity.  This is
+	 * deliberately map based: Hibernate entities are mutable and validating after
+	 * changing them would make a rejected multi update non-atomic. */
+	private void validateAddition(ShoppingCart cart, com.salesmanager.core.model.shoppingcart.ShoppingCartItem added,
+			MerchantStore store) {
+		Map<String, Integer> proposed = quantities(cart);
+		String sku = added.getProduct().getSku();
+		// Attribute-bearing additions are separate cart lines; do not combine
+		// their quantity with an existing un-attributed line of the same SKU.
+		boolean separateLine = !CollectionUtils.isEmpty(added.getAttributes());
+		int existingTotal = proposed.containsKey(sku) ? proposed.get(sku) : 0;
+		boolean newLine = separateLine || !proposed.containsKey(sku);
+		int old = separateLine ? 0 : existingTotal;
+		int next = old + (added.getQuantity() == null ? 0 : added.getQuantity());
+		validateProduct(added.getProduct(), next);
+		proposed.put(sku, separateLine ? existingTotal + next : next);
+		validateStoreCaps(cart, proposed, store, newLine && next > 0, next > old);
+	}
+
+	private void validateSingleChange(ShoppingCart cart, com.salesmanager.core.model.shoppingcart.ShoppingCartItem changed,
+			MerchantStore store) {
+		Map<String, Integer> proposed = quantities(cart);
+		String sku = changed.getProduct().getSku();
+		int old = proposed.containsKey(sku) ? proposed.get(sku) : 0;
+		int next = changed.getQuantity() == null ? 0 : changed.getQuantity();
+		validateProduct(changed.getProduct(), next);
+		if (next == 0) proposed.remove(sku); else proposed.put(sku, next);
+		validateStoreCaps(cart, proposed, store, old == 0 && next > 0, next > old);
+	}
+
+	private void validateMultiChange(ShoppingCart cart,
+			List<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> changed, MerchantStore store) {
+		Map<String, Integer> proposed = quantities(cart);
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem item : changed) {
+			String sku = item.getProduct().getSku();
+			int old = proposed.containsKey(sku) ? proposed.get(sku) : 0;
+			int next = item.getQuantity() == null ? 0 : item.getQuantity();
+			validateProduct(item.getProduct(), next);
+			if (next == 0) proposed.remove(sku); else proposed.put(sku, next);
+		}
+		int oldLines = quantities(cart).size();
+		int oldUnits = quantities(cart).values().stream().mapToInt(Integer::intValue).sum();
+		int newUnits = proposed.values().stream().mapToInt(Integer::intValue).sum();
+		validateStoreCaps(cart, proposed, store, proposed.size() > oldLines, newUnits > oldUnits);
+	}
+
+	private Map<String, Integer> quantities(ShoppingCart cart) {
+		Map<String, Integer> result = new LinkedHashMap<>();
+		if (cart.getLineItems() != null) for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : cart.getLineItems())
+			if (i.getProduct() != null && i.getQuantity() != null && i.getQuantity() > 0)
+				result.merge(i.getProduct().getSku(), i.getQuantity(), Integer::sum);
+		return result;
+	}
+
+	private void validateProduct(Product product, int quantity) {
+		if (quantity == 0) return;
+		Integer min = limit(product, "getMinPerCart");
+		Integer max = limit(product, "getMaxPerCart");
+		Integer pack = limit(product, "getPackSize");
+		if (min != null && quantity < min) reject("MIN_PER_CART", product.getSku());
+		if (max != null && quantity > max) reject("MAX_PER_CART", product.getSku());
+		if (pack != null && pack > 0 && quantity % pack != 0) reject("PACK_SIZE", product.getSku());
+	}
+
+	private void validateStoreCaps(ShoppingCart cart, Map<String, Integer> proposed, MerchantStore store,
+			boolean addingLine, boolean addingUnits) {
+		if (addingLine) {
+			Integer maxLines = limit(store, "getMaxLines");
+			if (maxLines != null && proposed.size() > maxLines) reject("MAX_LINES", null);
+		}
+		if (addingUnits) {
+			Integer maxUnits = limit(store, "getMaxUnits");
+			int units = proposed.values().stream().mapToInt(Integer::intValue).sum();
+			if (maxUnits != null && units > maxUnits) reject("MAX_UNITS", null);
+		}
+	}
+
+	private Integer limit(Object object, String getter) {
+		if (object == null) return null;
+		try {
+			Method m = object.getClass().getMethod(getter);
+			Object value = m.invoke(object);
+			return value == null ? null : ((Number)value).intValue();
+		} catch (Exception ignored) { return null; }
+	}
