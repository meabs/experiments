+package com.salesmanager.core.model.catalog.product;
+import java.io.Serializable;
+public final class ProductLimits implements Serializable {
+ private static final long serialVersionUID=1L; private final Integer minPerCart,maxPerCart,packSize;
+ public ProductLimits(Integer min,Integer max,Integer pack){ validate(min,max,pack); minPerCart=min;maxPerCart=max;packSize=pack; }
+ public Integer getMinPerCart(){return minPerCart;} public Integer getMaxPerCart(){return maxPerCart;} public Integer getPackSize(){return packSize;}
+ public boolean isEmpty(){return minPerCart==null&&maxPerCart==null&&packSize==null;}
+ public static void validate(Integer min,Integer max,Integer pack){if(min!=null&&min<1||max!=null&&max<1||pack!=null&&pack<1)throw new IllegalArgumentException("Limits must be at least 1");if(min!=null&&max!=null&&min>max)throw new IllegalArgumentException("minPerCart may not exceed maxPerCart");if(max!=null&&pack!=null&&max<pack)throw new IllegalArgumentException("maxPerCart may not be less than packSize");}
+}
