+package com.salesmanager.core.business.services.catalog.product;
+
+import java.util.Optional;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.ProductRepository;
+import com.salesmanager.core.business.repositories.merchant.MerchantRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductLimits;
+import com.salesmanager.core.model.merchant.CartRules;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("purchaseLimitsService")
+public class PurchaseLimitsServiceImpl implements PurchaseLimitsService {
+ private final ProductRepository products;
+ private final MerchantRepository stores;
+ @Inject public PurchaseLimitsServiceImpl(ProductRepository products, MerchantRepository stores){this.products=products;this.stores=stores;}
+ @Override public Optional<Product> findProduct(Long id, MerchantStore store){
+  if(id==null||store==null)return Optional.empty();
+  return products.findById(id).filter(p->p.getMerchantStore()!=null&&store.getId()!=null&&store.getId().equals(p.getMerchantStore().getId()));
+ }
+ @Override public ProductLimits getProductLimits(Long id, MerchantStore store){
+  return findProduct(id,store).map(this::from).orElse(null);
+ }
+ @Override public ProductLimits lookupProductLimits(Long id, MerchantStore store){return getProductLimits(id,store);}
+ @Override public ProductLimits updateProductLimits(Long id, MerchantStore store, ProductLimits limits){
+  Product p=findProduct(id,store).orElseThrow(()->new IllegalArgumentException("Unknown product or product does not belong to store"));
+  if(limits==null){limits=new ProductLimits(null,null,null);}
+  p.setMinPerCart(limits.getMinPerCart()); p.setMaxPerCart(limits.getMaxPerCart()); p.setPackSize(limits.getPackSize()); products.save(p); return limits;
+ }
+ @Override public CartRules getCartRules(MerchantStore store){return store==null?null:new CartRules(store.getMaxCartLines(),store.getMaxCartUnits());}
+ @Override public CartRules lookupCartRules(MerchantStore store){return getCartRules(store);}
+ @Override public CartRules updateCartRules(MerchantStore store, CartRules rules){
+  if(store==null)throw new IllegalArgumentException("Store is required"); if(rules==null)rules=new CartRules(null,null);
+  store.setMaxCartLines(rules.getMaxLines()); store.setMaxCartUnits(rules.getMaxUnits()); stores.save(store); return rules;
+ }
+ private ProductLimits from(Product p){return new ProductLimits(p.getMinPerCart(),p.getMaxPerCart(),p.getPackSize());}
+}
