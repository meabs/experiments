+package com.salesmanager.shop.store.api.v1.product;
+
+import javax.inject.Inject;
+
+import org.springframework.http.MediaType;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.product.PurchaseLimitsService;
+import com.salesmanager.core.model.catalog.product.ProductLimits;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/product/{id}/limits")
+public class ProductLimitsApi {
+    @Inject
+    private PurchaseLimitsService purchaseLimitsService;
+
+    @GetMapping(produces = MediaType.APPLICATION_JSON_VALUE)
+    public ProductLimitsRequest get(@PathVariable Long id, @ApiIgnore MerchantStore merchantStore) {
+        if (!purchaseLimitsService.findProduct(id, merchantStore).isPresent())
+            throw new ResourceNotFoundException("Product not found");
+        return response(purchaseLimitsService.getProductLimits(id, merchantStore));
+    }
+
+    @PutMapping(consumes = MediaType.APPLICATION_JSON_VALUE, produces = MediaType.APPLICATION_JSON_VALUE)
+    public ProductLimitsRequest put(@PathVariable Long id, @RequestBody ProductLimitsRequest request,
+            @ApiIgnore MerchantStore merchantStore) {
+        if (request == null) throw bad("Limits request is required");
+        // ProductLimits validates all relationships before touching the product.
+        final ProductLimits validated;
+        try {
+            validated = new ProductLimits(request.getMinPerCart(), request.getMaxPerCart(), request.getPackSize());
+        } catch (IllegalArgumentException e) {
+            throw bad(e.getMessage());
+        }
+        if (!purchaseLimitsService.findProduct(id, merchantStore).isPresent())
+            throw new ResourceNotFoundException("Product not found");
+        try { return response(purchaseLimitsService.updateProductLimits(id, merchantStore, validated)); }
+        catch (IllegalArgumentException e) { throw bad(e.getMessage()); }
+        catch (Exception e) { throw new RestApiException("Unable to save product limits", e); }
+    }
+
+    private ProductLimitsRequest response(ProductLimits limits) {
+        ProductLimitsRequest result = new ProductLimitsRequest();
+        if (limits != null) { result.setMinPerCart(limits.getMinPerCart()); result.setMaxPerCart(limits.getMaxPerCart()); result.setPackSize(limits.getPackSize()); }
+        return result;
+    }
+
+    private RestApiException bad(String message) { return new RestApiException("400", message); }
+}
