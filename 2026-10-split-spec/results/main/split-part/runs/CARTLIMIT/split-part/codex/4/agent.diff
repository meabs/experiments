+package com.salesmanager.shop.store.controller.shoppingCart.facade;
+
+import java.lang.reflect.Method;
+import java.util.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.shop.model.shoppingcart.CartLimitWarning;
+
+/** Reflection based bridge keeps cart module compatible with limit model versions. */
+public final class CartLimitSupport {
+    private CartLimitSupport() { }
+    static Object value(Object bean, String name) {
+        if (bean == null) return null;
+        try { Method m = bean.getClass().getMethod("get" + Character.toUpperCase(name.charAt(0)) + name.substring(1)); return m.invoke(bean); }
+        catch (Exception e) { return null; }
+    }
+    static Integer number(Object bean, String name) { Object v=value(bean,name); return v instanceof Number ? ((Number)v).intValue() : null; }
+    static Object limits(Object product) { Object l=value(product,"productLimits"); return l == null ? product : l; }
+    static Object rules(MerchantStore store) { Object r=value(store,"cartRules"); return r == null ? store : r; }
+    static void checkProduct(Object product, int quantity) {
+        if (quantity == 0) return;
+        Object l=limits(product); Integer min=number(l,"minPerCart"), max=number(l,"maxPerCart"), pack=number(l,"packSize");
+        if (min != null && quantity < min) throw new CartLimitException("MIN_PER_CART");
+        if (max != null && quantity > max) throw new CartLimitException("MAX_PER_CART");
