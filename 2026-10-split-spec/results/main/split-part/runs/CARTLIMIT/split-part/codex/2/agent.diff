+package com.salesmanager.core.business.services.merchant;
+
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.merchant.MerchantRepository;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.merchant.StoreCartRules;
+
+@Service("storeCartRuleService")
+public class StoreCartRuleServiceImpl implements StoreCartRuleService {
+    private final MerchantRepository merchantRepository;
+
+    @Inject
+    public StoreCartRuleServiceImpl(MerchantRepository merchantRepository) { this.merchantRepository = merchantRepository; }
+
+    @Override
+    public StoreCartRules getRules(MerchantStore store) {
+        MerchantStore current = resolve(store);
+        return current == null ? null : read(current);
+    }
+
+    @Override
+    public StoreCartRules updateRules(MerchantStore store, StoreCartRules rules) {
+        if (rules == null) throw new IllegalArgumentException("rules must not be null");
+        validate(rules);
+        MerchantStore current = resolve(store);
+        if (current == null) return null;
+        current.setMaxLines(rules.getMaxLines());
+        current.setMaxUnits(rules.getMaxUnits());
+        merchantRepository.save(current);
+        return read(current);
+    }
+
+    private MerchantStore resolve(MerchantStore store) {
+        if (store == null || store.getId() == null) return null;
+        return merchantRepository.findById(store.getId()).orElse(null);
+    }
+    private static StoreCartRules read(MerchantStore s) { return new StoreCartRules(s.getMaxLines(), s.getMaxUnits()); }
+    static void validate(StoreCartRules rules) {
+        if (rules.getMaxLines() != null && rules.getMaxLines() < 1) throw new IllegalArgumentException("maxLines must be at least 1");
+        if (rules.getMaxUnits() != null && rules.getMaxUnits() < 1) throw new IllegalArgumentException("maxUnits must be at least 1");
+    }
+}
