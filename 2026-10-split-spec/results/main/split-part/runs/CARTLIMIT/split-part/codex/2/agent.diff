+import springfox.documentation.annotations.ApiIgnore;
+
+/** Protected administration endpoints for cart limits and caps. */
+@RestController
+@RequestMapping("/api/v1")
+public class CartRulesApi {
+    @Inject private ProductLimitService productLimitService;
+    @Inject private StoreCartRuleService storeCartRuleService;
+
+    @GetMapping("/private/product/{id}/limits")
+    public ProductLimits getProductLimits(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        ProductCartLimits limits = productLimitService.getLimits(id, store);
+        if (limits == null) throw new ResourceNotFoundException("Product not found");
+        return new ProductLimits(limits.getMinPerCart(), limits.getMaxPerCart(), limits.getPackSize());
+    }
+
+    @PutMapping("/private/product/{id}/limits")
+    public ProductLimits updateProductLimits(@PathVariable Long id, @RequestBody ProductLimits request,
+            @ApiIgnore MerchantStore store) {
+        validateProduct(request);
+        ProductCartLimits limits = productLimitService.updateLimits(id, store,
+                new ProductCartLimits(request.getMinPerCart(), request.getMaxPerCart(), request.getPackSize()));
+        if (limits == null) throw new ResourceNotFoundException("Product not found");
+        return new ProductLimits(limits.getMinPerCart(), limits.getMaxPerCart(), limits.getPackSize());
+    }
+
+    @GetMapping("/private/cart-rules")
+    public CartRules getCartRules(@ApiIgnore MerchantStore store) {
+        StoreCartRules rules = storeCartRuleService.getRules(store);
+        if (rules == null) throw new ResourceNotFoundException("Store not found");
+        return new CartRules(rules.getMaxLines(), rules.getMaxUnits());
+    }
+
+    @PutMapping("/private/cart-rules")
+    public CartRules updateCartRules(@RequestBody CartRules request, @ApiIgnore MerchantStore store) {
+        validateRules(request);
+        StoreCartRules rules = storeCartRuleService.updateRules(store,
+                new StoreCartRules(request.getMaxLines(), request.getMaxUnits()));
+        if (rules == null) throw new ResourceNotFoundException("Store not found");
+        return new CartRules(rules.getMaxLines(), rules.getMaxUnits());
+    }
+
+    private static void validateProduct(ProductLimits limits) {
+        if (limits == null) throw new IllegalArgumentException("Request body is required");
+        positive(limits.getMinPerCart(), "minPerCart");
+        positive(limits.getMaxPerCart(), "maxPerCart");
+        positive(limits.getPackSize(), "packSize");
+        if (limits.getMinPerCart() != null && limits.getMaxPerCart() != null
+                && limits.getMinPerCart() > limits.getMaxPerCart())
+            throw new IllegalArgumentException("minPerCart may not exceed maxPerCart");
+        if (limits.getMaxPerCart() != null && limits.getPackSize() != null
+                && limits.getMaxPerCart() < limits.getPackSize())
+            throw new IllegalArgumentException("maxPerCart may not be less than packSize");
+    }
+
+    private static void validateRules(CartRules rules) {
+        if (rules == null) throw new IllegalArgumentException("Request body is required");
+        positive(rules.getMaxLines(), "maxLines");
+        positive(rules.getMaxUnits(), "maxUnits");
+    }
+
+    private static void positive(Integer value, String name) {
+        if (value != null && value < 1) throw new IllegalArgumentException(name + " must be at least 1");
+    }
+
+    @ExceptionHandler(IllegalArgumentException.class)
+    @ResponseStatus(HttpStatus.BAD_REQUEST)
+    @ResponseBody
+    public String badRequest(IllegalArgumentException e) { return e.getMessage(); }
+}
