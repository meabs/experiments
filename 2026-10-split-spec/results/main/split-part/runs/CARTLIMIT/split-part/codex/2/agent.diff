+package com.salesmanager.core.business.services.catalog.product;
+
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.ProductRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductCartLimits;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productLimitService")
+public class ProductLimitServiceImpl implements ProductLimitService {
+    private final ProductRepository productRepository;
+
+    @Inject
+    public ProductLimitServiceImpl(ProductRepository productRepository) { this.productRepository = productRepository; }
+
+    @Override
+    public ProductCartLimits getLimits(Long productId, MerchantStore store) {
+        Product product = ownedProduct(productId, store);
+        return product == null ? null : read(product);
+    }
+
+    @Override
+    public ProductCartLimits updateLimits(Long productId, MerchantStore store, ProductCartLimits limits) {
+        if (limits == null) throw new IllegalArgumentException("limits must not be null");
+        validate(limits);
+        Product product = ownedProduct(productId, store);
+        if (product == null) return null;
+        // Validation is complete before changing the entity, preserving old values on failure.
+        product.setMinPerCart(limits.getMinPerCart());
+        product.setMaxPerCart(limits.getMaxPerCart());
+        product.setPackSize(limits.getPackSize());
+        try { productRepository.save(product); }
+        catch (RuntimeException e) { throw e; }
+        return read(product);
+    }
+
+    private Product ownedProduct(Long id, MerchantStore store) {
+        if (id == null || store == null || store.getId() == null) return null;
+        Product product = productRepository.findById(id).orElse(null);
+        if (product == null || product.getMerchantStore() == null ||
+                !store.getId().equals(product.getMerchantStore().getId())) return null;
+        return product;
+    }
+
+    private static ProductCartLimits read(Product p) {
+        return new ProductCartLimits(p.getMinPerCart(), p.getMaxPerCart(), p.getPackSize());
+    }
+
+    static void validate(ProductCartLimits l) {
+        positive(l.getMinPerCart(), "minPerCart");
+        positive(l.getMaxPerCart(), "maxPerCart");
+        positive(l.getPackSize(), "packSize");
+        if (l.getMinPerCart() != null && l.getMaxPerCart() != null && l.getMinPerCart() > l.getMaxPerCart())
+            throw new IllegalArgumentException("minPerCart may not exceed maxPerCart");
+        if (l.getMaxPerCart() != null && l.getPackSize() != null && l.getMaxPerCart() < l.getPackSize())
+            throw new IllegalArgumentException("maxPerCart may not be less than packSize");
+    }
+
+    private static void positive(Integer n, String name) {
+        if (n != null && n < 1) throw new IllegalArgumentException(name + " must be at least 1");
+    }
+}
