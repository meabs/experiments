+	private void addLimitWarnings(ReadableShoppingCart destination, ShoppingCart source, MerchantStore store) {
+		List<ShoppingCartLimitWarning> warnings = new ArrayList<>();
+		Set<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> items = source.getLineItems();
+		int units = 0;
+		if (items != null) {
+			for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem item : items) {
+				if (item.getQuantity() == null || item.getProduct() == null) continue;
+				int quantity = item.getQuantity(); units += quantity;
+				com.salesmanager.core.model.catalog.product.Product product = item.getProduct();
+				if (product.getMinPerCart() != null && quantity < product.getMinPerCart()) warnings.add(new ShoppingCartLimitWarning(product.getSku(), "MIN_PER_CART"));
+				if (product.getMaxPerCart() != null && quantity > product.getMaxPerCart()) warnings.add(new ShoppingCartLimitWarning(product.getSku(), "MAX_PER_CART"));
+				if (product.getPackSize() != null && product.getPackSize() > 0 && quantity % product.getPackSize() != 0) warnings.add(new ShoppingCartLimitWarning(product.getSku(), "PACK_SIZE"));
+			}
+			if (store.getMaxLines() != null && items.size() > store.getMaxLines()) warnings.add(new ShoppingCartLimitWarning(null, "MAX_LINES"));
+		}
+		if (store.getMaxUnits() != null && units > store.getMaxUnits()) warnings.add(new ShoppingCartLimitWarning(null, "MAX_UNITS"));
+		destination.setLimitWarnings(warnings);
+	}
 	
 
 
