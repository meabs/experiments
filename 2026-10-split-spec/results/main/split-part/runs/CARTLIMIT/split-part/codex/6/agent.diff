@@ -0,0 +1,160 @@
+package com.salesmanager.shop.store.api.v1.cart;
+
+import java.util.Arrays;
+import java.util.Optional;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.model.cart.CartRules;
+import com.salesmanager.shop.model.catalog.product.ProductLimits;
+import com.salesmanager.shop.store.api.exception.InvalidCartLimitException;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.utils.AuthorizationUtils;
+
+import io.swagger.annotations.Api;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Administrative API for product quantity limits and store cart caps. */
+@RestController
+@RequestMapping("/api/v1/private")
+@Api(tags = { "Cart limits administration" })
+public class CartLimitsApi {
+
+    private static final java.util.List<String> ADMIN_GROUPS = Arrays.asList(
+            Constants.GROUP_SUPERADMIN, Constants.GROUP_ADMIN,
+            Constants.GROUP_ADMIN_CATALOGUE, Constants.GROUP_ADMIN_RETAIL);
+
+    @Inject
+    private ProductService productService;
+
+    @Inject
+    private MerchantStoreService merchantStoreService;
+
+    @Inject
+    private AuthorizationUtils authorizationUtils;
+
+    @GetMapping("/product/{id}/limits")
+    @ResponseStatus(HttpStatus.OK)
+    public ProductLimits getProductLimits(@PathVariable Long id, @ApiIgnore MerchantStore merchantStore) {
+        authorize(merchantStore);
+        return toProductLimits(findProduct(id, merchantStore));
+    }
+
+    @PutMapping("/product/{id}/limits")
+    @ResponseStatus(HttpStatus.OK)
+    public ProductLimits setProductLimits(@PathVariable Long id, @RequestBody ProductLimits limits,
+            @ApiIgnore MerchantStore merchantStore) {
+        authorize(merchantStore);
+        validateProductLimits(limits);
+        Product product = findProduct(id, merchantStore);
+        product.setMinPerCart(limits.getMinPerCart());
+        product.setMaxPerCart(limits.getMaxPerCart());
+        product.setPackSize(limits.getPackSize());
+        saveProduct(product);
+        return toProductLimits(product);
+    }
+
+    @GetMapping("/cart-rules")
+    @ResponseStatus(HttpStatus.OK)
+    public CartRules getCartRules(@ApiIgnore MerchantStore merchantStore) {
+        authorize(merchantStore);
+        return toCartRules(merchantStore);
+    }
+
+    @PutMapping("/cart-rules")
+    @ResponseStatus(HttpStatus.OK)
+    public CartRules setCartRules(@RequestBody CartRules rules, @ApiIgnore MerchantStore merchantStore) {
+        authorize(merchantStore);
+        validateCartRules(rules);
+        merchantStore.setMaxLines(rules.getMaxLines());
+        merchantStore.setMaxUnits(rules.getMaxUnits());
+        try {
+            merchantStoreService.saveOrUpdate(merchantStore);
+        } catch (ServiceException e) {
+            throw new RuntimeException("Unable to save cart rules", e);
+        }
+        return toCartRules(merchantStore);
+    }
+
+    private void authorize(MerchantStore store) {
+        String user = authorizationUtils.authenticatedUser();
+        authorizationUtils.authorizeUser(user, ADMIN_GROUPS, store);
+    }
+
+    private Product findProduct(Long id, MerchantStore store) {
+        Optional<Product> product = productService.retrieveById(id, store);
+        if (!product.isPresent()) {
+            throw new ResourceNotFoundException("Product " + id + " was not found for store " + store.getCode());
+        }
+        return product.get();
+    }
+
+    private void saveProduct(Product product) {
+        try {
+            productService.saveProduct(product);
+        } catch (ServiceException e) {
+            throw new RuntimeException("Unable to save product limits", e);
+        }
+    }
+
+    private static ProductLimits toProductLimits(Product product) {
+        ProductLimits limits = new ProductLimits();
+        limits.setMinPerCart(product.getMinPerCart());
+        limits.setMaxPerCart(product.getMaxPerCart());
+        limits.setPackSize(product.getPackSize());
+        return limits;
+    }
+
+    private static CartRules toCartRules(MerchantStore store) {
+        CartRules rules = new CartRules();
+        rules.setMaxLines(store.getMaxLines());
+        rules.setMaxUnits(store.getMaxUnits());
+        return rules;
+    }
+
+    private static void validateProductLimits(ProductLimits limits) {
+        if (limits == null) {
+            throw new InvalidCartLimitException("Request body is required");
+        }
+        requirePositive(limits.getMinPerCart(), "minPerCart");
+        requirePositive(limits.getMaxPerCart(), "maxPerCart");
+        requirePositive(limits.getPackSize(), "packSize");
+        if (limits.getMinPerCart() != null && limits.getMaxPerCart() != null
+                && limits.getMinPerCart() > limits.getMaxPerCart()) {
+            throw new InvalidCartLimitException("minPerCart may not exceed maxPerCart");
+        }
+        if (limits.getMaxPerCart() != null && limits.getPackSize() != null
+                && limits.getMaxPerCart() < limits.getPackSize()) {
+            throw new InvalidCartLimitException("maxPerCart may not be less than packSize");
+        }
+    }
+
+    private static void validateCartRules(CartRules rules) {
+        if (rules == null) {
+            throw new InvalidCartLimitException("Request body is required");
+        }
+        requirePositive(rules.getMaxLines(), "maxLines");
+        requirePositive(rules.getMaxUnits(), "maxUnits");
+    }
+
+    private static void requirePositive(Integer value, String field) {
+        if (value != null && value < 1) {
+            throw new InvalidCartLimitException(field + " must be at least 1");
+        }
+    }
+}
