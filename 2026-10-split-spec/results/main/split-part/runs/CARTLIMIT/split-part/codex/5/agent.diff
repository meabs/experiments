+import java.io.Serializable;
+
+/** Nullable per-product cart limits used by the private administration API. */
+public class ProductLimits implements Serializable {
+    private static final long serialVersionUID = 1L;
+
+    private Integer minPerCart;
+    private Integer maxPerCart;
+    private Integer packSize;
+
+    public ProductLimits() {
+    }
+
+    public ProductLimits(Integer minPerCart, Integer maxPerCart, Integer packSize) {
