+	private void validateProductLimit(Product product, int quantity) {
+		if (quantity == 0) return;
+		if (product.getMinPerCart() != null && quantity < product.getMinPerCart()) limitViolation("MIN_PER_CART", product.getSku());
+		if (product.getMaxPerCart() != null && quantity > product.getMaxPerCart()) limitViolation("MAX_PER_CART", product.getSku());
+		if (product.getPackSize() != null && product.getPackSize() > 0 && quantity % product.getPackSize() != 0) limitViolation("PACK_SIZE", product.getSku());
+	}
+
+	private void validateStoreLimits(ShoppingCart cart, Product product, int quantity, boolean newCart) {
+		if (quantity == 0) return;
+		int oldUnits = cart.getLineItems() == null ? 0 : cart.getLineItems().stream().mapToInt(i -> i.getQuantity()).sum();
+		boolean existing = cart.getLineItems() != null && cart.getLineItems().stream().anyMatch(i -> i.getProduct().getId().equals(product.getId()));
+		int oldQuantity = existing ? cart.getLineItems().stream().filter(i -> i.getProduct().getId().equals(product.getId())).mapToInt(i -> i.getQuantity()).sum() : 0;
+		long matchingLines = existing ? cart.getLineItems().stream().filter(i -> i.getProduct().getId().equals(product.getId())).count() : 0;
+		int newUnits = oldUnits - oldQuantity + (int) matchingLines * quantity;
+		Integer maxUnits = cart.getMerchantStore() == null ? null : cart.getMerchantStore().getMaxUnits();
+		Integer maxLines = cart.getMerchantStore() == null ? null : cart.getMerchantStore().getMaxLines();
+		if (maxUnits != null && newUnits > maxUnits && quantity > oldQuantity) limitViolation("MAX_UNITS", null);
+		if (maxLines != null && !existing && newCart || maxLines != null && !existing && cart.getLineItems() != null) {
+			int lines = cart.getLineItems() == null ? 0 : (int) cart.getLineItems().stream()
+					.filter(i -> i.getQuantity() > 0).map(i -> i.getProduct().getId()).distinct().count();
+			if (lines + 1 > maxLines) limitViolation("MAX_LINES", null);
+		}
+	}
+
+	private void validateMultiLimits(ShoppingCart cart, List<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> changes, MerchantStore store) {
+		java.util.Map<Long,Integer> quantities = new java.util.HashMap<>();
+		if (cart.getLineItems() != null) for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : cart.getLineItems()) quantities.put(i.getProduct().getId(), i.getQuantity());
+		int oldUnits = quantities.values().stream().mapToInt(Integer::intValue).sum();
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : changes) {
+			validateProductLimit(i.getProduct(), i.getQuantity());
+			quantities.put(i.getProduct().getId(), i.getQuantity());
+		}
+		int newUnits = quantities.values().stream().mapToInt(Integer::intValue).sum();
+		int oldLines = cart.getLineItems() == null ? 0 : (int) cart.getLineItems().stream()
+				.filter(i -> i.getQuantity() > 0).map(i -> i.getProduct().getId()).distinct().count();
+		int newLines = (int) quantities.values().stream().filter(q -> q > 0).count();
+		boolean addsUnits = newUnits > oldUnits;
+		if (store.getMaxUnits() != null && addsUnits && newUnits > store.getMaxUnits()) limitViolation("MAX_UNITS", null);
+		if (store.getMaxLines() != null && newLines > oldLines && newLines > store.getMaxLines()) limitViolation("MAX_LINES", null);
+	}
+
+	private void limitViolation(String rule, String sku) {
+		String message = rule + (sku == null ? "" : " for " + sku);
+		throw new ServiceRuntimeException(rule, message, new IllegalArgumentException(message));
+	}
+
 	@Override
 	public ReadableShoppingCart getById(Long shoppingCartId, MerchantStore store, Language language) throws Exception {
 
