+package com.salesmanager.shop.store.api.v1.limits;
+
+import javax.inject.Inject;
+
+import org.springframework.http.MediaType;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductLimits;
+import com.salesmanager.shop.model.store.CartRules;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Private administration endpoints for cart limits and caps. */
+@RestController
+@RequestMapping(value = "/api/v1", produces = MediaType.APPLICATION_JSON_VALUE)
+public class CartLimitsApi {
+
+    @Inject
+    private ProductService productService;
+
+    @Inject
+    private MerchantStoreService merchantStoreService;
+
+    @GetMapping("/private/product/{id}/limits")
+    @ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT") })
+    public ProductLimits getProductLimits(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        return toLimits(product(id, store));
+    }
+
+    @PutMapping("/private/product/{id}/limits")
+    @ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT") })
+    public ProductLimits setProductLimits(@PathVariable Long id, @RequestBody ProductLimits limits,
+            @ApiIgnore MerchantStore store) {
+        requireProductLimits(limits);
+        Product product = product(id, store);
+        product.setMinPerCart(limits.getMinPerCart());
+        product.setMaxPerCart(limits.getMaxPerCart());
+        product.setPackSize(limits.getPackSize());
+        try {
+            productService.saveProduct(product);
+        } catch (ServiceException e) {
+            throw new RestApiException("500", "Unable to save product limits", e);
+        }
+        return toLimits(product);
+    }
+
+    @GetMapping("/private/cart-rules")
+    @ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT") })
+    public CartRules getCartRules(@ApiIgnore MerchantStore store) {
+        return toRules(store);
+    }
+
+    @PutMapping("/private/cart-rules")
+    @ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT") })
+    public CartRules setCartRules(@RequestBody CartRules rules, @ApiIgnore MerchantStore store) {
+        requireCartRules(rules);
+        store.setMaxLines(rules.getMaxLines());
+        store.setMaxUnits(rules.getMaxUnits());
+        try {
+            merchantStoreService.saveOrUpdate(store);
+        } catch (ServiceException e) {
+            throw new RestApiException("500", "Unable to save cart rules", e);
+        }
+        return toRules(store);
+    }
+
+    private Product product(Long id, MerchantStore store) {
+        Product product = store == null ? null : productService.findOne(id, store);
+        if (product == null) {
+            throw new ResourceNotFoundException("Product not found");
+        }
+        return product;
+    }
+
+    private static ProductLimits toLimits(Product product) {
+        return new ProductLimits(product.getMinPerCart(), product.getMaxPerCart(), product.getPackSize());
+    }
+
+    private static CartRules toRules(MerchantStore store) {
+        if (store == null) {
+            throw new ResourceNotFoundException("Store not found");
+        }
+        return new CartRules(store.getMaxLines(), store.getMaxUnits());
+    }
+
+    private static void requireProductLimits(ProductLimits limits) {
+        if (limits == null || invalid(limits.getMinPerCart()) || invalid(limits.getMaxPerCart())
+                || invalid(limits.getPackSize())
+                || limits.getMinPerCart() != null && limits.getMaxPerCart() != null
+                    && limits.getMinPerCart() > limits.getMaxPerCart()
+                || limits.getMaxPerCart() != null && limits.getPackSize() != null
+                    && limits.getMaxPerCart() < limits.getPackSize()) {
+            throw new RestApiException("400", "Invalid product cart limits");
+        }
+    }
+
+    private static void requireCartRules(CartRules rules) {
+        if (rules == null || invalid(rules.getMaxLines()) || invalid(rules.getMaxUnits())) {
+            throw new RestApiException("400", "Invalid cart rules");
+        }
+    }
+
+    private static boolean invalid(Integer value) {
+        return value != null && value < 1;
+    }
+}
