+package com.salesmanager.core.business.services.wishlist;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Optional;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.wishlist.WishlistItemRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.wishlist.WishlistItem;
+
+@Service("wishlistService")
+public class WishlistServiceImpl implements WishlistService {
+    private static final int MAX_ITEMS = 50;
+    private final WishlistItemRepository repository;
+    private final ProductService productService;
+
+    @Inject
+    public WishlistServiceImpl(WishlistItemRepository repository, ProductService productService) {
+        this.repository = repository;
+        this.productService = productService;
+    }
+
+    @Override
+    @Transactional(readOnly = true)
+    public List<WishlistEntry> list(Customer customer, MerchantStore store) throws ServiceException {
+        List<WishlistEntry> result = new ArrayList<WishlistEntry>();
+        for (WishlistItem item : repository.findByCustomerIdAndMerchantStoreIdOrderByAddedAtDesc(customer.getId(), store.getId())) {
+            Product product = productService.findOne(item.getProductId(), store);
+            if (product != null) result.add(new WishlistEntry(item, product));
+        }
+        return result;
+    }
+
+    @Override
+    @Transactional
+    public WishlistEntry add(Customer customer, MerchantStore store, String sku) throws ServiceException {
+        Product product = productService.getBySku(sku, store);
+        if (product == null) throw new ServiceException("Product not found: " + sku);
+        Optional<WishlistItem> existing = repository.findByCustomerIdAndMerchantStoreIdAndProductId(customer.getId(), store.getId(), product.getId());
+        if (existing.isPresent()) return new WishlistEntry(existing.get(), product);
+        if (repository.countByCustomerIdAndMerchantStoreId(customer.getId(), store.getId()) >= MAX_ITEMS)
+            throw new WishlistLimitExceededException("A wishlist can contain at most 50 products");
+        WishlistItem item = repository.save(new WishlistItem(customer.getId(), store.getId(), product.getId(), product.getSku()));
+        return new WishlistEntry(item, product);
+    }
+
+    @Override
+    @Transactional
+    public void remove(Customer customer, MerchantStore store, String sku) throws ServiceException {
+        Product product = productService.getBySku(sku, store);
+        if (product != null) repository.deleteByCustomerIdAndMerchantStoreIdAndProductId(customer.getId(), store.getId(), product.getId());
+    }
+
+    @Override
+    @Transactional(readOnly = true)
+    public boolean contains(Customer customer, MerchantStore store, String sku) throws ServiceException {
+        Product product = productService.getBySku(sku, store);
+        return product != null && repository.findByCustomerIdAndMerchantStoreIdAndProductId(customer.getId(), store.getId(), product.getId()).isPresent();
+    }
+
+    @Override
+    public void removeAfterCartSuccess(Customer customer, MerchantStore store, String sku) throws ServiceException { remove(customer, store, sku); }
+
+    @Override
+    @Transactional(readOnly = true)
+    public List<WishlistPopularItem> popular(MerchantStore store) {
+        List<WishlistPopularItem> result = new ArrayList<WishlistPopularItem>();
+        for (Object[] row : repository.findPopular(store.getId())) {
+            if (result.size() == 10) break;
+            result.add(new WishlistPopularItem((String) row[0], ((Number) row[1]).longValue()));
+        }
+        return result;
+    }
+
+    @Override
+    @Transactional
+    public int removeDeletedProduct(Long productId, MerchantStore store) {
+        return store == null ? repository.deleteForProduct(productId) : repository.deleteForProduct(productId, store.getId());
+    }
+}
