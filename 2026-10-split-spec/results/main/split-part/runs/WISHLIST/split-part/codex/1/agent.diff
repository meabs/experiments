+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.math.BigDecimal;
+import java.security.Principal;
+import java.util.ArrayList;
+import java.util.List;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.server.ResponseStatusException;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.wishlist.WishlistEntry;
+import com.salesmanager.core.business.services.wishlist.WishlistLimitExceededException;
+import com.salesmanager.core.business.services.wishlist.WishlistService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.model.wishlist.PersistableWishlistItem;
+import com.salesmanager.shop.model.wishlist.ReadableWishlist;
+import com.salesmanager.shop.model.wishlist.ReadableWishlistItem;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.UnauthorizedException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/auth/customer/wishlist")
+public class CustomerWishlistApi {
+    @Inject private WishlistService wishlistService;
+    @Inject private CustomerFacade customerFacade;
+    @Inject private ShoppingCartFacade shoppingCartFacade;
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal principal = request.getUserPrincipal();
+        if (principal == null) throw new UnauthorizedException();
+        Customer c = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (c == null) throw new UnauthorizedException();
+        return c;
+    }
+    private ReadableWishlist readable(List<WishlistEntry> entries) {
+        ReadableWishlist result = new ReadableWishlist();
+        for (WishlistEntry entry : entries) {
+            Product p = entry.getProduct();
+            ReadableWishlistItem item = new ReadableWishlistItem();
+            item.setSku(entry.getSku()); item.setAddedAt(entry.getAddedAt());
+            item.setName(p.getProductDescription() == null ? null : p.getProductDescription().getName());
+            BigDecimal price = null; boolean available = false;
+            if (p.getAvailabilities() != null) for (ProductAvailability a : p.getAvailabilities()) {
+                available |= Boolean.TRUE.equals(a.getAvailable()) && a.getProductQuantity() != null && a.getProductQuantity() > 0;
+                if (a.getPrices() != null && !a.getPrices().isEmpty()) {
+                    ProductPrice pp = a.getPrices().iterator().next(); price = pp.getProductPriceAmount();
+                }
+            }
+            item.setPrice(price); item.setAvailable(available); result.getItems().add(item);
+        }
+        result.setCount(result.getItems().size()); return result;
+    }
+    @GetMapping public ReadableWishlist get(HttpServletRequest request, @ApiIgnore MerchantStore store) throws Exception {
+        return readable(wishlistService.list(customer(request, store), store));
+    }
+    @PostMapping public ResponseEntity<ReadableWishlist> add(@RequestBody PersistableWishlistItem body, HttpServletRequest request, @ApiIgnore MerchantStore store) throws Exception {
+        if (body == null || body.getProduct() == null || body.getProduct().trim().isEmpty()) return new ResponseEntity<ReadableWishlist>(HttpStatus.BAD_REQUEST);
+        Customer c = customer(request, store);
+        boolean duplicate = wishlistService.contains(c, store, body.getProduct());
+        try { wishlistService.add(c, store, body.getProduct()); }
+        catch (WishlistLimitExceededException e) { return new ResponseEntity<ReadableWishlist>(HttpStatus.BAD_REQUEST); }
+        catch (ServiceException e) { throw new ResourceNotFoundException("Unknown product [" + body.getProduct() + "]"); }
+        return new ResponseEntity<ReadableWishlist>(readable(wishlistService.list(c, store)), duplicate ? HttpStatus.OK : HttpStatus.CREATED);
+    }
+    @DeleteMapping("/{sku}") public ResponseEntity<Void> remove(@PathVariable String sku, HttpServletRequest request, @ApiIgnore MerchantStore store) throws Exception {
+        Customer c = customer(request, store);
+        if (!wishlistService.contains(c, store, sku)) throw new ResourceNotFoundException("Product is not on wishlist");
+        wishlistService.remove(c, store, sku); return new ResponseEntity<Void>(HttpStatus.NO_CONTENT);
+    }
+    @PostMapping("/{sku}/cart/{cartCode}") public ResponseEntity<ReadableShoppingCart> move(@PathVariable String sku, @PathVariable String cartCode, HttpServletRequest request, @ApiIgnore MerchantStore store, @ApiIgnore Language language) throws Exception {
+        Customer c = customer(request, store);
+        if (!wishlistService.contains(c, store, sku)) throw new ResourceNotFoundException("Product is not on wishlist");
+        boolean available = false;
+        for (WishlistEntry e : wishlistService.list(c, store)) if (sku.equals(e.getSku())) {
+            Product p = e.getProduct();
+            if (p.getAvailabilities() != null) for (ProductAvailability a : p.getAvailabilities())
+                available |= Boolean.TRUE.equals(a.getAvailable()) && a.getProductQuantity() != null && a.getProductQuantity() > 0;
+            break;
+        }
+        if (!available) throw new ResponseStatusException(HttpStatus.CONFLICT, "Product is unavailable or out of stock");
+        if (shoppingCartFacade.getByCode(cartCode, store, language) == null) throw new ResourceNotFoundException("Cart not found");
+        PersistableShoppingCartItem item = new PersistableShoppingCartItem(); item.setProduct(sku); item.setQuantity(1);
+        ReadableShoppingCart cart = shoppingCartFacade.modifyCart(cartCode, item, store, language);
+        wishlistService.removeAfterCartSuccess(c, store, sku);
+        return new ResponseEntity<ReadableShoppingCart>(cart, HttpStatus.OK);
+    }
+}
