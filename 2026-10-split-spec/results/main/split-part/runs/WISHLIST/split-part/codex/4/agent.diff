+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Authenticated customer's wishlist endpoints. */
+@RestController
+@RequestMapping("/api/v1/auth/customer/wishlist")
+public class WishlistApi {
+    @Inject private WishlistService wishlistService;
+    @Inject private CustomerService customerService;
+    @Inject private CustomerFacade customerFacade;
+    @Inject private ShoppingCartFacade shoppingCartFacade;
+
+    @GetMapping
+    public ReadableWishlist get(@ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest request) {
+        return view(customer(request, store), store);
+    }
+
+    @PostMapping
+    public ResponseEntity<ReadableWishlist> add(@Valid @RequestBody PersistableWishlist requestBody,
+            @ApiIgnore MerchantStore store, HttpServletRequest request) {
+        Customer customer = customer(request, store);
+        boolean alreadyThere;
+        try {
+            alreadyThere = wishlistService.find(customer, store, requestBody.getProduct()) != null;
+            wishlistService.add(customer, store, requestBody.getProduct());
+        } catch (WishlistExceptions.ProductNotFound e) {
+            throw new ResponseStatusException(HttpStatus.NOT_FOUND, e.getMessage(), e);
+        } catch (WishlistExceptions.InvalidWishlistRequest e) {
+            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, e.getMessage(), e);
+        } catch (WishlistExceptions.WishlistConflict e) {
+            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, e.getMessage(), e);
+        }
+        return ResponseEntity.status(alreadyThere ? HttpStatus.OK : HttpStatus.CREATED).body(view(customer, store));
+    }
+
+    @DeleteMapping("/{sku}")
+    public ResponseEntity<Void> remove(@PathVariable String sku, @ApiIgnore MerchantStore store,
+            HttpServletRequest request) {
+        Customer customer = customer(request, store);
+        if (!wishlistService.remove(customer, store, sku)) {
+            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Product is not on the wishlist");
+        }
+        return ResponseEntity.noContent().build();
+    }
+
+    @PostMapping("/{sku}/cart/{cartCode}")
+    public ReadableShoppingCart move(@PathVariable String sku, @PathVariable String cartCode,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest request) throws Exception {
+        Customer customer = customer(request, store);
+        if (wishlistService.find(customer, store, sku) == null) {
+            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Product is not on the wishlist");
+        }
+        PersistableShoppingCartItem item = new PersistableShoppingCartItem();
+        item.setProduct(sku);
+        item.setQuantity(1);
+        ReadableShoppingCart cart;
+        try {
+            cart = shoppingCartFacade.modifyCart(cartCode, item, store, language);
+        } catch (Exception e) {
+            if (e instanceof com.salesmanager.shop.store.api.exception.ResourceNotFoundException) {
+                throw new ResponseStatusException(HttpStatus.NOT_FOUND, e.getMessage(), e);
+            }
+            throw new ResponseStatusException(HttpStatus.CONFLICT, e.getMessage(), e);
+        }
+        if (cart == null) throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Cart not found");
+        // Remove only after the cart operation succeeds, preserving failed-move atomicity.
+        wishlistService.remove(customer, store, sku);
+        return cart;
+    }
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal principal = request.getUserPrincipal();
+        if (principal == null) throw new ResponseStatusException(HttpStatus.UNAUTHORIZED, "Authentication required");
+        try {
+            Customer customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+            if (customer == null) throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Customer not found");
+            return customer;
+        } catch (ResponseStatusException e) { throw e; }
+        catch (Exception e) { throw new ResponseStatusException(HttpStatus.UNAUTHORIZED, "Authentication required", e); }
+    }
+
+    private ReadableWishlist view(Customer customer, MerchantStore store) {
+        List<WishlistItem> source = wishlistService.get(customer, store);
+        ReadableWishlist result = new ReadableWishlist();
+        result.setCount(source.size());
+        result.setItems(source.stream().map(i -> {
+            ReadableWishlist.Item item = new ReadableWishlist.Item();
+            com.salesmanager.core.model.catalog.product.Product p = i.getProduct();
+            item.setSku(p.getSku());
+            item.setName(p.getDescriptions().stream().findFirst().map(d -> d.getName()).orElse(null));
+            item.setAvailable(p.isAvailable());
+            ProductAvailability a = p.getAvailabilities().stream().findFirst().orElse(null);
+            if (a != null) {
+                item.setAvailable(item.isAvailable() && Boolean.TRUE.equals(a.getAvailable()) && a.getProductQuantity() != null && a.getProductQuantity() > 0);
+                ProductPrice price = a.getPrices().stream().filter(ProductPrice::isDefaultPrice).findFirst().orElse(a.getPrices().stream().findFirst().orElse(null));
+                if (price != null) item.setPrice(price.getProductPriceAmount());
+            }
+            item.setAddedAt(i.getAddedAt());
+            return item;
+        }).collect(Collectors.toList()));
+        return result;
+    }
