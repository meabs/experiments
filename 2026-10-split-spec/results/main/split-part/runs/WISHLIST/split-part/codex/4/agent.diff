+package com.salesmanager.shop.store.api.v1.admin;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+
+import javax.inject.Inject;
+
+import org.springframework.http.MediaType;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.wishlist.WishlistService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.wishlist.PopularWishlistProduct;
+
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Protected administrative wishlist endpoints. */
+@RestController
+@RequestMapping("/api/v1")
+public class WishlistAdminApi {
+
+	@Inject
+	private WishlistService wishlistService;
+
+	/**
+	 * Returns the ten most wished products for the resolved merchant store.
+	 * MerchantStoreArgumentResolver performs store resolution and authorization.
+	 */
+	@GetMapping(value = "/private/wishlists/popular", produces = MediaType.APPLICATION_JSON_VALUE)
+	@ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT") })
+	public List<PopularWishlistProduct> popular(@ApiIgnore MerchantStore merchantStore) {
+		List<?> popular = wishlistService.popular(merchantStore, 10);
+		List<PopularWishlistProduct> response = new ArrayList<>();
+		if (popular == null) {
+			return response;
+		}
+		for (Object item : popular) {
+			if (item instanceof PopularWishlistProduct) {
+				response.add((PopularWishlistProduct) item);
+			} else if (item instanceof Map) {
+				Map<?, ?> values = (Map<?, ?>) item;
+				response.add(new PopularWishlistProduct(String.valueOf(values.get("sku")),
+						((Number) values.get("count")).longValue()));
+			} else {
+				response.add(new PopularWishlistProduct(readSku(item), readCount(item)));
+			}
+		}
+		return response;
+	}
+
+	private String readSku(Object item) {
+		try {
+			return String.valueOf(item.getClass().getMethod("getSku").invoke(item));
+		} catch (ReflectiveOperationException e) {
+			throw new IllegalStateException("Popular wishlist result does not expose sku", e);
+		}
+	}
+
+	private long readCount(Object item) {
+		try {
+			return ((Number) item.getClass().getMethod("getCount").invoke(item)).longValue();
+		} catch (ReflectiveOperationException e) {
+			throw new IllegalStateException("Popular wishlist result does not expose count", e);
+		}
+	}
+}
