+package com.salesmanager.core.business.services.wishlist;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.wishlist.WishlistItemRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.wishlist.*;
+@Service("wishlistService")
+public class WishlistServiceImpl implements WishlistService {
+    private final WishlistItemRepository repository; private final ProductService products;
+    @Inject public WishlistServiceImpl(WishlistItemRepository repository, ProductService products) { this.repository = repository; this.products = products; }
+    private void valid(Customer c, MerchantStore s) { if (c == null || s == null) throw new WishlistExceptions.InvalidWishlistRequest("Customer and store are required"); }
+    @Override @Transactional public WishlistItem add(Customer c, MerchantStore s, String sku) {
+        valid(c,s); if (sku == null || sku.trim().isEmpty()) throw new WishlistExceptions.InvalidWishlistRequest("Product is required");
+        Optional<WishlistItem> existing = repository.findByCustomerIdAndMerchantStoreIdAndProductSku(c.getId(), s.getId(), sku);
+        if (existing.isPresent()) return existing.get();
+        if (repository.countByCustomerIdAndMerchantStoreId(c.getId(), s.getId()) >= 50) throw new WishlistExceptions.WishlistConflict("Wishlist limit is 50 products");
+        Product p; try { p = products.getBySku(sku, s); } catch (ServiceException e) { throw new WishlistExceptions.ProductNotFound("Unknown product sku: " + sku); }
+        WishlistItem item = new WishlistItem(); item.setCustomer(c); item.setMerchantStore(s); item.setProduct(p); item.setAddedAt(new Date()); return repository.save(item);
+    }
+    @Override @Transactional(readOnly=true) public List<WishlistItem> get(Customer c, MerchantStore s) { valid(c,s); return repository.findByCustomerIdAndMerchantStoreIdOrderByAddedAtDesc(c.getId(), s.getId()); }
+    @Override @Transactional public boolean remove(Customer c, MerchantStore s, String sku) { valid(c,s); if (sku == null || sku.trim().isEmpty()) throw new WishlistExceptions.InvalidWishlistRequest("Product is required"); Optional<WishlistItem> i = repository.findByCustomerIdAndMerchantStoreIdAndProductSku(c.getId(), s.getId(), sku); if (!i.isPresent()) return false; repository.delete(i.get()); return true; }
+    @Override @Transactional(readOnly=true) public WishlistItem find(Customer c, MerchantStore s, String sku) { valid(c,s); return repository.findByCustomerIdAndMerchantStoreIdAndProductSku(c.getId(), s.getId(), sku).orElse(null); }
+    @Override @Transactional(readOnly=true) public List<WishlistPopular> popular(MerchantStore s, int limit) { if (s == null) throw new WishlistExceptions.InvalidWishlistRequest("Store is required"); if (limit < 0) throw new WishlistExceptions.InvalidWishlistRequest("Limit must not be negative"); List<WishlistPopular> out = new ArrayList<>(); for (Object[] row : repository.popular(s.getId())) { if (out.size() >= limit) break; out.add(new WishlistPopular((String)row[0], ((Number)row[1]).longValue())); } return out; }
+}
