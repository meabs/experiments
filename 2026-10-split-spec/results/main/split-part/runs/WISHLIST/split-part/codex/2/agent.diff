+package com.salesmanager.core.business.repositories.wishlist;
+import java.time.Instant;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Repository;
+import com.salesmanager.core.model.wishlist.WishlistEntry;
+@Repository
+public class WishlistRepository {
+ private final WishlistJpaRepository delegate;
+ @Inject public WishlistRepository(WishlistJpaRepository d){delegate=d;}
+ public List<WishlistEntry> find(long c,int s){return delegate.findByCustomerIdAndStoreIdOrderByAddedAtDesc(c,s);}
+ public boolean add(long c,int s,String sku,Instant at){if(delegate.findByCustomerIdAndStoreIdAndSku(c,s,sku)!=null)return false;if(delegate.countByCustomerIdAndStoreId(c,s)>=50)throw new IllegalStateException("Wishlist limit is 50"); WishlistEntry e=new WishlistEntry();e.setCustomerId(c);e.setStoreId(s);e.setSku(sku);e.setAddedAt(at);delegate.save(e);return true;}
+ public boolean remove(long c,int s,String sku){WishlistEntry e=delegate.findByCustomerIdAndStoreIdAndSku(c,s,sku);if(e==null)return false;delegate.delete(e);return true;}
+ public void removeProduct(String sku){delegate.deleteBySku(sku);}
+ public List<WishlistEntry> all(int s){return delegate.findByStoreId(s);}
+}
