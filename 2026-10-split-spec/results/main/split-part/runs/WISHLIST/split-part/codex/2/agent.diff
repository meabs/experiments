+package com.salesmanager.core.business.services.wishlist;
+
+import java.math.BigDecimal;
+import java.time.Instant;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.wishlist.WishlistRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.wishlist.PopularProduct;
+import com.salesmanager.core.model.wishlist.Wishlist;
+import com.salesmanager.core.model.wishlist.WishlistItem;
+import com.salesmanager.core.model.wishlist.WishlistEntry;
+
+@Service
+public class WishlistServiceImpl implements WishlistService {
+    private final WishlistRepository repository;
+    private final ProductService productService;
+    @Inject public WishlistServiceImpl(WishlistRepository repository, ProductService productService) {
+        this.repository = repository; this.productService = productService;
+    }
+    private long id(Object o) { return o instanceof Customer ? ((Customer)o).getId() : 0L; }
+    private int store(MerchantStore s) { return s == null || s.getId() == null ? 0 : s.getId(); }
+    private Product product(MerchantStore store, String sku) {
+        if (sku == null || sku.trim().isEmpty()) throw new IllegalArgumentException("sku is required");
+        Product p;
+        try { p = productService.getBySku(sku, store); }
+        catch (Exception ex) { throw new java.util.NoSuchElementException("Unknown sku: " + sku); }
+        if (p == null) throw new java.util.NoSuchElementException("Unknown sku: " + sku);
+        return p;
+    }
+    @Override public Wishlist list(Customer customer, MerchantStore store) {
+        Wishlist out = new Wishlist();
+        repository.find(id(customer), store(store)).forEach(e -> {
+            Product p = product(store, e.getSku());
+            BigDecimal price = null;
+            for (ProductAvailability a : p.getAvailabilities()) if (a.defaultPrice() != null) { price = a.defaultPrice().getProductPriceAmount(); break; }
+            String name = p.getDescriptions().isEmpty() ? p.getSku() : p.getDescriptions().iterator().next().getName();
+            boolean inStock = p.getAvailabilities().stream().anyMatch(a -> a.getProductQuantity() != null && a.getProductQuantity() > 0);
+            out.getItems().add(new WishlistItem(p.getSku(), name, price, p.isAvailable() && inStock, e.getAddedAt()));
+        });
+        out.setCount(out.getItems().size()); return out;
+    }
+    @Override public void add(Customer c, MerchantStore s, String sku) { product(s, sku); repository.add(id(c), store(s), sku, Instant.now()); }
+    @Override public boolean remove(Customer c, MerchantStore s, String sku) { return repository.remove(id(c), store(s), sku); }
+    @Override public boolean move(Customer c, MerchantStore s, String sku) { return remove(c, s, sku); }
+    @Override public void removeProduct(String sku) { repository.removeProduct(sku); }
+    @Override public List<PopularProduct> popular(MerchantStore s) {
+        Map<String, java.util.Set<Long>> counts = new HashMap<>();
+        repository.all(store(s)).forEach(e -> counts.computeIfAbsent(e.getSku(), k -> new java.util.HashSet<>()).add(e.getCustomerId()));
+        List<PopularProduct> out = new ArrayList<>(); counts.forEach((sku, ids) -> out.add(new PopularProduct(sku, ids.size())));
+        out.sort(Comparator.comparingLong(PopularProduct::getCustomerCount).reversed().thenComparing(PopularProduct::getSku));
+        return out.size() > 10 ? out.subList(0, 10) : out;
+    }
+}
