+
+import java.util.List;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.wishlist.WishlistService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.wishlist.PopularProduct;
+import com.salesmanager.shop.model.wishlist.PopularWishlistProduct;
+
+import io.swagger.annotations.Api;
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Administrative reporting endpoints for wishlist activity. */
+@RestController
+@RequestMapping("/api/v1")
+@Api(tags = { "Wishlist administration" })
+public class WishlistAdminApi {
+
+    @Inject
+    private WishlistService wishlistService;
+
+    @GetMapping("/private/wishlists/popular")
+    @ResponseStatus(HttpStatus.OK)
+    @ApiImplicitParams({
+        @ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT")
+    })
+    public List<PopularWishlistProduct> popular(@ApiIgnore MerchantStore merchantStore) {
+        return wishlistService.popular(merchantStore).stream()
+                .map(this::toResponse)
+                .collect(Collectors.toList());
+    }
+
+    private PopularWishlistProduct toResponse(PopularProduct product) {
+        return new PopularWishlistProduct(product.getSku(), product.getCustomerCount());
+    }
+}
