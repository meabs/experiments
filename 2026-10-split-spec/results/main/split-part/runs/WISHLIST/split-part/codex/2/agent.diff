@@ -0,0 +1,128 @@
+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.security.Principal;
+import java.util.Date;
+
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.wishlist.WishlistService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.wishlist.Wishlist;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.model.wishlist.PersistableWishlistItem;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.UnauthorizedException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Authenticated customer's wishlist endpoints. */
+@RestController
+@RequestMapping("/api/v1/auth/customer/wishlist")
+public class CustomerWishlistApi {
+    @Inject private WishlistService wishlistService;
+    @Inject private CustomerFacade customerFacade;
+    @Inject private ShoppingCartFacade shoppingCartFacade;
+    @Inject private ProductService productService;
+
+    @PostMapping
+    public ResponseEntity<?> add(@RequestBody PersistableWishlistItem request,
+            @ApiIgnore MerchantStore store, HttpServletRequest servletRequest) {
+        try {
+            Customer customer = customer(servletRequest, store);
+            if (request == null || request.getProduct() == null || request.getProduct().trim().isEmpty())
+                return ResponseEntity.badRequest().build();
+            Wishlist before = wishlistService.list(customer, store);
+            boolean duplicate = before.getItems().stream().anyMatch(i -> request.getProduct().equals(i.getSku()));
+            wishlistService.add(customer, store, request.getProduct());
+            return new ResponseEntity<>(wishlistService.list(customer, store),
+                    duplicate ? HttpStatus.OK : HttpStatus.CREATED);
+        } catch (java.util.NoSuchElementException e) {
+            return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+        } catch (IllegalStateException e) {
+            return ResponseEntity.badRequest().build();
+        }
+    }
+
+    @GetMapping
+    public Wishlist list(@ApiIgnore MerchantStore store, HttpServletRequest request) {
+        return wishlistService.list(customer(request, store), store);
+    }
+
+    @DeleteMapping("/{sku}")
+    public ResponseEntity<Void> remove(@PathVariable String sku, @ApiIgnore MerchantStore store,
+            HttpServletRequest request) {
+        if (!wishlistService.remove(customer(request, store), store, sku))
+            return ResponseEntity.notFound().build();
+        return ResponseEntity.noContent().build();
+    }
+
+    @PostMapping("/{sku}/cart/{cartCode}")
+    public ResponseEntity<?> move(@PathVariable String sku, @PathVariable String cartCode,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest request) {
+        Customer customer = customer(request, store);
+        Wishlist wishlist = wishlistService.list(customer, store);
+        if (wishlist.getItems().stream().noneMatch(i -> sku.equals(i.getSku())))
+            return ResponseEntity.notFound().build();
+        ShoppingCart cart;
+        try { cart = shoppingCartFacade.getShoppingCartModel(cartCode, store); }
+        catch (Exception e) { return ResponseEntity.notFound().build(); }
+        if (cart == null) return ResponseEntity.notFound().build();
+        Product product;
+        try { product = productService.getBySku(sku, store, language); }
+        catch (Exception e) { return ResponseEntity.notFound().build(); }
+        if (product == null) return ResponseEntity.notFound().build();
+        if (!available(product)) return ResponseEntity.status(HttpStatus.CONFLICT).build();
+
+        int quantity = 1;
+        if (cart.getLineItems() != null) {
+            for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem item : cart.getLineItems())
+                if (item.getProduct() != null && sku.equals(item.getProduct().getSku())) quantity += item.getQuantity();
+        }
+        PersistableShoppingCartItem item = new PersistableShoppingCartItem();
+        item.setProduct(sku); item.setQuantity(quantity);
+        try {
+            ReadableShoppingCart result = shoppingCartFacade.modifyCart(cartCode, item, store, language);
+            wishlistService.move(customer, store, sku);
+            return ResponseEntity.ok(result);
+        } catch (Exception e) {
+            return ResponseEntity.status(HttpStatus.CONFLICT).build();
+        }
+    }
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal principal = request.getUserPrincipal();
+        if (principal == null) throw new UnauthorizedException();
+        Customer customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (customer == null) throw new ResourceNotFoundException("Customer not found");
+        return customer;
+    }
+
+    private boolean available(Product product) {
+        if (!product.isAvailable() || product.getDateAvailable() != null && product.getDateAvailable().after(new Date())) return false;
+        if (product.getAvailabilities() == null || product.getAvailabilities().isEmpty()) return false;
+        for (ProductAvailability a : product.getAvailabilities())
+            if (a.getProductQuantity() == null || a.getProductQuantity() <= 0) return false;
+        return true;
+    }
+
+}
