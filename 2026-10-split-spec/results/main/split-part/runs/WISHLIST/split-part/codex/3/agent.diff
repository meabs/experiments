+package com.salesmanager.core.business.services.wishlist;
+
+import java.math.BigDecimal;
+import java.util.*;
+import javax.transaction.Transactional;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.wishlist.WishlistRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.shoppingcart.ShoppingCartService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.description.ProductDescription;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+import com.salesmanager.core.model.wishlist.WishlistItem;
+
+@Service
+public class WishlistServiceImpl implements WishlistService {
+    private static final int LIMIT = 50;
+    private final WishlistRepository repository;
+    private final ProductService productService;
+    private final ShoppingCartService cartService;
+    public WishlistServiceImpl(WishlistRepository repository, ProductService productService, ShoppingCartService cartService) { this.repository=repository; this.productService=productService; this.cartService=cartService; }
+
+    @Override public List<WishlistItemView> list(Customer customer, MerchantStore store) throws ServiceException {
+        List<WishlistItemView> result = new ArrayList<>();
+        for (WishlistItem item : repository.findForCustomer(customer.getId(), store.getId())) result.add(view(item));
+        return result;
+    }
+    @Override @Transactional public void add(Customer customer, MerchantStore store, String sku) throws ServiceException {
+        if (sku == null || sku.trim().isEmpty()) throw new IllegalArgumentException("product is required");
+        Product product = productService.getBySku(sku, store);
+        if (product == null) throw new WishlistException("Unknown product sku: " + sku);
+        if (repository.findByCustomer_IdAndMerchantStore_IdAndProduct_Sku(customer.getId(), store.getId(), sku) != null) return;
+        if (repository.countByCustomer_IdAndMerchantStore_Id(customer.getId(), store.getId()) >= LIMIT) throw new WishlistFullException();
+        WishlistItem item = new WishlistItem(); item.setCustomer(customer); item.setMerchantStore(store); item.setProduct(product); item.setAddedAt(new Date()); repository.save(item);
+    }
+    @Override @Transactional public void remove(Customer customer, MerchantStore store, String sku) throws ServiceException {
+        WishlistItem item = find(customer, store, sku); if (item == null) throw new WishlistException("Product is not on wishlist"); repository.delete(item);
+    }
+    @Override @Transactional public void move(Customer customer, MerchantStore store, String sku, ShoppingCart cart) throws ServiceException {
+        if (cart == null || cart.getId() == null || cart.getMerchantStore() == null || !store.getId().equals(cart.getMerchantStore().getId()) || !Objects.equals(customer.getId(), cart.getCustomerId())) throw new WishlistException("Cart not found");
+        WishlistItem item = find(customer, store, sku); if (item == null) throw new WishlistException("Product is not on wishlist");
+        Product product=item.getProduct(); if (!isAvailable(product)) throw new WishlistException("Product is unavailable");
+        ShoppingCartItem cartItem = null;
+        for (ShoppingCartItem existing : cart.getLineItems()) {
+            if (sku.equals(existing.getSku())) { cartItem = existing; break; }
+        }
+        if (cartItem != null) {
+            cartItem.setQuantity((cartItem.getQuantity() == null ? 0 : cartItem.getQuantity()) + 1);
+        } else {
+            cartItem = cartService.populateShoppingCartItem(product, store);
+            cartItem.setShoppingCart(cart);
+            cart.getLineItems().add(cartItem);
+        }
+        cartService.saveOrUpdate(cart); repository.delete(item);
+    }
+    @Override public List<PopularWishlistItem> popular(MerchantStore store) { List<PopularWishlistItem> out=new ArrayList<>(); for(Object[] row:repository.popular(store.getId())) { out.add(new PopularWishlistItem((String)row[0], ((Number)row[1]).longValue())); if(out.size()==10) break; } return out; }
+    private WishlistItem find(Customer c, MerchantStore s, String sku) { return repository.findByCustomer_IdAndMerchantStore_IdAndProduct_Sku(c.getId(), s.getId(), sku); }
+    private WishlistItemView view(WishlistItem item) { Product p=item.getProduct(); ProductAvailability a=availability(p); BigDecimal price=a==null?BigDecimal.ZERO:a.defaultPrice().getProductPriceAmount(); String name=p.getSku(); for(ProductDescription d:p.getDescriptions()) { if(d.getName()!=null){name=d.getName();break;} } return new WishlistItemView(p.getSku(),name,price,isAvailable(p),item.getAddedAt()); }
+    private ProductAvailability availability(Product p) { if(p.getAvailabilities()==null)return null; for(ProductAvailability a:p.getAvailabilities()) if(a.getProductVariant()==null)return a; return p.getAvailabilities().isEmpty()?null:p.getAvailabilities().iterator().next(); }
+    private boolean isAvailable(Product p) { ProductAvailability a=availability(p); return p.isAvailable() && a!=null && Boolean.TRUE.equals(a.getAvailable()) && a.getProductQuantity()!=null && a.getProductQuantity()>0; }
+}
