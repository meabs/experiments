+import java.util.List;
+import org.springframework.data.jpa.repository.*;
+import org.springframework.data.repository.query.Param;
+import com.salesmanager.core.model.wishlist.WishlistItem;
+
+public interface WishlistRepository extends JpaRepository<WishlistItem, Long> {
+    @Query("select w from WishlistItem w join fetch w.product p where w.customer.id=:customer and w.merchantStore.id=:store order by w.addedAt desc")
+    List<WishlistItem> findForCustomer(@Param("customer") Long customerId, @Param("store") Integer storeId);
