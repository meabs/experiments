+    @Query("select w.product.sku, count(w.id) from WishlistItem w where w.merchantStore.id=:store group by w.product.sku order by count(w.id) desc, w.product.sku asc")
+    List<Object[]> popular(@Param("store") Integer storeId);
+    @Modifying @Query("delete from WishlistItem w where w.product.id=:product") int deleteForProduct(@Param("product") Long productId);
+}
