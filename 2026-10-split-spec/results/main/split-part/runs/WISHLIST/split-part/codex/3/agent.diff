@@ -0,0 +1,132 @@
+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.security.Principal;
+import java.util.ArrayList;
+import java.util.List;
+
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.wishlist.WishlistException;
+import com.salesmanager.core.business.services.wishlist.WishlistItemView;
+import com.salesmanager.core.business.services.wishlist.WishlistService;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.model.wishlist.PersistableWishlistItem;
+import com.salesmanager.shop.model.wishlist.ReadableWishlist;
+import com.salesmanager.shop.model.wishlist.ReadableWishlistItem;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Authenticated customer's wishlist operations. */
+@RestController
+@RequestMapping("/api/v1/auth/customer/wishlist")
+public class CustomerWishlistApi {
+
+    @Inject private WishlistService wishlistService;
+    @Inject private CustomerFacade customerFacade;
+    @Inject private ShoppingCartFacade shoppingCartFacade;
+
+    @GetMapping
+    public ResponseEntity<ReadableWishlist> list(@ApiIgnore MerchantStore store,
+            @ApiIgnore Language language, HttpServletRequest request) {
+        try {
+            return ResponseEntity.ok(toDto(customer(request, store), store));
+        } catch (Exception e) {
+            return failure(e);
+        }
+    }
+
+    @PostMapping
+    public ResponseEntity<ReadableWishlist> add(@RequestBody PersistableWishlistItem body,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest request) {
+        try {
+            Customer customer = customer(request, store);
+            if (body == null || body.getProduct() == null || body.getProduct().trim().isEmpty())
+                return new ResponseEntity<>(HttpStatus.BAD_REQUEST);
+            boolean duplicate = contains(customer, store, body.getProduct());
+            wishlistService.add(customer, store, body.getProduct());
+            return new ResponseEntity<>(toDto(customer, store), duplicate ? HttpStatus.OK : HttpStatus.CREATED);
+        } catch (Exception e) {
+            return failure(e);
+        }
+    }
+
+    @DeleteMapping("/{sku}")
+    public ResponseEntity<Void> remove(@PathVariable String sku, @ApiIgnore MerchantStore store,
+            HttpServletRequest request) {
+        try {
+            wishlistService.remove(customer(request, store), store, sku);
+            return new ResponseEntity<>(HttpStatus.NO_CONTENT);
+        } catch (Exception e) {
+            return failure(e);
+        }
+    }
+
+    @PostMapping("/{sku}/cart/{cartCode}")
+    public ResponseEntity<ReadableShoppingCart> move(@PathVariable String sku, @PathVariable String cartCode,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest request) {
+        try {
+            Customer customer = customer(request, store);
+            ShoppingCart cart = shoppingCartFacade.getShoppingCartModel(cartCode, store);
+            if (cart == null) return new ResponseEntity<>(HttpStatus.NOT_FOUND);
+            wishlistService.move(customer, store, sku, cart);
+            return ResponseEntity.ok(shoppingCartFacade.readableCart(cart, store, language));
+        } catch (Exception e) {
+            return failure(e);
+        }
+    }
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal principal = request.getUserPrincipal();
+        if (principal == null) throw new WishlistHttpException(HttpStatus.UNAUTHORIZED);
+        Customer customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (customer == null) throw new WishlistHttpException(HttpStatus.NOT_FOUND);
+        return customer;
+    }
+
+    private boolean contains(Customer c, MerchantStore s, String sku) throws Exception {
+        for (WishlistItemView i : wishlistService.list(c, s)) if (sku.equals(i.getSku())) return true;
+        return false;
+    }
+
+    private ReadableWishlist toDto(Customer c, MerchantStore s) throws Exception {
+        List<ReadableWishlistItem> items = new ArrayList<>();
+        for (WishlistItemView v : wishlistService.list(c, s)) {
+            ReadableWishlistItem i = new ReadableWishlistItem();
+            i.setSku(v.getSku()); i.setName(v.getName()); i.setPrice(v.getPrice());
+            i.setAvailable(v.isAvailable()); i.setAddedAt(v.getAddedAt()); items.add(i);
+        }
+        ReadableWishlist result = new ReadableWishlist(); result.setItems(items); return result;
+    }
+
+    private <T> ResponseEntity<T> failure(Exception e) {
+        if (e instanceof WishlistHttpException) return new ResponseEntity<>(((WishlistHttpException)e).status);
+        String message = e.getMessage() == null ? "" : e.getMessage().toLowerCase();
+        if (message.contains("unavailable") || message.contains("no stock")) return new ResponseEntity<>(HttpStatus.CONFLICT);
+        if (message.contains("unknown") || message.contains("not on wishlist") || message.contains("cart not found")) return new ResponseEntity<>(HttpStatus.NOT_FOUND);
+        if (message.contains("50") || e instanceof IllegalArgumentException) return new ResponseEntity<>(HttpStatus.BAD_REQUEST);
+        return new ResponseEntity<>(HttpStatus.BAD_REQUEST);
+    }
+
+    private static class WishlistHttpException extends RuntimeException {
+        private static final long serialVersionUID = 1L;
+        private final HttpStatus status;
+        WishlistHttpException(HttpStatus status) { this.status = status; }
+    }
+}
