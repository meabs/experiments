+package com.salesmanager.shop.store.api.v1.wishlist;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.springframework.http.MediaType;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.wishlist.WishlistService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.business.services.wishlist.PopularWishlistItem;
+
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Administrative wishlist reporting endpoints. */
+@RestController
+@RequestMapping("/api/v1")
+public class WishlistAdminApi {
+
+    @Inject
+    private WishlistService wishlistService;
+
+    /**
+     * Returns the ten products most frequently added to wishlists for the
+     * selected store.  The service supplies the aggregate rows; sorting and
+     * limiting here keeps the response deterministic even when a repository
+     * does not impose an order.
+     */
+    @GetMapping(value = "/private/wishlists/popular", produces = MediaType.APPLICATION_JSON_VALUE)
+    @ApiImplicitParams({
+            @ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT") })
+    public List<PopularWishlist> popular(@ApiIgnore MerchantStore merchantStore) {
+        List<PopularWishlist> popular = new ArrayList<>();
+        for (PopularWishlistItem item : wishlistService.popular(merchantStore)) {
+            popular.add(new PopularWishlist(item.getSku(), item.getCount()));
+        }
+        popular.sort(Comparator.comparing(PopularWishlist::getCount, Comparator.reverseOrder())
+                .thenComparing(PopularWishlist::getSku));
+        return popular.size() > 10 ? new ArrayList<>(popular.subList(0, 10)) : popular;
+    }
+}
