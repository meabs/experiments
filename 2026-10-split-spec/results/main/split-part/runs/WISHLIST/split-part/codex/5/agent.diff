+package com.salesmanager.shop.store.controller.customer.facade;
+
+import java.time.Instant;
+import java.util.Date;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.wishlist.WishlistEntry;
+import com.salesmanager.core.business.services.wishlist.WishlistService;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.customer.wishlist.ReadableWishlist;
+import com.salesmanager.shop.model.customer.wishlist.ReadableWishlistItem;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+
+@Service("customerWishlistFacade")
+public class WishlistFacadeImpl implements WishlistFacade {
+    @Inject private WishlistService wishlistService;
+
+    @Override public ReadableWishlist get(Customer c, MerchantStore s, Language l) {
+        try { return convert(wishlistService.getWishlist(c, s, l)); } catch (ServiceException e) { throw error(e); }
+    }
+    @Override public ReadableWishlist add(Customer c, String sku, MerchantStore s, Language l) {
+        try { wishlistService.add(c, sku, s, l); return get(c, s, l); } catch (ServiceException e) { throw error(e); }
+    }
+    @Override public void remove(Customer c, String sku, MerchantStore s) {
+        try { wishlistService.remove(c, sku, s); } catch (ServiceException e) { throw error(e); }
+    }
+    private ReadableWishlist convert(com.salesmanager.core.business.services.wishlist.Wishlist w) {
+        return new ReadableWishlist(w.getItems().stream().map(this::convert).collect(Collectors.toList()));
+    }
+    private ReadableWishlistItem convert(WishlistEntry e) {
+        Date d = e.getAddedAt();
+        return new ReadableWishlistItem(e.getSku(), e.getName(), e.getPrice(), e.isAvailable(), d == null ? null : d.toInstant());
+    }
+    private ServiceRuntimeException error(ServiceException e) {
+        if (e instanceof com.salesmanager.core.business.services.wishlist.WishlistException) {
+            com.salesmanager.core.business.services.wishlist.WishlistException w = (com.salesmanager.core.business.services.wishlist.WishlistException)e;
+            return new ServiceRuntimeException(String.valueOf(w.getStatus()), e.getMessage());
+        }
+        return new ServiceRuntimeException(e);
+    }
+}
