+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.wishlist.PopularWishlistProduct;
+
+import io.swagger.annotations.Api;
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Administrative, store-scoped wishlist reports. */
+@RestController
+@RequestMapping("/api/v1/private/wishlists")
+@Api(tags = { "Wishlist administration" })
+public class WishlistAdminApi {
+
+    @PersistenceContext
+    private EntityManager entityManager;
+
+    @GetMapping(value = "/popular", produces = MediaType.APPLICATION_JSON_VALUE)
+    @ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT"),
+            @ApiImplicitParam(name = "lang", dataType = "string", defaultValue = "en") })
+    public List<PopularWishlistProduct> popular(@ApiIgnore MerchantStore merchantStore,
+            @ApiIgnore Language language) {
+        List<Object[]> rows = entityManager.createQuery(
+                "select w.product.sku, count(w.id) from WishlistItem w "
+                + "where w.merchantStore.id = :storeId group by w.product.sku "
+                + "order by count(w.id) desc, w.product.sku asc", Object[].class)
+                .setParameter("storeId", merchantStore.getId())
+                .setMaxResults(10)
+                .getResultList();
+        List<PopularWishlistProduct> result = new ArrayList<>(rows.size());
+        for (Object[] row : rows) {
+            result.add(new PopularWishlistProduct((String) row[0], ((Number) row[1]).longValue()));
+        }
+        return result;
+    }
+}
