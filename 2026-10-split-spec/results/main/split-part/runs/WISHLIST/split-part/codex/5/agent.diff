+package com.salesmanager.core.business.services.wishlist;
+
+import java.math.BigDecimal; import java.util.*;
+import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.wishlist.WishlistItemRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.reference.language.Language; import com.salesmanager.core.model.wishlist.WishlistItem;
+
+@Service("wishlistService")
+public class WishlistServiceImpl implements WishlistService {
+ private static final int MAX=50; private final WishlistItemRepository repository; private final ProductService productService;
+ public WishlistServiceImpl(WishlistItemRepository repository, ProductService productService){this.repository=repository;this.productService=productService;}
+ private Product product(String sku,MerchantStore store,Language language) throws ServiceException { if(sku==null||sku.trim().isEmpty()) throw new WishlistException(400,"product is required"); Product p=productService.getBySku(sku,store,language); if(p==null) throw new WishlistException(404,"Unknown product"); return p; }
+ private WishlistEntry entry(WishlistItem i){ Product p=i.getProduct(); String name=p.getProductDescription()==null?null:p.getProductDescription().getName(); BigDecimal price=null; boolean stock=false; for(ProductAvailability a:p.getAvailabilities()){ if(a.getProductVariant()==null){ProductPrice pp=a.defaultPrice(); if(pp!=null) price=pp.getProductPriceAmount(); if(a.getProductQuantity()!=null&&a.getProductQuantity()>0&&a.getProductStatus()) stock=true; break;} } return new WishlistEntry(p.getSku(),name,price,p.isAvailable()&&stock,i.getAddedAt()); }
+ @Override @Transactional(readOnly=true) public Wishlist getWishlist(Customer c,MerchantStore s,Language l){ List<WishlistEntry> out=new ArrayList<>(); for(WishlistItem i:repository.findByCustomerIdAndMerchantStoreIdOrderByAddedAtDesc(c.getId(),s.getId()))out.add(entry(i)); return new Wishlist(out); }
+ @Override @Transactional public Wishlist add(Customer c,String sku,MerchantStore s,Language l) throws ServiceException { Product p=product(sku,s,l); if(!repository.findByCustomerIdAndMerchantStoreIdAndProductSku(c.getId(),s.getId(),sku).isPresent()){ if(repository.countByCustomerIdAndMerchantStoreId(c.getId(),s.getId())>=MAX) throw new WishlistException(400,"Wishlist limit exceeded"); WishlistItem i=new WishlistItem(); i.setCustomer(c);i.setMerchantStore(s);i.setProduct(p);i.setAddedAt(new Date()); repository.save(i); } return getWishlist(c,s,l); }
+ @Override @Transactional public void remove(Customer c,String sku,MerchantStore s) throws ServiceException { WishlistItem i=repository.findByCustomerIdAndMerchantStoreIdAndProductSku(c.getId(),s.getId(),sku).orElseThrow(()->new WishlistException(404,"Wishlist item not found")); repository.delete(i); }
+ @Override public boolean contains(Customer c,String sku,MerchantStore s){return repository.findByCustomerIdAndMerchantStoreIdAndProductSku(c.getId(),s.getId(),sku).isPresent();}
+ @Override public WishlistEntry getEntry(Customer c,String sku,MerchantStore s,Language l) throws ServiceException { WishlistItem i=repository.findByCustomerIdAndMerchantStoreIdAndProductSku(c.getId(),s.getId(),sku).orElseThrow(()->new WishlistException(404,"Wishlist item not found")); return entry(i); }
+ @Override @Transactional(readOnly=true) public List<WishlistPopularEntry> popular(MerchantStore s){ Map<String,Integer> counts=new HashMap<>(); for(WishlistItem i:repository.findByMerchantStoreIdOrderByAddedAtDesc(s.getId())){String sku=i.getProduct().getSku();counts.put(sku,counts.getOrDefault(sku,0)+1);} List<String> skus=new ArrayList<>(counts.keySet()); skus.sort((a,b)->{int c=Integer.compare(counts.get(b),counts.get(a));return c!=0?c:a.compareTo(b);}); List<WishlistPopularEntry> out=new ArrayList<>(); for(String sku:skus){if(out.size()==10)break;out.add(new WishlistPopularEntry(sku,counts.get(sku)));} return out; }
+ @Override @Transactional public WishlistEntry move(Customer c,String sku,MerchantStore s,Language l) throws ServiceException { WishlistItem i=repository.findByCustomerIdAndMerchantStoreIdAndProductSku(c.getId(),s.getId(),sku).orElseThrow(()->new WishlistException(404,"Wishlist item not found")); WishlistEntry e=entry(i); if(!e.isAvailable()) throw new WishlistException(409,"Product is unavailable or out of stock"); repository.delete(i); return e; }
+ @Override @Transactional public void removeProduct(Long productId){repository.deleteByProductId(productId);}
+}
