+package com.salesmanager.core.model.customer;
+
+import java.io.Serializable;
+import java.util.Date;
+import javax.persistence.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+/** A customer's wishlist membership. Product details are deliberately resolved at read time. */
+@Entity
+@Table(name = "CUSTOMER_WISHLIST", uniqueConstraints = @UniqueConstraint(columnNames = {"CUSTOMER_ID", "MERCHANT_ID", "SKU"}))
+public class WishlistItem implements Serializable {
+    private static final long serialVersionUID = 1L;
+    @Id @GeneratedValue(strategy = GenerationType.TABLE, generator = "TABLE_GEN")
+    @TableGenerator(name = "TABLE_GEN", table = "SM_SEQUENCER", pkColumnName = "SEQ_NAME", valueColumnName = "SEQ_COUNT", pkColumnValue = "CUSTOMER_WISHLIST_SEQ_NEXT_VAL")
+    @Column(name = "WISHLIST_ID") private Long id;
+    @ManyToOne(fetch = FetchType.LAZY, optional = false) @JoinColumn(name = "CUSTOMER_ID", nullable = false) private Customer customer;
+    @ManyToOne(fetch = FetchType.LAZY, optional = false) @JoinColumn(name = "MERCHANT_ID", nullable = false) private MerchantStore merchantStore;
+    @Column(name = "SKU", nullable = false, length = 255) private String sku;
+    @Temporal(TemporalType.TIMESTAMP) @Column(name = "ADDED_AT", nullable = false) private Date addedAt = new Date();
+    public Long getId() { return id; }
+    public void setId(Long id) { this.id = id; }
+    public Customer getCustomer() { return customer; }
+    public void setCustomer(Customer customer) { this.customer = customer; }
+    public MerchantStore getMerchantStore() { return merchantStore; }
+    public void setMerchantStore(MerchantStore merchantStore) { this.merchantStore = merchantStore; }
+    public String getSku() { return sku; }
+    public void setSku(String sku) { this.sku = sku; }
+    public Date getAddedAt() { return addedAt == null ? null : new Date(addedAt.getTime()); }
+    public void setAddedAt(Date addedAt) { this.addedAt = addedAt; }
+}
