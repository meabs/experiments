+package com.salesmanager.core.business.services.customer;
+
+import java.math.BigDecimal; import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.customer.WishlistItemRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.pricing.PricingService;
+import com.salesmanager.core.business.services.shoppingcart.ShoppingCartService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.FinalPrice;
+import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.customer.WishlistItem;
+import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.core.model.shoppingcart.*;
+import com.salesmanager.core.model.customer.ReadablePopularWishlistItem;
+import com.salesmanager.core.model.customer.ReadableWishlist;
+import com.salesmanager.core.model.customer.ReadableWishlistItem;
+
+@Service("wishlistService")
+public class WishlistServiceImpl implements WishlistService {
+    private final WishlistItemRepository repository; @Inject private ProductService productService; @Inject private ShoppingCartService cartService; @Inject private PricingService pricingService;
+    @Inject public WishlistServiceImpl(WishlistItemRepository repository){this.repository=repository;}
+    private void valid(Customer c, MerchantStore s){if(c==null||c.getId()==null||s==null||s.getId()==null) throw new IllegalArgumentException("Customer and store are required");}
+    private Product product(String sku, MerchantStore store) throws ServiceException { if(sku==null||sku.trim().isEmpty()) throw new IllegalArgumentException("Product is required"); Product p=productService.getBySku(sku,store); if(p==null) throw new ServiceException("Unknown product sku: "+sku); return p; }
+    @Override @Transactional(readOnly=true) public ReadableWishlist list(Customer c, MerchantStore s) throws ServiceException {valid(c,s); return read(repository.findByCustomerIdAndMerchantStoreIdOrderByAddedAtDesc(c.getId(),s.getId()),s);}
+    @Override @Transactional public ReadableWishlist add(Customer c,String sku,MerchantStore s) throws ServiceException {valid(c,s); Product p=product(sku,s); if(repository.findByCustomerIdAndMerchantStoreIdAndSku(c.getId(),s.getId(),p.getSku())!=null)return list(c,s); if(repository.countByCustomerIdAndMerchantStoreId(c.getId(),s.getId())>=50) throw new IllegalStateException("Wishlist limit reached"); WishlistItem w=new WishlistItem();w.setCustomer(c);w.setMerchantStore(s);w.setSku(p.getSku());w.setAddedAt(new Date());repository.save(w);return list(c,s);}
+    @Override @Transactional public ReadableWishlist remove(Customer c,String sku,MerchantStore s) throws ServiceException {valid(c,s); WishlistItem w=repository.findByCustomerIdAndMerchantStoreIdAndSku(c.getId(),s.getId(),sku);if(w==null)throw new ServiceException("Wishlist item not found");repository.delete(w);return list(c,s);}
+    @Override @Transactional public ReadableWishlist moveToCart(Customer c,String sku,String code,MerchantStore s,Language language) throws ServiceException {valid(c,s); WishlistItem w=repository.findByCustomerIdAndMerchantStoreIdAndSku(c.getId(),s.getId(),sku);if(w==null)throw new ServiceException("Wishlist item not found"); Product p=product(sku,s);if(!available(p))throw new IllegalStateException("Product is unavailable"); ShoppingCart cart=cartService.getByCode(code,s);if(cart==null)throw new ServiceException("Cart not found"); ShoppingCartItem item=null;for(ShoppingCartItem i:cart.getLineItems()){if(sku.equals(i.getSku())){item=i;break;}}if(item==null){item=cartService.populateShoppingCartItem(p,s);item.setShoppingCart(cart);cart.getLineItems().add(item);}else item.setQuantity(item.getQuantity()+1);cartService.saveOrUpdate(cart);repository.delete(w);return list(c,s);}
+    @Override @Transactional(readOnly=true) public List<ReadablePopularWishlistItem> popular(MerchantStore s){List<ReadablePopularWishlistItem> out=new ArrayList<>();for(Object[] row:repository.popular(s.getId())){ReadablePopularWishlistItem i=new ReadablePopularWishlistItem();i.setSku((String)row[0]);i.setCount(((Number)row[1]).longValue());out.add(i);if(out.size()==10)break;}return out;}
+    @Override @Transactional public void removeProduct(String sku,MerchantStore s){repository.deleteBySkuAndMerchantStoreId(sku,s.getId());}
+    private boolean available(Product p){if(!p.isAvailable())return false;for(ProductAvailability a:p.getAvailabilities())if(Boolean.TRUE.equals(a.getAvailable())&&a.getProductQuantity()!=null&&a.getProductQuantity()>0)return true;return false;}
+    private ReadableWishlist read(List<WishlistItem> rows,MerchantStore s)throws ServiceException{ReadableWishlist out=new ReadableWishlist();for(WishlistItem w:rows){ReadableWishlistItem i=new ReadableWishlistItem();i.setSku(w.getSku());i.setAddedAt(w.getAddedAt());Product p=productService.getBySku(w.getSku(),s);if(p!=null){i.setName(p.getProductDescription()==null?null:p.getProductDescription().getName());i.setAvailable(available(p));try{FinalPrice f=pricingService.calculateProductPrice(p,Collections.emptyList());i.setPrice(f==null?null:f.getFinalPrice());}catch(Exception ignored){i.setPrice(BigDecimal.ZERO);}}out.getItems().add(i);}out.setCount(out.getItems().size());return out;}
+}
