+package com.salesmanager.core.model.catalog.product.question;
+
+import java.util.Date;
+import javax.persistence.*;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.generic.SalesManagerEntity;
+
+@Entity
+@Table(name = "PRODUCT_QUESTION", indexes = {
+    @Index(name = "PQ_PRODUCT_IDX", columnList = "PRODUCT_ID"),
+    @Index(name = "PQ_CUSTOMER_IDX", columnList = "CUSTOMER_ID")
+})
+public class ProductQuestion extends SalesManagerEntity<Long, ProductQuestion> {
+    private static final long serialVersionUID = 1L;
+    @Id @GeneratedValue(strategy = GenerationType.TABLE, generator = "TABLE_GEN")
+    @TableGenerator(name = "TABLE_GEN", table = "SM_SEQUENCER", pkColumnName = "SEQ_NAME", valueColumnName = "SEQ_COUNT", pkColumnValue = "PRODUCT_QUESTION_SEQ_NEXT_VAL")
+    @Column(name = "QUESTION_ID") private Long id;
+    @ManyToOne(fetch = FetchType.LAZY, optional = false) @JoinColumn(name = "PRODUCT_ID", nullable = false) private Product product;
+    @ManyToOne(fetch = FetchType.LAZY, optional = false) @JoinColumn(name = "CUSTOMER_ID", nullable = false) private Customer customer;
+    @Column(name = "QUESTION_TEXT", nullable = false, length = 500) private String text;
+    @Column(name = "ANSWER_TEXT", length = 2000) private String answer;
+    @Enumerated(EnumType.STRING) @Column(name = "STATUS", nullable = false, length = 16) private ProductQuestionStatus status = ProductQuestionStatus.PENDING;
+    @Temporal(TemporalType.TIMESTAMP) @Column(name = "ASKED_AT", nullable = false) private Date askedAt;
+    @Temporal(TemporalType.TIMESTAMP) @Column(name = "ANSWERED_AT") private Date answeredAt;
+    public Long getId() { return id; }
+    public void setId(Long id) { this.id = id; }
+    public Product getProduct() { return product; }
+    public void setProduct(Product product) { this.product = product; }
+    public Customer getCustomer() { return customer; }
+    public void setCustomer(Customer customer) { this.customer = customer; }
+    public String getText() { return text; }
+    public void setText(String text) { this.text = text; }
+    public String getAnswer() { return answer; }
+    public void setAnswer(String answer) { this.answer = answer; }
+    public ProductQuestionStatus getStatus() { return status; }
+    public void setStatus(ProductQuestionStatus status) { this.status = status; }
+    public Date getAskedAt() { return askedAt; }
+    public void setAskedAt(Date askedAt) { this.askedAt = askedAt; }
+    public Date getAnsweredAt() { return answeredAt; }
+    public void setAnsweredAt(Date answeredAt) { this.answeredAt = answeredAt; }
+    @Transient public String getSku() { return product == null ? null : product.getSku(); }
+    @Transient public String getAskedBy() { return customer == null || customer.getBilling() == null ? null : customer.getBilling().getFirstName(); }
+}
