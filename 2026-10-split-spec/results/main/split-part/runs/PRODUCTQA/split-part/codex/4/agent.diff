+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.question.PersistableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.question.ReadableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.question.ReadableProductQuestionList;
+import com.salesmanager.shop.model.catalog.product.question.ReadableProductQuestionSummary;
+import com.salesmanager.shop.populator.catalog.product.question.ProductQuestionPopulator;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Customer-authenticated and public product-question endpoints. */
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+
+    @Inject private ProductQuestionService productQuestionService;
+    @Inject private CustomerFacade customerFacade;
+
+    @PostMapping("/auth/products/{sku}/questions")
+    public ResponseEntity<?> ask(@PathVariable String sku,
+            @RequestBody PersistableProductQuestion request,
+            @ApiIgnore MerchantStore merchantStore, HttpServletRequest servletRequest) {
+        try {
+            Principal principal = servletRequest.getUserPrincipal();
+            if (principal == null) return ResponseEntity.status(HttpStatus.UNAUTHORIZED).build();
+            ProductQuestion question = productQuestionService.ask(sku,
+                    customerFacade.getCustomerByUserName(principal.getName(), merchantStore), merchantStore,
+                    request == null ? null : request.getText());
+            return ResponseEntity.status(HttpStatus.CREATED).body(ProductQuestionPopulator.populate(question));
+        } catch (IllegalArgumentException e) {
+            return ResponseEntity.badRequest().build();
+        } catch (ServiceException e) {
+            return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+        }
+    }
+
+    @GetMapping("/auth/customer/questions")
+    public ResponseEntity<List<ReadableProductQuestion>> customerQuestions(
+            @ApiIgnore MerchantStore merchantStore, HttpServletRequest servletRequest) {
+        Principal principal = servletRequest.getUserPrincipal();
+        if (principal == null) return ResponseEntity.status(HttpStatus.UNAUTHORIZED).build();
+        try {
+            List<ReadableProductQuestion> result = new ArrayList<>();
+            productQuestionService.listByCustomer(customerFacade.getCustomerByUserName(principal.getName(), merchantStore))
+                    .forEach(q -> result.add(ProductQuestionPopulator.populate(q)));
+            return ResponseEntity.ok(result);
+        } catch (RuntimeException e) {
+            return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+        }
+    }
+
+    @GetMapping("/products/{sku}/questions")
+    public ResponseEntity<?> publishedQuestions(@PathVariable String sku, @ApiIgnore MerchantStore merchantStore) {
+        try {
+            List<ReadableProductQuestionSummary> items = new ArrayList<>();
+            for (ProductQuestion question : productQuestionService.listPublished(sku, merchantStore))
+                items.add(ProductQuestionPopulator.populatePublic(question));
+            return ResponseEntity.ok(new ReadableProductQuestionList(items));
+        } catch (ServiceException e) {
+            return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+        }
+    }
+}
