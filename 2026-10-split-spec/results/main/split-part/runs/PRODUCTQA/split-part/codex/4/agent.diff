+import org.springframework.web.bind.annotation.RestController;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.question.admin.ProductQuestionAdminResponse;
+import com.salesmanager.shop.model.catalog.product.question.admin.ProductQuestionAnswerRequest;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionAdminApi {
+    @Inject private ProductQuestionService questionService;
+
+    @GetMapping("/private/questions")
+    public ResponseEntity<List<ProductQuestionAdminResponse>> list(
+            @RequestParam(value = "status", defaultValue = "PENDING") String status,
+            @ApiIgnore MerchantStore merchantStore) {
+        final ProductQuestionStatus parsed;
+        try { parsed = ProductQuestionStatus.valueOf(status); }
+        catch (Exception e) { return ResponseEntity.badRequest().build(); }
+        List<ProductQuestionAdminResponse> result = questionService.listByStore(merchantStore, parsed)
+                .stream().map(ProductQuestionAdminResponse::from).collect(Collectors.toList());
+        return ResponseEntity.ok(result);
+    }
+
+    @PutMapping("/private/questions/{id}/answer")
+    public ResponseEntity<ProductQuestionAdminResponse> answer(@PathVariable Long id,
+            @RequestBody ProductQuestionAnswerRequest request, @ApiIgnore MerchantStore merchantStore) {
+        ProductQuestion q = scoped(id, merchantStore);
+        if (q == null) return ResponseEntity.notFound().build();
+        try { return ResponseEntity.ok(ProductQuestionAdminResponse.from(questionService.answer(id, request == null ? null : request.getAnswer()))); }
+        catch (IllegalStateException e) { return ResponseEntity.status(HttpStatus.CONFLICT).build(); }
+        catch (IllegalArgumentException e) { return ResponseEntity.badRequest().build(); }
+        catch (ServiceException e) { return ResponseEntity.notFound().build(); }
+    }
+
+    @PutMapping("/private/questions/{id}/reject")
+    public ResponseEntity<ProductQuestionAdminResponse> reject(@PathVariable Long id,
+            @ApiIgnore MerchantStore merchantStore) {
+        if (scoped(id, merchantStore) == null) return ResponseEntity.notFound().build();
+        try { return ResponseEntity.ok(ProductQuestionAdminResponse.from(questionService.reject(id))); }
+        catch (ServiceException e) { return ResponseEntity.notFound().build(); }
+    }
+
+    private ProductQuestion scoped(Long id, MerchantStore store) {
+        ProductQuestion q = questionService.findById(id);
+        if (q == null || q.getProduct() == null || q.getProduct().getMerchantStore() == null
+                || store == null || !store.getId().equals(q.getProduct().getMerchantStore().getId())) return null;
+        return q;
+    }
+}
