@@ -0,0 +1,56 @@
+package com.salesmanager.core.business.services.catalog.product.question;
+
+import java.util.Date;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.*;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long, ProductQuestion> implements ProductQuestionService {
+    private final ProductQuestionRepository repository;
+    private final ProductService productService;
+    @Inject
+    public ProductQuestionServiceImpl(ProductQuestionRepository repository, ProductService productService) {
+        super(repository); this.repository = repository; this.productService = productService;
+    }
+    private String valid(String value, int min, int max, String name) {
+        if (value == null) throw new IllegalArgumentException(name + " is required");
+        String v = value.trim();
+        if (v.length() < min || v.length() > max) throw new IllegalArgumentException(name + " length is invalid");
+        return v;
+    }
+    @Override public ProductQuestion ask(String sku, Customer customer, MerchantStore store, String text) throws ServiceException {
+        Product product = productService.getBySku(sku, store);
+        if (product == null) throw new ServiceException("Product not found");
+        return ask(product, customer, text);
+    }
+    @Override public ProductQuestion ask(Product product, Customer customer, String text) throws ServiceException {
+        if (product == null || customer == null) throw new IllegalArgumentException("Product and customer are required");
+        if (repository.countPendingByCustomer(customer.getId()) >= 3) throw new IllegalArgumentException("Too many pending questions");
+        ProductQuestion q = new ProductQuestion(); q.setProduct(product); q.setCustomer(customer);
+        q.setText(valid(text, 10, 500, "Question")); q.setStatus(ProductQuestionStatus.PENDING); q.setAskedAt(new Date());
+        return saveAndFlush(q);
+    }
+    @Override public List<ProductQuestion> listByCustomer(Customer customer) { return repository.findByCustomer(customer.getId()); }
+    @Override public List<ProductQuestion> listByStore(MerchantStore store, ProductQuestionStatus status) { return repository.findByStoreAndStatus(store.getId(), status); }
+    @Override public List<ProductQuestion> listPublished(Product product) { return repository.findPublishedByProduct(product.getId()); }
+    @Override public List<ProductQuestion> listPublished(String sku, MerchantStore store) throws ServiceException {
+        Product p = productService.getBySku(sku, store); if (p == null) throw new ServiceException("Product not found"); return listPublished(p);
+    }
+    @Override public ProductQuestion findById(Long id) { return repository.findById(id).orElse(null); }
+    @Override public ProductQuestion answer(Long id, String answer) throws ServiceException {
+        ProductQuestion q = required(id); if (q.getStatus() == ProductQuestionStatus.REJECTED) throw new IllegalStateException("Rejected question cannot be answered");
+        q.setAnswer(valid(answer, 1, 2000, "Answer")); q.setStatus(ProductQuestionStatus.PUBLISHED); q.setAnsweredAt(new Date()); return saveAndFlush(q);
+    }
+    @Override public ProductQuestion reject(Long id) throws ServiceException { ProductQuestion q = required(id); q.setStatus(ProductQuestionStatus.REJECTED); return saveAndFlush(q); }
+    private ProductQuestion required(Long id) throws ServiceException { ProductQuestion q = findById(id); if (q == null) throw new ServiceException("Question not found"); return q; }
+    @Override public void deleteByProduct(Product product) { if (product != null && product.getId() != null) repository.deleteByProductId(product.getId()); }
+}
