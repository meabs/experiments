@@ -0,0 +1,124 @@
+package com.salesmanager.shop.store.api.v1.product;
+
+import java.io.IOException;
+import java.util.List;
+import java.util.Optional;
+
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletResponse;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Administrative moderation API for product questions. */
+@RestController
+@RequestMapping("/api/v1/private/questions")
+public class ProductQuestionAdminApi {
+
+    @Inject
+    private ProductQuestionService productQuestionService;
+
+    @GetMapping
+    @ResponseBody
+    @ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT") })
+    public List<ProductQuestion> list(
+            @RequestParam(value = "status", required = false, defaultValue = "PENDING") String status,
+            @ApiIgnore MerchantStore merchantStore,
+            HttpServletResponse response) throws IOException {
+        final ProductQuestionStatus questionStatus;
+        try {
+            questionStatus = ProductQuestionStatus.valueOf(status.trim().toUpperCase());
+        } catch (Exception e) {
+            response.sendError(HttpStatus.BAD_REQUEST.value(), "Invalid question status");
+            return null;
+        }
+        return productQuestionService.listByStoreAndStatus(merchantStore, questionStatus);
+    }
+
+    @PutMapping("/{id}/answer")
+    @ResponseStatus(HttpStatus.OK)
+    @ResponseBody
+    @ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT") })
+    public ProductQuestion answer(
+            @PathVariable Long id,
+            @RequestBody AnswerRequest request,
+            @ApiIgnore MerchantStore merchantStore,
+            HttpServletResponse response) throws IOException {
+        ProductQuestion question = findForStore(id, merchantStore, response);
+        if (question == null) {
+            return null;
+        }
+        if (question.getStatus() == ProductQuestionStatus.REJECTED) {
+            response.sendError(HttpStatus.CONFLICT.value(), "Rejected question cannot be answered");
+            return null;
+        }
+        try {
+            return productQuestionService.answer(id, request == null ? null : request.getAnswer());
+        } catch (IllegalArgumentException e) {
+            response.sendError(HttpStatus.BAD_REQUEST.value(), e.getMessage());
+            return null;
+        }
+    }
+
+    @PutMapping("/{id}/reject")
+    @ResponseStatus(HttpStatus.OK)
+    @ResponseBody
+    @ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT") })
+    public ProductQuestion reject(
+            @PathVariable Long id,
+            @ApiIgnore MerchantStore merchantStore,
+            HttpServletResponse response) throws IOException {
+        if (findForStore(id, merchantStore, response) == null) {
+            return null;
+        }
+        try {
+            return productQuestionService.reject(id);
+        } catch (IllegalArgumentException e) {
+            response.sendError(HttpStatus.NOT_FOUND.value(), e.getMessage());
+            return null;
+        }
+    }
+
+    private ProductQuestion findForStore(Long id, MerchantStore store, HttpServletResponse response)
+            throws IOException {
+        Optional<ProductQuestion> found = productQuestionService.findById(id);
+        if (!found.isPresent()
+                || found.get().getMerchantStore() == null
+                || store == null
+                || !store.getId().equals(found.get().getMerchantStore().getId())) {
+            response.sendError(HttpStatus.NOT_FOUND.value(), "Unknown question id");
+            return null;
+        }
+        return found.get();
+    }
+
+    /** Request body for the answer endpoint. */
+    public static class AnswerRequest {
+        private String answer;
+
+        public String getAnswer() {
+            return answer;
+        }
+
+        public void setAnswer(String answer) {
+            this.answer = answer;
+        }
+    }
+}
