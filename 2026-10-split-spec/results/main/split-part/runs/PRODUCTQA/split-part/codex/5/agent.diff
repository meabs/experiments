+public class ProductQuestionApi {
+    @Inject private ProductQuestionService questionService;
+    @Inject private CustomerFacade customerFacade;
+
+    @PostMapping("/auth/products/{sku}/questions")
+    @ResponseStatus(HttpStatus.CREATED)
+    public ReadableProductQuestion ask(@PathVariable String sku, @Valid @RequestBody PersistableProductQuestion input,
+            @ApiIgnore MerchantStore store, HttpServletRequest request) {
+        Customer customer = customer(store, request);
+        try { return full(questionService.createQuestion(sku, store, customer, input.getText())); }
+        catch (IllegalArgumentException e) { throw translate(e); }
+    }
+
+    @GetMapping("/auth/customer/questions")
+    public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store, @ApiIgnore Language language,
+            HttpServletRequest request) {
+        Customer customer = customer(store, request);
+        List<ReadableProductQuestion> result = new ArrayList<>();
+        for (ProductQuestion q : questionService.listByCustomer(customer)) result.add(full(q));
+        return result;
+    }
+
+    @GetMapping("/products/{sku}/questions")
+    public ReadableProductQuestionList published(@PathVariable String sku, @ApiIgnore MerchantStore store) {
+        try {
+            ReadableProductQuestionList result = new ReadableProductQuestionList();
+            List<ReadablePublishedProductQuestion> items = new ArrayList<>();
+            for (ProductQuestion q : questionService.listPublishedBySku(store, sku)) {
+                ReadablePublishedProductQuestion item = new ReadablePublishedProductQuestion();
+                item.setId(q.getId()); item.setText(q.getText()); item.setAnswer(q.getAnswer());
+                item.setAskedBy(q.getAskedBy()); item.setAnsweredAt(q.getAnsweredAt()); items.add(item);
+            }
+            // Keep the endpoint's item type compact while retaining the documented envelope.
+            result.setItems(items);
+            result.setCount(result.getItems().size()); return result;
+        } catch (IllegalArgumentException e) { throw new ResourceNotFoundException(e.getMessage()); }
+    }
+
+    private Customer customer(MerchantStore store, HttpServletRequest request) {
+        Principal principal = request.getUserPrincipal();
+        if (principal == null) throw new UnauthorizedException();
+        Customer customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (customer == null) throw new UnauthorizedException();
+        return customer;
+    }
+    private static ReadableProductQuestion full(ProductQuestion q) {
+        ReadableProductQuestion r = new ReadableProductQuestion(); r.setId(q.getId()); r.setSku(q.getSku()); r.setText(q.getText());
+        r.setStatus(q.getStatus() == null ? null : q.getStatus().name()); r.setAnswer(q.getAnswer()); r.setAskedBy(q.getAskedBy());
+        r.setAskedAt(q.getAskedAt()); r.setAnsweredAt(q.getAnsweredAt()); return r;
+    }
+    private static RuntimeException translate(IllegalArgumentException e) {
+        String m = e.getMessage() == null ? "Invalid question" : e.getMessage();
+        if (m.toLowerCase().contains("unknown sku")) return new ResourceNotFoundException(m);
+        if (m.toLowerCase().contains("rejected")) return new RestApiException("409", m);
+        return new ConstraintException(m);
+    }
+}
