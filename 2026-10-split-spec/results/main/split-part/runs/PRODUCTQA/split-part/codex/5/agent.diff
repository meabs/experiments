+package com.salesmanager.core.business.services.catalog.product.question;
+
+import java.util.Date;
+import java.util.List;
+import java.util.Optional;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.ProductRepository;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl implements ProductQuestionService {
+    private final ProductQuestionRepository repository;
+    private final ProductRepository productRepository;
+    @Inject
+    public ProductQuestionServiceImpl(ProductQuestionRepository repository, ProductRepository productRepository) {
+        this.repository = repository; this.productRepository = productRepository;
+    }
+    @Override public ProductQuestion createQuestion(Product product, MerchantStore store, Customer customer, String text) {
+        require(store != null && customer != null && product != null, "Product, store and customer are required");
+        String value = trim(text); require(value.length() >= 10 && value.length() <= 500, "Question must contain 10 to 500 characters");
+        require(repository.countByCustomerIdAndStatus(customer.getId(), ProductQuestionStatus.PENDING) < 3, "Customer has too many pending questions");
+        ProductQuestion q = new ProductQuestion(); q.setProduct(product); q.setMerchantStore(store); q.setCustomer(customer);
+        q.setSku(product.getSku()); q.setText(value); q.setAskedAt(new Date()); q.setStatus(ProductQuestionStatus.PENDING);
+        return repository.save(q);
+    }
+    @Override public ProductQuestion createQuestion(String sku, MerchantStore store, Customer customer, String text) {
+        require(sku != null && store != null, "SKU and store are required");
+        Product product = productRepository.findBySku(sku, store.getId()).stream()
+            .map(id -> productRepository.findById(Long.valueOf(id.toString())).orElse(null))
+            .filter(p -> p != null && p.getMerchantStore() != null && store.getId().equals(p.getMerchantStore().getId()))
+            .findFirst().orElse(null);
+        require(product != null, "Unknown SKU");
+        ProductQuestion q = createQuestion(product, store, customer, text); q.setSku(sku.trim()); return repository.save(q);
+    }
+    @Override public Optional<ProductQuestion> findById(Long id) { return repository.findById(id); }
+    @Override public List<ProductQuestion> listByStoreAndStatus(MerchantStore store, ProductQuestionStatus status) {
+        return repository.findByMerchantStoreIdAndStatusOrderByAskedAtAsc(store.getId(), status == null ? ProductQuestionStatus.PENDING : status);
+    }
+    @Override public List<ProductQuestion> listByCustomer(Customer customer) { return repository.findByCustomerIdOrderByAskedAtDesc(customer.getId()); }
+    @Override public List<ProductQuestion> listPublishedBySku(MerchantStore store, String sku) {
+        requireProduct(sku, store);
+        return repository.findByMerchantStoreIdAndSkuAndStatusOrderByAnsweredAtDesc(store.getId(), sku, ProductQuestionStatus.PUBLISHED);
+    }
+    @Override public ProductQuestion answer(Long id, String answer) {
+        ProductQuestion q = requireFound(id); require(q.getStatus() != ProductQuestionStatus.REJECTED, "Rejected question cannot be answered");
+        String value = trim(answer); require(value.length() >= 1 && value.length() <= 2000, "Answer must contain 1 to 2000 characters");
+        q.setAnswer(value); q.setAnsweredAt(new Date()); q.setStatus(ProductQuestionStatus.PUBLISHED); return repository.save(q);
+    }
+    @Override public ProductQuestion reject(Long id) { ProductQuestion q = requireFound(id); q.setStatus(ProductQuestionStatus.REJECTED); return repository.save(q); }
+    private ProductQuestion requireFound(Long id) { return repository.findById(id).orElseThrow(() -> new IllegalArgumentException("Unknown question id")); }
+    private Product requireProduct(String sku, MerchantStore store) {
+        require(sku != null && store != null, "SKU and store are required");
+        return productRepository.findBySku(sku, store.getId()).stream()
+            .map(id -> productRepository.findById(Long.valueOf(id.toString())).orElse(null))
+            .filter(p -> p != null && p.getMerchantStore() != null && store.getId().equals(p.getMerchantStore().getId()))
+            .findFirst().orElseThrow(() -> new IllegalArgumentException("Unknown SKU"));
+    }
+    private static String trim(String value) { return value == null ? "" : value.trim(); }
+    private static void require(boolean condition, String message) { if (!condition) throw new IllegalArgumentException(message); }
+}
