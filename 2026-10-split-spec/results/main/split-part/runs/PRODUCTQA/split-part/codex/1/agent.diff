+    public String getAnswer() { return answer; }
+    public void setAnswer(String answer) { this.answer = answer; }
+    public Date getAskedAt() { return askedAt == null ? null : new Date(askedAt.getTime()); }
+    public void setAskedAt(Date askedAt) { this.askedAt = askedAt == null ? null : new Date(askedAt.getTime()); }
+    public Date getAnsweredAt() { return answeredAt == null ? null : new Date(answeredAt.getTime()); }
