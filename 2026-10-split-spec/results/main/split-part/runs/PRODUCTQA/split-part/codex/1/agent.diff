+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletResponse;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.MediaType;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestMethod;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.product.question.ProductQuestionAnswerRequest;
+import com.salesmanager.shop.model.product.question.ReadableProductQuestion;
+
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Protected moderation API for questions belonging to the selected store. */
+@Controller
+@RequestMapping("/api/v1/private/questions")
+public class ProductQuestionAdministrationApi {
+  @Inject private ProductQuestionService productQuestionService;
+
+  @RequestMapping(method = RequestMethod.GET, produces = MediaType.APPLICATION_JSON_VALUE)
+  @ResponseStatus(HttpStatus.OK)
+  @ResponseBody
+  @ApiImplicitParams(@ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT"))
+  public List<ReadableProductQuestion> list(
+      @RequestParam(value = "status", defaultValue = "PENDING") String status,
+      @ApiIgnore MerchantStore merchantStore, HttpServletResponse response) throws Exception {
+    ProductQuestionStatus state;
+    try {
+      state = ProductQuestionStatus.valueOf(status == null ? "" : status.trim());
+    } catch (IllegalArgumentException e) {
+      response.sendError(HttpServletResponse.SC_BAD_REQUEST, "Invalid question status");
+      return new ArrayList<>();
+    }
+    List<ProductQuestion> questions = productQuestionService.list();
+    if (questions == null) questions = new ArrayList<>();
+    final Integer storeId = merchantStore == null ? null : merchantStore.getId();
+    return questions.stream()
+        .filter(q -> belongsToStore(q, storeId))
+        .filter(q -> q.getStatus() == state)
+        .sorted(Comparator.comparing(ProductQuestion::getAskedAt,
+            Comparator.nullsLast(Comparator.naturalOrder())))
+        .map(this::toReadable).collect(Collectors.toList());
+  }
+
+  @RequestMapping(value = "/{id}/answer", method = RequestMethod.PUT,
+      consumes = MediaType.APPLICATION_JSON_VALUE, produces = MediaType.APPLICATION_JSON_VALUE)
+  @ResponseStatus(HttpStatus.OK)
+  @ResponseBody
+  public ReadableProductQuestion answer(@PathVariable Long id, @RequestBody ProductQuestionAnswerRequest request,
+      @ApiIgnore MerchantStore merchantStore, HttpServletResponse response) throws Exception {
+    ProductQuestion question = findOwned(id, merchantStore, response);
+    if (question == null) return null;
+    if (question.getStatus() == ProductQuestionStatus.REJECTED) {
+      response.sendError(HttpServletResponse.SC_CONFLICT, "Rejected question cannot be answered");
+      return null;
+    }
+    String answer = request == null || request.getAnswer() == null ? null : request.getAnswer().trim();
+    if (answer == null || answer.length() < 1 || answer.length() > 2000) {
+      response.sendError(HttpServletResponse.SC_BAD_REQUEST, "Answer must be between 1 and 2000 characters");
+      return null;
+    }
+    return toReadable(productQuestionService.answer(id, answer));
+  }
+
+  @RequestMapping(value = "/{id}/reject", method = RequestMethod.PUT,
+      produces = MediaType.APPLICATION_JSON_VALUE)
+  @ResponseStatus(HttpStatus.OK)
+  @ResponseBody
+  public ReadableProductQuestion reject(@PathVariable Long id, @ApiIgnore MerchantStore merchantStore,
+      HttpServletResponse response) throws Exception {
+    if (findOwned(id, merchantStore, response) == null) return null;
+    return toReadable(productQuestionService.reject(id));
+  }
+
+  private ProductQuestion findOwned(Long id, MerchantStore store, HttpServletResponse response) throws Exception {
+    ProductQuestion q;
+    try { q = productQuestionService.findById(id); }
+    catch (ServiceException e) { response.sendError(HttpServletResponse.SC_NOT_FOUND, "Unknown question id"); return null; }
+    if (q == null || !belongsToStore(q, store == null ? null : store.getId())) {
+      response.sendError(HttpServletResponse.SC_NOT_FOUND, "Unknown question id"); return null;
+    }
+    return q;
+  }
+
+  private boolean belongsToStore(ProductQuestion q, Integer storeId) {
+    return q != null && q.getProduct() != null && q.getProduct().getMerchantStore() != null
+        && storeId != null && storeId.equals(q.getProduct().getMerchantStore().getId());
+  }
+
+  private ReadableProductQuestion toReadable(ProductQuestion q) {
+    ReadableProductQuestion r = new ReadableProductQuestion();
+    r.setId(q.getId()); r.setSku(q.getSku()); r.setText(q.getText());
+    r.setStatus(q.getStatus() == null ? null : q.getStatus().name()); r.setAnswer(q.getAnswer());
+    r.setAskedBy(q.getAskedBy()); r.setAskedAt(q.getAskedAt()); r.setAnsweredAt(q.getAnsweredAt());
+    return r;
+  }
+}
