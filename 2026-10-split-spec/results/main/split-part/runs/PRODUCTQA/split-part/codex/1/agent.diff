+package com.salesmanager.core.business.services.catalog.product.question;
+
+import java.util.Date;
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.ProductRepository;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long, ProductQuestion> implements ProductQuestionService {
+    private final ProductQuestionRepository repository;
+    private final ProductRepository productRepository;
+
+    @Inject
+    public ProductQuestionServiceImpl(ProductQuestionRepository repository, ProductRepository productRepository) {
+        super(repository);
+        this.repository = repository;
+        this.productRepository = productRepository;
+    }
+
+    @Override
+    public ProductQuestion ask(String sku, Customer customer, String text) throws ServiceException {
+        Product product = productRepository.getByCode(sku, customer.getMerchantStore());
+        if (product == null) throw new ServiceException("Unknown product sku");
+        return ask(product, customer, text);
+    }
+
+    @Override
+    public ProductQuestion ask(Product product, Customer customer, String text) throws ServiceException {
+        if (product == null || customer == null) throw new ServiceException("Product and customer are required");
+        String value = text == null ? null : text.trim();
+        if (value == null || value.length() < 10 || value.length() > 500) throw new ServiceException("Question text must be between 10 and 500 characters");
+        if (repository.findByCustomerIdAndStatus(customer.getId(), ProductQuestionStatus.PENDING).size() >= 3) throw new ServiceException("Customer has too many pending questions");
+        ProductQuestion q = new ProductQuestion();
+        q.setProduct(product); q.setCustomer(customer); q.setText(value); q.setStatus(ProductQuestionStatus.PENDING); q.setAskedAt(new Date());
+        return repository.saveAndFlush(q);
+    }
+
+    @Override public List<ProductQuestion> findByCustomer(Customer customer) { return repository.findByCustomerId(customer.getId(), customer.getMerchantStore().getId()); }
+    @Override public List<ProductQuestion> findBySkuAndStatus(String sku, ProductQuestionStatus status) { return java.util.Collections.emptyList(); }
+    @Override public List<ProductQuestion> findBySkuAndStatus(String sku, ProductQuestionStatus status, com.salesmanager.core.model.merchant.MerchantStore store) {
+        return repository.findBySkuAndStatus(sku, status, store.getId());
+    }
+    @Override public List<ProductQuestion> findByProduct(Product product, ProductQuestionStatus status) { return findBySkuAndStatus(product.getSku(), status, product.getMerchantStore()); }
+
+    @Override public ProductQuestion findById(Long id) throws ServiceException {
+        ProductQuestion q = repository.findOneWithDetails(id);
+        if (q == null) throw new ServiceException("Unknown question id");
+        return q;
+    }
+
+    @Override public ProductQuestion answer(Long id, String answer) throws ServiceException {
+        ProductQuestion q = findById(id);
+        if (q.getStatus() == ProductQuestionStatus.REJECTED) throw new ServiceException("Rejected question cannot be answered");
+        String value = answer == null ? null : answer.trim();
+        if (value == null || value.length() < 1 || value.length() > 2000) throw new ServiceException("Answer must be between 1 and 2000 characters");
+        q.setAnswer(value); q.setStatus(ProductQuestionStatus.PUBLISHED); q.setAnsweredAt(new Date());
+        return repository.saveAndFlush(q);
+    }
+
+    @Override public ProductQuestion reject(Long id) throws ServiceException {
+        ProductQuestion q = findById(id);
+        q.setStatus(ProductQuestionStatus.REJECTED); q.setAnsweredAt(null);
+        return repository.saveAndFlush(q);
+    }
+}
