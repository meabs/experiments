+import com.salesmanager.core.model.generic.SalesManagerEntity;
+
+/** A customer question and (optionally) the store's answer. */
+@Entity
+@Table(name = "PRODUCT_QUESTION")
+public class ProductQuestion extends SalesManagerEntity<Long, ProductQuestion> {
+    private static final long serialVersionUID = 1L;
+
+    @Id
+    @Column(name = "PRODUCT_QUESTION_ID", nullable = false, unique = true)
+    @TableGenerator(name = "TABLE_GEN", table = "SM_SEQUENCER", pkColumnName = "SEQ_NAME",
+            valueColumnName = "SEQ_COUNT", pkColumnValue = "PRODUCT_QUESTION_SEQ_NEXT_VAL")
+    @GeneratedValue(strategy = GenerationType.TABLE, generator = "TABLE_GEN")
+    private Long id;
+
+    @ManyToOne(optional = false)
+    @JoinColumn(name = "PRODUCT_ID", nullable = false)
+    private Product product;
+
+    @ManyToOne(optional = false)
+    @JoinColumn(name = "CUSTOMER_ID", nullable = false)
+    private Customer customer;
+
+    @Column(name = "QUESTION_TEXT", nullable = false, length = 500)
+    private String text;
+
+    @Enumerated(EnumType.STRING)
+    @Column(name = "STATUS", nullable = false, length = 16)
+    private ProductQuestionStatus status = ProductQuestionStatus.PENDING;
+
+    @Column(name = "ANSWER", length = 2000)
+    private String answer;
+
+    @Temporal(TemporalType.TIMESTAMP)
+    @Column(name = "ASKED_AT", nullable = false)
+    private Date askedAt;
+
+    @Temporal(TemporalType.TIMESTAMP)
+    @Column(name = "ANSWERED_AT")
+    private Date answeredAt;
+
+    public Long getId() { return id; }
+    public void setId(Long id) { this.id = id; }
