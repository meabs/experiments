+package com.salesmanager.shop.model.customer;
+
+import java.util.Date;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+
+/** Stable, deliberately small JSON representation shared by question APIs. */
+public class ReadableProductQuestion {
+    private Long id;
+    private String sku;
+    private String text;
+    private String status;
+    private String answer;
+    private String askedBy;
+    private Date askedAt;
+    private Date answeredAt;
+
+    public ReadableProductQuestion() { }
+    public ReadableProductQuestion(ProductQuestion q) {
+        id = q.getId(); sku = q.getSku(); text = q.getText();
+        status = q.getStatus() == null ? null : q.getStatus().name();
+        answer = q.getAnswer(); askedBy = q.getAskedBy();
+        askedAt = q.getAskedAt(); answeredAt = q.getAnsweredAt();
+    }
+    public Long getId(){return id;} public String getSku(){return sku;}
+    public String getText(){return text;} public String getStatus(){return status;}
+    public String getAnswer(){return answer;} public String getAskedBy(){return askedBy;}
+    public Date getAskedAt(){return askedAt;} public Date getAnsweredAt(){return answeredAt;}
+}
