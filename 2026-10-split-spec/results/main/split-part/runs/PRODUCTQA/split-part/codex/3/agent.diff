+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.security.Principal;
+import java.util.List;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.customer.ProductQuestionRequest;
+import com.salesmanager.shop.model.customer.ReadableProductQuestion;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.UnauthorizedException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionCustomerApi {
+    @Inject private ProductQuestionService questionService;
+    @Inject private CustomerFacade customerFacade;
+
+    @PostMapping("/auth/products/{sku}/questions")
+    @ResponseStatus(HttpStatus.CREATED)
+    public ReadableProductQuestion ask(@PathVariable String sku, @RequestBody ProductQuestionRequest request,
+            @ApiIgnore MerchantStore store, HttpServletRequest http) {
+        Customer customer = customer(http, store);
+        String text = request == null ? null : request.getText();
+        if (text == null || (text = text.trim()).length() < 10 || text.length() > 500)
+            throw new ServiceRuntimeException("400", "Question text must contain 10 to 500 characters");
+        try {
+            return new ReadableProductQuestion(questionService.ask(sku, store.getId(), customer, text));
+        } catch (ServiceException e) {
+            // The service uses a regular ServiceException for lookup misses; expose
+            // that specific case as the API's required 404 while retaining 400 for
+            // validation and pending-question limits.
+            if ("Unknown sku".equalsIgnoreCase(e.getMessage()))
+                throw new ResourceNotFoundException(e.getMessage());
+            throw new ServiceRuntimeException("400", e.getMessage(), e);
+        }
+    }
+
+    @GetMapping("/auth/customer/questions")
+    public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store, HttpServletRequest http) {
+        return questionService.getByCustomer(customer(http, store)).stream()
+                .map(ReadableProductQuestion::new).collect(Collectors.toList());
+    }
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal p = request.getUserPrincipal();
+        if (p == null || p.getName() == null) throw new UnauthorizedException();
+        Customer c = customerFacade.getCustomerByUserName(p.getName(), store);
+        if (c == null) throw new UnauthorizedException();
+        return c;
+    }
+}
