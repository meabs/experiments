+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Public product-question reads and merchant administration operations. */
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+
+    @Inject
+    private ProductQuestionService questionService;
+
+    @GetMapping("/products/{sku}/questions")
+    @ApiImplicitParams(@ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT"))
+    public ResponseEntity<Map<String, Object>> publicQuestions(@PathVariable String sku,
+            @ApiIgnore MerchantStore merchantStore) {
+        try {
+            List<ProductQuestion> questions = questionService.getPublic(sku, merchantStore.getId());
+            List<Map<String, Object>> items = new ArrayList<>();
+            for (ProductQuestion question : questions) items.add(publicView(question));
+            Map<String, Object> body = new LinkedHashMap<>();
+            body.put("count", items.size());
+            body.put("items", items);
+            return ResponseEntity.ok(body);
+        } catch (ServiceException e) {
+            return error(HttpStatus.NOT_FOUND, e.getMessage());
+        }
+    }
+
+    @GetMapping("/private/questions")
+    @ApiImplicitParams(@ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT"))
+    public ResponseEntity<List<Map<String, Object>>> list(@RequestParam(defaultValue = "PENDING") String status,
+            @ApiIgnore MerchantStore merchantStore) {
+        ProductQuestionStatus parsed;
+        try {
+            parsed = ProductQuestionStatus.valueOf(status.toUpperCase());
+        } catch (Exception e) {
+            return ResponseEntity.status(HttpStatus.BAD_REQUEST).build();
+        }
+        List<Map<String, Object>> result = new ArrayList<>();
+        for (ProductQuestion question : questionService.getByStore(merchantStore.getId(), parsed)) {
+            result.add(fullView(question));
+        }
+        return ResponseEntity.ok(result);
+    }
+
+    @PutMapping("/private/questions/{id}/answer")
+    @ApiImplicitParams(@ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT"))
+    public ResponseEntity<Map<String, Object>> answer(@PathVariable Long id, @RequestBody Map<String, String> body,
+            @ApiIgnore MerchantStore merchantStore) {
+        try {
+            ProductQuestion existing = questionService.getRequired(id);
+            if (!belongsToStore(existing, merchantStore)) return error(HttpStatus.NOT_FOUND, "Unknown question id");
+            ProductQuestion question = questionService.answer(id, body == null ? null : body.get("answer"));
+            return ResponseEntity.ok(fullView(question));
+        } catch (ServiceException e) {
+            return error(serviceStatus(e), e.getMessage());
+        }
+    }
+
+    @PutMapping("/private/questions/{id}/reject")
+    @ApiImplicitParams(@ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT"))
+    public ResponseEntity<Map<String, Object>> reject(@PathVariable Long id,
+            @ApiIgnore MerchantStore merchantStore) {
+        try {
+            ProductQuestion existing = questionService.getRequired(id);
+            if (!belongsToStore(existing, merchantStore)) return error(HttpStatus.NOT_FOUND, "Unknown question id");
+            return ResponseEntity.ok(fullView(questionService.reject(id)));
+        } catch (ServiceException e) {
+            return error(serviceStatus(e), e.getMessage());
+        }
+    }
+
+    private boolean belongsToStore(ProductQuestion q, MerchantStore store) {
+        return q != null && q.getProduct() != null && q.getProduct().getMerchantStore() != null
+                && store != null && q.getProduct().getMerchantStore().getId().equals(store.getId());
+    }
+
+    private Map<String, Object> publicView(ProductQuestion q) {
+        Map<String, Object> view = new LinkedHashMap<>();
+        view.put("id", q.getId()); view.put("text", q.getText()); view.put("answer", q.getAnswer());
+        view.put("askedBy", q.getAskedBy()); view.put("answeredAt", q.getAnsweredAt());
+        return view;
+    }
+
+    private Map<String, Object> fullView(ProductQuestion q) {
+        Map<String, Object> view = publicView(q);
+        view.put("sku", q.getSku()); view.put("status", q.getStatus()); view.put("askedAt", q.getAskedAt());
+        return view;
+    }
+
+    private HttpStatus serviceStatus(ServiceException e) {
+        String message = e.getMessage() == null ? "" : e.getMessage().toLowerCase();
+        if (message.contains("unknown") || message.contains("does not exist")) return HttpStatus.NOT_FOUND;
+        if (message.contains("rejected")) return HttpStatus.CONFLICT;
+        return HttpStatus.BAD_REQUEST;
+    }
+
+    private <T> ResponseEntity<T> error(HttpStatus status, String message) {
+        return ResponseEntity.status(status).build();
+    }
+}
