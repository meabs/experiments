+package com.salesmanager.core.business.services.catalog.product.question;
+
+import java.util.Date;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long, ProductQuestion> implements ProductQuestionService {
+    private final ProductQuestionRepository repository;
+    @Inject public ProductQuestionServiceImpl(ProductQuestionRepository repository) { super(repository); this.repository = repository; }
+    private ServiceException validation(String message) { return new ServiceException(ServiceException.EXCEPTION_VALIDATION, message); }
+    private String valid(String value, int min, int max, String name) throws ServiceException {
+        if (value == null) throw validation(name + " is required");
+        String v = value.trim();
+        if (v.length() < min || v.length() > max) throw validation(name + " must be between " + min + " and " + max + " characters");
+        return v;
+    }
+    @Override public ProductQuestion ask(Product product, Customer customer, String text) throws ServiceException {
+        if (product == null) throw new ServiceException("Unknown product");
+        if (customer == null || customer.getId() == null) throw validation("customer is required");
+        if (repository.countByCustomerIdAndStatus(customer.getId(), ProductQuestionStatus.PENDING) >= 3) throw validation("customer has too many pending questions");
+        ProductQuestion q = new ProductQuestion(); q.setProduct(product); q.setCustomer(customer); q.setText(valid(text,10,500,"text")); q.setStatus(ProductQuestionStatus.PENDING); q.setAskedAt(new Date());
+        return repository.saveAndFlush(q);
+    }
+    @Override public ProductQuestion ask(String sku, Integer storeId, Customer customer, String text) throws ServiceException {
+        Product p = repository.findProductBySkuAndStore(sku, storeId); if (p == null) throw new ServiceException("Unknown sku"); return ask(p, customer, text);
+    }
+    @Override public List<ProductQuestion> getByCustomer(Customer customer) { return repository.findByCustomerIdOrderByAskedAtDesc(customer.getId()); }
+    @Override public List<ProductQuestion> getPublic(Product product) { return repository.findByProductIdAndStatusOrderByAnsweredAtDescAskedAtDesc(product.getId(), ProductQuestionStatus.PUBLISHED); }
+    @Override public List<ProductQuestion> getPublic(String sku, Integer storeId) throws ServiceException { Product p=repository.findProductBySkuAndStore(sku,storeId); if(p==null) throw new ServiceException("Unknown sku"); return getPublic(p); }
+    @Override public List<ProductQuestion> getByStore(Integer storeId, ProductQuestionStatus status) { return repository.findByProductMerchantStoreIdAndStatusOrderByAskedAtAsc(storeId == null ? null : storeId.longValue(), status == null ? ProductQuestionStatus.PENDING : status); }
+    @Override public ProductQuestion getRequired(Long id) throws ServiceException { ProductQuestion q = repository.findById(id).orElse(null); if(q==null) throw new ServiceException("Unknown question id"); return q; }
+    @Override public ProductQuestion answer(Long id, String answer) throws ServiceException { ProductQuestion q=getRequired(id); if(q.getStatus()==ProductQuestionStatus.REJECTED) throw new ServiceException("Rejected question cannot be answered"); q.setAnswer(valid(answer,1,2000,"answer")); q.setStatus(ProductQuestionStatus.PUBLISHED); q.setAnsweredAt(new Date()); return repository.saveAndFlush(q); }
+    @Override public ProductQuestion reject(Long id) throws ServiceException { ProductQuestion q=getRequired(id); q.setStatus(ProductQuestionStatus.REJECTED); return repository.saveAndFlush(q); }
+}
