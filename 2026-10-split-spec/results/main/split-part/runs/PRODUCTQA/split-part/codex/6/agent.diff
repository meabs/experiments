+    @Column(name = "QUESTION_TEXT", nullable = false, length = 500) private String text;
+    @Enumerated(EnumType.STRING) @Column(name = "STATUS", nullable = false, length = 16) private ProductQuestionStatus status = ProductQuestionStatus.PENDING;
