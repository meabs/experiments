+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.shop.populator.catalog.product.question.ProductQuestionMapper;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Customer-facing product questions.  The /auth prefix is protected by the existing JWT rules. */
+@RestController
+@RequestMapping("/api/v1/auth")
+public class ProductQuestionCustomerApi {
+    @Inject private ProductQuestionService questionService;
+    @Inject private ProductService productService;
+    @Inject private CustomerService customerService;
+
+    @PostMapping("/products/{sku}/questions")
+    @ResponseStatus(HttpStatus.CREATED)
+    public ProductQuestion ask(@PathVariable String sku, @RequestBody QuestionRequest request,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest httpRequest) throws Exception {
+        Customer customer = customer(httpRequest, store);
+        Product product;
+        try {
+            product = productService.getBySku(sku, store, language);
+        } catch (ServiceException e) {
+            throw new ResourceNotFoundException("Product " + sku + " does not exist");
+        }
+        if (product == null) throw new ResourceNotFoundException("Product " + sku + " does not exist");
+        try {
+            return ProductQuestionMapper.toApi(questionService.create(product, customer, request == null ? null : request.getText()));
+        } catch (IllegalArgumentException e) {
+            throw new ServiceRuntimeException("400", e.getMessage(), e);
+        }
+    }
+
+    @GetMapping("/customer/questions")
+    public List<ProductQuestion> questions(@ApiIgnore MerchantStore store, HttpServletRequest httpRequest) {
+        return questionService.getByCustomer(customer(httpRequest, store)).stream()
+                .map(ProductQuestionMapper::toApi).collect(Collectors.toList());
+    }
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal principal = request.getUserPrincipal();
+        if (principal == null) throw new com.salesmanager.shop.store.api.exception.UnauthorizedException();
+        Customer customer = store == null ? customerService.getByNick(principal.getName())
+                : customerService.getByNick(principal.getName(), store.getId());
+        if (customer == null) throw new com.salesmanager.shop.store.api.exception.UnauthorizedException();
+        return customer;
+    }
+
+    public static class QuestionRequest {
+        private String text;
+        public String getText() { return text; }
+        public void setText(String text) { this.text = text; }
+    }
+}
