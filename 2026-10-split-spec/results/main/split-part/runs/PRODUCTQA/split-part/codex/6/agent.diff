+        if (product == null) throw new ResourceNotFoundException("Product " + sku + " does not exist");
+        List<PublicQuestion> items = questionService.getByProduct(product, ProductQuestionStatus.PUBLISHED).stream()
+                .sorted(Comparator.comparing(ProductQuestionEntityDates::answeredAt, Comparator.nullsLast(Comparator.reverseOrder())))
+                .map(ProductQuestionMapper::toApi).map(PublicQuestion::new).collect(Collectors.toList());
+        return new PublicQuestionList(items);
+    }
