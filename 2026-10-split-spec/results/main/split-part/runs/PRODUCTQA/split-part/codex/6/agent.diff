+package com.salesmanager.shop.populator.catalog.product.question;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.shop.model.catalog.product.question.*;
+/** Converts the persistence model without exposing customer or product entities. */
+public final class ProductQuestionMapper {
+    private ProductQuestionMapper() { }
+    public static com.salesmanager.shop.model.catalog.product.question.ProductQuestion toApi(ProductQuestion source) {
+        if (source == null) return null;
+        com.salesmanager.shop.model.catalog.product.question.ProductQuestion target = new com.salesmanager.shop.model.catalog.product.question.ProductQuestion();
+        target.setId(source.getId()); target.setSku(source.getProduct() == null ? null : source.getProduct().getSku());
+        target.setText(source.getText()); target.setStatus(source.getStatus()); target.setAnswer(source.getAnswer());
+        if (source.getCustomer() != null && source.getCustomer().getBilling() != null) target.setAskedBy(source.getCustomer().getBilling().getFirstName());
+        target.setAskedAt(source.getAskedAt()); target.setAnsweredAt(source.getAnsweredAt()); return target;
+    }
+}
