+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.shop.populator.catalog.product.question.ProductQuestionMapper;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Store-admin endpoints for moderating product questions. */
+@RestController
+@RequestMapping("/api/v1/private/questions")
+public class ProductQuestionAdminApi {
+
+    @Inject
+    private ProductQuestionService questionService;
+
+    @Inject
+    private ProductService productService;
+
+    @GetMapping
+    public ResponseEntity<?> list(
+            @RequestParam(value = "status", required = false, defaultValue = "PENDING") String status,
+            @ApiIgnore MerchantStore merchantStore,
+            @ApiIgnore Language language) {
+        final ProductQuestionStatus requested;
+        try {
+            requested = ProductQuestionStatus.valueOf(status.toUpperCase());
+        } catch (Exception e) {
+            return ResponseEntity.badRequest().build();
+        }
+
+        List<com.salesmanager.core.model.catalog.product.question.ProductQuestion> matches = new ArrayList<>();
+        for (Product product : productService.listByStore(merchantStore)) {
+            matches.addAll(questionService.getByProduct(product, requested));
+        }
+        matches.sort(Comparator.comparing(
+                com.salesmanager.core.model.catalog.product.question.ProductQuestion::getAskedAt,
+                Comparator.nullsLast(Comparator.naturalOrder())));
+        List<ProductQuestion> result = new ArrayList<>();
+        for (com.salesmanager.core.model.catalog.product.question.ProductQuestion question : matches) {
+            result.add(ProductQuestionMapper.toApi(question));
+        }
+        return ResponseEntity.ok(result);
+    }
+
+    @PutMapping("/{id}/answer")
+    public ResponseEntity<?> answer(@PathVariable Long id, @RequestBody AnswerRequest request,
+            @ApiIgnore MerchantStore merchantStore) {
+        com.salesmanager.core.model.catalog.product.question.ProductQuestion existing = questionService.getById(id);
+        if (!belongsToStore(existing, merchantStore)) {
