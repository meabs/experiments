+package com.salesmanager.core.business.services.catalog.product.question;
+import java.util.Date;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.*;
+import com.salesmanager.core.model.customer.Customer;
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long, ProductQuestion> implements ProductQuestionService {
+    private final ProductQuestionRepository repository;
+    @Inject public ProductQuestionServiceImpl(ProductQuestionRepository repository) { super(repository); this.repository = repository; }
+    private static String trimmed(String value, int min, int max, String name) {
+        if (value == null) throw new IllegalArgumentException(name + " is required");
+        String v = value.trim(); if (v.length() < min || v.length() > max) throw new IllegalArgumentException(name + " length is invalid"); return v;
+    }
+    public ProductQuestion create(Product product, Customer customer, String text) {
+        if (product == null || customer == null) throw new IllegalArgumentException("product and customer are required");
+        if (repository.countByCustomerIdAndStatus(customer.getId(), ProductQuestionStatus.PENDING) >= 3) throw new IllegalArgumentException("too many pending questions");
+        ProductQuestion q = new ProductQuestion(); q.setProduct(product); q.setCustomer(customer); q.setText(trimmed(text, 10, 500, "text")); q.setStatus(ProductQuestionStatus.PENDING); q.setAskedAt(new Date()); return repository.save(q);
+    }
+    public List<ProductQuestion> getByCustomer(Customer customer) { return repository.findByCustomerIdOrderByAskedAtDesc(customer.getId()); }
+    public List<ProductQuestion> getByProduct(Product product, ProductQuestionStatus status) { return repository.findByProductIdAndStatusOrderByAskedAtAsc(product.getId(), status); }
+    public List<ProductQuestion> getByProduct(Product product) { return repository.findByProductIdOrderByAskedAtDesc(product.getId()); }
+    public ProductQuestion answer(Long id, String answer) {
+        ProductQuestion q = repository.findById(id).orElse(null); if (q == null) return null;
+        if (q.getStatus() == ProductQuestionStatus.REJECTED) throw new IllegalStateException("rejected question cannot be answered");
+        q.setAnswer(trimmed(answer, 1, 2000, "answer")); q.setStatus(ProductQuestionStatus.PUBLISHED); q.setAnsweredAt(new Date()); return repository.save(q);
+    }
+    public ProductQuestion reject(Long id) { ProductQuestion q = repository.findById(id).orElse(null); if (q == null) return null; q.setStatus(ProductQuestionStatus.REJECTED); return repository.save(q); }
+}
