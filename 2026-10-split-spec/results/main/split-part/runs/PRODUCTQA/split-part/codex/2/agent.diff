+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.security.Principal;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.Date;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.NoSuchElementException;
+
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import javax.validation.Valid;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.business.services.productquestion.ProductQuestionService;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.productquestion.ProductQuestion;
+import com.salesmanager.shop.model.productquestion.PersistableProductQuestion;
+
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Customer-authenticated and public product question resources. */
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+
+    @Inject
+    private ProductQuestionService questionService;
+
+    @Inject
+    private CustomerService customerService;
+
+    @PostMapping("/auth/products/{sku}/questions")
+    @ApiImplicitParams(@ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT"))
+    public ResponseEntity<?> ask(@PathVariable String sku,
+            @Valid @RequestBody PersistableProductQuestion request,
+            @ApiIgnore MerchantStore merchantStore, HttpServletRequest httpRequest) {
+        try {
+            Principal principal = httpRequest.getUserPrincipal();
+            Customer customer = principal == null || merchantStore == null ? null
+                    : customerService.getByNick(principal.getName(), merchantStore.getId());
+            if (customer == null) {
+                return ResponseEntity.status(HttpStatus.UNAUTHORIZED).build();
+            }
+            // The shared create operation enforces the pending-question cap first;
+            // resolve the SKU up front so an unknown product remains a 404.
+            questionService.listPublishedBySku(merchantStore, sku);
+            ProductQuestion question = questionService.createBySku(sku, request.getText(), customer, merchantStore);
+            return ResponseEntity.status(HttpStatus.CREATED).body(detailed(question));
+        } catch (NoSuchElementException e) {
+            return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+        } catch (IllegalArgumentException | IllegalStateException e) {
+            return ResponseEntity.badRequest().build();
+        }
+    }
+
+    @GetMapping("/auth/customer/questions")
+    @ApiImplicitParams(@ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT"))
+    public ResponseEntity<?> mine(@ApiIgnore MerchantStore merchantStore, HttpServletRequest httpRequest) {
+        Principal principal = httpRequest.getUserPrincipal();
+        Customer customer = principal == null || merchantStore == null ? null
+                : customerService.getByNick(principal.getName(), merchantStore.getId());
+        if (customer == null) {
+            return ResponseEntity.status(HttpStatus.UNAUTHORIZED).build();
+        }
+        List<ProductQuestion> questions = new ArrayList<ProductQuestion>(questionService.listByCustomer(customer));
+        Collections.sort(questions, new Comparator<ProductQuestion>() {
+            @Override public int compare(ProductQuestion left, ProductQuestion right) {
+                Date a = left.getAskedAt(), b = right.getAskedAt();
+                if (a == b) return 0;
+                if (a == null) return 1;
+                if (b == null) return -1;
+                return b.compareTo(a);
+            }
+        });
+        List<Map<String, Object>> items = new ArrayList<Map<String, Object>>();
+        for (ProductQuestion question : questions) items.add(detailed(question));
+        return ResponseEntity.ok(items);
+    }
+
+    @GetMapping("/products/{sku}/questions")
+    @ApiImplicitParams(@ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT"))
+    public ResponseEntity<?> published(@PathVariable String sku, @ApiIgnore MerchantStore merchantStore) {
+        try {
+            List<ProductQuestion> questions = questionService.listPublishedBySku(merchantStore, sku);
+            Map<String, Object> result = new LinkedHashMap<String, Object>();
+            result.put("count", questions.size());
+            List<Map<String, Object>> items = new ArrayList<Map<String, Object>>();
+            for (ProductQuestion question : questions) {
+                Map<String, Object> item = new LinkedHashMap<String, Object>();
+                item.put("id", question.getId());
+                item.put("text", question.getText());
+                item.put("answer", question.getAnswer());
+                item.put("askedBy", askedBy(question));
+                item.put("answeredAt", question.getAnsweredAt());
+                items.add(item);
+            }
+            result.put("items", items);
+            return ResponseEntity.ok(result);
+        } catch (NoSuchElementException e) {
+            return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+        }
+    }
+
+    private Map<String, Object> detailed(ProductQuestion question) {
+        Map<String, Object> result = new LinkedHashMap<String, Object>();
+        result.put("id", question.getId());
+        result.put("sku", question.getSku());
+        result.put("text", question.getText());
+        result.put("status", question.getStatus());
+        result.put("answer", question.getAnswer());
+        result.put("askedBy", askedBy(question));
+        result.put("askedAt", question.getAskedAt());
+        result.put("answeredAt", question.getAnsweredAt());
+        return result;
+    }
+
+    private String askedBy(ProductQuestion question) {
+        return question.getCustomer() == null || question.getCustomer().getBilling() == null
+                ? null : question.getCustomer().getBilling().getFirstName();
+    }
+}
