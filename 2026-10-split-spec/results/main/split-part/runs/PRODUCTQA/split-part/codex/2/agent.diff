+package com.salesmanager.core.business.services.productquestion;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.productquestion.ProductQuestionRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.productquestion.*;
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl implements ProductQuestionService {
+ @Inject private ProductQuestionRepository repository;
+ @Inject private ProductService productService;
+ private String text(String value, int min, int max) { if(value==null) throw new IllegalArgumentException("text is required"); String s=value.trim(); if(s.length()<min||s.length()>max) throw new IllegalArgumentException("invalid length"); return s; }
+ public ProductQuestion createBySku(String sku,String question,Customer customer,MerchantStore store) {
+  if(customer==null||store==null) throw new IllegalArgumentException("customer and store are required");
+  String cleanSku=text(sku,1,255); String clean=text(question,10,500);
+  if(repository.countByCustomerIdAndStatus(customer.getId(),ProductQuestionStatus.PENDING)>=3) throw new IllegalStateException("question limit reached");
+  Product product; try { product=productService.getBySku(cleanSku,store); } catch(Exception e) { throw new NoSuchElementException("product not found"); } if(product==null) throw new NoSuchElementException("product not found");
+  ProductQuestion q=new ProductQuestion(); q.setProduct(product); q.setCustomer(customer); q.setMerchantStore(store); q.setSku(cleanSku); q.setText(clean); q.setStatus(ProductQuestionStatus.PENDING); q.setAskedAt(new Date()); repository.saveAndFlush(q); return q;
+ }
+ public ProductQuestion createBySku(MerchantStore s,Customer c,String sku,String text){return createBySku(sku,text,c,s);}
+ public List<ProductQuestion> listByCustomer(Customer c){return repository.findByCustomerIdOrderByAskedAtAsc(c.getId());}
+ public List<ProductQuestion> listByStore(MerchantStore s,ProductQuestionStatus status){return repository.findByMerchantStoreIdAndStatusOrderByAskedAtAsc(s.getId(),status==null?ProductQuestionStatus.PENDING:status);}
+ public List<ProductQuestion> listPublishedBySku(MerchantStore s,String sku){ Product p; try { p=productService.getBySku(sku,s); } catch(Exception e) { throw new NoSuchElementException("product not found"); } if(p==null) throw new NoSuchElementException("product not found"); return repository.findByProductIdAndStatusOrderByAnsweredAtDesc(p.getId(),ProductQuestionStatus.PUBLISHED); }
+ public ProductQuestion getById(Long id,MerchantStore s){ProductQuestion q=repository.findById(id).orElseThrow(()->new NoSuchElementException("question not found")); if(s!=null&&!q.getMerchantStore().getId().equals(s.getId())) throw new NoSuchElementException("question not found"); return q;}
+ public ProductQuestion answer(Long id,MerchantStore s,String value){ProductQuestion q=getById(id,s); if(q.getStatus()==ProductQuestionStatus.REJECTED) throw new IllegalStateException("rejected question"); q.setAnswer(text(value,1,2000)); q.setAnsweredAt(new Date()); q.setStatus(ProductQuestionStatus.PUBLISHED); return repository.saveAndFlush(q);}
+ public ProductQuestion reject(Long id,MerchantStore s){ProductQuestion q=getById(id,s); q.setStatus(ProductQuestionStatus.REJECTED); return repository.saveAndFlush(q);}
+}
