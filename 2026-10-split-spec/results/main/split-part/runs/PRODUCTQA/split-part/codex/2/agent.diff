+package com.salesmanager.shop.store.api.v1.questions;
+
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.List;
+import java.util.Locale;
+import java.util.NoSuchElementException;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.MediaType;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.productquestion.ProductQuestionService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.productquestion.ProductQuestion;
+import com.salesmanager.core.model.productquestion.ProductQuestionStatus;
+
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Administration operations for product questions. */
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionAdminApi {
+
+    @Inject
+    private ProductQuestionService questionService;
+
+    @GetMapping(value = "/private/questions", produces = MediaType.APPLICATION_JSON_VALUE)
+    @ApiImplicitParams(@ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT"))
+    public ResponseEntity<?> list(@RequestParam(name = "status", required = false) String status,
+            @ApiIgnore MerchantStore merchantStore) {
+        ProductQuestionStatus questionStatus;
+        try {
+            questionStatus = status == null ? ProductQuestionStatus.PENDING
+                    : ProductQuestionStatus.valueOf(status.toUpperCase(Locale.ROOT));
+        } catch (IllegalArgumentException ex) {
+            return badRequest("Unknown question status");
+        }
+        List<QuestionView> result = new ArrayList<>();
+        for (ProductQuestion question : questionService.listByStore(merchantStore, questionStatus)) {
+            result.add(QuestionView.from(question));
+        }
+        return ResponseEntity.ok(result);
+    }
+
+    @PutMapping(value = "/private/questions/{id}/answer", consumes = MediaType.APPLICATION_JSON_VALUE,
+            produces = MediaType.APPLICATION_JSON_VALUE)
+    @ApiImplicitParams(@ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT"))
+    public ResponseEntity<?> answer(@PathVariable Long id, @RequestBody AnswerRequest request,
+            @ApiIgnore MerchantStore merchantStore) {
+        if (request == null || request.answer == null) {
+            return badRequest("Answer is required");
+        }
+        String answer = request.answer.trim();
+        if (answer.length() < 1 || answer.length() > 2000) {
+            return badRequest("Answer must contain between 1 and 2000 characters");
+        }
+        try {
+            return ResponseEntity.ok(QuestionView.from(questionService.answer(id, merchantStore, answer)));
+        } catch (NoSuchElementException ex) {
+            return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+        } catch (IllegalStateException ex) {
+            return ResponseEntity.status(HttpStatus.CONFLICT).build();
+        } catch (IllegalArgumentException ex) {
+            return badRequest(ex.getMessage());
+        }
+    }
+
+    @PutMapping(value = "/private/questions/{id}/reject", produces = MediaType.APPLICATION_JSON_VALUE)
+    @ApiImplicitParams(@ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT"))
+    public ResponseEntity<?> reject(@PathVariable Long id, @ApiIgnore MerchantStore merchantStore) {
+        try {
+            return ResponseEntity.ok(QuestionView.from(questionService.reject(id, merchantStore)));
+        } catch (NoSuchElementException ex) {
+            return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+        }
+    }
+
+    private ResponseEntity<ErrorView> badRequest(String message) {
+        return ResponseEntity.status(HttpStatus.BAD_REQUEST).body(new ErrorView(message));
+    }
+
+    public static class AnswerRequest {
+        private String answer;
+        public String getAnswer() { return answer; }
+        public void setAnswer(String answer) { this.answer = answer; }
+    }
+
+    public static class QuestionView {
+        private Long id;
+        private String sku;
+        private String text;
+        private ProductQuestionStatus status;
+        private String answer;
+        private String askedBy;
+        private Date askedAt;
+        private Date answeredAt;
+
+        static QuestionView from(ProductQuestion source) {
+            QuestionView target = new QuestionView();
+            target.id = source.getId(); target.sku = source.getSku(); target.text = source.getText();
+            target.status = source.getStatus(); target.answer = source.getAnswer();
+            target.askedAt = source.getAskedAt(); target.answeredAt = source.getAnsweredAt();
+            if (source.getCustomer() != null && source.getCustomer().getBilling() != null) {
+                target.askedBy = source.getCustomer().getBilling().getFirstName();
+            }
+            return target;
+        }
