+package com.salesmanager.core.business.services.catalog.product;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.repositories.catalog.product.ProductTierRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productTierService")
+public class ProductTierServiceImpl implements ProductTierService {
+	private final ProductTierRepository repository;
+
+	@Inject
+	public ProductTierServiceImpl(ProductTierRepository repository) {
+		this.repository = repository;
+	}
+
+	@Override
+	public List<ProductTier> getTiers(Product product) {
+		if (product == null) return Collections.emptyList();
+		return repository.findByProductOrderByMinQuantityAscIdAsc(product);
+	}
+
+	@Override
+	public List<ProductTier> getTiers(Long productId, MerchantStore store) {
+		if (productId == null || store == null || store.getId() == null) return Collections.emptyList();
+		return repository.findByProductIdAndStore(productId, store.getId());
+	}
+
+	@Override
+	@Transactional
+	public List<ProductTier> replaceTiers(Product product, List<ProductTier> tiers) {
+		if (product == null) throw new IllegalArgumentException("Product is required");
+		List<ProductTier> input = tiers == null ? Collections.<ProductTier>emptyList() : tiers;
+		validate(input);
+		List<ProductTier> old = repository.findByProductOrderByMinQuantityAscIdAsc(product);
+		if (!old.isEmpty()) repository.deleteAll(old);
+		List<ProductTier> replacement = new ArrayList<ProductTier>();
+		for (ProductTier tier : input) {
+			tier.setId(null);
+			tier.setProduct(product);
+			replacement.add(tier);
+		}
+		return replacement.isEmpty() ? replacement : repository.saveAll(replacement);
+	}
+
+	private void validate(List<ProductTier> tiers) {
+		if (tiers.size() > 10) throw new IllegalArgumentException("At most 10 tiers are allowed");
+		HashSet<Integer> seen = new HashSet<Integer>();
+		List<ProductTier> sorted = new ArrayList<ProductTier>(tiers);
+		for (ProductTier tier : sorted) {
+			if (tier == null || tier.getMinQuantity() == null || tier.getPrice() == null
+					|| tier.getMinQuantity() < 2 || tier.getPrice().compareTo(BigDecimal.ZERO) <= 0
+					|| !seen.add(tier.getMinQuantity())) throw new IllegalArgumentException("Invalid product tier");
+		}
+		sorted.sort(Comparator.comparing(ProductTier::getMinQuantity));
+		for (int i = 1; i < sorted.size(); i++) {
+			if (sorted.get(i).getPrice().compareTo(sorted.get(i - 1).getPrice()) >= 0)
+				throw new IllegalArgumentException("Higher quantity tiers must be cheaper");
+		}
+	}
+
+	@Override
+	public BigDecimal resolveUnitPrice(Product product, int quantity, BigDecimal ownPrice) {
+		if (ownPrice == null) return null;
+		BigDecimal result = ownPrice;
+		for (ProductTier tier : getTiers(product)) {
+			if (quantity >= tier.getMinQuantity() && tier.getPrice().compareTo(result) < 0) result = tier.getPrice();
+		}
+		return result;
+	}
+}
