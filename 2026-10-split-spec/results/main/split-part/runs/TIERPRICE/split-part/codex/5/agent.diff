+package com.salesmanager.shop.store.api.v1.product;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Optional;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.MediaType;
+import org.springframework.http.ResponseEntity;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.ProductTierService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductTier;
+
+import io.swagger.annotations.Api;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Private administration endpoints for quantity based product pricing. */
+@Controller
+@RequestMapping("/api/v1")
+@Api(tags = { "Product tiers" })
+public class ProductTierApi {
+
+    @Inject
+    private ProductService productService;
+
+    @Inject
+    private ProductTierService productTierService;
+
+    @GetMapping(value = "/private/product/{id}/tiers", produces = MediaType.APPLICATION_JSON_VALUE)
+    public ResponseEntity<List<ProductTier>> get(@PathVariable Long id,
+            @ApiIgnore MerchantStore merchantStore) {
+        Optional<Product> product = productService.retrieveById(id, merchantStore);
+        if (!product.isPresent()) {
+            return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+        }
+        return ResponseEntity.ok(toDto(productTierService.getTiers(product.get())));
+    }
+
+    @PutMapping(value = "/private/product/{id}/tiers", consumes = MediaType.APPLICATION_JSON_VALUE,
+            produces = MediaType.APPLICATION_JSON_VALUE)
+    public ResponseEntity<List<ProductTier>> replace(@PathVariable Long id,
+            @RequestBody List<ProductTier> request, @ApiIgnore MerchantStore merchantStore) {
+        Optional<Product> product = productService.retrieveById(id, merchantStore);
+        if (!product.isPresent()) {
+            return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+        }
+        if (request == null || request.size() > 10 || !valid(request)) {
+            return ResponseEntity.status(HttpStatus.BAD_REQUEST).build();
+        }
+
+        List<com.salesmanager.core.model.catalog.product.ProductTier> tiers = new ArrayList<com.salesmanager.core.model.catalog.product.ProductTier>();
+        for (ProductTier tier : request) {
+            tiers.add(new com.salesmanager.core.model.catalog.product.ProductTier(tier.getMinQuantity(), tier.getPrice()));
+        }
+        try {
+            return ResponseEntity.ok(toDto(productTierService.replaceTiers(product.get(), tiers)));
+        } catch (IllegalArgumentException ex) {
+            // Keep validation failures from the service atomic and expose them as 400.
+            return ResponseEntity.status(HttpStatus.BAD_REQUEST).build();
+        }
+    }
+
+    private boolean valid(List<ProductTier> tiers) {
+        java.util.Set<Integer> quantities = new java.util.HashSet<Integer>();
+        List<ProductTier> sorted = new ArrayList<ProductTier>(tiers);
+        for (ProductTier tier : sorted) {
+            if (tier == null || tier.getMinQuantity() == null || tier.getPrice() == null
+                    || tier.getMinQuantity() < 2 || tier.getPrice().compareTo(BigDecimal.ZERO) <= 0
+                    || !quantities.add(tier.getMinQuantity())) return false;
+        }
+        sorted.sort(Comparator.comparing(ProductTier::getMinQuantity));
+        for (int i = 1; i < sorted.size(); i++) {
+            if (sorted.get(i).getPrice().compareTo(sorted.get(i - 1).getPrice()) >= 0) return false;
+        }
+        return true;
+    }
+
+    private List<ProductTier> toDto(List<com.salesmanager.core.model.catalog.product.ProductTier> tiers) {
+        List<ProductTier> result = new ArrayList<ProductTier>();
+        if (tiers != null) {
+            for (com.salesmanager.core.model.catalog.product.ProductTier tier : tiers) {
+                result.add(new ProductTier(tier.getMinQuantity(), tier.getPrice()));
+            }
+        }
+        result.sort(Comparator.comparing(ProductTier::getMinQuantity));
+        return result;
+    }
+}
