+package com.salesmanager.core.business.services.catalog.product;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.repositories.catalog.product.ProductTierRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productTierService")
+public class ProductTierServiceImpl implements ProductTierService {
+    private final ProductTierRepository repository;
+
+    @Inject
+    public ProductTierServiceImpl(ProductTierRepository repository) {
+        this.repository = repository;
+    }
+
+    @Override
+    @Transactional
+    public List<ProductTier> getTiers(Product product, MerchantStore store) {
+        requireOwned(product, store);
+        return repository.findByProductAndStore(product, store);
+    }
+
+    @Override
+    @Transactional
+    public List<ProductTier> replaceTiers(Product product, MerchantStore store, List<ProductTier> tiers) {
+        requireOwned(product, store);
+        List<ProductTier> validated = validate(tiers);
+        repository.deleteByProduct(product);
+        for (ProductTier tier : validated) tier.setProduct(product);
+        return repository.saveAll(validated);
+    }
+
+    @Override
+    @Transactional
+    public BigDecimal priceForQuantity(Product product, int quantity, BigDecimal ownPrice) {
+        if (ownPrice == null) return null;
+        BigDecimal result = ownPrice;
+        for (ProductTier tier : repository.findByProductOrderByMinQuantityAsc(product)) {
+            if (tier.getMinQuantity() != null && tier.getMinQuantity() <= quantity) result = tier.getPrice();
+            else break;
+        }
+        return result;
+    }
+
+    private List<ProductTier> validate(List<ProductTier> input) {
+        if (input == null) throw new IllegalArgumentException("tiers are required");
+        if (input.size() > 10) throw new IllegalArgumentException("at most 10 tiers are allowed");
+        List<ProductTier> result = new ArrayList<ProductTier>(input);
+        result.sort((left, right) -> {
+            if (left == null) return -1;
+            if (right == null) return 1;
+            return Comparator.nullsFirst(Integer::compareTo).compare(left.getMinQuantity(), right.getMinQuantity());
+        });
+        Set<Integer> seen = new HashSet<Integer>();
+        BigDecimal previous = null;
+        for (ProductTier tier : result) {
+            if (tier == null || tier.getMinQuantity() == null || tier.getPrice() == null)
+                throw new IllegalArgumentException("minQuantity and price are required");
+            if (tier.getMinQuantity() < 2 || !seen.add(tier.getMinQuantity()))
+                throw new IllegalArgumentException("invalid or duplicate minQuantity");
+            if (tier.getPrice().signum() <= 0)
+                throw new IllegalArgumentException("price must be greater than zero");
+            if (previous != null && tier.getPrice().compareTo(previous) >= 0)
+                throw new IllegalArgumentException("higher quantities must have lower prices");
+            previous = tier.getPrice();
+        }
+        return result;
+    }
+
+    private void requireOwned(Product product, MerchantStore store) {
+        if (product == null || store == null || product.getMerchantStore() == null ||
+                product.getMerchantStore().getId() == null || store.getId() == null ||
+                !product.getMerchantStore().getId().equals(store.getId()))
+            throw new java.util.NoSuchElementException("product not found");
+    }
+}
