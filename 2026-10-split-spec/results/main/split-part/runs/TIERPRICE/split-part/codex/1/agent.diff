+
+@Controller
+@RequestMapping("/api/v1")
+public class ProductQuantityTierApi {
+    @Autowired private ProductQuantityTierFacade tierFacade;
+
+    @RequestMapping(value = "/private/product/{id}/tiers", method = RequestMethod.GET)
+    @ResponseStatus(HttpStatus.OK)
+    public @ResponseBody List<ReadableProductQuantityTier> get(@PathVariable Long id,
+            @ApiIgnore MerchantStore merchantStore) {
+        return tierFacade.get(id, merchantStore);
+    }
+
+    @RequestMapping(value = "/private/product/{id}/tiers", method = RequestMethod.PUT)
+    @ResponseStatus(HttpStatus.OK)
+    public @ResponseBody List<ReadableProductQuantityTier> replace(@PathVariable Long id,
+            @RequestBody List<PersistableProductQuantityTier> tiers,
+            @ApiIgnore MerchantStore merchantStore) {
+        return tierFacade.replace(id, tiers, merchantStore);
+    }
+}
