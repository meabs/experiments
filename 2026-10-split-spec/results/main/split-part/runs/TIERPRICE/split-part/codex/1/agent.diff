+package com.salesmanager.shop.store.facade.product;
+
+import java.util.ArrayList;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.services.catalog.product.tier.ProductQuantityTierService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.tier.ProductQuantityTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.tier.PersistableProductQuantityTier;
+import com.salesmanager.shop.model.catalog.product.tier.ReadableProductQuantityTier;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.controller.product.facade.ProductFacade;
+import com.salesmanager.shop.store.controller.product.facade.ProductQuantityTierFacade;
+
+@Service
+public class ProductQuantityTierFacadeImpl implements ProductQuantityTierFacade {
+    private final ProductQuantityTierService tierService;
+    private final ProductFacade productFacade;
+
+    @Inject
+    public ProductQuantityTierFacadeImpl(ProductQuantityTierService tierService, ProductFacade productFacade) {
+        this.tierService = tierService;
+        this.productFacade = productFacade;
+    }
+
+    @Override
+    public List<ReadableProductQuantityTier> get(Long productId, MerchantStore store) {
+        Product product = product(productId, store);
+        List<ReadableProductQuantityTier> result = new ArrayList<>();
+        for (ProductQuantityTier tier : tierService.getTiers(product))
+            result.add(new ReadableProductQuantityTier(tier.getMinQuantity(), tier.getPrice()));
+        return result;
+    }
+
+    @Override
+    public List<ReadableProductQuantityTier> replace(Long productId, List<PersistableProductQuantityTier> input,
+            MerchantStore store) {
+        Product product = product(productId, store);
+        if (input == null) throw new RestApiException("400", "Tier list is required");
+        List<ProductQuantityTier> tiers = new ArrayList<>();
+        for (PersistableProductQuantityTier source : input) {
+            if (source == null) throw new RestApiException("400", "Tier must not be null");
+            ProductQuantityTier tier = new ProductQuantityTier();
+            tier.setMinQuantity(source.getMinQuantity());
+            tier.setPrice(source.getPrice());
+            tiers.add(tier);
+        }
+        try {
+            List<ReadableProductQuantityTier> result = new ArrayList<>();
+            for (ProductQuantityTier tier : tierService.replaceTiers(product, tiers))
+                result.add(new ReadableProductQuantityTier(tier.getMinQuantity(), tier.getPrice()));
+            return result;
+        } catch (IllegalArgumentException e) {
+            throw new RestApiException("400", e.getMessage());
+        }
+    }
+
+    private Product product(Long id, MerchantStore store) {
+        if (id == null || store == null) throw new ResourceNotFoundException("Product not found");
+        Product product = productFacade.getProduct(id, store);
+        if (product == null) throw new ResourceNotFoundException("Product not found");
+        return product;
+    }
+}
