+	/** Applies the best current tier to each line without sharing tiers between products. */
+	private void applyTierPrices(final ShoppingCart cart) throws ServiceException {
+		for (ShoppingCartItem item : cart.getLineItems()) {
+			Product product = item.getProduct();
+			if (product == null || item.getQuantity() == null || item.getItemPrice() == null) {
+				continue;
+			}
+			BigDecimal ownPrice = item.getItemPrice();
+			try {
+				List<ProductAttribute> attributes = new ArrayList<>();
+				if (item.getAttributes() != null) {
+					for (com.salesmanager.core.model.shoppingcart.ShoppingCartAttributeItem attribute : item.getAttributes()) {
+						if (attribute.getProductAttribute() != null) attributes.add(attribute.getProductAttribute());
+					}
+				}
+				if (!attributes.isEmpty()) ownPrice = pricingService.calculateProductPrice(product, attributes).getFinalPrice();
+				else ownPrice = pricingService.calculateProductPrice(product).getFinalPrice();
+			} catch (Exception ignored) {
+				// Keep the already calculated product price if a pricing extension fails.
+			}
+			BigDecimal selected = ownPrice;
+			int selectedMinimum = -1;
+			try {
+				Object tiers = product.getClass().getMethod("getTiers").invoke(product);
+				if (tiers instanceof Collection<?>) {
+					for (Object tier : (Collection<?>) tiers) {
+						Number minimum = (Number) tier.getClass().getMethod("getMinQuantity").invoke(tier);
+						BigDecimal price = (BigDecimal) tier.getClass().getMethod("getPrice").invoke(tier);
+						if (minimum != null && price != null && item.getQuantity() >= minimum.intValue() && minimum.intValue() > selectedMinimum) {
+							selected = price;
+							selectedMinimum = minimum.intValue();
+						}
+					}
+				}
+			} catch (ReflectiveOperationException ignored) { }
+			item.setItemPrice(selected.compareTo(ownPrice) < 0 ? selected : ownPrice);
+		}
+	}
+
 }
