+package com.salesmanager.core.business.services.catalog.product.tier;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Objects;
+
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.repositories.catalog.product.tier.ProductQuantityTierRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.tier.ProductQuantityTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productQuantityTierService")
+public class ProductQuantityTierServiceImpl implements ProductQuantityTierService {
+    private final ProductQuantityTierRepository repository;
+    private final ProductService productService;
+
+    @Inject
+    public ProductQuantityTierServiceImpl(ProductQuantityTierRepository repository, ProductService productService) {
+        this.repository = repository;
+        this.productService = productService;
+    }
+
+    @Override
+    @Transactional
+    public List<ProductQuantityTier> getTiers(Product product) {
+        if (product == null || product.getId() == null) return Collections.emptyList();
+        return new ArrayList<>(repository.findByProductIdOrderByMinQuantityAsc(product.getId()));
+    }
+
+    @Override
+    @Transactional
+    public List<ProductQuantityTier> getTiers(Long productId, MerchantStore store) {
+        if (productId == null || store == null) return Collections.emptyList();
+        Product product = productService.findOne(productId, store);
+        return getTiers(product);
+    }
+
+    @Override
+    @Transactional
+    public List<ProductQuantityTier> replaceTiers(Product product, List<ProductQuantityTier> tiers) {
+        if (product == null) throw new IllegalArgumentException("Product is required");
+        List<ProductQuantityTier> validated = validate(tiers);
+        repository.deleteByProductId(product.getId());
+        List<ProductQuantityTier> saved = new ArrayList<>();
+        for (ProductQuantityTier tier : validated) {
+            tier.setId(null);
+            tier.setProduct(product);
+            saved.add(repository.save(tier));
+        }
+        product.setQuantityPriceTiers(new HashSet<>(saved));
+        return saved;
+    }
+
+    private List<ProductQuantityTier> validate(List<ProductQuantityTier> tiers) {
+        if (tiers == null) throw new IllegalArgumentException("Tiers are required");
+        if (tiers.size() > 10) throw new IllegalArgumentException("At most 10 tiers are allowed");
+        List<ProductQuantityTier> sorted = new ArrayList<>(tiers);
+        sorted.sort(Comparator.comparing(ProductQuantityTier::getMinQuantity,
+            Comparator.nullsFirst(Integer::compareTo)));
+        Integer previousQuantity = null;
+        BigDecimal previousPrice = null;
+        for (ProductQuantityTier tier : sorted) {
+            if (tier == null || tier.getMinQuantity() == null || tier.getPrice() == null)
+                throw new IllegalArgumentException("Tier minQuantity and price are required");
+            if (tier.getMinQuantity() < 2 || (previousQuantity != null && tier.getMinQuantity().equals(previousQuantity)))
+                throw new IllegalArgumentException("Tier quantities must be distinct whole numbers of at least 2");
+            if (tier.getPrice().compareTo(BigDecimal.ZERO) <= 0)
+                throw new IllegalArgumentException("Tier price must be greater than zero");
+            if (previousPrice != null && tier.getPrice().compareTo(previousPrice) >= 0)
+                throw new IllegalArgumentException("Higher quantity tiers must have lower prices");
+            previousQuantity = tier.getMinQuantity();
+            previousPrice = tier.getPrice();
+        }
+        return sorted;
+    }
+}
