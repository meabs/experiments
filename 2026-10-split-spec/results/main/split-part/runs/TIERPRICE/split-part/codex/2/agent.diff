+package com.salesmanager.shop.store.api.v1.product;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestMethod;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductPriceTierService;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductPriceTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductTier;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Private, store-scoped administration of product quantity pricing. */
+@Controller
+@RequestMapping("/api/v1")
+public class ProductTierApi {
+
+    @Inject
+    private ProductService productService;
+
+    @Inject
+    private ProductPriceTierService productPriceTierService;
+
+    @RequestMapping(value = "/private/product/{id}/tiers", method = RequestMethod.GET)
+    @ResponseStatus(HttpStatus.OK)
+    @ResponseBody
+    public List<ProductTier> get(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        Product product = requireProduct(id, store);
+        return toApi(productPriceTierService.getTiers(product, store));
+    }
+
+    @RequestMapping(value = "/private/product/{id}/tiers", method = RequestMethod.PUT)
+    @ResponseStatus(HttpStatus.OK)
+    @ResponseBody
+    public List<ProductTier> replace(@PathVariable Long id, @RequestBody List<ProductTier> tiers,
+            @ApiIgnore MerchantStore store) {
+        Product product = requireProduct(id, store);
+        validate(tiers);
+        try {
+            return toApi(productPriceTierService.replaceTiers(product, store, toCore(tiers)));
+        } catch (ServiceException e) {
+            throw new RestApiException("400", e.getMessage(), e);
+        }
+    }
+
+    private Product requireProduct(Long id, MerchantStore store) {
+        Product product = id == null || store == null ? null : productService.retrieveById(id, store).orElse(null);
+        if (product == null) {
+            throw new ResourceNotFoundException("Product " + id + " was not found");
+        }
+        return product;
+    }
+
+    private void validate(List<ProductTier> tiers) {
+        if (tiers == null || tiers.size() > 10) throw new RestApiException("400", "Invalid tiers");
+        int previousQuantity = -1;
+        BigDecimal previousPrice = null;
+        for (ProductTier tier : tiers) {
+            if (tier == null || tier.getMinQuantity() == null || tier.getPrice() == null
+                    || tier.getMinQuantity() < 2 || tier.getPrice().signum() <= 0) {
+                throw new RestApiException("400", "Each tier requires minQuantity >= 2 and price > 0");
+            }
+            if (tier.getMinQuantity() <= previousQuantity) {
+                throw new RestApiException("400", "Tiers must have unique increasing minQuantity values");
+            }
+            // Once ordered by quantity, every subsequent price must be lower.
+            if (previousPrice != null && tier.getPrice().compareTo(previousPrice) >= 0) {
+                throw new RestApiException("400", "Higher quantities must have lower prices");
+            }
+            previousQuantity = tier.getMinQuantity();
+            previousPrice = tier.getPrice();
+        }
+    }
+
+    private List<ProductPriceTier> toCore(List<ProductTier> source) {
+        List<ProductPriceTier> result = new ArrayList<>();
+        for (ProductTier value : source) {
+            result.add(new ProductPriceTier(value.getMinQuantity(), value.getPrice()));
+        }
+        return result;
+    }
+
+    private List<ProductTier> toApi(List<ProductPriceTier> value) {
+        List<ProductTier> result = new ArrayList<>();
+        for (ProductPriceTier item : value) {
+            result.add(new ProductTier(item.getMinQuantity(), item.getPrice()));
+        }
+        result.sort(Comparator.comparing(ProductTier::getMinQuantity));
+        return result;
+    }
+}
