+package com.salesmanager.shop.model.catalog.product;
+
+import java.io.Serializable;
+import java.math.BigDecimal;
+
+/**
+ * A quantity break and the unit price that applies at that quantity.
+ *
+ * <p>The fields deliberately use boxed types: a missing JSON property must be
+ * distinguishable from a property whose value is zero so the API can report a
+ * bad request rather than silently applying a default.</p>
+ */
+public class ProductTier implements Serializable {
+
+    private static final long serialVersionUID = 1L;
+
+    private Integer minQuantity;
+    private BigDecimal price;
+
+    public ProductTier() {
+    }
+
+    public ProductTier(Integer minQuantity, BigDecimal price) {
+        this.minQuantity = minQuantity;
+        this.price = price;
+    }
+
+    public Integer getMinQuantity() {
+        return minQuantity;
+    }
+
+    public void setMinQuantity(Integer minQuantity) {
+        this.minQuantity = minQuantity;
+    }
+
+    public BigDecimal getPrice() {
+        return price;
+    }
+
+    public void setPrice(BigDecimal price) {
+        this.price = price;
+    }
+}
