+package com.salesmanager.core.business.services.catalog.product;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.ProductPriceTierRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductPriceTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productPriceTierService")
+public class ProductPriceTierServiceImpl implements ProductPriceTierService {
+ private final ProductPriceTierRepository repository;
+ @Inject public ProductPriceTierServiceImpl(ProductPriceTierRepository repository) { this.repository = repository; }
+ @Override @Transactional(readOnly = true)
+ public List<ProductPriceTier> getTiers(Product product, MerchantStore store) { checkProductStore(product, store); return repository.findByProductOrderByMinQuantityAsc(product); }
+ @Override @Transactional
+ public List<ProductPriceTier> replaceTiers(Product product, MerchantStore store, List<ProductPriceTier> requested) throws ServiceException {
+  checkProductStore(product, store); List<ProductPriceTier> tiers = validateAndSort(requested);
+  repository.deleteByProduct(product);
+  for (ProductPriceTier tier : tiers) { tier.setId(null); tier.setProduct(product); }
+  repository.saveAll(tiers); product.getPriceTiers().clear(); product.getPriceTiers().addAll(tiers); return tiers;
+ }
+ @Override @Transactional(readOnly = true)
+ public ProductPriceTier getTierForQuantity(Product product, MerchantStore store, int quantity) {
+  ProductPriceTier selected = null; for (ProductPriceTier tier : getTiers(product, store)) { if (tier.getMinQuantity() <= quantity) selected = tier; else break; } return selected;
+ }
+ private List<ProductPriceTier> validateAndSort(List<ProductPriceTier> requested) throws ServiceException {
+  if (requested == null || requested.size() > 10) throw invalid("At most 10 tiers are allowed");
+  List<ProductPriceTier> tiers = new ArrayList<ProductPriceTier>(requested);
+  for (ProductPriceTier tier : tiers) if (tier == null || tier.getMinQuantity() == null || tier.getMinQuantity() < 2 || tier.getPrice() == null || tier.getPrice().signum() <= 0) throw invalid("Invalid price tier");
+  tiers.sort(Comparator.comparing(ProductPriceTier::getMinQuantity));
+  for (int i = 1; i < tiers.size(); i++) { ProductPriceTier tier = tiers.get(i); if (tiers.get(i - 1).getMinQuantity().equals(tier.getMinQuantity())) throw invalid("Duplicate minimum quantity"); for (int j = 0; j < i; j++) if (tier.getPrice().compareTo(tiers.get(j).getPrice()) >= 0) throw invalid("Higher quantities must have lower prices"); }
+  return tiers;
+ }
+ private ServiceException invalid(String message) { return new ServiceException(ServiceException.EXCEPTION_VALIDATION, message); }
+ private void checkProductStore(Product product, MerchantStore store) { if (product == null || store == null || product.getMerchantStore() == null || product.getMerchantStore().getId() == null || !product.getMerchantStore().getId().equals(store.getId())) throw new IllegalArgumentException("Product does not belong to store"); }
+}
