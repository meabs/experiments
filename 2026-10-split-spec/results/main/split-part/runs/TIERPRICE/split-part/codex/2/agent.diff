+    /**
+     * Resolve the quantity tier supplied by the product model.  Reflection keeps
+     * this service compatible with the model's tier value type while that type is
+     * shared by the core and shop modules; the lookup remains strictly scoped to
+     * the line's product.
+     */
+    private BigDecimal tierPrice(ShoppingCartItem item) {
+        BigDecimal own = item.getItemPrice();
+        if (item.getFinalPrice() != null && item.getFinalPrice().getFinalPrice() != null) {
+            own = item.getFinalPrice().getFinalPrice();
+        }
+        if (own == null || item.getProduct() == null || item.getQuantity() == null) {
+            return own;
+        }
+        try {
+            BigDecimal selected = null;
+            int selectedMin = -1;
+            for (ProductPriceTier tier : item.getProduct().getPriceTiers()) {
+                int min = tier.getMinQuantity();
+                if (min <= item.getQuantity() && min >= selectedMin) {
+                    selectedMin = min;
+                    selected = tier.getPrice();
+                }
+            }
+            return selected != null && selected.compareTo(own) < 0 ? selected : own;
+        } catch (Exception ignored) {
+            return own;
+        }
+    }
