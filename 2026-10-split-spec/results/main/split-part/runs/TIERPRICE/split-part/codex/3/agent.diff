+	private void recalculateTierPrices(final ShoppingCart cart, final MerchantStore store) throws ServiceException {
+		if (cart.getLineItems() == null) return;
+		for (ShoppingCartItem item : cart.getLineItems()) {
+			if (item.getProduct() == null || item.getItemPrice() == null || item.getQuantity() == null) continue;
+			// itemPrice may be a prior tier price, so obtain the product's current base
+			// price before selecting the applicable tier.
+			BigDecimal basePrice = item.getFinalPrice() == null ? item.getItemPrice()
+					: item.getFinalPrice().getFinalPrice();
+			if (basePrice == null) basePrice = item.getItemPrice();
+			BigDecimal selected = basePrice;
+			for (ProductTier tier : productTierService.getOrderedTiers(item.getProduct(), store)) {
+				if (tier.getMinQuantity() != null && tier.getMinQuantity() <= item.getQuantity()
+						&& tier.getPrice() != null && tier.getPrice().compareTo(selected) < 0) {
+					selected = tier.getPrice();
+				}
+			}
+			item.setItemPrice(selected);
+			item.setSubTotal(selected.multiply(new BigDecimal(item.getQuantity())));
+		}
+	}
+
 }
