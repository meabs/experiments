+package com.salesmanager.shop.store.api.v1.product;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.stream.Collectors;
+
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.ProductTierService;
+import com.salesmanager.core.model.catalog.product.ProductTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Protected administration API for product quantity-break prices. */
+@Controller
+@RequestMapping("/api/v1")
+public class ProductTierApi {
+
+    @Autowired
+    private ProductTierService productTierService;
+
+    @Autowired
+    private ProductService productService;
+
+    @GetMapping("/private/product/{id}/tiers")
+    @ResponseStatus(HttpStatus.OK)
+    public @ResponseBody List<com.salesmanager.shop.model.catalog.product.ProductTier> get(
+            @PathVariable Long id, @ApiIgnore MerchantStore merchantStore) {
+        requireProduct(id, merchantStore);
+        try {
+            return toApi(productTierService.getOrderedTiers(productService.retrieveById(id, merchantStore).get(), merchantStore));
+        } catch (Exception e) {
+            throw new RestApiException("Unable to read product tiers", e);
+        }
+    }
+
+    @PutMapping("/private/product/{id}/tiers")
+    @ResponseStatus(HttpStatus.OK)
+    public @ResponseBody List<com.salesmanager.shop.model.catalog.product.ProductTier> replace(
+            @PathVariable Long id,
+            @RequestBody List<com.salesmanager.shop.model.catalog.product.ProductTier> tiers,
+            @ApiIgnore MerchantStore merchantStore) {
+        requireProduct(id, merchantStore);
+        validate(tiers);
+        List<ProductTier> coreTiers = tiers.stream().map(this::toCore).collect(Collectors.toList());
+        try {
+            productTierService.replaceTiers(id, merchantStore, coreTiers);
+            return toApi(productTierService.getTiers(id, merchantStore));
+        } catch (Exception e) {
+            throw new RestApiException("Unable to replace product tiers", e);
+        }
+    }
+
+    private void requireProduct(Long id, MerchantStore store) {
+        if (id == null || store == null || !productService.retrieveById(id, store).isPresent()) {
+            throw new ResourceNotFoundException("Product not found");
+        }
+    }
