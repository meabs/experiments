+package com.salesmanager.core.business.services.catalog.product;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.ProductTierRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productTierService")
+public class ProductTierServiceImpl implements ProductTierService {
+    private final ProductTierRepository tierRepository;
+    private final ProductService productService;
+
+    @Inject
+    public ProductTierServiceImpl(ProductTierRepository tierRepository, ProductService productService) {
+        this.tierRepository = tierRepository;
+        this.productService = productService;
+    }
+
+    @Override
+    @Transactional(readOnly = true)
+    public List<ProductTier> getTiers(Product product, MerchantStore store) throws ServiceException {
+        if (product == null || product.getId() == null) return new ArrayList<ProductTier>();
+        return getTiers(product.getId(), store);
+    }
+
+    @Override
+    @Transactional(readOnly = true)
+    public List<ProductTier> getTiers(Long productId, MerchantStore store) throws ServiceException {
+        requireProduct(productId, store);
+        return tierRepository.findByProductAndStore(productId, store.getId());
+    }
+
+    @Override
+    public List<ProductTier> getOrderedTiers(Product product, MerchantStore store) throws ServiceException {
+        return getTiers(product, store);
+    }
+
+    @Override
+    @Transactional
+    public void replaceTiers(Long productId, MerchantStore store, List<ProductTier> tiers) throws ServiceException {
+        Product product = requireProduct(productId, store);
+        validate(tiers);
+        // Validate completely before touching the managed collection: rejected requests are no-ops.
+        product.getQuantityTiers().clear();
+        if (tiers != null) {
+            for (ProductTier tier : tiers) {
+                tier.setId(null);
+                tier.setProduct(product);
+                product.getQuantityTiers().add(tier);
+            }
+        }
+        productService.update(product);
+    }
+
+    @Override
+    public void replaceTiers(Product product, MerchantStore store, List<ProductTier> tiers) throws ServiceException {
+        replaceTiers(product == null ? null : product.getId(), store, tiers);
+    }
+
+    private Product requireProduct(Long productId, MerchantStore store) throws ServiceException {
+        if (productId == null || store == null) throw invalid("Product and store are required");
+        Product product = productService.retrieveById(productId, store).orElse(null);
+        if (product == null) throw invalid("Product does not belong to store");
+        return product;
+    }
+
+    private void validate(List<ProductTier> tiers) throws ServiceException {
+        if (tiers == null || tiers.isEmpty()) return;
+        if (tiers.size() > 10) throw invalid("At most 10 tiers are allowed");
+        List<ProductTier> ordered = new ArrayList<ProductTier>(tiers);
+        ordered.sort(Comparator.comparing(ProductTier::getMinQuantity, Comparator.nullsFirst(Integer::compareTo)));
+        Integer previousQuantity = null;
+        BigDecimal previousPrice = null;
+        for (ProductTier tier : ordered) {
+            if (tier == null || tier.getMinQuantity() == null || tier.getPrice() == null
+                    || tier.getMinQuantity() < 2 || tier.getPrice().compareTo(BigDecimal.ZERO) <= 0) {
+                throw invalid("Invalid tier");
+            }
+            if (previousQuantity != null && previousQuantity.equals(tier.getMinQuantity())) {
+                throw invalid("Duplicate minimum quantity");
+            }
+            if (previousPrice != null && tier.getPrice().compareTo(previousPrice) >= 0) {
+                throw invalid("Tier prices must decrease as quantity increases");
+            }
+            previousQuantity = tier.getMinQuantity();
+            previousPrice = tier.getPrice();
+        }
+    }
+
+    private ServiceException invalid(String message) {
+        return new ServiceException(ServiceException.EXCEPTION_VALIDATION, message);
+    }
+}
