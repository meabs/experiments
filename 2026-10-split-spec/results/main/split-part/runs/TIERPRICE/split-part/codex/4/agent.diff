+package com.salesmanager.core.business.services.catalog.product;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+import javax.transaction.Transactional;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.repositories.catalog.product.ProductTierRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductTier;
+
+@Service
+public class ProductTierServiceImpl implements ProductTierService {
+    private final ProductTierRepository repository;
+
+    public ProductTierServiceImpl(ProductTierRepository repository) { this.repository = repository; }
+
+    @Override public List<ProductTier> get(Product product) {
+        if (product == null) return new ArrayList<ProductTier>();
+        return repository.findByProductOrderByMinQuantityAsc(product);
+    }
+
+    @Override public List<ProductTier> getQuantityPriceTiers(Product product) { return get(product); }
+
+    @Override @Transactional
+    public void replace(Product product, List<ProductTier> tiers) {
+        if (product == null) throw new IllegalArgumentException("Product is required");
+        List<ProductTier> checked = validate(tiers);
+        repository.deleteByProduct(product);
+        for (ProductTier tier : checked) tier.setProduct(product);
+        repository.saveAll(checked);
+        product.setQuantityPriceTiers(checked);
+    }
+
+    @Override public void replaceQuantityPriceTiers(Product product, List<ProductTier> tiers) { replace(product, tiers); }
+
+    @Override public BigDecimal resolvePrice(Product product, int quantity, BigDecimal basePrice) {
+        BigDecimal result = basePrice;
+        for (ProductTier tier : get(product)) {
+            if (quantity >= tier.getMinQuantity()) {
+                // A tier is a discount, never a surcharge over the product's
+                // current (possibly special) price.
+                if (result == null || tier.getPrice().compareTo(result) < 0) result = tier.getPrice();
+            } else break;
+        }
+        return result;
+    }
+
+    @Override public BigDecimal resolvePrice(Product product, int quantity) {
+        List<ProductTier> tiers = get(product);
+        BigDecimal result = null;
+        for (ProductTier tier : tiers) if (quantity >= tier.getMinQuantity()) result = tier.getPrice(); else break;
+        return result;
+    }
+
+    private List<ProductTier> validate(List<ProductTier> tiers) {
+        if (tiers == null) return new ArrayList<ProductTier>();
+        if (tiers.size() > 10) throw new IllegalArgumentException("At most 10 tiers are allowed");
+        List<ProductTier> sorted = new ArrayList<ProductTier>(tiers);
+        for (ProductTier tier : sorted) {
+            if (tier == null || tier.getMinQuantity() == null || tier.getPrice() == null
+                    || tier.getMinQuantity() < 2 || tier.getPrice().compareTo(BigDecimal.ZERO) <= 0)
+                throw new IllegalArgumentException("Invalid quantity price tier");
+        }
+        sorted.sort(Comparator.comparing(ProductTier::getMinQuantity));
+        Set<Integer> quantities = new HashSet<Integer>();
+        BigDecimal prior = null;
+        for (ProductTier tier : sorted) {
+            if (!quantities.add(tier.getMinQuantity())) throw new IllegalArgumentException("Duplicate minQuantity");
+            if (prior != null && tier.getPrice().compareTo(prior) >= 0)
+                throw new IllegalArgumentException("Higher quantity must have a lower price");
+            prior = tier.getPrice();
+        }
+        return sorted;
+    }
+}
