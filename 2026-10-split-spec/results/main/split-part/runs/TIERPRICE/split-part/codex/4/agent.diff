+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.MediaType;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.ExceptionHandler;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+import org.springframework.http.converter.HttpMessageNotReadableException;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.ProductTierService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.QuantityPriceTier;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import io.swagger.annotations.Api;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Protected administration endpoints for product quantity-price tiers. */
+@RestController
+@RequestMapping("/api/v1")
+@Api(tags = { "Product quantity price tiers" })
+public class ProductTierApi {
+
+    @Inject
+    private ProductService productService;
+
+    @Inject
+    private ProductTierService productTierService;
+
+    @GetMapping(value = "/private/product/{id}/tiers", produces = MediaType.APPLICATION_JSON_VALUE)
+    @ResponseStatus(HttpStatus.OK)
+    public List<QuantityPriceTier> get(@PathVariable Long id, @ApiIgnore MerchantStore merchantStore) {
+        Product product = findProduct(id, merchantStore);
+        return toDto(productTierService.getQuantityPriceTiers(product));
+    }
+
+    @PutMapping(value = "/private/product/{id}/tiers", consumes = MediaType.APPLICATION_JSON_VALUE,
+            produces = MediaType.APPLICATION_JSON_VALUE)
+    @ResponseStatus(HttpStatus.OK)
+    public List<QuantityPriceTier> replace(@PathVariable Long id,
+            @RequestBody List<QuantityPriceTier> requested, @ApiIgnore MerchantStore merchantStore) {
+        Product product = findProduct(id, merchantStore);
+        if (requested == null) {
+            throw new BadTierRequestException("Tier list is required");
+        }
+
+        List<ProductTier> tiers = new ArrayList<ProductTier>(requested.size());
+        for (QuantityPriceTier tier : requested) {
+            if (tier == null) {
+                throw new BadTierRequestException("Tier must not be null");
+            }
+            Integer minQuantity;
+            try {
+                minQuantity = tier.getMinQuantity().intValueExact();
+            } catch (ArithmeticException | NullPointerException ex) {
+                throw new BadTierRequestException("minQuantity must be a whole number");
+            }
+            tiers.add(new ProductTier(minQuantity, tier.getPrice()));
+        }
+        try {
+            productTierService.replaceQuantityPriceTiers(product, tiers);
+        } catch (IllegalArgumentException ex) {
+            // Validation happens before replacement in the tier service.
+            throw new BadTierRequestException(ex.getMessage());
+        }
+        return toDto(productTierService.getQuantityPriceTiers(product));
+    }
+
+    private Product findProduct(Long id, MerchantStore store) {
+        Product product = productService.findOne(id, store);
+        if (product == null) {
+            throw new ResourceNotFoundException("Product [" + id + "] not found");
+        }
+        return product;
+    }
+
+    private List<QuantityPriceTier> toDto(List<ProductTier> tiers) {
+        return tiers.stream().map(t -> new QuantityPriceTier(t.getMinQuantity(), t.getPrice()))
+                .collect(Collectors.toList());
+    }
+
+    @ExceptionHandler(HttpMessageNotReadableException.class)
+    @ResponseStatus(HttpStatus.BAD_REQUEST)
+    public void malformedJson(HttpMessageNotReadableException exception) {
+        // Includes fractional/non-numeric minQuantity values rejected during JSON binding.
+    }
+
+    private static class BadTierRequestException extends RestApiException {
+        private static final long serialVersionUID = 1L;
+        BadTierRequestException(String message) { super("400", message); }
+    }
+}
