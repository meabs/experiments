+import java.io.Serializable;
+import java.math.BigDecimal;
+
+/** JSON representation of a product quantity-price tier. */
+public class QuantityPriceTier implements Serializable {
+    private static final long serialVersionUID = 1L;
+
+    /* BigDecimal lets the API distinguish 2.5 (invalid) from a missing value. */
+    private BigDecimal minQuantity;
+    private BigDecimal price;
+
+    public QuantityPriceTier() { }
+
+    public QuantityPriceTier(Integer minQuantity, BigDecimal price) {
+        this.minQuantity = minQuantity == null ? null : BigDecimal.valueOf(minQuantity);
+        this.price = price;
+    }
+
+    public BigDecimal getMinQuantity() {
+        return minQuantity;
+    }
+
+    public void setMinQuantity(BigDecimal minQuantity) {
+        this.minQuantity = minQuantity;
+    }
+
+    public BigDecimal getPrice() {
+        return price;
+    }
+
+    public void setPrice(BigDecimal price) {
+        this.price = price;
+    }
+}
