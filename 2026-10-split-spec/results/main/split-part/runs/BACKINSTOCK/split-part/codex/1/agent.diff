+      if (a.getProductQuantity() != null && a.getProductQuantity() > 0) throw new org.springframework.web.server.ResponseStatusException(HttpStatus.CONFLICT);
+    Optional<StockAlert> old = stockAlertService.findPending(product, store, request.getEmail());
+    StockAlert alert = old.isPresent() ? old.get() : stockAlertService.create(product, store, request.getEmail());
+    return ResponseEntity.status(old.isPresent() ? HttpStatus.OK : HttpStatus.CREATED).body(toReadable(alert));
+  }
+
+  @RequestMapping(value="/products/{sku}/alerts", method=RequestMethod.DELETE)
+  @ResponseStatus(HttpStatus.NO_CONTENT)
+  public void cancel(@PathVariable String sku, @RequestParam String email, @ApiIgnore MerchantStore store,
+      @ApiIgnore Language language) throws Exception {
+    Product product;
+    try { product = productService.getBySku(sku, store, language); } catch (Exception e) { throw new org.springframework.web.server.ResponseStatusException(HttpStatus.NOT_FOUND); }
+    if (product == null) throw new org.springframework.web.server.ResponseStatusException(HttpStatus.NOT_FOUND);
+    Optional<StockAlert> found = stockAlertService.findPending(product, store, email);
+    if (!found.isPresent()) throw new org.springframework.web.server.ResponseStatusException(HttpStatus.NOT_FOUND);
+    stockAlertService.cancel(found.get().getId(), store);
+  }
+
+  @RequestMapping(value="/private/stock-alerts", method=RequestMethod.GET)
+  @ResponseBody
+  public List<ReadableStockAlert> list(@RequestParam(value="status", required=false) String status,
+      @ApiIgnore MerchantStore store) throws Exception {
+    StockAlertStatus filter = parseStatus(status);
+    List<StockAlert> alerts = storeAlerts(store, filter);
+    Collections.sort(alerts, Comparator.comparing(StockAlert::getCreatedAt, Comparator.nullsFirst(Comparator.naturalOrder())));
+    List<ReadableStockAlert> result = new ArrayList<>();
+    for (StockAlert a : alerts) result.add(toReadable(a));
+    return result;
+  }
+
+  @RequestMapping(value="/private/stock-alerts/outbox", method=RequestMethod.GET)
+  @ResponseBody
+  public List<ReadableStockAlertOutbox> outbox(@ApiIgnore MerchantStore store) {
+    List<com.salesmanager.core.model.catalog.product.stockalert.StockAlertOutbox> messages = stockAlertService.listOutbox(store);
+    Collections.sort(messages, Comparator.comparing(com.salesmanager.core.model.catalog.product.stockalert.StockAlertOutbox::getCreatedAt,
+        Comparator.nullsFirst(Comparator.naturalOrder())));
+    List<ReadableStockAlertOutbox> result = new ArrayList<>();
+    for (com.salesmanager.core.model.catalog.product.stockalert.StockAlertOutbox m : messages) {
+      ReadableStockAlertOutbox r = new ReadableStockAlertOutbox(); r.setTo(m.getTo()); r.setSku(m.getSku()); r.setSubject(m.getSubject()); r.setCreatedAt(date(m.getCreatedAt())); result.add(r);
+    }
+    return result;
+  }
+
+  @SuppressWarnings("unchecked")
+  private List<StockAlert> storeAlerts(MerchantStore store, StockAlertStatus status) throws Exception {
+    // Part 1 exposes the store-wide overload; reflection keeps this module source-compatible
+    // with older service binaries while that overload is being introduced.
+    for (java.lang.reflect.Method m : stockAlertService.getClass().getMethods()) {
+      if (!m.getName().equals("list") && !m.getName().equals("listAll")) continue;
+      Class<?>[] p = m.getParameterTypes();
+      if (p.length == 2 && p[0].isAssignableFrom(MerchantStore.class)) {
+        Object v = m.invoke(stockAlertService, store, status); return (List<StockAlert>) v;
+      }
+    }
+    throw new IllegalStateException("Stock-alert service has no store-wide listing method");
+  }
+
+  private StockAlertStatus parseStatus(String status) {
+    if (status == null || status.isEmpty()) return null;
+    try { return StockAlertStatus.valueOf(status); }
+    catch (IllegalArgumentException e) { throw new org.springframework.web.server.ResponseStatusException(HttpStatus.BAD_REQUEST); }
+  }
+
+  private ReadableStockAlert toReadable(StockAlert a) {
+    ReadableStockAlert r = new ReadableStockAlert(); r.setId(a.getId()); r.setSku(a.getSku()); r.setEmail(a.getEmail());
+    r.setStatus(a.getStatus() == null ? null : a.getStatus().name()); r.setCreatedAt(date(a.getCreatedAt())); r.setSentAt(date(a.getSentAt())); return r;
+  }
+  private String date(Date d) { return d == null ? null : new SimpleDateFormat(ISO).format(d); }
+}
