+package com.salesmanager.core.business.services.catalog.product.stockalert;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.stockalert.*;
+import com.salesmanager.core.business.repositories.catalog.product.ProductRepository;
+import com.salesmanager.core.model.catalog.product.*;
+import com.salesmanager.core.model.catalog.product.description.ProductDescription;
+import com.salesmanager.core.model.catalog.product.stockalert.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+    private final StockAlertRepository alerts; private final StockAlertOutboxRepository outbox;
+    private final ProductRepository products;
+    @Inject public StockAlertServiceImpl(StockAlertRepository a, StockAlertOutboxRepository o, ProductRepository p) { alerts=a; outbox=o; products=p; }
+    @Override @Transactional public StockAlert create(Product p, MerchantStore s, String email) throws ServiceException {
+        if (email == null || email.trim().isEmpty()) throw new ServiceException("Email is required");
+        Optional<StockAlert> existing=findPending(p,s,email); if(existing.isPresent()) return existing.get();
+        StockAlert a=new StockAlert(); a.setProduct(p); a.setMerchantStore(s); a.setSku(p.getSku()); a.setEmail(email); return alerts.save(a);
+    }
+    public Optional<StockAlert> findPending(Product p, MerchantStore s, String e) { return alerts.findPending(p.getId(),s.getId(),e); }
+    @Override @Transactional public StockAlert cancel(Long id, MerchantStore s) throws ServiceException {
+        StockAlert a=alerts.findById(id).orElseThrow(() -> new ServiceException("Alert not found"));
+        if (!a.getMerchantStore().getId().equals(s.getId())) throw new ServiceException("Alert not found"); alerts.delete(a); return a;
+    }
+    public List<StockAlert> list(Product p, MerchantStore s, StockAlertStatus status) { return status==null ? alerts.findAll(p.getId(),s.getId()) : alerts.findAll(p.getId(),s.getId(),status); }
+    public List<StockAlert> list(MerchantStore s, StockAlertStatus status) { return status==null ? alerts.findAllByStore(s.getId()) : alerts.findAllByStore(s.getId(), status); }
+    public Optional<Product> findProductBySku(String sku, MerchantStore store) { return Optional.ofNullable(products.getByCode(sku, store)); }
+    public List<StockAlertOutbox> listOutbox(MerchantStore s) { return outbox.findAll(s.getId()); }
+    @Override @Transactional public void notifyRestocked(Product p, MerchantStore s) throws ServiceException {
+        String name=p.getSku(); if (p.getDescriptions()!=null && !p.getDescriptions().isEmpty()) { ProductDescription d=p.getDescriptions().iterator().next(); if (d.getName()!=null) name=d.getName(); }
+        for (StockAlert a : alerts.findPending(p.getId(),s.getId())) { a.setStatus(StockAlertStatus.SENT); a.setSentAt(new Date()); alerts.save(a); StockAlertOutbox m=new StockAlertOutbox(); m.setMerchantStore(s); m.setTo(a.getEmail()); m.setSku(a.getSku()); m.setSubject(name+" is back in stock"); outbox.save(m); }
+    }
+    public void deleteByProduct(Product p) { if (p != null && p.getId()!=null) alerts.deleteByProductId(p.getId()); }
+}
