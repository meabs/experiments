+
+@RestController
+@RequestMapping("/api/v1")
+@Api(tags={"Stock alerts"})
+public class StockAlertApi {
+ @Inject private StockAlertFacade facade;
+ @PostMapping("/products/{sku}/alerts") @ResponseStatus(HttpStatus.CREATED)
