+package com.salesmanager.core.business.services.catalog.product;
+
+import java.util.*;
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.*;
+import com.salesmanager.core.model.catalog.product.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+ private final StockAlertRepository alerts; private final StockAlertOutboxRepository outbox;
+ @Inject public StockAlertServiceImpl(StockAlertRepository alerts, StockAlertOutboxRepository outbox){this.alerts=alerts;this.outbox=outbox;}
+ @Override @Transactional public StockAlert createAlert(Product product, MerchantStore store, String email) {
+  if (product == null || store == null || email == null) throw new IllegalArgumentException("Product, store and email are required");
+  Optional<StockAlert> existing=alerts.findFirstByProductIdAndMerchantStoreIdAndStatusAndEmailIgnoreCase(product.getId(),store.getId(),StockAlertStatus.PENDING,email.trim());
+  if(existing.isPresent()) return existing.get();
+  StockAlert a=new StockAlert(); a.setProduct(product); a.setMerchantStore(store); a.setSku(product.getSku()); a.setEmail(email.trim()); a.setCreatedAt(new Date()); a.setStatus(StockAlertStatus.PENDING); return alerts.save(a);
+ }
+ @Override public StockAlert createAlert(MerchantStore store, Product product, String email){return createAlert(product,store,email);}
+ @Override @Transactional public StockAlert cancelAlert(Long id, MerchantStore store){
+  StockAlert a=alerts.findById(id).orElseThrow(()->new NoSuchElementException("Alert not found"));
+  if(store==null || !store.getId().equals(a.getMerchantStore().getId())) throw new NoSuchElementException("Alert not found");
+  a.setStatus(StockAlertStatus.CANCELLED); return alerts.save(a);
+ }
+ @Override @Transactional public List<StockAlert> listAlerts(Product product, MerchantStore store){return alerts.findByProductIdAndMerchantStoreId(product.getId(),store.getId());}
+ @Override @Transactional public List<StockAlertOutbox> listOutbox(MerchantStore store){return outbox.findByMerchantStoreIdOrderByCreatedAtDesc(store.getId());}
+ @Override @Transactional public void processStockTransition(Product product, MerchantStore store, long oldQuantity, long newQuantity){
+  if(oldQuantity!=0 || newQuantity<=0 || product==null || store==null) return;
+  List<StockAlert> pending=alerts.findByProductIdAndMerchantStoreIdAndStatus(product.getId(),store.getId(),StockAlertStatus.PENDING);
+  String name=product.getProductDescription()!=null ? product.getProductDescription().getName() : product.getSku();
+  for(StockAlert a:pending){ a.setStatus(StockAlertStatus.SENT); a.setSentAt(new Date()); alerts.save(a); StockAlertOutbox m=new StockAlertOutbox(); m.setAlert(a);m.setMerchantStore(store);m.setTo(a.getEmail());m.setSku(a.getSku());m.setSubject(name + " is back in stock");m.setCreatedAt(new Date());outbox.save(m); }
+ }
+}
