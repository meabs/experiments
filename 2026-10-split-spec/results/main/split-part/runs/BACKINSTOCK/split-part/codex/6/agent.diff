+package com.salesmanager.core.business.services.catalog.product.stockalert;
+
+import java.util.*;
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.stockalert.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.business.repositories.catalog.product.stockalert.*;
+
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+ private final StockAlertRepository alerts; private final StockAlertOutboxRepository outbox;
+ @Inject public StockAlertServiceImpl(StockAlertRepository alerts, StockAlertOutboxRepository outbox){this.alerts=alerts;this.outbox=outbox;}
+ @Override @Transactional public StockAlert createOrGetPending(Product product, MerchantStore store, String email) {
+  if(product==null || store==null || email==null || email.trim().isEmpty()) throw new IllegalArgumentException("Product, store and email are required");
+  if(!isOutOfStock(product)) throw new StockAlertConflictException("Product is in stock");
+  String normalized=email.trim();
+  StockAlert existing=alerts.findByProductIdAndMerchantStoreIdAndEmailIgnoreCaseAndStatus(product.getId(),store.getId(),normalized,StockAlertStatus.PENDING);
+  if(existing!=null) return existing;
+  StockAlert a=new StockAlert(); a.setProduct(product); a.setMerchantStore(store); a.setEmail(normalized); a.setStatus(StockAlertStatus.PENDING); a.setCreatedAt(new Date());
+  return alerts.save(a);
+ }
+ @Override @Transactional public StockAlert cancelPending(Product product, MerchantStore store, String email) {
+  StockAlert a=alerts.findByProductIdAndMerchantStoreIdAndEmailIgnoreCaseAndStatus(product.getId(),store.getId(),email.trim(),StockAlertStatus.PENDING);
+  if(a!=null){a.setStatus(StockAlertStatus.CANCELLED); alerts.save(a);} return a;
+ }
+ @Override public List<StockAlert> list(MerchantStore store, StockAlertStatus status){return alerts.findByMerchantStoreIdAndStatus(store.getId(),status);}
+ @Override public List<StockAlert> list(Product product, StockAlertStatus status){return alerts.findByProductIdAndStatus(product.getId(),status);}
+ @Override public List<StockAlertOutboxMessage> listOutbox(MerchantStore store){return outbox.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId());}
+ @Override public List<StockAlertOutboxMessage> listOutbox(Product product){return outbox.findByProductIdOrderByCreatedAtAsc(product.getId());}
+ @Override @Transactional public void notifyRestocked(Product product,int oldQuantity,int newQuantity){
+  if(product==null || oldQuantity!=0 || newQuantity<=0) return;
+  for(StockAlert a: new ArrayList<>(alerts.findByProductIdAndStatus(product.getId(),StockAlertStatus.PENDING))){
+   Date now=new Date(); a.setStatus(StockAlertStatus.SENT); a.setSentAt(now); alerts.save(a);
+   StockAlertOutboxMessage m=new StockAlertOutboxMessage(); m.setAlert(a);m.setProduct(product);m.setMerchantStore(a.getMerchantStore());m.setEmail(a.getEmail());m.setCreatedAt(now);m.setMessage("Product " + product.getSku() + " is back in stock."); outbox.save(m);
+  }
+ }
+ @Override @Transactional public void deleteForProduct(Product product){
+  if(product!=null && product.getId()!=null){ outbox.deleteByProductId(product.getId()); alerts.deleteByProductId(product.getId()); }
+ }
+ public boolean isOutOfStock(Product product){
+  if(product.getAvailabilities()==null || product.getAvailabilities().isEmpty()) return true;
+  for(ProductAvailability a: product.getAvailabilities()) if(a.getProductQuantity()!=null && a.getProductQuantity()>0) return false;
+  return true;
+ }
+}
