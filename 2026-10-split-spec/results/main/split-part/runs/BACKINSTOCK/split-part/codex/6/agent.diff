+@Controller
+@RequestMapping("/api/v1")
+public class StockAlertApi {
+    @Inject private StockAlertFacade stockAlertFacade;
+
+    @PostMapping("/products/{sku}/alerts")
+    public ResponseEntity<ReadableStockAlert> create(@PathVariable String sku,
+            @Valid @RequestBody PersistableStockAlert request,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language) {
+        ReadableStockAlert result = stockAlertFacade.create(sku, request, store, language);
+        return ResponseEntity.status(result.isNewlyCreated() ? HttpStatus.CREATED : HttpStatus.OK).body(result);
+    }
+
+    @DeleteMapping("/products/{sku}/alerts")
+    public ResponseEntity<Void> cancel(@PathVariable String sku, @RequestParam String email,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language) {
+        stockAlertFacade.cancel(sku, email, store, language);
+        return ResponseEntity.noContent().build();
+    }
+
+    @GetMapping("/private/stock-alerts")
+    public ResponseEntity<List<ReadableStockAlert>> list(@RequestParam(required = false) String status,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language) {
+        return ResponseEntity.ok(stockAlertFacade.list(status, store, language));
+    }
+
+    @GetMapping("/private/stock-alerts/outbox")
+    public ResponseEntity<List<ReadableStockAlertOutbox>> outbox(@ApiIgnore MerchantStore store,
+            @ApiIgnore Language language) {
+        return ResponseEntity.ok(stockAlertFacade.listOutbox(store, language));
+    }
+}
