@@ -0,0 +1,128 @@
+package com.salesmanager.shop.store.facade.product;
+
+import java.time.Instant;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.List;
+import java.util.regex.Pattern;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+import org.springframework.web.server.ResponseStatusException;
+import org.springframework.http.HttpStatus;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.stockalert.StockAlertConflictException;
+import com.salesmanager.core.business.services.catalog.product.stockalert.StockAlertService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.description.ProductDescription;
+import com.salesmanager.core.model.catalog.product.stockalert.StockAlert;
+import com.salesmanager.core.model.catalog.product.stockalert.StockAlertOutboxMessage;
+import com.salesmanager.core.model.catalog.product.stockalert.StockAlertStatus;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.catalog.product.stockalert.PersistableStockAlert;
+import com.salesmanager.shop.model.catalog.product.stockalert.ReadableStockAlert;
+import com.salesmanager.shop.model.catalog.product.stockalert.ReadableStockAlertOutbox;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.controller.product.facade.StockAlertFacade;
+
+@Service("stockAlertFacade")
+public class StockAlertFacadeImpl implements StockAlertFacade {
+    private static final Pattern EMAIL = Pattern.compile("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$");
+
+    @Inject private StockAlertService stockAlertService;
+    @Inject private ProductService productService;
+
+    @Override
+    public ReadableStockAlert create(String sku, PersistableStockAlert request, MerchantStore store, Language language) {
+        String email = request == null ? null : request.getEmail();
+        validateEmail(email);
+        Product product = product(sku, store, language);
+        try {
+            boolean existing = stockAlertService.list(product, StockAlertStatus.PENDING).stream()
+                    .anyMatch(a -> a.getEmail().equalsIgnoreCase(email.trim()));
+            ReadableStockAlert result = alert(stockAlertService.createOrGetPending(product, store, email));
+            result.setNewlyCreated(!existing);
+            return result;
+        } catch (StockAlertConflictException e) {
+            throw new ResponseStatusException(HttpStatus.CONFLICT, e.getMessage(), e);
+        } catch (IllegalArgumentException e) {
+            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, e.getMessage(), e);
+        }
+    }
+
+    @Override
+    public void cancel(String sku, String email, MerchantStore store, Language language) {
+        validateEmail(email);
+        Product product = product(sku, store, language);
+        StockAlert result = stockAlertService.cancelPending(product, store, email.trim());
+        if (result == null) throw new ResourceNotFoundException("No pending stock alert found");
+    }
+
+    @Override
+    public List<ReadableStockAlert> list(String status, MerchantStore store, Language language) {
+        StockAlertStatus parsed = null;
+        if (status != null) {
+            try { parsed = StockAlertStatus.valueOf(status.toUpperCase()); }
+            catch (IllegalArgumentException e) { throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Invalid status", e); }
+            if (parsed != StockAlertStatus.PENDING && parsed != StockAlertStatus.SENT)
+                throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Invalid status");
+        }
+        List<ReadableStockAlert> result = new ArrayList<>();
+        List<StockAlert> source = new ArrayList<>();
+        if (parsed == null) {
+            source.addAll(stockAlertService.list(store, StockAlertStatus.PENDING));
+            source.addAll(stockAlertService.list(store, StockAlertStatus.SENT));
+        } else source.addAll(stockAlertService.list(store, parsed));
+        source.sort((a, b) -> date(a.getCreatedAt()).compareTo(date(b.getCreatedAt())));
+        for (StockAlert a : source) result.add(alert(a));
+        return result;
+    }
+
+    @Override
+    public List<ReadableStockAlertOutbox> listOutbox(MerchantStore store, Language language) {
+        List<ReadableStockAlertOutbox> result = new ArrayList<>();
+        List<StockAlertOutboxMessage> source = new ArrayList<>(stockAlertService.listOutbox(store));
+        source.sort((a, b) -> date(a.getCreatedAt()).compareTo(date(b.getCreatedAt())));
+        for (StockAlertOutboxMessage m : source) result.add(outbox(m));
+        return result;
+    }
+
+    private Product product(String sku, MerchantStore store, Language language) {
+        if (sku == null || sku.trim().isEmpty()) throw new ResourceNotFoundException("Product not found");
+        try {
+            Product p = productService.getBySku(sku, store, language);
+            if (p == null) throw new ResourceNotFoundException("Product not found: " + sku);
+            return p;
+        } catch (ResourceNotFoundException e) { throw e; }
+        catch (ServiceException e) { throw new ResourceNotFoundException("Product not found: " + sku); }
+    }
+
+    private void validateEmail(String email) {
+        if (email == null || !EMAIL.matcher(email.trim()).matches())
+            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Invalid email",
+                    new IllegalArgumentException("Invalid email"));
+    }
+
+    private ReadableStockAlert alert(StockAlert source) {
+        ReadableStockAlert target = new ReadableStockAlert();
+        target.setId(source.getId()); target.setEmail(source.getEmail()); target.setStatus(source.getStatus().name());
+        target.setSku(source.getProduct().getSku()); target.setCreatedAt(iso(source.getCreatedAt())); target.setSentAt(iso(source.getSentAt()));
+        return target;
+    }
+    private ReadableStockAlertOutbox outbox(StockAlertOutboxMessage source) {
+        ReadableStockAlertOutbox target = new ReadableStockAlertOutbox();
+        target.setTo(source.getEmail()); target.setSku(source.getProduct().getSku()); target.setCreatedAt(iso(source.getCreatedAt()));
+        String name = source.getProduct().getSku();
+        ProductDescription description = source.getProduct().getProductDescription();
+        if (description != null && description.getName() != null) name = description.getName();
+        target.setSubject(name + " is back in stock");
+        return target;
+    }
+    private String iso(Date value) { return value == null ? null : Instant.ofEpochMilli(value.getTime()).toString(); }
+    private Date date(Date value) { return value == null ? new Date(0) : value; }
+}
