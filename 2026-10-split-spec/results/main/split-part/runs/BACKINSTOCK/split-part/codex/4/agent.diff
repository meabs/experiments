+package com.salesmanager.core.business.services.stockalert;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.stockalert.*;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.stockalert.*;
+
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+ @Inject private StockAlertRepository alerts;
+ @Inject private OutboxMessageRepository outbox;
+ private Integer storeId(MerchantStore s){ return s.getId().intValue(); }
+ @Override @Transactional public StockAlert create(Product p, MerchantStore s, String email) {
+  if (p==null || s==null || email==null || email.trim().isEmpty()) throw new IllegalArgumentException("Product, store and email are required");
+  boolean inStock=false; if(p.getAvailabilities()!=null) for(com.salesmanager.core.model.catalog.product.availability.ProductAvailability a:p.getAvailabilities()) if(a.getProductQuantity()!=null && a.getProductQuantity()>0) inStock=true;
+  if(inStock) throw new IllegalStateException("Product is in stock");
+  StockAlert old=findPending(p,s,email); if(old!=null)return old;
+  StockAlert a=new StockAlert(); a.setProduct(p); a.setMerchantStore(s); a.setEmail(email.trim()); a.setStatus(StockAlertStatus.PENDING); return alerts.save(a);
+ }
+ public StockAlert createAlert(Product p, MerchantStore s,String e){return create(p,s,e);}
+ @Transactional(readOnly=true) public StockAlert findPending(Product p,MerchantStore s,String e){return alerts.findPendingByEmail(p.getId(),storeId(s),e);}
+ public StockAlert findPendingAlert(Product p,MerchantStore s,String e){return findPending(p,s,e);}
+ @Transactional(readOnly=true) public List<StockAlert> listPending(Product p,MerchantStore s){return alerts.findPending(p.getId(),storeId(s));}
+ public List<StockAlert> listPendingAlerts(Product p,MerchantStore s){return listPending(p,s);}
+ @Transactional public void cancel(StockAlert a){a.setStatus(StockAlertStatus.CANCELLED);alerts.save(a);}
+ public void cancelAlert(StockAlert a){cancel(a);}
+ @Transactional public void onStockUpdated(Product p,int oldQ,int newQ){if(oldQ!=0||newQ<=0)return; MerchantStore s=p.getMerchantStore(); List<StockAlert> list=listPending(p,s); Date now=new Date(); String name=p.getSku(); if(p.getDescriptions()!=null&&!p.getDescriptions().isEmpty()&&p.getDescriptions().iterator().next().getName()!=null) name=p.getDescriptions().iterator().next().getName(); for(StockAlert a:list){a.setStatus(StockAlertStatus.SENT);a.setSentAt(now);alerts.save(a);OutboxMessage m=new OutboxMessage();m.setMerchantStore(s);m.setRecipient(a.getEmail());m.setSku(p.getSku());m.setProductName(name);m.setSubject(name+" is back in stock");m.setBody("Product "+name+" is back in stock.");outbox.save(m);}}
+ @Transactional(readOnly=true) public List<OutboxMessage> listOutbox(MerchantStore s){return outbox.findByMerchantStoreIdOrderByCreatedAtAsc(storeId(s));}
+ public List<OutboxMessage> getOutbox(MerchantStore s){return listOutbox(s);}
+}
