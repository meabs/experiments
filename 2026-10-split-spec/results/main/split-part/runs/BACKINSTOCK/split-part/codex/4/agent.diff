+package com.salesmanager.shop.store.api.v1.stockalert;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.List;
+
+import javax.inject.Inject;
+import javax.validation.Valid;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.repositories.stockalert.StockAlertRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.stockalert.StockAlertService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.stockalert.OutboxMessage;
+import com.salesmanager.core.model.stockalert.StockAlert;
+import com.salesmanager.core.model.stockalert.StockAlertStatus;
+import com.salesmanager.shop.model.stockalert.PersistableStockAlert;
+import com.salesmanager.shop.model.stockalert.ReadableOutboxMessage;
+import com.salesmanager.shop.model.stockalert.ReadableStockAlert;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Shopper subscription and private store stock-alert resources. */
+@RestController
+@RequestMapping("/api/v1")
+public class StockAlertApi {
+    @Inject private ProductService productService;
+    @Inject private StockAlertService stockAlertService;
+    /* Used only for the administrative historical view; the service exposes the
+       transition operations, while this repository supplies its read projection. */
+    @Inject private StockAlertRepository stockAlertRepository;
+
+    @PostMapping("/products/{sku}/alerts")
+    public ResponseEntity<ReadableStockAlert> subscribe(@PathVariable String sku,
+            @Valid @RequestBody PersistableStockAlert request,
+            @ApiIgnore MerchantStore store) {
+        Product product = product(sku, store);
+        try {
+            StockAlert existing = stockAlertService.findPendingAlert(product, store, request.getEmail());
+            if (existing != null)
+                return new ResponseEntity<ReadableStockAlert>(read(existing, false), HttpStatus.OK);
+            StockAlert alert = stockAlertService.createAlert(product, store, request.getEmail());
+            return new ResponseEntity<ReadableStockAlert>(read(alert, false), HttpStatus.CREATED);
+        } catch (IllegalStateException e) {
+            return new ResponseEntity<ReadableStockAlert>(HttpStatus.CONFLICT);
+        } catch (IllegalArgumentException e) {
+            throw new RestApiException("400", e.getMessage());
+        }
+    }
+
+    @DeleteMapping("/products/{sku}/alerts")
+    public ResponseEntity<Void> cancel(@PathVariable String sku, @RequestParam String email,
+            @ApiIgnore MerchantStore store) {
+        Product product = product(sku, store);
+        StockAlert alert = stockAlertService.findPendingAlert(product, store, email);
+        if (alert == null) return new ResponseEntity<Void>(HttpStatus.NOT_FOUND);
+        stockAlertService.cancelAlert(alert);
+        return new ResponseEntity<Void>(HttpStatus.NO_CONTENT);
+    }
+
+    @GetMapping("/private/stock-alerts")
+    public ResponseEntity<List<ReadableStockAlert>> list(@RequestParam(required = false) String status,
+            @ApiIgnore MerchantStore store) {
+        StockAlertStatus requested = null;
+        if (status != null) {
+            try { requested = StockAlertStatus.valueOf(status.toUpperCase()); }
+            catch (IllegalArgumentException e) { throw new RestApiException("400", "Invalid status"); }
+            if (requested == StockAlertStatus.CANCELLED)
+                throw new RestApiException("400", "Invalid status");
+        }
+        List<StockAlert> all = new ArrayList<StockAlert>();
+        for (StockAlert a : stockAlertRepository.findAll()) {
+            if (a.getMerchantStore() != null && store != null &&
+                a.getMerchantStore().getId().equals(store.getId()) &&
+                (requested != null || a.getStatus() != StockAlertStatus.CANCELLED) &&
+                (requested == null || a.getStatus() == requested)) all.add(a);
+        }
+        Collections.sort(all, Comparator.comparing(StockAlert::getCreatedAt));
+        List<ReadableStockAlert> result = new ArrayList<ReadableStockAlert>();
+        for (StockAlert a : all) result.add(read(a, true));
+        return new ResponseEntity<List<ReadableStockAlert>>(result, HttpStatus.OK);
+    }
+
+    @GetMapping("/private/stock-alerts/outbox")
+    public ResponseEntity<List<ReadableOutboxMessage>> outbox(@ApiIgnore MerchantStore store) {
+        List<OutboxMessage> messages = stockAlertService.getOutbox(store);
+        List<ReadableOutboxMessage> result = new ArrayList<ReadableOutboxMessage>();
+        for (OutboxMessage m : messages) {
+            ReadableOutboxMessage r = new ReadableOutboxMessage();
+            r.setTo(m.getRecipient()); r.setSku(m.getSku()); r.setSubject(m.getSubject()); r.setCreatedAt(m.getCreatedAt());
+            // Older outbox records do not retain a product relation; derive SKU when available.
+            result.add(r);
+        }
+        return new ResponseEntity<List<ReadableOutboxMessage>>(result, HttpStatus.OK);
+    }
+
+    private Product product(String sku, MerchantStore store) {
+        try {
+            Product p = productService.getBySku(sku, store);
+            if (p == null) throw new RestApiException("404", "Unknown sku");
+            return p;
+        } catch (RestApiException e) { throw e; }
+        catch (Exception e) { throw new RestApiException("404", "Unknown sku"); }
+    }
+
+    private ReadableStockAlert read(StockAlert a, boolean admin) {
+        ReadableStockAlert r = new ReadableStockAlert();
+        r.setId(a.getId()); r.setEmail(a.getEmail()); r.setStatus(a.getStatus().name());
+        r.setCreatedAt(a.getCreatedAt()); r.setSentAt(a.getSentAt());
+        if (a.getProduct() != null) r.setSku(a.getProduct().getSku());
+        if (!admin) r.setId(null);
+        return r;
+    }
+}
