+package com.salesmanager.shop.store.api.v1.stockalert;
+
+import java.util.ArrayList;
+import java.util.List;
+import javax.inject.Inject;
+import javax.validation.Valid;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.stockalert.StockAlertService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.core.model.stockalert.StockAlert;
+import com.salesmanager.core.model.stockalert.StockAlertOutboxMessage;
+import com.salesmanager.core.model.stockalert.StockAlertStatus;
+import com.salesmanager.shop.model.stockalert.StockAlertOutboxResponse;
+import com.salesmanager.shop.model.stockalert.StockAlertRequest;
+import com.salesmanager.shop.model.stockalert.StockAlertResponse;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class StockAlertApi {
+    @Inject private StockAlertService stockAlertService;
+    @Inject private ProductService productService;
+
+    @PostMapping("/products/{sku}/alerts")
+    @ResponseStatus(HttpStatus.CREATED)
+    public StockAlertResponse create(@PathVariable String sku, @Valid @RequestBody StockAlertRequest request,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language) {
+        Product product = product(sku, store, language);
+        return alert(stockAlertService.createOrGetPending(store, product, request.getEmail()));
+    }
+
+    @DeleteMapping("/products/{sku}/alerts")
+    @ResponseStatus(HttpStatus.NO_CONTENT)
+    public void cancel(@PathVariable String sku, @RequestParam String email,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language) {
+        stockAlertService.cancel(store, product(sku, store, language), email);
+    }
+
+    @GetMapping("/private/stock-alerts")
+    public List<StockAlertResponse> list(@RequestParam(required = false) String status,
+            @ApiIgnore MerchantStore store) {
+        StockAlertStatus filter = null;
+        if (status != null) {
+            try { filter = StockAlertStatus.valueOf(status.toUpperCase()); }
+            catch (IllegalArgumentException e) { throw new RestApiException("Invalid alert status"); }
+        }
+        List<StockAlertResponse> result = new ArrayList<>();
+        for (StockAlert a : stockAlertService.listAlerts(store))
+            if (filter == null || filter == a.getStatus()) result.add(alert(a));
+        return result;
+    }
+
+    @GetMapping("/private/stock-alerts/outbox")
+    public List<StockAlertOutboxResponse> outbox(@ApiIgnore MerchantStore store) {
+        List<StockAlertOutboxResponse> result = new ArrayList<>();
+        for (StockAlertOutboxMessage m : stockAlertService.listOutbox(store)) {
+            StockAlertOutboxResponse r = new StockAlertOutboxResponse();
+            r.setTo(m.getRecipient()); r.setSku(m.getAlert().getSku()); r.setSubject(m.getSubject());
+            if (m.getCreatedAt() != null) r.setCreatedAt(m.getCreatedAt().toInstant());
+            result.add(r);
+        }
+        return result;
+    }
+
+    private Product product(String sku, MerchantStore store, Language language) {
+        try {
+            Product p = productService.getBySku(sku, store, language);
+            if (p == null) throw new ResourceNotFoundException("404", "Unknown product sku " + sku);
+            return p;
+        } catch (ResourceNotFoundException e) { throw e; }
+        catch (Exception e) { throw new ResourceNotFoundException("404", "Unknown product sku " + sku); }
+    }
+
+    private StockAlertResponse alert(StockAlert a) {
+        StockAlertResponse r = new StockAlertResponse();
+        r.setId(a.getId()); r.setSku(a.getSku()); r.setEmail(a.getEmail());
+        r.setStatus(a.getStatus() == null ? null : a.getStatus().name());
+        if (a.getCreatedAt() != null) r.setCreatedAt(a.getCreatedAt().toInstant());
+        if (a.getSentAt() != null) r.setSentAt(a.getSentAt().toInstant());
+        return r;
+    }
+}
