+package com.salesmanager.core.business.services.stockalert;
+
+import java.util.*;
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.stockalert.*;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.stockalert.*;
+
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+    private final StockAlertRepository alerts;
+    private final StockAlertOutboxRepository outbox;
+    @Inject public StockAlertServiceImpl(StockAlertRepository alerts, StockAlertOutboxRepository outbox) { this.alerts = alerts; this.outbox = outbox; }
+
+    @Override @Transactional
+    public StockAlert createOrGetPending(MerchantStore store, Product product, String email) {
+        if (store == null || product == null || product.getMerchantStore() == null || !Objects.equals(store.getId(), product.getMerchantStore().getId())) throw new IllegalArgumentException("Product does not belong to store");
+        if (email == null || !email.matches("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$")) throw new IllegalArgumentException("Invalid email");
+        int quantity = 0;
+        if (product.getAvailabilities() != null) for (com.salesmanager.core.model.catalog.product.availability.ProductAvailability a : product.getAvailabilities()) if (a.getProductQuantity() != null) quantity += a.getProductQuantity();
+        if (quantity > 0) throw new StockAlertConflictException("Product is in stock");
+        String normalized = email.trim().toLowerCase(Locale.ROOT);
+        StockAlert existing = alerts.findByProductAndMerchantStoreAndEmailIgnoreCaseAndStatus(product, store, normalized, StockAlertStatus.PENDING);
+        if (existing != null) return existing;
+        StockAlert alert = new StockAlert(); alert.setProduct(product); alert.setMerchantStore(store); alert.setSku(product.getSku()); alert.setEmail(normalized); alert.setCreatedAt(new Date()); alert.setStatus(StockAlertStatus.PENDING);
+        return alerts.save(alert);
+    }
+    @Override @Transactional public void cancel(MerchantStore store, Long id) {
+        StockAlert a = alerts.findById(id).orElse(null);
+        if (a == null || a.getMerchantStore() == null || !Objects.equals(a.getMerchantStore().getId(), store.getId()) || a.getStatus() != StockAlertStatus.PENDING) throw new NoSuchStockAlertException();
+        alerts.delete(a);
+    }
+    @Override @Transactional public void cancel(MerchantStore store, Product p, String email) {
+        StockAlert a = alerts.findByProductAndMerchantStoreAndEmailIgnoreCaseAndStatus(p, store, email, StockAlertStatus.PENDING);
+        if (a == null) throw new NoSuchStockAlertException(); cancel(store, a.getId());
+    }
+    @Override public List<StockAlert> listAlerts(MerchantStore store) { return alerts.findByMerchantStoreOrderByCreatedAtAsc(store); }
+    @Override public List<StockAlertOutboxMessage> listOutbox(MerchantStore store) { return outbox.findByMerchantStoreOrderByCreatedAtAsc(store); }
+    @Override @Transactional public void onInventoryQuantityChanged(Product product, int oldQuantity, int newQuantity) {
+        if (product == null || oldQuantity != 0 || newQuantity <= 0) return;
+        MerchantStore store = product.getMerchantStore();
+        for (StockAlert a : alerts.findByProductAndMerchantStoreAndStatusOrderByCreatedAtAsc(product, store, StockAlertStatus.PENDING)) {
+            String productName = product.getProductDescription() == null ? product.getSku() : product.getProductDescription().getName();
+            a.setStatus(StockAlertStatus.SENT); a.setSentAt(new Date()); alerts.save(a);
+            StockAlertOutboxMessage m = new StockAlertOutboxMessage(); m.setMerchantStore(store); m.setAlert(a); m.setRecipient(a.getEmail()); m.setSubject(productName + " is back in stock"); m.setCreatedAt(new Date()); outbox.save(m);
+        }
+    }
+    @Override @Transactional public void deleteForProduct(Product product) { outbox.deleteByAlertProduct(product); alerts.deleteByProduct(product); }
+}
