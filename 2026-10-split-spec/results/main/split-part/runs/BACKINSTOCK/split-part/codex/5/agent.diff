+ public String getSku(){return productSku;} public String getEmail(){return email;} public void setEmail(String e){email=e;}
+ public StockAlertStatus getStatus(){return status;} public void setStatus(StockAlertStatus s){status=s;}
+ public Date getCreatedAt(){return createdAt;} public void setCreatedAt(Date d){createdAt=d;}
+ public Date getSentAt(){return sentAt;} public void setSentAt(Date d){sentAt=d;}
+}
