+package com.salesmanager.shop.store.api.v1.stockalert;
+
+import java.util.List;
+
+import javax.validation.Valid;
+
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.ExceptionHandler;
+import org.springframework.web.server.ResponseStatusException;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.stockalert.StockAlertOutboxResponse;
+import com.salesmanager.shop.model.stockalert.StockAlertRequest;
+import com.salesmanager.shop.model.stockalert.StockAlertResponse;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.controller.stockalert.facade.StockAlertFacade;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+public class StockAlertApi {
+    @Autowired
+    private StockAlertFacade stockAlertFacade;
+
+    @ExceptionHandler(ResponseStatusException.class)
+    public ResponseEntity<Void> handleStatus(ResponseStatusException ex) {
+        return ResponseEntity.status(ex.getStatus()).build();
+    }
+
+    @PostMapping("/api/v1/products/{sku}/alerts")
+    public ResponseEntity<StockAlertResponse> subscribe(@PathVariable String sku, @Valid @RequestBody StockAlertRequest request,
+            @ApiIgnore MerchantStore merchantStore) {
+        if (request == null || StringUtils.isBlank(request.getEmail())) {
+            throw new RestApiException("400", "A valid email is required");
+        }
+        StockAlertResponse response = stockAlertFacade.subscribe(sku, request.getEmail(), merchantStore);
+        return ResponseEntity.status(response.isNewlyCreated() ? HttpStatus.CREATED : HttpStatus.OK).body(response);
+    }
+
+    @DeleteMapping("/api/v1/products/{sku}/alerts")
+    @ResponseStatus(HttpStatus.NO_CONTENT)
+    public void cancel(@PathVariable String sku, @RequestParam String email,
+            @ApiIgnore MerchantStore merchantStore) {
+        if (StringUtils.isBlank(email)) {
+            throw new RestApiException("400", "A valid email is required");
+        }
+        stockAlertFacade.cancel(sku, email, merchantStore);
+    }
+
+    @GetMapping("/api/v1/private/stock-alerts")
+    public List<StockAlertResponse> list(@RequestParam(required = false) String status,
+            @ApiIgnore MerchantStore merchantStore) {
+        if (status != null && !"PENDING".equalsIgnoreCase(status) && !"SENT".equalsIgnoreCase(status)) {
+            throw new RestApiException("400", "Invalid stock alert status");
+        }
+        return stockAlertFacade.list(merchantStore, status == null ? null : status.toUpperCase());
+    }
+
+    @GetMapping("/api/v1/private/stock-alerts/outbox")
+    public List<StockAlertOutboxResponse> outbox(@ApiIgnore MerchantStore merchantStore) {
+        return stockAlertFacade.outbox(merchantStore);
+    }
+}
