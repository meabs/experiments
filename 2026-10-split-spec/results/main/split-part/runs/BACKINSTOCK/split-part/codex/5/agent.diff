+package com.salesmanager.shop.store.controller.stockalert.facade;
+
+import java.util.List;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+import org.springframework.web.server.ResponseStatusException;
+import org.springframework.http.HttpStatus;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.stockalert.StockAlertService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.stockalert.StockAlert;
+import com.salesmanager.core.model.stockalert.StockAlertOutbox;
+import com.salesmanager.core.model.stockalert.StockAlertStatus;
+import com.salesmanager.shop.model.stockalert.StockAlertOutboxResponse;
+import com.salesmanager.shop.model.stockalert.StockAlertResponse;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+
+/** Maps the core stock-alert service model to the HTTP DTOs. */
+@Service
+public class StockAlertFacadeImpl implements StockAlertFacade {
+    @Inject private StockAlertService service;
+    @Inject private ProductService productService;
+
+    @Override
+    public StockAlertResponse subscribe(String sku, String email, MerchantStore store) {
+        Product product;
+        try { product = productService.getBySku(sku, store); }
+        catch (Exception e) { throw new ResourceNotFoundException("Product not found: " + sku); }
+        if (product == null) throw new ResourceNotFoundException("Product not found: " + sku);
+        List<StockAlert> pending = service.list(store, sku, email, StockAlertStatus.PENDING);
+        boolean alreadyPending = pending != null && !pending.isEmpty();
+        StockAlert alert;
+        try {
+            alert = service.createOrGetPending(product, store, email);
+        } catch (IllegalArgumentException e) {
+            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "Invalid email", e);
+        } catch (IllegalStateException e) {
+            throw new ResponseStatusException(HttpStatus.CONFLICT, "Product is in stock", e);
+        }
+        StockAlertResponse response = map(alert);
+        // The service returns the existing object for an idempotent request.  Its
+        // created timestamp is still useful to callers, while this flag lets the
+        // resource select the required 200/201 status without exposing metadata.
+        response.setNewlyCreated(!alreadyPending);
+        return response;
+    }
+
+    @Override
+    public void cancel(String sku, String email, MerchantStore store) {
+        List<StockAlert> matches = service.list(store, sku, email, StockAlertStatus.PENDING);
+        if (matches == null || matches.isEmpty()) throw new ResourceNotFoundException("Alert not found");
+        try {
+            service.cancelPending(matches.get(0).getId(), store);
+        } catch (RuntimeException e) {
+            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Alert not found", e);
+        }
+    }
+
+    @Override
+    public List<StockAlertResponse> list(MerchantStore store, String status) {
+        StockAlertStatus filter = status == null ? null : StockAlertStatus.valueOf(status);
+        return service.list(store, null, null, filter).stream().map(this::map).collect(Collectors.toList());
+    }
+
+    @Override
+    public List<StockAlertOutboxResponse> outbox(MerchantStore store) {
+        return service.listOutbox(store, null, null).stream().map(this::map).collect(Collectors.toList());
+    }
+
+    private StockAlertResponse map(StockAlert a) {
+        StockAlertResponse r = new StockAlertResponse();
+        r.setId(a.getId()); r.setSku(a.getProductSku()); r.setEmail(a.getEmail());
+        r.setStatus(a.getStatus() == null ? null : a.getStatus().name());
+        r.setCreatedAt(a.getCreatedAt()); r.setSentAt(a.getSentAt());
+        return r;
+    }
+
+    private StockAlertOutboxResponse map(StockAlertOutbox o) {
+        StockAlertOutboxResponse r = new StockAlertOutboxResponse();
+        r.setTo(o.getEmail()); r.setSku(o.getProductSku()); r.setSubject(o.getMessage());
+        r.setCreatedAt(o.getCreatedAt());
+        return r;
+    }
+}
