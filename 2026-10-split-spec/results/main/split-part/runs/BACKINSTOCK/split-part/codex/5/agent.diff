+package com.salesmanager.core.business.services.stockalert;
+import java.util.*;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.stockalert.*;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.stockalert.*;
+
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+ private final StockAlertRepository alerts; private final StockAlertOutboxRepository outbox;
+ public StockAlertServiceImpl(StockAlertRepository a, StockAlertOutboxRepository o){alerts=a;outbox=o;}
+ @Transactional public StockAlert createOrGetPending(Product p, MerchantStore s, String email){
+  if(p==null||s==null) throw new StockAlertBadRequestException("Product and store are required");
+  if(email==null||!email.matches("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$")) throw new StockAlertBadRequestException("Invalid email");
+  boolean inStock=false; for(ProductAvailability a:p.getAvailabilities()) if(a.getMerchantStore()!=null&&Objects.equals(a.getMerchantStore().getId(),s.getId())) if(a.getProductQuantity()!=null&&a.getProductQuantity()>0){inStock=true;break;}
+  if(inStock) throw new StockAlertConflictException("Product is in stock");
+  StockAlert existing=alerts.findPending(p.getId(),s.getId(),email); if(existing!=null)return existing;
+  StockAlert a=new StockAlert(); a.setProduct(p);a.setMerchantStore(s);a.setProductSku(p.getSku());a.setEmail(email.trim());a.setStatus(StockAlertStatus.PENDING); return alerts.save(a);
+ }
+ @Transactional public void cancelPending(Long id, MerchantStore s){ StockAlert a=alerts.findById(id).orElse(null); if(a==null||a.getStatus()!=StockAlertStatus.PENDING||s==null||!Objects.equals(a.getMerchantStore().getId(),s.getId())) throw new NoSuchElementException("Alert not found"); alerts.delete(a); }
+ public List<StockAlert> list(MerchantStore s,String sku,String email,StockAlertStatus status){return s==null?Collections.emptyList():alerts.search(s.getId(),sku,email,status);}
+ public List<StockAlertOutbox> listOutbox(MerchantStore s,String sku,String email){return s==null?Collections.emptyList():outbox.search(s.getId(),sku,email);}
+ @Transactional public void onStockUpdated(Product p, MerchantStore s,int oldQ,int newQ){if(p==null||s==null||oldQ!=0||newQ<=0)return; for(StockAlert a:alerts.findPendingByProduct(p.getId())) if(Objects.equals(a.getMerchantStore().getId(),s.getId())){a.setStatus(StockAlertStatus.SENT);a.setSentAt(new Date());alerts.save(a);StockAlertOutbox o=new StockAlertOutbox();o.setMerchantStore(s);o.setProductSku(a.getProductSku());o.setEmail(a.getEmail());o.setMessage(productName(p)+" is back in stock");outbox.save(o);}}
+ private String productName(Product p){ if(p.getDescriptions()!=null) for(com.salesmanager.core.model.catalog.product.description.ProductDescription d:p.getDescriptions()) if(d.getName()!=null&&!d.getName().trim().isEmpty()) return d.getName(); return p.getSku(); }
+}
