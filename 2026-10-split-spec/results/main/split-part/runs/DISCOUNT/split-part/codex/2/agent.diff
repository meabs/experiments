+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.discount.DiscountService;
+import com.salesmanager.core.business.services.discount.DiscountValidationException;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.discount.PersistableDiscount;
+import com.salesmanager.shop.model.discount.ReadableDiscount;
+
+import io.swagger.annotations.Api;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Protected administration endpoints for store-scoped discount codes. */
+@RestController
+@RequestMapping("/api/v1/private/discounts")
+@Api(tags = { "Discount code management" })
+public class DiscountApi {
+
+    @Inject
+    private DiscountService discountService;
+
+    @PostMapping
+    @ResponseStatus(HttpStatus.CREATED)
+    public ReadableDiscount create(@RequestBody PersistableDiscount request,
+            @ApiIgnore MerchantStore merchantStore) throws Exception {
+        Discount discount = toEntity(request, null);
+        discountService.create(merchantStore, discount);
+        return fromEntity(discount);
+    }
+
+    @GetMapping
+    public List<ReadableDiscount> list(@ApiIgnore MerchantStore merchantStore) {
+        return discountService.listByStore(merchantStore).stream().map(DiscountApi::fromEntity)
+                .collect(Collectors.toList());
+    }
+
+    @PutMapping("/{id}")
+    public ReadableDiscount update(@PathVariable Long id, @RequestBody PersistableDiscount request,
+            @ApiIgnore MerchantStore merchantStore) throws Exception {
+        Discount discount = toEntity(request, id);
+        discountService.update(merchantStore, discount);
+        return fromEntity(discount);
+    }
+
+    @DeleteMapping("/{id}")
+    @ResponseStatus(HttpStatus.NO_CONTENT)
+    public void delete(@PathVariable Long id, @ApiIgnore MerchantStore merchantStore) throws Exception {
+        discountService.delete(merchantStore, id);
+    }
+
+    private static Discount toEntity(PersistableDiscount source, Long id) {
+        if (source == null) throw new DiscountValidationException("Request body is required");
+        Discount target = new Discount();
+        target.setId(id);
+        target.setCode(source.getCode());
+        target.setValue(source.getValue());
+        if (source.getType() == null) throw new DiscountValidationException("type is required");
+        try {
+            target.setType(DiscountType.valueOf(source.getType().trim().toUpperCase()));
+        } catch (IllegalArgumentException ex) {
+            throw new DiscountValidationException("Unknown discount type: " + source.getType());
+        }
+        target.setMinimumSubtotal(source.getMinimumSubtotal());
+        target.setStartDate(toDate(source.getStartDate()));
+        target.setEndDate(toDate(source.getEndDate()));
+        target.setActive(source.getActive() == null || source.getActive());
+        Set<String> categories = source.getCategories() == null ? null
+                : source.getCategories().stream().collect(Collectors.toSet());
+        target.setCategoryCodes(categories);
+        return target;
+    }
+
+    private static ReadableDiscount fromEntity(Discount source) {
+        ReadableDiscount target = new ReadableDiscount();
+        target.setId(source.getId());
+        target.setCode(source.getCode());
+        target.setType(source.getType() == null ? null : source.getType().name());
+        target.setValue(source.getValue());
+        target.setMinimumSubtotal(source.getMinimumSubtotal());
+        target.setStartDate(toLocalDate(source.getStartDate()));
+        target.setEndDate(toLocalDate(source.getEndDate()));
+        target.setActive(source.isActive());
+        Set<String> codes = source.getCategoryCodes();
+        if (codes == null || codes.isEmpty()) {
+            codes = source.getCategories() == null ? null : source.getCategories().stream()
+                    .map(Category::getCode).collect(Collectors.toSet());
+        }
+        target.setCategories(codes == null ? new ArrayList<String>() : new ArrayList<String>(codes));
+        return target;
+    }
+
+    private static Date toDate(LocalDate date) {
+        return date == null ? null : Date.from(date.atStartOfDay(ZoneId.systemDefault()).toInstant());
+    }
+
+    private static LocalDate toLocalDate(Date date) {
+        return date == null ? null : date.toInstant().atZone(ZoneId.systemDefault()).toLocalDate();
+    }
+}
