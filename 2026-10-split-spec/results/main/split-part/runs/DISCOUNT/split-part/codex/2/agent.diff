diff --git a/sm-core/src/main/java/com/salesmanager/core/business/services/discount/DiscountServiceImpl.java b/sm-core/src/main/java/com/salesmanager/core/business/services/discount/DiscountServiceImpl.java
new file mode 100644
index 0000000..7c9583b
--- /dev/null
+++ b/sm-core/src/main/java/com/salesmanager/core/business/services/discount/DiscountServiceImpl.java
@@ -0,0 +1,41 @@
+package com.salesmanager.core.business.services.discount;
+
+import java.math.*; import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.business.repositories.discount.DiscountRepository; import com.salesmanager.core.business.repositories.catalog.category.CategoryRepository; import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl; import com.salesmanager.core.model.catalog.category.Category; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.discount.*; import com.salesmanager.core.model.shoppingcart.*;
+
+@Service("discountService")
+public class DiscountServiceImpl extends SalesManagerEntityServiceImpl<Long,Discount> implements DiscountService {
+  private final DiscountRepository repository; private final CategoryRepository categoryRepository;
+  @Inject public DiscountServiceImpl(DiscountRepository r, CategoryRepository c){super(r);repository=r;categoryRepository=c;}
+  public void create(MerchantStore store, Discount d) throws ServiceException { validate(store,d); d.setMerchantStore(store); resolveCategories(store,d); super.create(d); }
+  public void update(MerchantStore store, Discount d) throws ServiceException {
+    if (d == null || d.getId() == null) throw new DiscountValidationException("Discount id is required");
+    Discount existing = repository.findById(d.getId()).orElse(null);
+    if (existing == null || !sameStore(store, existing.getMerchantStore())) {
+      throw new DiscountValidationException("Discount does not belong to store");
+    }
+    validate(store,d); d.setMerchantStore(store); resolveCategories(store,d); super.update(d);
+  }
+  public void delete(MerchantStore store, Long id) throws ServiceException { Discount d=repository.findById(id).orElse(null); if(d!=null && sameStore(store,d.getMerchantStore())) super.delete(d); }
+  public List<Discount> listByStore(MerchantStore s){return repository.findByMerchantStoreIdOrderByCode(s.getId());}
+  public Discount findByCode(MerchantStore s,String code){return code==null?null:repository.findByMerchantStoreIdAndCodeNormalized(s.getId(),code.trim().toLowerCase(Locale.ROOT));}
+  private boolean sameStore(MerchantStore a,MerchantStore b){return a!=null&&b!=null&&Objects.equals(a.getId(),b.getId());}
+  private void validate(MerchantStore s,Discount d){
+    if(s==null||d==null||d.getCode()==null||d.getCode().trim().isEmpty()||d.getValue()==null||d.getType()==null) throw new DiscountValidationException("code, type and value are required");
+    String n=d.getCode().trim().toLowerCase(Locale.ROOT); boolean conflict=d.getId()==null?repository.existsByMerchantStoreIdAndCodeNormalized(s.getId(),n):repository.existsByMerchantStoreIdAndCodeNormalizedAndIdNot(s.getId(),n,d.getId()); if(conflict) throw new DiscountConflictException("Discount code already exists");
+    if(d.getValue().signum()<=0 || (d.getType()==DiscountType.PERCENT&&d.getValue().compareTo(BigDecimal.valueOf(100))>0)) throw new DiscountValidationException("Invalid discount value");
+    if(d.getStartDate()==null)d.setStartDate(new Date()); if(d.getEndDate()!=null&&date(d.getEndDate()).before(date(d.getStartDate()))) throw new DiscountValidationException("endDate must not precede startDate");
+    if(d.getMinimumSubtotal()!=null&&d.getMinimumSubtotal().signum()<0) throw new DiscountValidationException("minimumSubtotal must not be negative"); d.setCode(d.getCode().trim());
+  }
+  private Date date(Date x){Calendar c=Calendar.getInstance();c.setTime(x);c.set(Calendar.HOUR_OF_DAY,0);c.set(Calendar.MINUTE,0);c.set(Calendar.SECOND,0);c.set(Calendar.MILLISECOND,0);return c.getTime();}
+  private void resolveCategories(MerchantStore s,Discount d){Set<String> codes=d.getCategoryCodes(); if(codes==null||codes.isEmpty())return; Set<Category> cats=new HashSet<>(); for(String code:codes){Category c=categoryRepository.findByCode(s.getId(),code);if(c==null)throw new DiscountValidationException("Unknown category: "+code);cats.add(c);}d.setCategories(cats);}
+  public DiscountCalculation calculate(MerchantStore s,String code,ShoppingCart cart){Discount d=findByCode(s,code);return d==null?new DiscountCalculation(false,BigDecimal.ZERO,BigDecimal.ZERO):calculate(d,cart);}
+  public DiscountCalculation calculate(Discount d,ShoppingCart cart){
+    if(d==null||cart==null||!sameStore(d.getMerchantStore(),cart.getMerchantStore())||!d.isActive())return no(); Date today=date(new Date()); if(today.before(date(d.getStartDate()))||(d.getEndDate()!=null&&today.after(date(d.getEndDate()))))return no();
+    BigDecimal subtotal=BigDecimal.ZERO,eligible=BigDecimal.ZERO; for(ShoppingCartItem i:cart.getLineItems()){BigDecimal amount=i.getSubTotal();if(amount==null&&i.getItemPrice()!=null)amount=i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity()==null?1:i.getQuantity()));if(amount==null)continue;subtotal=subtotal.add(amount);if(eligible(i.getProduct(),d.getCategories()))eligible=eligible.add(amount);}
+    if(d.getMinimumSubtotal()!=null&&subtotal.compareTo(d.getMinimumSubtotal())<0||eligible.signum()<=0)return new DiscountCalculation(false,BigDecimal.ZERO,eligible);
+    BigDecimal amount=d.getType()==DiscountType.PERCENT?eligible.multiply(d.getValue()).divide(BigDecimal.valueOf(100),8,RoundingMode.HALF_UP):d.getValue(); if(amount.compareTo(eligible)>0)amount=eligible; return new DiscountCalculation(true,amount.setScale(2,RoundingMode.HALF_UP),eligible);
+  }
+  private DiscountCalculation no(){return new DiscountCalculation(false,BigDecimal.ZERO,BigDecimal.ZERO);}
+  private boolean eligible(Product p,Set<Category> roots){if(roots==null||roots.isEmpty())return true;if(p==null||p.getCategories()==null)return false;for(Category pc:p.getCategories())for(Category r:roots){if(Objects.equals(pc.getId(),r.getId())|| (pc.getLineage()!=null&&r.getId()!=null&&pc.getLineage().contains("/"+r.getId()+"/")))return true;}return false;}
+}
