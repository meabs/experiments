+package com.salesmanager.shop.store.api.v1.discount;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.ExceptionHandler;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.business.services.discount.DiscountCodeService;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.discount.DiscountCode;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.discount.PersistableDiscountCode;
+import com.salesmanager.shop.model.discount.ReadableDiscountCode;
+
+import io.swagger.annotations.Api;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+@Api(tags = { "Discount code management" })
+public class DiscountCodeApi {
+    @Inject private DiscountCodeService discountCodeService;
+    @Inject private CategoryService categoryService;
+
+    @PostMapping("/private/discounts")
+    public ResponseEntity<ReadableDiscountCode> create(@ApiIgnore MerchantStore store,
+            @RequestBody PersistableDiscountCode request) {
+        DiscountCode code = toEntity(request, store);
+        code.setId(null);
+        discountCodeService.validateCandidate(code, store);
+        ReadableDiscountCode result = toModel(discountCodeService.save(code, store));
+        return new ResponseEntity<ReadableDiscountCode>(result, HttpStatus.CREATED);
+    }
+
+    @GetMapping("/private/discounts")
+    public List<ReadableDiscountCode> list(@ApiIgnore MerchantStore store) {
+        return discountCodeService.findByStore(store).stream().map(this::toModel).collect(Collectors.toList());
+    }
+
+    @PutMapping("/private/discounts/{id}")
+    public ReadableDiscountCode update(@PathVariable Long id, @ApiIgnore MerchantStore store,
+            @RequestBody PersistableDiscountCode request) {
+        DiscountCode code = toEntity(request, store);
+        code.setId(id);
+        discountCodeService.validateCandidate(code, store);
+        // save() is intentionally used after validation; the service enforces store ownership.
+        DiscountCode existing = discountCodeService.findByStore(store).stream()
+                .filter(item -> id.equals(item.getId())).findFirst().orElseThrow(NotFoundException::new);
+        code.setMerchantStore(existing.getMerchantStore());
+        return toModel(discountCodeService.save(code, store));
+    }
+
+    @DeleteMapping("/private/discounts/{id}")
+    public ResponseEntity<Void> delete(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        boolean exists = discountCodeService.findByStore(store).stream().anyMatch(item -> id.equals(item.getId()));
+        if (!exists) throw new NotFoundException();
+        discountCodeService.deleteByIdAndStore(id, store);
+        return ResponseEntity.noContent().build();
+    }
+
+    private DiscountCode toEntity(PersistableDiscountCode request, MerchantStore store) {
+        if (request == null) throw new IllegalArgumentException("request is required");
+        DiscountCode result = new DiscountCode();
+        result.setCode(request.getCode()); result.setType(request.getType()); result.setValue(request.getValue());
+        result.setMinimumSubtotal(request.getMinimumSubtotal()); result.setStartDate(request.getStartDate());
+        result.setEndDate(request.getEndDate()); result.setActive(request.isActive()); result.setMerchantStore(store);
+        List<Category> categories = new ArrayList<Category>();
+        if (request.getCategories() != null) for (String categoryCode : request.getCategories()) {
+            if (categoryCode == null || categoryCode.trim().isEmpty()) throw new IllegalArgumentException("unknown category");
+            try { Category category = categoryService.getByCode(store, categoryCode.trim());
+                if (category == null) throw new IllegalArgumentException("unknown category");
+                categories.add(category);
+            } catch (Exception ex) { throw new IllegalArgumentException("unknown category", ex); }
+        }
+        result.setCategories(categories);
+        return result;
+    }
+
+    private ReadableDiscountCode toModel(DiscountCode source) {
+        ReadableDiscountCode result = new ReadableDiscountCode();
+        result.setId(source.getId()); result.setCode(source.getCode()); result.setType(source.getType());
+        result.setValue(source.getValue()); result.setMinimumSubtotal(source.getMinimumSubtotal());
+        result.setStartDate(source.getStartDate()); result.setEndDate(source.getEndDate()); result.setActive(source.isActive());
+        result.setCategories(source.getCategories() == null ? new ArrayList<String>() : source.getCategories().stream().map(Category::getCode).collect(Collectors.toList()));
+        return result;
+    }
+
+    @ExceptionHandler(NotFoundException.class)
+    public ResponseEntity<Void> notFound() { return ResponseEntity.notFound().build(); }
+
+    @ExceptionHandler(IllegalStateException.class)
+    public ResponseEntity<Void> conflict() { return ResponseEntity.status(HttpStatus.CONFLICT).build(); }
+
+    @ExceptionHandler(IllegalArgumentException.class)
+    public ResponseEntity<Void> badRequest() { return ResponseEntity.badRequest().build(); }
+
+    private static class NotFoundException extends RuntimeException { private static final long serialVersionUID = 1L; }
+}
