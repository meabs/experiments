+package com.salesmanager.core.business.services.discount;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDate;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+import java.util.Objects;
+import java.util.Set;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.discount.DiscountCodeRepository;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.discount.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service("discountCodeService")
+public class DiscountCodeServiceImpl implements DiscountCodeService {
+    private final DiscountCodeRepository repository;
+    @Inject public DiscountCodeServiceImpl(DiscountCodeRepository repository) { this.repository = repository; }
+
+    @Override public DiscountCode findByStoreAndCode(MerchantStore store, String code) { return findByStoreAndCodeIgnoreCase(store, code); }
+    @Override public DiscountCode findByStoreAndCodeIgnoreCase(MerchantStore store, String code) {
+        return store == null || store.getId() == null || code == null ? null : repository.findByStoreAndCodeIgnoreCase(store.getId(), code.trim());
+    }
+    @Override public List<DiscountCode> findByStore(MerchantStore store) { return store == null ? Collections.emptyList() : repository.findByStore(store.getId()); }
+
+    @Override public void validateCandidate(DiscountCode discount, MerchantStore store) {
+        if (discount == null || store == null) throw new IllegalArgumentException("discount and store are required");
+        if (discount.getCode() == null || discount.getCode().trim().isEmpty()) throw new IllegalArgumentException("code is required");
+        if (discount.getType() == null) throw new IllegalArgumentException("type is required");
+        if (discount.getValue() == null || discount.getValue().compareTo(BigDecimal.ZERO) <= 0) throw new IllegalArgumentException("value must be positive");
+        if (discount.getType() == DiscountType.PERCENT && discount.getValue().compareTo(BigDecimal.valueOf(100)) > 0) throw new IllegalArgumentException("percent must not exceed 100");
+        if (discount.getStartDate() == null) discount.setStartDate(LocalDate.now());
+        if (discount.getMinimumSubtotal() == null) discount.setMinimumSubtotal(BigDecimal.ZERO);
+        if (discount.getMinimumSubtotal().compareTo(BigDecimal.ZERO) < 0) throw new IllegalArgumentException("minimum subtotal cannot be negative");
+        if (discount.getEndDate() != null && discount.getEndDate().isBefore(discount.getStartDate())) throw new IllegalArgumentException("end date precedes start date");
+        DiscountCode existing = findByStoreAndCodeIgnoreCase(store, discount.getCode());
+        if (existing != null && !Objects.equals(existing.getId(), discount.getId())) throw new IllegalStateException("discount code already exists");
+        for (Category category : discount.getCategories()) if (category == null || category.getMerchantStore() == null || !Objects.equals(category.getMerchantStore().getId(), store.getId())) throw new IllegalArgumentException("unknown category");
+    }
+    @Override public void validate(DiscountCode discount, MerchantStore store) { validateCandidate(discount, store); }
+    @Override public DiscountCode save(DiscountCode discount, MerchantStore store) { validateCandidate(discount, store); discount.setMerchantStore(store); discount.setCode(discount.getCode().trim()); return repository.save(discount); }
+    @Override public void deleteByIdAndStore(Long id, MerchantStore store) { if (id != null && store != null) { DiscountCode d = repository.findByIdAndStore(id, store.getId()); if (d != null) repository.delete(d); } }
+
+    @Override public DiscountEvaluation evaluate(String code, ShoppingCart cart) { return evaluate(cart == null ? null : findByStoreAndCodeIgnoreCase(cart.getMerchantStore(), code), cart); }
+    @Override public DiscountEvaluation evaluate(DiscountCode discount, ShoppingCart cart) {
+        if (discount == null || cart == null) return DiscountEvaluation.notApplicable("code not found");
+        MerchantStore cartStore = cart.getMerchantStore();
+        if (cartStore == null || discount.getMerchantStore() == null || !Objects.equals(cartStore.getId(), discount.getMerchantStore().getId())) return DiscountEvaluation.notApplicable("store mismatch");
+        LocalDate today = LocalDate.now();
+        if (!discount.isActive()) return DiscountEvaluation.notApplicable("inactive");
+        if (discount.getStartDate() != null && today.isBefore(discount.getStartDate())) return DiscountEvaluation.notApplicable("not started");
+        if (discount.getEndDate() != null && today.isAfter(discount.getEndDate())) return DiscountEvaluation.notApplicable("expired");
+        BigDecimal minimum = discount.getMinimumSubtotal() == null ? BigDecimal.ZERO : discount.getMinimumSubtotal();
+        BigDecimal subtotal = cartSubtotal(cart);
+        if (subtotal.compareTo(minimum) < 0) return DiscountEvaluation.notApplicable("minimum subtotal not met");
+        Set<Category> allowed = discount.getCategories() == null ? Collections.emptySet() : discount.getCategories().stream().filter(Objects::nonNull).collect(Collectors.toSet());
+        BigDecimal eligible = BigDecimal.ZERO;
+        for (ShoppingCartItem item : cart.getLineItems() == null ? Collections.<ShoppingCartItem>emptySet() : cart.getLineItems()) {
+            if (item == null || item.isObsolete() || (item.getProduct() == null && item.getSubTotal() == null)) continue;
+            if (allowed.isEmpty() || eligibleCategory(item, allowed)) eligible = eligible.add(itemSubtotal(item));
+        }
+        if (eligible.signum() <= 0) return DiscountEvaluation.notApplicable("no eligible items");
+        BigDecimal amount = discount.getType() == DiscountType.PERCENT ? eligible.multiply(discount.getValue()).divide(BigDecimal.valueOf(100), 2, RoundingMode.HALF_UP) : discount.getValue().min(eligible);
+        return new DiscountEvaluation(true, amount.setScale(2, RoundingMode.HALF_UP), null);
+    }
+    private BigDecimal cartSubtotal(ShoppingCart cart) { BigDecimal total = BigDecimal.ZERO; for (ShoppingCartItem i : cart.getLineItems() == null ? Collections.<ShoppingCartItem>emptySet() : cart.getLineItems()) if (i != null && !i.isObsolete()) total = total.add(itemSubtotal(i)); return total; }
+    private BigDecimal itemSubtotal(ShoppingCartItem item) { if (item.getSubTotal() != null) return item.getSubTotal(); if (item.getItemPrice() != null) return item.getItemPrice().multiply(BigDecimal.valueOf(item.getQuantity() == null ? 1 : item.getQuantity())); return BigDecimal.ZERO; }
+    private boolean eligibleCategory(ShoppingCartItem item, Set<Category> allowed) { if (item.getProduct() == null || item.getProduct().getCategories() == null) return false; for (Category actual : item.getProduct().getCategories()) for (Category wanted : allowed) if (isSameOrDescendant(actual, wanted)) return true; return false; }
+    private boolean isSameOrDescendant(Category actual, Category wanted) {
+        if (actual == null || wanted == null) return false;
+        if (Objects.equals(actual.getId(), wanted.getId()) || Objects.equals(actual.getCode(), wanted.getCode())) return true;
+        String lineage = actual.getLineage();
+        if (lineage == null || wanted.getId() == null) return false;
+        String parentId = String.valueOf(wanted.getId());
+        // Category.lineage is normally slash-delimited (for example /1/2/),
+        // but older data may use an underscore-delimited path.
+        return lineage.equals(parentId)
+                || lineage.contains("/" + parentId + "/")
+                || lineage.startsWith(parentId + "/")
+                || lineage.startsWith(parentId + "_");
+    }
+}
