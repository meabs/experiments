+import java.util.List;
+import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Query;
+import com.salesmanager.core.model.discount.DiscountCode;
+
+public interface DiscountCodeRepository extends JpaRepository<DiscountCode, Long> {
+    @Query("select d from DiscountCode d where d.merchantStore.id = ?1 and lower(d.code) = lower(?2)")
+    DiscountCode findByStoreAndCodeIgnoreCase(Integer storeId, String code);
+    @Query("select d from DiscountCode d where d.merchantStore.id = ?1")
+    List<DiscountCode> findByStore(Integer storeId);
