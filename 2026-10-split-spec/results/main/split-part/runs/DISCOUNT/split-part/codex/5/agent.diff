+package com.salesmanager.shop.store.api.v1.discount;
+
+import java.time.LocalDate;
+import java.time.ZoneId;
+import java.util.Date;
+import java.util.List;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+import org.springframework.web.server.ResponseStatusException;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.discount.DiscountCodeService;
+import com.salesmanager.core.model.discount.DiscountCode;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.discount.DiscountCodeRequest;
+import com.salesmanager.shop.model.discount.DiscountCodeResponse;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/discounts")
+public class DiscountCodeApi {
+    @Inject private DiscountCodeService discountCodeService;
+
+    @PostMapping
+    public ResponseEntity<DiscountCodeResponse> create(@ApiIgnore MerchantStore store,
+            @RequestBody DiscountCodeRequest request) {
+        try { DiscountCode saved = discountCodeService.create(store, toEntity(request, null));
+            return new ResponseEntity<>(fromEntity(saved), HttpStatus.CREATED);
+        } catch (ServiceException e) { throw error(e); }
+    }
+
+    @GetMapping
+    public List<DiscountCodeResponse> list(@ApiIgnore MerchantStore store) {
+        return discountCodeService.listByStore(store).stream().map(this::fromEntity).collect(Collectors.toList());
+    }
+
+    @PutMapping("/{id}")
+    public DiscountCodeResponse update(@ApiIgnore MerchantStore store, @PathVariable Long id,
+            @RequestBody DiscountCodeRequest request) {
+        DiscountCode current = discountCodeService.getById(id);
+        if (current == null || current.getMerchantStore() == null || !current.getMerchantStore().getId().equals(store.getId()))
+            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Discount code not found");
+        try { return fromEntity(discountCodeService.update(store, toEntity(request, id))); }
+        catch (ServiceException e) { throw error(e); }
+    }
+
+    @DeleteMapping("/{id}")
+    @ResponseStatus(HttpStatus.NO_CONTENT)
+    public void delete(@ApiIgnore MerchantStore store, @PathVariable Long id) {
+        DiscountCode current = discountCodeService.getById(id);
+        if (current == null || current.getMerchantStore() == null || !current.getMerchantStore().getId().equals(store.getId()))
+            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Discount code not found");
+        try { discountCodeService.delete(store, id); } catch (ServiceException e) { throw error(e); }
+    }
+
+    private RuntimeException error(ServiceException e) {
+        if (e.getMessage() != null && e.getMessage().toLowerCase().contains("already exists"))
+            return new ResponseStatusException(HttpStatus.CONFLICT, e.getMessage(), e);
+        return new ResponseStatusException(HttpStatus.BAD_REQUEST, e.getMessage(), e);
+    }
+    private DiscountCode toEntity(DiscountCodeRequest r, Long id) {
+        DiscountCode d = new DiscountCode(); d.setId(id); d.setCode(r.getCode()); d.setType(r.getType()); d.setValue(r.getValue());
+        d.setMinimumSubtotal(r.getMinimumSubtotal()); d.setStartDate(date(r.getStartDate())); d.setEndDate(date(r.getEndDate()));
+        d.setCategories(r.getCategories()); d.setActive(r.getActive() == null || r.getActive()); return d;
+    }
+    private DiscountCodeResponse fromEntity(DiscountCode d) {
+        DiscountCodeResponse r = new DiscountCodeResponse(); r.setId(d.getId()); r.setCode(d.getCode()); r.setType(d.getType()); r.setValue(d.getValue());
+        r.setMinimumSubtotal(d.getMinimumSubtotal()); r.setStartDate(local(d.getStartDate())); r.setEndDate(local(d.getEndDate())); r.setCategories(d.getCategories()); r.setActive(d.isActive()); return r;
+    }
+    private Date date(LocalDate d) { return d == null ? null : Date.from(d.atStartOfDay(ZoneId.systemDefault()).toInstant()); }
+    private LocalDate local(Date d) { return d == null ? null : d.toInstant().atZone(ZoneId.systemDefault()).toLocalDate(); }
+}
