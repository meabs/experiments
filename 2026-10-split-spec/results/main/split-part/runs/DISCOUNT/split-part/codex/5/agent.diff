+package com.salesmanager.core.business.services.discount;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.discount.DiscountCodeRepository;
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.discount.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service("discountCodeService")
+public class DiscountCodeServiceImpl extends SalesManagerEntityServiceImpl<Long, DiscountCode> implements DiscountCodeService {
+  private final DiscountCodeRepository repository;
+  private final CategoryService categoryService;
+  @Inject public DiscountCodeServiceImpl(DiscountCodeRepository repository, CategoryService categoryService) { super(repository); this.repository=repository; this.categoryService=categoryService; }
+  public DiscountCode create(MerchantStore store, DiscountCode d) throws ServiceException { d.setMerchantStore(store); validate(store,d); super.create(d); return d; }
+  public DiscountCode update(MerchantStore store, DiscountCode d) throws ServiceException { d.setMerchantStore(store); validate(store,d); super.update(d); return d; }
+  public void delete(MerchantStore store, Long id) throws ServiceException { DiscountCode d=repository.findById(id).orElse(null); if(d!=null && d.getMerchantStore().getId().equals(store.getId())) super.delete(d); }
+  public List<DiscountCode> listByStore(MerchantStore store) { return repository.findByMerchantStoreIdOrderByCodeAsc(store.getId()); }
+  public Optional<DiscountCode> findByStoreAndCodeIgnoreCase(MerchantStore store,String code) { return code==null ? Optional.<DiscountCode>empty() : repository.findByMerchantStoreIdAndCodeIgnoreCase(store.getId(),code); }
+  public void validate(MerchantStore store, DiscountCode d) throws ServiceException {
+    if(store==null || d==null || d.getCode()==null || d.getCode().trim().isEmpty() || d.getType()==null || d.getValue()==null) throw new ServiceException("Missing discount code, type or value");
+    if(d.getType()==DiscountType.PERCENT && (d.getValue().compareTo(BigDecimal.ZERO)<=0 || d.getValue().compareTo(new BigDecimal("100"))>0)) throw new ServiceException("Percent must be greater than zero and at most 100");
+    if(d.getType()==DiscountType.AMOUNT && d.getValue().compareTo(BigDecimal.ZERO)<=0) throw new ServiceException("Amount must be greater than zero");
+    if(d.getMinimumSubtotal()!=null && d.getMinimumSubtotal().compareTo(BigDecimal.ZERO)<0) throw new ServiceException("Minimum subtotal cannot be negative");
+    if(d.getStartDate()==null) d.setStartDate(new Date());
+    if(d.getEndDate()!=null && d.getEndDate().before(d.getStartDate())) throw new ServiceException("End date cannot precede start date");
+    Optional<DiscountCode> existing=findByStoreAndCodeIgnoreCase(store,d.getCode());
+    if(existing.isPresent() && !Objects.equals(existing.get().getId(),d.getId())) throw new ServiceException("Discount code already exists");
+    if(d.getCategories()!=null) for(String code:d.getCategories()) { if(code==null || categoryService.getByCode(store,code)==null) throw new ServiceException("Unknown category: "+code); }
+  }
+  public boolean isEligible(DiscountCode d, BigDecimal subtotal, Collection<String> productCodes) {
+    if(d==null || !d.isActive() || subtotal==null) return false; Date now=new Date();
+    if(d.getStartDate()!=null && now.before(d.getStartDate()) || d.getEndDate()!=null && now.after(endOfDay(d.getEndDate()))) return false;
+    if(d.getMinimumSubtotal()!=null && subtotal.compareTo(d.getMinimumSubtotal())<0) return false;
+    if(d.getCategories()!=null && !d.getCategories().isEmpty() && (productCodes==null || !matchesCategory(d,productCodes))) return false;
+    return true;
+  }
+  private boolean matchesCategory(DiscountCode d,Collection<String> codes) {
+    for(String c:codes) for(String allowed:d.getCategories()) {
+      if(allowed.equalsIgnoreCase(c)) return true;
+      try { Category category=categoryService.getByCode(d.getMerchantStore(),c); while(category!=null) { if(allowed.equalsIgnoreCase(category.getCode())) return true; category=category.getParent(); } }
+      catch(Exception ignored) { /* an unknown cart category simply cannot match */ }
+    }
+    return false;
+  }
+  private Date endOfDay(Date date){ Calendar c=Calendar.getInstance(); c.setTime(date); c.set(Calendar.HOUR_OF_DAY,23);c.set(Calendar.MINUTE,59);c.set(Calendar.SECOND,59);c.set(Calendar.MILLISECOND,999);return c.getTime(); }
+  public BigDecimal calculateDiscount(DiscountCode d,BigDecimal subtotal,Collection<String> codes) { if(!isEligible(d,subtotal,codes)) return BigDecimal.ZERO; BigDecimal result=d.getType()==DiscountType.PERCENT ? subtotal.multiply(d.getValue()).divide(new BigDecimal("100"),8,RoundingMode.HALF_UP) : d.getValue(); return result.min(subtotal).setScale(2,RoundingMode.HALF_UP); }
+  @Override
+  public BigDecimal calculateDiscount(DiscountCode requested, MerchantStore store, ShoppingCart cart) {
+    if (requested == null || store == null || cart == null || cart.getMerchantStore() == null
+        || !store.getId().equals(cart.getMerchantStore().getId()) || requested.getId() == null) return BigDecimal.ZERO;
+    Optional<DiscountCode> current = repository.findById(requested.getId());
+    if (!current.isPresent() || !store.getId().equals(current.get().getMerchantStore().getId())) return BigDecimal.ZERO;
+    DiscountCode d = current.get();
+    BigDecimal eligibleSubtotal = BigDecimal.ZERO;
+    if (cart.getLineItems() != null) for (ShoppingCartItem item : cart.getLineItems()) {
+      if (item == null || item.isObsolete() || item.getSubTotal() == null) continue;
+      Collection<String> categories = new ArrayList<String>();
+      if (item.getProduct() != null && item.getProduct().getCategories() != null)
+        for (Category category : item.getProduct().getCategories()) if (category != null) categories.add(category.getCode());
+      if (d.getCategories() == null || d.getCategories().isEmpty() || matchesCategory(d, categories)) eligibleSubtotal = eligibleSubtotal.add(item.getSubTotal());
+    }
+    // Passing the configured categories keeps the normal active/date/minimum checks while
+    // the line filtering above has already established descendant-category eligibility.
+    return calculateDiscount(d, eligibleSubtotal, d.getCategories());
+  }
+}
