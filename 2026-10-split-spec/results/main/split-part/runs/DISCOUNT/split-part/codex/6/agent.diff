+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem; import com.salesmanager.core.modules.order.total.OrderTotalPostProcessorModule;
+@Component public class PromoCodeCalculatorModule implements OrderTotalPostProcessorModule {
+ @Autowired private DiscountService discountService; private String name,code;
+ public String getName(){return name;} public void setName(String n){name=n;} public String getCode(){return code;} public void setCode(String c){code=c;}
+ public OrderTotal caculateProductPiceVariation(OrderSummary s,ShoppingCartItem item,Product product,Customer customer,MerchantStore store)throws Exception{
+  Validate.notNull(s,"OrderTotalSummary must not be null"); Validate.notNull(store,"MerchantStore must not be null"); if(StringUtils.isBlank(s.getPromoCode())||s.getProducts()==null)return null;
+  Discount d=discountService.findByCode(store,s.getPromoCode()); LocalDate now=LocalDate.now(); if(d==null||!d.isActive()||d.getStartDate()==null||now.isBefore(d.getStartDate())||(d.getEndDate()!=null&&now.isAfter(d.getEndDate())))return null;
+  BigDecimal subtotal=BigDecimal.ZERO,eligible=BigDecimal.ZERO; ShoppingCartItem first=null; for(ShoppingCartItem i:s.getProducts()){BigDecimal line=i.getItemPrice()==null?BigDecimal.ZERO:i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity())); subtotal=subtotal.add(line); if(ok(d,i.getProduct())){eligible=eligible.add(line);if(first==null)first=i;}}
+  if(first!=item||eligible.signum()<=0||(d.getMinimumSubtotal()!=null&&subtotal.compareTo(d.getMinimumSubtotal())<0))return null;
+  BigDecimal amount=d.getType()==DiscountType.PERCENT?eligible.multiply(d.getValue()).divide(BigDecimal.valueOf(100)):d.getValue(); amount=amount.min(eligible).setScale(2,RoundingMode.HALF_UP); if(amount.signum()<=0)return null;
+  OrderTotal t=new OrderTotal(); t.setOrderTotalCode(Constants.OT_DISCOUNT_TITLE); t.setOrderTotalType(OrderTotalType.SUBTOTAL); t.setTitle(Constants.OT_SUBTOTAL_MODULE_CODE); t.setText(d.getCode()); t.setValue(amount); return t;
+ }
+ private boolean ok(Discount d,Product p){List<String> roots=d.getCategories();if(roots==null||roots.isEmpty())return true;if(p==null||p.getCategories()==null)return false;for(Category c:p.getCategories())for(Category x=c;x!=null;x=x.getParent())if(roots.contains(x.getCode()))return true;return false;}
 }
