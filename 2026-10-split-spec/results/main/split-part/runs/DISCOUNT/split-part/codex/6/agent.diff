+package com.salesmanager.shop.store.controller.discount.facade;
+import java.util.*; import org.springframework.stereotype.Service; import com.salesmanager.core.business.services.discount.DiscountService; import com.salesmanager.core.model.discount.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.discount.*;
+@Service public class DiscountFacadeImpl implements DiscountFacade {
+ private final DiscountService service; public DiscountFacadeImpl(DiscountService s){service=s;}
+ public DiscountResponse create(DiscountRequest r,MerchantStore s){return out(service.save(in(r),s));}
+ public List<DiscountResponse> list(MerchantStore s){List<DiscountResponse> out=new ArrayList<>();for(Discount d:service.list(s))out.add(out(d));return out;}
+ public DiscountResponse replace(Long id,DiscountRequest r,MerchantStore s){return out(service.replace(id,in(r),s));}
+ public void delete(Long id,MerchantStore s){service.delete(id,s);}
+ private Discount in(DiscountRequest r){Discount d=new Discount();d.setCode(r.getCode());try{d.setType(r.getType()==null?null:DiscountType.valueOf(r.getType()));}catch(Exception e){throw new IllegalArgumentException("unknown type");}d.setValue(r.getValue());d.setMinimumSubtotal(r.getMinimumSubtotal());d.setStartDate(r.getStartDate());d.setEndDate(r.getEndDate());d.setCategories(r.getCategories());d.setActive(r.getActive()==null||r.getActive());return d;}
+ private DiscountResponse out(Discount d){DiscountResponse r=new DiscountResponse();r.setId(d.getId());r.setCode(d.getCode());r.setType(d.getType().name());r.setValue(d.getValue());r.setMinimumSubtotal(d.getMinimumSubtotal());r.setStartDate(d.getStartDate());r.setEndDate(d.getEndDate());r.setCategories(d.getCategories());r.setActive(d.isActive());return r;}
+}
