+package com.salesmanager.shop.store.api.v1.discount;
+import java.util.List; import java.util.Arrays; import org.springframework.beans.factory.annotation.Autowired; import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import org.springframework.web.server.ResponseStatusException; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.constants.Constants; import com.salesmanager.shop.model.discount.*; import com.salesmanager.shop.store.controller.discount.facade.DiscountFacade; import com.salesmanager.shop.utils.AuthorizationUtils; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/discounts") public class DiscountApi {
+ private final DiscountFacade facade; private final AuthorizationUtils authorizationUtils;
+ @Autowired public DiscountApi(DiscountFacade f, AuthorizationUtils a){facade=f;authorizationUtils=a;}
+ private void authorize(MerchantStore store){String user=authorizationUtils.authenticatedUser(); authorizationUtils.authorizeUser(user,Arrays.asList(Constants.GROUP_SUPERADMIN,Constants.GROUP_ADMIN,Constants.GROUP_ADMIN_RETAIL),store);}
+ @PostMapping public ResponseEntity<DiscountResponse> create(@ApiIgnore MerchantStore s,@RequestBody DiscountRequest r){authorize(s);try{return ResponseEntity.status(HttpStatus.CREATED).body(facade.create(r,s));}catch(IllegalStateException e){throw new ResponseStatusException(HttpStatus.CONFLICT,e.getMessage());}catch(IllegalArgumentException e){throw new ResponseStatusException(HttpStatus.BAD_REQUEST,e.getMessage());}}
+ @GetMapping public List<DiscountResponse> list(@ApiIgnore MerchantStore s){authorize(s);return facade.list(s);}
+ @PutMapping("/{id}") public DiscountResponse replace(@PathVariable Long id,@ApiIgnore MerchantStore s,@RequestBody DiscountRequest r){authorize(s);try{return facade.replace(id,r,s);}catch(IllegalStateException e){throw new ResponseStatusException(HttpStatus.CONFLICT,e.getMessage());}catch(IllegalArgumentException e){throw new ResponseStatusException(HttpStatus.BAD_REQUEST,e.getMessage());}}
+ @DeleteMapping("/{id}") public ResponseEntity<Void> delete(@PathVariable Long id,@ApiIgnore MerchantStore s){authorize(s);facade.delete(id,s);return ResponseEntity.noContent().build();}
+}
