+package com.salesmanager.core.business.services.discount;
+import java.time.LocalDate;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.category.CategoryRepository;
+import com.salesmanager.core.business.repositories.discount.DiscountRepository;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("discountService")
+public class DiscountServiceImpl implements DiscountService {
+ private final DiscountRepository repository; private final CategoryRepository categories;
+ @Inject public DiscountServiceImpl(DiscountRepository r, CategoryRepository c){repository=r;categories=c;}
+ public Discount findByCode(MerchantStore s,String c){return repository.findByStoreAndCode(s.getId(),c);}
+ public List<Discount> list(MerchantStore s){return repository.findByStore(s.getId());}
+ public Discount save(Discount d,MerchantStore s){d.setMerchantStore(s); validate(d); return repository.saveAndFlush(d);}
+ public Discount replace(Long id,Discount d,MerchantStore s){Discount old=repository.findByStoreAndId(s.getId(),id); if(old==null) throw new IllegalArgumentException("Discount not found"); d.setId(id); d.setMerchantStore(s); validate(d); return repository.saveAndFlush(d);}
+ public void delete(Long id,MerchantStore s){Discount d=repository.findByStoreAndId(s.getId(),id); if(d!=null) repository.delete(d);}
+ private void validate(Discount d){
+  if(d.getCode()==null||d.getCode().trim().isEmpty()||d.getType()==null||d.getValue()==null) throw new IllegalArgumentException("code, type and value are required");
+  d.setCode(d.getCode().trim()); if(d.getStartDate()==null)d.setStartDate(LocalDate.now());
+  if(d.getEndDate()!=null&&d.getEndDate().isBefore(d.getStartDate()))throw new IllegalArgumentException("endDate before startDate");
+  if(d.getValue().signum()<=0||(d.getType()==DiscountType.PERCENT&&d.getValue().compareTo(java.math.BigDecimal.valueOf(100))>0))throw new IllegalArgumentException("invalid value");
+  Discount duplicate=repository.findByStoreAndCode(d.getMerchantStore().getId(),d.getCode()); if(duplicate!=null&&!duplicate.getId().equals(d.getId()))throw new IllegalStateException("duplicate code");
+  if(d.getCategories()!=null) for(String code:d.getCategories()) if(code==null||categories.findByCode(d.getMerchantStore().getId(),code)==null) throw new IllegalArgumentException("unknown category");
+ }
+}
