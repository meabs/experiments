+package com.salesmanager.shop.store.api.v1.discount;
+
+import java.time.ZoneId;
+import java.util.Date;
+import java.util.List;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+import javax.validation.Valid;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.ExceptionHandler;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.discount.DiscountService;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.model.discount.PersistableDiscount;
+import com.salesmanager.shop.model.discount.ReadableDiscount;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.api.exception.UnauthorizedException;
+import com.salesmanager.shop.store.controller.user.facade.UserFacade;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Protected merchant administration endpoints for discount codes. */
+@RestController
+@RequestMapping("/api/v1/private/discounts")
+public class DiscountApi {
+    @Inject private DiscountService discountService;
+    @Inject private UserFacade userFacade;
+
+    @GetMapping
+    public List<ReadableDiscount> list(@ApiIgnore MerchantStore store) {
+        authorize();
+        try {
+            return discountService.listByStore(store).stream().map(DiscountApi::read).collect(Collectors.toList());
+        } catch (ServiceException e) { throw bad(e); }
+    }
+
+    @PostMapping
+    public ResponseEntity<ReadableDiscount> create(@Valid @RequestBody PersistableDiscount request,
+            @ApiIgnore MerchantStore store) {
+        authorize();
+        try {
+            if (discountService.findByCode(request.getCode(), store) != null) throw new DuplicateDiscountException();
+            Discount saved = discountService.saveOrUpdate(toEntity(request, store));
+            return new ResponseEntity<>(read(saved), HttpStatus.CREATED);
+        } catch (DuplicateDiscountException e) { throw e;
+        } catch (ServiceException e) { throw translate(e); }
+    }
+
+    @PutMapping("/{id}")
+    public ReadableDiscount update(@PathVariable Long id, @Valid @RequestBody PersistableDiscount request,
+            @ApiIgnore MerchantStore store) {
+        authorize();
+        try {
+            Discount current = discountService.getById(id);
+            if (current == null || current.getMerchantStore() == null || !current.getMerchantStore().getId().equals(store.getId()))
+                throw new RestApiException("Discount not found");
+            Discount duplicate = discountService.findByCode(request.getCode(), store);
+            if (duplicate != null && !id.equals(duplicate.getId())) throw new DuplicateDiscountException();
+            Discount entity = toEntity(request, store); entity.setId(id);
+            return read(discountService.updateOrReplace(entity));
+        } catch (DuplicateDiscountException e) { throw e;
+        } catch (ServiceException e) { throw translate(e); }
+    }
+
+    @DeleteMapping("/{id}")
+    public ResponseEntity<Void> delete(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        authorize();
+        Discount current = discountService.getById(id);
+        if (current == null || current.getMerchantStore() == null || !current.getMerchantStore().getId().equals(store.getId()))
+            throw new RestApiException("Discount not found");
+        try { discountService.delete(current); return ResponseEntity.noContent().build(); }
+        catch (ServiceException e) { throw bad(e); }
+    }
+
+    private void authorize() {
+        String user = userFacade.authenticatedUser();
+        if (user == null) throw new UnauthorizedException();
+        userFacade.authorizedGroup(user, java.util.Arrays.asList(Constants.GROUP_SUPERADMIN,
+                Constants.GROUP_ADMIN, Constants.GROUP_ADMIN_RETAIL));
+    }
+
+    private static Discount toEntity(PersistableDiscount source, MerchantStore store) {
+        Discount d = new Discount(); d.setMerchantStore(store); d.setCode(source.getCode());
+        d.setType(com.salesmanager.core.model.discount.DiscountType.valueOf(source.getType().name()));
+        d.setValue(source.getValue()); d.setMinimumSubtotal(source.getMinimumSubtotal()); d.setActive(source.isActive());
+        d.setStartDate(Date.from(source.getStartDate().atStartOfDay(ZoneId.systemDefault()).toInstant()));
+        if (source.getEndDate() != null) d.setEndDate(Date.from(source.getEndDate().atStartOfDay(ZoneId.systemDefault()).toInstant()));
+        d.setCategories(source.getCategories() == null ? null : new java.util.HashSet<>(source.getCategories())); return d;
+    }
+    private static ReadableDiscount read(Discount d) {
+        ReadableDiscount r = new ReadableDiscount(); r.setId(d.getId()); r.setCode(d.getCode());
+        r.setType(com.salesmanager.shop.model.discount.DiscountType.valueOf(d.getType().name())); r.setValue(d.getValue());
+        r.setMinimumSubtotal(d.getMinimumSubtotal());
+        if (d.getStartDate() != null) r.setStartDate(d.getStartDate().toInstant().atZone(ZoneId.systemDefault()).toLocalDate());
+        if (d.getEndDate() != null) r.setEndDate(d.getEndDate().toInstant().atZone(ZoneId.systemDefault()).toLocalDate());
+        Set<String> categories = d.getCategories(); r.setCategories(categories == null ? null : categories.stream().collect(Collectors.toList())); r.setActive(d.isActive()); return r;
+    }
+    private static RestApiException bad(Exception e) { return new RestApiException("Invalid discount", e); }
+    private static RestApiException translate(Exception e) { if (e.getMessage() != null && e.getMessage().toLowerCase().contains("already exists")) return new DuplicateDiscountException(); return bad(e); }
+    @ExceptionHandler(DuplicateDiscountException.class)
+    public ResponseEntity<String> duplicate(DuplicateDiscountException e) {
+        return ResponseEntity.status(HttpStatus.CONFLICT).body(e.getMessage());
+    }
+    @org.springframework.web.bind.annotation.ResponseStatus(HttpStatus.CONFLICT)
+    private static class DuplicateDiscountException extends RestApiException { private static final long serialVersionUID = 1L; DuplicateDiscountException() { super("Discount code already exists"); } }
+}
