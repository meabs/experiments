+package com.salesmanager.core.business.services.discount;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.discount.DiscountRepository;
+import com.salesmanager.core.business.repositories.catalog.category.CategoryRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.discount.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.*;
+
+@Service("discountService")
+public class DiscountServiceImpl extends SalesManagerEntityServiceImpl<Long,Discount> implements DiscountService {
+ private final DiscountRepository repository;
+ private final CategoryRepository categoryRepository;
+ /** Constructor retained for lightweight unit tests; production wiring uses the category-aware constructor. */
+ public DiscountServiceImpl(DiscountRepository repository){this(repository,null);}
+ @Inject public DiscountServiceImpl(DiscountRepository repository, CategoryRepository categoryRepository){super(repository);this.repository=repository;this.categoryRepository=categoryRepository;}
+
+ @Override public Discount saveOrUpdate(Discount d) throws ServiceException { validate(d); checkUnique(d); return d.getId()!=null&&d.getId()>0 ? replace(d) : saveAndFlush(d); }
+ @Override public Discount updateOrReplace(Discount d) throws ServiceException { validate(d); checkUnique(d); return replace(d); }
+ private Discount replace(Discount d){return repository.saveAndFlush(d);}
+ private void checkUnique(Discount d) throws ServiceException {
+  if(d.getMerchantStore()==null) throw new ServiceException("Merchant store is required");
+  if(d.getCode()==null||d.getCode().trim().isEmpty()) throw new ServiceException("Discount code is required");
+  Discount existing=repository.findByStoreAndCode(d.getMerchantStore().getId(),d.getCode().trim());
+  if(existing!=null && !existing.getId().equals(d.getId())) throw new ServiceException("Discount code already exists in this store");
+  d.setCode(d.getCode().trim());
+ }
+ private void validate(Discount d) throws ServiceException {
+  if(d==null) throw new ServiceException("Discount is required");
+  if(d.getType()==null) throw new ServiceException("Discount type is required");
+  if(d.getValue()==null||d.getValue().compareTo(BigDecimal.ZERO)<=0) throw new ServiceException("Discount value must be positive");
+  if(d.getType()==DiscountType.PERCENT&&d.getValue().compareTo(new BigDecimal("100"))>0) throw new ServiceException("Percent discount cannot exceed 100");
+  if(d.getMinimumSubtotal()!=null&&d.getMinimumSubtotal().compareTo(BigDecimal.ZERO)<0) throw new ServiceException("Minimum subtotal cannot be negative");
+  if(d.getStartDate()==null)d.setStartDate(new Date());
+  if(d.getEndDate()!=null&&date(d.getEndDate()).before(date(d.getStartDate()))) throw new ServiceException("End date cannot precede start date");
+  if(d.getCategories()!=null) for(String c:d.getCategories()) {
+   if(c==null||c.trim().isEmpty()) throw new ServiceException("Category code cannot be empty");
+   if(categoryRepository!=null && d.getMerchantStore()!=null && categoryRepository.findByCode(d.getMerchantStore().getId(),c.trim())==null)
+    throw new ServiceException("Unknown category code: "+c);
+  }
+ }
+ private Date date(Date d){Calendar c=Calendar.getInstance();c.setTime(d);c.set(Calendar.HOUR_OF_DAY,0);c.set(Calendar.MINUTE,0);c.set(Calendar.SECOND,0);c.set(Calendar.MILLISECOND,0);return c.getTime();}
+ @Override public List<Discount> listByStore(MerchantStore s)throws ServiceException{if(s==null)throw new ServiceException("Merchant store is required");return repository.findByStore(s.getId());}
+ @Override public Discount getByCode(String code,MerchantStore s)throws ServiceException{return findByCode(code,s);}
+ @Override public Discount findByCode(String code,MerchantStore s)throws ServiceException{if(s==null||code==null||code.trim().isEmpty())return null;return repository.findByStoreAndCode(s.getId(),code.trim());}
+ @Override public DiscountEvaluation evaluate(String code,MerchantStore s,ShoppingCart cart)throws ServiceException{return evaluate(findByCode(code,s),s,cart);}
+ @Override public DiscountEvaluation evaluate(Discount d,MerchantStore s,ShoppingCart cart)throws ServiceException{
+  BigDecimal zero=BigDecimal.ZERO.setScale(2); if(d==null||s==null||cart==null||d.getMerchantStore()==null||!Objects.equals(d.getMerchantStore().getId(),s.getId()))return new DiscountEvaluation(false,zero,zero);
+  Date today=date(new Date()); if(!d.isActive()||(d.getStartDate()!=null&&today.before(date(d.getStartDate())))||(d.getEndDate()!=null&&today.after(date(d.getEndDate()))))return new DiscountEvaluation(false,zero,zero);
+  BigDecimal subtotal=BigDecimal.ZERO, eligible=BigDecimal.ZERO;
+  for(ShoppingCartItem i:cart.getLineItems()){BigDecimal amount=i.getSubTotal();if(amount==null&&i.getFinalPrice()!=null)amount=i.getFinalPrice().getFinalPrice();if(amount==null)continue;subtotal=subtotal.add(amount);if(eligible(i,d.getCategories()))eligible=eligible.add(amount);}
+  if(d.getMinimumSubtotal()!=null&&subtotal.compareTo(d.getMinimumSubtotal())<0||eligible.signum()<=0)return new DiscountEvaluation(false,eligible.setScale(2,RoundingMode.HALF_UP),zero);
+  BigDecimal discount=d.getType()==DiscountType.PERCENT?eligible.multiply(d.getValue()).divide(new BigDecimal("100"),8,RoundingMode.HALF_UP):d.getValue();
+  discount=discount.min(eligible).setScale(2,RoundingMode.HALF_UP); return new DiscountEvaluation(discount.signum()>0,eligible.setScale(2,RoundingMode.HALF_UP),discount);
+ }
+ private boolean eligible(ShoppingCartItem i,Set<String> wanted){if(wanted==null||wanted.isEmpty())return true;Product p=i.getProduct();if(p==null||p.getCategories()==null)return false;for(Category c:p.getCategories())for(String w:wanted){Category x=c;while(x!=null){if(w.equalsIgnoreCase(x.getCode()))return true;x=x.getParent();}}return false;}
+}
