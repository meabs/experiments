+package com.salesmanager.core.business.services.discount;
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDate;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.DiscountCodeConflictException;
+import com.salesmanager.core.business.exception.DiscountCodeValidationException;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.category.CategoryRepository;
+import com.salesmanager.core.business.repositories.discount.DiscountCodeRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.discount.DiscountCode;
+import com.salesmanager.core.model.discount.DiscountCodeType;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service("discountCodeService")
+public class DiscountCodeServiceImpl extends SalesManagerEntityServiceImpl<Long, DiscountCode> implements DiscountCodeService {
+    private final DiscountCodeRepository repository; private final CategoryRepository categories;
+    @Inject public DiscountCodeServiceImpl(DiscountCodeRepository repository, CategoryRepository categories) { super(repository); this.repository=repository; this.categories=categories; }
+    @Override public List<DiscountCode> listByStore(MerchantStore s) { return repository.findByMerchantStoreId(s.getId()); }
+    @Override public DiscountCode getByCode(MerchantStore s, String c) { return c == null ? null : repository.findByMerchantStoreIdAndCodeIgnoreCase(s.getId(), c.trim()); }
+    @Override public DiscountCode getById(MerchantStore s, Long id) { return repository.findByMerchantStoreIdAndId(s.getId(), id); }
+    @Override public DiscountCode saveOrUpdate(DiscountCode c) throws ServiceException {
+        validate(c);
+        Integer sid=c.getMerchantStore().getId(); boolean duplicate=c.getId()==null ? repository.existsByMerchantStoreIdAndCodeIgnoreCase(sid,c.getCode()) : repository.existsByMerchantStoreIdAndCodeIgnoreCaseAndIdNot(sid,c.getCode(),c.getId());
+        if (duplicate) throw new DiscountCodeConflictException("Discount code already exists in this store");
+        if (c.getId()==null) return super.saveAndFlush(c); update(c); return c;
+    }
+    private void validate(DiscountCode c) throws ServiceException {
+        if (c==null || c.getMerchantStore()==null || c.getCode()==null || c.getCode().trim().isEmpty() || c.getValue()==null || c.getType()==null) throw new DiscountCodeValidationException("Code, type, value and store are required");
+        c.setCode(c.getCode().trim()); if (c.getStartDate()==null) c.setStartDate(LocalDate.now());
+        if (c.getEndDate()!=null && c.getEndDate().isBefore(c.getStartDate())) throw new DiscountCodeValidationException("End date cannot precede start date");
+        if (c.getValue().signum()<=0 || (c.getType()==DiscountCodeType.PERCENT && c.getValue().compareTo(BigDecimal.valueOf(100))>0)) throw new DiscountCodeValidationException("Invalid discount value");
+        if (c.getMinimumSubtotal()!=null && c.getMinimumSubtotal().signum()<0) throw new DiscountCodeValidationException("Minimum subtotal cannot be negative");
+        for (String category : c.getCategories()) if (category==null || categories.findByCode(c.getMerchantStore().getId(), category)==null) throw new DiscountCodeValidationException("Unknown category: " + category);
+    }
+    @Override public DiscountEvaluation evaluate(MerchantStore store, String code, ShoppingCart cart) { return evaluate(getByCode(store,code),cart); }
+    @Override public DiscountEvaluation evaluate(DiscountCode c, ShoppingCart cart) {
+        if (c==null || cart==null || c.getMerchantStore()==null || cart.getMerchantStore()==null || !c.getMerchantStore().getId().equals(cart.getMerchantStore().getId())) return new DiscountEvaluation(c,false,BigDecimal.ZERO.setScale(2));
+        LocalDate today=LocalDate.now(); if (!c.isActive() || today.isBefore(c.getStartDate()) || c.getEndDate()!=null && today.isAfter(c.getEndDate())) return new DiscountEvaluation(c,false,BigDecimal.ZERO.setScale(2));
+        BigDecimal subtotal=BigDecimal.ZERO, eligible=BigDecimal.ZERO;
+        for (ShoppingCartItem item: cart.getLineItems()) { BigDecimal amount=item.getSubTotal(); if (amount==null && item.getItemPrice()!=null) amount=item.getItemPrice().multiply(BigDecimal.valueOf(item.getQuantity()==null?0:item.getQuantity())); if(amount==null) continue; subtotal=subtotal.add(amount); if (eligible(item,c)) eligible=eligible.add(amount); }
+        if (c.getMinimumSubtotal()!=null && subtotal.compareTo(c.getMinimumSubtotal())<0 || eligible.signum()<=0) return new DiscountEvaluation(c,false,BigDecimal.ZERO.setScale(2));
+        BigDecimal discount=c.getType()==DiscountCodeType.PERCENT ? eligible.multiply(c.getValue()).divide(BigDecimal.valueOf(100), 2, RoundingMode.HALF_UP) : c.getValue().min(eligible);
+        return new DiscountEvaluation(c,true,discount.setScale(2,RoundingMode.HALF_UP));
+    }
+    private boolean eligible(ShoppingCartItem item, DiscountCode c) { if(c.getCategories().isEmpty()) return true; Product p=item.getProduct(); if(p==null || p.getCategories()==null) return false; for(Category pc:p.getCategories()) for(String wanted:c.getCategories()) { Category x=pc; while(x!=null) { if(wanted.equalsIgnoreCase(x.getCode())) return true; x=x.getParent(); } } return false; }
+}
