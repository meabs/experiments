@@ -0,0 +1,62 @@
+package com.salesmanager.shop.store.facade.discount;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.stream.Collectors;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.exception.DiscountCodeConflictException;
+import com.salesmanager.core.business.services.discount.DiscountCodeService;
+import com.salesmanager.core.model.discount.DiscountCode;
+import com.salesmanager.core.model.discount.DiscountCodeType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.discount.PersistableDiscountCode;
+import com.salesmanager.shop.model.discount.ReadableDiscountCode;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.api.exception.DiscountCodeConflictRuntimeException;
+import com.salesmanager.shop.store.controller.discount.facade.DiscountCodeFacade;
+
+@Service
+public class DiscountCodeFacadeImpl implements DiscountCodeFacade {
+    @Autowired private DiscountCodeService service;
+
+    @Override public ReadableDiscountCode create(PersistableDiscountCode source, MerchantStore store) {
+        DiscountCode saved = persist(toModel(source, store));
+        return toReadable(saved);
+    }
+    @Override public List<ReadableDiscountCode> list(MerchantStore store) {
+        try { return service.listByStore(store).stream().map(this::toReadable).collect(Collectors.toList()); }
+        catch (ServiceException e) { throw new ServiceRuntimeException("Unable to list discount codes", e); }
+    }
+    @Override public ReadableDiscountCode update(Long id, PersistableDiscountCode source, MerchantStore store) {
+        try {
+            DiscountCode existing = service.getById(store, id);
+            if (existing == null) throw new ResourceNotFoundException("Discount code not found [" + id + "]");
+            DiscountCode replacement = toModel(source, store); replacement.setId(id);
+            return toReadable(persist(replacement));
+        } catch (ServiceException e) { throw new ServiceRuntimeException("Unable to update discount code", e); }
+    }
+    @Override public void delete(Long id, MerchantStore store) {
+        try {
+            DiscountCode existing = service.getById(store, id);
+            if (existing == null) throw new ResourceNotFoundException("Discount code not found [" + id + "]");
+            service.delete(existing);
+        } catch (ServiceException e) { throw new ServiceRuntimeException("Unable to delete discount code", e); }
+    }
+    private DiscountCode persist(DiscountCode model) {
+        try { return service.saveOrUpdate(model); }
+        catch (DiscountCodeConflictException e) { throw new DiscountCodeConflictRuntimeException(e.getMessage(), e); }
+        catch (ServiceException e) { throw new ServiceRuntimeException(e.getMessage(), e); }
+    }
+    private DiscountCode toModel(PersistableDiscountCode s, MerchantStore store) {
+        DiscountCode m = new DiscountCode();
+        if (s != null) { m.setId(s.getId()); m.setCode(s.getCode()); m.setValue(s.getValue()); m.setMinimumSubtotal(s.getMinimumSubtotal()); m.setStartDate(s.getStartDate()); m.setEndDate(s.getEndDate()); m.setCategories(new HashSet<>(s.getCategories() == null ? new ArrayList<>() : s.getCategories())); m.setActive(s.getActive() == null || s.getActive()); try { m.setType(s.getType() == null ? null : DiscountCodeType.valueOf(s.getType().toUpperCase())); } catch (IllegalArgumentException e) { m.setType(null); } }
+        m.setMerchantStore(store); return m;
+    }
+    private ReadableDiscountCode toReadable(DiscountCode m) {
+        ReadableDiscountCode r = new ReadableDiscountCode(); r.setId(m.getId()); r.setCode(m.getCode()); r.setType(m.getType() == null ? null : m.getType().name()); r.setValue(m.getValue()); r.setMinimumSubtotal(m.getMinimumSubtotal()); r.setStartDate(m.getStartDate()); r.setEndDate(m.getEndDate()); r.setCategories(new ArrayList<>(m.getCategories())); r.setActive(m.isActive()); return r;
+    }
+}
