+package com.salesmanager.shop.model.discount;
+
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.util.ArrayList;
+import java.util.List;
+
+/** The JSON representation accepted by the merchant discount-code API. */
+public class PersistableDiscountCode {
+    private Long id;
+    private String code;
+    private String type;
