+package com.salesmanager.core.business.services.catalog.product.stockalert;
+
+import java.util.Date;
+import java.util.List;
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.stockalert.StockAlertOutboxRepository;
+import com.salesmanager.core.business.repositories.catalog.product.stockalert.StockAlertRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.description.ProductDescription;
+import com.salesmanager.core.model.catalog.product.stockalert.StockAlert;
+import com.salesmanager.core.model.catalog.product.stockalert.StockAlertOutboxMessage;
+import com.salesmanager.core.model.catalog.product.stockalert.StockAlertStatus;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+    @Inject private StockAlertRepository alertRepository;
+    @Inject private StockAlertOutboxRepository outboxRepository;
+
+    @Override @Transactional
+    public StockAlert request(Product product, MerchantStore store, String email) {
+        StockAlert existing = alertRepository.findByProductIdAndMerchantStoreIdAndEmailIgnoreCaseAndStatus(product.getId(), store.getId(), email, StockAlertStatus.PENDING).orElse(null);
+        if (existing != null) return existing;
+        StockAlert alert = new StockAlert();
+        alert.setProduct(product); alert.setMerchantStore(store); alert.setSku(product.getSku()); alert.setEmail(email);
+        return alertRepository.save(alert);
+    }
+
+    @Override @Transactional
+    public boolean hasPending(Product product, MerchantStore store, String email) {
+        return alertRepository.findByProductIdAndMerchantStoreIdAndEmailIgnoreCaseAndStatus(product.getId(), store.getId(), email, StockAlertStatus.PENDING).isPresent();
+    }
+
+    @Override @Transactional
+    public void cancel(Product product, MerchantStore store, String email) {
+        StockAlert alert = alertRepository.findByProductIdAndMerchantStoreIdAndEmailIgnoreCaseAndStatus(product.getId(), store.getId(), email, StockAlertStatus.PENDING).orElse(null);
+        if (alert == null) throw new IllegalArgumentException("Pending stock alert not found");
+        alertRepository.delete(alert);
+    }
+
+    @Override @Transactional
+    public List<StockAlert> list(MerchantStore store, StockAlertStatus status) {
+        return status == null ? alertRepository.findByMerchantStoreIdOrderByCreatedAtAscIdAsc(store.getId()) : alertRepository.findByMerchantStoreIdAndStatusOrderByCreatedAtAscIdAsc(store.getId(), status);
+    }
+
+    @Override @Transactional
+    public List<StockAlertOutboxMessage> outbox(MerchantStore store) { return outboxRepository.findByMerchantStoreIdOrderByCreatedAtAscIdAsc(store.getId()); }
+
+    @Override @Transactional
+    public void restocked(ProductAvailability availability) {
+        if (availability.getProductQuantity() == null || availability.getProductQuantity() <= 0) return;
+        Product product = availability.getProduct();
+        List<StockAlert> alerts = alertRepository.findByProductIdAndMerchantStoreIdAndStatusOrderByCreatedAtAscIdAsc(product.getId(), availability.getMerchantStore().getId(), StockAlertStatus.PENDING);
+        Date now = new Date();
+        for (StockAlert alert : alerts) {
+            alert.setStatus(StockAlertStatus.SENT); alert.setSentAt(now); alertRepository.save(alert);
+            StockAlertOutboxMessage message = new StockAlertOutboxMessage();
+            message.setMerchantStore(availability.getMerchantStore()); message.setProduct(product); message.setTo(alert.getEmail()); message.setSku(product.getSku()); message.setSubject(productName(product) + " is back in stock"); message.setCreatedAt(now);
+            outboxRepository.save(message);
+        }
+    }
+
+    private String productName(Product product) {
+        if (product.getDescriptions() != null) for (ProductDescription description : product.getDescriptions()) if (description.getName() != null) return description.getName();
+        return product.getSku();
+    }
+}
