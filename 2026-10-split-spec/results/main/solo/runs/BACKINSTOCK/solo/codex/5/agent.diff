+package com.salesmanager.core.business.services.catalog.product.stockalert;
+import java.util.*;
+import javax.inject.Inject;
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.catalog.product.stockalert.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.stockalert.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.business.exception.ServiceException;
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+    private static final String PENDING = "PENDING", SENT = "SENT";
+    @Inject StockAlertRepository alerts;
+    @Inject StockAlertOutboxRepository outbox;
+    @Inject ProductService products;
+    private Product product(String sku, MerchantStore store) {
+        try { return products.getBySku(sku, store); } catch (ServiceException e) { throw new NoSuchElementException("Unknown sku"); }
+    }
+    @Override @Transactional
+    public StockAlert request(String sku, String email, MerchantStore store) {
+        Product p = product(sku, store);
+        if (p == null) throw new NoSuchElementException("Unknown sku");
+        boolean inStock = p.getAvailabilities().stream().anyMatch(a -> a.getProductQuantity() != null && a.getProductQuantity() > 0);
+        if (inStock) throw new StockConflictException();
+        return alerts.findByProductIdAndMerchantStoreIdAndEmailIgnoreCaseAndStatus(p.getId(), store.getId(), email, PENDING).map(a -> { a.setNewlyCreated(false); return a; }).orElseGet(() -> {
+            StockAlert a = new StockAlert(); a.setProduct(p); a.setMerchantStore(store); a.setSku(sku); a.setEmail(email); a.setStatus(PENDING); a.setNewlyCreated(true); return alerts.save(a);
+        });
+    }
+    @Override @Transactional public void cancel(String sku, String email, MerchantStore store) {
+        Product p = product(sku, store); if (p == null) throw new NoSuchElementException("Unknown sku");
+        StockAlert a = alerts.findByProductIdAndMerchantStoreIdAndEmailIgnoreCaseAndStatus(p.getId(), store.getId(), email, PENDING).orElseThrow(NoSuchElementException::new); alerts.delete(a);
+    }
+    @Override public List<StockAlert> list(MerchantStore store, String status) { return status == null ? alerts.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId()) : alerts.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(store.getId(), status); }
+    @Override public List<StockAlertOutbox> outbox(MerchantStore store) { return outbox.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId()); }
+    @Override @Transactional public void restocked(ProductAvailability availability, int oldQuantity, Product product, MerchantStore store) {
+        if (oldQuantity > 0 || availability.getProductQuantity() == null || availability.getProductQuantity() <= 0) return;
+        for (StockAlert a : alerts.findByProductIdAndMerchantStoreIdAndStatusOrderByCreatedAtAsc(product.getId(), store.getId(), PENDING)) {
+            a.setStatus(SENT); a.setSentAt(new Date()); alerts.save(a);
+            StockAlertOutbox m = new StockAlertOutbox(); m.setMerchantStore(store); m.setToEmail(a.getEmail()); m.setSku(a.getSku());
+            String name = product.getProductDescription() == null ? product.getSku() : product.getProductDescription().getName();
+            m.setSubject(name + " is back in stock"); outbox.save(m);
+        }
+    }
+}
