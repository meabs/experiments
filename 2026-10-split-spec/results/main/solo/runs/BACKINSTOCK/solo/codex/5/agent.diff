+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.*;
+import java.util.regex.Pattern;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.stockalert.StockAlertService;
+import com.salesmanager.core.business.services.catalog.product.stockalert.StockConflictException;
+import com.salesmanager.core.model.catalog.product.stockalert.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.store.api.exception.*;
+import com.salesmanager.shop.utils.AuthorizationUtils;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class StockAlertApi {
+    private static final Pattern EMAIL = Pattern.compile("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$");
+    @Inject private StockAlertService service;
+    @Inject private AuthorizationUtils authorizationUtils;
+
+    @PostMapping("/products/{sku}/alerts")
+    public ResponseEntity<Map<String, Object>> request(@PathVariable String sku, @RequestBody Map<String, String> body,
+            @ApiIgnore MerchantStore store) {
+        String email = body == null ? null : body.get("email");
+        if (email == null || !EMAIL.matcher(email).matches()) throw new RestApiException("Invalid email");
+        try {
+            StockAlert a = service.request(sku, email, store);
+            Map<String,Object> result = new LinkedHashMap<>(); result.put("sku", a.getSku()); result.put("email", a.getEmail()); result.put("status", a.getStatus());
+            return ResponseEntity.status(a.isNewlyCreated() ? HttpStatus.CREATED : HttpStatus.OK).body(result);
+        } catch (StockConflictException e) { throw new ConflictException(); }
+          catch (NoSuchElementException e) { throw new ResourceNotFoundException("Product not found"); }
+    }
+
+    @DeleteMapping("/products/{sku}/alerts")
+    @ResponseStatus(HttpStatus.NO_CONTENT)
+    public void cancel(@PathVariable String sku, @RequestParam String email, @ApiIgnore MerchantStore store) {
+        if (!EMAIL.matcher(email).matches()) throw new RestApiException("Invalid email");
+        try { service.cancel(sku, email, store); }
+        catch (NoSuchElementException e) { throw new ResourceNotFoundException("Alert not found"); }
+    }
+
+    @GetMapping("/private/stock-alerts")
+    public List<Map<String,Object>> list(@RequestParam(required=false) String status, @ApiIgnore MerchantStore store) {
+        checkAdmin(store);
+        if (status != null && !status.equals("PENDING") && !status.equals("SENT")) throw new RestApiException("Invalid status");
+        return service.list(store, status).stream().map(this::alert).collect(Collectors.toList());
+    }
+
+    @GetMapping("/private/stock-alerts/outbox")
+    public List<Map<String,Object>> outbox(@ApiIgnore MerchantStore store) {
+        checkAdmin(store); return service.outbox(store).stream().map(this::message).collect(Collectors.toList());
+    }
+    private void checkAdmin(MerchantStore store) {
+        String user = authorizationUtils.authenticatedUser();
+        if (user == null) throw new UnauthorizedException();
+        authorizationUtils.authorizeUser(user, Arrays.asList(Constants.GROUP_SUPERADMIN, Constants.GROUP_ADMIN, Constants.GROUP_ADMIN_RETAIL), store);
+    }
+    private Map<String,Object> alert(StockAlert a) { Map<String,Object> m = new LinkedHashMap<>(); m.put("id", a.getId()); m.put("sku", a.getSku()); m.put("email", a.getEmail()); m.put("status", a.getStatus()); m.put("createdAt", a.getCreatedAt()); m.put("sentAt", a.getSentAt()); return m; }
+    private Map<String,Object> message(StockAlertOutbox a) { Map<String,Object> m = new LinkedHashMap<>(); m.put("to", a.getToEmail()); m.put("sku", a.getSku()); m.put("subject", a.getSubject()); m.put("createdAt", a.getCreatedAt()); return m; }
+    @ResponseStatus(HttpStatus.CONFLICT) private static class ConflictException extends RuntimeException {}
+}
