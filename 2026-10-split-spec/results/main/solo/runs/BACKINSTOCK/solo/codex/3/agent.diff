+package com.salesmanager.shop.store.stock;
+
+import java.util.*;
+import java.util.regex.Pattern;
+import javax.transaction.Transactional;
+import org.springframework.stereotype.Service;
+import org.springframework.beans.factory.annotation.Autowired;
+import com.salesmanager.core.business.repositories.catalog.product.stock.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.stock.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+@Service
+public class StockAlertService {
+ private static final Pattern EMAIL=Pattern.compile("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$");
+ @Autowired private StockAlertRepository alerts; @Autowired private StockAlertOutboxRepository outbox; @Autowired private ProductService products;
+ private Product product(String sku, MerchantStore store){ try { Product p=products.getBySku(sku,store); if(p==null) throw new ResourceNotFoundException("Product not found"); return p; } catch(Exception e){ if(e instanceof ResourceNotFoundException) throw (ResourceNotFoundException)e; throw new ResourceNotFoundException("Product not found"); } }
+ @Transactional public StockAlert ask(String sku,String email,MerchantStore store){
+  if(email==null || !EMAIL.matcher(email.trim()).matches()) throw new RestApiException("400","Invalid email");
+  Product p=product(sku,store); boolean inStock=p.getAvailabilities()!=null && p.getAvailabilities().stream().anyMatch(a->a.getProductQuantity()!=null && a.getProductQuantity()>0);
+  if(inStock) throw new RestApiException("409","Product is in stock");
+  Optional<StockAlert> existing=alerts.findFirstByMerchantStoreIdAndSkuAndEmailIgnoreCaseAndStatus(store.getId(),sku,email.trim(),"PENDING"); if(existing.isPresent()){ existing.get().setDuplicate(true); return existing.get(); }
+  StockAlert a=new StockAlert(); a.setMerchantStore(store); a.setProduct(p); a.setSku(sku); a.setEmail(email.trim()); a.setStatus("PENDING"); return alerts.save(a);
+ }
+ @Transactional public void cancel(String sku,String email,MerchantStore store){ StockAlert a=alerts.findFirstByMerchantStoreIdAndSkuAndEmailIgnoreCaseAndStatus(store.getId(),sku,email,"PENDING").orElseThrow(()->new ResourceNotFoundException("Alert not found")); alerts.delete(a); }
+ public List<StockAlert> list(MerchantStore store,String status){ if(status!=null && !status.equals("PENDING")&&!status.equals("SENT")) throw new RestApiException("400","Invalid status"); return status==null?alerts.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId()):alerts.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(store.getId(),status); }
+ public List<StockAlertOutbox> outbox(MerchantStore store){return outbox.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId());}
+ @Transactional public void restocked(ProductAvailability availability,int oldQuantity,MerchantStore store){
+  if(oldQuantity>0 || availability.getProductQuantity()==null || availability.getProductQuantity()<=0) return;
+  String sku=availability.getSku()!=null?availability.getSku():availability.getProduct().getSku(); List<StockAlert> pending=alerts.findByMerchantStoreIdAndSkuAndStatusOrderByCreatedAtAsc(store.getId(),sku,"PENDING");
+  String name=availability.getProduct().getProductDescription()!=null?availability.getProduct().getProductDescription().getName():sku;
+  for(StockAlert a:pending){ a.setStatus("SENT"); a.setSentAt(new Date()); alerts.save(a); StockAlertOutbox m=new StockAlertOutbox(); m.setMerchantStore(store); m.setToEmail(a.getEmail()); m.setSku(sku); m.setSubject(name+" is back in stock"); outbox.save(m); }
+ }
+}
