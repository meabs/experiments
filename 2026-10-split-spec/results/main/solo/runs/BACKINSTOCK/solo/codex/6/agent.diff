+package com.salesmanager.core.business.services.catalog.product.stockalert;
+
+import java.util.Date;
+import java.util.List;
+import java.util.Locale;
+
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.repositories.catalog.product.stockalert.StockAlertOutboxRepository;
+import com.salesmanager.core.business.repositories.catalog.product.stockalert.StockAlertRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.stockalert.StockAlert;
+import com.salesmanager.core.model.catalog.product.stockalert.StockAlert.Status;
+import com.salesmanager.core.model.catalog.product.stockalert.StockAlertOutboxMessage;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+    @Inject private StockAlertRepository alertRepository;
+    @Inject private StockAlertOutboxRepository outboxRepository;
+
+    @Override @Transactional
+    public StockAlert request(Product product, MerchantStore store, String email) {
+        return alertRepository.findFirstByMerchantStoreIdAndProductIdAndEmailIgnoreCaseAndStatus(store.getId(), product.getId(), email, Status.PENDING)
+            .orElseGet(() -> {
+                StockAlert alert = new StockAlert();
+                alert.setMerchantStore(store); alert.setProduct(product); alert.setSku(product.getSku());
+                alert.setEmail(email); alert.setStatus(Status.PENDING); alert.setCreatedAt(new Date());
+                return alertRepository.save(alert);
+            });
+    }
+    @Override public boolean isPending(Product product, MerchantStore store, String email) {
+        return alertRepository.findFirstByMerchantStoreIdAndProductIdAndEmailIgnoreCaseAndStatus(store.getId(), product.getId(), email, Status.PENDING).isPresent();
+    }
+    @Override @Transactional
+    public void cancel(Product product, MerchantStore store, String email) {
+        StockAlert alert = alertRepository.findFirstByMerchantStoreIdAndProductIdAndEmailIgnoreCaseAndStatus(store.getId(), product.getId(), email, Status.PENDING)
+            .orElseThrow(() -> new IllegalArgumentException("Pending stock alert not found"));
+        alertRepository.delete(alert);
+    }
+    @Override public List<StockAlert> list(MerchantStore store, Status status) {
+        return status == null ? alertRepository.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId()) : alertRepository.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(store.getId(), status);
+    }
+    @Override public List<StockAlertOutboxMessage> outbox(MerchantStore store) { return outboxRepository.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId()); }
+    @Override @Transactional
+    public void sendForProduct(Product product, MerchantStore store) {
+        List<StockAlert> alerts = alertRepository.findByMerchantStoreIdAndProductIdAndStatusOrderByCreatedAtAsc(store.getId(), product.getId(), Status.PENDING);
+        String name = product.getProductDescription() == null ? product.getSku() : product.getProductDescription().getName();
+        for (StockAlert alert : alerts) {
+            alert.setStatus(Status.SENT); alert.setSentAt(new Date()); alertRepository.save(alert);
+            StockAlertOutboxMessage message = new StockAlertOutboxMessage();
+            message.setMerchantStoreId(store.getId()); message.setTo(alert.getEmail()); message.setSku(alert.getSku());
+            message.setSubject(name + " is back in stock"); message.setCreatedAt(new Date()); outboxRepository.save(message);
+        }
+    }
+    @Override @Transactional public void deleteForProduct(Product product) { alertRepository.deleteByProductId(product.getId()); }
+}
