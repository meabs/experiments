+import com.salesmanager.shop.model.catalog.product.stockalert.StockAlertRequest;
+import com.salesmanager.shop.model.catalog.product.stockalert.StockAlertResponse;
+import com.salesmanager.shop.model.catalog.product.stockalert.StockAlertOutboxResponse;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.api.exception.StockAlertConflictException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class StockAlertApi {
+    private static final Pattern EMAIL = Pattern.compile("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$");
+    @Inject private ProductService productService;
+    @Inject private StockAlertService stockAlertService;
+
+    @PostMapping("/products/{sku}/alerts")
+    public ResponseEntity<StockAlertResponse> request(@PathVariable String sku, @RequestBody StockAlertRequest request, @ApiIgnore MerchantStore store) {
+        if (request == null || request.getEmail() == null || !EMAIL.matcher(request.getEmail()).matches()) throw new RestApiException("Invalid email");
+        Product product = product(sku, store);
+        if (product.getAvailabilities() == null || product.getAvailabilities().stream().anyMatch(a -> a.getProductQuantity() != null && a.getProductQuantity() > 0)) throw new StockAlertConflictException();
+        boolean alreadyPending = stockAlertService.isPending(product, store, request.getEmail());
+        StockAlertResponse response = new StockAlertResponse(stockAlertService.request(product, store, request.getEmail()));
+        return ResponseEntity.status(alreadyPending ? HttpStatus.OK : HttpStatus.CREATED).body(response);
+    }
+
+    @DeleteMapping("/products/{sku}/alerts")
+    @ResponseStatus(HttpStatus.NO_CONTENT)
+    public void cancel(@PathVariable String sku, @RequestParam String email, @ApiIgnore MerchantStore store) {
+        if (!EMAIL.matcher(email == null ? "" : email).matches()) throw new RestApiException("Invalid email");
+        try { stockAlertService.cancel(product(sku, store), store, email); }
+        catch (IllegalArgumentException e) { throw new ResourceNotFoundException("Pending stock alert not found"); }
+    }
+
+    @GetMapping("/private/stock-alerts")
+    public List<StockAlertResponse> list(@RequestParam(required=false) String status, @ApiIgnore MerchantStore store) {
+        StockAlert.Status parsed = null;
+        if (status != null) try { parsed = StockAlert.Status.valueOf(status); } catch (IllegalArgumentException e) { throw new RestApiException("Invalid status"); }
+        return stockAlertService.list(store, parsed).stream().map(StockAlertResponse::new).collect(Collectors.toList());
+    }
+
+    @GetMapping("/private/stock-alerts/outbox")
+    public List<StockAlertOutboxResponse> outbox(@ApiIgnore MerchantStore store) {
+        return stockAlertService.outbox(store).stream().map(StockAlertOutboxResponse::new).collect(Collectors.toList());
+    }
+
+    private Product product(String sku, MerchantStore store) {
+        try { Product p = productService.getBySku(sku, store); if (p == null) throw new ResourceNotFoundException("Product sku [" + sku + "] not found"); return p; }
+        catch (ServiceException e) { throw new ResourceNotFoundException("Product sku [" + sku + "] not found"); }
+    }
+}
