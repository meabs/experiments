+package com.salesmanager.core.business.services.catalog.product.stockalert;
+
+import java.util.Date;
+import java.util.List;
+import java.util.Locale;
+import java.util.Optional;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.catalog.product.stockalert.StockAlertOutboxRepository;
+import com.salesmanager.core.business.repositories.catalog.product.stockalert.StockAlertRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.description.ProductDescription;
+import com.salesmanager.core.model.catalog.product.stockalert.StockAlert;
+import com.salesmanager.core.model.catalog.product.stockalert.StockAlertOutbox;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+    private static final String PENDING = "PENDING";
+    private static final String SENT = "SENT";
+    @Inject private StockAlertRepository repository;
+    @Inject private StockAlertOutboxRepository outboxRepository;
+
+    @Override @Transactional
+    public StockAlert request(Product product, MerchantStore store, String email) {
+        Optional<StockAlert> existing = repository.findByMerchantStoreIdAndSkuAndEmailIgnoreCaseAndStatus(store.getId(), product.getSku(), email, PENDING);
+        if (existing.isPresent()) return existing.get();
+        StockAlert alert = new StockAlert();
+        alert.setProduct(product); alert.setMerchantStore(store); alert.setSku(product.getSku());
+        alert.setEmail(email); alert.setStatus(PENDING); alert.setCreatedAt(new Date());
+        return repository.save(alert);
+    }
+
+    @Override @Transactional
+    public void cancel(Product product, MerchantStore store, String email) {
+        Optional<StockAlert> existing = repository.findByMerchantStoreIdAndSkuAndEmailIgnoreCaseAndStatus(store.getId(), product.getSku(), email, PENDING);
+        if (!existing.isPresent()) throw new IllegalArgumentException("Pending stock alert not found");
+        repository.delete(existing.get());
+    }
+
+    @Override @Transactional(readOnly = true)
+    public List<StockAlert> list(MerchantStore store, String status) {
+        return status == null ? repository.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId()) : repository.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(store.getId(), status);
+    }
+
+    @Override @Transactional(readOnly = true)
+    public List<StockAlertOutbox> outbox(MerchantStore store) { return outboxRepository.findByAlertMerchantStoreIdOrderByCreatedAtAsc(store.getId()); }
+
+    @Override @Transactional
+    public void sendPending(Product product, MerchantStore store) {
+        List<StockAlert> pending = repository.findByMerchantStoreIdAndSkuAndStatusOrderByCreatedAtAsc(store.getId(), product.getSku(), PENDING);
+        String name = product.getSku();
+        ProductDescription description = product.getProductDescription();
+        if (description != null && description.getName() != null) name = description.getName();
+        Date now = new Date();
+        for (StockAlert alert : pending) {
+            alert.setStatus(SENT); alert.setSentAt(now);
+            StockAlertOutbox message = new StockAlertOutbox();
+            message.setAlert(alert); message.setTo(alert.getEmail()); message.setSku(alert.getSku());
+            message.setSubject(name + " is back in stock"); message.setCreatedAt(now);
+            alert.getOutbox().add(message);
+            repository.save(alert);
+        }
+    }
+}
