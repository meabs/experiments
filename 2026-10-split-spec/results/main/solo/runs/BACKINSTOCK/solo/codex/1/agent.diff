+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.List;
+import java.util.regex.Pattern;
+import java.util.stream.Collectors;
+import javax.validation.Valid;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.stockalert.StockAlertService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.stockalert.StockAlert;
+import com.salesmanager.core.model.catalog.product.stockalert.StockAlertOutbox;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.api.exception.StockAlertConflictException;
+import com.salesmanager.shop.store.api.exception.StockAlertRequest;
+import com.salesmanager.shop.store.api.exception.StockAlertView;
+import com.salesmanager.shop.store.api.exception.StockAlertOutboxView;
+import com.salesmanager.shop.store.api.exception.StockAlertStatus;
+import springfox.documentation.annotations.ApiIgnore;
+import org.springframework.http.ResponseEntity;
+
+@RestController
+@RequestMapping("/api/v1")
+public class StockAlertApi {
+    private static final Pattern EMAIL = Pattern.compile("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$");
+    @Autowired private ProductService productService;
+    @Autowired private StockAlertService stockAlertService;
+
+    @PostMapping("/products/{sku}/alerts")
+    public ResponseEntity<StockAlertView> request(@PathVariable String sku, @Valid @RequestBody StockAlertRequest request, @ApiIgnore MerchantStore store) {
+        validateEmail(request.getEmail());
+        Product product = product(sku, store);
+        if (product.getAvailabilities() == null || product.getAvailabilities().stream().anyMatch(a -> a.getProductQuantity() != null && a.getProductQuantity() > 0)) throw new StockAlertConflictException("Product is in stock");
+        boolean duplicate = stockAlertService.list(store, StockAlertStatus.PENDING).stream().anyMatch(a -> a.getSku().equals(product.getSku()) && a.getEmail().equalsIgnoreCase(request.getEmail()));
+        StockAlert alert = stockAlertService.request(product, store, request.getEmail());
+        return ResponseEntity.status(duplicate ? HttpStatus.OK : HttpStatus.CREATED).body(StockAlertView.from(alert));
+    }
+
+    @DeleteMapping("/products/{sku}/alerts")
+    @ResponseStatus(HttpStatus.NO_CONTENT)
+    public void cancel(@PathVariable String sku, @RequestParam String email, @ApiIgnore MerchantStore store) {
+        validateEmail(email);
+        Product product = product(sku, store);
+        try { stockAlertService.cancel(product, store, email); }
+        catch (IllegalArgumentException e) { throw new ResourceNotFoundException(e.getMessage()); }
+    }
+
+    @GetMapping("/private/stock-alerts")
+    public List<StockAlertView> list(@RequestParam(required = false) String status, @ApiIgnore MerchantStore store) {
+        if (status != null && !StockAlertStatus.PENDING.equals(status) && !StockAlertStatus.SENT.equals(status)) throw new RestApiException("Invalid status");
+        return stockAlertService.list(store, status).stream().map(StockAlertView::from).collect(Collectors.toList());
+    }
+
+    @GetMapping("/private/stock-alerts/outbox")
