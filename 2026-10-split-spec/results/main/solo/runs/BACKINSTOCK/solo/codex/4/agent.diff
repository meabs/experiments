+@RestController @RequestMapping("/api/v1") public class StockAlertApi {
+ private static final Pattern EMAIL=Pattern.compile("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"); @Autowired private ProductService products; @Autowired private StockAlertService service;
+ private Product product(String sku,MerchantStore store){try{Product p=products.getBySku(sku,store);if(p==null)throw new ResourceNotFoundException("Product not found");return p;}catch(com.salesmanager.core.business.exception.ServiceException e){throw new ServiceRuntimeException("Unable to find product",e);}}
+ @PostMapping("/products/{sku}/alerts") public ResponseEntity<Map<String,Object>> request(@PathVariable String sku,@RequestParam String store,@RequestBody Map<String,String> body,@ApiIgnore MerchantStore merchantStore){String email=body==null?null:body.get("email");if(email==null||!EMAIL.matcher(email).matches())throw new RestApiException("400","Invalid email");Product p=product(sku,merchantStore);if(p.getAvailabilities()!=null&&p.getAvailabilities().stream().anyMatch(a->a.getProductQuantity()!=null&&a.getProductQuantity()>0))throw new StockConflictException("Product is in stock");StockAlert existing=service.pending(p,email);StockAlert a=existing==null?service.request(p,email):existing;Map<String,Object> out=new LinkedHashMap<>();out.put("sku",sku);out.put("email",a.getEmail());out.put("status",a.getStatus());return ResponseEntity.status(existing==null?HttpStatus.CREATED:HttpStatus.OK).body(out);}
+ @DeleteMapping("/products/{sku}/alerts") public ResponseEntity<Void> cancel(@PathVariable String sku,@RequestParam String store,@RequestParam String email,@ApiIgnore MerchantStore merchantStore){if(!EMAIL.matcher(email).matches())throw new RestApiException("400","Invalid email");try{service.cancel(product(sku,merchantStore),email);}catch(NoSuchElementException e){throw new ResourceNotFoundException("Stock alert not found");}return ResponseEntity.noContent().build();}
+ @GetMapping("/private/stock-alerts") public List<Map<String,Object>> list(@RequestParam String store,@RequestParam(required=false) String status,@ApiIgnore MerchantStore merchantStore){if(status!=null&&!status.equals("PENDING")&&!status.equals("SENT"))throw new RestApiException("400","Invalid status");return service.list(merchantStore.getId(),status).stream().map(this::view).collect(Collectors.toList());}
+ @GetMapping("/private/stock-alerts/outbox") public List<Map<String,Object>> outbox(@RequestParam String store,@ApiIgnore MerchantStore merchantStore){return service.outbox().stream().filter(m->m.getStoreId().equals(merchantStore.getId())).map(m->{Map<String,Object>x=new LinkedHashMap<>();x.put("to",m.getEmail());x.put("sku",m.getSku());x.put("subject",m.getSubject());x.put("createdAt",m.getCreatedAt());return x;}).collect(Collectors.toList());}
+ private Map<String,Object> view(StockAlert a){Map<String,Object>x=new LinkedHashMap<>();x.put("id",a.getId());x.put("sku",a.getProduct().getSku());x.put("email",a.getEmail());x.put("status",a.getStatus());x.put("createdAt",a.getCreatedAt());x.put("sentAt",a.getSentAt());return x;}
+}
