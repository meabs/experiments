+package com.salesmanager.core.business.services.catalog.product.stockalert;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.catalog.product.stockalert.*;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.description.ProductDescription;
+import com.salesmanager.core.model.catalog.product.stockalert.*;
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+ @Inject private StockAlertRepository alerts;
+ @Inject private StockAlertMessageRepository messages;
+ @Override @Transactional public StockAlert request(Product product, String email) {
+  StockAlert a=alerts.findFirstByProductIdAndEmailIgnoreCaseAndStatus(product.getId(),email,"PENDING");
+  if(a!=null) return a;
+  a=new StockAlert(); a.setProduct(product); a.setEmail(email); return alerts.save(a);
+ }
+ @Override public StockAlert pending(Product product, String email) { return alerts.findFirstByProductIdAndEmailIgnoreCaseAndStatus(product.getId(), email, "PENDING"); }
+ @Override @Transactional public void cancel(Product product,String email) {
+  StockAlert a=alerts.findFirstByProductIdAndEmailIgnoreCaseAndStatus(product.getId(),email,"PENDING");
+  if(a==null) throw new NoSuchElementException("Stock alert not found");
+  alerts.delete(a);
+ }
+ @Override public List<StockAlert> list(Integer storeId,String status) { return status==null?alerts.findByProductMerchantStoreIdOrderByCreatedAtAsc(storeId):alerts.findByProductMerchantStoreIdAndStatusOrderByCreatedAtAsc(storeId,status); }
+ @Override public List<StockAlertMessage> outbox(){return messages.findAllByOrderByCreatedAtAsc();}
+ @Override @Transactional public void sendPending(Product product) {
+  for(StockAlert a:alerts.findByProductIdAndStatusOrderByCreatedAtAsc(product.getId(),"PENDING")) {
+   StockAlertMessage m=new StockAlertMessage(); m.setEmail(a.getEmail()); m.setSku(product.getSku());
+   ProductDescription d=product.getProductDescription(); m.setStore(product.getMerchantStore()); m.setSubject((d==null?product.getSku():d.getName())+" is back in stock"); messages.save(m);
+   a.setStatus("SENT"); a.setSentAt(new Date()); alerts.save(a);
+  }
+ }
+}
