+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.math.BigDecimal;
+import java.security.Principal;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.List;
+import java.util.Set;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+
+import com.salesmanager.core.business.services.catalog.pricing.PricingService;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.customer.WishlistService;
+import com.salesmanager.core.business.services.shoppingcart.ShoppingCartService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.FinalPrice;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.WishlistItem;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.store.api.exception.ConflictException;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.api.exception.UnauthorizedException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class WishlistApi {
+    @Inject private WishlistService wishlistService;
+    @Inject private ProductService productService;
+    @Inject private PricingService pricingService;
+    @Inject private ShoppingCartService shoppingCartService;
+    @Inject private ShoppingCartFacade shoppingCartFacade;
+    @Inject private CustomerFacade customerFacade;
+
+    public static class Request { private String product; public String getProduct() { return product; } public void setProduct(String product) { this.product = product; } }
+    public static class Item { public String sku; public String name; public BigDecimal price; public boolean available; public Date addedAt; }
+    public static class Wishlist { public int count; public List<Item> items = new ArrayList<>(); }
+    public static class Popular { public String sku; public long count; public Popular(String sku, long count) { this.sku=sku; this.count=count; } }
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal p = request.getUserPrincipal();
+        if (p == null) throw new UnauthorizedException("Customer authentication is required");
+        Customer c = customerFacade.getCustomerByUserName(p.getName(), store);
+        if (c == null) throw new ResourceNotFoundException("Customer not found");
+        return c;
+    }
+    private Product product(String sku, MerchantStore store) throws Exception {
+        Product p = productService.getBySku(sku, store);
+        if (p == null) throw new ResourceNotFoundException("Product [" + sku + "] not found");
+        return p;
+    }
+    private boolean available(Product p) {
+        if (!p.isAvailable() || p.getAvailabilities() == null) return false;
+        for (ProductAvailability a : p.getAvailabilities()) if (a.getProductQuantity() != null && a.getProductQuantity() > 0 && a.getAvailable() != Boolean.FALSE && a.getProductStatus()) return true;
+        return false;
+    }
+    private Wishlist view(Customer c) throws Exception {
+        Wishlist w = new Wishlist();
+        for (WishlistItem wi : wishlistService.findByCustomer(c)) {
+            Product p = wi.getProduct(); Item i = new Item(); i.sku=p.getSku(); i.name=p.getProductDescription() == null ? null : p.getProductDescription().getName();
+            FinalPrice fp = pricingService.calculateProductPrice(p); i.price=fp.getFinalPrice(); i.available=available(p); i.addedAt=wi.getAddedAt(); w.items.add(i);
+        }
+        w.count=w.items.size(); return w;
+    }
+    @PostMapping("/auth/customer/wishlist")
+    public ResponseEntity<Wishlist> add(@RequestBody Request request, @ApiIgnore MerchantStore store, HttpServletRequest http) throws Exception {
+        if (request == null || request.getProduct() == null || request.getProduct().trim().isEmpty()) throw new RestApiException("400", "product is required");
+        Customer c=customer(http,store); Product p=product(request.getProduct(),store); WishlistItem existing=wishlistService.find(c,p);
+        if (existing == null && wishlistService.findByCustomer(c).size() >= 50) throw new RestApiException("400", "Wishlist cannot contain more than 50 products");
+        boolean created=existing == null; wishlistService.add(c,p); return new ResponseEntity<>(view(c), created ? HttpStatus.CREATED : HttpStatus.OK);
+    }
+    @GetMapping("/auth/customer/wishlist")
+    public Wishlist get(@ApiIgnore MerchantStore store, HttpServletRequest http) throws Exception { return view(customer(http,store)); }
+    @DeleteMapping("/auth/customer/wishlist/{sku}")
+    public ResponseEntity<Void> remove(@PathVariable String sku, @ApiIgnore MerchantStore store, HttpServletRequest http) throws Exception { Customer c=customer(http,store); Product p=product(sku,store); if (wishlistService.find(c,p)==null) throw new ResourceNotFoundException("Product is not on wishlist"); wishlistService.remove(c,p); return ResponseEntity.noContent().build(); }
+    @PostMapping("/auth/customer/wishlist/{sku}/cart/{cartCode}")
+    public ReadableShoppingCart move(@PathVariable String sku, @PathVariable String cartCode, @ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest http) throws Exception {
+        Customer c=customer(http,store); Product p=product(sku,store); if (wishlistService.find(c,p)==null) throw new ResourceNotFoundException("Product is not on wishlist");
+        if (!available(p)) throw new ConflictException("Product is not available or has no stock"); ShoppingCart cart=shoppingCartService.getByCode(cartCode,store); if (cart==null) throw new ResourceNotFoundException("Cart not found");
+        int quantity=1; if (cart.getLineItems()!=null) for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem item:cart.getLineItems()) if (p.getId().equals(item.getProduct().getId())) quantity=item.getQuantity()+1;
+        PersistableShoppingCartItem item=new PersistableShoppingCartItem(); item.setProduct(sku); item.setQuantity(quantity);
+        try { ReadableShoppingCart result=shoppingCartFacade.modifyCart(cartCode,item,store,language); wishlistService.remove(c,p); return result; } catch (Exception e) { throw new RestApiException("400", e.getMessage(), e); }
+    }
+    @GetMapping("/private/wishlists/popular")
+    public List<Popular> popular(@ApiIgnore MerchantStore store) { List<Popular> result=new ArrayList<>(); for(Object[] row:wishlistService.popular(store.getId())) { result.add(new Popular((String)row[0], ((Number)row[1]).longValue())); if(result.size()==10) break; } return result; }
+}
