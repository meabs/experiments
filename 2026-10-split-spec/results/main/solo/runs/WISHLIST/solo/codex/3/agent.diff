+package com.salesmanager.core.business.services.customer;
+import java.util.Date;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.customer.WishlistItemRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.WishlistItem;
+@Service("wishlistService")
+public class WishlistServiceImpl implements WishlistService {
+    private final WishlistItemRepository repository;
+    @Inject public WishlistServiceImpl(WishlistItemRepository repository) { this.repository = repository; }
+    @Override @Transactional(readOnly = true) public List<WishlistItem> findByCustomer(Customer c) { return repository.findByCustomerIdOrderByAddedAtDesc(c.getId()); }
+    @Override @Transactional(readOnly = true) public WishlistItem find(Customer c, Product p) { return repository.findByCustomerIdAndProductId(c.getId(), p.getId()); }
+    @Override @Transactional public WishlistItem add(Customer c, Product p) { WishlistItem old = find(c,p); if (old != null) return old; WishlistItem i = new WishlistItem(); i.setCustomer(c); i.setProduct(p); i.setAddedAt(new Date()); return repository.save(i); }
+    @Override @Transactional public void remove(Customer c, Product p) { repository.deleteByCustomerIdAndProductId(c.getId(), p.getId()); }
+    @Override @Transactional public void removeProduct(Product p) { repository.deleteByProductId(p.getId()); }
+    @Override @Transactional(readOnly = true) public List<Object[]> popular(Integer storeId) { return repository.popular(storeId); }
+}
