+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.security.Principal;
+import java.util.ArrayList;
+import java.util.List;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.pricing.PricingService;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.customer.WishlistService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.FinalPrice;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.WishlistItem;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.model.wishlist.*;
+import com.salesmanager.shop.store.api.exception.*;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class WishlistApi {
+    @Inject private WishlistService wishlistService;
+    @Inject private CustomerFacade customerFacade;
+    @Inject private ProductService productService;
+    @Inject private PricingService pricingService;
+    @Inject private ShoppingCartFacade shoppingCartFacade;
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal p = request.getUserPrincipal();
+        if (p == null) throw new UnauthorizedException();
+        Customer c = customerFacade.getCustomerByUserName(p.getName(), store);
+        if (c == null) throw new UnauthorizedException();
+        return c;
+    }
+    private Product product(String sku, MerchantStore store, Language language) {
+        if (sku == null || sku.trim().isEmpty()) throw new RestApiException("400", "product is required");
+        try { Product p = productService.getBySku(sku, store, language); if (p == null) throw new ResourceNotFoundException("Product ["+sku+"] not found"); return p; }
+        catch (ResourceNotFoundException e) { throw e; } catch (Exception e) { throw new ServiceRuntimeException(e); }
+    }
+    private Wishlist dto(Customer c, MerchantStore store, Language language) {
+        Wishlist out = new Wishlist(); List<WishlistItem> rows = wishlistService.list(c, store); out.setCount(rows.size());
+        for (WishlistItem row : rows) { Product p = product(row.getSku(), store, language); WishlistItemDto(row, p, out); }
+        return out;
+    }
+    private void WishlistItemDto(WishlistItem row, Product p, Wishlist out) {
+        com.salesmanager.shop.model.wishlist.WishlistItem x = new com.salesmanager.shop.model.wishlist.WishlistItem(); x.setSku(row.getSku());
+        x.setName(p.getProductDescription() == null ? null : p.getProductDescription().getName()); x.setAddedAt(row.getAddedAt());
+        try { FinalPrice fp = pricingService.calculateProductPrice(p); x.setPrice(fp.getFinalPrice()); } catch (Exception ignored) { }
+        boolean stock = false; if (p.getAvailabilities() != null) for (ProductAvailability a : p.getAvailabilities()) if (a.getProductQuantity() != null && a.getProductQuantity() > 0) stock = true;
+        x.setAvailable(p.isAvailable() && stock); out.getItems().add(x);
+    }
+    @GetMapping("/auth/customer/wishlist")
+    public Wishlist get(@ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest request) { return dto(customer(request, store), store, language); }
+    @PostMapping("/auth/customer/wishlist")
+    public ResponseEntity<Wishlist> add(@RequestBody WishlistRequest requestBody, @ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest request) {
+        Customer c = customer(request, store); Product p = product(requestBody == null ? null : requestBody.getProduct(), store, language); String sku = requestBody.getProduct();
+        if (wishlistService.find(c, store, sku) != null) return ResponseEntity.ok(dto(c, store, language));
+        if (wishlistService.count(c, store) >= 50) throw new RestApiException("400", "Wishlist cannot contain more than 50 products");
+        WishlistItem row = new WishlistItem(); row.setCustomer(c); row.setStore(store); row.setSku(sku);
+        try { wishlistService.add(row); } catch (Exception e) { throw new ServiceRuntimeException(e); }
+        return new ResponseEntity<>(dto(c, store, language), HttpStatus.CREATED);
+    }
+    @DeleteMapping("/auth/customer/wishlist/{sku}")
+    public ResponseEntity<Void> remove(@PathVariable String sku, @ApiIgnore MerchantStore store, HttpServletRequest request) { Customer c=customer(request,store); if(wishlistService.find(c,store,sku)==null) throw new ResourceNotFoundException("Wishlist item not found"); wishlistService.remove(c,store,sku); return ResponseEntity.noContent().build(); }
+    @PostMapping("/auth/customer/wishlist/{sku}/cart/{cartCode}")
+    public ResponseEntity<ReadableShoppingCart> move(@PathVariable String sku, @PathVariable String cartCode, @ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest request) {
+        Customer c=customer(request,store); if(wishlistService.find(c,store,sku)==null) throw new ResourceNotFoundException("Wishlist item not found"); Product p=product(sku,store,language);
+        boolean stock=false; if(p.getAvailabilities()!=null) for(ProductAvailability a:p.getAvailabilities()) if(a.getProductQuantity()!=null&&a.getProductQuantity()>0) stock=true;
+        if(!p.isAvailable()||!stock) throw new WishlistConflictException("Product is not available");
+        PersistableShoppingCartItem item=new PersistableShoppingCartItem(); item.setProduct(sku); item.setQuantity(1);
+        try { com.salesmanager.core.model.shoppingcart.ShoppingCart model=shoppingCartFacade.getShoppingCartModel(cartCode,store); if(model==null) throw new ResourceNotFoundException("Cart not found");
+            int quantity=0; if(model.getLineItems()!=null) for(com.salesmanager.core.model.shoppingcart.ShoppingCartItem line:model.getLineItems()) if(line.getProduct().getSku().equals(sku)) quantity=line.getQuantity();
+            item.setQuantity(quantity+1); ReadableShoppingCart cart=shoppingCartFacade.modifyCart(cartCode,item,store,language); wishlistService.remove(c,store,sku); return ResponseEntity.ok(cart); }
+        catch(ResourceNotFoundException e){throw e;} catch(Exception e){throw new ServiceRuntimeException(e);}
+    }
+    @GetMapping("/private/wishlists/popular")
+    public List<PopularWishlistItem> popular(@ApiIgnore MerchantStore store) { List<PopularWishlistItem> out=new ArrayList<>(); for(Object[] row:wishlistService.popular(store)){out.add(new PopularWishlistItem((String)row[0],((Number)row[1]).longValue())); if(out.size()==10)break;} return out; }
+}
