+package com.salesmanager.core.business.services.customer;
+
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.customer.WishlistRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.WishlistItem;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("wishlistService")
+public class WishlistServiceImpl extends SalesManagerEntityServiceImpl<Long, WishlistItem> implements WishlistService {
+    private final WishlistRepository repository;
+    @Inject public WishlistServiceImpl(WishlistRepository repository) { super(repository); this.repository = repository; }
+    public List<WishlistItem> list(Customer c, MerchantStore s) { return repository.findByCustomerIdAndStoreIdOrderByAddedAtDesc(c.getId(), s.getId()); }
+    public WishlistItem find(Customer c, MerchantStore s, String sku) { return repository.findByCustomerIdAndStoreIdAndSku(c.getId(), s.getId(), sku); }
+    public void add(WishlistItem item) throws ServiceException { save(item); }
+    public void remove(Customer c, MerchantStore s, String sku) { repository.deleteByCustomerIdAndStoreIdAndSku(c.getId(), s.getId(), sku); }
+    public long count(Customer c, MerchantStore s) { return repository.countByCustomerIdAndStoreId(c.getId(), s.getId()); }
+    public List<Object[]> popular(MerchantStore s) { return repository.popular(s.getId()); }
+}
