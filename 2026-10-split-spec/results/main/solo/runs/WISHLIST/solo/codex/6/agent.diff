+package com.salesmanager.core.business.services.wishlist;
+
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.wishlist.WishlistRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.wishlist.WishlistItem;
+
+@Service("wishlistService")
+public class WishlistServiceImpl implements WishlistService {
+    private static final int MAX_ITEMS = 50;
+    @Inject private WishlistRepository repository;
+
+    public WishlistItem find(Customer customer, Product product) { return repository.findByCustomerIdAndProductId(customer.getId(), product.getId()); }
+    public List<WishlistItem> list(Customer customer, MerchantStore store) { return repository.findByCustomerIdAndMerchantStoreIdOrderByAddedAtDesc(customer.getId(), store.getId()); }
+
+    @Transactional
+    public WishlistItem add(Customer customer, Product product, MerchantStore store) throws ServiceException {
+        WishlistItem existing = find(customer, product);
+        if (existing != null) return existing;
+        if (list(customer, store).size() >= MAX_ITEMS) throw new ServiceException("Wishlist cannot contain more than 50 products");
+        WishlistItem item = new WishlistItem();
+        item.setCustomer(customer); item.setProduct(product); item.setMerchantStore(store);
+        return repository.save(item);
+    }
+
+    @Transactional public void remove(Customer customer, Product product) { repository.deleteByCustomerIdAndProductId(customer.getId(), product.getId()); }
+    @Transactional public void removeProduct(Product product) { repository.deleteByProductId(product.getId()); }
+    public List<Object[]> popular(MerchantStore store) { return repository.popular(store.getId()); }
+}
