+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.math.BigDecimal;
+import java.security.Principal;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.List;
+
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+import org.springframework.web.bind.annotation.ResponseStatus;
+
+import com.salesmanager.core.business.services.catalog.pricing.PricingService;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.wishlist.WishlistService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.FinalPrice;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.core.model.wishlist.WishlistItem;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/auth/customer/wishlist")
+public class WishlistApi {
+    @Inject private WishlistService wishlistService;
+    @Inject private ProductService productService;
+    @Inject private PricingService pricingService;
+    @Inject private CustomerFacade customerFacade;
+    @Inject private ShoppingCartFacade shoppingCartFacade;
+
+    @PostMapping
+    public ResponseEntity<Wishlist> add(@RequestBody WishlistRequest request, @ApiIgnore MerchantStore store,
+            @ApiIgnore Language language, HttpServletRequest servletRequest) {
+        if (request == null || request.getProduct() == null || request.getProduct().trim().isEmpty()) throw new WishlistBadRequest("product is required");
+        Customer customer = customer(servletRequest, store);
+        Product product = product(request.getProduct(), store, language);
+        boolean duplicate = wishlistService.find(customer, product) != null;
+        try { wishlistService.add(customer, product, store); }
+        catch (Exception e) { throw new WishlistBadRequest(e.getMessage()); }
+        return new ResponseEntity<>(read(customer, store, language), duplicate ? HttpStatus.OK : HttpStatus.CREATED);
+    }
+
+    @GetMapping
+    public Wishlist get(@ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest request) {
+        return read(customer(request, store), store, language);
+    }
+
+    @DeleteMapping("/{sku}")
+    @ResponseStatus(HttpStatus.NO_CONTENT)
+    public void remove(@PathVariable String sku, @ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest request) {
+        Customer customer = customer(request, store); Product product = product(sku, store, language);
+        if (wishlistService.find(customer, product) == null) throw new ResourceNotFoundException("Product is not on the wishlist");
+        wishlistService.remove(customer, product);
+    }
+
+    @PostMapping("/{sku}/cart/{cartCode}")
+    public ReadableShoppingCart move(@PathVariable String sku, @PathVariable String cartCode, @ApiIgnore MerchantStore store,
+            @ApiIgnore Language language, HttpServletRequest request) {
+        Customer customer = customer(request, store); Product product = product(sku, store, language);
+        if (wishlistService.find(customer, product) == null) throw new ResourceNotFoundException("Product is not on the wishlist");
+        if (!available(product)) throw new WishlistConflict("Product is not available");
+        PersistableShoppingCartItem item = new PersistableShoppingCartItem(); item.setProduct(sku); item.setQuantity(1);
+        try {
+            ReadableShoppingCart cart = shoppingCartFacade.modifyCart(cartCode, item, store, language);
+            wishlistService.remove(customer, product);
+            return cart;
+        } catch (ResourceNotFoundException e) { throw e; }
+        catch (Exception e) { throw new WishlistConflict("Product cannot be added to the cart"); }
+    }
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal principal = request.getUserPrincipal();
+        if (principal == null) throw new WishlistUnauthorized();
+        Customer customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (customer == null) throw new WishlistUnauthorized();
+        return customer;
+    }
+    private Product product(String sku, MerchantStore store, Language language) {
+        try { Product p = productService.getBySku(sku, store, language); if (p == null) throw new ResourceNotFoundException("Product not found"); return p; }
+        catch (ResourceNotFoundException e) { throw e; } catch (Exception e) { throw new ResourceNotFoundException("Product not found"); }
+    }
+    private boolean available(Product p) {
+        if (!p.isAvailable() || p.getDateAvailable() == null || p.getDateAvailable().after(new Date())) return false;
+        return p.getAvailabilities() != null && p.getAvailabilities().stream().anyMatch(a -> a.getProductQuantity() != null && a.getProductQuantity() > 0 && (a.getAvailable() == null || a.getAvailable()));
+    }
+    private Wishlist read(Customer customer, MerchantStore store, Language language) {
+        Wishlist result = new Wishlist(); List<WishlistEntry> entries = new ArrayList<>();
+        for (WishlistItem item : wishlistService.list(customer, store)) {
+            Product p = item.getProduct(); WishlistEntry entry = new WishlistEntry(); entry.setSku(p.getSku());
+            entry.setName(p.getDescriptions().stream().filter(d -> language == null || d.getLanguage().getId().equals(language.getId())).findFirst().map(d -> d.getName()).orElse(p.getSku()));
+            try { FinalPrice price = pricingService.calculateProductPrice(p); entry.setPrice(price.getFinalPrice()); } catch (Exception ignored) { entry.setPrice(BigDecimal.ZERO); }
+            entry.setAvailable(available(p)); entry.setAddedAt(item.getAddedAt()); entries.add(entry);
+        }
+        result.setCount(entries.size()); result.setItems(entries); return result;
+    }
+
+    public static class WishlistRequest { private String product; public String getProduct() { return product; } public void setProduct(String product) { this.product = product; } }
+    public static class Wishlist { private int count; private List<WishlistEntry> items; public int getCount(){return count;} public void setCount(int c){count=c;} public List<WishlistEntry> getItems(){return items;} public void setItems(List<WishlistEntry> i){items=i;} }
+    public static class WishlistEntry { private String sku,name; private BigDecimal price; private boolean available; private Date addedAt; public String getSku(){return sku;} public void setSku(String v){sku=v;} public String getName(){return name;} public void setName(String v){name=v;} public BigDecimal getPrice(){return price;} public void setPrice(BigDecimal v){price=v;} public boolean isAvailable(){return available;} public void setAvailable(boolean v){available=v;} public Date getAddedAt(){return addedAt;} public void setAddedAt(Date v){addedAt=v;} }
+}
