+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.wishlist.WishlistService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/wishlists")
+public class WishlistAdminApi {
+    @Inject private WishlistService wishlistService;
+
+    @GetMapping("/popular")
+    public List<PopularWishlistProduct> popular(@ApiIgnore MerchantStore store) {
+        List<PopularWishlistProduct> result = new ArrayList<>();
+        for (Object[] row : wishlistService.popular(store)) {
+            result.add(new PopularWishlistProduct((String) row[0], ((Number) row[1]).longValue()));
+            if (result.size() == 10) break;
+        }
+        return result;
+    }
+
+    public static class PopularWishlistProduct {
+        private String sku; private long count;
+        public PopularWishlistProduct(String sku, long count) { this.sku = sku; this.count = count; }
+        public String getSku() { return sku; } public long getCount() { return count; }
+    }
+}
