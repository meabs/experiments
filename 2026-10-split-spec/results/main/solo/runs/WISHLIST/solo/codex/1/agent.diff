+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.math.BigDecimal;
+import java.security.Principal;
+import java.util.ArrayList;
+import java.util.List;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+import com.salesmanager.core.business.services.catalog.pricing.PricingService;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.customer.WishlistService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.price.FinalPrice;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.WishlistItem;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.store.api.exception.ConflictException;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class WishlistApi {
+    @Inject private WishlistService wishlistService;
+    @Inject private ProductService productService;
+    @Inject private PricingService pricingService;
+    @Inject private CustomerFacade customerFacade;
+    @Inject private ShoppingCartFacade shoppingCartFacade;
+
+    @PostMapping("/auth/customer/wishlist")
+    public ResponseEntity<WishlistResponse> add(@RequestBody WishlistRequest request, @ApiIgnore MerchantStore store,
+            @ApiIgnore Language language, HttpServletRequest httpRequest) {
+        if (request == null || request.getProduct() == null || request.getProduct().trim().isEmpty())
+            throw new ServiceRuntimeException("400", "product is required");
+        Customer customer = customer(httpRequest, store);
+        Product product = product(request.getProduct(), store, language);
+        boolean duplicate = wishlistService.find(customer, request.getProduct(), store) != null;
+        try { wishlistService.add(customer, product); } catch (Exception e) { throw new ServiceRuntimeException("400", e.getMessage(), e); }
+        return new ResponseEntity<>(response(customer, store), duplicate ? HttpStatus.OK : HttpStatus.CREATED);
+    }
+
+    @GetMapping("/auth/customer/wishlist")
+    public WishlistResponse get(@ApiIgnore MerchantStore store, HttpServletRequest request) { return response(customer(request, store), store); }
+
+    @DeleteMapping("/auth/customer/wishlist/{sku}")
+    public ResponseEntity<Void> remove(@PathVariable String sku, @ApiIgnore MerchantStore store, HttpServletRequest request) {
+        try { wishlistService.remove(customer(request, store), sku, store); }
+        catch (Exception e) { throw new ResourceNotFoundException("Product is not on the wishlist"); }
+        return ResponseEntity.noContent().build();
+    }
+
+    @PostMapping("/auth/customer/wishlist/{sku}/cart/{cartCode}")
+    public ReadableShoppingCart move(@PathVariable String sku, @PathVariable String cartCode, @ApiIgnore MerchantStore store,
+            @ApiIgnore Language language, HttpServletRequest request) {
+        Customer customer = customer(request, store);
+        WishlistItem wishlist = wishlistService.find(customer, sku, store);
+        if (wishlist == null) throw new ResourceNotFoundException("Product is not on the wishlist");
+        try {
+            com.salesmanager.core.model.shoppingcart.ShoppingCart cart = shoppingCartFacade.getShoppingCartModel(cartCode, store);
+            if (cart == null) throw new ResourceNotFoundException("Cart not found");
+            int quantity = cart.getLineItems().stream().filter(i -> sku.equals(i.getSku())).mapToInt(i -> i.getQuantity()).findFirst().orElse(0) + 1;
+            PersistableShoppingCartItem item = new PersistableShoppingCartItem(); item.setProduct(sku); item.setQuantity(quantity);
+            ReadableShoppingCart result = shoppingCartFacade.modifyCart(cartCode, item, store, language);
+            wishlistService.remove(customer, sku, store);
+            return result;
+        } catch (ResourceNotFoundException e) { throw e; }
+        catch (Exception e) { throw new ConflictException("Product is not available or has no stock"); }
+    }
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal principal = request.getUserPrincipal();
+        if (principal == null) throw new ResourceNotFoundException("Customer not found");
+        Customer customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (customer == null) throw new ResourceNotFoundException("Customer not found");
+        return customer;
+    }
+
+    private Product product(String sku, MerchantStore store, Language language) {
+        try { return productService.getBySku(sku, store, language); }
+        catch (Exception e) { throw new ResourceNotFoundException("Product with sku " + sku + " does not exist"); }
+    }
+
+    private WishlistResponse response(Customer customer, MerchantStore store) {
+        List<WishlistEntry> entries = new ArrayList<>();
+        for (WishlistItem item : wishlistService.get(customer, store)) {
+            Product product = item.getProduct();
+            BigDecimal price = BigDecimal.ZERO;
+            try { FinalPrice p = pricingService.calculateProductPrice(product); if (p != null && p.getFinalPrice() != null) price = p.getFinalPrice(); } catch (Exception ignored) { }
+            String name = product.getProductDescription() == null ? product.getSku() : product.getProductDescription().getName();
+            boolean available = product.isAvailable() && product.getAvailabilities() != null && product.getAvailabilities().stream().anyMatch(a -> a.getProductQuantity() != null && a.getProductQuantity() > 0);
+            entries.add(new WishlistEntry(product.getSku(), name, price, available, item.getAddedAt()));
+        }
+        return new WishlistResponse(entries);
+    }
+
+    public static class WishlistRequest { private String product; public String getProduct() { return product; } public void setProduct(String product) { this.product = product; } }
+    public static class WishlistResponse { private final int count; private final List<WishlistEntry> items; public WishlistResponse(List<WishlistEntry> items) { this.count = items.size(); this.items = items; } public int getCount() { return count; } public List<WishlistEntry> getItems() { return items; } }
+    public static class WishlistEntry { private final String sku; private final String name; private final BigDecimal price; private final boolean available; private final java.util.Date addedAt; public WishlistEntry(String sku,String name,BigDecimal price,boolean available,java.util.Date addedAt){this.sku=sku;this.name=name;this.price=price;this.available=available;this.addedAt=addedAt;} public String getSku(){return sku;} public String getName(){return name;} public BigDecimal getPrice(){return price;} public boolean isAvailable(){return available;} public java.util.Date getAddedAt(){return addedAt;} }
+}
