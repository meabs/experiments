+package com.salesmanager.core.business.services.customer;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.customer.WishlistRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.WishlistItem;
+import com.salesmanager.core.model.customer.PopularWishlistProduct;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("wishlistService")
+public class WishlistServiceImpl implements WishlistService {
+    private static final int MAX_ITEMS = 50;
+    private final WishlistRepository repository;
+
+    @Inject
+    public WishlistServiceImpl(WishlistRepository repository) { this.repository = repository; }
+
+    @Override public List<WishlistItem> get(Customer customer, MerchantStore store) { return repository.findByCustomerAndStore(customer.getId(), store.getId()); }
+
+    @Override @Transactional
+    public WishlistItem add(Customer customer, Product product) throws ServiceException {
+        if (repository.findByCustomerIdAndProductId(customer.getId(), product.getId()).isPresent()) return null;
+        if (repository.findByCustomerAndStore(customer.getId(), product.getMerchantStore().getId()).size() >= MAX_ITEMS)
+            throw new ServiceException("Wishlist cannot contain more than 50 products");
+        WishlistItem item = new WishlistItem(); item.setCustomer(customer); item.setProduct(product); item.setAddedAt(new java.util.Date());
+        return repository.save(item);
+    }
+
+    @Override @Transactional
+    public void remove(Customer customer, String sku, MerchantStore store) throws ServiceException {
+        WishlistItem item = find(customer, sku, store);
+        if (item == null) throw new ServiceException("Product is not on the wishlist");
+        repository.delete(item);
+    }
+
+    @Override public WishlistItem find(Customer customer, String sku, MerchantStore store) {
+        return repository.findByCustomerSkuAndStore(customer.getId(), sku, store.getId()).orElse(null);
+    }
+
+    @Override public List<PopularWishlistProduct> popular(MerchantStore store) {
+        Map<Long, String> skus = new LinkedHashMap<>();
+        Map<Long, Integer> counts = new LinkedHashMap<>();
+        for (WishlistItem item : repository.findByStore(store.getId())) {
+            Long productId = item.getProduct().getId();
+            skus.putIfAbsent(productId, item.getProduct().getSku()); counts.put(productId, counts.getOrDefault(productId, 0) + 1);
+        }
+        List<PopularWishlistProduct> result = new ArrayList<>();
+        counts.forEach((id, count) -> result.add(new PopularWishlistProduct(skus.get(id), count)));
+        result.sort(Comparator.comparingInt(PopularWishlistProduct::getCount).reversed().thenComparing(PopularWishlistProduct::getSku));
+        return result.size() > 10 ? result.subList(0, 10) : result;
+    }
+
+    @Override @Transactional public void removeProduct(Product product) { repository.deleteByProductId(product.getId()); }
+}
