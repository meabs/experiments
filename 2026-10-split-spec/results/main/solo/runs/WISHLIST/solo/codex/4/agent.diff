+import org.springframework.data.repository.query.Param;
+
+import com.salesmanager.core.model.customer.WishlistItem;
+
+public interface WishlistItemRepository extends JpaRepository<WishlistItem, Long> {
+    @Query("select w from WishlistItem w join fetch w.product p join fetch w.customer c where c.id = :customerId and p.merchantStore.id = :storeId order by w.addedAt desc")
