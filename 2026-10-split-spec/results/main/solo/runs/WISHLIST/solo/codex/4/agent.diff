+package com.salesmanager.core.business.services.customer;
+
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.customer.WishlistItemRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.WishlistItem;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("wishlistService")
+public class WishlistServiceImpl implements WishlistService {
+    private final WishlistItemRepository repository;
+    @Inject public WishlistServiceImpl(WishlistItemRepository repository) { this.repository = repository; }
+    @Override @Transactional(readOnly = true)
+    public List<WishlistItem> list(Customer customer, MerchantStore store) throws ServiceException { return repository.findForCustomer(customer.getId(), store.getId()); }
+    @Override @Transactional(readOnly = true)
+    public WishlistItem find(Customer customer, Product product) throws ServiceException { return repository.findByCustomerIdAndProductId(customer.getId(), product.getId()); }
+    @Override @Transactional
+    public WishlistItem add(Customer customer, Product product, MerchantStore store) throws ServiceException {
+        WishlistItem existing = find(customer, product);
+        if (existing != null) return existing;
+        if (repository.findForCustomer(customer.getId(), store.getId()).size() >= 50) throw new IllegalArgumentException("Wishlist cannot contain more than 50 products");
+        return repository.saveAndFlush(new WishlistItem(customer, product));
+    }
+    @Override @Transactional
+    public void remove(Customer customer, Product product) throws ServiceException { repository.deleteForCustomer(customer.getId(), product.getId()); }
+    @Override @Transactional
+    public void removeProduct(Product product) throws ServiceException { repository.deleteForProduct(product.getId()); }
+    @Override @Transactional(readOnly = true)
+    public List<Object[]> popular(MerchantStore store) throws ServiceException { return repository.popular(store.getId()); }
+}
