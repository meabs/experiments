+    @Modifying
+    @Query("delete from WishlistItem w where w.product.id = :productId")
+    void deleteForProduct(@Param("productId") Long productId);
+    @Query("select w.product.sku, count(distinct w.customer.id) from WishlistItem w where w.product.merchantStore.id = :storeId group by w.product.sku order by count(distinct w.customer.id) desc, w.product.sku asc")
