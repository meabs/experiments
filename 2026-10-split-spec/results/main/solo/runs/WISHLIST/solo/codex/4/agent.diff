+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.math.BigDecimal;
+import java.security.Principal;
+import java.util.ArrayList;
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.security.core.Authentication;
+import org.springframework.security.core.context.SecurityContextHolder;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.pricing.PricingService;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.business.services.customer.WishlistService;
+import com.salesmanager.core.business.services.shoppingcart.ShoppingCartService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.FinalPrice;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.WishlistItem;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.shop.model.customer.PopularWishlistData;
+import com.salesmanager.shop.model.customer.WishlistData;
+import com.salesmanager.shop.model.customer.WishlistItemData;
+import com.salesmanager.shop.model.customer.WishlistRequest;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+import com.salesmanager.shop.store.security.user.JWTUser;
+import com.salesmanager.shop.store.controller.store.facade.StoreFacade;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class WishlistApi {
+    @Inject private WishlistService wishlistService;
+    @Inject private CustomerService customerService;
+    @Inject private ProductService productService;
+    @Inject private PricingService pricingService;
+    @Inject private ShoppingCartService shoppingCartService;
+    @Inject private ShoppingCartFacade shoppingCartFacade;
+    @Inject private StoreFacade storeFacade;
+    @Inject private CustomerFacade customerFacade;
+
+    @PostMapping("/auth/customer/wishlist")
+    public ResponseEntity<?> add(@RequestBody WishlistRequest request, @ApiIgnore MerchantStore store) throws Exception {
+        if (request == null || request.getProduct() == null || request.getProduct().trim().isEmpty()) return ResponseEntity.badRequest().build();
+        Customer customer = customer();
+        Product product = lookup(request.getProduct(), store);
+        if (product == null) return ResponseEntity.notFound().build();
+        WishlistItem existing = wishlistService.find(customer, product);
+        try {
+            wishlistService.add(customer, product, store);
+        } catch (IllegalArgumentException e) {
+            return ResponseEntity.badRequest().build();
+        }
+        return new ResponseEntity<>(data(customer, store), existing == null ? HttpStatus.CREATED : HttpStatus.OK);
+    }
+
+    @GetMapping("/auth/customer/wishlist")
+    public WishlistData get(@ApiIgnore MerchantStore store) throws Exception { return data(customer(), store); }
+
+    @DeleteMapping("/auth/customer/wishlist/{sku}")
+    public ResponseEntity<Void> remove(@PathVariable String sku, @ApiIgnore MerchantStore store) throws Exception {
+        Customer customer = customer(); Product product = lookup(sku, store);
+        WishlistItem item = product == null ? null : wishlistService.find(customer, product);
+        if (item == null) return ResponseEntity.notFound().build();
+        wishlistService.remove(customer, product); return ResponseEntity.noContent().build();
+    }
+
+    @PostMapping("/auth/customer/wishlist/{sku}/cart/{cartCode}")
+    public ResponseEntity<?> move(@PathVariable String sku, @PathVariable String cartCode, @ApiIgnore MerchantStore store, @ApiIgnore Language language) throws Exception {
+        Customer customer = customer(); Product product = lookup(sku, store);
+        WishlistItem item = product == null ? null : wishlistService.find(customer, product);
+        if (item == null) return ResponseEntity.notFound().build();
+        if (!available(product)) return ResponseEntity.status(HttpStatus.CONFLICT).build();
+        ReadableShoppingCart current = shoppingCartFacade.getByCode(cartCode, store, language);
+        if (current == null) return ResponseEntity.notFound().build();
+        int quantity = 1;
+        if (current.getProducts() != null) for (com.salesmanager.shop.model.shoppingcart.ReadableShoppingCartItem i : current.getProducts()) if (sku.equals(i.getSku())) quantity = i.getQuantity() + 1;
+        PersistableShoppingCartItem cartItem = new PersistableShoppingCartItem(); cartItem.setProduct(sku); cartItem.setQuantity(quantity);
+        ReadableShoppingCart result = shoppingCartFacade.modifyCart(cartCode, cartItem, store, language);
+        wishlistService.remove(customer, product);
+        return ResponseEntity.ok(result);
+    }
+
+    private Customer customer() {
+        Authentication auth = SecurityContextHolder.getContext().getAuthentication();
+        if (auth == null || !(auth.getPrincipal() instanceof JWTUser)) throw new ResourceNotFoundException("Customer authentication required");
+        return customerService.getById(((JWTUser) auth.getPrincipal()).getId());
+    }
+    private Product lookup(String sku, MerchantStore store) {
+        try { return productService.getBySku(sku, store, store.getDefaultLanguage()); }
+        catch (Exception e) { return null; }
+    }
+    private WishlistData data(Customer customer, MerchantStore store) throws Exception {
+        List<WishlistItemData> result = new ArrayList<>();
+        for (WishlistItem item : wishlistService.list(customer, store)) {
+            Product p = item.getProduct(); FinalPrice price = pricingService.calculateProductPrice(p);
+            BigDecimal amount = price == null ? null : price.getFinalPrice();
+            String name = p.getProductDescription() == null ? null : p.getProductDescription().getName();
+            result.add(new WishlistItemData(p.getSku(), name, amount, available(p), item.getAddedAt()));
+        }
+        return new WishlistData(result);
+    }
+    private boolean available(Product p) {
+        if (!p.isAvailable()) return false;
+        if (p.getAvailabilities() == null || p.getAvailabilities().isEmpty()) return false;
+        for (ProductAvailability a : p.getAvailabilities()) if ((a.getAvailable() == null || a.getAvailable()) && a.getProductQuantity() != null && a.getProductQuantity() > 0) return true;
+        return false;
+    }
+
+    @GetMapping("/private/wishlists/popular")
+    public List<PopularWishlistData> popular(@ApiIgnore MerchantStore store) throws Exception {
+        List<PopularWishlistData> result = new ArrayList<>(); int limit = 0;
+        for (Object[] row : wishlistService.popular(store)) { if (limit++ == 10) break; result.add(new PopularWishlistData((String) row[0], ((Number) row[1]).longValue())); }
+        return result;
+    }
+}
