+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.security.Principal; import java.util.*; import java.math.BigDecimal; import javax.servlet.http.HttpServletRequest; import javax.inject.Inject;
+import org.springframework.http.*; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.customer.CustomerService; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.shoppingcart.ShoppingCartService;
+import com.salesmanager.core.model.customer.*; import com.salesmanager.core.model.catalog.product.*; import com.salesmanager.core.model.catalog.product.availability.ProductAvailability; import com.salesmanager.core.model.catalog.product.price.ProductPrice; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.reference.language.Language; import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.shop.model.customer.*; import com.salesmanager.shop.model.shoppingcart.*; import com.salesmanager.shop.store.api.exception.*; import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade; import springfox.documentation.annotations.ApiIgnore;
+
+@RestController @RequestMapping("/api/v1/auth/customer/wishlist")
+public class WishlistApi {
+ @Inject private CustomerService customers; @Inject private ProductService products; @Inject private ShoppingCartService carts; @Inject private ShoppingCartFacade cartFacade;
+ @PostMapping public ResponseEntity<Wishlist> add(@RequestBody WishlistProductRequest body, @ApiIgnore MerchantStore store, HttpServletRequest request) throws Exception { com.salesmanager.core.model.customer.Customer c=customer(request,store); if(body==null||body.getProduct()==null||body.getProduct().trim().isEmpty()) return ResponseEntity.badRequest().build(); Product p=products.getBySku(body.getProduct(),store,store.getDefaultLanguage()); if(p==null) throw new ResourceNotFoundException("Product not found"); for(CustomerWishlistItem w:c.getWishlistItems()) if(w.getProduct().getId().equals(p.getId())) return ResponseEntity.ok(view(c)); if(c.getWishlistItems().size()>=50) return ResponseEntity.badRequest().build(); CustomerWishlistItem w=new CustomerWishlistItem(); w.setCustomer(c); w.setProduct(p); c.getWishlistItems().add(w); save(c); return ResponseEntity.status(HttpStatus.CREATED).body(view(c)); }
+ @GetMapping public Wishlist get(@ApiIgnore MerchantStore store,HttpServletRequest r){return view(customer(r,store));}
+ @DeleteMapping("/{sku}") @ResponseStatus(HttpStatus.NO_CONTENT) public void remove(@PathVariable String sku,@ApiIgnore MerchantStore store,HttpServletRequest r){com.salesmanager.core.model.customer.Customer c=customer(r,store); CustomerWishlistItem w=find(c,sku); c.getWishlistItems().remove(w); save(c);}
+ @PostMapping("/{sku}/cart/{code}") public ResponseEntity<ReadableShoppingCart> move(@PathVariable String sku,@PathVariable String code,@ApiIgnore MerchantStore store,@ApiIgnore Language language,HttpServletRequest r) throws Exception {com.salesmanager.core.model.customer.Customer c=customer(r,store); CustomerWishlistItem w=find(c,sku); Product p=w.getProduct(); if(!available(p)) return ResponseEntity.status(HttpStatus.CONFLICT).build(); ShoppingCart cart=carts.getByCode(code,store); if(cart==null) throw new ResourceNotFoundException("Cart not found"); PersistableShoppingCartItem item=new PersistableShoppingCartItem(); item.setProduct(sku); int qty=1; for(com.salesmanager.core.model.shoppingcart.ShoppingCartItem i:cart.getLineItems()) if(i.getProduct().getSku().equals(sku)) qty=i.getQuantity()+1; item.setQuantity(qty); ReadableShoppingCart result=cartFacade.modifyCart(code,item,store,language); c.getWishlistItems().remove(w); save(c); return ResponseEntity.ok(result); }
+ private com.salesmanager.core.model.customer.Customer customer(HttpServletRequest r,MerchantStore s){Principal p=r.getUserPrincipal(); if(p==null) throw new UnauthorizedException(); com.salesmanager.core.model.customer.Customer c=customers.getByNick(p.getName(),s.getCode()); if(c==null) throw new ResourceNotFoundException("Customer not found"); return c;}
+ private CustomerWishlistItem find(com.salesmanager.core.model.customer.Customer c,String sku){for(CustomerWishlistItem w:c.getWishlistItems()) if(w.getProduct().getSku().equals(sku)) return w; throw new ResourceNotFoundException("Wishlist item not found");}
+ private void save(com.salesmanager.core.model.customer.Customer c){try{customers.saveOrUpdate(c);}catch(Exception e){throw new ServiceRuntimeException(e);}}
+ private boolean available(Product p){if(!p.isAvailable())return false; for(ProductAvailability a:p.getAvailabilities()) if(a.getProductQuantity()!=null&&a.getProductQuantity()>0) return true; return false;}
+ private Wishlist view(com.salesmanager.core.model.customer.Customer c){List<CustomerWishlistItem> source=new ArrayList<>(c.getWishlistItems()); source.sort((a,b)->b.getAddedAt().compareTo(a.getAddedAt())); Wishlist out=new Wishlist(); out.setCount(source.size()); for(CustomerWishlistItem w:source){Product p=w.getProduct(); WishlistItem i=new WishlistItem(); i.setSku(p.getSku()); i.setName(p.getDescriptions().isEmpty()?p.getSku():p.getDescriptions().iterator().next().getName()); i.setAddedAt(w.getAddedAt()); i.setAvailable(available(p)); BigDecimal price=null; for(ProductAvailability a:p.getAvailabilities()) for(ProductPrice x:a.getPrices()) {price=x.getProductPriceAmount();break;} i.setPrice(price); out.getItems().add(i);} return out;}
+}
