+package com.salesmanager.shop.store.api.v1.customer;
+import java.util.*; import javax.inject.Inject; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.business.services.customer.CustomerService; import com.salesmanager.core.model.customer.*; import com.salesmanager.core.model.merchant.MerchantStore; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/wishlists") public class WishlistAdminApi {
+ @Inject private CustomerService customers;
+ public static class Popular { private String sku; private long count; public Popular(String s,long c){sku=s;count=c;} public String getSku(){return sku;} public long getCount(){return count;} }
+ @GetMapping("/popular") public List<Popular> popular(@ApiIgnore MerchantStore store){Map<String,Set<Long>> counts=new HashMap<>(); for(Customer c:customers.getListByStore(store)) for(CustomerWishlistItem w:c.getWishlistItems()) counts.computeIfAbsent(w.getProduct().getSku(),k->new HashSet<>()).add(c.getId()); List<Popular> result=new ArrayList<>(); for(Map.Entry<String,Set<Long>> e:counts.entrySet()) result.add(new Popular(e.getKey(),e.getValue().size())); result.sort(Comparator.comparingLong(Popular::getCount).reversed().thenComparing(Popular::getSku)); return result.size()>10?result.subList(0,10):result; }
+}
