+
+@RestController
+@RequestMapping("/api/v1/private")
+public class CartLimitsApi {
+    @Inject private ProductService productService;
+    @Inject private MerchantStoreService merchantStoreService;
+
+    @GetMapping("/product/{id}/limits")
+    public ProductLimits getProductLimits(@PathVariable Long id, @RequestParam("store") String storeCode) {
+        Product product = product(id, storeCode);
+        return limits(product);
+    }
+
+    @PutMapping("/product/{id}/limits")
+    public ResponseEntity<ProductLimits> setProductLimits(@PathVariable Long id, @RequestParam("store") String storeCode,
+            @RequestBody ProductLimits request) {
+        Product product = product(id, storeCode);
+        validate(request.getMinPerCart(), request.getMaxPerCart(), request.getPackSize());
+        product.setMinPerCart(request.getMinPerCart());
+        product.setMaxPerCart(request.getMaxPerCart());
+        product.setPackSize(request.getPackSize());
+        try { productService.saveProduct(product); } catch (Exception e) { throw new RestApiException("400", e.getMessage(), e); }
+        return ResponseEntity.ok(limits(product));
+    }
+
+    @GetMapping("/cart-rules")
+    public CartRules getCartRules(@RequestParam("store") String storeCode) { return rules(store(storeCode)); }
+
+    @PutMapping("/cart-rules")
+    public ResponseEntity<CartRules> setCartRules(@RequestParam("store") String storeCode, @RequestBody CartRules request) {
+        validate(request.getMaxLines()); validate(request.getMaxUnits());
+        MerchantStore store = store(storeCode);
+        store.setMaxLines(request.getMaxLines()); store.setMaxUnits(request.getMaxUnits());
+        try { merchantStoreService.saveOrUpdate(store); } catch (Exception e) { throw new RestApiException("400", e.getMessage(), e); }
+        return ResponseEntity.ok(rules(store));
+    }
+
+    private Product product(Long id, String code) {
+        MerchantStore store = store(code);
+        Product p = productService.findOne(id, store);
+        if (p == null) throw new ResourceNotFoundException("Product not found");
+        return p;
+    }
+    private MerchantStore store(String code) {
+        try {
+            MerchantStore s = merchantStoreService.getByCode(code);
+            if (s == null) throw new ResourceNotFoundException("Store not found");
+            return s;
+        } catch (ResourceNotFoundException e) { throw e; }
+          catch (Exception e) { throw new ResourceNotFoundException("Store not found"); }
+    }
+    private ProductLimits limits(Product p) { ProductLimits r = new ProductLimits(); r.setMinPerCart(p.getMinPerCart()); r.setMaxPerCart(p.getMaxPerCart()); r.setPackSize(p.getPackSize()); return r; }
+    private CartRules rules(MerchantStore s) { CartRules r = new CartRules(); r.setMaxLines(s.getMaxLines()); r.setMaxUnits(s.getMaxUnits()); return r; }
+    private void validate(Integer... values) { for (Integer v : values) if (v != null && v < 1) throw new RestApiException("400", "Limits must be at least 1"); }
+    private void validate(Integer min, Integer max, Integer pack) { validate(new Integer[]{min, max, pack}); if (min != null && max != null && min > max) throw new RestApiException("400", "minPerCart may not exceed maxPerCart"); if (max != null && pack != null && max < pack) throw new RestApiException("400", "maxPerCart may not be less than packSize"); }
+}
