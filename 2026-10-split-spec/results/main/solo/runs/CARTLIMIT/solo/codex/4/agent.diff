+package com.salesmanager.shop.store.api.v1;
+
+import javax.inject.Inject;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductLimits;
+import com.salesmanager.shop.model.shoppingcart.CartRules;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private")
+public class CartLimitsApi {
+    @Inject private ProductService productService;
+    @Inject private MerchantStoreService merchantStoreService;
+
+    @PutMapping("/product/{id}/limits")
+    public ProductLimits setProductLimits(@PathVariable Long id, @RequestBody ProductLimits request,
+            @ApiIgnore MerchantStore store) throws Exception {
+        Product product = productService.retrieveById(id, store).orElseThrow(() ->
+                new ResourceNotFoundException("Product not found"));
+        validate(request.getMinPerCart(), request.getMaxPerCart(), request.getPackSize());
+        product.setMinPerCart(request.getMinPerCart());
+        product.setMaxPerCart(request.getMaxPerCart());
+        product.setPackSize(request.getPackSize());
+        productService.update(product);
+        return limits(product);
+    }
+
+    @GetMapping("/product/{id}/limits")
+    public ProductLimits getProductLimits(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        Product product = productService.retrieveById(id, store).orElseThrow(() ->
+                new ResourceNotFoundException("Product not found"));
+        return limits(product);
+    }
+
+    @PutMapping("/cart-rules")
+    public CartRules setCartRules(@RequestBody CartRules request, @ApiIgnore MerchantStore store) throws Exception {
+        validate(request.getMaxLines(), request.getMaxUnits());
+        store.setMaxLines(request.getMaxLines());
+        store.setMaxUnits(request.getMaxUnits());
+        merchantStoreService.update(store);
+        return rules(store);
+    }
+
+    @GetMapping("/cart-rules")
+    public CartRules getCartRules(@ApiIgnore MerchantStore store) { return rules(store); }
+
+    private ProductLimits limits(Product p) {
+        ProductLimits r = new ProductLimits(); r.setMinPerCart(p.getMinPerCart());
+        r.setMaxPerCart(p.getMaxPerCart()); r.setPackSize(p.getPackSize()); return r;
+    }
+    private CartRules rules(MerchantStore s) {
+        CartRules r = new CartRules(); r.setMaxLines(s.getMaxLines()); r.setMaxUnits(s.getMaxUnits()); return r;
+    }
+    private void validate(Integer... values) {
+        for (Integer value : values) if (value != null && value < 1)
+            throw new ServiceRuntimeException("400", "Limits must be at least 1");
+        if (values.length == 3 && values[0] != null && values[1] != null && values[0] > values[1])
+            throw new ServiceRuntimeException("400", "minPerCart may not exceed maxPerCart");
+        if (values.length == 3 && values[1] != null && values[2] != null && values[1] < values[2])
+            throw new ServiceRuntimeException("400", "maxPerCart may not be less than packSize");
+    }
+}
