+	private int quantityOf(ShoppingCart cart, Long productId) {
+		if (cart.getLineItems() == null) return 0;
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem item : cart.getLineItems())
+			if (item.getProduct().getId().equals(productId)) return item.getQuantity();
+		return 0;
+	}
+
+	private void validateProduct(Product product, int quantity) {
+		if (quantity == 0) return;
+		if (product.getMinPerCart() != null && quantity < product.getMinPerCart()) violation("MIN_PER_CART");
+		if (product.getMaxPerCart() != null && quantity > product.getMaxPerCart()) violation("MAX_PER_CART");
+		if (product.getPackSize() != null && quantity % product.getPackSize() != 0) violation("PACK_SIZE");
+	}
 
+	private void validateCaps(ShoppingCart cart, Product product, int oldQuantity, int delta, MerchantStore store) {
+		boolean newLine = oldQuantity == 0 && delta > 0;
+		if (store.getMaxLines() != null && newLine) {
+			int lines = cart.getLineItems() == null ? 0 : cart.getLineItems().size();
+			if (lines + 1 > store.getMaxLines()) violation("MAX_LINES");
+		}
+		if (store.getMaxUnits() != null && delta > 0) {
+			int units = cart.getLineItems() == null ? 0 : cart.getLineItems().stream().mapToInt(i -> i.getQuantity()).sum();
+			if (units + delta > store.getMaxUnits()) violation("MAX_UNITS");
+		}
+	}
+
+	private void violation(String rule) {
+		throw new ServiceRuntimeException(rule, "Cart violates " + rule, new IllegalArgumentException(rule));
+	}
+
+	private ReadableShoppingCart withWarnings(ReadableShoppingCart readable, ShoppingCart cart, MerchantStore store) {
+		List<CartLimitWarning> warnings = new ArrayList<>();
+		int units = 0;
+		if (cart.getLineItems() != null) {
+			for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem item : cart.getLineItems()) {
+				units += item.getQuantity();
+				Product p = item.getProduct();
+				if (p.getMinPerCart() != null && item.getQuantity() < p.getMinPerCart()) warnings.add(new CartLimitWarning(p.getSku(), "MIN_PER_CART"));
+				if (p.getMaxPerCart() != null && item.getQuantity() > p.getMaxPerCart()) warnings.add(new CartLimitWarning(p.getSku(), "MAX_PER_CART"));
+				if (p.getPackSize() != null && item.getQuantity() % p.getPackSize() != 0) warnings.add(new CartLimitWarning(p.getSku(), "PACK_SIZE"));
+			}
+		}
+		if (store.getMaxLines() != null && cart.getLineItems() != null && cart.getLineItems().size() > store.getMaxLines()) warnings.add(new CartLimitWarning(null, "MAX_LINES"));
+		if (store.getMaxUnits() != null && units > store.getMaxUnits()) warnings.add(new CartLimitWarning(null, "MAX_UNITS"));
+		readable.setLimitWarnings(warnings);
+		return readable;
