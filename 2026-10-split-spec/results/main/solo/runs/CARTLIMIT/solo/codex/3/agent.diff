+	private void validateSingleChange(ShoppingCart cart, Product product, int requested, boolean additive,
+			MerchantStore store) {
+		Map<Product,Integer> candidate = new java.util.HashMap<>();
+		Set<Product> changed = new java.util.HashSet<>(); int oldUnits = 0; int old = 0;
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : cart.getLineItems()) {
+			candidate.put(i.getProduct(), i.getQuantity()); oldUnits += i.getQuantity();
+			if (i.getProduct().getId().equals(product.getId())) old = i.getQuantity();
+		}
+		int next = requested;
+		if (additive && old > 0 && !product.isProductVirtual()) next += old;
+		candidate.put(product, next); changed.add(product);
+		int newUnits = oldUnits - old + Math.max(next, 0);
+		CartLimitValidator.validate(candidate, store, changed, oldUnits,
+				old == 0 && next > 0, newUnits > oldUnits);
+	}
+
+	private void validateMultiChange(ShoppingCart cart, List<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> incoming,
+			MerchantStore store) {
+		Map<Product,Integer> candidate = new java.util.HashMap<>(); Set<Product> changed = new java.util.HashSet<>(); int oldUnits = 0;
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : cart.getLineItems()) { candidate.put(i.getProduct(), i.getQuantity()); oldUnits += i.getQuantity(); }
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : incoming) { candidate.put(i.getProduct(), i.getQuantity()); changed.add(i.getProduct()); }
+		int newUnits = 0; for (Integer q : candidate.values()) if (q != null && q > 0) newUnits += q;
+		boolean lineAdded = false;
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : incoming)
+			if (i.getQuantity() > 0 && !cart.getLineItems().stream().anyMatch(old -> old.getProduct().getId().equals(i.getProduct().getId()))) lineAdded = true;
+		CartLimitValidator.validate(candidate, store, changed, oldUnits, lineAdded, newUnits > oldUnits);
+	}
+
 	private String uniqueShoppingCartCode() {
 		return UUID.randomUUID().toString().replaceAll("-", "");
 	}
