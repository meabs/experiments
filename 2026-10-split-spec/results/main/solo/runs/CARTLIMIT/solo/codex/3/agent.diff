+package com.salesmanager.shop.store.api.v1.cart;
+
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductCartLimits;
+import com.salesmanager.shop.model.shoppingcart.CartRules;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private")
+public class CartLimitsApi {
+    @Inject private ProductService productService;
+    @Inject private MerchantStoreService merchantStoreService;
+
+    @GetMapping("/product/{id}/limits")
+    public ProductCartLimits getProductLimits(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        return limits(product(id, store));
+    }
+
+    @PutMapping("/product/{id}/limits")
+    @ResponseStatus(HttpStatus.OK)
+    public ProductCartLimits setProductLimits(@PathVariable Long id, @RequestBody ProductCartLimits request,
+                                               @ApiIgnore MerchantStore store) {
+        validate(request.getMinPerCart(), "MIN_PER_CART");
+        validate(request.getMaxPerCart(), "MAX_PER_CART");
+        validate(request.getPackSize(), "PACK_SIZE");
+        if (request.getMinPerCart() != null && request.getMaxPerCart() != null && request.getMinPerCart() > request.getMaxPerCart())
+            throw bad("MAX_PER_CART", "minPerCart may not exceed maxPerCart");
+        if (request.getMaxPerCart() != null && request.getPackSize() != null && request.getMaxPerCart() < request.getPackSize())
+            throw bad("MAX_PER_CART", "maxPerCart may not be less than packSize");
+        Product product = product(id, store);
+        product.setMinPerCart(request.getMinPerCart()); product.setMaxPerCart(request.getMaxPerCart()); product.setPackSize(request.getPackSize());
+        try { productService.update(product); } catch (Exception e) { throw new ServiceRuntimeException("500", e.getMessage(), e); }
+        return limits(product);
+    }
+
+    @GetMapping("/cart-rules")
+    public CartRules getCartRules(@ApiIgnore MerchantStore store) { return rules(store); }
+
+    @PutMapping("/cart-rules")
+    @ResponseStatus(HttpStatus.OK)
+    public CartRules setCartRules(@RequestBody CartRules request, @ApiIgnore MerchantStore store) {
+        validate(request.getMaxLines(), "MAX_LINES"); validate(request.getMaxUnits(), "MAX_UNITS");
+        store.setMaxLines(request.getMaxLines()); store.setMaxUnits(request.getMaxUnits());
+        try { merchantStoreService.saveOrUpdate(store); } catch (Exception e) { throw new ServiceRuntimeException("500", e.getMessage(), e); }
+        return rules(store);
+    }
+
+    private Product product(Long id, MerchantStore store) {
+        Product product = productService.findOne(id, store);
+        if (product == null || product.getMerchantStore() == null || !product.getMerchantStore().getId().equals(store.getId()))
+            throw new ResourceNotFoundException("Product not found");
+        return product;
+    }
+    private ProductCartLimits limits(Product p) { ProductCartLimits r = new ProductCartLimits(); r.setMinPerCart(p.getMinPerCart()); r.setMaxPerCart(p.getMaxPerCart()); r.setPackSize(p.getPackSize()); return r; }
+    private CartRules rules(MerchantStore s) { CartRules r = new CartRules(); r.setMaxLines(s.getMaxLines()); r.setMaxUnits(s.getMaxUnits()); return r; }
+    private void validate(Integer value, String code) { if (value != null && value < 1) throw bad(code, "Value must be at least 1"); }
+    private ServiceRuntimeException bad(String code, String message) { return new ServiceRuntimeException(code, message, new IllegalArgumentException(message)); }
+}
