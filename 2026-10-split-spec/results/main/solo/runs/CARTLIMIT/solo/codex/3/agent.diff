+package com.salesmanager.shop.store.controller.shoppingCart;
+
+import java.util.*;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.shop.model.shoppingcart.LimitWarning;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+
+public final class CartLimitValidator {
+    private CartLimitValidator() { }
+    public static void validate(Map<Product,Integer> candidate, MerchantStore store, Set<Product> changed,
+                                int oldUnits, boolean lineAdded, boolean unitsAdded) {
+        for (Map.Entry<Product,Integer> e : candidate.entrySet()) {
+            int q = e.getValue(); Product p = e.getKey();
+            if (q <= 0 || !changed.contains(p)) continue;
+            if (p.getMinPerCart() != null && q < p.getMinPerCart()) fail("MIN_PER_CART");
+            if (p.getMaxPerCart() != null && q > p.getMaxPerCart()) fail("MAX_PER_CART");
+            if (p.getPackSize() != null && q % p.getPackSize() != 0) fail("PACK_SIZE");
+        }
+        int lines = 0, units = 0;
+        for (Integer q : candidate.values()) if (q != null && q > 0) { lines++; units += q; }
+        if (lineAdded && store.getMaxLines() != null && lines > store.getMaxLines()) fail("MAX_LINES");
+        if (unitsAdded && store.getMaxUnits() != null && units > store.getMaxUnits()) fail("MAX_UNITS");
+    }
+    public static List<LimitWarning> warnings(ShoppingCart cart, MerchantStore store) {
+        List<LimitWarning> result = new ArrayList<>(); int lines = 0, units = 0;
+        if (cart.getLineItems() != null) for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : cart.getLineItems()) {
+            if (i.getQuantity() <= 0) continue; lines++; units += i.getQuantity(); Product p = i.getProduct(); int q = i.getQuantity();
+            if (p.getMinPerCart() != null && q < p.getMinPerCart()) result.add(new LimitWarning(p.getSku(), "MIN_PER_CART"));
+            if (p.getMaxPerCart() != null && q > p.getMaxPerCart()) result.add(new LimitWarning(p.getSku(), "MAX_PER_CART"));
+            if (p.getPackSize() != null && q % p.getPackSize() != 0) result.add(new LimitWarning(p.getSku(), "PACK_SIZE"));
+        }
+        if (store.getMaxLines() != null && lines > store.getMaxLines()) result.add(new LimitWarning(null, "MAX_LINES"));
+        if (store.getMaxUnits() != null && units > store.getMaxUnits()) result.add(new LimitWarning(null, "MAX_UNITS"));
+        return result;
+    }
+    private static void fail(String code) { throw new ServiceRuntimeException(code, "Cart violates " + code, new IllegalArgumentException(code)); }
+}
