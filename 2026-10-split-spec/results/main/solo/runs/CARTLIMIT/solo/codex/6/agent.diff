+	private void validateChange(ShoppingCart cart, Product product, int quantity, MerchantStore store,
+			boolean addsLine, int unitDelta) {
+		if (quantity != 0) validateLine(product, quantity);
+		Map<Long, Integer> changes = new HashMap<>(); changes.put(product.getId(), quantity);
+		validateCaps(cart, store, changes, addsLine, unitDelta > 0);
+	}
+
+	private void validateLine(Product product, int quantity) {
+		if (product.getMinPerCart() != null && quantity < product.getMinPerCart()) limitError("MIN_PER_CART");
+		if (product.getMaxPerCart() != null && quantity > product.getMaxPerCart()) limitError("MAX_PER_CART");
+		if (product.getPackSize() != null && quantity % product.getPackSize() != 0) limitError("PACK_SIZE");
+	}
+
+	private void validateCaps(ShoppingCart cart, MerchantStore store, Map<Long, Integer> changes,
+			boolean addsLine, boolean addsUnits) {
+		int lines = 0, units = 0;
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : cart.getLineItems()) {
+			Integer q = changes.get(i.getProduct().getId());
+			if (q == null) q = i.getQuantity();
+			if (q > 0) { lines++; units += q; }
+		}
+		for (Map.Entry<Long,Integer> e : changes.entrySet()) {
+			boolean found = false;
+			for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : cart.getLineItems()) if (i.getProduct().getId().equals(e.getKey())) found = true;
+			if (!found && e.getValue() > 0) { lines++; units += e.getValue(); }
+		}
+		if (addsLine && store.getMaxLines() != null && lines > store.getMaxLines()) limitError("MAX_LINES");
+		if (addsUnits && store.getMaxUnits() != null && units > store.getMaxUnits()) limitError("MAX_UNITS");
+	}
+
+	private static void limitError(String rule) {
+		throw new ServiceRuntimeException(rule, "Cart limit violated: " + rule, new IllegalArgumentException(rule));
+	}
+
