@@ -0,0 +1,63 @@
+package com.salesmanager.shop.store.api.v1.product;
+
+import javax.inject.Inject;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private")
+public class CartLimitAdministrationApi {
+    @Inject private ProductService productService;
+    @Inject private MerchantStoreService merchantStoreService;
+
+    @PutMapping("/product/{id}/limits")
+    public ProductLimits putProduct(@PathVariable Long id, @RequestBody ProductLimits request, @ApiIgnore MerchantStore store) throws Exception {
+        Product p = productService.getById(id);
+        if (p == null || p.getMerchantStore() == null || !p.getMerchantStore().getId().equals(store.getId())) throw new ResourceNotFoundException("Product not found");
+        validateProduct(request);
+        p.setMinPerCart(request.minPerCart); p.setMaxPerCart(request.maxPerCart); p.setPackSize(request.packSize);
+        productService.saveProduct(p);
+        return ProductLimits.from(p);
+    }
+
+    @GetMapping("/product/{id}/limits")
+    public ProductLimits getProduct(@PathVariable Long id, @ApiIgnore MerchantStore store) throws Exception {
+        Product p = productService.getById(id);
+        if (p == null || p.getMerchantStore() == null || !p.getMerchantStore().getId().equals(store.getId())) throw new ResourceNotFoundException("Product not found");
+        return ProductLimits.from(p);
+    }
+
+    @PutMapping("/cart-rules")
+    public CartRules putCart(@RequestBody CartRules request, @ApiIgnore MerchantStore store) throws Exception {
+        validatePositive(request.maxLines, "maxLines"); validatePositive(request.maxUnits, "maxUnits");
+        store.setMaxLines(request.maxLines); store.setMaxUnits(request.maxUnits); merchantStoreService.save(store);
+        return CartRules.from(store);
+    }
+
+    @GetMapping("/cart-rules")
+    public CartRules getCart(@ApiIgnore MerchantStore store) { return CartRules.from(store); }
+
+    private static void validateProduct(ProductLimits r) {
+        validatePositive(r.minPerCart, "minPerCart"); validatePositive(r.maxPerCart, "maxPerCart"); validatePositive(r.packSize, "packSize");
+        if (r.minPerCart != null && r.maxPerCart != null && r.minPerCart > r.maxPerCart) bad("minPerCart");
+        if (r.maxPerCart != null && r.packSize != null && r.maxPerCart < r.packSize) bad("packSize");
+    }
+    private static void validatePositive(Integer n, String name) { if (n != null && n < 1) bad(name); }
+    private static void bad(String field) { throw new RestApiException("400", "Invalid " + field); }
+
+    public static class ProductLimits {
+        public Integer minPerCart, maxPerCart, packSize;
+        public static ProductLimits from(Product p) { ProductLimits r = new ProductLimits(); r.minPerCart=p.getMinPerCart(); r.maxPerCart=p.getMaxPerCart(); r.packSize=p.getPackSize(); return r; }
+    }
+    public static class CartRules {
+        public Integer maxLines, maxUnits;
+        public static CartRules from(MerchantStore s) { CartRules r=new CartRules(); r.maxLines=s.getMaxLines(); r.maxUnits=s.getMaxUnits(); return r; }
+    }
+}
