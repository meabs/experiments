+package com.salesmanager.shop.store.api.v1.cart;
+
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductLimits;
+import com.salesmanager.shop.model.cart.CartRules;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private")
+public class CartLimitAdministrationApi {
+    @Inject private ProductService productService;
+    @Inject private MerchantStoreService storeService;
+
+    @PutMapping("/product/{id}/limits")
+    public ProductLimits putProductLimits(@PathVariable Long id, @RequestBody ProductLimits request, @ApiIgnore MerchantStore store) {
+        Product p = productService.findOne(id, store);
+        if (p == null || p.getMerchantStore() == null || !p.getMerchantStore().getId().equals(store.getId())) throw new ResourceNotFoundException("Product not found");
+        validate(request.getMinPerCart(), request.getMaxPerCart(), request.getPackSize());
+        p.setMinPerCart(request.getMinPerCart()); p.setMaxPerCart(request.getMaxPerCart()); p.setPackSize(request.getPackSize());
+        try { productService.update(p); } catch (Exception e) { throw new ServiceRuntimeException(e); }
+        return limits(p);
+    }
+
+    @GetMapping("/product/{id}/limits")
+    public ProductLimits getProductLimits(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        Product p = productService.findOne(id, store);
+        if (p == null || p.getMerchantStore() == null || !p.getMerchantStore().getId().equals(store.getId())) throw new ResourceNotFoundException("Product not found");
+        return limits(p);
+    }
+
+    @PutMapping("/cart-rules")
+    public CartRules putCartRules(@RequestBody CartRules request, @ApiIgnore MerchantStore store) {
+        validate(request.getMaxLines(), request.getMaxUnits(), null);
+        store.setMaxCartLines(request.getMaxLines()); store.setMaxCartUnits(request.getMaxUnits());
+        try { storeService.saveOrUpdate(store); } catch (Exception e) { throw new ServiceRuntimeException(e); }
+        return rules(store);
+    }
+
+    @GetMapping("/cart-rules")
+    public CartRules getCartRules(@ApiIgnore MerchantStore store) { return rules(store); }
+
+    private ProductLimits limits(Product p) { ProductLimits x = new ProductLimits(); x.setMinPerCart(p.getMinPerCart()); x.setMaxPerCart(p.getMaxPerCart()); x.setPackSize(p.getPackSize()); return x; }
+    private CartRules rules(MerchantStore s) { CartRules x = new CartRules(); x.setMaxLines(s.getMaxCartLines()); x.setMaxUnits(s.getMaxCartUnits()); return x; }
+    private void validate(Integer min, Integer max, Integer pack) {
+        if ((min != null && min < 1) || (max != null && max < 1) || (pack != null && pack < 1)) throw new IllegalArgumentException("Limits must be positive");
+        if (min != null && max != null && min > max) throw new IllegalArgumentException("minPerCart cannot exceed maxPerCart");
+        if (max != null && pack != null && max < pack) throw new IllegalArgumentException("maxPerCart cannot be less than packSize");
+    }
+}
