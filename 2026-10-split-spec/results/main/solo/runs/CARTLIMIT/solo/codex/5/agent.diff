+		}
+		if (!present) lines++;
+		if (!present && store.getMaxCartLines() != null && lines > store.getMaxCartLines()) throw new CartLimitException("MAX_LINES");
+		if (store.getMaxCartUnits() != null && units > oldUnits && units > store.getMaxCartUnits()) throw new CartLimitException("MAX_UNITS");
