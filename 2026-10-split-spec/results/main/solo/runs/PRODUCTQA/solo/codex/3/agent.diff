+  public List<ProductQuestion> findByStore(Integer store, ProductQuestionStatus status) { return repository.findByProductMerchantStoreIdAndStatusOrderByAskedAtAsc(store, status); }
+  public long countPending(Customer c) { return repository.countByCustomerIdAndStatus(c.getId(), ProductQuestionStatus.PENDING); }
+}
