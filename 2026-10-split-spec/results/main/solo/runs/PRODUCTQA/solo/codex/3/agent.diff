+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.Date;
+import java.util.List;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.catalog.product.ProductQuestionAnswerRequest;
+import com.salesmanager.shop.model.catalog.product.ProductQuestionRequest;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestionList;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+  @Inject private ProductService productService;
+  @Inject private ProductQuestionService questionService;
+  @Inject private CustomerFacade customerFacade;
+
+  @PostMapping("/auth/products/{sku}/questions")
+  public ResponseEntity<?> ask(@PathVariable String sku, @RequestBody ProductQuestionRequest request,
+      @ApiIgnore MerchantStore store, HttpServletRequest http) {
+    String text = request == null || request.getText() == null ? null : request.getText().trim();
+    if (text == null || text.length() < 10 || text.length() > 500) return bad("Question must be between 10 and 500 characters");
+    try {
+      Product product = productService.getBySku(sku, store);
+      Customer customer = customerFacade.getCustomerByUserName(http.getUserPrincipal().getName(), store);
+      if (questionService.countPending(customer) >= 3) return bad("A customer may have at most 3 pending questions");
+      ProductQuestion q = new ProductQuestion(); q.setProduct(product); q.setCustomer(customer); q.setText(text);
+      q.setStatus(ProductQuestionStatus.PENDING); q.setAskedAt(new Date()); questionService.create(q);
+      return ResponseEntity.status(HttpStatus.CREATED).body(toFull(q));
+    } catch (Exception e) { return ResponseEntity.status(HttpStatus.NOT_FOUND).build(); }
+  }
+
+  @GetMapping("/auth/customer/questions")
+  public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store, HttpServletRequest http) {
+    try { Customer c=customerFacade.getCustomerByUserName(http.getUserPrincipal().getName(), store); return questionService.findByCustomer(c).stream().map(this::toFull).collect(Collectors.toList()); }
+    catch (Exception e) { throw new RuntimeException(e); }
+  }
+
+  @GetMapping("/products/{sku}/questions")
+  public ResponseEntity<?> published(@PathVariable String sku, @ApiIgnore MerchantStore store) {
+    try { Product p=productService.getBySku(sku, store); List<ReadableProductQuestion> items=questionService.findPublished(p).stream().map(this::toPublic).collect(Collectors.toList()); return ResponseEntity.ok(new ReadableProductQuestionList(items)); }
+    catch (Exception e) { return ResponseEntity.notFound().build(); }
+  }
+
+  @GetMapping("/private/questions")
+  public ResponseEntity<?> list(@RequestParam(defaultValue="PENDING") String status, @ApiIgnore MerchantStore store) throws Exception {
+    ProductQuestionStatus s; try { s=ProductQuestionStatus.valueOf(status); } catch (Exception e) { return bad("Invalid question status"); }
+    return ResponseEntity.ok(questionService.findByStore(store.getId(), s).stream().map(this::toFull).collect(Collectors.toList()));
+  }
+
+  @PutMapping("/private/questions/{id}/answer")
+  public ResponseEntity<?> answer(@PathVariable Long id, @RequestBody ProductQuestionAnswerRequest request, @ApiIgnore MerchantStore store) throws Exception {
+    ProductQuestion q=question(id, store); if(q==null) return ResponseEntity.notFound().build();
+    String answer=request==null || request.getAnswer()==null ? null : request.getAnswer().trim();
+    if(answer==null || answer.length()<1 || answer.length()>2000) return bad("Answer must be between 1 and 2000 characters");
+    if(q.getStatus()==ProductQuestionStatus.REJECTED) return ResponseEntity.status(HttpStatus.CONFLICT).build();
+    q.setAnswer(answer); q.setStatus(ProductQuestionStatus.PUBLISHED); q.setAnsweredAt(new Date()); questionService.update(q); return ResponseEntity.ok(toFull(q));
+  }
+
+  @PutMapping("/private/questions/{id}/reject")
+  public ResponseEntity<?> reject(@PathVariable Long id, @ApiIgnore MerchantStore store) throws Exception {
+    ProductQuestion q=question(id, store); if(q==null) return ResponseEntity.notFound().build(); q.setStatus(ProductQuestionStatus.REJECTED); questionService.update(q); return ResponseEntity.ok(toFull(q));
+  }
+
+  private ProductQuestion question(Long id, MerchantStore store) { try { ProductQuestion q=questionService.getById(id); return q != null && q.getProduct().getMerchantStore().getId().equals(store.getId()) ? q : null; } catch(Exception e) { return null; } }
+  private ResponseEntity<?> bad(String message) { return ResponseEntity.badRequest().body(message); }
+  private ReadableProductQuestion toFull(ProductQuestion q) { ReadableProductQuestion r=toPublic(q); r.setSku(q.getProduct().getSku()); r.setStatus(q.getStatus().name()); r.setAskedAt(q.getAskedAt()); return r; }
+  private ReadableProductQuestion toPublic(ProductQuestion q) { ReadableProductQuestion r=new ReadableProductQuestion(); r.setId(q.getId()); r.setText(q.getText()); r.setAnswer(q.getAnswer()); r.setAnsweredAt(q.getAnsweredAt()); r.setAskedBy(q.getCustomer().getBilling()==null?null:q.getCustomer().getBilling().getFirstName()); return r; }
+}
