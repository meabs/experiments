+  public List<ProductQuestion> byStore(MerchantStore store, ProductQuestionStatus status) { return repository.findByProductMerchantStoreIdAndStatusOrderByAskedAtAsc(store.getId(), status); }
+  public long pendingCount(Long id) { return repository.countByCustomerIdAndStatus(id, ProductQuestionStatus.PENDING); }
+}
