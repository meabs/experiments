@@ -0,0 +1,80 @@
+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.*;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.model.catalog.product.*;
+import com.salesmanager.shop.store.api.exception.*;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.utils.AuthorizationUtils;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+  @Inject private ProductQuestionService questionService;
+  @Inject private ProductService productService;
+  @Inject private CustomerFacade customerFacade;
+  @Inject private AuthorizationUtils authorizationUtils;
+
+  @PostMapping("/auth/products/{sku}/questions") @ResponseStatus(HttpStatus.CREATED)
+  public ReadableProductQuestion ask(@PathVariable String sku, @RequestBody PersistableProductQuestion body,
+      @ApiIgnore MerchantStore store, Principal principal) {
+    Customer customer = customer(principal, store); Product product = product(sku, store);
+    String text = trim(body == null ? null : body.getText());
+    if (text == null || text.length() < 10 || text.length() > 500) throw new RestApiException("400", "Question must be between 10 and 500 characters");
+    if (questionService.pendingCount(customer.getId()) >= 3) throw new RestApiException("400", "Customer has too many pending questions");
+    ProductQuestion q = new ProductQuestion(); q.setProduct(product); q.setCustomer(customer); q.setText(text); q.setStatus(ProductQuestionStatus.PENDING); q.setAskedAt(new Date());
+    try { questionService.save(q); } catch (Exception e) { throw new RestApiException("Unable to save question", e); }
+    return full(q);
+  }
+
+  @GetMapping("/auth/customer/questions")
+  public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store, Principal principal) {
+    Customer c = customer(principal, store); List<ReadableProductQuestion> result = new ArrayList<>();
+    for (ProductQuestion q : questionService.byCustomer(c.getId(), store)) result.add(full(q)); return result;
+  }
+
+  @GetMapping("/products/{sku}/questions")
+  public ReadableProductQuestionList published(@PathVariable String sku, @ApiIgnore MerchantStore store) {
+    Product p = product(sku, store); List<ReadablePublishedProductQuestion> items = new ArrayList<>();
+    for (ProductQuestion q : questionService.byProduct(p.getId())) items.add(publicView(q));
+    ReadableProductQuestionList result = new ReadableProductQuestionList(); result.setCount(items.size()); result.setItems(items); return result;
+  }
+
+  @GetMapping("/private/questions")
+  public List<ReadableProductQuestion> adminList(@RequestParam(defaultValue="PENDING") String status, @ApiIgnore MerchantStore store) {
+    authorize(store); ProductQuestionStatus s = parseStatus(status); List<ReadableProductQuestion> result = new ArrayList<>();
+    for (ProductQuestion q : questionService.byStore(store, s)) result.add(full(q)); return result;
+  }
+
+  @PutMapping("/private/questions/{id}/answer")
+  public ReadableProductQuestion answer(@PathVariable Long id, @RequestBody PersistableProductQuestion body, @ApiIgnore MerchantStore store) {
+    authorize(store); ProductQuestion q = owned(id, store); if (q.getStatus() == ProductQuestionStatus.REJECTED) throw new ConflictException("Rejected question cannot be answered");
+    String answer = trim(body == null ? null : body.getAnswer()); if (answer == null || answer.length() < 1 || answer.length() > 2000) throw new RestApiException("400", "Answer must be between 1 and 2000 characters");
+    q.setAnswer(answer); q.setStatus(ProductQuestionStatus.PUBLISHED); q.setAnsweredAt(new Date()); save(q); return full(q);
+  }
+
+  @PutMapping("/private/questions/{id}/reject")
+  public ReadableProductQuestion reject(@PathVariable Long id, @ApiIgnore MerchantStore store) { authorize(store); ProductQuestion q = owned(id, store); q.setStatus(ProductQuestionStatus.REJECTED); save(q); return full(q); }
+
+  private void authorize(MerchantStore store) { authorizationUtils.authorizeUser(authorizationUtils.authenticatedUser(), Arrays.asList(Constants.GROUP_ADMIN, Constants.GROUP_ADMIN_CATALOGUE), store); }
+  private Customer customer(Principal p, MerchantStore store) { if (p == null) throw new UnauthorizedException(); Customer c = customerFacade.getCustomerByUserName(p.getName(), store); if (c == null) throw new UnauthorizedException(); return c; }
+  private Product product(String sku, MerchantStore store) { try { Product p = productService.getBySku(sku, store); if (p == null) throw new Exception(); return p; } catch (Exception e) { throw new ResourceNotFoundException("Product with sku [" + sku + "] does not exist"); } }
+  private ProductQuestion owned(Long id, MerchantStore store) { ProductQuestion q = questionService.getById(id); if (q == null || q.getProduct().getMerchantStore().getId().intValue() != store.getId().intValue()) throw new ResourceNotFoundException("Question with id [" + id + "] does not exist"); return q; }
+  private void save(ProductQuestion q) { try { questionService.update(q); } catch (Exception e) { throw new RestApiException("Unable to save question", e); } }
+  private ProductQuestionStatus parseStatus(String s) { try { return ProductQuestionStatus.valueOf(s.toUpperCase(Locale.ROOT)); } catch (Exception e) { throw new RestApiException("400", "Invalid question status"); } }
+  private String trim(String s) { return s == null ? null : s.trim(); }
+  private String name(ProductQuestion q) { return q.getCustomer().getBilling() == null ? null : q.getCustomer().getBilling().getFirstName(); }
+  private ReadableProductQuestion full(ProductQuestion q) { ReadableProductQuestion r = new ReadableProductQuestion(); r.setId(q.getId()); r.setSku(q.getProduct().getSku()); r.setText(q.getText()); r.setStatus(q.getStatus().name()); r.setAnswer(q.getAnswer()); r.setAskedBy(name(q)); r.setAskedAt(q.getAskedAt()); r.setAnsweredAt(q.getAnsweredAt()); return r; }
+  private ReadablePublishedProductQuestion publicView(ProductQuestion q) { ReadablePublishedProductQuestion r=new ReadablePublishedProductQuestion(); r.setId(q.getId()); r.setText(q.getText()); r.setAnswer(q.getAnswer()); r.setAskedBy(name(q)); r.setAnsweredAt(q.getAnsweredAt()); return r; }
+}
