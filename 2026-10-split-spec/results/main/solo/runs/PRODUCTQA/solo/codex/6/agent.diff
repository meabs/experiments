+package com.salesmanager.core.business.services.catalog.product;
+
+import java.util.List;
+import java.util.Optional;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.ProductQuestionRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.*;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long, ProductQuestion> implements ProductQuestionService {
+    private final ProductQuestionRepository repository;
+    @Inject public ProductQuestionServiceImpl(ProductQuestionRepository repository) { super(repository); this.repository = repository; }
+    public List<ProductQuestion> byCustomer(Customer c, MerchantStore s) { return repository.findByCustomerIdAndProductMerchantStoreIdOrderByAskedAtDesc(c.getId(), s.getId()); }
+    public List<ProductQuestion> byProduct(Product p) { return repository.findByProductIdAndStatusOrderByAnsweredAtDesc(p.getId(), ProductQuestionStatus.PUBLISHED); }
+    public List<ProductQuestion> byStore(MerchantStore s, ProductQuestionStatus status) { return repository.findByProductMerchantStoreIdAndStatusOrderByAskedAtAsc(s.getId(), status); }
+    public long pendingCount(Customer c, MerchantStore s) { return repository.countByCustomerIdAndProductMerchantStoreIdAndStatus(c.getId(), s.getId(), ProductQuestionStatus.PENDING); }
+    @Override public ProductQuestion getById(Long id) { return repository.findById(id).orElse(null); }
+}
