+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.Date;
+import java.util.List;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductQuestionService;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.model.catalog.product.*;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductAnswerRequest;
+import com.salesmanager.shop.model.catalog.product.ProductQuestionRequest;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestionList;
+import com.salesmanager.shop.store.api.exception.*;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+    @Inject private ProductQuestionService questionService;
+    @Inject private ProductService productService;
+    @Inject private CustomerService customerService;
+
+    @PostMapping("/auth/products/{sku}/questions") @ResponseStatus(HttpStatus.CREATED)
+    public ReadableProductQuestion ask(@PathVariable String sku, @RequestBody ProductQuestionRequest request,
+            @ApiIgnore MerchantStore store, HttpServletRequest http) {
+        String text = request == null ? null : StringUtils.trimToNull(request.getText());
+        if (text == null || text.length() < 10 || text.length() > 500) throw new BadRequestException("Question must be between 10 and 500 characters");
+        Product product = product(sku, store);
+        Customer customer = customer(http, store);
+        if (questionService.pendingCount(customer, store) >= 3) throw new BadRequestException("A customer may have at most 3 pending questions");
+        ProductQuestion q = new ProductQuestion(); q.setProduct(product); q.setCustomer(customer); q.setText(text); q.setAskedAt(new Date()); q.setStatus(ProductQuestionStatus.PENDING);
+        try { questionService.create(q); } catch (ServiceException e) { throw new BadRequestException(e.getMessage()); }
+        return readable(q);
+    }
+
+    @GetMapping("/auth/customer/questions")
+    public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store, HttpServletRequest http) {
+        return questionService.byCustomer(customer(http, store), store).stream().map(this::readable).collect(Collectors.toList());
+    }
+
+    @GetMapping("/products/{sku}/questions")
+    public ReadableProductQuestionList published(@PathVariable String sku, @ApiIgnore MerchantStore store) {
+        return new ReadableProductQuestionList(questionService.byProduct(product(sku, store)).stream().map(this::publicReadable).collect(Collectors.toList()));
+    }
+
+    @GetMapping("/private/questions")
+    public List<ReadableProductQuestion> adminList(@RequestParam(defaultValue="PENDING") String status, @ApiIgnore MerchantStore store) {
+        ProductQuestionStatus s; try { s=ProductQuestionStatus.valueOf(status); } catch (Exception e) { throw new BadRequestException("Invalid question status"); }
+        return questionService.byStore(store, s).stream().map(this::readable).collect(Collectors.toList());
+    }
+
+    @PutMapping("/private/questions/{id}/answer")
+    public ReadableProductQuestion answer(@PathVariable Long id, @RequestBody ProductAnswerRequest request, @ApiIgnore MerchantStore store) {
+        String answer = request == null ? null : StringUtils.trimToNull(request.getAnswer());
+        if (answer == null || answer.length() < 1 || answer.length() > 2000) throw new BadRequestException("Answer must be between 1 and 2000 characters");
+        ProductQuestion q = question(id, store);
+        if (q.getStatus() == ProductQuestionStatus.REJECTED) throw new ConflictException("A rejected question cannot be answered");
+        q.setAnswer(answer); q.setStatus(ProductQuestionStatus.PUBLISHED); q.setAnsweredAt(new Date()); save(q); return readable(q);
+    }
+
+    @PutMapping("/private/questions/{id}/reject")
+    public ReadableProductQuestion reject(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        ProductQuestion q=question(id, store); q.setStatus(ProductQuestionStatus.REJECTED); save(q); return readable(q);
+    }
+
+    private void save(ProductQuestion q) { try { questionService.update(q); } catch (ServiceException e) { throw new BadRequestException(e.getMessage()); } }
+    private Product product(String sku, MerchantStore store) { try { Product p=productService.getBySku(sku, store); if(p==null) throw new ResourceNotFoundException("Product with sku " + sku + " does not exist"); return p; } catch (ResourceNotFoundException e){throw e;} catch(Exception e){throw new ResourceNotFoundException("Product with sku " + sku + " does not exist");} }
+    private ProductQuestion question(Long id, MerchantStore store) { ProductQuestion q=questionService.getById(id); if(q==null || q.getProduct()==null || !q.getProduct().getMerchantStore().getId().equals(store.getId())) throw new ResourceNotFoundException("Question with id " + id + " does not exist"); return q; }
+    private Customer customer(HttpServletRequest request, MerchantStore store) { Principal p=request.getUserPrincipal(); if(p==null) throw new UnauthorizedException(); Customer c=customerService.getByNick(p.getName(), store.getId()); if(c==null) throw new UnauthorizedException(); return c; }
+    private ReadableProductQuestion readable(ProductQuestion q) { ReadableProductQuestion r=new ReadableProductQuestion(); r.setId(q.getId()); r.setSku(q.getProduct().getSku()); r.setText(q.getText()); r.setStatus(q.getStatus().name()); r.setAnswer(q.getAnswer()); r.setAskedAt(q.getAskedAt()); r.setAnsweredAt(q.getAnsweredAt()); r.setAskedBy(q.getCustomer().getBilling()==null?null:q.getCustomer().getBilling().getFirstName()); return r; }
+    private ReadableProductQuestion publicReadable(ProductQuestion q) { ReadableProductQuestion r=new ReadableProductQuestion(); r.setId(q.getId()); r.setText(q.getText()); r.setAnswer(q.getAnswer()); r.setAnsweredAt(q.getAnsweredAt()); r.setAskedBy(q.getCustomer().getBilling()==null?null:q.getCustomer().getBilling().getFirstName()); return r; }
+}
