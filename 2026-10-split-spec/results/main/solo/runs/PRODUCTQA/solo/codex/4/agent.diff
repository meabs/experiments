+package com.salesmanager.core.business.services.catalog.product;
+
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.repositories.catalog.product.ProductQuestionRepository;
+import com.salesmanager.core.model.catalog.product.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.ProductQuestionStatus;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl implements ProductQuestionService {
+    private final ProductQuestionRepository repository;
+
+    @Inject
+    public ProductQuestionServiceImpl(ProductQuestionRepository repository) { this.repository = repository; }
+    public ProductQuestion save(ProductQuestion question) { return repository.saveAndFlush(question); }
+    public List<ProductQuestion> byCustomer(Long customerId, MerchantStore store) { return repository.findByCustomerIdAndMerchantStoreIdOrderByAskedAtDesc(customerId, store.getId()); }
+    public List<ProductQuestion> byStore(MerchantStore store, ProductQuestionStatus status) { return repository.findByMerchantStoreIdAndStatusOrderByAskedAtAsc(store.getId(), status); }
+    public List<ProductQuestion> published(Long productId) { return repository.findByProductIdAndStatusOrderByAnsweredAtDesc(productId, ProductQuestionStatus.PUBLISHED); }
+    public ProductQuestion get(Long id) { return repository.findById(id).orElse(null); }
+    public long pendingCount(Long customerId, MerchantStore store) { return repository.countByCustomerIdAndMerchantStoreIdAndStatus(customerId, store.getId(), ProductQuestionStatus.PENDING); }
+}
