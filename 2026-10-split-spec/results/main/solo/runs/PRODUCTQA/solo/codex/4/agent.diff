+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.List;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductQuestionService;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductAnswerRequest;
+import com.salesmanager.shop.model.catalog.product.ProductQuestionRequest;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.ReadablePublicProductQuestion;
+import com.salesmanager.shop.model.catalog.product.ReadablePublicProductQuestionList;
+import com.salesmanager.shop.store.api.exception.ConflictException;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.api.exception.UnauthorizedException;
+import com.salesmanager.shop.store.security.user.JWTUser;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+    @Inject private ProductQuestionService questionService;
+    @Inject private ProductService productService;
+    @Inject private CustomerService customerService;
+
+    @PostMapping("/auth/products/{sku}/questions")
+    @ResponseStatus(HttpStatus.CREATED)
+    public ReadableProductQuestion ask(@PathVariable String sku, @RequestBody ProductQuestionRequest request,
+            @ApiIgnore MerchantStore store, HttpServletRequest servletRequest) {
+        String text = request == null ? null : trim(request.getText());
+        if (text == null || text.length() < 10 || text.length() > 500) throw bad("Question must be between 10 and 500 characters");
+        Product product = product(sku, store);
+        Long customerId = customerId(servletRequest);
+        if (questionService.pendingCount(customerId, store) >= 3) throw bad("A customer may have at most 3 pending questions");
+        Customer customer = customerService.getById(customerId);
+        ProductQuestion q = new ProductQuestion();
+        q.setProduct(product); q.setSku(sku); q.setCustomer(customer); q.setMerchantStore(store); q.setText(text);
+        q.setAskedBy(customer.getBilling().getFirstName()); q.setStatus(ProductQuestionStatus.PENDING);
+        return new ReadableProductQuestion(questionService.save(q));
+    }
+
+    @GetMapping("/auth/customer/questions")
+    public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store, HttpServletRequest request) {
+        return questionService.byCustomer(customerId(request), store).stream().map(ReadableProductQuestion::new).collect(Collectors.toList());
+    }
+
+    @GetMapping("/products/{sku}/questions")
+    public ReadablePublicProductQuestionList publicQuestions(@PathVariable String sku, @ApiIgnore MerchantStore store) {
+        Product product = product(sku, store);
+        List<ReadablePublicProductQuestion> items = questionService.published(product.getId()).stream().map(ReadableProductQuestion::new).map(ReadablePublicProductQuestion::new).collect(Collectors.toList());
+        return new ReadablePublicProductQuestionList(items);
+    }
+
+    @GetMapping("/private/questions")
+    public List<ReadableProductQuestion> adminList(@RequestParam(defaultValue = "PENDING") String status, @ApiIgnore MerchantStore store) {
+        ProductQuestionStatus parsed = parseStatus(status);
+        return questionService.byStore(store, parsed).stream().map(ReadableProductQuestion::new).collect(Collectors.toList());
+    }
+
+    @PutMapping("/private/questions/{id}/answer")
+    public ReadableProductQuestion answer(@PathVariable Long id, @RequestBody ProductAnswerRequest request, @ApiIgnore MerchantStore store) {
+        String answer = request == null ? null : trim(request.getAnswer());
+        if (answer == null || answer.length() < 1 || answer.length() > 2000) throw bad("Answer must be between 1 and 2000 characters");
+        ProductQuestion q = question(id, store);
+        if (q.getStatus() == ProductQuestionStatus.REJECTED) throw new ConflictException("A rejected question cannot be answered");
+        q.setAnswer(answer); q.setStatus(ProductQuestionStatus.PUBLISHED); q.setAnsweredAt(new java.util.Date());
+        return new ReadableProductQuestion(questionService.save(q));
+    }
+
+    @PutMapping("/private/questions/{id}/reject")
+    public ReadableProductQuestion reject(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        ProductQuestion q = question(id, store);
+        q.setStatus(ProductQuestionStatus.REJECTED);
+        return new ReadableProductQuestion(questionService.save(q));
+    }
+
+    private ProductQuestion question(Long id, MerchantStore store) {
+        ProductQuestion q = questionService.get(id);
+        if (q == null || q.getMerchantStore().getId().intValue() != store.getId().intValue()) throw new ResourceNotFoundException("Question not found");
+        return q;
+    }
+    private Product product(String sku, MerchantStore store) {
+        try { return productService.getBySku(sku, store); }
+        catch (Exception e) { throw new ResourceNotFoundException("Product not found"); }
+    }
+    private Long customerId(HttpServletRequest request) {
+        Principal principal = request.getUserPrincipal();
+        if (principal == null || !(principal instanceof org.springframework.security.core.Authentication)) throw new UnauthorizedException();
+        Object user = ((org.springframework.security.core.Authentication) principal).getPrincipal();
+        if (!(user instanceof JWTUser)) throw new UnauthorizedException();
+        return ((JWTUser) user).getId();
+    }
+    private ProductQuestionStatus parseStatus(String value) {
+        try { return ProductQuestionStatus.valueOf(value.toUpperCase()); }
+        catch (Exception e) { throw bad("Invalid question status"); }
+    }
+    private RestApiException bad(String message) { return new RestApiException("400", message); }
+    private String trim(String value) { return value == null ? null : StringUtils.trimToNull(value); }
+}
