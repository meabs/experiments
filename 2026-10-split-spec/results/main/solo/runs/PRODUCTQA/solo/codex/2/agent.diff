+package com.salesmanager.core.business.repositories.catalog.product;
+
+import java.util.List;
+import java.util.Optional;
+
+import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Query;
+
+import com.salesmanager.core.model.catalog.product.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.ProductQuestionStatus;
+
+public interface ProductQuestionRepository extends JpaRepository<ProductQuestion, Long> {
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch q.customer c "
+         + "where c.id = ?1 and p.merchantStore.id = ?2 order by q.askedAt desc")
+    List<ProductQuestion> findByCustomerAndStore(Long customerId, Integer storeId);
+
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch q.customer c "
+         + "where p.merchantStore.id = ?1 and q.status = ?2 order by q.askedAt asc")
+    List<ProductQuestion> findByStoreAndStatus(Integer storeId, ProductQuestionStatus status);
+
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch q.customer c "
+         + "where p.id = ?1 and q.status = com.salesmanager.core.model.catalog.product.ProductQuestionStatus.PUBLISHED "
+         + "order by q.answeredAt desc")
+    List<ProductQuestion> findPublishedByProduct(Long productId);
+
+    long countByCustomer_IdAndStatus(Long customerId, ProductQuestionStatus status);
+
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch q.customer c "
+         + "where q.id = ?1 and p.merchantStore.id = ?2")
+    Optional<ProductQuestion> findByIdAndStore(Long id, Integer storeId);
+}
