+    private String answer;
+    private String askedBy;
+    private Date askedAt;
+    private Date answeredAt;
+
+    public static ReadableProductQuestion from(ProductQuestion q) {
+        ReadableProductQuestion result = new ReadableProductQuestion();
+        result.id = q.getId();
+        result.sku = q.getProduct().getSku();
+        result.text = q.getText();
+        result.status = q.getStatus().name();
+        result.answer = q.getAnswer();
+        result.askedBy = q.getCustomer().getBilling() == null ? null : q.getCustomer().getBilling().getFirstName();
+        result.askedAt = q.getAskedAt();
+        result.answeredAt = q.getAnsweredAt();
+        return result;
+    }
+    public Long getId() { return id; }
+    public String getSku() { return sku; }
+    public String getText() { return text; }
+    public String getStatus() { return status; }
+    public String getAnswer() { return answer; }
