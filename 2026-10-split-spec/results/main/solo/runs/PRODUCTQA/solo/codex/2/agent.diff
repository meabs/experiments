@@ -0,0 +1,133 @@
+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.Date;
+import java.util.List;
+import java.util.Optional;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+
+import org.apache.commons.lang3.StringUtils;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.product.ProductAnswerRequest;
+import com.salesmanager.shop.model.product.ProductQuestionRequest;
+import com.salesmanager.shop.model.product.ReadableProductQuestion;
+import com.salesmanager.shop.model.product.ReadablePublishedProductQuestion;
+import com.salesmanager.shop.model.product.ReadablePublishedProductQuestionList;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.api.exception.ConflictException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+    @Inject private ProductService productService;
+    @Inject private ProductQuestionService questionService;
+    @Inject private CustomerFacade customerFacade;
+
+    @PostMapping("/auth/products/{sku}/questions")
+    public ResponseEntity<ReadableProductQuestion> ask(@PathVariable String sku,
+            @RequestBody ProductQuestionRequest request, @ApiIgnore MerchantStore store,
+            Principal principal) {
+        Product product = product(sku, store);
+        String text = request == null ? null : StringUtils.trimToNull(request.getText());
+        requireLength(text, 10, 500, "Question text must be between 10 and 500 characters");
+        Customer customer = customer(principal, store);
+        if (questionService.countPending(customer.getId()) >= 3) {
+            throw new RestApiException("400", "A customer may have at most 3 pending questions");
+        }
+        ProductQuestion q = new ProductQuestion();
+        q.setProduct(product); q.setCustomer(customer); q.setText(text);
+        q.setStatus(ProductQuestionStatus.PENDING); q.setAskedAt(new Date());
+        try { questionService.save(q); } catch (ServiceException e) { throw new RestApiException("400", e.getMessage(), e); }
+        return new ResponseEntity<>(ReadableProductQuestion.from(q), HttpStatus.CREATED);
+    }
+
+    @GetMapping("/auth/customer/questions")
+    public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store, Principal principal) {
+        return questionService.findByCustomerAndStore(customer(principal, store).getId(), store.getId())
+                .stream().map(ReadableProductQuestion::from).collect(Collectors.toList());
+    }
+
+    @GetMapping("/products/{sku}/questions")
+    public ReadablePublishedProductQuestionList published(@PathVariable String sku, @ApiIgnore MerchantStore store) {
+        Product product = product(sku, store);
+        List<ReadablePublishedProductQuestion> items = questionService.findPublishedByProduct(product.getId())
+                .stream().map(ReadablePublishedProductQuestion::from).collect(Collectors.toList());
+        return new ReadablePublishedProductQuestionList(items);
+    }
+
+    @GetMapping("/private/questions")
+    public List<ReadableProductQuestion> adminList(@RequestParam(defaultValue = "PENDING") String status,
+            @ApiIgnore MerchantStore store) {
+        ProductQuestionStatus parsed = parseStatus(status);
+        return questionService.findByStoreAndStatus(store.getId(), parsed).stream()
+                .map(ReadableProductQuestion::from).collect(Collectors.toList());
+    }
+
+    @PutMapping("/private/questions/{id}/answer")
+    public ReadableProductQuestion answer(@PathVariable Long id, @RequestBody ProductAnswerRequest request,
+            @ApiIgnore MerchantStore store) {
+        ProductQuestion q = question(id, store);
+        if (q.getStatus() == ProductQuestionStatus.REJECTED) throw new ConflictException("Rejected questions cannot be answered");
+        String answer = request == null ? null : StringUtils.trimToNull(request.getAnswer());
+        requireLength(answer, 1, 2000, "Answer must be between 1 and 2000 characters");
+        q.setAnswer(answer); q.setStatus(ProductQuestionStatus.PUBLISHED); q.setAnsweredAt(new Date());
+        save(q);
+        return ReadableProductQuestion.from(q);
+    }
+
+    @PutMapping("/private/questions/{id}/reject")
+    public ReadableProductQuestion reject(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        ProductQuestion q = question(id, store);
+        q.setStatus(ProductQuestionStatus.REJECTED);
+        save(q);
+        return ReadableProductQuestion.from(q);
+    }
+
+    private Product product(String sku, MerchantStore store) {
+        try { return productService.getBySku(sku, store); }
+        catch (Exception e) { throw new ResourceNotFoundException("No product found for sku [" + sku + "]"); }
+    }
+    private ProductQuestion question(Long id, MerchantStore store) {
+        return questionService.findByIdAndStore(id, store.getId())
+                .orElseThrow(() -> new ResourceNotFoundException("No question found for id [" + id + "]"));
+    }
+    private Customer customer(Principal principal, MerchantStore store) {
+        Customer customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (customer == null) throw new ResourceNotFoundException("No customer found for principal [" + principal.getName() + "]");
+        return customer;
+    }
+    private void save(ProductQuestion q) {
