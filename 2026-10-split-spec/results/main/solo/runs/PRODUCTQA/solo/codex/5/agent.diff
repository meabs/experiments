+package com.salesmanager.core.business.repositories.catalog.product;
+import java.util.List;
+import org.springframework.data.jpa.repository.*;
+import com.salesmanager.core.model.catalog.product.*;
+public interface ProductQuestionRepository extends JpaRepository<ProductQuestion, Long> {
+ @Query("select q from ProductQuestion q join fetch q.product p join fetch q.customer c where q.customer.id=?1 order by q.askedAt desc") List<ProductQuestion> findByCustomer(Long id);
+ @Query("select q from ProductQuestion q join fetch q.product p join fetch q.customer c where p.merchantStore.id=?1 and q.status=?2 order by q.askedAt asc") List<ProductQuestion> findByStoreAndStatus(Integer storeId, ProductQuestionStatus status);
