@@ -0,0 +1,48 @@
+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.*;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.*;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.*;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.model.catalog.product.*;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.*;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController @RequestMapping("/api/v1")
+public class ProductQuestionApi {
+ @Inject private ProductQuestionService questions; @Inject private ProductService products; @Inject private CustomerService customers;
+
+ public static class TextRequest { private String text; public String getText(){return text;} public void setText(String v){text=v;} }
+ public static class AnswerRequest { private String answer; public String getAnswer(){return answer;} public void setAnswer(String v){answer=v;} }
+ public static class QuestionView { public Long id; public String sku,text,status,answer,askedBy,askedAt,answeredAt; }
+ public static class QuestionList { public int count; public List<QuestionView> items; QuestionList(List<QuestionView> x){items=x;count=x.size();} }
+
+ @PostMapping("/auth/products/{sku}/questions") public ResponseEntity<QuestionView> ask(@PathVariable String sku,@RequestBody TextRequest body,@ApiIgnore MerchantStore store,HttpServletRequest req){
+   Customer c=customer(req,store); String text=trim(body==null?null:body.text); valid(text,10,500,"Question");
+   Product p=product(sku,store); if(questions.pending(c)>=3) throw new RestApiException("400","A customer may have at most 3 pending questions");
+   ProductQuestion q=new ProductQuestion(); q.setProduct(p);q.setCustomer(c);q.setSku(sku);q.setText(text);q.setAskedAt(new Date());q.setStatus(ProductQuestionStatus.PENDING); save(q);
+   return ResponseEntity.status(HttpStatus.CREATED).body(view(q));
+ }
+ @GetMapping("/auth/customer/questions") public List<QuestionView> mine(@ApiIgnore MerchantStore store,HttpServletRequest req){Customer c=customer(req,store);List<QuestionView> out=new ArrayList<>();for(ProductQuestion q:questions.byCustomer(c))out.add(view(q));return out;}
+ @GetMapping("/products/{sku}/questions") public QuestionList published(@PathVariable String sku,@ApiIgnore MerchantStore store){Product p=product(sku,store);List<QuestionView> out=new ArrayList<>();for(ProductQuestion q:questions.published(p))out.add(publicView(q));return new QuestionList(out);}
+ @GetMapping("/private/questions") public List<QuestionView> admin(@RequestParam(defaultValue="PENDING") String status,@ApiIgnore MerchantStore store){ProductQuestionStatus s;try{s=ProductQuestionStatus.valueOf(status);}catch(Exception e){throw new RestApiException("400","Invalid question status");}List<QuestionView> out=new ArrayList<>();for(ProductQuestion q:questions.byStore(store.getId(),s))out.add(view(q));return out;}
+ @PutMapping("/private/questions/{id}/answer") public QuestionView answer(@PathVariable Long id,@RequestBody AnswerRequest body,@ApiIgnore MerchantStore store){ProductQuestion q=question(id,store);if(q.getStatus()==ProductQuestionStatus.REJECTED)throw new QuestionConflictException("A rejected question cannot be answered");String a=trim(body==null?null:body.answer);valid(a,1,2000,"Answer");q.setAnswer(a);q.setStatus(ProductQuestionStatus.PUBLISHED);q.setAnsweredAt(new Date());save(q);return view(q);}
+ @PutMapping("/private/questions/{id}/reject") public QuestionView reject(@PathVariable Long id,@ApiIgnore MerchantStore store){ProductQuestion q=question(id,store);q.setStatus(ProductQuestionStatus.REJECTED);save(q);return view(q);}
+ private Customer customer(HttpServletRequest r,MerchantStore s){Principal p=r.getUserPrincipal();if(p==null)throw new UnauthorizedException();Customer c=customers.getByNick(p.getName(),s.getId());if(c==null)throw new UnauthorizedException();return c;}
+ private Product product(String sku,MerchantStore s){try{Product p=products.getBySku(sku,s);if(p==null)throw new Exception();return p;}catch(Exception e){throw new ResourceNotFoundException("Product sku ["+sku+"] not found");}}
+ private ProductQuestion question(Long id,MerchantStore s){ProductQuestion q=questions.find(id);if(q==null||q.getProduct()==null||!q.getProduct().getMerchantStore().getId().equals(s.getId()))throw new ResourceNotFoundException("Question ["+id+"] not found");return q;}
+ private void save(ProductQuestion q){try{if(q.getId()==null)questions.create(q);else questions.update(q);}catch(ServiceException e){throw new RestApiException("Unable to save question",e);}}
+ private static String trim(String s){return s==null?null:s.trim();} private static void valid(String s,int min,int max,String label){if(s==null||s.length()<min||s.length()>max)throw new RestApiException("400",label+" must be between "+min+" and "+max+" characters");}
+ private static String first(Customer c){return c.getBilling()==null?null:c.getBilling().getFirstName();}
+ private static String iso(Date d){return d==null?null:d.toInstant().toString();}
+ private static QuestionView view(ProductQuestion q){QuestionView v=base(q);v.status=q.getStatus().name();v.answer=q.getAnswer();v.askedAt=iso(q.getAskedAt());return v;}
+ private static QuestionView publicView(ProductQuestion q){QuestionView v=base(q);v.answer=q.getAnswer();v.answeredAt=iso(q.getAnsweredAt());return v;}
+ private static QuestionView base(ProductQuestion q){QuestionView v=new QuestionView();v.id=q.getId();v.sku=q.getSku();v.text=q.getText();v.askedBy=first(q.getCustomer());return v;}
+}
