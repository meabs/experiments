@@ -0,0 +1,88 @@
+package com.salesmanager.shop.store.api.v1.product;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/product/{id}/tiers")
+public class ProductTierApi {
+    @Inject
+    private ProductService productService;
+
+    @GetMapping
+    public List<ProductTier> get(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        return product(id, store).getTiers();
+    }
+
+    @PutMapping
+    @ResponseStatus(HttpStatus.OK)
+    public List<ProductTier> replace(@PathVariable Long id, @RequestBody List<ProductTier> requested,
+            @ApiIgnore MerchantStore store) {
+        Product product = product(id, store);
+        validate(requested);
+        List<ProductTier> tiers = new ArrayList<>(requested);
+        tiers.sort(Comparator.comparing(ProductTier::getMinQuantity));
+        product.setTiers(tiers);
+        try {
+            productService.update(product);
+        } catch (Exception e) {
+            throw new RestApiException("Could not save product tiers", e);
+        }
+        return product.getTiers();
+    }
+
+    private Product product(Long id, MerchantStore store) {
+        Product product = productService.findOne(id, store);
+        if (product == null || product.getMerchantStore() == null
+                || !product.getMerchantStore().getId().equals(store.getId())) {
+            throw new ResourceNotFoundException("Product not found");
+        }
+        return product;
+    }
+
+    private void validate(List<ProductTier> tiers) {
+        if (tiers == null || tiers.size() > 10) bad("At most 10 tiers are allowed");
+        Set<Integer> quantities = new HashSet<>();
+        List<ProductTier> ordered = new ArrayList<>(tiers);
+        ordered.sort((a, b) -> {
+            if (a == null || a.getMinQuantity() == null) return -1;
+            if (b == null || b.getMinQuantity() == null) return 1;
+            return a.getMinQuantity().compareTo(b.getMinQuantity());
+        });
+        BigDecimal previous = null;
+        for (ProductTier tier : ordered) {
+            if (tier == null || tier.getMinQuantity() == null || tier.getPrice() == null
+                    || tier.getMinQuantity() < 2 || tier.getPrice().compareTo(BigDecimal.ZERO) <= 0
+                    || !quantities.add(tier.getMinQuantity())) bad("Invalid product tier");
+            if (previous != null && tier.getPrice().compareTo(previous) >= 0)
+                bad("Higher quantity tiers must have lower prices");
+            previous = tier.getPrice();
+        }
+    }
+
+    private void bad(String message) { throw new RestApiException("400", message); }
+}
