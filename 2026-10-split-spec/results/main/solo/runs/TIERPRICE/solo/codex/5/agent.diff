+package com.salesmanager.shop.store.api.v1.product;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductQuantityTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.QuantityPriceTier;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/product/{id}/tiers")
+public class ProductQuantityTierApi {
+
+    @Inject
+    private ProductService productService;
+
+    @GetMapping
+    @Transactional(readOnly = true)
+    public List<QuantityPriceTier> get(@PathVariable Long id, @ApiIgnore MerchantStore merchantStore) {
+        return toResponse(product(id, merchantStore).getQuantityTiers());
+    }
+
+    @PutMapping
+    @ResponseStatus(HttpStatus.OK)
+    @Transactional
+    public List<QuantityPriceTier> replace(@PathVariable Long id, @RequestBody List<QuantityPriceTier> requested,
+            @ApiIgnore MerchantStore merchantStore) {
+        Product product = product(id, merchantStore);
+        if (requested == null) {
+            throw bad("Tier list must not be null");
+        }
+        validate(requested);
+
+        List<ProductQuantityTier> stored = new ArrayList<>();
+        for (QuantityPriceTier tier : requested) {
+            ProductQuantityTier entity = new ProductQuantityTier();
+            entity.setProduct(product);
+            entity.setMinQuantity(tier.getMinQuantity());
+            entity.setPrice(tier.getPrice());
+            stored.add(entity);
+        }
+        product.getQuantityTiers().clear();
+        product.getQuantityTiers().addAll(stored);
+        try {
+            productService.update(product);
+        } catch (ServiceException e) {
+            throw new RestApiException("500", "Unable to save product tiers", e);
+        }
+        return toResponse(product.getQuantityTiers());
+    }
+
+    private Product product(Long id, MerchantStore store) {
+        Product product = productService.findOne(id, store);
+        if (product == null) {
+            throw new ResourceNotFoundException("Product not found");
+        }
+        return product;
+    }
+
+    private void validate(List<QuantityPriceTier> tiers) {
+        if (tiers.size() > 10) throw bad("A maximum of 10 tiers is allowed");
+        Integer previousQuantity = null;
+        BigDecimal previousPrice = null;
+        for (QuantityPriceTier tier : tiers.stream().sorted(Comparator.comparing(QuantityPriceTier::getMinQuantity, Comparator.nullsFirst(Integer::compareTo))).collect(Collectors.toList())) {
+            if (tier.getMinQuantity() == null || tier.getMinQuantity() < 2 || tier.getPrice() == null || tier.getPrice().compareTo(BigDecimal.ZERO) <= 0) {
+                throw bad("Each tier requires minQuantity >= 2 and price > 0");
+            }
+            if (previousQuantity != null && previousQuantity.equals(tier.getMinQuantity())) throw bad("Duplicate minQuantity");
+            if (previousPrice != null && tier.getPrice().compareTo(previousPrice) >= 0) throw bad("Higher quantities must have lower prices");
+            previousQuantity = tier.getMinQuantity();
+            previousPrice = tier.getPrice();
+        }
+    }
+
+    private RestApiException bad(String message) { return new RestApiException("400", message, new IllegalArgumentException(message)); }
+
+    private List<QuantityPriceTier> toResponse(List<ProductQuantityTier> tiers) {
+        List<QuantityPriceTier> response = new ArrayList<>();
+        if (tiers == null) return response;
+        tiers.stream().sorted(Comparator.comparing(ProductQuantityTier::getMinQuantity)).forEach(tier -> {
+            QuantityPriceTier item = new QuantityPriceTier();
+            item.setMinQuantity(tier.getMinQuantity());
+            item.setPrice(tier.getPrice());
+            response.add(item);
+        });
+        return response;
+    }
+}
