diff --git a/sm-shop/src/main/java/com/salesmanager/shop/store/api/v1/product/ProductPriceTierApi.java b/sm-shop/src/main/java/com/salesmanager/shop/store/api/v1/product/ProductPriceTierApi.java
new file mode 100644
index 0000000..41f5e66
--- /dev/null
+++ b/sm-shop/src/main/java/com/salesmanager/shop/store/api/v1/product/ProductPriceTierApi.java
@@ -0,0 +1,104 @@
+package com.salesmanager.shop.store.api.v1.product;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestMethod;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.stereotype.Controller;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductPriceTier;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+@Controller
+@RequestMapping("/api/v1")
+public class ProductPriceTierApi {
+
+    @Inject
+    private ProductService productService;
+
+    @RequestMapping(value = "/private/product/{id}/tiers", method = RequestMethod.GET)
+    @ResponseBody
+    public List<ProductPriceTier> get(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        return toResponse(product(id, store).getPriceTiers());
+    }
+
+    @RequestMapping(value = "/private/product/{id}/tiers", method = RequestMethod.PUT)
+    @ResponseStatus(HttpStatus.OK)
+    @ResponseBody
+    public List<ProductPriceTier> replace(@PathVariable Long id, @RequestBody List<ProductPriceTier> request,
+            @ApiIgnore MerchantStore store) throws ServiceException {
+        if (request == null) {
+            throw bad("Tier list is required");
+        }
+        Product product = product(id, store);
+        validate(request);
+        List<com.salesmanager.core.model.catalog.product.ProductPriceTier> tiers = new ArrayList<>();
+        for (ProductPriceTier input : request) {
+            com.salesmanager.core.model.catalog.product.ProductPriceTier tier = new com.salesmanager.core.model.catalog.product.ProductPriceTier();
+            tier.setProduct(product);
+            tier.setMinQuantity(input.getMinQuantity());
+            tier.setPrice(input.getPrice());
+            tiers.add(tier);
+        }
+        product.getPriceTiers().clear();
+        product.getPriceTiers().addAll(tiers);
+        productService.update(product);
+        return toResponse(product.getPriceTiers());
+    }
+
+    private Product product(Long id, MerchantStore store) {
+        return productService.retrieveById(id, store)
+                .orElseThrow(() -> new ResourceNotFoundException("Product not found"));
+    }
+
+    private void validate(List<ProductPriceTier> tiers) {
+        if (tiers.size() > 10) throw bad("A product may have at most 10 tiers");
+        Set<Integer> quantities = new HashSet<>();
+        for (ProductPriceTier tier : tiers) {
+            if (tier == null) throw bad("Invalid product price tier");
+        }
+        List<ProductPriceTier> sorted = new ArrayList<>(tiers);
+        sorted.sort(Comparator.comparing(ProductPriceTier::getMinQuantity, Comparator.nullsFirst(Integer::compareTo)));
+        for (ProductPriceTier tier : sorted) {
+            if (tier.getMinQuantity() == null || tier.getMinQuantity() < 2
+                    || tier.getPrice() == null || tier.getPrice().compareTo(BigDecimal.ZERO) <= 0
+                    || !quantities.add(tier.getMinQuantity())) {
+                throw bad("Invalid product price tier");
+            }
+        }
+        for (int i = 1; i < sorted.size(); i++) {
+            if (sorted.get(i).getPrice().compareTo(sorted.get(i - 1).getPrice()) >= 0) {
+                throw bad("Higher quantity tiers must have lower prices");
+            }
+        }
+    }
+
+    private RestApiException bad(String message) { return new RestApiException("400", message); }
+
+    private List<ProductPriceTier> toResponse(List<com.salesmanager.core.model.catalog.product.ProductPriceTier> tiers) {
+        if (tiers == null) return new ArrayList<>();
+        return tiers.stream().sorted(Comparator.comparing(com.salesmanager.core.model.catalog.product.ProductPriceTier::getMinQuantity))
+                .map(tier -> { ProductPriceTier result = new ProductPriceTier(); result.setMinQuantity(tier.getMinQuantity()); result.setPrice(tier.getPrice()); return result; })
+                .collect(Collectors.toList());
+    }
+}
