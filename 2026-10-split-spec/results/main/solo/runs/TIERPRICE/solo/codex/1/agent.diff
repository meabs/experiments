+	@ResponseStatus(HttpStatus.OK)
+	@RequestMapping(value = "/private/product/{id}/tiers", method = RequestMethod.GET)
+	@Transactional(readOnly = true)
+	public @ResponseBody List<ProductTierRequest> getTiers(@PathVariable Long id,
+			@ApiIgnore MerchantStore merchantStore) {
+		Product product = productService.findOne(id, merchantStore);
+		if (product == null) {
+			throw new ResourceNotFoundException("Product not found");
+		}
+		return tierRequests(product.getTiers());
