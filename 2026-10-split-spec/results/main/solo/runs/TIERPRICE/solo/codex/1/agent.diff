+
+	@ResponseStatus(HttpStatus.OK)
+	@RequestMapping(value = "/private/product/{id}/tiers", method = RequestMethod.PUT)
+	@Transactional
+	public @ResponseBody List<ProductTierRequest> putTiers(@PathVariable Long id,
+			@RequestBody List<ProductTierRequest> requests, @ApiIgnore MerchantStore merchantStore) {
+		Product product = productService.findOne(id, merchantStore);
+		if (product == null) {
+			throw new ResourceNotFoundException("Product not found");
+		}
+		if (requests == null || requests.size() > 10) {
+			throw new RestApiException("400", "At most 10 tiers are allowed");
+		}
+
+		for (ProductTierRequest request : requests) {
+			if (request == null || request.getMinQuantity() == null || request.getPrice() == null
+					|| request.getMinQuantity() < 2 || request.getPrice().signum() <= 0) {
+				throw new RestApiException("400", "Invalid product tier list");
+			}
+		}
+		List<ProductTierRequest> sorted = new ArrayList<>(requests);
+		sorted.sort((a, b) -> Integer.compare(a.getMinQuantity() == null ? Integer.MAX_VALUE : a.getMinQuantity(),
+				b.getMinQuantity() == null ? Integer.MAX_VALUE : b.getMinQuantity()));
+		Integer previousQuantity = null;
+		BigDecimal previousPrice = null;
+		for (ProductTierRequest request : sorted) {
+			if ((previousQuantity != null && request.getMinQuantity().equals(previousQuantity))
+					|| (previousPrice != null && request.getPrice().compareTo(previousPrice) >= 0)) {
+				throw new RestApiException("400", "Invalid product tier list");
+			}
+			previousQuantity = request.getMinQuantity();
+			previousPrice = request.getPrice();
+		}
+
+		List<ProductTier> tiers = new ArrayList<>();
+		for (ProductTierRequest request : sorted) {
+			ProductTier tier = new ProductTier();
+			tier.setProduct(product);
+			tier.setMinQuantity(request.getMinQuantity());
+			tier.setPrice(request.getPrice());
+			tiers.add(tier);
+		}
+		product.setTiers(tiers);
+		try {
+			productService.update(product);
+		} catch (Exception e) {
+			throw new RestApiException("Unable to save product tiers", e);
+		}
+		return tierRequests(product.getTiers());
+	}
+
+	private List<ProductTierRequest> tierRequests(List<ProductTier> tiers) {
+		List<ProductTierRequest> result = new ArrayList<>();
+		if (tiers != null) {
+			tiers.stream().sorted((a, b) -> Integer.compare(a.getMinQuantity(), b.getMinQuantity())).forEach(tier -> {
+				ProductTierRequest request = new ProductTierRequest();
+				request.setMinQuantity(tier.getMinQuantity());
+				request.setPrice(tier.getPrice());
+				result.add(request);
+			});
+		}
+		return result;
+	}
