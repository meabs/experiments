+package com.salesmanager.core.model.catalog.product;
+
+import java.io.Serializable;
+import java.math.BigDecimal;
+
+import javax.persistence.Column;
+import javax.persistence.Embeddable;
+
+@Embeddable
+public class ProductTier implements Serializable {
+    private static final long serialVersionUID = 1L;
+
+    @Column(name = "MIN_QUANTITY", nullable = false)
+    private Integer minQuantity;
+
+    @Column(name = "TIER_PRICE", nullable = false, precision = 19, scale = 4)
+    private BigDecimal price;
+
+    public ProductTier() {
+    }
+
+    public ProductTier(Integer minQuantity, BigDecimal price) {
+        this.minQuantity = minQuantity;
+        this.price = price;
+    }
+
+    public Integer getMinQuantity() {
+        return minQuantity;
+    }
+
+    public void setMinQuantity(Integer minQuantity) {
+        this.minQuantity = minQuantity;
+    }
+
+    public BigDecimal getPrice() {
+        return price;
+    }
+
+    public void setPrice(BigDecimal price) {
+        this.price = price;
+    }
+
+    public static BigDecimal priceFor(Product product, int quantity, BigDecimal ownPrice) {
+        BigDecimal selected = ownPrice;
+        if (product != null && product.getTiers() != null) {
+            for (ProductTier tier : product.getTiers()) {
+                if (tier.getMinQuantity() != null && tier.getMinQuantity() <= quantity
+                        && tier.getPrice() != null && tier.getPrice().compareTo(selected) < 0) {
+                    selected = tier.getPrice();
+                }
+            }
+        }
+        return selected;
+    }
+}
