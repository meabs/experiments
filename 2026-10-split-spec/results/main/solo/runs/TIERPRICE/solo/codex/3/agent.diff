@@ -0,0 +1,115 @@
+package com.salesmanager.shop.store.api.v1.product;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.stereotype.Controller;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+@Controller
+@RequestMapping("/api/v1")
+public class ProductTierApi {
+    @Inject
+    private ProductService productService;
+
+    @GetMapping("/private/product/{id}/tiers")
+    @ResponseStatus(HttpStatus.OK)
+    public List<ProductTier> get(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        return product(id, store).getTiers();
+    }
+
+    @PutMapping("/private/product/{id}/tiers")
+    @ResponseStatus(HttpStatus.OK)
+    public List<ProductTier> replace(@PathVariable Long id, @RequestBody List<TierRequest> requested,
+            @ApiIgnore MerchantStore store) throws ServiceException {
+        Product product = product(id, store);
+        if (requested == null) {
+            throw bad("Tier list is required");
+        }
+        validate(requested);
+        List<ProductTier> tiers = new ArrayList<>();
+        requested.stream().sorted(Comparator.comparing(TierRequest::quantity)).forEach(t ->
+                tiers.add(new ProductTier(t.quantity().intValueExact(), t.price())));
+        product.setTiers(tiers);
+        productService.update(product);
+        return product.getTiers();
+    }
+
+    private Product product(Long id, MerchantStore store) {
+        return productService.retrieveById(id, store)
+                .orElseThrow(() -> new ResourceNotFoundException("Product id " + id + " was not found"));
+    }
+
+    private void validate(List<TierRequest> tiers) {
+        if (tiers.size() > 10) throw bad("A product may have at most 10 tiers");
+        TierRequest previous = null;
+        for (TierRequest tier : tiers.stream().sorted(Comparator.comparing(TierRequest::quantity,
+                Comparator.nullsFirst(BigDecimal::compareTo))).toList()) {
+            if (tier.quantity() == null || tier.quantity().stripTrailingZeros().scale() > 0
+                    || tier.quantity().compareTo(BigDecimal.valueOf(2)) < 0
+                    || tier.quantity().compareTo(BigDecimal.valueOf(Integer.MAX_VALUE)) > 0
+                    || tier.price() == null || tier.price().compareTo(BigDecimal.ZERO) <= 0) {
+                throw bad("Each tier requires minQuantity >= 2 and price > 0");
+            }
+            if (previous != null) {
+                if (previous.quantity().compareTo(tier.quantity()) == 0) throw bad("Duplicate minQuantity");
+                if (tier.price().compareTo(previous.price()) >= 0)
+                    throw bad("Higher quantities must have lower prices");
+            }
+            previous = tier;
+        }
+    }
+
+    private RestApiException bad(String message) {
+        return new RestApiException("400", message);
+    }
+
+    public static class TierRequest {
+        private BigDecimal minQuantity;
+        private BigDecimal price;
+
+        public BigDecimal getMinQuantity() {
+            return minQuantity;
+        }
+
+        public void setMinQuantity(BigDecimal minQuantity) {
+            this.minQuantity = minQuantity;
+        }
+
+        public BigDecimal getPrice() {
+            return price;
+        }
+
+        public void setPrice(BigDecimal price) {
+            this.price = price;
+        }
+
+        private BigDecimal quantity() {
+            return minQuantity;
+        }
+
+        private BigDecimal price() {
+            return price;
+        }
+    }
+}
