+package com.salesmanager.shop.store.api.v1.product;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestMethod;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductTier;
+import com.salesmanager.shop.store.api.exception.ConversionRuntimeException;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@Controller
+@RequestMapping("/api/v1")
+public class ProductTierApi {
+    @Inject private ProductService productService;
+
+    @RequestMapping(value = "/private/product/{id}/tiers", method = RequestMethod.GET)
+    @ResponseStatus(HttpStatus.OK) @ResponseBody
+    public List<ProductTier> get(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        return output(product(id, store).getTiers());
+    }
+
+    @RequestMapping(value = "/private/product/{id}/tiers", method = RequestMethod.PUT)
+    @ResponseStatus(HttpStatus.OK) @ResponseBody
+    public List<ProductTier> replace(@PathVariable Long id, @RequestBody List<ProductTier> input,
+            @ApiIgnore MerchantStore store) throws ServiceException {
+        validate(input);
+        Product product = product(id, store);
+        List<com.salesmanager.core.model.catalog.product.ProductTier> stored = new ArrayList<>();
+        for (ProductTier tier : input) stored.add(new com.salesmanager.core.model.catalog.product.ProductTier(tier.getMinQuantity(), tier.getPrice()));
+        product.setTiers(stored);
+        productService.update(product);
+        return output(stored);
+    }
+
+    private Product product(Long id, MerchantStore store) {
+        Product product = productService.findOne(id, store);
+        if (product == null) throw new ResourceNotFoundException("Product not found: " + id);
+        return product;
+    }
+
+    private static void validate(List<ProductTier> input) {
+        if (input == null || input.size() > 10) bad("At most 10 tiers are allowed");
+        List<ProductTier> sorted = new ArrayList<>(input);
+        sorted.sort(Comparator.comparing(t -> t == null ? null : t.getMinQuantity(), Comparator.nullsFirst(Comparator.naturalOrder())));
+        Integer previousQuantity = null;
+        BigDecimal previousPrice = null;
+        for (ProductTier tier : sorted) {
+            if (tier == null || tier.getMinQuantity() == null || tier.getPrice() == null || tier.getMinQuantity() < 2 || tier.getPrice().signum() <= 0) bad("Invalid tier");
+            if (previousQuantity != null && previousQuantity.equals(tier.getMinQuantity())) bad("Duplicate minQuantity");
+            if (previousPrice != null && tier.getPrice().compareTo(previousPrice) >= 0) bad("Tier prices must decrease");
+            previousQuantity = tier.getMinQuantity();
+            previousPrice = tier.getPrice();
+        }
+    }
+
+    private static void bad(String message) { throw new ConversionRuntimeException("400", message); }
+
+    private static List<ProductTier> output(List<com.salesmanager.core.model.catalog.product.ProductTier> tiers) {
+        List<ProductTier> result = new ArrayList<>();
+        if (tiers != null) for (com.salesmanager.core.model.catalog.product.ProductTier tier : tiers) {
+            ProductTier dto = new ProductTier(); dto.setMinQuantity(tier.getMinQuantity()); dto.setPrice(tier.getPrice()); result.add(dto);
+        }
+        result.sort(Comparator.comparing(ProductTier::getMinQuantity));
+        return result;
+    }
+}
