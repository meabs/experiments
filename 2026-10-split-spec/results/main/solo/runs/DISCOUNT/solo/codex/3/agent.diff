@@ -0,0 +1,70 @@
+package com.salesmanager.core.business.services.discount;
+
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.discount.DiscountCodeRepository;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.discount.DiscountCode;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service
+public class DiscountCodeService {
+    @Inject private DiscountCodeRepository repository;
+
+    public List<DiscountCode> list(MerchantStore store) { return repository.findByMerchantStoreId(store.getId()); }
+    public DiscountCode find(MerchantStore store, String code) { return repository.findByMerchantStoreIdAndCodeIgnoreCase(store.getId(), code); }
+    public DiscountCode find(MerchantStore store, Long id) { return repository.findByIdAndMerchantStoreId(id, store.getId()); }
+    public DiscountCode save(DiscountCode d, MerchantStore store) {
+        validate(d);
+        DiscountCode existing = find(store, d.getCode());
+        if (existing != null && !existing.getId().equals(d.getId())) throw new IllegalArgumentException("Discount code already exists");
+        d.setMerchantStore(store); return repository.save(d);
+    }
+    public void delete(MerchantStore store, Long id) { DiscountCode d = find(store, id); if (d != null) repository.delete(d); }
+    public void validate(DiscountCode d) {
+        if (d == null || d.getCode() == null || d.getCode().trim().isEmpty() || d.getValue() == null || d.getType() == null) throw new IllegalArgumentException("code, type and value are required");
+        d.setCode(d.getCode().trim());
+        if (d.getStartDate() == null) d.setStartDate(LocalDate.now());
+        if (d.getType() == DiscountType.PERCENT && (d.getValue().signum() <= 0 || d.getValue().compareTo(new BigDecimal("100")) > 0)) throw new IllegalArgumentException("invalid percent");
+        if (d.getType() == DiscountType.AMOUNT && d.getValue().signum() <= 0) throw new IllegalArgumentException("invalid amount");
+        if (d.getEndDate() != null && d.getEndDate().isBefore(d.getStartDate())) throw new IllegalArgumentException("endDate is before startDate");
+    }
+    public boolean applies(DiscountCode d, ShoppingCart cart) {
+        if (d == null || !d.isActive() || !d.getMerchantStore().getId().equals(cart.getMerchantStore().getId())) return false;
+        LocalDate today = LocalDate.now();
+        if (today.isBefore(d.getStartDate()) || (d.getEndDate() != null && today.isAfter(d.getEndDate()))) return false;
+        BigDecimal subtotal = subtotal(cart.getLineItems());
+        if (d.getMinimumSubtotal() != null && subtotal.compareTo(d.getMinimumSubtotal()) < 0) return false;
+        return eligibleSubtotal(d, cart.getLineItems()).signum() > 0;
+    }
+    public BigDecimal discount(DiscountCode d, ShoppingCart cart) {
+        BigDecimal eligible = eligibleSubtotal(d, cart.getLineItems());
+        if (eligible.signum() == 0) return BigDecimal.ZERO.setScale(2);
+        BigDecimal amount = d.getType() == DiscountType.PERCENT ? eligible.multiply(d.getValue()).divide(new BigDecimal("100")) : d.getValue().min(eligible);
+        return amount.setScale(2, java.math.RoundingMode.HALF_UP);
+    }
+    public BigDecimal discountForItem(DiscountCode d, List<ShoppingCartItem> items, ShoppingCartItem item) {
+        BigDecimal eligible = BigDecimal.ZERO;
+        for (ShoppingCartItem i : items) if (eligible(d, i)) eligible = eligible.add(i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity())));
+        if (eligible.signum() == 0 || !eligible(d, item)) return BigDecimal.ZERO.setScale(2);
+        BigDecimal total = d.getType() == DiscountType.PERCENT ? eligible.multiply(d.getValue()).divide(new BigDecimal("100")) : d.getValue().min(eligible);
+        return total.multiply(item.getItemPrice()).multiply(BigDecimal.valueOf(item.getQuantity())).divide(eligible, 2, java.math.RoundingMode.HALF_UP);
+    }
+    private BigDecimal subtotal(Iterable<ShoppingCartItem> items) { BigDecimal r = BigDecimal.ZERO; for (ShoppingCartItem i : items) r = r.add(i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity()))); return r; }
+    private BigDecimal eligibleSubtotal(DiscountCode d, Iterable<ShoppingCartItem> items) { BigDecimal r = BigDecimal.ZERO; for (ShoppingCartItem i : items) if (eligible(d, i)) r = r.add(i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity()))); return r; }
+    private boolean eligible(DiscountCode d, ShoppingCartItem i) {
+        if (d.getCategories() == null || d.getCategories().isEmpty()) return true;
+        if (i.getProduct() == null || i.getProduct().getCategories() == null) return false;
+        for (Category c : i.getProduct().getCategories()) for (String wanted : d.getCategories()) {
+            Category current = c;
+            while (current != null) { if (current.getCode().equalsIgnoreCase(wanted)) return true; current = current.getParent(); }
+        }
+        return false;
+    }
+}
