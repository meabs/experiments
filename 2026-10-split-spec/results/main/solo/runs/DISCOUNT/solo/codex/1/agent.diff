+package com.salesmanager.shop.store.api.v1.discount;
+
+import java.time.LocalDate;
+import java.util.List;
+import java.util.stream.Collectors;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.business.services.discount.DiscountService;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.discount.DiscountRequest;
+import com.salesmanager.shop.model.discount.DiscountResponse;
+import com.salesmanager.shop.store.api.exception.DiscountBadRequestException;
+import com.salesmanager.shop.store.api.exception.DiscountConflictException;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/discounts")
+public class DiscountApi {
+    @Inject private DiscountService service;
+    @Inject private CategoryService categoryService;
+
+    @PostMapping
+    public ResponseEntity<DiscountResponse> create(@RequestBody DiscountRequest request, @ApiIgnore MerchantStore store) throws Exception {
+        validate(request, store, null);
+        return ResponseEntity.status(HttpStatus.CREATED).body(toResponse(service.create(toEntity(request, new Discount(), store), store)));
+    }
+    @GetMapping
+    public List<DiscountResponse> list(@ApiIgnore MerchantStore store) { return service.list(store).stream().map(this::toResponse).collect(Collectors.toList()); }
+    @PutMapping("/{id}")
+    public DiscountResponse update(@PathVariable Long id, @RequestBody DiscountRequest request, @ApiIgnore MerchantStore store) throws Exception {
+        Discount current = service.get(id, store);
+        if (current == null) throw new DiscountBadRequestException("Discount not found");
+        validate(request, store, id);
+        return toResponse(service.update(toEntity(request, current, store), store));
+    }
+    @DeleteMapping("/{id}")
+    public ResponseEntity<Void> delete(@PathVariable Long id, @ApiIgnore MerchantStore store) throws Exception {
+        if (service.get(id, store) == null) throw new DiscountBadRequestException("Discount not found");
+        service.delete(id, store); return ResponseEntity.noContent().build();
+    }
+    private void validate(DiscountRequest r, MerchantStore store, Long id) throws Exception {
+        if (r == null || r.getCode() == null || r.getCode().trim().isEmpty() || r.getValue() == null || r.getType() == null) throw new DiscountBadRequestException("code, type and value are required");
+        if (r.getType() == DiscountType.PERCENT && (r.getValue().signum() <= 0 || r.getValue().compareTo(java.math.BigDecimal.valueOf(100)) > 0)) throw new DiscountBadRequestException("percent must be between 0 and 100");
+        if (r.getType() == DiscountType.AMOUNT && r.getValue().signum() <= 0) throw new DiscountBadRequestException("amount must be positive");
+        if (r.getEndDate() != null && r.getStartDate() != null && r.getEndDate().isBefore(r.getStartDate())) throw new DiscountBadRequestException("endDate must not precede startDate");
+        if (service.exists(r.getCode().trim(), store, id)) throw new DiscountConflictException("code already exists");
+        if (r.getCategories() != null) for (String category : r.getCategories()) if (categoryService.getByCode(store, category) == null) throw new DiscountBadRequestException("unknown category: " + category);
+    }
+    private Discount toEntity(DiscountRequest r, Discount d, MerchantStore store) {
+        d.setMerchantStore(store); d.setCode(r.getCode().trim()); d.setType(r.getType()); d.setValue(r.getValue()); d.setMinimumSubtotal(r.getMinimumSubtotal());
+        d.setStartDate(r.getStartDate() == null ? LocalDate.now() : r.getStartDate()); d.setEndDate(r.getEndDate()); d.setCategories(r.getCategories()); d.setActive(r.getActive() == null ? true : r.getActive()); return d;
+    }
+    private DiscountResponse toResponse(Discount d) {
+        DiscountResponse r = new DiscountResponse(); r.setId(d.getId()); r.setCode(d.getCode()); r.setType(d.getType()); r.setValue(d.getValue()); r.setMinimumSubtotal(d.getMinimumSubtotal()); r.setStartDate(d.getStartDate()); r.setEndDate(d.getEndDate()); r.setCategories(d.getCategories()); r.setActive(d.isActive()); return r;
+    }
+}
