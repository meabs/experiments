+package com.salesmanager.core.business.services.discount;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDate;
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.discount.DiscountRepository;
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.order.OrderSummary;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service("discountService")
+public class DiscountServiceImpl implements DiscountService {
+    @Inject private DiscountRepository repository;
+    @Inject private CategoryService categoryService;
+
+    @Override public Discount create(Discount d, MerchantStore store) throws ServiceException { d.setMerchantStore(store); return repository.saveAndFlush(d); }
+    @Override public Discount update(Discount d, MerchantStore store) throws ServiceException { d.setMerchantStore(store); return repository.saveAndFlush(d); }
+    @Override public List<Discount> list(MerchantStore store) { return repository.findByStore(store.getId()); }
+    @Override public Discount get(Long id, MerchantStore store) { return repository.findByIdAndStore(id, store.getId()); }
+    @Override public Discount find(String code, MerchantStore store) { return code == null ? null : repository.findByStoreAndCode(store.getId(), code); }
+    @Override public void delete(Long id, MerchantStore store) throws ServiceException { Discount d = get(id, store); if (d != null) repository.delete(d); }
+    @Override public boolean exists(String code, MerchantStore store, Long excludingId) { return repository.existsByStoreAndCode(store.getId(), code, excludingId); }
+
+    @Override
+    public boolean applies(Discount d, OrderSummary summary, ShoppingCartItem item, Product product, MerchantStore store) {
+        if (d == null || !d.isActive() || d.getMerchantStore().getId().intValue() != store.getId().intValue()) return false;
+        LocalDate today = LocalDate.now();
+        if (d.getStartDate() == null || today.isBefore(d.getStartDate()) || (d.getEndDate() != null && today.isAfter(d.getEndDate()))) return false;
+        BigDecimal subtotal = summary.getProducts().stream().map(i -> i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity()))).reduce(BigDecimal.ZERO, BigDecimal::add);
+        if (d.getMinimumSubtotal() != null && subtotal.compareTo(d.getMinimumSubtotal()) < 0) return false;
+        if (d.getCategories() == null || d.getCategories().isEmpty()) return true;
+        if (product == null || product.getCategories() == null) return false;
+        for (Category productCategory : product.getCategories()) {
+            for (String code : d.getCategories()) {
+                Category root;
+                try { root = categoryService.getByCode(store, code); } catch (ServiceException e) { return false; }
+                if (root != null && (root.getId().equals(productCategory.getId()) || (productCategory.getLineage() != null && productCategory.getLineage().contains("/" + root.getId() + "/")))) return true;
+            }
+        }
+        return false;
+    }
+
+    @Override
+    public BigDecimal discountFor(OrderSummary summary, ShoppingCartItem item, Product product, MerchantStore store) {
+        Discount d = find(summary.getPromoCode(), store);
+        if (!applies(d, summary, item, product, store)) return BigDecimal.ZERO;
+        BigDecimal eligible = summary.getProducts().stream().filter(i -> applies(d, summary, i, i.getProduct(), store))
+                .map(i -> i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity()))).reduce(BigDecimal.ZERO, BigDecimal::add);
+        if (eligible.signum() == 0) return BigDecimal.ZERO;
+        boolean first = summary.getProducts().stream().filter(i -> applies(d, summary, i, i.getProduct(), store)).findFirst().orElse(null) == item;
+        if (!first) return BigDecimal.ZERO;
+        BigDecimal result = d.getType() == DiscountType.PERCENT ? eligible.multiply(d.getValue()).divide(BigDecimal.valueOf(100)) : d.getValue().min(eligible);
+        return result.setScale(2, RoundingMode.HALF_UP);
+    }
+}
