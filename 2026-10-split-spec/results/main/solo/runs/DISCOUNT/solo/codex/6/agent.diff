+package com.salesmanager.core.business.services.discount;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDate;
+import java.util.List;
+import java.util.Objects;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.discount.DiscountRepository;
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service("discountService")
+public class DiscountServiceImpl extends SalesManagerEntityServiceImpl<Long, Discount> implements DiscountService {
+    private final DiscountRepository repository;
+    private final CategoryService categoryService;
+
+    @Inject
+    public DiscountServiceImpl(DiscountRepository repository, CategoryService categoryService) {
+        super(repository);
+        this.repository = repository;
+        this.categoryService = categoryService;
+    }
+
+    @Override public Discount save(Discount d, MerchantStore store) throws ServiceException {
+        d.setMerchantStore(store);
+        if (d.getId() == null || d.getId() == 0) return repository.saveAndFlush(d);
+        repository.saveAndFlush(d); return d;
+    }
+    @Override public List<Discount> list(MerchantStore store) { return repository.findByMerchantStoreId(store.getId()); }
+    @Override public Discount get(Long id, MerchantStore store) { Discount d = repository.findById(id).orElse(null); return d != null && d.getMerchantStore().getId().equals(store.getId()) ? d : null; }
+    @Override public Discount find(String code, MerchantStore store) { return code == null ? null : repository.findByMerchantStoreIdAndCodeIgnoreCase(store.getId(), code); }
+    @Override public void delete(Long id, MerchantStore store) throws ServiceException { Discount d = get(id, store); if (d != null) repository.delete(d); }
+
+    @Override public boolean applies(Discount d, ShoppingCart cart, MerchantStore store) {
+        if (d == null || !d.isActive() || d.getMerchantStore() == null || !Objects.equals(d.getMerchantStore().getId(), store.getId())) return false;
+        LocalDate today = LocalDate.now();
+        if (d.getStartDate() == null || today.isBefore(d.getStartDate()) || (d.getEndDate() != null && today.isAfter(d.getEndDate()))) return false;
+        BigDecimal subtotal = BigDecimal.ZERO;
+        for (ShoppingCartItem i : cart.getLineItems()) subtotal = subtotal.add(price(i));
+        if (d.getMinimumSubtotal() != null && subtotal.compareTo(d.getMinimumSubtotal()) < 0) return false;
+        return eligibleSubtotal(d, cart) .compareTo(BigDecimal.ZERO) > 0;
+    }
+
+    @Override public BigDecimal amount(Discount d, ShoppingCart cart, MerchantStore store) {
+        BigDecimal eligible = eligibleSubtotal(d, cart);
+        if (eligible.signum() == 0) return BigDecimal.ZERO.setScale(2);
+        BigDecimal result = d.getType() == DiscountType.PERCENT ? eligible.multiply(d.getValue()).divide(new BigDecimal("100"), 8, RoundingMode.HALF_UP) : d.getValue().min(eligible);
+        return result.min(eligible).setScale(2, RoundingMode.HALF_UP);
+    }
+
+    public BigDecimal eligibleSubtotal(Discount d, ShoppingCart cart) {
+        BigDecimal total = BigDecimal.ZERO;
+        for (ShoppingCartItem item : cart.getLineItems()) if (eligible(d, item.getProduct())) total = total.add(price(item));
+        return total;
+    }
+    @Override public boolean eligible(Discount d, Product product) {
+        if (product == null) return false;
+        if (d.getCategories() == null || d.getCategories().isEmpty()) return true;
+        for (String code : d.getCategories()) {
+            Category root;
+            try { root = categoryService.getByCode(d.getMerchantStore(), code); } catch (ServiceException e) { return false; }
+            if (root == null) continue;
+            for (Category category : product.getCategories()) {
+                if (root.getId().equals(category.getId()) || (category.getLineage() != null && category.getLineage().contains("/" + root.getId() + "/"))) return true;
+            }
+        }
+        return false;
+    }
+    private BigDecimal price(ShoppingCartItem i) { return i.getItemPrice() == null ? BigDecimal.ZERO : i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity())); }
+}
