@@ -0,0 +1,48 @@
+package com.salesmanager.shop.store.api.v1.discount;
+
+import java.time.LocalDate;
+import java.util.List;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.business.services.discount.DiscountService;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.discount.DiscountData;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.api.exception.ConflictException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/discounts")
+public class DiscountApi {
+    @Inject private DiscountService service;
+    @Inject private CategoryService categoryService;
+
+    @PostMapping
+    public ResponseEntity<DiscountData> create(@RequestBody DiscountData data, @ApiIgnore MerchantStore store) {
+        Discount d = validate(data, store); if (service.find(d.getCode(), store) != null) throw new ConflictException("Discount code already exists");
+        try { return ResponseEntity.status(HttpStatus.CREATED).body(DiscountData.from(service.save(d, store))); } catch (Exception e) { throw new RestApiException("500", e.getMessage(), e); }
+    }
+    @GetMapping public List<DiscountData> list(@ApiIgnore MerchantStore store) { return service.list(store).stream().map(DiscountData::from).collect(Collectors.toList()); }
+    @PutMapping("/{id}") public DiscountData update(@PathVariable Long id, @RequestBody DiscountData data, @ApiIgnore MerchantStore store) {
+        Discount old=service.get(id,store); if(old==null) throw new RestApiException("404", "Discount not found");
+        Discount d=validate(data,store); d.setId(id); if (service.find(d.getCode(),store)!=null && !service.find(d.getCode(),store).getId().equals(id)) throw new ConflictException("Discount code already exists");
+        try { return DiscountData.from(service.save(d,store)); } catch(Exception e) { throw new RestApiException("500",e.getMessage(),e); }
+    }
+    @DeleteMapping("/{id}") public ResponseEntity<Void> delete(@PathVariable Long id,@ApiIgnore MerchantStore store) throws Exception { if(service.get(id,store)==null) return ResponseEntity.notFound().build(); service.delete(id,store); return ResponseEntity.noContent().build(); }
+
+    private Discount validate(DiscountData x, MerchantStore store) {
+        if(x==null || x.getCode()==null || x.getCode().trim().isEmpty() || x.getValue()==null || x.getType()==null) throw new RestApiException("400","Missing code, type or value");
+        if(x.getType()==DiscountType.PERCENT && (x.getValue().signum()<=0 || x.getValue().compareTo(new java.math.BigDecimal("100"))>0)) throw new RestApiException("400","Percent must be between 0 and 100");
+        if(x.getType()==DiscountType.AMOUNT && x.getValue().signum()<=0) throw new RestApiException("400","Amount must be positive");
+        if(x.getEndDate()!=null && x.getStartDate()!=null && x.getEndDate().isBefore(x.getStartDate())) throw new RestApiException("400","End date precedes start date");
+        if(x.getStartDate()==null) x.setStartDate(LocalDate.now());
+        if(x.getCategories()!=null) for(String c:x.getCategories()) { try { if(categoryService.getByCode(store,c)==null) throw new RestApiException("400","Unknown category: "+c); } catch (com.salesmanager.core.business.exception.ServiceException e) { throw new RestApiException("400","Unknown category: "+c); } }
+        Discount d=x.toEntity(); d.setCode(x.getCode().trim()); return d;
+    }
+}
