+ private DiscountData out(Discount d){DiscountData x=new DiscountData();x.setId(d.getId());x.setCode(d.getCode());x.setType(d.getType());x.setValue(d.getValue());x.setMinimumSubtotal(d.getMinimumSubtotal());x.setStartDate(d.getStartDate());x.setEndDate(d.getEndDate());x.setCategories(d.getCategories()==null?new java.util.ArrayList<>():new java.util.ArrayList<>(d.getCategories()));x.setActive(d.isActive());return x;}
+}
