+package com.salesmanager.core.business.services.discount;
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDate;
+import java.util.List;
+import java.util.Locale;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.category.CategoryRepository;
+import com.salesmanager.core.business.repositories.discount.DiscountRepository;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service("discountService")
+public class DiscountServiceImpl implements DiscountService {
+  private final DiscountRepository repo; private final CategoryRepository categories;
+  @Inject public DiscountServiceImpl(DiscountRepository repo, CategoryRepository categories){this.repo=repo;this.categories=categories;}
+  public Discount create(Discount d, MerchantStore s){validate(d,s,null); d.setMerchantStore(s); return repo.save(d);}
+  public Discount update(Long id, Discount d, MerchantStore s){Discount old=repo.findByIdAndMerchantStoreId(id,s.getId()); if(old==null) throw new IllegalArgumentException("Discount not found"); validate(d,s,id); d.setId(id); d.setMerchantStore(s); return repo.save(d);}
+  public List<Discount> list(MerchantStore s){return repo.findByMerchantStoreId(s.getId());}
+  public void delete(Long id, MerchantStore s){Discount d=repo.findByIdAndMerchantStoreId(id,s.getId()); if(d==null) throw new IllegalArgumentException("Discount not found"); repo.delete(d);}
+  public Discount find(String code, MerchantStore s){return code==null?null:repo.findByMerchantStoreIdAndCodeIgnoreCase(s.getId(),code);}
+  private void validate(Discount d, MerchantStore s, Long id){
+    if(d.getCode()==null||d.getCode().trim().isEmpty()||d.getValue()==null||d.getType()==null) throw new IllegalArgumentException("code, type and value are required");
+    if(d.getType()==DiscountType.PERCENT && (d.getValue().signum()<=0||d.getValue().compareTo(BigDecimal.valueOf(100))>0)) throw new IllegalArgumentException("invalid percent");
+    if(d.getType()==DiscountType.AMOUNT && d.getValue().signum()<=0) throw new IllegalArgumentException("invalid amount");
+    if(d.getStartDate()==null)d.setStartDate(LocalDate.now()); if(d.getEndDate()!=null&&d.getEndDate().isBefore(d.getStartDate()))throw new IllegalArgumentException("invalid dates");
+    if(repo.findByMerchantStoreIdAndCodeIgnoreCase(s.getId(),d.getCode())!=null && (id==null || !repo.findByMerchantStoreIdAndCodeIgnoreCase(s.getId(),d.getCode()).getId().equals(id))) throw new IllegalStateException("duplicate discount code");
+    if(d.getCategories()!=null) for(String c:d.getCategories()) if(categories.findByCode(s.getId(),c)==null) throw new IllegalArgumentException("unknown category: "+c);
+  }
+  public boolean applies(ShoppingCart cart, MerchantStore store, Discount d){
+    if(d==null||!d.isActive()||d.getMerchantStore()==null||!d.getMerchantStore().getId().equals(store.getId()))return false;
+    LocalDate today=LocalDate.now(); if(d.getStartDate()!=null&&today.isBefore(d.getStartDate())||d.getEndDate()!=null&&today.isAfter(d.getEndDate()))return false;
+    BigDecimal subtotal=eligible(cart,d); if(d.getMinimumSubtotal()!=null&&subtotal.add(ineligible(cart,d)).compareTo(d.getMinimumSubtotal())<0)return false; return subtotal.signum()>0;
+  }
+  public BigDecimal calculate(ShoppingCart cart, MerchantStore store, Discount d){if(!applies(cart,store,d))return BigDecimal.ZERO; BigDecimal base=eligible(cart,d); BigDecimal result=d.getType()==DiscountType.PERCENT?base.multiply(d.getValue()).divide(BigDecimal.valueOf(100),8,RoundingMode.HALF_UP):d.getValue().min(base); return result.setScale(2,RoundingMode.HALF_UP);}
+  public boolean eligibleItem(ShoppingCartItem item, Discount d){return eligible(item,d);}
+  private BigDecimal eligible(ShoppingCart c,Discount d){BigDecimal n=BigDecimal.ZERO;for(ShoppingCartItem i:c.getLineItems())if(eligible(i,d))n=n.add(i.getSubTotal()!=null?i.getSubTotal():i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity())));return n;}
+  private BigDecimal ineligible(ShoppingCart c,Discount d){BigDecimal n=BigDecimal.ZERO;for(ShoppingCartItem i:c.getLineItems())if(!eligible(i,d))n=n.add(i.getSubTotal()!=null?i.getSubTotal():i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity())));return n;}
+  private boolean eligible(ShoppingCartItem i,Discount d){if(d.getCategories()==null||d.getCategories().isEmpty())return true;if(i.getProduct()==null||i.getProduct().getCategories()==null)return false;for(Category c:i.getProduct().getCategories())for(String wanted:d.getCategories()){Category current=c;while(current!=null){if(current.getCode()!=null&&current.getCode().equalsIgnoreCase(wanted))return true;current=current.getParent();}}return false;}
+}
