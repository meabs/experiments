+package com.salesmanager.core.business.services.discount;
+
+import java.time.LocalDate;
+import java.util.List;
+import java.util.Locale;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.discount.DiscountCodeRepository;
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.model.discount.DiscountCode;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("discountCodeService")
+public class DiscountCodeService {
+    @Inject private DiscountCodeRepository repository;
+    @Inject private CategoryService categoryService;
+
+    public List<DiscountCode> list(MerchantStore store) { return repository.findByMerchantStoreId(store.getId()); }
+    public DiscountCode find(MerchantStore store, String code) { return repository.findByMerchantStoreIdAndCodeNormalized(store.getId(), normalize(code)); }
+    public DiscountCode find(MerchantStore store, Long id) { return repository.findByIdAndMerchantStoreId(id, store.getId()); }
+    public DiscountCode save(DiscountCode value, MerchantStore store) throws ServiceException {
+        validate(value, store);
+        DiscountCode duplicate = repository.findByMerchantStoreIdAndCodeNormalized(store.getId(), value.getCodeNormalized());
+        if (duplicate != null && !duplicate.getId().equals(value.getId())) throw new DiscountConflictException("Discount code already exists");
+        value.setMerchantStore(store);
+        return repository.saveAndFlush(value);
+    }
+    public void delete(DiscountCode value) { repository.delete(value); }
+    public static String normalize(String code) { return code == null ? null : code.trim().toUpperCase(Locale.ROOT); }
+    private void validate(DiscountCode d, MerchantStore store) throws ServiceException {
+        if (d.getCode() == null || d.getCode().trim().isEmpty() || d.getValue() == null || d.getType() == null) throw new ServiceException("Code, type and value are required");
+        d.setCode(d.getCode().trim()); d.setCodeNormalized(normalize(d.getCode()));
+        if ((d.getType() == DiscountType.PERCENT && (d.getValue().signum() <= 0 || d.getValue().compareTo(java.math.BigDecimal.valueOf(100)) > 0)) || (d.getType() == DiscountType.AMOUNT && d.getValue().signum() <= 0)) throw new ServiceException("Invalid discount value");
+        if (d.getStartDate() == null) d.setStartDate(LocalDate.now());
+        if (d.getEndDate() != null && d.getEndDate().isBefore(d.getStartDate())) throw new ServiceException("End date cannot be before start date");
+        if (d.getCategories() != null) for (String category : d.getCategories()) if (categoryService.getByCode(store, category) == null) throw new ServiceException("Unknown category: " + category);
+        if (d.getCategories() == null) d.setCategories(java.util.Collections.emptyList());
+    }
+    public static class DiscountConflictException extends RuntimeException { public DiscountConflictException(String message) { super(message); } }
+}
