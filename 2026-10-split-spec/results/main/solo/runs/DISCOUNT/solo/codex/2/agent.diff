+package com.salesmanager.shop.store.api.v1.discount;
+import java.time.LocalDate; import java.util.List; import java.util.Locale; import java.util.stream.Collectors; import javax.inject.Inject;
+import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import org.springframework.web.server.ResponseStatusException; import com.salesmanager.core.business.services.catalog.category.CategoryService; import com.salesmanager.core.business.services.discount.DiscountService; import com.salesmanager.core.model.discount.Discount; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.discount.PersistableDiscount; import com.salesmanager.shop.store.api.exception.ResourceNotFoundException; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/discounts") public class DiscountApi {
+ @Inject private DiscountService service; @Inject private CategoryService categories;
+ private Discount convert(PersistableDiscount p, MerchantStore s){LocalDate start=p.getStartDate()==null?LocalDate.now():p.getStartDate();if(p.getCode()==null||p.getCode().trim().isEmpty()||p.getType()==null||p.getValue()==null||p.getValue().compareTo(java.math.BigDecimal.ZERO)<=0||(p.getType().name().equals("PERCENT")&&p.getValue().compareTo(java.math.BigDecimal.valueOf(100))>0)||(p.getEndDate()!=null&&p.getEndDate().isBefore(start))) throw new ResponseStatusException(HttpStatus.BAD_REQUEST,"Invalid discount"); Discount d=new Discount(); d.setId(p.getId()); d.setCode(p.getCode()); d.setType(p.getType()); d.setValue(p.getValue()); d.setMinimumSubtotal(p.getMinimumSubtotal()); d.setStartDate(start); d.setEndDate(p.getEndDate()); d.setActive(p.getActive()==null||p.getActive()); d.setCategories(p.getCategories()); d.setMerchantStore(s); try { for(String c:d.getCategories())if(categories.getByCode(s,c)==null)throw new ResponseStatusException(HttpStatus.BAD_REQUEST,"Unknown category: "+c); } catch(Exception e) { if(e instanceof ResponseStatusException) throw (ResponseStatusException)e; throw new ResponseStatusException(HttpStatus.BAD_REQUEST,"Unknown category"); } return d;}
+ private PersistableDiscount out(Discount d){PersistableDiscount p=new PersistableDiscount();p.setId(d.getId());p.setCode(d.getCode());p.setType(d.getType());p.setValue(d.getValue());p.setMinimumSubtotal(d.getMinimumSubtotal());p.setStartDate(d.getStartDate());p.setEndDate(d.getEndDate());p.setCategories(d.getCategories());p.setActive(d.isActive());return p;}
+ @PostMapping public ResponseEntity<PersistableDiscount> create(@RequestBody PersistableDiscount p,@ApiIgnore MerchantStore s){if(service.find(p.getCode(),s)!=null)throw new ResponseStatusException(HttpStatus.CONFLICT,"Code already exists");return ResponseEntity.status(HttpStatus.CREATED).body(out(service.save(convert(p,s),s)));}
+ @GetMapping public List<PersistableDiscount> list(@ApiIgnore MerchantStore s){return service.list(s).stream().map(this::out).collect(Collectors.toList());}
+ @PutMapping("/{id}") public PersistableDiscount update(@PathVariable Long id,@RequestBody PersistableDiscount p,@ApiIgnore MerchantStore s){Discount old=service.get(id,s);if(old==null)throw new ResourceNotFoundException("Discount not found");Discount same=service.find(p.getCode(),s);if(same!=null&&!id.equals(same.getId()))throw new ResponseStatusException(HttpStatus.CONFLICT,"Code already exists");p.setId(id);return out(service.save(convert(p,s),s));}
+ @DeleteMapping("/{id}") public ResponseEntity<Void> delete(@PathVariable Long id,@ApiIgnore MerchantStore s){if(service.get(id,s)==null)throw new ResourceNotFoundException("Discount not found");service.delete(id,s);return ResponseEntity.noContent().build();}
+}
