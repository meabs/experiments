+package com.salesmanager.core.business.services.discount;
+import java.math.BigDecimal; import java.math.RoundingMode; import java.time.LocalDate; import java.util.*;
+import javax.inject.Inject; import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.discount.DiscountRepository; import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.model.catalog.category.Category; import com.salesmanager.core.model.discount.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.shoppingcart.*;
+@Service("discountService") public class DiscountServiceImpl implements DiscountService {
+ @Inject private DiscountRepository repository; @Inject private CategoryService categoryService;
+ public Discount save(Discount d, MerchantStore s){d.setMerchantStore(s); d.setCode(d.getCode().trim()); d.setCodeKey(d.getCode().toLowerCase(Locale.ROOT)); return repository.saveAndFlush(d);}
+ public List<Discount> list(MerchantStore s){return repository.findByMerchantStoreId(s.getId());}
+ public Discount get(Long id, MerchantStore s){return repository.findByIdAndMerchantStoreId(id,s.getId());}
+ public void delete(Long id, MerchantStore s){Discount d=get(id,s); if(d!=null) repository.delete(d);}
+ public Discount find(String code, MerchantStore s){return code==null?null:repository.findByMerchantStoreIdAndCodeKey(s.getId(),code.toLowerCase(Locale.ROOT));}
+ private boolean eligible(ShoppingCartItem i, Discount d){if(d.getCategories().isEmpty())return true; if(i.getProduct()==null)return false; for(Category c:i.getProduct().getCategories()) for(String wanted:d.getCategories()){Category x=c; while(x!=null){if(wanted.equalsIgnoreCase(x.getCode()))return true; x=x.getParent();}} return false;}
+ public boolean applies(Discount d, ShoppingCart cart){if(d==null||!d.isActive()||d.getMerchantStore().getId().intValue()!=cart.getMerchantStore().getId().intValue())return false; LocalDate today=LocalDate.now(); if(d.getStartDate()==null||today.isBefore(d.getStartDate())||(d.getEndDate()!=null&&today.isAfter(d.getEndDate())))return false; BigDecimal subtotal=subtotal(cart); if(d.getMinimumSubtotal()!=null&&subtotal.compareTo(d.getMinimumSubtotal())<0)return false; return cart.getLineItems().stream().anyMatch(i->eligible(i,d));}
+ private BigDecimal subtotal(ShoppingCart c){return c.getLineItems().stream().map(i->price(i).multiply(BigDecimal.valueOf(i.getQuantity()))).reduce(BigDecimal.ZERO,BigDecimal::add);}
+ private BigDecimal price(ShoppingCartItem i){return i.getItemPrice()==null?BigDecimal.ZERO:i.getItemPrice();}
+ public BigDecimal discountFor(Discount d, ShoppingCart c){if(!applies(d,c))return BigDecimal.ZERO; BigDecimal eligible=c.getLineItems().stream().filter(i->eligible(i,d)).map(i->price(i).multiply(BigDecimal.valueOf(i.getQuantity()))).reduce(BigDecimal.ZERO,BigDecimal::add); BigDecimal result=d.getType()==DiscountType.PERCENT?eligible.multiply(d.getValue()).divide(BigDecimal.valueOf(100)):d.getValue().min(eligible); return result.setScale(2,RoundingMode.HALF_UP);}
+}
