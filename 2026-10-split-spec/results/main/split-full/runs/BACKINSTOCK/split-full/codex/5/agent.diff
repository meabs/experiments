+package com.salesmanager.core.business.services.catalog.product.alert;
+
+import java.util.Date;
+import java.util.List;
+import java.util.regex.Pattern;
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.alert.StockAlertRepository;
+import com.salesmanager.core.business.repositories.catalog.product.alert.StockAlertOutboxRepository;
+import com.salesmanager.core.business.repositories.merchant.MerchantRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.alert.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+    private static final Pattern EMAIL = Pattern.compile("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$");
+    private final StockAlertRepository alerts;
+    private final StockAlertOutboxRepository outbox;
+    private final MerchantRepository stores;
+    private final ProductService products;
+
+    @Inject
+    public StockAlertServiceImpl(StockAlertRepository alerts, StockAlertOutboxRepository outbox,
+            MerchantRepository stores, ProductService products) {
+        this.alerts = alerts; this.outbox = outbox; this.stores = stores; this.products = products;
+    }
+    private MerchantStore store(String code) {
+        MerchantStore s = stores.findByCode(code);
+        if (s == null) throw new IllegalArgumentException("Unknown store");
+        return s;
+    }
+    private static String validEmail(String email) {
+        if (email == null || !EMAIL.matcher(email.trim()).matches()) throw new IllegalArgumentException("Invalid email");
+        return email.trim().toLowerCase(java.util.Locale.ROOT);
+    }
+    private Product product(String sku, MerchantStore store) {
+        try {
+            Product p = products.getBySku(sku, store);
+            if (p == null) throw new StockAlertNotFoundException("Unknown sku: " + sku);
+            return p;
+        } catch (StockAlertNotFoundException e) { throw e;
+        } catch (Exception e) { throw new StockAlertNotFoundException("Unknown sku: " + sku); }
+    }
+    @Override @Transactional
+    public StockAlert createOrGetPendingAlert(String storeCode, String sku, String email) {
+        MerchantStore store = store(storeCode); String normalized = validEmail(email);
+        Product product = product(sku, store);
+        if (product.getAvailabilities() != null && product.getAvailabilities().stream()
+                .anyMatch(a -> a.getProductQuantity() != null && a.getProductQuantity() > 0)) {
+            throw new ProductInStockException("Product is already in stock: " + sku);
+        }
+        StockAlert existing = alerts.findByMerchantStoreIdAndProductIdAndEmailIgnoreCaseAndStatus(store.getId(), product.getId(), normalized, StockAlertStatus.PENDING);
+        if (existing != null) return existing;
+        StockAlert alert = new StockAlert(); alert.setMerchantStore(store); alert.setProduct(product); alert.setSku(sku);
+        alert.setEmail(normalized); alert.setStatus(StockAlertStatus.PENDING); alert.setCreatedAt(new Date());
+        return alerts.save(alert);
+    }
+    @Override @Transactional
+    public void cancelAlert(String storeCode, String sku, String email) {
+        MerchantStore store = store(storeCode); Product product = product(sku, store);
+        StockAlert alert = alerts.findByMerchantStoreIdAndProductIdAndEmailIgnoreCaseAndStatus(store.getId(), product.getId(), validEmail(email), StockAlertStatus.PENDING);
+        if (alert == null) throw new StockAlertNotFoundException("Alert not found");
+        alerts.delete(alert);
+    }
+    @Override public List<StockAlert> listAlerts(String storeCode, StockAlertStatus status) {
+        Integer id = store(storeCode).getId(); return status == null ? alerts.findByMerchantStoreIdOrderByCreatedAtAsc(id) : alerts.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(id, status);
+    }
+    @Override public List<StockAlertOutbox> listOutbox(String storeCode) { return outbox.findByMerchantStoreIdOrderByCreatedAtAsc(store(storeCode).getId()); }
+    @Override @Transactional
+    public void releaseForProduct(Product product) {
+        if (product == null || product.getId() == null) return;
+        List<StockAlert> pending = alerts.findByProductIdAndStatusOrderByCreatedAtAsc(product.getId(), StockAlertStatus.PENDING);
+        for (StockAlert a : pending) {
+            a.setStatus(StockAlertStatus.SENT); a.setSentAt(new Date()); alerts.save(a);
+            StockAlertOutbox message = new StockAlertOutbox(); message.setMerchantStore(a.getMerchantStore()); message.setTo(a.getEmail()); message.setSku(a.getSku());
+            String name = a.getSku(); if (product.getDescriptions() != null && !product.getDescriptions().isEmpty()) name = product.getDescriptions().iterator().next().getName();
+            message.setSubject(name + " is back in stock"); message.setCreatedAt(new Date()); outbox.save(message);
+        }
+    }
+    @Override @Transactional public void deleteForProduct(Product product) { if (product != null && product.getId() != null) alerts.deleteByProductId(product.getId()); }
+}
