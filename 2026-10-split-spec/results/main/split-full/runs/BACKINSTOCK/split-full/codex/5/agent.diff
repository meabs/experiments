+/** Shopper subscription and merchant outbox endpoints. */
+@RestController
+@RequestMapping("/api/v1")
+@Api(tags = {"Stock alert resource"})
+public class StockAlertApi {
+
+    private final StockAlertService stockAlertService;
+
+    public StockAlertApi(StockAlertService stockAlertService) {
+        this.stockAlertService = stockAlertService;
+    }
+
+    @PostMapping("/products/{sku}/alerts")
+    public ResponseEntity<ReadableStockAlert> create(@PathVariable String sku,
+                                     @Valid @RequestBody StockAlertRequest request,
+                                     @ApiIgnore MerchantStore store) {
+        // The service deliberately has an idempotent create-or-get contract.  Check
+        // first so the HTTP status can distinguish an existing subscription (200)
+        // from a newly-created one (201).
+        boolean existing = false;
+        for (StockAlert alert : stockAlertService.listAlerts(store.getCode(), StockAlertStatus.PENDING)) {
+            if (sku.equals(alert.getSku()) && request.getEmail() != null
+                    && request.getEmail().trim().equalsIgnoreCase(alert.getEmail())) {
+                existing = true;
+                break;
+            }
+        }
+        ReadableStockAlert result = toDto(stockAlertService.createOrGetPendingAlert(store.getCode(), sku, request.getEmail()));
+        return ResponseEntity.status(existing ? HttpStatus.OK : HttpStatus.CREATED).body(result);
+    }
+
+    @DeleteMapping("/products/{sku}/alerts")
+    @ResponseStatus(HttpStatus.NO_CONTENT)
+    public void cancel(@PathVariable String sku, @RequestParam String email,
+                       @ApiIgnore MerchantStore store) {
+        stockAlertService.cancelAlert(store.getCode(), sku, email);
+    }
+
+    @GetMapping("/private/stock-alerts")
+    public List<ReadableStockAlert> list(@RequestParam(required = false) String status,
+                                         @ApiIgnore MerchantStore store) {
+        if (status != null && !"PENDING".equals(status) && !"SENT".equals(status)) {
+            throw new RestApiException("Invalid stock alert status: " + status);
+        }
+        List<ReadableStockAlert> result = new ArrayList<>();
+        StockAlertStatus filter = status == null ? null : StockAlertStatus.valueOf(status);
+        for (StockAlert alert : stockAlertService.listAlerts(store.getCode(), filter)) result.add(toDto(alert));
+        return result;
+    }
+
+    @GetMapping("/private/stock-alerts/outbox")
+    public List<ReadableStockAlertOutboxMessage> outbox(@ApiIgnore MerchantStore store) {
+        List<ReadableStockAlertOutboxMessage> result = new ArrayList<>();
+        for (StockAlertOutbox message : stockAlertService.listOutbox(store.getCode())) result.add(toDto(message));
+        return result;
+    }
+
+    private ReadableStockAlert toDto(StockAlert source) {
+        ReadableStockAlert dto = new ReadableStockAlert();
+        dto.setId(source.getId()); dto.setSku(source.getSku()); dto.setEmail(source.getEmail());
+        dto.setStatus(source.getStatus() == null ? null : source.getStatus().toString());
+        dto.setCreatedAt(source.getCreatedAt()); dto.setSentAt(source.getSentAt());
+        return dto;
+    }
+
+    private ReadableStockAlertOutboxMessage toDto(StockAlertOutbox source) {
+        ReadableStockAlertOutboxMessage dto = new ReadableStockAlertOutboxMessage();
+        dto.setTo(source.getTo()); dto.setSku(source.getSku()); dto.setSubject(source.getSubject());
+        dto.setCreatedAt(source.getCreatedAt());
+        return dto;
+    }
+
+    @ExceptionHandler(IllegalArgumentException.class)
+    public ResponseEntity<Void> badRequest(IllegalArgumentException exception) {
+        String message = exception.getMessage() == null ? "" : exception.getMessage().toLowerCase();
+        if (message.contains("unknown sku")) return ResponseEntity.notFound().build();
+        if (message.contains("alert not found")) return ResponseEntity.notFound().build();
+        if (message.contains("in stock") || message.contains("out of stock"))
+            return ResponseEntity.status(HttpStatus.CONFLICT).build();
+        return ResponseEntity.badRequest().build();
+    }
+}
