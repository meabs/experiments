+package com.salesmanager.shop.store.api.v1;
+
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.availability.ProductAvailabilityService;
+import com.salesmanager.core.business.services.stockalert.StockAlertService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.stockalert.*;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Shopper stock-alert subscription and the protected admin views. */
+@RestController
+@RequestMapping("/api/v1")
+public class StockAlertApi {
+  @Inject private StockAlertService alertService;
+  @Inject private ProductService productService;
+  @Inject private ProductAvailabilityService availabilityService;
+
+  @PostMapping("/products/{sku}/alerts")
+  @ApiImplicitParams(@ApiImplicitParam(name="store", dataType="String", defaultValue="DEFAULT"))
+  public org.springframework.http.ResponseEntity<AlertResponse> create(@PathVariable String sku, @RequestBody AlertRequest request,
+      @ApiIgnore MerchantStore store) {
+    if (request == null || request.getEmail() == null ||
+        !request.getEmail().matches("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"))
+      throw new StockAlertBadRequestException("Invalid email");
+    Product product = product(sku, store);
+    int quantity = 0;
+    for (com.salesmanager.core.model.catalog.product.availability.ProductAvailability a : availabilityService.getBySku(sku, store))
+      if (a.getProductQuantity() != null) quantity += a.getProductQuantity();
+    boolean duplicate = false;
+    for (StockAlert existing : alertService.list(store, StockAlertStatus.PENDING))
+      if (existing.getProduct().getId().equals(product.getId()) && existing.getEmail().equalsIgnoreCase(request.getEmail())) duplicate = true;
+    StockAlert alert = alertService.create(product, request.getEmail(), quantity);
+    return new org.springframework.http.ResponseEntity<>(AlertResponse.from(alert), duplicate ? HttpStatus.OK : HttpStatus.CREATED);
+  }
+
+  @DeleteMapping("/products/{sku}/alerts")
+  @ResponseStatus(HttpStatus.NO_CONTENT)
+  public void cancel(@PathVariable String sku, @RequestParam String email, @ApiIgnore MerchantStore store) {
+    if (!alertService.cancel(product(sku, store), email)) throw new ResourceNotFoundException("Alert not found");
+  }
+
+  @GetMapping("/private/stock-alerts")
+  public List<AlertResponse> list(@RequestParam(required=false) String status, @ApiIgnore MerchantStore store) {
+    StockAlertStatus filter = parseStatus(status);
+    List<AlertResponse> result = new ArrayList<>();
+    for (StockAlert a : alertService.list(store, filter)) result.add(AlertResponse.from(a));
+    return result;
+  }
+
+  @GetMapping("/private/stock-alerts/outbox")
+  public List<OutboxResponse> outbox(@ApiIgnore MerchantStore store) {
+    List<OutboxResponse> result = new ArrayList<>();
+    for (StockAlertOutbox m : alertService.listOutbox(store)) result.add(OutboxResponse.from(m));
+    return result;
+  }
+
+  private Product product(String sku, MerchantStore store) {
+    try {
+      Product p = productService.getBySku(sku, store);
+      if (p == null) throw new ResourceNotFoundException("Unknown sku");
+      return p;
+    } catch (ResourceNotFoundException e) { throw e; }
+    catch (Exception e) { throw new ResourceNotFoundException("Unknown sku"); }
+  }
+
+  private StockAlertStatus parseStatus(String value) {
+    if (value == null || value.trim().isEmpty()) return null;
+    try { return StockAlertStatus.valueOf(value); }
+    catch (IllegalArgumentException e) { throw new StockAlertBadRequestException("Invalid status"); }
+  }
+
+  public static class AlertRequest { private String email; public String getEmail(){return email;} public void setEmail(String e){email=e;} }
+  public static class AlertResponse {
+    private Long id; private String sku; private String email; private StockAlertStatus status; private Date createdAt; private Date sentAt;
+    public static AlertResponse from(StockAlert a){ AlertResponse r=new AlertResponse(); r.id=a.getId();r.sku=a.getSku();r.email=a.getEmail();r.status=a.getStatus();r.createdAt=a.getCreatedAt();r.sentAt=a.getSentAt();return r; }
+    public Long getId(){return id;} public String getSku(){return sku;} public String getEmail(){return email;} public StockAlertStatus getStatus(){return status;} public Date getCreatedAt(){return createdAt;} public Date getSentAt(){return sentAt;}
+  }
+  public static class OutboxResponse {
+    private String to; private String sku; private String subject; private Date createdAt;
+    public static OutboxResponse from(StockAlertOutbox m){OutboxResponse r=new OutboxResponse();r.to=m.getRecipient();r.sku=m.getSku();r.subject=m.getSubject();r.createdAt=m.getCreatedAt();return r;}
+    public String getTo(){return to;} public String getSku(){return sku;} public String getSubject(){return subject;} public Date getCreatedAt(){return createdAt;}
+  }
+}
