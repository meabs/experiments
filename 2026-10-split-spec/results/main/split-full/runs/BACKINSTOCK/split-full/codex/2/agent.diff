+package com.salesmanager.core.business.services.stockalert;
+
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.stockalert.*;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.stockalert.*;
+
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+ private final StockAlertRepository alerts; private final StockAlertOutboxRepository outbox;
+ @Inject public StockAlertServiceImpl(StockAlertRepository alerts, StockAlertOutboxRepository outbox){this.alerts=alerts;this.outbox=outbox;}
+ @Override @Transactional public StockAlert create(Product product,String email){return create(product,email,0);}
+ @Override @Transactional public StockAlert createAlert(Product product,String email){return create(product,email);}
+ @Override @Transactional public StockAlert create(Product product,String email,int quantity){
+  if(product==null || product.getMerchantStore()==null) throw new IllegalArgumentException("Product is required");
+  if(email==null || !email.matches("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$")) throw new IllegalArgumentException("Invalid email");
+  if(quantity>0) throw new IllegalStateException("Product is in stock");
+  Optional<StockAlert> existing=alerts.findFirstByMerchantStoreIdAndProductIdAndStatusAndEmailIgnoreCase(product.getMerchantStore().getId(),product.getId(),StockAlertStatus.PENDING,email);
+  if(existing.isPresent()) return existing.get();
+  StockAlert a=new StockAlert(); a.setProduct(product); a.setMerchantStore(product.getMerchantStore()); a.setSku(product.getSku()); a.setEmail(email); a.setStatus(StockAlertStatus.PENDING); return alerts.saveAndFlush(a);
+ }
+ @Override @Transactional public boolean cancel(Product product,String email){return product!=null && cancel(product.getMerchantStore(),product.getSku(),email);}
+ @Override @Transactional public boolean cancel(MerchantStore store,String sku,String email){
+  if(store==null||sku==null||email==null) return false;
+  Optional<StockAlert> found=alerts.findFirstByMerchantStoreIdAndProductIdAndEmailIgnoreCase(store.getId(), findProductId(store,sku),email);
+  if(!found.isPresent() || found.get().getStatus()!=StockAlertStatus.PENDING) return false; alerts.delete(found.get()); return true;
+ }
+ /* Product lookup belongs at the service boundary; cancellation by Product is preferred. */
+ private Long findProductId(MerchantStore store,String sku){ for(StockAlert a:alerts.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId())) if(sku.equals(a.getSku())) return a.getProduct().getId(); return -1L; }
+ @Override public List<StockAlert> list(MerchantStore store,StockAlertStatus status){if(store==null)return Collections.emptyList(); return status==null?alerts.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId()):alerts.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(store.getId(),status);}
+ @Override public List<StockAlertOutbox> listOutbox(MerchantStore store){return store==null?Collections.emptyList():outbox.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId());}
+ @Override @Transactional public void dispatchPendingAlerts(Product product,int previousQuantity,int newQuantity){
+  if(product==null||previousQuantity!=0||newQuantity<=0)return; Integer store=product.getMerchantStore().getId();
+  for(StockAlert a:alerts.findByMerchantStoreIdAndProductIdAndStatus(store,product.getId(),StockAlertStatus.PENDING)){a.setStatus(StockAlertStatus.SENT);a.setSentAt(new Date());alerts.save(a); StockAlertOutbox m=new StockAlertOutbox();m.setMerchantStore(product.getMerchantStore());m.setRecipient(a.getEmail());m.setSku(product.getSku());m.setSubject(productName(product)+" is back in stock");outbox.save(m);}
+ }
+ private String productName(Product p){if(p.getDescriptions()!=null&&!p.getDescriptions().isEmpty()) return p.getDescriptions().iterator().next().getName(); return p.getSku();}
+ @Override @Transactional public void deleteForProduct(Product product){if(product!=null&&product.getId()!=null)alerts.deleteByProductId(product.getId());}
+}
