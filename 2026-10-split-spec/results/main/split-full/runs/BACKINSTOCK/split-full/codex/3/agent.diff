+package com.salesmanager.core.business.services.catalog.product.alert;
+
+import java.util.*;
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.ProductRepository;
+import com.salesmanager.core.business.repositories.catalog.product.alert.*;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.alert.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+    private final StockAlertRepository alertRepository;
+    private final StockAlertOutboxRepository outboxRepository;
+    private final ProductRepository productRepository;
+
+    @Inject
+    public StockAlertServiceImpl(StockAlertRepository alertRepository,
+            StockAlertOutboxRepository outboxRepository, ProductRepository productRepository) {
+        this.alertRepository = alertRepository;
+        this.outboxRepository = outboxRepository;
+        this.productRepository = productRepository;
+    }
+
+    @Override @Transactional
+    public StockAlert create(MerchantStore store, String sku, String email) {
+        requireStore(store); String normalizedSku = require(sku, "sku");
+        String normalizedEmail = require(email, "email");
+        validateEmail(normalizedEmail);
+        Product product = productRepository.getByCode(normalizedSku, store);
+        if (product == null) throw new NoSuchElementException("Unknown product: " + normalizedSku);
+        if (inStock(product)) throw new IllegalStateException("Product is in stock");
+        StockAlert existing = alertRepository.findFirstByStore_IdAndSkuAndEmailIgnoreCaseAndStatus(
+            store.getId(), normalizedSku, normalizedEmail, StockAlertStatus.PENDING);
+        if (existing != null) return existing;
+        StockAlert alert = new StockAlert(); alert.setStore(store); alert.setSku(normalizedSku);
+        alert.setEmail(normalizedEmail); alert.setStatus(StockAlertStatus.PENDING); alert.setCreatedAt(new Date());
+        return alertRepository.save(alert);
+    }
+
+    @Override @Transactional
+    public StockAlert cancel(MerchantStore store, String sku, String email) {
+        requireStore(store);
+        String normalizedEmail = require(email, "email");
+        validateEmail(normalizedEmail);
+        StockAlert alert = alertRepository.findFirstByStore_IdAndSkuAndEmailIgnoreCaseAndStatus(
+            store.getId(), require(sku, "sku"), normalizedEmail, StockAlertStatus.PENDING);
+        if (alert == null) throw new NoSuchElementException("Pending alert not found");
+        alertRepository.delete(alert); return alert;
+    }
+
+    @Override @Transactional
+    public List<StockAlert> list(MerchantStore store, StockAlertStatus status) {
+        requireStore(store);
+        return status == null ? alertRepository.findByStore_IdOrderByCreatedAtAscIdAsc(store.getId())
+            : alertRepository.findByStore_IdAndStatusOrderByCreatedAtAscIdAsc(store.getId(), status);
+    }
+    @Override public List<StockAlert> list(MerchantStore store) { return list(store, null); }
+    @Override @Transactional
+    public List<StockAlertOutbox> listOutbox(MerchantStore store) {
+        requireStore(store); return outboxRepository.findByStore_IdOrderByCreatedAtAscIdAsc(store.getId());
+    }
+
+    @Override @Transactional
+    public int notifyRestocked(MerchantStore store, String sku) {
+        requireStore(store); String normalizedSku = require(sku, "sku");
+        Product product = productRepository.getByCode(normalizedSku, store);
+        if (product == null || !inStock(product)) return 0;
+        List<StockAlert> pending = alertRepository.findByStore_IdAndSkuAndStatusOrderByCreatedAtAscIdAsc(
+            store.getId(), normalizedSku, StockAlertStatus.PENDING);
+        String name = normalizedSku;
+        if (product.getDescriptions() != null && !product.getDescriptions().isEmpty()) {
+            name = product.getDescriptions().iterator().next().getName();
+        }
+        Date sent = new Date();
+        for (StockAlert alert : pending) {
+            alert.setStatus(StockAlertStatus.SENT); alert.setSentAt(sent); alertRepository.save(alert);
+            StockAlertOutbox message = new StockAlertOutbox(); message.setStore(store); message.setTo(alert.getEmail());
+            message.setSku(normalizedSku); message.setSubject(name + " is back in stock"); message.setCreatedAt(sent);
+            outboxRepository.save(message);
+        }
+        return pending.size();
+    }
+
+    @Override @Transactional
+    public void deleteForProduct(MerchantStore store, String sku) {
+        requireStore(store); String normalizedSku = require(sku, "sku");
+        alertRepository.deleteByStore_IdAndSku(store.getId(), normalizedSku);
+        outboxRepository.deleteByStore_IdAndSku(store.getId(), normalizedSku);
+    }
+
+    private static boolean inStock(Product product) {
+        if (product.getAvailabilities() == null) return false;
+        return product.getAvailabilities().stream().anyMatch(a -> a.getProductQuantity() != null && a.getProductQuantity() > 0);
+    }
+    private static String require(String value, String name) {
+        if (value == null || value.trim().isEmpty()) throw new IllegalArgumentException(name + " is required");
+        return value.trim();
+    }
+    private static void validateEmail(String email) {
+        if (!email.matches("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$")) throw new IllegalArgumentException("Invalid email");
+    }
+    private static void requireStore(MerchantStore store) { if (store == null || store.getId() == null) throw new IllegalArgumentException("store is required"); }
+}
