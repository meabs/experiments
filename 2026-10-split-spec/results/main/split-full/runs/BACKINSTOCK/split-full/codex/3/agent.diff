+package com.salesmanager.shop.store.api.v1;
+
+import java.text.SimpleDateFormat;
+import java.util.Date;
+import java.util.List;
+import java.util.NoSuchElementException;
+import java.util.TimeZone;
+import java.util.stream.Collectors;
+
+import javax.validation.Valid;
+
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+
+import com.salesmanager.core.business.services.catalog.product.alert.StockAlertService;
+import com.salesmanager.core.model.catalog.product.alert.StockAlert;
+import com.salesmanager.core.model.catalog.product.alert.StockAlertOutbox;
+import com.salesmanager.core.model.catalog.product.alert.StockAlertStatus;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.stockalert.*;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Shopper subscription and administrator views for stock notifications. */
+@RestController
+@RequestMapping("/api/v1")
+public class StockAlertApi {
+    private static final String ISO = "yyyy-MM-dd'T'HH:mm:ss.SSSXXX";
+    @Autowired private StockAlertService stockAlertService;
+
+    @PostMapping("/products/{sku}/alerts")
+    public ResponseEntity<ReadableStockAlert> create(@PathVariable String sku,
+            @Valid @RequestBody StockAlertRequest request, @ApiIgnore MerchantStore merchantStore) {
+        try {
+            boolean duplicate = stockAlertService.list(merchantStore, StockAlertStatus.PENDING).stream()
+                    .anyMatch(a -> sku.equals(a.getSku()) && request.getEmail().equalsIgnoreCase(a.getEmail()));
+            StockAlert alert = stockAlertService.create(merchantStore, sku, request.getEmail());
+            return ResponseEntity.status(duplicate ? HttpStatus.OK : HttpStatus.CREATED).body(toDto(alert));
+        } catch (IllegalStateException e) {
+            return ResponseEntity.status(HttpStatus.CONFLICT).build();
+        } catch (NoSuchElementException e) {
+            throw new ResourceNotFoundException(e.getMessage());
+        } catch (IllegalArgumentException e) {
+            throw new RestApiException("400", e.getMessage());
+        }
+    }
+
+    @DeleteMapping("/products/{sku}/alerts")
+    public ResponseEntity<Void> cancel(@PathVariable String sku, @RequestParam String email,
+            @ApiIgnore MerchantStore merchantStore) {
+        try {
+            stockAlertService.cancel(merchantStore, sku, email);
+            return ResponseEntity.noContent().build();
+        } catch (NoSuchElementException e) {
+            throw new ResourceNotFoundException(e.getMessage());
+        } catch (IllegalArgumentException e) {
+            throw new RestApiException("400", e.getMessage());
+        }
+    }
+
+    @GetMapping("/private/stock-alerts")
+    public List<ReadableStockAlert> list(@RequestParam(required = false) String status,
+            @ApiIgnore MerchantStore merchantStore) {
+        StockAlertStatus parsed = parseStatus(status);
+        return stockAlertService.list(merchantStore, parsed).stream().map(StockAlertApi::toDto).collect(Collectors.toList());
+    }
+
+    @GetMapping("/private/stock-alerts/outbox")
+    public List<ReadableStockAlertOutbox> outbox(@ApiIgnore MerchantStore merchantStore) {
+        return stockAlertService.listOutbox(merchantStore).stream().map(StockAlertApi::toDto).collect(Collectors.toList());
+    }
+
+    private static StockAlertStatus parseStatus(String status) {
+        if (status == null || status.trim().isEmpty()) return null;
+        try { return StockAlertStatus.valueOf(status.toUpperCase()); }
+        catch (IllegalArgumentException e) { throw new RestApiException("400", "Invalid status: " + status); }
+    }
+    private static ReadableStockAlert toDto(StockAlert a) {
+        ReadableStockAlert d = new ReadableStockAlert(); d.setId(a.getId()); d.setSku(a.getSku()); d.setEmail(a.getEmail());
+        d.setStatus(a.getStatus() == null ? null : a.getStatus().name()); d.setCreatedAt(format(a.getCreatedAt())); d.setSentAt(format(a.getSentAt())); return d;
+    }
+    private static ReadableStockAlertOutbox toDto(StockAlertOutbox a) {
+        ReadableStockAlertOutbox d = new ReadableStockAlertOutbox(); d.setTo(a.getTo()); d.setSku(a.getSku()); d.setSubject(a.getSubject()); d.setCreatedAt(format(a.getCreatedAt())); return d;
+    }
+    private static String format(Date date) {
+        if (date == null) return null; SimpleDateFormat f = new SimpleDateFormat(ISO); f.setTimeZone(TimeZone.getTimeZone("UTC")); return f.format(date);
+    }
+}
