+    }
+    private boolean hasStock(Product p) {
+        if (p.getAvailabilities() == null) return false;
+        return p.getAvailabilities().stream().anyMatch(a -> a.getProductQuantity() != null && a.getProductQuantity() > 0);
+    }
+    private void authorize(MerchantStore store) {
+        String user = authorizationUtils.authenticatedUser();
+        authorizationUtils.authorizeUser(user, java.util.stream.Stream.of(Constants.GROUP_SUPERADMIN,
+                Constants.GROUP_ADMIN, Constants.GROUP_ADMIN_ORDER, Constants.GROUP_ADMIN_RETAIL).collect(Collectors.toList()), store);
+    }
+    private static StockAlert read(com.salesmanager.core.model.catalog.product.alert.StockAlert a) {
+        StockAlert r = new StockAlert(); r.setId(a.getId()); r.setSku(a.getSku()); r.setEmail(a.getEmail());
+        r.setStatus(com.salesmanager.shop.model.catalog.product.alert.StockAlertStatus.valueOf(a.getStatus().name())); r.setCreatedAt(a.getCreatedAt()); r.setSentAt(a.getSentAt()); return r;
+    }
+    private static StockAlertOutbox readOutbox(com.salesmanager.core.model.catalog.product.alert.StockAlertOutbox a) {
+        StockAlertOutbox r = new StockAlertOutbox(); r.setTo(a.getTo()); r.setSku(a.getSku());
+        r.setSubject(a.getSubject()); r.setCreatedAt(a.getCreatedAt()); return r;
+    }
+}
