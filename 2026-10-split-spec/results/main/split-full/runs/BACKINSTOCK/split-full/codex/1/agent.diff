+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.utils.AuthorizationUtils;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Shopper stock-alert subscription and the merchant's alert inbox/outbox. */
+@RestController
+@RequestMapping("/api/v1")
+public class StockAlertApi {
+    @Inject private StockAlertService stockAlertService;
+    @Inject private ProductService productService;
+    @Inject private AuthorizationUtils authorizationUtils;
+
+    @RequestMapping("/products/{sku}/alerts")
+    public ResponseEntity<StockAlert> create(@PathVariable String sku,
+            @Valid @RequestBody StockAlertRequest request,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language) {
+        Product product = product(sku, store, language);
+        if (hasStock(product))
+            throw new ResponseStatusException(HttpStatus.CONFLICT, "Product is in stock");
+        try {
+            com.salesmanager.core.model.catalog.product.alert.StockAlert existing = stockAlertService.findPending(product, store, request.getEmail());
+            com.salesmanager.core.model.catalog.product.alert.StockAlert alert = existing == null ? stockAlertService.create(product, store, request.getEmail()) : existing;
+            return ResponseEntity.status(existing == null ? HttpStatus.CREATED : HttpStatus.OK).body(read(alert));
+        } catch (IllegalArgumentException e) {
+            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, e.getMessage(), e);
+        }
+    }
+
+    @DeleteMapping("/products/{sku}/alerts")
