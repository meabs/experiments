+package com.salesmanager.core.business.services.stockalert;
+import java.util.*;
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.stockalert.*;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.alert.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+ private final StockAlertRepository alerts; private final StockAlertOutboxRepository outbox;
+ @Inject public StockAlertServiceImpl(StockAlertRepository a,StockAlertOutboxRepository o){alerts=a;outbox=o;}
+ private void valid(String email){if(email==null || !email.matches("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$")) throw new IllegalArgumentException("Invalid email");}
+ public StockAlert findPending(Product p,MerchantStore s,String e){valid(e);return alerts.findFirstByProductIdAndMerchantStoreIdAndEmailIgnoreCaseAndStatus(p.getId(),s.getId(),e,StockAlertStatus.PENDING);}
+ @Transactional public StockAlert create(Product p,MerchantStore s,String e){valid(e); StockAlert old=findPending(p,s,e); if(old!=null)return old; StockAlert a=new StockAlert();a.setProduct(p);a.setMerchantStore(s);a.setSku(p.getSku());a.setEmail(e);a.setStatus(StockAlertStatus.PENDING);a.setCreatedAt(new Date());return alerts.save(a);}
+ @Transactional public void cancel(Product p,MerchantStore s,String e){StockAlert a=findPending(p,s,e);if(a==null)throw new NoSuchElementException("Alert not found");alerts.delete(a);}
+ public List<StockAlert> list(MerchantStore s,StockAlertStatus status){return status==null?alerts.findByMerchantStoreIdOrderByCreatedAtAsc(s.getId()):alerts.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(s.getId(),status);}
+ public List<StockAlertOutbox> listOutbox(MerchantStore s){return outbox.findByMerchantStoreIdOrderByCreatedAtAsc(s.getId());}
+ @Transactional public void sendOnRestock(Product p,MerchantStore s){List<StockAlert> as=alerts.findByProductIdAndMerchantStoreIdAndStatusOrderByCreatedAtAsc(p.getId(),s.getId(),StockAlertStatus.PENDING);Date now=new Date();String name=p.getSku();if(p.getDescriptions()!=null&&!p.getDescriptions().isEmpty()&&p.getDescriptions().iterator().next().getName()!=null)name=p.getDescriptions().iterator().next().getName();for(StockAlert a:as){a.setStatus(StockAlertStatus.SENT);a.setSentAt(now);alerts.save(a);StockAlertOutbox o=new StockAlertOutbox();o.setMerchantStore(s);o.setTo(a.getEmail());o.setSku(a.getSku());o.setSubject(name+" is back in stock");o.setCreatedAt(now);outbox.save(o);}}
+}
