+    @ResponseBody
+    public List<ReadableStockAlert> list(@RequestParam(required = false) String status,
+            @ApiIgnore MerchantStore merchantStore) {
+        StockAlertStatus parsed = parseStatus(status);
+        return service.listAlerts(merchantStore, parsed).stream().map(StockAlertMapper::map).collect(Collectors.toList());
+    }
+
+    @GetMapping("/private/stock-alerts/outbox")
+    @ResponseBody
+    public List<ReadableStockAlertOutbox> outbox(@ApiIgnore MerchantStore merchantStore) {
+        return service.listOutbox(merchantStore).stream().map(StockAlertMapper::map).collect(Collectors.toList());
+    }
+
+    private StockAlertStatus parseStatus(String value) {
+        if (value == null || value.trim().isEmpty()) return null;
+        try { return StockAlertStatus.valueOf(value); }
+        catch (IllegalArgumentException e) { throw new StockAlertBadRequestException("invalid status"); }
+    }
