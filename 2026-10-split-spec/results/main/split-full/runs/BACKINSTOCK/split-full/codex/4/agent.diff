+
+@Entity
+@Table(name = "STOCK_ALERT", indexes = {
+    @Index(name = "STOCK_ALERT_STORE_SKU_EMAIL", columnList = "MERCHANT_ID,SKU,EMAIL"),
+    @Index(name = "STOCK_ALERT_STORE_STATUS", columnList = "MERCHANT_ID,STATUS")
+})
+public class StockAlert extends SalesManagerEntity<Long, StockAlert> {
