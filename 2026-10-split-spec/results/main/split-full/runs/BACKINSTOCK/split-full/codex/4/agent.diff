+package com.salesmanager.core.business.services.catalog.product.alert;
+
+import java.util.*;
+import java.util.regex.Pattern;
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.alert.*;
+import com.salesmanager.core.business.repositories.catalog.product.availability.ProductAvailabilityRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.alert.*;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+    private static final Pattern EMAIL = Pattern.compile("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$");
+    @Inject private StockAlertRepository alerts;
+    @Inject private StockAlertOutboxRepository outbox;
+    @Inject private ProductAvailabilityRepository inventory;
+
+    @Override @Transactional
+    public StockAlert createAlert(String sku, String email, MerchantStore store) {
+        if (store == null || sku == null || sku.trim().isEmpty()) throw new IllegalArgumentException("sku and store are required");
+        if (email == null || !EMAIL.matcher(email.trim()).matches()) throw new IllegalArgumentException("invalid email");
+        List<ProductAvailability> matches = inventory.getBySku(sku, store.getCode());
+        ProductAvailability availability = matches.stream().filter(a -> a.getMerchantStore() == null || store.getCode().equals(a.getMerchantStore().getCode())).findFirst().orElse(null);
+        if (availability == null || availability.getProduct() == null) throw new NoSuchElementException("unknown sku");
+        if (availability.getProductQuantity() != null && availability.getProductQuantity() > 0) throw new IllegalStateException("product is in stock");
+        StockAlert existing = alerts.findByMerchantStoreIdAndSkuIgnoreCaseAndEmailIgnoreCaseAndStatus(store.getId(), sku, email.trim(), StockAlertStatus.PENDING);
+        if (existing != null) return existing;
+        StockAlert alert = new StockAlert(); alert.setSku(sku); alert.setEmail(email.trim()); alert.setMerchantStore(store); alert.setProduct(availability.getProduct()); alert.setStatus(StockAlertStatus.PENDING);
+        return alerts.save(alert);
+    }
+
+    @Override @Transactional
+    public StockAlert cancelAlert(String sku, String email, MerchantStore store) {
+        if (store == null || sku == null || email == null) throw new IllegalArgumentException("missing cancellation fields");
+        if (!EMAIL.matcher(email.trim()).matches()) throw new IllegalArgumentException("invalid email");
+        StockAlert alert = alerts.findByMerchantStoreIdAndSkuIgnoreCaseAndEmailIgnoreCaseAndStatus(store.getId(), sku, email.trim(), StockAlertStatus.PENDING);
+        if (alert == null) throw new NoSuchElementException("alert not found");
+        alerts.delete(alert); return alert;
+    }
+
+    public List<StockAlert> listAlerts(MerchantStore store, StockAlertStatus status) {
+        if (status == null) return alerts.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId());
+        return alerts.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(store.getId(), status);
+    }
+    public List<StockAlertOutbox> listOutbox(MerchantStore store) { return outbox.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId()); }
+
+    @Override @Transactional
+    public void onInventoryUpdated(ProductAvailability previous, ProductAvailability current) {
+        if (previous == null || current == null || previous.getProductQuantity() == null || current.getProductQuantity() == null || previous.getProductQuantity() != 0 || current.getProductQuantity() <= 0) return;
+        Product product = current.getProduct(); if (product == null || current.getMerchantStore() == null) return;
+        MerchantStore store = current.getMerchantStore();
+        List<StockAlert> pending = alerts.findByMerchantStoreIdAndSkuIgnoreCaseAndStatusOrderByCreatedAtAsc(store.getId(), product.getSku(), StockAlertStatus.PENDING);
+        String name = product.getProductDescription() == null ? product.getSku() : product.getProductDescription().getName();
+        for (StockAlert alert : pending) {
+            if (alert.getStatus() != StockAlertStatus.PENDING) continue;
+            StockAlertOutbox message = new StockAlertOutbox(); message.setTo(alert.getEmail()); message.setSku(alert.getSku()); message.setSubject(name + " is back in stock"); message.setMerchantStore(store); outbox.save(message);
+            alert.setStatus(StockAlertStatus.SENT); alert.setSentAt(new Date()); alerts.save(alert);
+        }
+    }
+    public void deleteForProduct(Product product) { if (product != null) alerts.deleteByProduct(product); }
+}
