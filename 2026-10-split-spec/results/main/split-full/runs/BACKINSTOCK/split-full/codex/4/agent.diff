+package com.salesmanager.shop.store.api.v1.stockalert;
+
+import java.util.List;
+import java.util.stream.Collectors;
+import javax.validation.Valid;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.ExceptionHandler;
+
+import com.salesmanager.core.business.services.catalog.product.alert.StockAlertService;
+import com.salesmanager.core.model.catalog.product.alert.StockAlertStatus;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.stockalert.PersistableStockAlert;
+import com.salesmanager.shop.model.stockalert.ReadableStockAlert;
+import com.salesmanager.shop.model.stockalert.ReadableStockAlertOutbox;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import io.swagger.annotations.Api;
+import springfox.documentation.annotations.ApiIgnore;
+
+@Controller
+@RequestMapping("/api/v1")
+@Api(tags = { "Stock alert resource" })
+public class StockAlertApi {
+    private final StockAlertService service;
+
+    public StockAlertApi(StockAlertService service) { this.service = service; }
+
+    @PostMapping("/products/{sku}/alerts")
+    @ResponseBody
+    public ResponseEntity<ReadableStockAlert> create(@PathVariable String sku, @Valid @RequestBody PersistableStockAlert request,
+            @ApiIgnore MerchantStore merchantStore) {
+        try {
+            boolean duplicate = service.listAlerts(merchantStore, StockAlertStatus.PENDING).stream().anyMatch(a ->
+                sku.equalsIgnoreCase(a.getSku()) && request.getEmail().trim().equalsIgnoreCase(a.getEmail()));
+            ReadableStockAlert result = StockAlertMapper.map(service.createAlert(sku, request.getEmail(), merchantStore));
+            return ResponseEntity.status(duplicate ? HttpStatus.OK : HttpStatus.CREATED).body(result);
+        } catch (IllegalStateException e) {
+            throw new StockAlertConflictException(e.getMessage());
+        } catch (java.util.NoSuchElementException e) {
+            throw new StockAlertNotFoundException(e.getMessage());
+        } catch (IllegalArgumentException e) {
+            throw new StockAlertBadRequestException(e.getMessage());
+        }
+    }
+
+    @DeleteMapping("/products/{sku}/alerts")
+    @ResponseStatus(HttpStatus.NO_CONTENT)
