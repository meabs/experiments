@@ -0,0 +1,35 @@
+package com.salesmanager.shop.store.facade.product;
+
+import java.time.Instant;
+import java.util.Date;
+import java.util.List;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.alert.StockAlertService;
+import com.salesmanager.core.model.catalog.product.alert.StockAlertStatus;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.StockAlert;
+import com.salesmanager.shop.model.catalog.product.StockAlertOutbox;
+
+@Service("stockAlertFacade")
+public class StockAlertFacadeImpl implements StockAlertFacade {
+    @Inject private StockAlertService service;
+    @Override public StockAlert createAlert(String sku, String email, MerchantStore store) {
+        try { return map(service.createAlert(sku, email, store)); } catch (ServiceException e) { throw new IllegalStateException(e.getMessage(), e); }
+    }
+    @Override public void cancelAlert(String sku, String email, MerchantStore store) {
+        try { service.cancelAlert(sku, email, store); } catch (ServiceException e) { throw new IllegalStateException(e.getMessage(), e); }
+    }
+    @Override public List<StockAlert> listAlerts(MerchantStore store, String status) {
+        StockAlertStatus s = status == null ? null : StockAlertStatus.valueOf(status);
+        return service.listAlerts(store, s).stream().map(this::map).collect(Collectors.toList());
+    }
+    @Override public List<StockAlertOutbox> listOutbox(MerchantStore store) { return service.listOutbox(store).stream().map(this::map).collect(Collectors.toList()); }
+    private StockAlert map(com.salesmanager.core.model.catalog.product.alert.StockAlert s) {
+        StockAlert t = new StockAlert(); t.setId(s.getId()); t.setSku(s.getSku()); t.setEmail(s.getEmail()); t.setStatus(s.getStatus().name()); t.setCreatedAt(iso(s.getCreatedAt())); t.setSentAt(iso(s.getSentAt())); t.setNewlyCreated(s.isNewlyCreated()); return t;
+    }
+    private StockAlertOutbox map(com.salesmanager.core.model.catalog.product.alert.StockAlertOutbox s) { StockAlertOutbox t = new StockAlertOutbox(); t.setTo(s.getTo()); t.setSku(s.getSku()); t.setSubject(s.getSubject()); t.setCreatedAt(iso(s.getCreatedAt())); return t; }
+    private String iso(Date d) { return d == null ? null : Instant.ofEpochMilli(d.getTime()).toString(); }
+}
