+package com.salesmanager.core.business.services.catalog.product.alert;
+
+import java.util.*;
+import java.util.regex.Pattern;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.alert.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.availability.ProductAvailabilityService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.alert.*;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+    private static final Pattern EMAIL = Pattern.compile("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$");
+    @Inject private StockAlertRepository alertRepository;
+    @Inject private StockAlertOutboxRepository outboxRepository;
+    @Inject private ProductService productService;
+    @Inject private ProductAvailabilityService availabilityService;
+
+    @Override @Transactional
+    public StockAlert createAlert(String sku, String email, MerchantStore store) throws ServiceException {
+        if (email == null || !EMAIL.matcher(email.trim()).matches()) throw new IllegalArgumentException("Invalid email");
+        Product product = product(sku, store);
+        if (inStock(sku, store)) throw new IllegalStateException("Product is in stock");
+        Optional<StockAlert> existing = alertRepository.findByProductIdAndEmailIgnoreCaseAndStatus(product.getId(), email.trim(), StockAlertStatus.PENDING);
+        if (existing.isPresent()) { existing.get().setNewlyCreated(false); return existing.get(); }
+        StockAlert alert = new StockAlert();
+        alert.setProduct(product); alert.setMerchantStore(store); alert.setSku(sku); alert.setEmail(email.trim());
+        return alertRepository.save(alert);
+    }
+
+    @Override @Transactional
+    public void cancelAlert(String sku, String email, MerchantStore store) throws ServiceException {
+        Product product = product(sku, store);
+        StockAlert alert = alertRepository.findByProductIdAndEmailIgnoreCaseAndStatus(product.getId(), email, StockAlertStatus.PENDING)
+            .orElseThrow(() -> new NoSuchElementException("Alert not found"));
+        alertRepository.delete(alert);
+    }
+
+    @Override @Transactional(readOnly = true)
+    public List<StockAlert> listAlerts(MerchantStore store, StockAlertStatus status) {
+        return status == null ? alertRepository.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId().longValue())
+            : alertRepository.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(store.getId().longValue(), status);
+    }
+    @Override @Transactional(readOnly = true)
+    public List<StockAlertOutbox> listOutbox(MerchantStore store) {
+        return outboxRepository.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId().longValue());
+    }
+    @Override @Transactional
+    public void onStockChanged(String sku, MerchantStore store, int oldQuantity, int newQuantity) throws ServiceException {
+        if (oldQuantity > 0 || newQuantity <= 0) return;
+        Product product = product(sku, store);
+        for (StockAlert alert : alertRepository.findByProductIdAndStatusOrderByCreatedAtAsc(product.getId(), StockAlertStatus.PENDING)) {
+            alert.setStatus(StockAlertStatus.SENT); alert.setSentAt(new Date()); alertRepository.save(alert);
+            StockAlertOutbox message = new StockAlertOutbox(); message.setMerchantStore(store); message.setTo(alert.getEmail());
+            message.setSku(alert.getSku()); message.setSubject(productName(product) + " is back in stock"); outboxRepository.save(message);
+        }
+    }
+    private Product product(String sku, MerchantStore store) throws ServiceException {
+        Product p = productService.getBySku(sku, store);
+        if (p == null) throw new NoSuchElementException("Unknown sku");
+        return p;
+    }
+    private boolean inStock(String sku, MerchantStore store) {
+        for (ProductAvailability a : availabilityService.getBySku(sku, store)) if (a.getProductQuantity() != null && a.getProductQuantity() > 0) return true;
+        return false;
+    }
+    private String productName(Product p) { return p.getProductDescription() != null && p.getProductDescription().getName() != null ? p.getProductDescription().getName() : p.getSku(); }
+}
