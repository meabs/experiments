+package com.salesmanager.shop.store.api.v1.stockalert;
+
+import java.util.List;
+import java.util.Locale;
+import java.util.NoSuchElementException;
+
+import javax.validation.Valid;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.ExceptionHandler;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.StockAlert;
+import com.salesmanager.shop.model.catalog.product.StockAlertOutbox;
+import com.salesmanager.shop.model.catalog.product.StockAlertRequest;
+import com.salesmanager.shop.store.facade.product.StockAlertFacade;
+
+import io.swagger.annotations.Api;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Shopper stock-alert subscription and protected administrator views. */
+@Controller
+@RequestMapping("/api/v1")
+@Api(tags = { "Stock alerts" })
+public class StockAlertApi {
+
+    private final StockAlertFacade stockAlertFacade;
+
+    public StockAlertApi(StockAlertFacade stockAlertFacade) {
+        this.stockAlertFacade = stockAlertFacade;
+    }
+
+    @PostMapping("/products/{sku}/alerts")
+    public ResponseEntity<StockAlert> create(@PathVariable String sku,
+            @Valid @RequestBody StockAlertRequest request, @ApiIgnore MerchantStore merchantStore) {
+        if (request == null || request.getEmail() == null || !request.getEmail().matches("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"))
+            throw new BadRequestException("Invalid email");
+        StockAlert alert = stockAlertFacade.createAlert(sku, request.getEmail(), merchantStore);
+        // The facade may return an existing pending subscription. Callers need the
+        // idempotent status (200) in that case, while a newly-created one is 201.
+        return ResponseEntity.status(alert.isNewlyCreated() ? HttpStatus.CREATED : HttpStatus.OK).body(alert);
+    }
+
+    @DeleteMapping("/products/{sku}/alerts")
+    @ResponseStatus(HttpStatus.NO_CONTENT)
+    public void cancel(@PathVariable String sku, @RequestParam String email,
+            @ApiIgnore MerchantStore merchantStore) {
+        if (email == null || !email.matches("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"))
+            throw new BadRequestException("Invalid email");
+        stockAlertFacade.cancelAlert(sku, email, merchantStore);
+    }
+
+    @GetMapping("/private/stock-alerts")
+    @ResponseBody
+    public List<StockAlert> list(@RequestParam(required = false) String status,
+            @ApiIgnore MerchantStore merchantStore) {
+        if (status != null) {
+            if (!"PENDING".equalsIgnoreCase(status) && !"SENT".equalsIgnoreCase(status))
+                throw new BadRequestException("status must be PENDING or SENT");
+        }
+        return stockAlertFacade.listAlerts(merchantStore, status == null ? null : status.toUpperCase(Locale.ROOT));
+    }
+
+    @GetMapping("/private/stock-alerts/outbox")
+    @ResponseBody
+    public List<StockAlertOutbox> outbox(@ApiIgnore MerchantStore merchantStore) {
+        return stockAlertFacade.listOutbox(merchantStore);
+    }
+
+    @ExceptionHandler(BadRequestException.class)
+    @ResponseStatus(HttpStatus.BAD_REQUEST)
+    public void badRequest() { }
+
+    @ExceptionHandler(IllegalArgumentException.class)
