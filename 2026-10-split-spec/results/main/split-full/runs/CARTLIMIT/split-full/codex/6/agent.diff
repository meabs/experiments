+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import springfox.documentation.annotations.ApiIgnore;
+
+import javax.inject.Inject;
+
+/** Protected administration API for store-wide cart caps. */
+@RestController
+@RequestMapping("/api/v1")
+public class CartRulesApi {
+    @Inject private MerchantStoreService merchantStoreService;
+    @Inject private AuthorizationUtils authorizationUtils;
+
+    @GetMapping("/private/cart-rules")
+    @ResponseStatus(HttpStatus.OK)
+    public CartRules get(@ApiIgnore MerchantStore store) {
+        authorize(store);
+        return from(store);
+    }
+
+    @PutMapping("/private/cart-rules")
+    @ResponseStatus(HttpStatus.OK)
+    public CartRules update(@RequestBody CartRules rules, @ApiIgnore MerchantStore store) throws Exception {
+        authorize(store);
+        validate(rules);
+        merchantStoreService.updateCartRules(store, rules.getMaxLines(), rules.getMaxUnits());
+        return from(store);
+    }
+
+    private CartRules from(MerchantStore store) {
+        CartRules result = new CartRules();
+        result.setMaxLines(store.getMaxLines());
+        result.setMaxUnits(store.getMaxUnits());
+        return result;
+    }
+    private void validate(CartRules rules) {
+        if (rules == null || positive(rules.getMaxLines()) || positive(rules.getMaxUnits()))
+            throw new RestApiException("400", "Invalid cart rules");
+    }
+    private boolean positive(Integer value) { return value != null && value < 1; }
+    private void authorize(MerchantStore store) {
+        authorizationUtils.authorizeUser(authorizationUtils.authenticatedUser(),
+                java.util.Arrays.asList(Constants.GROUP_SUPERADMIN, Constants.GROUP_ADMIN,
+                        Constants.GROUP_ADMIN_RETAIL), store);
+    }
+}
