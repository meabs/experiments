@@ -0,0 +1,71 @@
+package com.salesmanager.shop.store.api.v1.product;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductLimits;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.utils.AuthorizationUtils;
+import com.salesmanager.shop.constants.Constants;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import springfox.documentation.annotations.ApiIgnore;
+
+import javax.inject.Inject;
+
+/** Protected administration API for per-product purchase limits. */
+@RestController
+@RequestMapping("/api/v1")
+public class ProductLimitsApi {
+    @Inject private ProductService productService;
+    @Inject private AuthorizationUtils authorizationUtils;
+
+    @GetMapping("/private/product/{id}/limits")
+    @ResponseStatus(HttpStatus.OK)
+    public ProductLimits get(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        authorize(store);
+        Product product = productService.findOne(id, store);
+        if (product == null) throw new ResourceNotFoundException("Product not found");
+        return from(product);
+    }
+
+    @PutMapping("/private/product/{id}/limits")
+    @ResponseStatus(HttpStatus.OK)
+    public ProductLimits update(@PathVariable Long id, @RequestBody ProductLimits limits,
+                                @ApiIgnore MerchantStore store) throws Exception {
+        authorize(store);
+        validate(limits);
+        Product product = productService.findOne(id, store);
+        if (product == null) throw new ResourceNotFoundException("Product not found");
+        productService.updateCartLimits(product, limits.getMinPerCart(), limits.getMaxPerCart(), limits.getPackSize());
+        return from(product);
+    }
+
+    private ProductLimits from(Product product) {
+        ProductLimits result = new ProductLimits();
+        result.setMinPerCart(product.getMinPerCart());
+        result.setMaxPerCart(product.getMaxPerCart());
+        result.setPackSize(product.getPackSize());
+        return result;
+    }
+
+    private void validate(ProductLimits limits) {
+        if (limits == null || positive(limits.getMinPerCart()) || positive(limits.getMaxPerCart())
+                || positive(limits.getPackSize())
+                || limits.getMinPerCart() != null && limits.getMaxPerCart() != null
+                    && limits.getMinPerCart() > limits.getMaxPerCart()
+                || limits.getMaxPerCart() != null && limits.getPackSize() != null
+                    && limits.getMaxPerCart() < limits.getPackSize()) {
+            throw new RestApiException("400", "Invalid product limits");
+        }
+    }
+
+    private boolean positive(Integer value) { return value != null && value < 1; }
+
+    private void authorize(MerchantStore store) {
+        authorizationUtils.authorizeUser(authorizationUtils.authenticatedUser(),
+                java.util.Arrays.asList(Constants.GROUP_SUPERADMIN, Constants.GROUP_ADMIN,
+                        Constants.GROUP_ADMIN_RETAIL), store);
+    }
+}
