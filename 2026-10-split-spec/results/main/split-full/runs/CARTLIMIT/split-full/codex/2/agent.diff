@@ -0,0 +1,38 @@
+package com.salesmanager.shop.store.controller.shoppingCart.facade;
+
+import java.lang.reflect.Method;
+import java.util.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.LimitWarning;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+
+/** Central, side-effect free cart-limit checks. Reflection keeps this module compatible
+ * with stores/products built before the optional limit fields were introduced. */
+final class CartLimitValidator {
+ private CartLimitValidator() {}
+ private static Integer number(Object o,String getter) {
+  if(o==null) return null; try { Method m=o.getClass().getMethod(getter); Object v=m.invoke(o); return v==null?null:((Number)v).intValue(); } catch(Exception e) { return null; }
+ }
+ private static void bad(String code,String msg) { throw new ServiceRuntimeException(code,msg,new IllegalArgumentException(msg)); }
+ static void validate(ShoppingCart cart, MerchantStore store, Set<ShoppingCartItem> proposed, Set<String> changed, boolean additions) {
+  int lines=0, units=0; for(ShoppingCartItem i: proposed) {
+   if(i.getQuantity()!=null && i.getQuantity()>0) { lines++; units += i.getQuantity(); }
+   if(changed.contains(i.getSku()) && i.getQuantity()!=null && i.getQuantity()>0) {
+    Integer min=number(i.getProduct(),"getMinPerCart"), max=number(i.getProduct(),"getMaxPerCart"), pack=number(i.getProduct(),"getPackSize");
+    int q=i.getQuantity(); if(min!=null&&q<min) bad("MIN_PER_CART","Minimum quantity for "+i.getSku()+" is "+min);
+    if(max!=null&&q>max) bad("MAX_PER_CART","Maximum quantity for "+i.getSku()+" is "+max);
+    if(pack!=null&&q%pack!=0) bad("PACK_SIZE","Quantity for "+i.getSku()+" must be a multiple of "+pack);
+   }
+  }
+  Integer ml=number(store,"getMaxLines"), mu=number(store,"getMaxUnits");
+  if(additions && ml!=null && lines>ml) bad("MAX_LINES","Cart cannot contain more than "+ml+" products");
+  if(additions && mu!=null && units>mu) bad("MAX_UNITS","Cart cannot contain more than "+mu+" units");
+ }
+ static List<LimitWarning> warnings(ShoppingCart cart, MerchantStore store) {
+  List<LimitWarning> out=new ArrayList<>(); Set<ShoppingCartItem> items=cart.getLineItems(); if(items==null) return out;
+  int lines=0, units=0; for(ShoppingCartItem i:items) if(i.getQuantity()!=null&&i.getQuantity()>0) { lines++; units+=i.getQuantity(); Integer min=number(i.getProduct(),"getMinPerCart"), max=number(i.getProduct(),"getMaxPerCart"), pack=number(i.getProduct(),"getPackSize"); int q=i.getQuantity(); if(min!=null&&q<min) out.add(new LimitWarning(i.getSku(),"MIN_PER_CART")); if(max!=null&&q>max) out.add(new LimitWarning(i.getSku(),"MAX_PER_CART")); if(pack!=null&&q%pack!=0) out.add(new LimitWarning(i.getSku(),"PACK_SIZE")); }
+  Integer ml=number(store,"getMaxLines"),mu=number(store,"getMaxUnits"); if(ml!=null&&lines>ml) out.add(new LimitWarning(null,"MAX_LINES")); if(mu!=null&&units>mu) out.add(new LimitWarning(null,"MAX_UNITS")); return out;
+ }
+}
