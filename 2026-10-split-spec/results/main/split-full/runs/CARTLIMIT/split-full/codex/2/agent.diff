+package com.salesmanager.shop.store.api.v1.store;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.shoppingcart.CartRules;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Private administration endpoints for store-wide cart caps. */
+@RestController
+@RequestMapping("/api/v1/private")
+public class CartRulesApi {
+
+    @Inject
+    private MerchantStoreService merchantStoreService;
+
+    @GetMapping("/cart-rules")
+    public CartRules get(@ApiIgnore MerchantStore merchantStore) {
+        return read(merchantStore);
+    }
+
+    @PutMapping("/cart-rules")
+    @ResponseStatus(HttpStatus.OK)
+    public CartRules put(@RequestBody CartRules requested, @ApiIgnore MerchantStore merchantStore)
+            throws Exception {
+        validate(requested);
+        return read(merchantStoreService.updateCartRules(merchantStore, requested.getMaxLines(),
+                requested.getMaxUnits()));
+    }
+
+    private static CartRules read(MerchantStore store) {
+        CartRules result = new CartRules();
+        result.setMaxLines(store.getMaxLines());
+        result.setMaxUnits(store.getMaxUnits());
+        return result;
+    }
+
+    private static void validate(CartRules rules) {
+        if (rules == null || invalid(rules.getMaxLines()) || invalid(rules.getMaxUnits())) {
+            throw new RestApiException("400", "Invalid cart rules");
+        }
+    }
+
+    private static boolean invalid(Integer value) {
+        return value != null && value < 1;
+    }
+}
