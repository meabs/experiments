+package com.salesmanager.shop.store.api.v1.product;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.shoppingcart.ProductLimits;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Private administration endpoints for per-product cart quantity rules. */
+@RestController
+@RequestMapping("/api/v1/private/product")
+public class ProductLimitsApi {
+
+    @Inject
+    private ProductService productService;
+
+    @GetMapping("/{id}/limits")
+    public ProductLimits get(@PathVariable Long id, @ApiIgnore MerchantStore merchantStore) {
+        Product product = productService.findOne(id, merchantStore);
+        if (product == null || product.getMerchantStore() == null
+                || !merchantStore.getId().equals(product.getMerchantStore().getId())) {
+            throw new ResourceNotFoundException("Product [" + id + "] not found");
+        }
+        return read(product);
+    }
+
+    @PutMapping("/{id}/limits")
+    @ResponseStatus(HttpStatus.OK)
+    public ProductLimits put(@PathVariable Long id, @RequestBody ProductLimits requested,
+            @ApiIgnore MerchantStore merchantStore) throws Exception {
+        Product product = productService.findOne(id, merchantStore);
+        if (product == null || product.getMerchantStore() == null
+                || !merchantStore.getId().equals(product.getMerchantStore().getId())) {
+            throw new ResourceNotFoundException("Product [" + id + "] not found");
+        }
+        validate(requested);
+        Product updated = productService.updateLimits(id, merchantStore, requested.getMinPerCart(),
+                requested.getMaxPerCart(), requested.getPackSize());
+        return read(updated);
+    }
+
+    private static ProductLimits read(Product product) {
+        ProductLimits result = new ProductLimits();
+        result.setMinPerCart(product.getMinPerCart());
+        result.setMaxPerCart(product.getMaxPerCart());
+        result.setPackSize(product.getPackSize());
+        return result;
+    }
+
+    private static void validate(ProductLimits limits) {
+        if (limits == null || invalid(limits.getMinPerCart()) || invalid(limits.getMaxPerCart())
+                || invalid(limits.getPackSize())
+                || (limits.getMinPerCart() != null && limits.getMaxPerCart() != null
+                    && limits.getMinPerCart() > limits.getMaxPerCart())
+                || (limits.getMaxPerCart() != null && limits.getPackSize() != null
+                    && limits.getMaxPerCart() < limits.getPackSize())) {
+            throw new RestApiException("400", "Invalid product limits");
+        }
+    }
+
+    private static boolean invalid(Integer value) {
+        return value != null && value < 1;
+    }
+}
