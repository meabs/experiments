+    public Integer getMaxPerCart() {
+        return maxPerCart;
+    }
+
+    public void setMaxPerCart(Integer maxPerCart) {
+        this.maxPerCart = maxPerCart;
+    }
+
+    public Integer getPackSize() {
+        return packSize;
+    }
+
+    public void setPackSize(Integer packSize) {
+        this.packSize = packSize;
+    }
+
+    @JsonIgnore
+    @AssertTrue(message = "minPerCart may not be greater than maxPerCart")
+    public boolean isOrdered() {
+        return minPerCart == null || maxPerCart == null || minPerCart <= maxPerCart;
+    }
+
+    @JsonIgnore
