+package com.salesmanager.core.business.services.system;
+
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+/** Shared, HTTP-independent purchase-rule checks for cart implementations. */
+public final class PurchaseLimitValidator {
+    public static final String MIN_PER_CART = "MIN_PER_CART";
+    public static final String MAX_PER_CART = "MAX_PER_CART";
+    public static final String PACK_SIZE = "PACK_SIZE";
+    public static final String MAX_LINES = "MAX_LINES";
+    public static final String MAX_UNITS = "MAX_UNITS";
+    private PurchaseLimitValidator() { }
+
+    /** Returns the violated rule, or null when quantity is valid. Quantity zero removes a line. */
+    public static String validateQuantity(Product product, int quantity) {
+        if (quantity == 0) return null;
+        if (quantity < 0) return MIN_PER_CART;
+        if (product.getMinPerCart() != null && quantity < product.getMinPerCart()) return MIN_PER_CART;
+        if (product.getMaxPerCart() != null && quantity > product.getMaxPerCart()) return MAX_PER_CART;
+        if (product.getPackSize() != null && quantity % product.getPackSize() != 0) return PACK_SIZE;
+        return null;
+    }
+
+    /** Checks caps after a proposed cart change. Pass the proposed final line/unit totals. */
+    public static String validateCart(MerchantStore store, int lineCount, int unitCount,
+                                      boolean addsLine, boolean addsUnits) {
+        if (addsLine && store.getMaxLines() != null && lineCount > store.getMaxLines()) return MAX_LINES;
+        if (addsUnits && store.getMaxUnits() != null && unitCount > store.getMaxUnits()) return MAX_UNITS;
+        return null;
+    }
+}
