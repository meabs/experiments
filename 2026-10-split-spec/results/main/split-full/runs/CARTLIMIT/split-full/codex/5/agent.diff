+/** The per-cart quantity constraints configured for one product. */
+public class ProductLimits {
+
+    @Min(1)
+    private Integer minPerCart;
+
+    @Min(1)
+    private Integer maxPerCart;
+
+    @Min(1)
+    private Integer packSize;
+
+    public ProductLimits() {
+    }
+
+    public ProductLimits(Integer minPerCart, Integer maxPerCart, Integer packSize) {
+        this.minPerCart = minPerCart;
+        this.maxPerCart = maxPerCart;
+        this.packSize = packSize;
+    }
+
