+package com.salesmanager.core.business.services.cartlimit;
+
+import java.util.Optional;
+
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.repositories.merchant.MerchantRepository;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("cartRuleService")
+public class CartRuleServiceImpl implements CartRuleService {
+    private final MerchantRepository merchantRepository;
+
+    @Inject
+    public CartRuleServiceImpl(MerchantRepository merchantRepository) {
+        this.merchantRepository = merchantRepository;
+    }
+
+    @Override
+    public Optional<MerchantStore> getCartRules(Integer storeId) {
+        return storeId == null ? Optional.empty() : merchantRepository.findById(storeId);
+    }
+
+    @Override
+    public MerchantStore getCartRules(MerchantStore store) {
+        return store == null || store.getId() == null ? null
+                : getCartRules(store.getId()).orElse(null);
+    }
+
+    @Override
+    @Transactional
+    public MerchantStore setCartRules(Integer storeId, Integer maxLines, Integer maxUnits) {
+        CartLimitValidation.validateCartRules(maxLines, maxUnits);
+        MerchantStore store = getCartRules(storeId)
+                .orElseThrow(() -> new IllegalArgumentException("store not found"));
+        store.setMaxLines(maxLines);
+        store.setMaxUnits(maxUnits);
+        return merchantRepository.save(store);
+    }
+
+    @Override
+    @Transactional
+    public MerchantStore setCartRules(MerchantStore store, Integer maxLines, Integer maxUnits) {
+        if (store == null || store.getId() == null) throw new IllegalArgumentException("store is required");
+        return setCartRules(store.getId(), maxLines, maxUnits);
+    }
+}
