@@ -0,0 +1,29 @@
+package com.salesmanager.core.business.services.cartlimit;
+
+/** Validation shared by administrative updates and cart enforcement. */
+public final class CartLimitValidation {
+    private CartLimitValidation() { }
+
+    public static void validatePositive(String name, Integer value) {
+        if (value != null && value < 1) {
+            throw new IllegalArgumentException(name + " must be at least 1");
+        }
+    }
+
+    public static void validateProductLimits(Integer minPerCart, Integer maxPerCart, Integer packSize) {
+        validatePositive("minPerCart", minPerCart);
+        validatePositive("maxPerCart", maxPerCart);
+        validatePositive("packSize", packSize);
+        if (minPerCart != null && maxPerCart != null && minPerCart > maxPerCart) {
+            throw new IllegalArgumentException("minPerCart may not be greater than maxPerCart");
+        }
+        if (maxPerCart != null && packSize != null && maxPerCart < packSize) {
+            throw new IllegalArgumentException("maxPerCart may not be less than packSize");
+        }
+    }
+
+    public static void validateCartRules(Integer maxLines, Integer maxUnits) {
+        validatePositive("maxLines", maxLines);
+        validatePositive("maxUnits", maxUnits);
+    }
+}
