+package com.salesmanager.core.business.services.cartlimit;
+
+import java.util.Optional;
+
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.repositories.catalog.product.ProductRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productLimitService")
+public class ProductLimitServiceImpl implements ProductLimitService {
+    private final ProductRepository productRepository;
+
+    @Inject
+    public ProductLimitServiceImpl(ProductRepository productRepository) {
+        this.productRepository = productRepository;
+    }
+
+    @Override
+    public Optional<Product> getProductLimits(Long productId, MerchantStore store) {
+        if (store == null || store.getId() == null) return Optional.empty();
+        return getProductLimits(productId, store.getId());
+    }
+
+    @Override
+    public Optional<Product> getProductLimits(Long productId, Integer storeId) {
+        return productRepository.findById(productId)
+                .filter(p -> p.getMerchantStore() != null && storeId != null
+                        && storeId.equals(p.getMerchantStore().getId()));
+    }
+
+    @Override
+    @Transactional
+    public Product setProductLimits(Long productId, MerchantStore store, Integer minPerCart,
+            Integer maxPerCart, Integer packSize) {
+        if (store == null || store.getId() == null) throw new IllegalArgumentException("store is required");
+        return setProductLimits(productId, store.getId(), minPerCart, maxPerCart, packSize);
+    }
+
+    @Override
+    @Transactional
+    public Product setProductLimits(Long productId, Integer storeId, Integer minPerCart,
+            Integer maxPerCart, Integer packSize) {
+        CartLimitValidation.validateProductLimits(minPerCart, maxPerCart, packSize);
+        Product product = getProductLimits(productId, storeId)
+                .orElseThrow(() -> new IllegalArgumentException("product not found"));
+        product.setMinPerCart(minPerCart);
+        product.setMaxPerCart(maxPerCart);
+        product.setPackSize(packSize);
+        return productRepository.save(product);
+    }
+}
