+package com.salesmanager.shop.store.api.v1.cart;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.cartlimit.CartRuleService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.cart.CartRules;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Protected administration endpoint for store cart caps. */
+@RestController
+@RequestMapping("/api/v1/private/cart-rules")
+public class CartRulesApi {
+    @Inject private CartRuleService cartRuleService;
+
+    @GetMapping
+    public @ResponseBody CartRules get(@ApiIgnore MerchantStore store) {
+        return rules(cartRuleService.getCartRules(store));
+    }
+
+    @PutMapping
+    @ResponseStatus(HttpStatus.OK)
+    public @ResponseBody CartRules set(@RequestBody CartRules request, @ApiIgnore MerchantStore store) {
+        validate(request);
+        try {
+            return rules(cartRuleService.setCartRules(store, request.getMaxLines(), request.getMaxUnits()));
+        } catch (Exception e) {
+            throw new RestApiException("Unable to save cart rules", e);
+        }
+    }
+
+    private CartRules rules(MerchantStore store) {
+        return new CartRules(store.getMaxLines(), store.getMaxUnits());
+    }
+    private void validate(CartRules rules) {
+        if (rules == null || invalid(rules.getMaxLines()) || invalid(rules.getMaxUnits())) {
+            throw new RestApiException("INVALID_CART_RULE", "Cart caps must be whole numbers of at least 1");
+        }
+    }
+    private boolean invalid(Integer n) { return n != null && n < 1; }
+}
