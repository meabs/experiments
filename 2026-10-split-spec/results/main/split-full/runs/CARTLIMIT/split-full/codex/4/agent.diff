+
+/** Protected administration endpoint for per-product cart limits. */
+@RestController
+@RequestMapping("/api/v1/private/product/{id}/limits")
+public class ProductLimitsApi {
+    @Inject private ProductLimitService productLimitService;
+
+    @GetMapping
+    public @ResponseBody PurchaseLimits get(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        return limits(productLimitService.getProductLimits(id, store));
+    }
+
+    @PutMapping
+    @ResponseStatus(HttpStatus.OK)
+    public @ResponseBody PurchaseLimits set(@PathVariable Long id, @RequestBody PurchaseLimits request,
+            @ApiIgnore MerchantStore store) {
+        validate(request);
+        try {
+            return limits(productLimitService.setProductLimits(id, store, request.getMinPerCart(),
+                    request.getMaxPerCart(), request.getPackSize()));
+        } catch (Exception e) {
+            if (e instanceof IllegalArgumentException && "product not found".equals(e.getMessage())) {
+                throw new ResourceNotFoundException("Product not found");
+            }
+            throw new RestApiException("Unable to save product limits", e);
+        }
+    }
+
