+    }
+
+    private static void validateProductLimits(ProductLimits limits) {
+        if (limits == null) {
+            throw new RestApiException("400", "Product limits are required");
+        }
+        validatePositive(limits.getMinPerCart(), "minPerCart");
+        validatePositive(limits.getMaxPerCart(), "maxPerCart");
+        validatePositive(limits.getPackSize(), "packSize");
+        if (limits.getMinPerCart() != null && limits.getMaxPerCart() != null
+                && limits.getMinPerCart() > limits.getMaxPerCart()) {
+            throw new RestApiException("400", "minPerCart may not exceed maxPerCart");
+        }
+        if (limits.getMaxPerCart() != null && limits.getPackSize() != null
+                && limits.getMaxPerCart() < limits.getPackSize()) {
+            throw new RestApiException("400", "maxPerCart may not be less than packSize");
+        }
+    }
+
+    private static void validatePositive(Integer value, String name) {
+        if (value != null && value < 1) {
+            throw new RestApiException("400", name + " must be at least 1");
+        }
+    }
+
+    private static ProductLimits productLimits(ProductCartLimits product) {
+        ProductLimits result = new ProductLimits();
+        result.setMinPerCart(product.getMinPerCart());
+        result.setMaxPerCart(product.getMaxPerCart());
+        result.setPackSize(product.getPackSize());
+        return result;
+    }
+
+    private static CartRules cartRules(CartCaps store) {
+        CartRules result = new CartRules();
+        result.setMaxLines(store.getMaxLines());
+        result.setMaxUnits(store.getMaxUnits());
+        return result;
+    }
+
+    private static RuntimeException translate(ServiceException exception) {
+        if ("Not found".equalsIgnoreCase(exception.getMessage())) {
+            return new ResourceNotFoundException("Resource not found");
+        }
+        return new RestApiException("400", exception.getMessage());
+    }
+}
