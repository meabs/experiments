+
+    @PutMapping("/product/{id}/limits")
+    public ProductLimits updateProductLimits(@PathVariable Long id,
+            @RequestBody ProductLimits limits, @ApiIgnore MerchantStore merchantStore) throws Exception {
+        authorize();
+        if (limits == null) {
+            throw new RestApiException("400", "Product limits are required");
+        }
+        try {
+            ProductCartLimits value = purchaseLimitService.updateProductLimits(id, merchantStore,
