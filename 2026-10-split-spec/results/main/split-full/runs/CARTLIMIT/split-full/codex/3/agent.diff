+/** Administrative API for product quantity limits and store cart caps. */
+@RestController
+@RequestMapping(value = "/api/v1/private", produces = MediaType.APPLICATION_JSON_VALUE)
+public class PurchaseLimitsApi {
+
+    @Inject
