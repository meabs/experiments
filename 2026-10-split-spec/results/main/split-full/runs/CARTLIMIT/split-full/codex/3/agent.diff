+package com.salesmanager.core.business.services.cart;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+/** Reads and updates purchase limits while enforcing merchant scoping. */
+public interface PurchaseLimitService {
+    ProductCartLimits getProductLimits(Long productId, MerchantStore store) throws ServiceException;
+    ProductCartLimits updateProductLimits(Long productId, MerchantStore store, ProductCartLimits limits) throws ServiceException;
+    CartCaps getCartCaps(MerchantStore store) throws ServiceException;
+    CartCaps updateCartCaps(MerchantStore store, CartCaps caps) throws ServiceException;
