+        } catch (ServiceException e) {
+            throw translate(e);
+        }
+    }
+
+    @PutMapping("/cart-rules")
+    public CartRules updateCartRules(@RequestBody CartRules rules,
+            @ApiIgnore MerchantStore merchantStore) throws Exception {
+        authorize();
+        if (rules == null) {
+            throw new RestApiException("400", "Cart rules are required");
+        }
+        try {
+            CartCaps value = purchaseLimitService.updateCartCaps(merchantStore,
+                    new CartCaps(rules.getMaxLines(), rules.getMaxUnits()));
