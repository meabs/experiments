@@ -0,0 +1,89 @@
+package com.salesmanager.core.business.services.cart;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("purchaseLimitService")
+public class PurchaseLimitServiceImpl implements PurchaseLimitService {
+    private final ProductService productService;
+    private final MerchantStoreService merchantStoreService;
+
+    @Inject
+    public PurchaseLimitServiceImpl(ProductService productService, MerchantStoreService merchantStoreService) {
+        this.productService = productService;
+        this.merchantStoreService = merchantStoreService;
+    }
+
+    @Override
+    public ProductCartLimits getProductLimits(Long productId, MerchantStore store) throws ServiceException {
+        Product product = product(productId, store);
+        return new ProductCartLimits(product.getMinPerCart(), product.getMaxPerCart(), product.getPackSize());
+    }
+
+    @Override
+    public ProductCartLimits updateProductLimits(Long productId, MerchantStore store, ProductCartLimits limits) throws ServiceException {
+        if (limits == null) throw invalid("Product limits are required");
+        validateProduct(limits);
+        Product product = product(productId, store);
+        product.setMinPerCart(limits.getMinPerCart());
+        product.setMaxPerCart(limits.getMaxPerCart());
+        product.setPackSize(limits.getPackSize());
+        productService.update(product);
+        return new ProductCartLimits(product.getMinPerCart(), product.getMaxPerCart(), product.getPackSize());
+    }
+
+    @Override
+    public CartCaps getCartCaps(MerchantStore store) throws ServiceException {
+        MerchantStore managed = store(store);
+        return new CartCaps(managed.getMaxLines(), managed.getMaxUnits());
+    }
+
+    @Override
+    public CartCaps updateCartCaps(MerchantStore store, CartCaps caps) throws ServiceException {
+        if (caps == null) throw invalid("Cart caps are required");
+        validatePositive(caps.getMaxLines(), "maxLines");
+        validatePositive(caps.getMaxUnits(), "maxUnits");
+        MerchantStore managed = store(store);
+        managed.setMaxLines(caps.getMaxLines());
+        managed.setMaxUnits(caps.getMaxUnits());
+        merchantStoreService.update(managed);
+        return new CartCaps(managed.getMaxLines(), managed.getMaxUnits());
+    }
+
+    private Product product(Long id, MerchantStore store) throws ServiceException {
+        if (id == null || store == null) throw notFound();
+        Product product = productService.findOne(id, store);
+        if (product == null) throw notFound();
+        return product;
+    }
+
+    private MerchantStore store(MerchantStore value) throws ServiceException {
+        if (value == null || value.getId() == null) throw notFound();
+        MerchantStore managed = merchantStoreService.getById(value.getId());
+        if (managed == null) throw notFound();
+        return managed;
+    }
+
+    private static void validateProduct(ProductCartLimits limits) throws ServiceException {
+        validatePositive(limits.getMinPerCart(), "minPerCart");
+        validatePositive(limits.getMaxPerCart(), "maxPerCart");
+        validatePositive(limits.getPackSize(), "packSize");
+        if (limits.getMinPerCart() != null && limits.getMaxPerCart() != null
+                && limits.getMinPerCart() > limits.getMaxPerCart()) throw invalid("minPerCart may not exceed maxPerCart");
+        if (limits.getMaxPerCart() != null && limits.getPackSize() != null
+                && limits.getMaxPerCart() < limits.getPackSize()) throw invalid("maxPerCart may not be less than packSize");
+    }
+
+    private static void validatePositive(Integer value, String name) throws ServiceException {
+        if (value != null && value < 1) throw invalid(name + " must be at least 1");
+    }
+    private static ServiceException invalid(String message) { return new ServiceException(ServiceException.EXCEPTION_VALIDATION, message); }
+    private static ServiceException notFound() { return new ServiceException(ServiceException.EXCEPTION_VALIDATION, "Not found"); }
+}
