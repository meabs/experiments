+
+	/** Validate a single replacement before any persistent/cart collection mutation. */
+	private void validateChange(ShoppingCart cart, com.salesmanager.core.model.shoppingcart.ShoppingCartItem changed,
+			int quantity, boolean adding) {
+		if (quantity < 0) reject("MIN_PER_CART", "Quantity cannot be negative");
+		if (quantity == 0) return;
+		int oldUnits = 0, oldLines = 0, oldQuantity = 0;
+		if (cart.getLineItems() != null) for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem line : cart.getLineItems()) {
+			int q = line.getQuantity() == null ? 0 : line.getQuantity(); oldUnits += q;
+			if (line.getQuantity() != null && line.getQuantity() > 0) oldLines++;
+			if (line.getProduct() != null && changed.getProduct() != null && line.getProduct().getId().equals(changed.getProduct().getId())) oldQuantity = q;
+		}
+		boolean newLine = oldQuantity == 0;
+		int resultingUnits = oldUnits - oldQuantity + (adding && oldQuantity > 0 ? oldQuantity + quantity : quantity);
+		int resultingQuantity = adding && oldQuantity > 0 ? oldQuantity + quantity : quantity;
+		validateProduct(changed.getProduct(), resultingQuantity);
+		if (cart.getMerchantStore() != null && newLine && cart.getMerchantStore().getMaxLines() != null
+				&& oldLines + 1 > cart.getMerchantStore().getMaxLines()) reject("MAX_LINES", "Cart line limit exceeded");
+		if (cart.getMerchantStore() != null && cart.getMerchantStore().getMaxUnits() != null
+				&& resultingUnits > oldUnits && resultingUnits > cart.getMerchantStore().getMaxUnits()) reject("MAX_UNITS", "Cart unit limit exceeded");
+	}
+
+	private void validateProduct(Product product, int quantity) {
+		if (product.getMinPerCart() != null && quantity < product.getMinPerCart()) reject("MIN_PER_CART", "Minimum quantity not met");
+		if (product.getMaxPerCart() != null && quantity > product.getMaxPerCart()) reject("MAX_PER_CART", "Maximum quantity exceeded");
+		if (product.getPackSize() != null && quantity % product.getPackSize() != 0) reject("PACK_SIZE", "Quantity must be a multiple of pack size");
+	}
+
+	private void validateMultiChange(ShoppingCart cart, List<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> changes) {
+		java.util.Map<Long,Integer> quantities = new java.util.HashMap<Long,Integer>();
+		if (cart.getLineItems() != null) for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem line : cart.getLineItems()) quantities.put(line.getProduct().getId(), line.getQuantity());
+		int oldUnits = quantities.values().stream().mapToInt(Integer::intValue).sum();
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem change : changes) {
+			int q = change.getQuantity();
+			if (q < 0) reject("MIN_PER_CART", "Quantity cannot be negative");
+			if (q > 0) validateProduct(change.getProduct(), q);
+			if (q == 0) quantities.remove(change.getProduct().getId()); else quantities.put(change.getProduct().getId(), q);
+		}
+		int newUnits = quantities.values().stream().mapToInt(Integer::intValue).sum();
+		int oldLines = cart.getLineItems() == null ? 0 : cart.getLineItems().size();
+		boolean lineAdded = quantities.size() > oldLines;
+		if (lineAdded && cart.getMerchantStore().getMaxLines() != null && quantities.size() > cart.getMerchantStore().getMaxLines()) reject("MAX_LINES", "Cart line limit exceeded");
+		if (newUnits > oldUnits && cart.getMerchantStore().getMaxUnits() != null && newUnits > cart.getMerchantStore().getMaxUnits()) reject("MAX_UNITS", "Cart unit limit exceeded");
