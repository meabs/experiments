+package com.salesmanager.core.business.services.cart;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+/** Pure rule evaluation helpers shared by cart implementations. */
+public final class CartLimitValidation {
+    private CartLimitValidation() { }
+    public static CartLimitRule productRule(Product product, int quantity) {
+        if (quantity == 0) return null;
+        if (product.getMinPerCart() != null && quantity < product.getMinPerCart()) return CartLimitRule.MIN_PER_CART;
+        if (product.getMaxPerCart() != null && quantity > product.getMaxPerCart()) return CartLimitRule.MAX_PER_CART;
+        if (product.getPackSize() != null && quantity % product.getPackSize() != 0) return CartLimitRule.PACK_SIZE;
+        return null;
+    }
+    public static List<CartLimitViolation> evaluate(MerchantStore store, Map<String, Product> products, Map<String, Integer> quantities) {
+        List<CartLimitViolation> result = new ArrayList<>();
+        int lines = 0, units = 0;
+        for (Map.Entry<String, Integer> entry : quantities.entrySet()) {
+            int quantity = entry.getValue() == null ? 0 : entry.getValue();
+            if (quantity <= 0) continue;
+            lines++; units += quantity;
+            Product product = products.get(entry.getKey());
+            if (product != null) {
+                CartLimitRule rule = productRule(product, quantity);
+                if (rule != null) result.add(new CartLimitViolation(entry.getKey(), rule));
+            }
+        }
+        if (store.getMaxLines() != null && lines > store.getMaxLines()) result.add(new CartLimitViolation(null, CartLimitRule.MAX_LINES));
+        if (store.getMaxUnits() != null && units > store.getMaxUnits()) result.add(new CartLimitViolation(null, CartLimitRule.MAX_UNITS));
+        return result;
+    }
+}
