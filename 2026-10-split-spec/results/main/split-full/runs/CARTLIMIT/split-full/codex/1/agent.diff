+package com.salesmanager.core.business.services.cart;
+
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.cart.CartRules;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("cartRuleService")
+public class CartRuleServiceImpl implements CartRuleService {
+    private final MerchantStoreService merchantStoreService;
+    @Inject
+    public CartRuleServiceImpl(MerchantStoreService merchantStoreService) { this.merchantStoreService = merchantStoreService; }
+    public CartRules getRules(MerchantStore store) { return new CartRules(store.getMaxLines(), store.getMaxUnits()); }
+    public CartRules setRules(MerchantStore store, CartRules rules) throws ServiceException {
+        if (rules == null) throw new IllegalArgumentException("rules are required");
+        checkPositive(rules.getMaxLines()); checkPositive(rules.getMaxUnits());
+        store.setMaxLines(rules.getMaxLines()); store.setMaxUnits(rules.getMaxUnits());
+        merchantStoreService.saveOrUpdate(store);
+        return getRules(store);
+    }
+    private void checkPositive(Integer value) { if (value != null && value < 1) throw new IllegalArgumentException("rules must be positive"); }
+}
