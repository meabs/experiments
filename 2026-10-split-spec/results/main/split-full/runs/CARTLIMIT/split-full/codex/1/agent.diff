+    @GetMapping("/product/{id}/limits")
+    public ProductLimits getProductLimits(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        Optional<com.salesmanager.core.model.cart.ProductLimits> result = productLimitService.getLimits(id, store);
+        if (!result.isPresent()) throw new ResourceNotFoundException("Product not found");
+        return productDto(result.get());
