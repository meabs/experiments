+package com.salesmanager.core.business.services.cart;
+
+import java.util.Optional;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.cart.ProductLimits;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productLimitService")
+public class ProductLimitServiceImpl implements ProductLimitService {
+    private final ProductService productService;
+    @Inject
+    public ProductLimitServiceImpl(ProductService productService) { this.productService = productService; }
+
+    public ProductLimits getLimits(Product product) {
+        return new ProductLimits(product.getMinPerCart(), product.getMaxPerCart(), product.getPackSize());
+    }
+    public Optional<ProductLimits> getLimits(Long id, MerchantStore store) {
+        Product product = productService.findOne(id, store);
+        return product == null ? Optional.<ProductLimits>empty() : Optional.of(getLimits(product));
+    }
+    public ProductLimits setLimits(Product product, ProductLimits limits) throws ServiceException {
+        validate(limits);
+        product.setMinPerCart(limits.getMinPerCart());
+        product.setMaxPerCart(limits.getMaxPerCart());
+        product.setPackSize(limits.getPackSize());
+        productService.saveProduct(product);
+        return getLimits(product);
+    }
+    public Optional<ProductLimits> setLimits(Long id, MerchantStore store, ProductLimits limits) throws ServiceException {
+        Product product = productService.findOne(id, store);
+        return product == null ? Optional.<ProductLimits>empty() : Optional.of(setLimits(product, limits));
+    }
+    private void validate(ProductLimits l) {
+        if (l == null) throw new IllegalArgumentException("limits are required");
+        checkPositive(l.getMinPerCart()); checkPositive(l.getMaxPerCart()); checkPositive(l.getPackSize());
+        if (l.getMinPerCart() != null && l.getMaxPerCart() != null && l.getMinPerCart() > l.getMaxPerCart())
+            throw new IllegalArgumentException("minPerCart may not exceed maxPerCart");
+        if (l.getMaxPerCart() != null && l.getPackSize() != null && l.getMaxPerCart() < l.getPackSize())
+            throw new IllegalArgumentException("maxPerCart may not be less than packSize");
+    }
+    private void checkPositive(Integer value) { if (value != null && value < 1) throw new IllegalArgumentException("limits must be positive"); }
+}
