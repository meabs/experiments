+
+    @PutMapping("/product/{id}/limits")
+    public ProductLimits setProductLimits(@PathVariable Long id, @RequestBody ProductLimits dto,
+            @ApiIgnore MerchantStore store) {
+        try {
+            if (dto == null) throw new IllegalArgumentException("limits are required");
+            com.salesmanager.core.model.cart.ProductLimits limits = new com.salesmanager.core.model.cart.ProductLimits(dto.getMinPerCart(), dto.getMaxPerCart(), dto.getPackSize());
+            Optional<com.salesmanager.core.model.cart.ProductLimits> result = productLimitService.setLimits(id, store, limits);
+            if (!result.isPresent()) throw new ResourceNotFoundException("Product not found");
+            return productDto(result.get());
+        } catch (IllegalArgumentException e) {
+            throw new RestApiException("400", e.getMessage());
+        } catch (com.salesmanager.core.business.exception.ServiceException e) {
+            throw new RestApiException("400", e.getMessage(), e);
+        }
+    }
