+	private void validateCartChange(ShoppingCart cart, List<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> changes,
+			MerchantStore store, boolean incrementExisting) {
+		java.util.Map<String, Integer> quantities = new java.util.HashMap<>();
+		if (cart.getLineItems() != null) for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : cart.getLineItems())
+			quantities.put(i.getProduct().getSku(), i.getQuantity());
+		int oldLines = quantities.size();
+		int oldUnits = quantities.values().stream().mapToInt(Integer::intValue).sum();
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem change : changes) {
+			String sku = change.getProduct().getSku();
+			int q = change.getQuantity() == null ? 0 : change.getQuantity();
+			if (q < 0) throw new CartLimitException("MIN_PER_CART", sku);
+			if (incrementExisting && q > 0 && quantities.containsKey(sku)) q += quantities.get(sku);
+			if (q > 0) {
+				ProductLimits l = productLimitService.getLimits(change.getProduct());
+				if (l.getMinPerCart() != null && q < l.getMinPerCart()) throw new CartLimitException("MIN_PER_CART", sku);
+				if (l.getMaxPerCart() != null && q > l.getMaxPerCart()) throw new CartLimitException("MAX_PER_CART", sku);
+				if (l.getPackSize() != null && q % l.getPackSize() != 0) throw new CartLimitException("PACK_SIZE", sku);
+			}
+			if (q == 0) quantities.remove(sku); else quantities.put(sku, q);
+		}
+		CartRules rules = cartRuleService.getRules(store);
+		int newLines = quantities.size();
+		int newUnits = quantities.values().stream().mapToInt(Integer::intValue).sum();
+		if (rules.getMaxLines() != null && newLines > oldLines && newLines > rules.getMaxLines()) throw new CartLimitException("MAX_LINES", null);
+		if (rules.getMaxUnits() != null && newUnits > oldUnits && newUnits > rules.getMaxUnits()) throw new CartLimitException("MAX_UNITS", null);
+	}
