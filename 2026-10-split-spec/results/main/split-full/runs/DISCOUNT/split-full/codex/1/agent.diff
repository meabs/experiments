+/** Administration endpoints for merchant-owned promotion codes. */
+@RestController
+@RequestMapping(value = "/api/v1/private/discounts", produces = MediaType.APPLICATION_JSON_VALUE)
+public class DiscountApi {
+
+    @Inject
+    private DiscountService discountService;
+
+    @PostMapping(consumes = MediaType.APPLICATION_JSON_VALUE)
+    @ResponseStatus(HttpStatus.CREATED)
+    @ApiImplicitParams(@ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT"))
+    public Discount create(@RequestBody Discount discount, @ApiIgnore MerchantStore store) {
+        discount.setId(null);
+        discount.setMerchantStore(store);
+        try {
+            return discountService.create(discount);
+        } catch (ServiceException e) {
+            throw apiError(e);
+        }
+    }
+
+    @GetMapping
+    @ApiImplicitParams(@ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT"))
+    public List<Discount> list(@ApiIgnore MerchantStore store) {
+        try {
+            return discountService.list(store);
+        } catch (ServiceException e) {
+            throw apiError(e);
+        }
+    }
+
+    @PutMapping(value = "/{id}", consumes = MediaType.APPLICATION_JSON_VALUE)
+    @ApiImplicitParams(@ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT"))
+    public Discount update(@PathVariable Long id, @RequestBody Discount discount,
+            @ApiIgnore MerchantStore store) {
+        Discount existing = find(id, store);
+        discount.setId(existing.getId());
+        discount.setMerchantStore(store);
+        try {
+            return discountService.update(discount);
+        } catch (ServiceException e) {
+            throw apiError(e);
+        }
+    }
+
+    @DeleteMapping("/{id}")
+    @ResponseStatus(HttpStatus.NO_CONTENT)
+    @ApiImplicitParams(@ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT"))
+    public void delete(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        // Resolve first so deleting another store's id cannot silently succeed.
+        find(id, store);
+        try {
+            discountService.delete(id, store);
+        } catch (ServiceException e) {
+            throw apiError(e);
+        }
+    }
+
+    private Discount find(Long id, MerchantStore store) {
+        try {
+            for (Discount discount : discountService.list(store)) {
+                if (id.equals(discount.getId())) {
+                    return discount;
+                }
+            }
+        } catch (ServiceException e) {
+            throw apiError(e);
+        }
+        throw new ResourceNotFoundException("Discount not found: " + id);
+    }
+
+    private RuntimeException apiError(ServiceException e) {
+        String message = e.getMessage() == null ? "Invalid discount" : e.getMessage();
+        // The service uses validation for both malformed values and duplicate codes.
+        if (message.toLowerCase().contains("already exists") || message.toLowerCase().contains("duplicate")) {
+            return new DiscountConflictException(message);
+        }
+        return new RestApiException("400", message);
+    }
+
+    @ResponseStatus(HttpStatus.CONFLICT)
+    private static class DiscountConflictException extends RuntimeException {
+        private static final long serialVersionUID = 1L;
+        DiscountConflictException(String message) { super(message); }
+    }
+}
