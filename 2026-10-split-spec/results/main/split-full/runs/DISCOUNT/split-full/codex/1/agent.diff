+package com.salesmanager.core.business.services.discount;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDate;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.category.CategoryRepository;
+import com.salesmanager.core.business.repositories.discount.DiscountRepository;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service("discountService")
+public class DiscountServiceImpl implements DiscountService {
+ private final DiscountRepository repository; private final CategoryRepository categoryRepository;
+ @Inject public DiscountServiceImpl(DiscountRepository r, CategoryRepository c){repository=r;categoryRepository=c;}
+ private ServiceException invalid(String s){return new ServiceException(ServiceException.EXCEPTION_VALIDATION,s);}
+ private void validate(Discount d) throws ServiceException {
+  if(d==null || d.getMerchantStore()==null || d.getCode()==null || d.getCode().trim().isEmpty() || d.getValue()==null || d.getType()==null) throw invalid("Invalid discount");
+  d.setCode(d.getCode().trim()); if(d.getStartDate()==null)d.setStartDate(LocalDate.now());
+  if(d.getValue().compareTo(BigDecimal.ZERO)<=0 || (d.getType()==DiscountType.PERCENT && d.getValue().compareTo(new BigDecimal("100"))>0)) throw invalid("Invalid discount value");
+  if(d.getMinimumSubtotal()!=null && d.getMinimumSubtotal().compareTo(BigDecimal.ZERO)<0) throw invalid("Invalid minimum subtotal");
+  if(d.getEndDate()!=null && d.getEndDate().isBefore(d.getStartDate())) throw invalid("Invalid discount dates");
+  if(d.getCategories()!=null) for(String code:d.getCategories()) if(code==null || categoryRepository.findByCode(d.getMerchantStore().getId(),code)==null) throw invalid("Unknown category: "+code);
+  Discount existing=repository.findByStoreAndCode(d.getMerchantStore().getId(),d.getCode());
+  if(existing!=null && (d.getId()==null || !existing.getId().equals(d.getId()))) throw invalid("Discount code already exists");
+ }
+ public Discount create(Discount d)throws ServiceException{validate(d);return repository.saveAndFlush(d);}
+ public Discount update(Discount d)throws ServiceException{validate(d);return repository.saveAndFlush(d);}
+ public void delete(Long id,MerchantStore s)throws ServiceException{Discount d=repository.findById(id).orElse(null);if(d!=null&&d.getMerchantStore().getId().equals(s.getId()))repository.delete(d);}
+ public List<Discount> list(MerchantStore s)throws ServiceException{return repository.findByStore(s.getId());}
+ public Discount findByCode(MerchantStore s,String code)throws ServiceException{return code==null?null:repository.findByStoreAndCode(s.getId(),code);}
+ public Evaluation evaluate(Discount d,ShoppingCart cart)throws ServiceException{
+  if(d==null||cart==null||cart.getMerchantStore()==null||d.getMerchantStore()==null||!d.getMerchantStore().getId().equals(cart.getMerchantStore().getId())||!d.isActive())return new Evaluation(false,BigDecimal.ZERO);
+  LocalDate today=LocalDate.now(); if(d.getStartDate()!=null&&today.isBefore(d.getStartDate())||(d.getEndDate()!=null&&today.isAfter(d.getEndDate())))return new Evaluation(false,BigDecimal.ZERO);
+  BigDecimal subtotal=BigDecimal.ZERO; BigDecimal eligible=BigDecimal.ZERO;
+  for(ShoppingCartItem i:cart.getLineItems()){BigDecimal line=i.getSubTotal();if(line==null&&i.getItemPrice()!=null)line=i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity()==null?1:i.getQuantity()));if(line==null)continue;subtotal=subtotal.add(line);if(isEligible(i,d))eligible=eligible.add(line);}
+  if(d.getMinimumSubtotal()!=null&&subtotal.compareTo(d.getMinimumSubtotal())<0||eligible.compareTo(BigDecimal.ZERO)<=0)return new Evaluation(false,BigDecimal.ZERO);
+  BigDecimal amount=d.getType()==DiscountType.PERCENT?eligible.multiply(d.getValue()).divide(new BigDecimal("100"),8,RoundingMode.HALF_UP):d.getValue(); if(amount.compareTo(eligible)>0)amount=eligible;
+  return new Evaluation(true,amount.setScale(2,RoundingMode.HALF_UP));
+ }
+ private boolean isEligible(ShoppingCartItem item,Discount d){if(d.getCategories()==null||d.getCategories().isEmpty())return true;Product p=item.getProduct();if(p==null||p.getCategories()==null)return false;for(Category c:p.getCategories())for(String wanted:d.getCategories()){Category x=c;while(x!=null){if(wanted.equalsIgnoreCase(x.getCode()))return true;x=x.getParent();}}return false;}
+}
