+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.discount.PersistableDiscount;
+import com.salesmanager.shop.model.discount.ReadableDiscount;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Merchant administration endpoints for store discount codes. */
+@RestController
+@RequestMapping(value = "/api/v1/private/discounts", produces = MediaType.APPLICATION_JSON_VALUE)
+public class DiscountApi {
+
+    private final DiscountService discountService;
+
+    public DiscountApi(DiscountService discountService) { this.discountService = discountService; }
+
+    @PostMapping
+    public ResponseEntity<?> create(@ApiIgnore MerchantStore store, @Valid @RequestBody PersistableDiscount payload) {
+        try {
+            Discount model = toModel(payload, store);
+            discountService.create(model);
+            return ResponseEntity.status(HttpStatus.CREATED).body(toDto(model));
+        } catch (ServiceException e) { return error(e); }
+        catch (IllegalArgumentException e) { return ResponseEntity.badRequest().body(e.getMessage()); }
+    }
+
+    @GetMapping
+    public ResponseEntity<List<ReadableDiscount>> list(@ApiIgnore MerchantStore store) {
+        List<Discount> values = discountService.listByStore(store);
+        return ResponseEntity.ok(values == null ? Collections.<ReadableDiscount>emptyList() :
+            values.stream().map(this::toDto).collect(Collectors.toList()));
+    }
+
+    @PutMapping("/{id}")
+    public ResponseEntity<?> update(@PathVariable Long id, @ApiIgnore MerchantStore store,
+            @Valid @RequestBody PersistableDiscount payload) {
+        Discount existing = discountService.getById(store, id);
+        if (existing == null) return ResponseEntity.status(HttpStatus.NOT_FOUND).body("Discount not found");
+        try {
+            Discount model = toModel(payload, store);
+            model.setId(id);
+            discountService.update(model);
+            return ResponseEntity.ok(toDto(model));
+        } catch (ServiceException e) { return error(e); }
+        catch (IllegalArgumentException e) { return ResponseEntity.badRequest().body(e.getMessage()); }
+    }
+
+    @DeleteMapping("/{id}")
+    public ResponseEntity<?> delete(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        Discount existing = discountService.getById(store, id);
+        if (existing == null) return ResponseEntity.status(HttpStatus.NOT_FOUND).body("Discount not found");
+        try { discountService.delete(existing); return ResponseEntity.noContent().build(); }
+        catch (ServiceException e) { return error(e); }
+    }
+
+    private ResponseEntity<String> error(ServiceException e) {
+        String message = e.getMessage() == null ? "Invalid discount" : e.getMessage();
+        return ResponseEntity.status(message.toLowerCase().contains("duplicate") ? HttpStatus.CONFLICT : HttpStatus.BAD_REQUEST).body(message);
+    }
+
+    private Discount toModel(PersistableDiscount p, MerchantStore store) {
+        Discount d = new Discount(store);
+        d.setCode(p.getCode());
+        d.setType(p.getType() == null ? null : DiscountType.valueOf(p.getType().toUpperCase()));
+        d.setValue(p.getValue()); d.setMinimumSubtotal(p.getMinimumSubtotal());
+        d.setStartDate(p.getStartDate()); d.setEndDate(p.getEndDate());
+        d.setCategories(p.getCategories()); d.setActive(p.getActive() == null || p.getActive());
+        return d;
+    }
+
+    private ReadableDiscount toDto(Discount d) {
+        ReadableDiscount p = new ReadableDiscount(); p.setId(d.getId()); p.setCode(d.getCode());
+        p.setType(d.getType() == null ? null : d.getType().name()); p.setValue(d.getValue());
+        p.setMinimumSubtotal(d.getMinimumSubtotal()); p.setStartDate(d.getStartDate()); p.setEndDate(d.getEndDate());
+        p.setCategories(d.getCategories()); p.setActive(d.isActive()); return p;
+    }
+}
