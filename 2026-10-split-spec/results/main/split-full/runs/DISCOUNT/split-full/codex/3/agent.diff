@@ -0,0 +1,107 @@
+package com.salesmanager.core.business.services.discount;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDate;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+import java.util.Optional;
+
+import javax.inject.Inject;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.stereotype.Service;
+import org.springframework.util.StringUtils;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.category.CategoryRepository;
+import com.salesmanager.core.business.repositories.discount.DiscountRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service("discountService")
+public class DiscountServiceImpl extends SalesManagerEntityServiceImpl<Long, Discount> implements DiscountService {
+    private final DiscountRepository discountRepository;
+    @Autowired(required = false)
+    private CategoryRepository categoryRepository;
+
+    @Inject
+    public DiscountServiceImpl(DiscountRepository repository) {
+        super(repository);
+        this.discountRepository = repository;
+    }
+
+    @Override public List<Discount> listByStore(MerchantStore store) {
+        return store == null || store.getId() == null ? Collections.<Discount>emptyList() : discountRepository.findByMerchantStoreId(store.getId());
+    }
+
+    @Override public Optional<Discount> findByCode(MerchantStore store, String code) {
+        if (store == null || store.getId() == null || !StringUtils.hasText(code)) return Optional.empty();
+        return discountRepository.findByMerchantStoreIdAndCodeKey(store.getId(), key(code));
+    }
+
+    @Override public Discount getById(MerchantStore store, Long id) {
+        if (store == null || id == null) return null;
+        Discount d = discountRepository.findById(id).orElse(null);
+        return d != null && sameStore(store, d.getMerchantStore()) ? d : null;
+    }
+
+    @Override public void create(Discount discount) throws ServiceException { validate(discount); super.create(discount); }
+    @Override public void update(Discount discount) throws ServiceException { validate(discount); super.update(discount); }
+
+    @Override public void validate(Discount d) throws ServiceException {
+        if (d == null || d.getMerchantStore() == null || !StringUtils.hasText(d.getCode()) || d.getType() == null || d.getValue() == null)
+            throw invalid("code, type, value and store are required");
+        if (d.getType() == DiscountType.PERCENT && (d.getValue().signum() <= 0 || d.getValue().compareTo(BigDecimal.valueOf(100)) > 0))
+            throw invalid("percent must be greater than 0 and at most 100");
+        if (d.getType() == DiscountType.AMOUNT && d.getValue().signum() <= 0) throw invalid("amount must be greater than 0");
+        if (d.getMinimumSubtotal() != null && d.getMinimumSubtotal().signum() < 0) throw invalid("minimum subtotal cannot be negative");
+        if (d.getStartDate() == null) d.setStartDate(LocalDate.now());
+        if (d.getEndDate() != null && d.getEndDate().isBefore(d.getStartDate())) throw invalid("end date precedes start date");
+        d.setCode(d.getCode().trim());
+        if (d.getCategories() == null) d.setCategories(Collections.<String>emptyList());
+        if (categoryRepository != null) for (String category : d.getCategories()) {
+            if (!StringUtils.hasText(category) || categoryRepository.findByCode(d.getMerchantStore().getId(), category) == null)
+                throw invalid("unknown category: " + category);
+        }
+        Optional<Discount> existing = discountRepository.findByMerchantStoreIdAndCodeKey(d.getMerchantStore().getId(), d.getCodeKey());
+        if (existing.isPresent() && !existing.get().getId().equals(d.getId())) throw new ServiceException(ServiceException.EXCEPTION_VALIDATION, "duplicate discount code");
+    }
+
+    private ServiceException invalid(String message) { return new ServiceException(ServiceException.EXCEPTION_VALIDATION, message); }
+
+    @Override public boolean isApplicable(Discount d, ShoppingCart cart) { return isApplicable(d, cart, LocalDate.now()); }
+    @Override public boolean isApplicable(Discount d, ShoppingCart cart, LocalDate today) {
+        if (d == null || cart == null || !d.isActive() || !sameStore(d.getMerchantStore(), cart.getMerchantStore())) return false;
+        if (d.getStartDate() != null && today.isBefore(d.getStartDate()) || d.getEndDate() != null && today.isAfter(d.getEndDate())) return false;
+        BigDecimal subtotal = subtotal(cart);
+        if (d.getMinimumSubtotal() != null && subtotal.compareTo(d.getMinimumSubtotal()) < 0) return false;
+        return eligibleSubtotal(d, cart).signum() > 0;
+    }
+
+    @Override public BigDecimal calculateDiscount(Discount d, ShoppingCart cart) { return calculateDiscount(d, cart, LocalDate.now()); }
+    @Override public BigDecimal calculateDiscount(Discount d, ShoppingCart cart, LocalDate today) {
+        if (!isApplicable(d, cart, today)) return BigDecimal.ZERO.setScale(2);
+        BigDecimal eligible = eligibleSubtotal(d, cart);
+        BigDecimal result = d.getType() == DiscountType.PERCENT ? eligible.multiply(d.getValue()).divide(BigDecimal.valueOf(100), 8, RoundingMode.HALF_UP) : d.getValue().min(eligible);
+        return result.setScale(2, RoundingMode.HALF_UP);
+    }
+
+    private BigDecimal subtotal(ShoppingCart c) { BigDecimal n = BigDecimal.ZERO; for (ShoppingCartItem i : c.getLineItems()) n = n.add(lineSubtotal(i)); return n; }
+    private BigDecimal eligibleSubtotal(Discount d, ShoppingCart c) { BigDecimal n = BigDecimal.ZERO; for (ShoppingCartItem i : c.getLineItems()) if (eligible(d, i)) n = n.add(lineSubtotal(i)); return n; }
+    private BigDecimal lineSubtotal(ShoppingCartItem i) { if (i.getSubTotal() != null) return i.getSubTotal(); return i.getItemPrice() == null ? BigDecimal.ZERO : i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity() == null ? 0 : i.getQuantity())); }
+    private boolean eligible(Discount d, ShoppingCartItem i) {
+        if (d.getCategories() == null || d.getCategories().isEmpty()) return true;
+        Product p = i.getProduct(); if (p == null || p.getCategories() == null) return false;
+        for (Category c : p.getCategories()) for (Category parent = c; parent != null; parent = parent.getParent()) for (String code : d.getCategories()) if (code != null && code.equalsIgnoreCase(parent.getCode())) return true;
+        return false;
+    }
+    private static String key(String code) { return code.trim().toLowerCase(Locale.ROOT); }
+    private static boolean sameStore(MerchantStore a, MerchantStore b) { return a != null && b != null && a.getId() != null && a.getId().equals(b.getId()); }
+}
