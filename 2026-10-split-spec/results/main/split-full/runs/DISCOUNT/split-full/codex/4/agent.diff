@@ -0,0 +1,62 @@
+package com.salesmanager.shop.store.facade.discount;
+
+import java.time.LocalDate;
+import java.util.List;
+import java.util.stream.Collectors;
+
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.HttpStatus;
+import org.springframework.stereotype.Service;
+import org.springframework.web.server.ResponseStatusException;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.discount.DiscountConflictException;
+import com.salesmanager.core.business.services.discount.DiscountService;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.discount.PersistableDiscount;
+import com.salesmanager.shop.model.discount.ReadableDiscount;
+import com.salesmanager.shop.store.controller.discount.facade.DiscountFacade;
+
+@Service
+public class DiscountFacadeImpl implements DiscountFacade {
+    @Autowired private DiscountService discountService;
+
+    @Override public ReadableDiscount create(PersistableDiscount input, MerchantStore store) {
+        try { return toReadable(discountService.create(toModel(input, store), store)); }
+        catch (DiscountConflictException e) { throw new ResponseStatusException(HttpStatus.CONFLICT, e.getMessage(), e); }
+        catch (IllegalArgumentException e) { throw new ResponseStatusException(HttpStatus.BAD_REQUEST, e.getMessage(), e); }
+        catch (ServiceException e) { throw new ResponseStatusException(HttpStatus.BAD_REQUEST, e.getMessage(), e); }
+    }
+
+    @Override public List<ReadableDiscount> list(MerchantStore store) {
+        return discountService.list(store).stream().map(this::toReadable).collect(Collectors.toList());
+    }
+
+    @Override public ReadableDiscount update(Long id, PersistableDiscount input, MerchantStore store) {
+        if (discountService.find(id, store).isEmpty()) throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Discount not found");
+        input.setId(id);
+        try { return toReadable(discountService.update(toModel(input, store), store)); }
+        catch (DiscountConflictException e) { throw new ResponseStatusException(HttpStatus.CONFLICT, e.getMessage(), e); }
+        catch (IllegalArgumentException e) { throw new ResponseStatusException(HttpStatus.BAD_REQUEST, e.getMessage(), e); }
+        catch (ServiceException e) { throw new ResponseStatusException(HttpStatus.BAD_REQUEST, e.getMessage(), e); }
+    }
+
+    @Override public void delete(Long id, MerchantStore store) {
+        if (discountService.find(id, store).isEmpty()) throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Discount not found");
+        try { discountService.delete(id, store); }
+        catch (ServiceException e) { throw new ResponseStatusException(HttpStatus.BAD_REQUEST, e.getMessage(), e); }
+    }
+
+    private Discount toModel(PersistableDiscount source, MerchantStore store) {
+        Discount d = new Discount(); d.setId(source.getId()); d.setMerchantStore(store); d.setCode(source.getCode());
+        d.setType(source.getType()); d.setValue(source.getValue()); d.setMinimumSubtotal(source.getMinimumSubtotal());
+        d.setStartDate(source.getStartDate() == null ? LocalDate.now() : source.getStartDate()); d.setEndDate(source.getEndDate());
+        d.setCategories(source.getCategories()); d.setActive(source.getActive() == null || source.getActive()); return d;
+    }
+    private ReadableDiscount toReadable(Discount source) {
+        ReadableDiscount d = new ReadableDiscount(); d.setId(source.getId()); d.setCode(source.getCode()); d.setType(source.getType());
+        d.setValue(source.getValue()); d.setMinimumSubtotal(source.getMinimumSubtotal()); d.setStartDate(source.getStartDate());
+        d.setEndDate(source.getEndDate()); d.setCategories(source.getCategories()); d.setActive(source.isActive()); return d;
+    }
+}
