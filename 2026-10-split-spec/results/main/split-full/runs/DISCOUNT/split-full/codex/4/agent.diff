+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/discounts")
+public class DiscountApi {
+    private final DiscountFacade facade;
+    public DiscountApi(DiscountFacade facade) { this.facade = facade; }
+
+    @PostMapping @ResponseStatus(HttpStatus.CREATED)
+    public ReadableDiscount create(@Valid @RequestBody PersistableDiscount discount, @ApiIgnore MerchantStore store) { return facade.create(discount, store); }
+    @GetMapping public List<ReadableDiscount> list(@ApiIgnore MerchantStore store) { return facade.list(store); }
+    @PutMapping("/{id}") public ReadableDiscount update(@PathVariable Long id, @Valid @RequestBody PersistableDiscount discount, @ApiIgnore MerchantStore store) { return facade.update(id, discount, store); }
+    @DeleteMapping("/{id}") @ResponseStatus(HttpStatus.NO_CONTENT)
+    public void delete(@PathVariable Long id, @ApiIgnore MerchantStore store) { facade.delete(id, store); }
+}
