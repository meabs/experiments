+package com.salesmanager.core.business.services.discount;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDate;
+import java.util.Collections;
+import java.util.List;
+import java.util.Optional;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.category.CategoryRepository;
+import com.salesmanager.core.business.repositories.discount.DiscountRepository;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.discount.DiscountEvaluation;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service("discountService")
+public class DiscountServiceImpl implements DiscountService {
+  private final DiscountRepository repository; private final CategoryRepository categories;
+  @Inject public DiscountServiceImpl(DiscountRepository r, CategoryRepository c){repository=r; categories=c;}
+  public Discount create(Discount d, MerchantStore s) throws ServiceException { d.setId(null); d.setMerchantStore(s); validate(d,s); return repository.save(d); }
+  public Discount update(Discount d, MerchantStore s) throws ServiceException { if(d.getId()==null) throw new IllegalArgumentException("Discount id is required"); Discount old=repository.findByIdAndMerchantStoreId(d.getId(),s.getId()).orElseThrow(()->new IllegalArgumentException("Discount not found")); d.setMerchantStore(s); validate(d,s); return repository.save(d); }
+  public List<Discount> list(MerchantStore s){return repository.findByMerchantStoreId(s.getId());}
+  public Optional<Discount> find(Long id, MerchantStore s){return repository.findByIdAndMerchantStoreId(id,s.getId());}
+  public Optional<Discount> findByCode(String code, MerchantStore s){return code==null?Optional.empty():repository.findByMerchantStoreIdAndCodeIgnoreCase(s.getId(),code);}
+  public void delete(Long id, MerchantStore s) throws ServiceException { repository.findByIdAndMerchantStoreId(id,s.getId()).ifPresent(repository::delete); }
+  private void validate(Discount d, MerchantStore s) throws ServiceException {
+    if(d.getCode()==null || d.getCode().trim().isEmpty() || d.getType()==null || d.getValue()==null || d.getValue().signum()<=0) throw new IllegalArgumentException("Code, type and positive value are required");
+    if(d.getType()==DiscountType.PERCENT && d.getValue().compareTo(BigDecimal.valueOf(100))>0) throw new IllegalArgumentException("Percent must not exceed 100");
+    if(d.getStartDate()==null)d.setStartDate(LocalDate.now()); if(d.getEndDate()!=null&&d.getEndDate().isBefore(d.getStartDate())) throw new IllegalArgumentException("End date precedes start date");
+    if(d.getCategories()==null)d.setCategories(Collections.emptyList());
+    for(String code:d.getCategories()){if(code==null||categories.findByCode(s.getId(),code)==null)throw new IllegalArgumentException("Unknown category: "+code);}
+    Optional<Discount> duplicate=repository.findByMerchantStoreIdAndCodeIgnoreCase(s.getId(),d.getCode()); if(duplicate.isPresent()&&!duplicate.get().getId().equals(d.getId()))throw new DiscountConflictException(d.getCode());
+  }
+  public DiscountEvaluation evaluate(String code, ShoppingCart cart){if(cart==null||cart.getMerchantStore()==null)return DiscountEvaluation.notApplicable(); Optional<Discount>d=findByCode(code,cart.getMerchantStore()); return d.map(x->evaluate(x,cart)).orElse(DiscountEvaluation.notApplicable());}
+  public DiscountEvaluation evaluate(Discount d, ShoppingCart cart){
+    if(d==null||cart==null||cart.getMerchantStore()==null||d.getMerchantStore()==null||!d.getMerchantStore().getId().equals(cart.getMerchantStore().getId())||!d.isActive())return DiscountEvaluation.notApplicable();
+    LocalDate today=LocalDate.now(); if(d.getStartDate()!=null&&today.isBefore(d.getStartDate())||d.getEndDate()!=null&&today.isAfter(d.getEndDate()))return DiscountEvaluation.notApplicable();
+    BigDecimal subtotal=BigDecimal.ZERO, eligible=BigDecimal.ZERO; for(ShoppingCartItem item:cart.getLineItems()){BigDecimal line=item.getSubTotal(); if(line==null&&item.getItemPrice()!=null)line=item.getItemPrice().multiply(BigDecimal.valueOf(item.getQuantity()==null?1:item.getQuantity())); if(line==null)continue; subtotal=subtotal.add(line); if(eligible(item,d))eligible=eligible.add(line);}
+    if(d.getMinimumSubtotal()!=null&&subtotal.compareTo(d.getMinimumSubtotal())<0||eligible.signum()<=0)return DiscountEvaluation.notApplicable(); BigDecimal amount=d.getType()==DiscountType.PERCENT?eligible.multiply(d.getValue()).divide(BigDecimal.valueOf(100),8,RoundingMode.HALF_UP):d.getValue(); amount=amount.min(eligible).setScale(2,RoundingMode.HALF_UP); return new DiscountEvaluation(amount.signum()>0,eligible,amount);
+  }
+  private boolean eligible(ShoppingCartItem item, Discount d){if(d.getCategories()==null||d.getCategories().isEmpty())return true; Product p=item.getProduct(); if(p==null||p.getCategories()==null)return false; for(Category c:p.getCategories())for(String wanted:d.getCategories()){Category root=categories.findByCode(d.getMerchantStore().getId(),wanted); if(root!=null&&(c.getId().equals(root.getId())||(c.getLineage()!=null&&root.getLineage()!=null&&c.getLineage().startsWith(root.getLineage()))))return true;} return false;}
+}
