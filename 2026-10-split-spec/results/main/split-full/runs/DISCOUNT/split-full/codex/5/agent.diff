+package com.salesmanager.shop.store.facade.discount;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.List;
+import java.util.stream.Collectors;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.services.discount.DiscountService;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.discount.PersistableDiscount;
+import com.salesmanager.shop.model.discount.ReadableDiscount;
+import com.salesmanager.shop.store.controller.discount.facade.DiscountFacade;
+
+@Service
+public class DiscountFacadeImpl implements DiscountFacade {
+    @Autowired private DiscountService discountService;
+
+    @Override public ReadableDiscount create(PersistableDiscount source, MerchantStore store) {
+        return read(discountService.create(store, write(source)));
+    }
+    @Override public List<ReadableDiscount> list(MerchantStore store) {
+        return discountService.list(store).stream().map(this::read).collect(Collectors.toList());
+    }
+    @Override public ReadableDiscount update(Long id, PersistableDiscount source, MerchantStore store) {
+        Discount result = discountService.update(store, id, write(source));
+        return result == null ? null : read(result);
+    }
+    @Override public boolean delete(Long id, MerchantStore store) {
+        if (discountService.getById(store, id) == null) return false;
+        discountService.delete(store, id);
+        return true;
+    }
+    private Discount write(PersistableDiscount s) {
+        Discount d = new Discount(); d.setCode(s.getCode());
+        d.setType(s.getType() == null ? null : DiscountType.valueOf(s.getType().toUpperCase()));
+        d.setValue(s.getValue()); d.setMinimumSubtotal(s.getMinimumSubtotal());
+        d.setStartDate(s.getStartDate()); d.setEndDate(s.getEndDate()); d.setActive(s.isActive());
+        d.setCategories(new HashSet<>(s.getCategories() == null ? new ArrayList<>() : s.getCategories()));
+        return d;
+    }
+    private ReadableDiscount read(Discount d) {
+        ReadableDiscount r = new ReadableDiscount(); r.setId(d.getId()); r.setCode(d.getCode());
+        r.setType(d.getType() == null ? null : d.getType().name()); r.setValue(d.getValue());
+        r.setMinimumSubtotal(d.getMinimumSubtotal()); r.setStartDate(d.getStartDate()); r.setEndDate(d.getEndDate());
+        r.setCategories(new ArrayList<>(d.getCategories() == null ? new HashSet<>() : d.getCategories())); r.setActive(d.isActive());
+        return r;
+    }
+}
