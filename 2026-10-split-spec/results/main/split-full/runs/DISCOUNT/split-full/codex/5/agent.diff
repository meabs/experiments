+package com.salesmanager.shop.store.api.v1.discount;
+
+import java.util.List;
+import javax.validation.Valid;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+import com.salesmanager.core.business.services.discount.DiscountConflictException;
+import com.salesmanager.core.business.services.discount.DiscountValidationException;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.discount.PersistableDiscount;
+import com.salesmanager.shop.model.discount.ReadableDiscount;
+import com.salesmanager.shop.store.controller.discount.facade.DiscountFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/discounts")
+public class DiscountApi {
+    @Autowired private DiscountFacade facade;
+
+    @PostMapping
+    public ResponseEntity<?> create(@ApiIgnore MerchantStore store, @Valid @RequestBody PersistableDiscount request) {
+        try { return ResponseEntity.status(HttpStatus.CREATED).body(facade.create(request, store)); }
+        catch (DiscountConflictException e) { return conflict(e); }
+        catch (DiscountValidationException | IllegalArgumentException e) { return bad(e); }
+    }
+    @GetMapping
+    public ResponseEntity<List<ReadableDiscount>> list(@ApiIgnore MerchantStore store) {
+        return ResponseEntity.ok(facade.list(store));
+    }
+    @PutMapping("/{id}")
+    public ResponseEntity<?> update(@PathVariable Long id, @ApiIgnore MerchantStore store,
+                                    @Valid @RequestBody PersistableDiscount request) {
+        try {
+            ReadableDiscount result = facade.update(id, request, store);
+            return result == null ? ResponseEntity.notFound().build() : ResponseEntity.ok(result);
+        } catch (DiscountConflictException e) { return conflict(e); }
+          catch (DiscountValidationException | IllegalArgumentException e) { return bad(e); }
+    }
+    @DeleteMapping("/{id}")
+    public ResponseEntity<Void> delete(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        return facade.delete(id, store) ? ResponseEntity.noContent().build() : ResponseEntity.notFound().build();
+    }
+    private ResponseEntity<String> bad(Exception e) { return ResponseEntity.status(HttpStatus.BAD_REQUEST).body(e.getMessage()); }
+    private ResponseEntity<String> conflict(Exception e) { return ResponseEntity.status(HttpStatus.CONFLICT).body(e.getMessage()); }
+}
