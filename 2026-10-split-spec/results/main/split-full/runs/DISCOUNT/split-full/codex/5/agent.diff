+package com.salesmanager.core.business.services.discount;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDate;
+import java.util.Collection;
+import java.util.Collections;
+import java.util.List;
+import java.util.Objects;
+import java.util.Set;
+import java.util.stream.Collectors;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.catalog.category.CategoryRepository;
+import com.salesmanager.core.business.repositories.discount.DiscountRepository;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service
+public class DiscountServiceImpl implements DiscountService {
+ private final DiscountRepository repository; private final CategoryRepository categoryRepository;
+ public DiscountServiceImpl(DiscountRepository repository, CategoryRepository categoryRepository){this.repository=repository;this.categoryRepository=categoryRepository;}
+ public List<Discount> list(MerchantStore s){return s==null?Collections.emptyList():repository.findByMerchantStoreId(s.getId());}
+ public Discount getById(MerchantStore s, Long id){return s==null||id==null?null:repository.findByIdAndMerchantStoreId(id,s.getId());}
+ public Discount findByCode(MerchantStore s,String code){return s==null||code==null?null:repository.findByMerchantStoreIdAndCodeIgnoreCase(s.getId(),code);}
+ @Transactional public Discount create(MerchantStore s, Discount d){if(s==null) throw new DiscountValidationException("Store is required"); d.setMerchantStore(s); validate(d); if(findByCode(s,d.getCode())!=null) throw new DiscountConflictException("Code already exists"); return repository.save(d);}
+ @Transactional public Discount update(MerchantStore s,Long id,Discount d){Discount old=getById(s,id);if(old==null) return null; d.setId(id);d.setMerchantStore(s);validate(d);Discount conflict=findByCode(s,d.getCode());if(conflict!=null&&!Objects.equals(conflict.getId(),id))throw new DiscountConflictException("Code already exists");return repository.save(d);}
+ @Transactional public void delete(MerchantStore s,Long id){Discount d=getById(s,id);if(d!=null)repository.delete(d);}
+ private void validate(Discount d){if(d.getCode()==null||d.getCode().trim().isEmpty()||d.getType()==null||d.getValue()==null)throw new DiscountValidationException("Code, type and value are required");d.setCode(d.getCode().trim());if(d.getStartDate()==null)d.setStartDate(LocalDate.now());if(d.getType()==DiscountType.PERCENT&&(d.getValue().signum()<=0||d.getValue().compareTo(BigDecimal.valueOf(100))>0))throw new DiscountValidationException("Invalid percentage");if(d.getType()==DiscountType.AMOUNT&&d.getValue().signum()<=0)throw new DiscountValidationException("Invalid amount");if(d.getMinimumSubtotal()!=null&&d.getMinimumSubtotal().signum()<0)throw new DiscountValidationException("Invalid minimum subtotal");if(d.getEndDate()!=null&&d.getEndDate().isBefore(d.getStartDate()))throw new DiscountValidationException("End date precedes start date");if(categoryRepository!=null&&d.getCategories()!=null)for(String c:d.getCategories())if(categoryRepository.findByCode(d.getMerchantStore().getId(),c)==null)throw new DiscountValidationException("Unknown category: "+c);}
+ public DiscountEvaluation evaluate(Discount d,ShoppingCart cart){if(cart==null)return new DiscountEvaluation(false,BigDecimal.ZERO);BigDecimal subtotal=cart.getLineItems().stream().map(this::itemSubtotal).reduce(BigDecimal.ZERO,BigDecimal::add);return evaluate(d,cart.getMerchantStore(),cart.getLineItems(),subtotal);}
+ public DiscountEvaluation evaluate(Discount d,MerchantStore store,Collection<ShoppingCartItem> items,BigDecimal subtotal){if(d==null||store==null||d.getMerchantStore()==null||!Objects.equals(store.getId(),d.getMerchantStore().getId())||!d.isActive())return new DiscountEvaluation(false,BigDecimal.ZERO);LocalDate today=LocalDate.now();if(d.getStartDate()!=null&&today.isBefore(d.getStartDate())||d.getEndDate()!=null&&today.isAfter(d.getEndDate()))return new DiscountEvaluation(false,BigDecimal.ZERO);if(d.getMinimumSubtotal()!=null&&subtotal.compareTo(d.getMinimumSubtotal())<0)return new DiscountEvaluation(false,BigDecimal.ZERO);Set<String> cats=d.getCategories()==null?Collections.emptySet():d.getCategories().stream().map(String::toLowerCase).collect(Collectors.toSet());BigDecimal eligible=items==null?BigDecimal.ZERO:items.stream().filter(i->eligible(i,cats)).map(this::itemSubtotal).reduce(BigDecimal.ZERO,BigDecimal::add);if(eligible.signum()<=0)return new DiscountEvaluation(false,BigDecimal.ZERO);BigDecimal amount=d.getType()==DiscountType.PERCENT?eligible.multiply(d.getValue()).divide(BigDecimal.valueOf(100),8,RoundingMode.HALF_UP):d.getValue().min(eligible);return new DiscountEvaluation(true,amount.setScale(2,RoundingMode.HALF_UP));}
+ private BigDecimal itemSubtotal(ShoppingCartItem i){if(i.getSubTotal()!=null)return i.getSubTotal();if(i.getItemPrice()!=null)return i.getItemPrice().multiply(BigDecimal.valueOf(i.getQuantity()==null?1:i.getQuantity()));return BigDecimal.ZERO;}
+ private boolean eligible(ShoppingCartItem i,Set<String> wanted){if(wanted.isEmpty())return true;Product p=i.getProduct();if(p==null||p.getCategories()==null)return false;for(Category c:p.getCategories())for(Category x=c;x!=null;x=x.getParent())if(x.getCode()!=null&&wanted.contains(x.getCode().toLowerCase()))return true;return false;}
+}
