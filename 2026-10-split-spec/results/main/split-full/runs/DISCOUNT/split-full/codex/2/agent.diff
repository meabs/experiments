@@ -0,0 +1,84 @@
+package com.salesmanager.shop.store.controller.discount;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.stream.Collectors;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.discount.DiscountCodeService;
+import com.salesmanager.core.model.discount.DiscountCode;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.discount.PersistableDiscount;
+import com.salesmanager.shop.model.discount.ReadableDiscount;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+
+@Service
+public class DiscountFacadeImpl implements DiscountFacade {
+    private final DiscountCodeService service;
+
+    public DiscountFacadeImpl(DiscountCodeService service) { this.service = service; }
+
+    @Override public ReadableDiscount create(PersistableDiscount input, MerchantStore store) {
+        requireStore(store);
+        try { return readable(service.create(model(input, store, null))); }
+        catch (ServiceException e) { throw translate(e); }
+    }
+
+    @Override public List<ReadableDiscount> list(MerchantStore store) {
+        requireStore(store);
+        try { return service.list(store).stream().map(this::readable).collect(Collectors.toList()); }
+        catch (ServiceException e) { throw new ServiceRuntimeException("Unable to list discounts", e); }
+    }
+
+    @Override public ReadableDiscount update(Long id, PersistableDiscount input, MerchantStore store) {
+        requireStore(store);
+        DiscountCode current = find(id, store);
+        try { return readable(service.update(model(input, store, current))); }
+        catch (ServiceException e) { throw translate(e); }
+    }
+
+    @Override public void delete(Long id, MerchantStore store) {
+        requireStore(store); find(id, store);
+        try { service.delete(store, id); }
+        catch (ServiceException e) { throw new ResourceNotFoundException("Discount not found [" + id + "]"); }
+    }
+
+    private DiscountCode find(Long id, MerchantStore store) {
+        if (id == null) throw new ResourceNotFoundException("Discount not found");
+        try {
+            return service.list(store).stream().filter(c -> id.equals(c.getId())).findFirst()
+                .orElseThrow(() -> new ResourceNotFoundException("Discount not found [" + id + "]"));
+        } catch (ServiceException e) {
+            throw new ServiceRuntimeException("Unable to find discount", e);
+        }
+    }
+
+    private DiscountCode model(PersistableDiscount in, MerchantStore store, DiscountCode existing) {
+        if (in == null) throw new DiscountBadRequestException("Discount is required");
+        DiscountCode d = existing == null ? new DiscountCode() : existing;
+        d.setMerchantStore(store); d.setCode(in.getCode()); d.setValue(in.getValue());
+        try { d.setType(in.getType() == null ? null : DiscountType.valueOf(in.getType().toUpperCase(Locale.ROOT))); }
+        catch (IllegalArgumentException e) { throw new DiscountBadRequestException("Unknown discount type"); }
+        d.setMinimumSubtotal(in.getMinimumSubtotal()); d.setStartDate(in.getStartDate()); d.setEndDate(in.getEndDate());
+        d.setCategories(in.getCategories() == null ? new ArrayList<String>() : in.getCategories());
+        d.setActive(in.getActive() == null || in.getActive());
+        return d;
+    }
+
+    private ReadableDiscount readable(DiscountCode d) {
+        ReadableDiscount out = new ReadableDiscount(); out.setId(d.getId()); out.setCode(d.getCode());
+        out.setType(d.getType() == null ? null : d.getType().name()); out.setValue(d.getValue());
+        out.setMinimumSubtotal(d.getMinimumSubtotal()); out.setStartDate(d.getStartDate()); out.setEndDate(d.getEndDate());
+        out.setCategories(d.getCategories()); out.setActive(d.isActive()); return out;
+    }
+    private void requireStore(MerchantStore store) { if (store == null || store.getId() == null) throw new IllegalArgumentException("Merchant store is required"); }
+    private RuntimeException translate(ServiceException e) {
+        if (e.getMessage() != null && e.getMessage().toLowerCase(Locale.ROOT).contains("duplicate")) return new DiscountConflictException(e.getMessage());
+        return new DiscountBadRequestException(e.getMessage());
+    }
+}
