+package com.salesmanager.core.business.services.discount;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDate;
+import java.util.Collections;
+import java.util.List;
+import java.util.Locale;
+import java.util.Optional;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.discount.DiscountCodeRepository;
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.discount.DiscountCode;
+import com.salesmanager.core.model.discount.DiscountEvaluation;
+import com.salesmanager.core.model.discount.DiscountType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service("discountCodeService")
+public class DiscountCodeServiceImpl implements DiscountCodeService {
+  private final DiscountCodeRepository repository;
+  private final CategoryService categoryService;
+  @Inject public DiscountCodeServiceImpl(DiscountCodeRepository repository, CategoryService categoryService) { this.repository=repository; this.categoryService=categoryService; }
+
+  public DiscountCode create(DiscountCode code) throws ServiceException { normalizeAndValidate(code, null); return repository.saveAndFlush(code); }
+  public DiscountCode update(DiscountCode code) throws ServiceException { normalizeAndValidate(code, code.getId()); return repository.saveAndFlush(code); }
+  public List<DiscountCode> list(MerchantStore store) { return repository.findByMerchantStoreId(store.getId()); }
+  public void delete(MerchantStore store, Long id) throws ServiceException {
+    DiscountCode c=repository.findByIdAndMerchantStoreId(id, store.getId()); if(c==null) throw new ServiceException(ServiceException.EXCEPTION_VALIDATION,"Unknown discount"); repository.delete(c);
+  }
+  public Optional<DiscountCode> findByStoreAndCodeIgnoreCase(MerchantStore store, String code) { if(store==null||code==null)return Optional.empty(); return Optional.ofNullable(repository.findByMerchantStoreIdAndCodeIgnoreCase(store.getId(), code)); }
+
+  private void normalizeAndValidate(DiscountCode c, Long updating) throws ServiceException {
+    if(c==null||c.getMerchantStore()==null||c.getCode()==null||c.getCode().trim().isEmpty()||c.getValue()==null||c.getType()==null) throw invalid("Code, type and value are required");
+    c.setCode(c.getCode().trim()); if(c.getStartDate()==null)c.setStartDate(LocalDate.now()); if(c.getCategories()==null)c.setCategories(Collections.<String>emptyList());
+    if(c.getType()==DiscountType.PERCENT && (c.getValue().signum()<=0||c.getValue().compareTo(new BigDecimal("100"))>0)) throw invalid("Invalid percentage");
+    if(c.getType()==DiscountType.AMOUNT && c.getValue().signum()<=0) throw invalid("Invalid amount");
+    if(c.getMinimumSubtotal()!=null&&c.getMinimumSubtotal().signum()<0) throw invalid("Invalid minimum subtotal");
+    if(c.getEndDate()!=null&&c.getEndDate().isBefore(c.getStartDate())) throw invalid("End date precedes start date");
+    for(String cat:c.getCategories()) { if(cat==null||categoryService.getByCode(c.getMerchantStore(),cat)==null) throw invalid("Unknown category: "+cat); }
+    for(DiscountCode existing:list(c.getMerchantStore())) if(!existing.getId().equals(updating)&&existing.getCode().equalsIgnoreCase(c.getCode())) throw new ServiceException(ServiceException.EXCEPTION_VALIDATION,"Duplicate discount code");
+  }
+  private ServiceException invalid(String m){return new ServiceException(ServiceException.EXCEPTION_VALIDATION,m);}
+
+  public Optional<DiscountEvaluation> evaluate(ShoppingCart cart, MerchantStore store, String code, LocalDate date) throws ServiceException { return findByStoreAndCodeIgnoreCase(store,code).flatMap(c->{try{return evaluate(cart,store,c,date);}catch(ServiceException e){return Optional.empty();}}); }
+  public Optional<DiscountEvaluation> evaluate(ShoppingCart cart, MerchantStore store, DiscountCode c, LocalDate date) throws ServiceException {
+    if(cart==null||store==null||c==null||c.getMerchantStore()==null||!store.getId().equals(c.getMerchantStore().getId())||!c.isActive())return Optional.empty();
+    LocalDate d=date==null?LocalDate.now():date; if(c.getStartDate()!=null&&d.isBefore(c.getStartDate())||c.getEndDate()!=null&&d.isAfter(c.getEndDate()))return Optional.empty();
+    BigDecimal subtotal=BigDecimal.ZERO, eligible=BigDecimal.ZERO; for(ShoppingCartItem item:cart.getLineItems()) { BigDecimal amount=item.getSubTotal(); if(amount==null&&item.getItemPrice()!=null) amount=item.getItemPrice().multiply(BigDecimal.valueOf(item.getQuantity()==null?1:item.getQuantity())); if(amount==null)continue; subtotal=subtotal.add(amount); if(isEligible(item,c))eligible=eligible.add(amount); }
+    if(c.getMinimumSubtotal()!=null&&subtotal.compareTo(c.getMinimumSubtotal())<0||eligible.signum()<=0)return Optional.empty();
+    BigDecimal discount=c.getType()==DiscountType.PERCENT?eligible.multiply(c.getValue()).divide(new BigDecimal("100"),8,RoundingMode.HALF_UP):c.getValue().min(eligible); discount=discount.setScale(2,RoundingMode.HALF_UP); if(discount.signum()<=0)return Optional.empty(); return Optional.of(new DiscountEvaluation(c,discount,eligible));
+  }
+  private boolean isEligible(ShoppingCartItem item, DiscountCode c) {
+    if(c.getCategories()==null||c.getCategories().isEmpty())return true; Product p=item.getProduct(); if(p==null||p.getCategories()==null)return false;
+    for(Category actual:p.getCategories()) for(String wanted:c.getCategories()) { Category root; try { root=categoryService.getByCode(c.getMerchantStore(),wanted); } catch(ServiceException e) { continue; } if(root!=null&&(actual.getId().equals(root.getId())||actual.getLineage()!=null&&actual.getLineage().contains("/"+root.getId()+"/")))return true; } return false;
+  }
+}
