+package com.salesmanager.shop.store.api.v1.discount;
+
+import java.util.List;
+
+import javax.validation.Valid;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.discount.PersistableDiscount;
+import com.salesmanager.shop.model.discount.ReadableDiscount;
+import com.salesmanager.shop.store.controller.discount.DiscountFacade;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/discounts")
+public class DiscountApi {
+    private final DiscountFacade discountFacade;
+
+    public DiscountApi(DiscountFacade discountFacade) {
+        this.discountFacade = discountFacade;
+    }
+
+    @PostMapping
+    @ResponseStatus(HttpStatus.CREATED)
+    public ReadableDiscount create(@ApiIgnore MerchantStore store,
+            @Valid @RequestBody PersistableDiscount discount) {
+        return discountFacade.create(discount, store);
+    }
+
+    @GetMapping
+    public List<ReadableDiscount> list(@ApiIgnore MerchantStore store) {
+        return discountFacade.list(store);
+    }
+
+    @PutMapping("/{id}")
+    public ReadableDiscount update(@PathVariable Long id, @ApiIgnore MerchantStore store,
+            @Valid @RequestBody PersistableDiscount discount) {
+        return discountFacade.update(id, discount, store);
+    }
+
+    @DeleteMapping("/{id}")
+    @ResponseStatus(HttpStatus.NO_CONTENT)
+    public void delete(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        discountFacade.delete(id, store);
+    }
+}
