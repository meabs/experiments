+package com.salesmanager.core.business.services.discount;
+
+import java.math.BigDecimal; import java.math.RoundingMode; import java.time.LocalDate; import java.util.Collections; import java.util.List; import java.util.Objects;
+import javax.inject.Inject; import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.discount.DiscountRepository; import com.salesmanager.core.business.services.catalog.category.CategoryService; import com.salesmanager.core.model.catalog.category.Category; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.discount.Discount; import com.salesmanager.core.model.discount.DiscountType; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.shoppingcart.ShoppingCart; import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+@Service("discountService")
+public class DiscountServiceImpl implements DiscountService {
+  private final DiscountRepository repository; private final CategoryService categoryService;
+  @Inject public DiscountServiceImpl(DiscountRepository r, CategoryService c){repository=r;categoryService=c;}
+  public List<Discount> list(MerchantStore s){return s==null?Collections.emptyList():repository.findByMerchantStoreId(s.getId());}
+  public Discount get(MerchantStore s,Long id){return repository.findByIdAndMerchantStoreId(id,s.getId()).orElse(null);}
+  public Discount findByCode(MerchantStore s,String code){return code==null||s==null?null:repository.findByStoreAndCode(s.getId(),code).orElse(null);}
+  public Discount create(MerchantStore s,Discount d){ if(d==null)d=new Discount(); d.setId(null); d.setMerchantStore(s); validate(d,null); return repository.save(d); }
+  public Discount update(MerchantStore s,Long id,Discount d){Discount old=get(s,id); if(old==null)throw new DiscountException("Discount not found"); d.setId(id); d.setMerchantStore(s); validate(d,id); return repository.save(d);}
+  public void delete(MerchantStore s,Long id){Discount d=get(s,id); if(d==null)throw new DiscountException("Discount not found"); repository.delete(d);}
+  private void validate(Discount d,Long id){
+    if(d.getMerchantStore()==null||d.getCode()==null||d.getCode().trim().isEmpty()||d.getType()==null||d.getValue()==null)throw new DiscountException("Code, type and value are required");
+    d.setCode(d.getCode().trim()); if(repository.existsDuplicate(d.getMerchantStore().getId(),d.getCode(),id))throw new DiscountException("Duplicate discount code");
+    if(d.getType()==DiscountType.PERCENT && (d.getValue().compareTo(BigDecimal.ZERO)<=0||d.getValue().compareTo(new BigDecimal("100"))>0))throw new DiscountException("Invalid percent value");
+    if(d.getType()==DiscountType.AMOUNT && d.getValue().compareTo(BigDecimal.ZERO)<=0)throw new DiscountException("Invalid amount value");
+    if(d.getStartDate()==null)d.setStartDate(LocalDate.now()); if(d.getEndDate()!=null&&d.getEndDate().isBefore(d.getStartDate()))throw new DiscountException("End date before start date");
+    if(d.getMinimumSubtotal()!=null&&d.getMinimumSubtotal().compareTo(BigDecimal.ZERO)<0)throw new DiscountException("Invalid minimum subtotal");
+    if(d.getCategories()!=null) for(String code:d.getCategories()){try { if(code==null||categoryService.getByCode(d.getMerchantStore(),code)==null)throw new DiscountException("Unknown category"); } catch(com.salesmanager.core.business.exception.ServiceException e){throw new DiscountException("Unknown category");}}
+  }
+  public DiscountCalculation calculate(ShoppingCart cart,Discount d){
+    if(cart==null||d==null||cart.getMerchantStore()==null||d.getMerchantStore()==null||!Objects.equals(cart.getMerchantStore().getId(),d.getMerchantStore().getId())||!d.isActive())return new DiscountCalculation(false,BigDecimal.ZERO,BigDecimal.ZERO);
+    LocalDate now=LocalDate.now(); if(d.getStartDate()!=null&&now.isBefore(d.getStartDate())||d.getEndDate()!=null&&now.isAfter(d.getEndDate()))return new DiscountCalculation(false,BigDecimal.ZERO,BigDecimal.ZERO);
+    BigDecimal subtotal=BigDecimal.ZERO, eligible=BigDecimal.ZERO; if (cart.getLineItems() != null) for(ShoppingCartItem item:cart.getLineItems()){BigDecimal line=item.getSubTotal(); if(line==null&&item.getItemPrice()!=null)line=item.getItemPrice().multiply(BigDecimal.valueOf(item.getQuantity()==null?1:item.getQuantity())); if(line==null)continue; subtotal=subtotal.add(line); Product p=item.getProduct(); if(d.getCategories()==null||d.getCategories().isEmpty()||p!=null&&eligible(p,d.getCategories()))eligible=eligible.add(line);}
+    if(d.getMinimumSubtotal()!=null&&subtotal.compareTo(d.getMinimumSubtotal())<0||eligible.compareTo(BigDecimal.ZERO)<=0)return new DiscountCalculation(false,BigDecimal.ZERO,eligible);
+    BigDecimal amount=d.getType()==DiscountType.PERCENT?eligible.multiply(d.getValue()).divide(new BigDecimal("100"),8,RoundingMode.HALF_UP):d.getValue(); amount=amount.min(eligible).setScale(2,RoundingMode.HALF_UP); return new DiscountCalculation(true,amount,eligible);
+  }
+  private boolean eligible(Product p,List<String> roots){
+    if (p.getCategories() == null) return false;
+    for(Category c:p.getCategories()) for(String root:roots) {
+      if (c.getCode().equalsIgnoreCase(root)) return true;
+      try {
+        Category rootCategory = categoryService.getByCode(p.getMerchantStore(), root);
+        if (rootCategory != null && rootCategory.getId() != null && c.getLineage() != null
+            && c.getLineage().contains("/" + rootCategory.getId() + "/")) return true;
+      } catch (com.salesmanager.core.business.exception.ServiceException ignored) { }
+    }
+    return false;
+  }
+}
