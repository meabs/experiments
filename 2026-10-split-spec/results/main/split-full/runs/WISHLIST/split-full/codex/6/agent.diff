+package com.salesmanager.core.business.repositories.customer;
+import java.util.List;
+import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Modifying;
+import org.springframework.data.jpa.repository.Query;
+import org.springframework.data.repository.query.Param;
+import com.salesmanager.core.model.customer.WishlistItem;
+
+public interface WishlistRepository extends JpaRepository<WishlistItem, Long> {
+    @Query("select w from WishlistItem w where w.customer.id = :customer and w.merchantStore.id = :store order by w.addedAt desc, w.id desc")
+    List<WishlistItem> findForCustomer(@Param("customer") Long customerId, @Param("store") Integer storeId);
+    WishlistItem findByCustomerIdAndMerchantStoreIdAndSku(Long customerId, Integer storeId, String sku);
+    long countByCustomerIdAndMerchantStoreId(Long customerId, Integer storeId);
+    @Query("select w.sku, count(distinct w.customer.id) from WishlistItem w where w.merchantStore.id = :store group by w.sku order by count(distinct w.customer.id) desc, w.sku asc")
+    List<Object[]> popular(@Param("store") Integer storeId);
+    @Modifying
+    @Query("delete from WishlistItem w where w.merchantStore.id = :store and w.sku = :sku")
+    int deleteByStoreAndSku(@Param("store") Integer storeId, @Param("sku") String sku);
+}
