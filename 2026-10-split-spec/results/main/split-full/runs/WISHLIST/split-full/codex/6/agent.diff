+package com.salesmanager.core.business.services.customer;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.customer.WishlistRepository;
+import com.salesmanager.core.model.customer.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("wishlistService")
+public class WishlistServiceImpl implements WishlistService {
+    public static final int MAX_ITEMS = 50;
+    private final WishlistRepository repository;
+    @Inject public WishlistServiceImpl(WishlistRepository repository) { this.repository = repository; }
+    private Integer storeId(MerchantStore s) { return s == null ? null : s.getId(); }
+    public List<WishlistItem> list(Customer c, MerchantStore s) { if (c == null || s == null) return Collections.emptyList(); return repository.findForCustomer(c.getId(), storeId(s)); }
+    public WishlistItem find(Customer c, MerchantStore s, String sku) { return c == null || s == null || sku == null ? null : repository.findByCustomerIdAndMerchantStoreIdAndSku(c.getId(), storeId(s), sku); }
+    @Transactional
+    public WishlistItem add(Customer c, MerchantStore s, String sku) {
+        if (c == null || s == null || sku == null || sku.trim().isEmpty()) throw new IllegalArgumentException("product is required");
+        WishlistItem existing = find(c,s,sku); if (existing != null) return existing;
+        if (repository.countByCustomerIdAndMerchantStoreId(c.getId(), storeId(s)) >= MAX_ITEMS) throw new IllegalStateException("wishlist limit exceeded");
+        WishlistItem w = new WishlistItem(); w.setCustomer(c); w.setMerchantStore(s); w.setSku(sku); w.setAddedAt(new Date()); return repository.save(w);
+    }
+    @Transactional public void remove(Customer c, MerchantStore s, String sku) { WishlistItem w=find(c,s,sku); if(w==null) throw new NoSuchElementException("wishlist item not found"); repository.delete(w); }
+    @Transactional public void removeProduct(MerchantStore s, String sku) { if(s != null && sku != null) repository.deleteByStoreAndSku(storeId(s), sku); }
+    public List<PopularWishlistDto> popular(MerchantStore s) { List<PopularWishlistDto> out=new ArrayList<>(); if(s==null)return out; for(Object[] r:repository.popular(storeId(s))){ if(out.size()>=10)break; out.add(new PopularWishlistDto((String)r[0], ((Number)r[1]).longValue())); } return out; }
+}
