+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.math.BigDecimal;
+import java.security.Principal;
+import java.util.Date;
+import java.util.List;
+
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.server.ResponseStatusException;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.pricing.PricingService;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.customer.WishlistService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.WishlistDto;
+import com.salesmanager.core.model.customer.WishlistItem;
+import com.salesmanager.core.model.customer.WishlistItemDto;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.shop.model.customer.WishlistRequest;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Customer-owned wishlist endpoints. */
+@RestController
+@RequestMapping("/api/v1/auth/customer/wishlist")
+public class WishlistApi {
+    @Inject private WishlistService wishlistService;
+    @Inject private CustomerFacade customerFacade;
+    @Inject private ProductService productService;
+    @Inject private PricingService pricingService;
+    @Inject private ShoppingCartFacade shoppingCartFacade;
+
+    @GetMapping
+    public WishlistDto list(@ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest request) {
+        return view(customer(request, store), store, language);
+    }
+
+    @PostMapping
+    public ResponseEntity<WishlistDto> add(@RequestBody WishlistRequest payload, @ApiIgnore MerchantStore store,
+            @ApiIgnore Language language, HttpServletRequest request) {
+        if (payload == null || payload.getProduct() == null || payload.getProduct().trim().isEmpty())
+            return ResponseEntity.badRequest().build();
+        Customer customer = customer(request, store);
+        if (product(payload.getProduct(), store, language) == null)
+            throw new ResourceNotFoundException("Product with sku " + payload.getProduct() + " does not exist");
+        boolean existing = wishlistService.find(customer, store, payload.getProduct()) != null;
+        try {
+            wishlistService.add(customer, store, payload.getProduct());
+        } catch (IllegalStateException e) { return ResponseEntity.badRequest().build(); }
+        return new ResponseEntity<>(view(customer, store, language), existing ? HttpStatus.OK : HttpStatus.CREATED);
+    }
+
+    @DeleteMapping("/{sku}")
+    public ResponseEntity<Void> remove(@PathVariable String sku, @ApiIgnore MerchantStore store, HttpServletRequest request) {
+        try { wishlistService.remove(customer(request, store), store, sku); }
+        catch (java.util.NoSuchElementException e) { throw new ResourceNotFoundException(e.getMessage()); }
+        return ResponseEntity.noContent().build();
+    }
+
+    @PostMapping("/{sku}/cart/{cartCode}")
+    public ResponseEntity<ReadableShoppingCart> move(@PathVariable String sku, @PathVariable String cartCode,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest request) {
+        Customer customer = customer(request, store);
+        WishlistItem item = wishlistService.find(customer, store, sku);
+        if (item == null) throw new ResourceNotFoundException("Wishlist item not found");
+        try {
+            ShoppingCart cartModel = shoppingCartFacade.getShoppingCartModel(cartCode, store);
+            if (cartModel == null)
+                throw new ResourceNotFoundException("Cart not found");
+            if (cartModel.getCustomerId() == null || !cartModel.getCustomerId().equals(customer.getId()))
+                throw new ResourceNotFoundException("Cart not found");
+            Product product = product(sku, store, language);
+            if (!canAdd(product))
+                throw new ResponseStatusException(HttpStatus.CONFLICT, "Product is unavailable or out of stock");
+            int quantity = 1;
+            for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem line : cartModel.getLineItems())
+                if (sku.equals(line.getSku())) quantity = line.getQuantity() + 1;
+            PersistableShoppingCartItem add = new PersistableShoppingCartItem(); add.setProduct(sku); add.setQuantity(quantity);
+            ReadableShoppingCart cart = shoppingCartFacade.modifyCart(cartCode, add, store, language);
+            wishlistService.remove(customer, store, sku);
+            return ResponseEntity.ok(cart);
+        } catch (ResourceNotFoundException e) { throw e; }
+        catch (Exception e) { throw new ServiceRuntimeException("Product cannot be added to cart", e); }
+    }
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal p = request.getUserPrincipal();
+        if (p == null) throw new org.springframework.security.access.AccessDeniedException("Authentication required");
+        Customer c = customerFacade.getCustomerByUserName(p.getName(), store);
+        if (c == null) throw new ResourceNotFoundException("Customer not found");
+        return c;
+    }
+
+    private WishlistDto view(Customer customer, MerchantStore store, Language language) {
+        WishlistDto out = new WishlistDto(); List<WishlistItemDto> items = new java.util.ArrayList<>();
+        for (WishlistItem i : wishlistService.list(customer, store)) {
+            Product p = product(i.getSku(), store, language); if (p == null) continue;
+            BigDecimal price = null; try { price = pricingService.calculateProductPrice(p).getFinalPrice(); } catch (Exception ignored) { }
+            boolean available = canAdd(p);
+            String name = p.getProductDescription() == null ? null : p.getProductDescription().getName();
+            items.add(new WishlistItemDto(i.getSku(), name, price, available, i.getAddedAt()));
+        }
+        out.setItems(items); out.setCount(items.size()); return out;
+    }
+
+    private Product product(String sku, MerchantStore store, Language language) {
+        try { return productService.getBySku(sku, store, language); }
+        catch (Exception e) { throw new ServiceRuntimeException("Unable to load product " + sku, e); }
+    }
+
+    /** Mirrors ShoppingCartFacadeImpl's insertion checks. */
+    private boolean canAdd(Product p) {
+        if (p == null || !p.isAvailable() || p.getDateAvailable() == null || p.getDateAvailable().after(new Date())) return false;
+        if (p.getAvailabilities() == null || p.getAvailabilities().isEmpty()) return false;
+        for (ProductAvailability a : p.getAvailabilities())
+            if (a.getProductQuantity() == null || a.getProductQuantity() <= 0) return false;
+        return true;
+    }
+}
