+package com.salesmanager.shop.store.api.v1.wishlist;
+
+import java.util.List;
+import java.util.stream.Collectors;
+import java.util.stream.Stream;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.customer.wishlist.WishlistService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.core.model.customer.wishlist.PopularWishlistItem;
+import com.salesmanager.shop.utils.AuthorizationUtils;
+
+import io.swagger.annotations.Api;
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import io.swagger.annotations.ApiOperation;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Merchant administration endpoints for wishlist reporting. */
+@RestController
+@RequestMapping("/api/v1")
+@Api(tags = { "Wishlist management resource" })
+public class WishlistApi {
+
+    @Inject
+    private WishlistService wishlistService;
+
+    @Inject
+    private AuthorizationUtils authorizationUtils;
+
+    @GetMapping("/private/wishlists/popular")
+    @ResponseStatus(HttpStatus.OK)
+    @ApiOperation(httpMethod = "GET", value = "List the most wished products", produces = "application/json")
+    @ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT") })
+    public List<PopularWishlistItem> popular(@ApiIgnore MerchantStore merchantStore,
+            @ApiIgnore Language language) throws ServiceException {
+        String user = authorizationUtils.authenticatedUser();
+        authorizationUtils.authorizeUser(user,
+                Stream.of(Constants.GROUP_SUPERADMIN, Constants.GROUP_ADMIN, Constants.GROUP_ADMIN_RETAIL)
+                        .collect(Collectors.toList()), merchantStore);
+        return wishlistService.popular(merchantStore);
