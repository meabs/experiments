@@ -0,0 +1,132 @@
+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.security.Principal;
+import java.util.List;
+
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+import org.springframework.web.bind.annotation.ResponseStatus;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.customer.wishlist.WishlistService;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.core.model.customer.wishlist.WishlistView;
+import com.salesmanager.shop.model.customer.wishlist.ReadableWishlist;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.UnauthorizedException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Customer-scoped wishlist endpoints. */
+@RestController
+@RequestMapping("/api/v1/auth/customer/wishlist")
+public class WishlistApi {
+
+    @Inject private WishlistService wishlistService;
+    @Inject private CustomerFacade customerFacade;
+    @Inject private ShoppingCartFacade shoppingCartFacade;
+
+    public static class WishlistRequest {
+        private String product;
+        public String getProduct() { return product; }
+        public void setProduct(String product) { this.product = product; }
+    }
+
+    @PostMapping
+    public ResponseEntity<ReadableWishlist> add(@RequestBody WishlistRequest request,
+            @ApiIgnore MerchantStore store, HttpServletRequest servletRequest) {
+        Customer customer = customer(servletRequest, store);
+        if (request == null || request.getProduct() == null || request.getProduct().trim().isEmpty()) {
+            return ResponseEntity.badRequest().build();
+        }
+        try {
+            WishlistView before = wishlistService.get(customer, store);
+            boolean duplicate = before.getItems().stream().anyMatch(i -> request.getProduct().equals(i.getSku()));
+            return ResponseEntity.status(duplicate ? HttpStatus.OK : HttpStatus.CREATED)
+                    .body(readable(wishlistService.add(customer, store, request.getProduct())));
+        } catch (ServiceException e) {
+            if (e.getMessage() != null && e.getMessage().toLowerCase().contains("product not found"))
+                throw new ResourceNotFoundException(e.getMessage());
+            return ResponseEntity.badRequest().build();
+        }
+    }
+
+    @GetMapping
+    public ReadableWishlist get(@ApiIgnore MerchantStore store, HttpServletRequest request) {
+        try { return readable(wishlistService.get(customer(request, store), store)); }
+        catch (ServiceException e) { throw new RuntimeException(e); }
+    }
+
+    @DeleteMapping("/{sku}")
+    public ResponseEntity<Void> remove(@PathVariable String sku, @ApiIgnore MerchantStore store,
+            HttpServletRequest request) {
+        try { wishlistService.remove(customer(request, store), store, sku); }
+        catch (ServiceException e) { throw new ResourceNotFoundException(e.getMessage()); }
+        return ResponseEntity.noContent().build();
+    }
+
+    @PostMapping("/{sku}/cart/{cartCode}")
+    public ResponseEntity<ReadableShoppingCart> move(@PathVariable String sku, @PathVariable String cartCode,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest request) {
+        Customer customer = customer(request, store);
+        try {
+            wishlistService.validateMove(customer, store, sku);
+            ReadableShoppingCart updated = shoppingCartFacade.addToExistingCart(customer, cartCode, sku, store, language);
+            wishlistService.removeAfterMove(customer, store, sku);
+            return ResponseEntity.ok(updated);
+        } catch (ResourceNotFoundException e) { throw e;
+        } catch (ServiceException e) {
+            if (e.getMessage() != null && e.getMessage().toLowerCase().contains("unavailable"))
+                throw new WishlistConflictException(e.getMessage());
+            throw new ResourceNotFoundException(e.getMessage());
+        } catch (Exception e) {
+            String message = e.getMessage() == null ? "" : e.getMessage().toLowerCase();
+            if (message.contains("stock") || message.contains("available") || message.contains("inventory")
+                    || message.contains("quantity")) throw new WishlistConflictException(e.getMessage());
+            throw new ResourceNotFoundException(e.getMessage());
+        }
+    }
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal principal = request.getUserPrincipal();
+        if (principal == null) throw new UnauthorizedException();
+        Customer customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (customer == null) throw new UnauthorizedException();
+        return customer;
+    }
+
+    private ReadableWishlist readable(WishlistView source) {
+        ReadableWishlist result = new ReadableWishlist();
+        result.setCount(source.getCount());
+        for (WishlistView.Item sourceItem : source.getItems()) {
+            com.salesmanager.shop.model.customer.wishlist.ReadableWishlistItem item =
+                    new com.salesmanager.shop.model.customer.wishlist.ReadableWishlistItem();
+            item.setSku(sourceItem.getSku()); item.setName(sourceItem.getName());
+            item.setAvailable(sourceItem.isAvailable()); item.setAddedAt(sourceItem.getAddedAt());
+            result.getItems().add(item);
+        }
+        return result;
+    }
+
+    @ResponseStatus(HttpStatus.CONFLICT)
+    public static class WishlistConflictException extends RuntimeException {
+        private static final long serialVersionUID = 1L;
+        public WishlistConflictException(String message) { super(message); }
+    }
+}
