+package com.salesmanager.core.business.services.customer.wishlist;
+import java.util.List; import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.customer.wishlist.*; import com.salesmanager.core.model.merchant.MerchantStore;
+/** Customer wishlist operations and the store-wide popularity report. */
+public interface WishlistService {
+ /** Add SKU (idempotently), returning the resulting wishlist. */ WishlistView add(Customer customer, MerchantStore store, String sku) throws ServiceException;
+ /** Return this customer's wishlist, newest entries first. */ WishlistView get(Customer customer, MerchantStore store) throws ServiceException;
+ /** Remove SKU, failing when it is not on this customer's wishlist. */ void remove(Customer customer, MerchantStore store, String sku) throws ServiceException;
+ /** Ensure an entry exists and return it for a cart move operation. */ void validateMove(Customer customer, MerchantStore store, String sku) throws ServiceException;
+ /** Remove an entry after a successful cart move. */ void removeAfterMove(Customer customer, MerchantStore store, String sku) throws ServiceException;
+ /** Return at most ten products ordered by distinct-wishlist customer count. */ List<PopularWishlistItem> popular(MerchantStore store) throws ServiceException;
+ /** Remove all references to a deleted product. */ void removeProduct(MerchantStore store, String sku);
+}
diff --git a/sm-core/src/main/java/com/salesmanager/core/business/services/customer/wishlist/WishlistServiceImpl.java b/sm-core/src/main/java/com/salesmanager/core/business/services/customer/wishlist/WishlistServiceImpl.java
