+package com.salesmanager.core.business.services.customer.wishlist;
+import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.business.repositories.customer.wishlist.WishlistRepository; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.availability.ProductAvailability; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.customer.wishlist.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("wishlistService") public class WishlistServiceImpl implements WishlistService {
+ @Inject WishlistRepository repository; @Inject ProductService productService;
+ @Override @Transactional public WishlistView add(Customer c,MerchantStore s,String sku)throws ServiceException{product(sku,s);if(repository.findByCustomerAndMerchantStoreAndSku(c,s,sku)==null){if(repository.findByCustomerAndMerchantStoreOrderByAddedAtDesc(c,s).size()>=50)throw new ServiceException("Wishlist limit exceeded");WishlistEntry e=new WishlistEntry();e.setCustomer(c);e.setMerchantStore(s);e.setSku(sku);e.setAddedAt(new Date());repository.save(e);}return get(c,s);}
+ @Override @Transactional(readOnly=true) public WishlistView get(Customer c,MerchantStore s)throws ServiceException{WishlistView w=new WishlistView();for(WishlistEntry e:repository.findByCustomerAndMerchantStoreOrderByAddedAtDesc(c,s)){Product p;try{p=product(e.getSku(),s);}catch(ServiceException x){continue;}WishlistView.Item i=new WishlistView.Item();i.setSku(e.getSku());i.setAddedAt(e.getAddedAt());i.setName(p.getDescriptions().isEmpty()?e.getSku():p.getDescriptions().iterator().next().getName());i.setAvailable(available(p));for(ProductAvailability a:p.getAvailabilities())if(a.defaultPrice()!=null){i.setPrice(a.defaultPrice().getProductPriceAmount());break;}w.getItems().add(i);}w.setCount(w.getItems().size());return w;}
+ @Override @Transactional public void remove(Customer c,MerchantStore s,String sku)throws ServiceException{WishlistEntry e=repository.findByCustomerAndMerchantStoreAndSku(c,s,sku);if(e==null)throw new ServiceException("Wishlist item not found");repository.delete(e);}
+ @Override @Transactional(readOnly=true) public void validateMove(Customer c,MerchantStore s,String sku)throws ServiceException{if(repository.findByCustomerAndMerchantStoreAndSku(c,s,sku)==null)throw new ServiceException("Wishlist item not found");if(!available(product(sku,s)))throw new ServiceException("Wishlist product unavailable");}
+ @Override public void removeAfterMove(Customer c,MerchantStore s,String sku)throws ServiceException{remove(c,s,sku);}
+ @Override @Transactional(readOnly=true) public List<PopularWishlistItem> popular(MerchantStore s){Map<String,Long> m=new HashMap<>();for(WishlistEntry e:repository.findAll())if(Objects.equals(e.getMerchantStore().getId(),s.getId()))m.put(e.getSku(),m.getOrDefault(e.getSku(),0L)+1);List<String> k=new ArrayList<>(m.keySet());k.sort((a,b)->{int x=Long.compare(m.get(b),m.get(a));return x!=0?x:a.compareTo(b);});List<PopularWishlistItem> out=new ArrayList<>();for(String x:k){if(out.size()==10)break;out.add(new PopularWishlistItem(x,m.get(x)));}return out;}
+ @Override public void removeProduct(MerchantStore s,String sku){repository.deleteByMerchantStoreAndSku(s,sku);} private Product product(String sku,MerchantStore s)throws ServiceException{Product p=productService.getBySku(sku,s);if(p==null)throw new ServiceException("Product not found");return p;} private boolean available(Product p){if(!p.isAvailable())return false;for(ProductAvailability a:p.getAvailabilities())if(Boolean.TRUE.equals(a.getAvailable())&&a.getProductQuantity()!=null&&a.getProductQuantity()>0)return true;return false;}
+}
