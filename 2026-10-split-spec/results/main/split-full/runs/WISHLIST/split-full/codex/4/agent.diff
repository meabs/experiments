+package com.salesmanager.core.business.services.wishlist;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.wishlist.WishlistRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.wishlist.*;
+
+@Service("wishlistService")
+public class WishlistServiceImpl implements WishlistService {
+    private static final int MAX_ITEMS = 50;
+    private final WishlistRepository repository;
+    @Inject public WishlistServiceImpl(WishlistRepository repository) { this.repository = repository; }
+
+    @Override @Transactional
+    public boolean add(Customer customer, Product product) throws ServiceException {
+        if (customer == null || product == null) throw new ServiceException("Customer and product are required");
+        if (repository.findByCustomerAndProduct(customer, product) != null) return false;
+        if (repository.findByCustomerOrderByAddedAtDesc(customer).size() >= MAX_ITEMS)
+            throw new ServiceException("Wishlist cannot contain more than 50 products");
+        WishlistItem row = new WishlistItem(); row.setCustomer(customer); row.setProduct(product);
+        repository.saveAndFlush(row); return true;
+    }
+
+    @Override @Transactional(readOnly = true)
+    public WishlistDto find(Customer customer) {
+        List<WishlistItemDto> items = new ArrayList<WishlistItemDto>();
+        if (customer != null) for (WishlistItem row : repository.findByCustomerOrderByAddedAtDesc(customer)) items.add(toDto(row));
+        WishlistDto result = new WishlistDto(); result.setItems(items); result.setCount(items.size()); return result;
+    }
+    @Override @Transactional(readOnly = true) public WishlistItem findItem(Customer c, Product p) { return repository.findByCustomerAndProduct(c, p); }
+    @Override @Transactional(readOnly = true) public WishlistItem findItem(Customer c, String sku) {
+        if (c == null || sku == null) return null;
+        for (WishlistItem row : repository.findByCustomerOrderByAddedAtDesc(c)) if (sku.equals(row.getProduct().getSku())) return row;
+        return null;
+    }
+    @Override @Transactional public void remove(Customer c, Product p) throws ServiceException { WishlistItem row = findItem(c,p); if (row == null) throw new ServiceException("Wishlist item not found"); repository.delete(row); }
+    @Override @Transactional public void remove(Customer c, String sku) throws ServiceException { WishlistItem row = findItem(c,sku); if (row == null) throw new ServiceException("Wishlist item not found"); repository.delete(row); }
+    @Override @Transactional public void deleteByProduct(Product product) { if (product != null) repository.deleteByProduct(product); }
+    @Override @Transactional(readOnly = true) public List<PopularWishlistProduct> popular(MerchantStore store) {
+        List<PopularWishlistProduct> result = new ArrayList<PopularWishlistProduct>(); int limit = 0;
+        for (Object[] row : repository.findPopular(store)) { if (limit++ == 10) break; result.add(new PopularWishlistProduct((String)row[0], ((Number)row[1]).longValue())); }
+        return result;
+    }
+    private WishlistItemDto toDto(WishlistItem row) {
+        Product p = row.getProduct(); BigDecimal price = null; boolean available = p.isAvailable(); long stock = 0;
+        for (ProductAvailability a : p.getAvailabilities()) { if (a.getProductQuantity() != null) stock += a.getProductQuantity(); ProductPrice pp = a.defaultPrice(); if (price == null && pp != null) price = pp.getProductPriceAmount(); }
+        String name = p.getProductDescription() == null ? null : p.getProductDescription().getName();
+        return new WishlistItemDto(p.getSku(), name, price, available && stock > 0, row.getAddedAt());
+    }
+}
