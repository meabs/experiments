@@ -0,0 +1,76 @@
+package com.salesmanager.shop.store.controller.wishlist;
+
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.shoppingcart.ShoppingCartService;
+import com.salesmanager.core.business.services.wishlist.WishlistService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.core.model.shoppingcart.ShoppingCart;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+import com.salesmanager.core.model.wishlist.WishlistDto;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+
+@Service
+public class WishlistFacadeImpl implements WishlistFacade {
+    private final WishlistService wishlistService;
+    private final ProductService productService;
+    private final ShoppingCartService shoppingCartService;
+    private final ShoppingCartFacade shoppingCartFacade;
+
+    @Inject
+    public WishlistFacadeImpl(WishlistService wishlistService, ProductService productService,
+            ShoppingCartService shoppingCartService, ShoppingCartFacade shoppingCartFacade) {
+        this.wishlistService = wishlistService; this.productService = productService;
+        this.shoppingCartService = shoppingCartService; this.shoppingCartFacade = shoppingCartFacade;
+    }
+
+    private Product product(String sku, MerchantStore store) {
+        if (sku == null || sku.trim().isEmpty()) throw new RestApiException("400", "Product is required");
+        try {
+            Product p = productService.getBySku(sku, store);
+            if (p == null) throw new ResourceNotFoundException("Product [" + sku + "] not found");
+            return p;
+        } catch (ResourceNotFoundException e) { throw e; }
+        catch (Exception e) { throw new ResourceNotFoundException("Product [" + sku + "] not found"); }
+    }
+
+    @Override public boolean add(Customer customer, String sku, MerchantStore store, Language language) {
+        Product p = product(sku, store);
+        try { return wishlistService.add(customer, p); }
+        catch (ServiceException e) {
+            if (e.getMessage() != null && e.getMessage().contains("50")) throw new RestApiException("400", e.getMessage());
+            throw new RestApiException(e);
+        }
+    }
+    @Override public WishlistDto get(Customer customer) { return wishlistService.find(customer); }
+    @Override public void remove(Customer customer, String sku) {
+        try { wishlistService.remove(customer, sku); }
+        catch (ServiceException e) { throw new ResourceNotFoundException("Wishlist item [" + sku + "] not found"); }
+    }
+    @Override public ReadableShoppingCart move(Customer customer, String sku, String cartCode, MerchantStore store, Language language) throws Exception {
+        Product p = product(sku, store);
+        if (wishlistService.findItem(customer, p) == null) throw new ResourceNotFoundException("Wishlist item [" + sku + "] not found");
+        ShoppingCart cart = shoppingCartService.getByCode(cartCode, store);
+        if (cart == null) throw new ResourceNotFoundException("Cart [" + cartCode + "] not found");
+        long stock = 0;
+        if (p.getAvailabilities() != null) for (com.salesmanager.core.model.catalog.product.availability.ProductAvailability a : p.getAvailabilities())
+            if (a.getProductQuantity() != null) stock += a.getProductQuantity();
+        if (!p.isAvailable() || stock <= 0) throw new WishlistConflictException("Product is not available");
+        int quantity = 1;
+        if (cart.getLineItems() != null) for (ShoppingCartItem item : cart.getLineItems())
+            if (item.getProduct() != null && p.getId().equals(item.getProduct().getId())) quantity += item.getQuantity();
+        PersistableShoppingCartItem item = new PersistableShoppingCartItem(); item.setProduct(sku); item.setQuantity(quantity);
+        ReadableShoppingCart result = shoppingCartFacade.modifyCart(cartCode, item, store, language);
+        wishlistService.remove(customer, p);
+        return result;
+    }
+}
