+import com.salesmanager.shop.model.wishlist.ReadablePopularWishlistProduct;
+
+@Component
+public class ReadablePopularWishlistProductMapper {
+    public List<ReadablePopularWishlistProduct> convert(List<PopularWishlistProduct> products) {
+        List<ReadablePopularWishlistProduct> result = new ArrayList<ReadablePopularWishlistProduct>();
+        if (products != null) {
