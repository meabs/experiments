+/** Merchant-only wishlist reporting endpoints. */
+@RestController
+@RequestMapping("/api/v1")
+public class WishlistAdminApi {
+
+    @Inject
+    private WishlistAdminFacade wishlistAdminFacade;
+
+    @Inject
+    private UserFacade userFacade;
+
+    @GetMapping(value = "/private/wishlists/popular", produces = MediaType.APPLICATION_JSON_VALUE)
