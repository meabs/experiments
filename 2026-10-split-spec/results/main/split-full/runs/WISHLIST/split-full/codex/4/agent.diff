+package com.salesmanager.shop.store.api.v1.wishlist;
+
+import java.security.Principal;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.core.model.wishlist.WishlistDto;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.model.wishlist.PersistableWishlistItem;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.wishlist.WishlistFacade;
+import com.salesmanager.shop.store.controller.wishlist.WishlistConflictException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/auth/customer/wishlist")
+public class WishlistApi {
+    @Inject private WishlistFacade wishlistFacade;
+    @Inject private CustomerFacade customerFacade;
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal principal = request.getUserPrincipal();
+        if (principal == null) throw new ResourceNotFoundException("Customer not authenticated");
+        Customer c = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (c == null) throw new ResourceNotFoundException("Customer not found");
+        return c;
+    }
+    @PostMapping
+    public ResponseEntity<WishlistDto> add(@RequestBody(required=false) PersistableWishlistItem request,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest http) {
+        String sku = request == null ? null : request.getProduct();
+        boolean created = wishlistFacade.add(customer(http, store), sku, store, language);
+        return ResponseEntity.status(created ? HttpStatus.CREATED : HttpStatus.OK).body(wishlistFacade.get(customer(http, store)));
+    }
+    @GetMapping public WishlistDto get(@ApiIgnore MerchantStore store, HttpServletRequest http) { return wishlistFacade.get(customer(http, store)); }
+    @DeleteMapping("/{sku}") public ResponseEntity<Void> remove(@PathVariable String sku, @ApiIgnore MerchantStore store, HttpServletRequest http) {
+        wishlistFacade.remove(customer(http, store), sku); return ResponseEntity.noContent().build();
+    }
+    @PostMapping("/{sku}/cart/{cartCode}") public ReadableShoppingCart move(@PathVariable String sku, @PathVariable String cartCode,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest http) throws Exception {
+        return wishlistFacade.move(customer(http, store), sku, cartCode, store, language);
+    }
+
+    /** Keep this endpoint's conflict status independent of the legacy global error handler. */
+    @ExceptionHandler(WishlistConflictException.class)
+    public ResponseEntity<Void> handleConflict(WishlistConflictException exception) {
+        return ResponseEntity.status(HttpStatus.CONFLICT).build();
+    }
+}
