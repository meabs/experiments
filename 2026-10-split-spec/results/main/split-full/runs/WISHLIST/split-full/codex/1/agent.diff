+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.security.Principal;
+import java.time.Instant;
+import java.util.Date;
+import java.util.ArrayList;
+import java.util.List;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+import org.springframework.web.server.ResponseStatusException;
+
+import com.salesmanager.core.business.services.wishlist.WishlistService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.core.model.wishlist.WishlistEntry;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.model.wishlist.PersistableWishlist;
+import com.salesmanager.shop.model.wishlist.Wishlist;
+import com.salesmanager.shop.model.wishlist.WishlistItem;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+
+/** Customer wishlist endpoints. */
+@RestController
+@RequestMapping("/api/v1/auth/customer/wishlist")
+public class WishlistApi {
+    @Inject private WishlistService wishlistService;
+    @Inject private CustomerFacade customerFacade;
+    @Inject private ShoppingCartFacade shoppingCartFacade;
+
+    @GetMapping
+    public Wishlist get(MerchantStore store, Language language, HttpServletRequest request) {
+        Customer customer = customer(request, store);
+        return toDto(wishlistService.getWishlist(customer, store), store, language);
+    }
+
+    @PostMapping
+    public ResponseEntity<Wishlist> add(MerchantStore store, Language language,
+            @RequestBody PersistableWishlist body, HttpServletRequest request) {
+        if (body == null || body.getProduct() == null || body.getProduct().trim().isEmpty())
+            throw new ResponseStatusException(HttpStatus.BAD_REQUEST, "product is required");
+        Customer customer = customer(request, store);
+        boolean existing = wishlistService.findEntry(customer, store, body.getProduct()) != null;
+        try {
+            wishlistService.add(customer, store, body.getProduct());
+        } catch (Exception e) {
+            String message = e.getMessage() == null ? "" : e.getMessage();
+            HttpStatus status = message.contains("50 products") ? HttpStatus.BAD_REQUEST : HttpStatus.NOT_FOUND;
+            throw new ResponseStatusException(status, message, e);
+        }
+        return ResponseEntity.status(existing ? HttpStatus.OK : HttpStatus.CREATED)
+                .body(toDto(wishlistService.getWishlist(customer, store), store, language));
+    }
+
+    @DeleteMapping("/{sku}")
+    public ResponseEntity<Void> remove(@PathVariable String sku, MerchantStore store,
+            HttpServletRequest request) {
+        Customer customer = customer(request, store);
+        if (wishlistService.findEntry(customer, store, sku) == null)
+            throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Product is not on wishlist");
+        try { wishlistService.remove(customer, store, sku); }
+        catch (Exception e) { throw new ResponseStatusException(HttpStatus.NOT_FOUND, e.getMessage(), e); }
+        return ResponseEntity.noContent().build();
+    }
+
+    @PostMapping("/{sku}/cart/{cartCode}")
+    public ReadableShoppingCart move(@PathVariable String sku, @PathVariable String cartCode,
+            MerchantStore store, Language language, HttpServletRequest request) {
+        Customer customer = customer(request, store);
+        WishlistEntry entry = wishlistService.findEntry(customer, store, sku);
+        if (entry == null) throw new ResponseStatusException(HttpStatus.NOT_FOUND, "Product is not on wishlist");
+        if (!available(entry.getProduct())) throw new ResponseStatusException(HttpStatus.CONFLICT, "Product is unavailable");
+        try {
+            ReadableShoppingCart cart = shoppingCartFacade.addOneToCart(cartCode, sku, store, language);
+            wishlistService.remove(customer, store, sku);
+            return cart;
+        } catch (Exception e) {
+            // The cart facade reports a missing cart as ResourceNotFoundException;
+            // all product/stock failures are conflicts and occur before mutation.
+            if (e instanceof com.salesmanager.shop.store.api.exception.ResourceNotFoundException)
+                throw new ResponseStatusException(HttpStatus.NOT_FOUND, e.getMessage(), e);
+            throw new ResponseStatusException(HttpStatus.CONFLICT, e.getMessage(), e);
+        }
+    }
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal principal = request.getUserPrincipal();
+        if (principal == null) throw new ResponseStatusException(HttpStatus.UNAUTHORIZED, "Authentication required");
+        Customer customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (customer == null) throw new ResponseStatusException(HttpStatus.UNAUTHORIZED, "Customer not found");
+        return customer;
+    }
+
+    private boolean available(Product product) {
+        if (product == null || !product.isAvailable()) return false;
+        for (ProductAvailability availability : product.getAvailabilities())
+            if (Boolean.TRUE.equals(availability.getAvailable()) && availability.getProductQuantity() != null
+                    && availability.getProductQuantity() > 0) return true;
+        return false;
+    }
+
+    private Wishlist toDto(List<WishlistEntry> entries, MerchantStore store, Language language) {
+        Wishlist result = new Wishlist();
+        List<WishlistItem> items = new ArrayList<WishlistItem>();
+        for (WishlistEntry entry : entries) {
+            Product product = entry.getProduct();
+            WishlistItem item = new WishlistItem();
+            item.setSku(product.getSku());
+            if (product.getDescriptions() != null && !product.getDescriptions().isEmpty()) {
+                String name = null;
+                for (com.salesmanager.core.model.catalog.product.description.ProductDescription description : product.getDescriptions()) {
+                    Language descriptionLanguage = description.getLanguage();
+                    if (language != null && descriptionLanguage != null
+                            && ((language.getId() != null && language.getId().equals(descriptionLanguage.getId()))
+                                || (language.getCode() != null && language.getCode().equalsIgnoreCase(descriptionLanguage.getCode())))) {
+                        name = description.getName();
+                        break;
+                    }
+                }
+                if (name == null) name = product.getDescriptions().iterator().next().getName();
+                item.setName(name);
+            }
+            item.setPrice(currentPrice(product, store));
+            item.setAvailable(available(product));
+            item.setAddedAt(entry.getAddedAt() == null ? null : entry.getAddedAt().toInstant());
+            items.add(item);
+        }
+        result.setItems(items);
+        return result;
+    }
+
+    private java.math.BigDecimal currentPrice(Product product, MerchantStore store) {
+        for (ProductAvailability availability : product.getAvailabilities()) {
+            if (store != null && availability.getMerchantStore() != null && store.getId() != null
+                    && !store.getId().equals(availability.getMerchantStore().getId())) continue;
+            com.salesmanager.core.model.catalog.product.price.ProductPrice price = availability.defaultPrice();
+            if (price == null || price.getProductPriceAmount() == null) continue;
+            Date now = new Date();
+            Date start = price.getProductPriceSpecialStartDate();
+            Date end = price.getProductPriceSpecialEndDate();
+            if (price.getProductPriceSpecialAmount() != null
+                    && (start == null || !now.before(start)) && (end == null || !now.after(end)))
+                return price.getProductPriceSpecialAmount();
+            return price.getProductPriceAmount();
+        }
+        return null;
+    }
+}
