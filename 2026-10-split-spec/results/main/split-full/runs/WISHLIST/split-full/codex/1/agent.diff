+			throws Exception {
+		Validate.notBlank(cartCode, "Shopping cart code must not be blank");
+		Validate.notBlank(sku, "Product sku must not be blank");
+		ShoppingCart cart = getCartModel(cartCode, store);
+		if (cart == null) {
+			throw new ResourceNotFoundException("Cart code [" + cartCode + "] not found");
+		}
+
+		// Build the item first: this performs the same product availability and stock
+		// checks as all other cart entry points, before mutating the cart.
+		PersistableShoppingCartItem requested = new PersistableShoppingCartItem();
+		requested.setProduct(sku);
+		requested.setQuantity(1);
+		com.salesmanager.core.model.shoppingcart.ShoppingCartItem newItem = createCartItem(cart, requested, store);
+		Set<com.salesmanager.core.model.shoppingcart.ShoppingCartItem> items = cart.getLineItems();
+		if (items == null) {
+			items = new HashSet<>();
+			cart.setLineItems(items);
+		}
+		boolean found = false;
+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem existing : items) {
+			if (sku.equals(existing.getSku()) || (existing.getProduct() != null && sku.equals(existing.getProduct().getSku()))) {
+				existing.setQuantity(existing.getQuantity() + 1);
+				found = true;
+				break;
+			}
+		}
+		if (!found) {
+			items.add(newItem);
+		}
+		shoppingCartService.saveOrUpdate(cart);
+		ShoppingCart refreshed = shoppingCartService.getById(cart.getId(), store);
+		shoppingCartCalculationService.calculate(refreshed, store, language);
+		return readableShoppingCartMapper.convert(refreshed, store, language);
+	}
