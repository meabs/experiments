+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class WishlistAdminApi {
+    @Inject private WishlistService wishlistService;
+
+    @GetMapping("/private/wishlists/popular")
+    public List<PopularWishlistProduct> popular(@ApiIgnore MerchantStore merchantStore,
+                                                 @ApiIgnore Language language) {
+        return wishlistService.popular(merchantStore).stream()
+                .map(p -> new PopularWishlistProduct(p.getSku(), p.getCount()))
+                .collect(Collectors.toList());
+    }
+}
