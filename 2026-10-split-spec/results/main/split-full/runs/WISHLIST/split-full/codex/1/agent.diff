+package com.salesmanager.core.business.services.wishlist;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.wishlist.WishlistRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.wishlist.WishlistEntry;
+import com.salesmanager.core.model.wishlist.WishlistPopular;
+
+@Service("wishlistService")
+public class WishlistServiceImpl extends SalesManagerEntityServiceImpl<Long, WishlistEntry> implements WishlistService {
+    private static final int MAX_ITEMS = 50;
+    private final WishlistRepository repository;
+    @Inject private ProductService productService;
+    @Inject public WishlistServiceImpl(WishlistRepository repository) { super(repository); this.repository = repository; }
+    @Override public List<WishlistEntry> getWishlist(Customer customer, MerchantStore store) {
+        return repository.findByCustomerIdAndMerchantStoreIdOrderByAddedAtDesc(customer.getId(), store.getId());
+    }
+    @Override public WishlistEntry findEntry(Customer customer, MerchantStore store, String sku) {
+        return repository.findByCustomerIdAndMerchantStoreIdAndProductSku(customer.getId(), store.getId(), sku);
+    }
+    @Override public WishlistEntry add(Customer customer, MerchantStore store, String sku) throws ServiceException {
+        if (sku == null || sku.trim().isEmpty()) throw new ServiceException("Product SKU is required");
+        WishlistEntry existing = findEntry(customer, store, sku);
+        if (existing != null) return existing;
+        // Resolve the SKU before applying capacity: an unknown product is a 404,
+        // even when this customer's wishlist is already full.
+        Product product = productService.getBySku(sku, store);
+        if (product == null) throw new ServiceException("Unknown product " + sku);
+        if (repository.countByCustomerIdAndMerchantStoreId(customer.getId(), store.getId()) >= MAX_ITEMS)
+            throw new ServiceException("Wishlist cannot contain more than 50 products");
+        WishlistEntry entry = new WishlistEntry(); entry.setCustomer(customer); entry.setMerchantStore(store); entry.setProduct(product);
+        return repository.saveAndFlush(entry);
+    }
+    @Override public void remove(Customer customer, MerchantStore store, String sku) throws ServiceException {
+        WishlistEntry entry = findEntry(customer, store, sku);
+        if (entry == null) throw new ServiceException("Product is not on wishlist");
+        repository.delete(entry);
+    }
+    @Override public List<WishlistPopular> popular(MerchantStore store) {
+        List<WishlistPopular> result = repository.popular(store.getId());
+        return result.size() > 10 ? result.subList(0, 10) : result;
+    }
+    @Override @Transactional public int deleteByProduct(Long productId) { return repository.deleteByProductId(productId); }
+    /** Availability check used by the cart adapter before it mutates either side. */
+    public boolean isAvailable(WishlistEntry entry) {
+        if (entry == null || entry.getProduct() == null || !entry.getProduct().isAvailable()) return false;
+        for (ProductAvailability a : entry.getProduct().getAvailabilities())
+            if (Boolean.TRUE.equals(a.getAvailable()) && a.getProductQuantity() != null && a.getProductQuantity() > 0) return true;
+        return false;
+    }
+}
