@@ -0,0 +1,71 @@
+package com.salesmanager.core.business.services.customer.wishlist;
+
+import java.math.BigDecimal;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.wishlist.WishlistRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.availability.ProductAvailabilityService;
+import com.salesmanager.core.business.services.shoppingcart.ShoppingCartService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.price.ProductPrice;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.wishlist.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.shoppingcart.*;
+
+@Service("wishlistService")
+public class WishlistServiceImpl implements WishlistService {
+    private static final int MAX_ITEMS = 50;
+    @Inject private WishlistRepository repository;
+    @Inject private ProductService productService;
+    @Inject private ProductAvailabilityService availabilityService;
+    @Inject private ShoppingCartService shoppingCartService;
+
+    private void check(Customer customer, MerchantStore store) {
+        if (customer == null || customer.getId() == null || store == null || store.getId() == null) throw new IllegalArgumentException("Customer and store are required");
+    }
+    @Override public Wishlist getWishlist(Customer customer, MerchantStore store) throws ServiceException {
+        check(customer, store); List<WishlistItem> result = new ArrayList<>();
+        for (CustomerWishlistEntry entry : repository.findByCustomerIdAndMerchantIdOrderByAddedAtDesc(customer.getId(), store.getId())) {
+            Product p = productService.getBySku(entry.getSku(), store);
+            if (p != null) result.add(item(p, entry.getAddedAt(), store));
+        }
+        return new Wishlist(result);
+    }
+    @Override @Transactional public Wishlist add(Customer customer, MerchantStore store, String sku) throws ServiceException {
+        check(customer, store); if (sku == null || sku.trim().isEmpty()) throw new IllegalArgumentException("Product is required");
+        Product product = productService.getBySku(sku, store);
+        if (product == null) throw new WishlistException(404, "Unknown product");
+        if (repository.findByCustomerIdAndMerchantIdAndSku(customer.getId(), store.getId(), sku) != null) return getWishlist(customer, store);
+        if (repository.findByCustomerIdAndMerchantIdOrderByAddedAtDesc(customer.getId(), store.getId()).size() >= MAX_ITEMS) throw new WishlistException(400, "Wishlist limit reached");
+        CustomerWishlistEntry entry = new CustomerWishlistEntry(); entry.setCustomerId(customer.getId()); entry.setMerchantId(store.getId()); entry.setSku(product.getSku()); entry.setAddedAt(new Date()); repository.save(entry);
+        return getWishlist(customer, store);
+    }
+    @Override @Transactional public void remove(Customer customer, MerchantStore store, String sku) throws ServiceException {
+        check(customer, store); if (repository.findByCustomerIdAndMerchantIdAndSku(customer.getId(), store.getId(), sku) == null) throw new WishlistException(404, "Wishlist product not found");
+        repository.deleteByCustomerIdAndMerchantIdAndSku(customer.getId(), store.getId(), sku);
+    }
+    @Override @Transactional public ShoppingCart moveToCart(Customer customer, MerchantStore store, String sku, String cartCode) throws ServiceException {
+        check(customer, store); CustomerWishlistEntry entry = repository.findByCustomerIdAndMerchantIdAndSku(customer.getId(), store.getId(), sku);
+        if (entry == null) throw new WishlistException(404, "Wishlist product not found");
+        Product product = productService.getBySku(sku, store); if (product == null) throw new WishlistException(404, "Product not found");
+        if (!product.isAvailable() || !hasStock(sku, store)) throw new WishlistException(409, "Product is unavailable");
+        ShoppingCart cart = shoppingCartService.getByCode(cartCode, store); if (cart == null) throw new WishlistException(404, "Cart not found");
+        ShoppingCartItem existing = null; for (ShoppingCartItem i : cart.getLineItems()) if (sku.equals(i.getSku())) { existing = i; break; }
+        if (existing != null) existing.setQuantity(existing.getQuantity() + 1);
+        else { ShoppingCartItem item = shoppingCartService.populateShoppingCartItem(product, store); item.setQuantity(1); item.setShoppingCart(cart); cart.getLineItems().add(item); }
+        shoppingCartService.saveOrUpdate(cart); repository.delete(entry); return cart;
+    }
+    private boolean hasStock(String sku, MerchantStore store) { for (ProductAvailability a : availabilityService.getBySku(sku, store)) if (Boolean.TRUE.equals(a.getAvailable()) && a.getProductQuantity() != null && a.getProductQuantity() > 0) return true; return false; }
+    private WishlistItem item(Product p, Date addedAt, MerchantStore store) {
+        BigDecimal price = null; boolean stock = false; for (ProductAvailability a : availabilityService.getBySku(p.getSku(), store)) { ProductPrice pp = a.defaultPrice(); if (pp != null) price = pp.getProductPriceAmount(); if (Boolean.TRUE.equals(a.getAvailable()) && a.getProductQuantity() != null && a.getProductQuantity() > 0) stock = true; }
+        String name = p.getProductDescription() == null ? p.getSku() : p.getProductDescription().getName(); return new WishlistItem(p.getSku(), name, price, p.isAvailable() && stock, addedAt);
+    }
+    @Override public List<PopularWishlistItem> popular(MerchantStore store) { List<PopularWishlistItem> result = new ArrayList<>(); if (store == null || store.getId() == null) return result; for (Object[] row : repository.popular(store.getId())) { result.add(new PopularWishlistItem(String.valueOf(row[0]), ((Number) row[1]).longValue())); if (result.size() == 10) break; } return result; }
+    @Override @Transactional public void removeProduct(MerchantStore store, String sku) { if (store != null && store.getId() != null && sku != null) repository.deleteByMerchantIdAndSku(store.getId(), sku); }
+}
