+package com.salesmanager.shop.store.api.v1.wishlist;
+
+import com.salesmanager.core.business.services.customer.wishlist.WishlistService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.customer.wishlist.PopularWishlistItem;
+import io.swagger.annotations.Api;
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import io.swagger.annotations.ApiOperation;
+import org.springframework.http.MediaType;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+import springfox.documentation.annotations.ApiIgnore;
+
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/** Administrative wishlist reporting endpoints. */
+@RestController
+@RequestMapping(value = "/api/v1")
+@Api(tags = {"Wishlist administration api"})
+public class WishlistAdministrationApi {
+
+    private final WishlistService wishlistService;
+
+    public WishlistAdministrationApi(WishlistService wishlistService) {
+        this.wishlistService = wishlistService;
+    }
+
+    /**
+     * Returns the products most frequently saved by customers of the store.
+     * The service owns the aggregation, ordering, and ten-item cap; this
+     * endpoint deliberately only shapes the report's public representation.
+     */
+    @GetMapping(value = "/private/wishlists/popular", produces = MediaType.APPLICATION_JSON_VALUE)
+    @ApiOperation(httpMethod = "GET", value = "Get popular wishlist products", response = List.class)
+    @ApiImplicitParams({
+            @ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT")
+    })
+    public List<Map<String, Object>> popular(@ApiIgnore MerchantStore merchantStore) {
+        List<PopularWishlistItem> report = wishlistService.popular(merchantStore);
+        List<Map<String, Object>> result = new ArrayList<>(report == null ? 0 : report.size());
+        if (report == null) {
+            return result;
+        }
+        for (PopularWishlistItem row : report) {
+            Map<String, Object> item = new LinkedHashMap<>();
+            item.put("sku", row.getSku());
+            item.put("count", row.getCount());
+            result.add(item);
+        }
+        return result;
+    }
+}
