+@RequestMapping("/api/v1/auth/customer/wishlist")
+public class WishlistApi {
+    @Inject private WishlistService wishlistService;
+    @Inject private CustomerFacade customerFacade;
+    @Inject private ShoppingCartFacade shoppingCartFacade;
+    private final ReadableWishlistPopulator populator = new ReadableWishlistPopulator();
+
+    @PostMapping
+    public ResponseEntity<ReadableWishlist> add(@RequestBody(required = false) PersistableWishlistItem request,
+            @ApiIgnore MerchantStore store, HttpServletRequest servletRequest) {
+        Customer customer = customer(servletRequest, store);
+        if (request == null || request.getProduct() == null || request.getProduct().trim().isEmpty())
+            throw error(400, "Product is required");
+        try {
+            Wishlist before = wishlistService.getWishlist(customer, store);
+            boolean duplicate = before.getItems().stream().anyMatch(i -> request.getProduct().equals(i.getSku()));
+            Wishlist result = wishlistService.add(customer, store, request.getProduct());
+            return new ResponseEntity<>(populator.populate(result), duplicate ? HttpStatus.OK : HttpStatus.CREATED);
+        } catch (WishlistException e) { throw error(e); }
+        catch (Exception e) { throw new ServiceRuntimeException(e); }
+    }
+
+    @GetMapping
+    public ReadableWishlist get(@ApiIgnore MerchantStore store, HttpServletRequest servletRequest) {
+        try { return populator.populate(wishlistService.getWishlist(customer(servletRequest, store), store)); }
+        catch (WishlistException e) { throw error(e); }
+        catch (Exception e) { throw new ServiceRuntimeException(e); }
+    }
+
+    @DeleteMapping("/{sku}")
+    public ResponseEntity<Void> remove(@PathVariable String sku, @ApiIgnore MerchantStore store,
+            HttpServletRequest servletRequest) {
+        try { wishlistService.remove(customer(servletRequest, store), store, sku); return ResponseEntity.noContent().build(); }
+        catch (WishlistException e) { throw error(e); }
+        catch (Exception e) { throw new ServiceRuntimeException(e); }
+    }
+
+    @PostMapping("/{sku}/cart/{cartCode}")
+    public ResponseEntity<ReadableShoppingCart> move(@PathVariable String sku, @PathVariable String cartCode,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest servletRequest) {
+        try {
+            ShoppingCart cart = wishlistService.moveToCart(customer(servletRequest, store), store, sku, cartCode);
+            return ResponseEntity.ok(shoppingCartFacade.readableCart(cart, store, language));
+        } catch (WishlistException e) { throw error(e); }
+        catch (Exception e) { throw new ServiceRuntimeException(e); }
+    }
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal principal = request.getUserPrincipal();
+        if (principal == null) throw new ServiceRuntimeException("401", "Customer authentication required");
+        Customer customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (customer == null) throw new ResourceNotFoundException("Customer not found");
+        return customer;
+    }
+
+    private ServiceRuntimeException error(int status, String message) {
+        return new ServiceRuntimeException(String.valueOf(status), message,
+                new WishlistException(status, message));
+    }
+
+    private ServiceRuntimeException error(WishlistException exception) {
+        return new ServiceRuntimeException(String.valueOf(exception.getStatus()), exception.getMessage(), exception);
+    }
+}
