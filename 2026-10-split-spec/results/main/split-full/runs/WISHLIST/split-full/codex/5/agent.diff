+
+@Entity
+@Table(name = "CUSTOMER_WISHLIST", uniqueConstraints = @UniqueConstraint(columnNames = {"CUSTOMER_ID", "MERCHANT_ID", "SKU"}), indexes = @Index(name = "WISHLIST_PRODUCT_IDX", columnList = "MERCHANT_ID,SKU"))
+public class CustomerWishlistEntry {
+    @Id @GeneratedValue(strategy = GenerationType.TABLE, generator = "wishlist_gen")
+    @TableGenerator(name = "wishlist_gen", table = "SM_SEQUENCER", pkColumnName = "SEQ_NAME", valueColumnName = "SEQ_COUNT", pkColumnValue = "CUSTOMER_WISHLIST_SEQ")
