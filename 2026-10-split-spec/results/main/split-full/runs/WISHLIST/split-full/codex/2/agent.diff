+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.wishlist.WishlistService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.wishlist.WishlistPopular;
+import com.salesmanager.shop.model.wishlist.PopularWishlistItem;
+
+import io.swagger.annotations.Api;
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Merchant report endpoints for wishlist activity. */
+@RestController
+@RequestMapping("/api/v1")
+@Api(tags = { "Wishlist administration resource" })
+public class WishlistAdminApi {
+
+    @Inject
+    private WishlistService wishlistService;
+
+    @GetMapping("/private/wishlists/popular")
+    @ApiImplicitParams({
+            @ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT"),
+            @ApiImplicitParam(name = "lang", dataType = "string", defaultValue = "en") })
+    public List<PopularWishlistItem> popular(@ApiIgnore MerchantStore merchantStore) {
+        List<WishlistPopular> aggregated = wishlistService.popular(merchantStore);
+        List<PopularWishlistItem> result = new ArrayList<PopularWishlistItem>();
+        if (aggregated != null) {
+            for (WishlistPopular entry : aggregated) {
+                if (entry != null && entry.getSku() != null) {
+                    result.add(new PopularWishlistItem(entry.getSku(), entry.getCount()));
+                }
+            }
+        }
+        Collections.sort(result, Comparator.comparingLong(PopularWishlistItem::getCount).reversed()
+                .thenComparing(PopularWishlistItem::getSku));
+        return result.size() > 10 ? new ArrayList<PopularWishlistItem>(result.subList(0, 10)) : result;
+    }
+
+}
