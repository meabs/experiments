+++ b/sm-core/src/main/java/com/salesmanager/core/business/services/wishlist/WishlistServiceImpl.java
@@ -0,0 +1,59 @@
+package com.salesmanager.core.business.services.wishlist;
+
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.wishlist.WishlistRepository;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.catalog.product.variant.ProductVariant;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.wishlist.*;
+
+@Service("wishlistService")
+public class WishlistServiceImpl implements WishlistService {
+    private final WishlistRepository repository;
+    @Inject public WishlistServiceImpl(WishlistRepository repository) { this.repository=repository; }
+    private Integer storeId(MerchantStore s) { return s.getId(); }
+    @Transactional
+    public WishlistItem add(Customer c, MerchantStore s, Product p) throws ServiceException {
+        WishlistItem old=get(c,s,p); if(old!=null) return old;
+        if(repository.countByCustomerIdAndMerchantStoreId(c.getId(),storeId(s))>=50) throw new ServiceException("Wishlist limit reached");
+        WishlistItem item=new WishlistItem(); item.setCustomer(c); item.setMerchantStore(s); item.setProduct(p); item.setAddedAt(new Date()); return repository.saveAndFlush(item);
+    }
+    public List<WishlistItem> list(Customer c, MerchantStore s) { return repository.findByCustomerIdAndMerchantStoreIdOrderByAddedAtDesc(c.getId(),storeId(s)); }
+    public WishlistItem get(Customer c, MerchantStore s, Product p) { return repository.findByCustomerIdAndMerchantStoreIdAndProductId(c.getId(),storeId(s),p.getId()); }
+    public boolean contains(Customer c, MerchantStore s, Product p) { return get(c,s,p)!=null; }
+    @Transactional public void remove(Customer c, MerchantStore s, Product p) throws ServiceException { WishlistItem i=get(c,s,p); if(i!=null) repository.delete(i); }
+    public List<WishlistPopular> popular(MerchantStore s) { List<WishlistPopular> out=new ArrayList<>(); for(Object[] row:repository.popular(storeId(s))) { if(out.size()==10) break; out.add(new WishlistPopular((String)row[0], ((Number)row[1]).longValue())); } return out; }
+    @Transactional public void removeProduct(Product p) { repository.deleteByProductId(p.getId()); }
+    /**
+     * A product can carry inventory either on itself or on one of its variants.
+     * Variant inventory is intentionally checked independently: a product with
+     * empty product-level availability can still be purchasable when a variant
+     * has stock (the same fallback used by ProductInventoryService).
+     */
+    public boolean hasStock(Product p) {
+        if (p == null || !p.isAvailable()) return false;
+        if (hasStock(p.getAvailabilities())) return true;
+        if (p.getVariants() != null) {
+            for (ProductVariant variant : p.getVariants()) {
+                if (variant != null && variant.isAvailable() && hasStock(variant.getAvailabilities())) return true;
+                // ProductInventoryService falls back to the product availability
+                // for variants without their own inventory, already checked above.
+            }
+        }
+        return false;
+    }
+
+    private boolean hasStock(Set<ProductAvailability> availabilities) {
+        if (availabilities == null) return false;
+        for (ProductAvailability a : availabilities) {
+            if (a != null && a.getProductQuantity() != null && a.getProductQuantity() > 0 && a.getProductStatus()) return true;
+        }
+        return false;
+    }
+}
