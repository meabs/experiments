+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.security.Principal;
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.List;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.ExceptionHandler;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.wishlist.WishlistService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.core.model.wishlist.WishlistItem;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.model.wishlist.PersistableWishlist;
+import com.salesmanager.shop.model.wishlist.ReadableWishlist;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Authenticated customer's wishlist endpoints. */
+@RestController
+@RequestMapping("/api/v1/auth/customer/wishlist")
+public class CustomerWishlistApi {
+    @Inject private WishlistService wishlistService;
+    @Inject private ProductService productService;
+    @Inject private CustomerFacade customerFacade;
+    @Inject private ShoppingCartFacade shoppingCartFacade;
+
+    @GetMapping
+    public ReadableWishlist get(@ApiIgnore MerchantStore store, @ApiIgnore Language language,
+            HttpServletRequest request) {
+        return readable(customer(request, store), store);
+    }
+
+    @PostMapping
+    public ResponseEntity<ReadableWishlist> add(@RequestBody PersistableWishlist body,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest request) {
+        if (body == null || body.getProduct() == null || body.getProduct().trim().isEmpty())
+            throw new WishlistHttpException(HttpStatus.BAD_REQUEST, "product is required");
+        Customer customer = customer(request, store);
+        Product product = product(body.getProduct(), store, language);
+        boolean duplicate = wishlistService.contains(customer, store, product);
+        try { wishlistService.add(customer, store, product); }
+        catch (Exception e) { throw new WishlistHttpException(HttpStatus.BAD_REQUEST, "Unable to add wishlist item"); }
+        return new ResponseEntity<>(readable(customer, store), duplicate ? HttpStatus.OK : HttpStatus.CREATED);
+    }
+
+    @DeleteMapping("/{sku}")
+    public ResponseEntity<Void> remove(@PathVariable String sku, @ApiIgnore MerchantStore store,
+            @ApiIgnore Language language, HttpServletRequest request) {
+        Customer customer = customer(request, store); Product product = product(sku, store, language);
+        if (!wishlistService.contains(customer, store, product)) throw new ResourceNotFoundException("Wishlist item not found");
+        try { wishlistService.remove(customer, store, product); }
+        catch (Exception e) { throw new WishlistHttpException(HttpStatus.BAD_REQUEST, "Unable to remove wishlist item"); }
+        return new ResponseEntity<>(HttpStatus.NO_CONTENT);
+    }
+
+    @PostMapping("/{sku}/cart/{cartCode}")
+    public ResponseEntity<ReadableShoppingCart> move(@PathVariable String sku, @PathVariable String cartCode,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest request) {
+        Customer customer = customer(request, store); Product product = product(sku, store, language);
+        if (!wishlistService.contains(customer, store, product)) throw new ResourceNotFoundException("Wishlist item not found");
+        if (!wishlistService.hasStock(product)) throw new WishlistHttpException(HttpStatus.CONFLICT, "Wishlist product is unavailable");
+        PersistableShoppingCartItem item = new PersistableShoppingCartItem(); item.setProduct(sku); item.setQuantity(1);
+        try {
+            // The facade's customer overload creates a cart when needed; this operation requires an existing code.
+            ReadableShoppingCart cart = shoppingCartFacade.addToCart(customer, cartCode, item, store, language);
+            if (cart == null) throw new ResourceNotFoundException("Cart not found");
+            wishlistService.remove(customer, store, product);
+            return new ResponseEntity<>(cart, HttpStatus.OK);
+        } catch (ResourceNotFoundException e) { throw e; }
+        catch (Exception e) { throw new WishlistHttpException(HttpStatus.BAD_REQUEST, "Unable to add wishlist item to cart"); }
+    }
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal principal = request.getUserPrincipal();
+        if (principal == null) throw new WishlistHttpException(HttpStatus.UNAUTHORIZED, "Customer authentication required");
+        Customer c = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (c == null) throw new ResourceNotFoundException("Customer not found");
+        return c;
+    }
+    private Product product(String sku, MerchantStore store, Language language) {
+        try { Product p = productService.getBySku(sku, store, language); if (p == null) throw new ResourceNotFoundException("Product not found"); return p; }
+        catch (ResourceNotFoundException e) { throw e; }
+        catch (Exception e) { throw new ResourceNotFoundException("Product not found"); }
+    }
+    private ReadableWishlist readable(Customer c, MerchantStore store) {
+        List<com.salesmanager.shop.model.wishlist.WishlistItem> items = new ArrayList<>();
+        for (WishlistItem w : wishlistService.list(c, store)) {
+            Product p = w.getProduct(); BigDecimal price = null;
+            for (ProductAvailability a : p.getAvailabilities()) { if (a.defaultPrice() != null) { price = a.defaultPrice().getProductPriceAmount(); break; } }
+            String name = p.getDescriptions().isEmpty() ? null : p.getDescriptions().iterator().next().getName();
+            items.add(new com.salesmanager.shop.model.wishlist.WishlistItem(p.getSku(), name, price, wishlistService.hasStock(p), w.getAddedAt()));
+        }
+        ReadableWishlist result = new ReadableWishlist(); result.setItems(items); return result;
+    }
+
+    @ExceptionHandler(WishlistHttpException.class)
+    public ResponseEntity<Void> handleWishlistError(WishlistHttpException e) {
+        return new ResponseEntity<>(e.getStatus());
+    }
+
+    private static final class WishlistHttpException extends RuntimeException {
+        private static final long serialVersionUID = 1L;
+        private final HttpStatus status;
+        WishlistHttpException(HttpStatus status, String message) { super(message); this.status = status; }
+        HttpStatus getStatus() { return status; }
+    }
+}
