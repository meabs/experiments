+package com.salesmanager.core.business.services.catalog.product.question;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.*;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl implements ProductQuestionService {
+  private final ProductQuestionRepository repository; private final ProductService productService;
+  @Inject public ProductQuestionServiceImpl(ProductQuestionRepository repository, ProductService productService){this.repository=repository;this.productService=productService;}
+  private String text(String value,int min,int max,String label){if(value==null) throw new ProductQuestionException(ProductQuestionException.Reason.VALIDATION,label+" is required"); String v=value.trim(); if(v.length()<min||v.length()>max) throw new ProductQuestionException(ProductQuestionException.Reason.VALIDATION,label+" length is invalid"); return v;}
+  private Product product(String sku, MerchantStore store){try {Product p=productService.getBySku(sku,store); if(p==null) throw new ProductQuestionException(ProductQuestionException.Reason.NOT_FOUND,"Product not found"); return p;} catch(Exception e){if(e instanceof ProductQuestionException) throw (ProductQuestionException)e; throw new ProductQuestionException(ProductQuestionException.Reason.NOT_FOUND,"Product not found");}}
+  @Transactional public ProductQuestion ask(String sku,Customer customer,MerchantStore store,String value){if(customer==null||store==null) throw new ProductQuestionException(ProductQuestionException.Reason.VALIDATION,"Customer and store are required"); Product p=product(sku,store); if(repository.countByCustomerIdAndStatus(customer.getId(),ProductQuestionStatus.PENDING)>=3) throw new ProductQuestionException(ProductQuestionException.Reason.VALIDATION,"Customer has too many pending questions"); ProductQuestion q=new ProductQuestion(); q.setProduct(p);q.setCustomer(customer);q.setMerchantStore(store);q.setText(text(value,10,500,"Question"));q.setAskedAt(new Date());q.setStatus(ProductQuestionStatus.PENDING); return repository.saveAndFlush(q);}
+  public List<ProductQuestion> listByCustomer(Customer c){return repository.findByCustomerIdOrderByAskedAtDesc(c.getId());}
+  public List<ProductQuestion> listByStore(MerchantStore s,ProductQuestionStatus status){return repository.findByMerchantStoreIdAndStatusOrderByAskedAtAsc(s.getId(),status);}
+  public List<ProductQuestion> listPublished(String sku,MerchantStore store){Product p=product(sku,store); return repository.findByProductIdAndStatusOrderByAnsweredAtDesc(p.getId(),ProductQuestionStatus.PUBLISHED);}
+  private ProductQuestion get(Long id){return repository.findById(id).orElseThrow(()->new ProductQuestionException(ProductQuestionException.Reason.NOT_FOUND,"Question not found"));}
+  @Transactional public ProductQuestion answer(Long id,String value){ProductQuestion q=get(id); if(q.getStatus()==ProductQuestionStatus.REJECTED) throw new ProductQuestionException(ProductQuestionException.Reason.CONFLICT,"Rejected question cannot be answered"); q.setAnswer(text(value,1,2000,"Answer"));q.setStatus(ProductQuestionStatus.PUBLISHED);q.setAnsweredAt(new Date());return repository.saveAndFlush(q);}
+  @Transactional public ProductQuestion reject(Long id){ProductQuestion q=get(id);q.setStatus(ProductQuestionStatus.REJECTED);return repository.saveAndFlush(q);}
+  @Transactional public void deleteByProduct(Product product){if(product!=null&&product.getId()!=null) repository.deleteByProductId(product.getId());}
+}
