+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Customer and public product-question endpoints. */
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+
+    @Inject
+    private ProductQuestionService productQuestionService;
+
+    @Inject
+    private CustomerFacade customerFacade;
+
+    @PostMapping("/auth/products/{sku}/questions")
+    @ResponseStatus(HttpStatus.CREATED)
+    public ProductQuestionView ask(@PathVariable String sku,
+            @RequestBody ProductQuestionRequest request,
+            @ApiIgnore MerchantStore merchantStore,
+            HttpServletRequest servletRequest) {
+        Customer customer = authenticatedCustomer(servletRequest, merchantStore);
+        ProductQuestion question = productQuestionService.ask(sku, customer, merchantStore,
+                request == null ? null : request.getText());
+        return ProductQuestionView.from(question);
+    }
+
+    @GetMapping("/auth/customer/questions")
+    public List<ProductQuestionView> myQuestions(@ApiIgnore MerchantStore merchantStore,
+            HttpServletRequest servletRequest) {
+        Customer customer = authenticatedCustomer(servletRequest, merchantStore);
+        List<ProductQuestionView> result = new java.util.ArrayList<>();
+        for (ProductQuestion question : productQuestionService.listByCustomer(customer)) {
+            result.add(ProductQuestionView.from(question));
+        }
+        return result;
+    }
+
+    @GetMapping("/products/{sku}/questions")
+    public PublicProductQuestionList published(@PathVariable String sku,
+            @ApiIgnore MerchantStore merchantStore) {
+        return new PublicProductQuestionList(productQuestionService.listPublished(sku, merchantStore));
+    }
+
+    private Customer authenticatedCustomer(HttpServletRequest request, MerchantStore store) {
+        Principal principal = request == null ? null : request.getUserPrincipal();
+        if (principal == null || principal.getName() == null) {
+            throw new UnauthorizedException();
+        }
+        Customer customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (customer == null) {
+            throw new UnauthorizedException();
+        }
+        return customer;
+    }
+
+    /** Translate domain outcomes to the HTTP contract without exposing the domain exception. */
+    @ExceptionHandler(ProductQuestionException.class)
+    public ResponseEntity<String> handleQuestionException(ProductQuestionException exception) {
+        ProductQuestionException.Reason reason = exception.getReason();
+        HttpStatus status = reason == ProductQuestionException.Reason.NOT_FOUND
+                ? HttpStatus.NOT_FOUND
+                : HttpStatus.BAD_REQUEST;
+        if (reason == ProductQuestionException.Reason.CONFLICT) {
+            status = HttpStatus.CONFLICT;
+        }
+        return ResponseEntity.status(status).body(exception.getMessage());
+    }
+}
