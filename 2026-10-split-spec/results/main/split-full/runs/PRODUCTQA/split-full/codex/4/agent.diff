+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.List;
+
+import javax.validation.Valid;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.ExceptionHandler;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionException;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionView;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.api.exception.ErrorEntity;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Administrative operations for product questions. */
+@RestController
+@RequestMapping("/api/v1/private/questions")
+public class ProductQuestionAdminApi {
+
+    private final ProductQuestionService questionService;
+
+    public ProductQuestionAdminApi(ProductQuestionService questionService) {
+        this.questionService = questionService;
+    }
+
+    @GetMapping
+    public List<ProductQuestionView> list(
+            @RequestParam(value = "status", defaultValue = "PENDING") String status,
+            @ApiIgnore MerchantStore merchantStore) {
+        final ProductQuestionStatus questionStatus;
+        try {
+            questionStatus = ProductQuestionStatus.valueOf(status.toUpperCase());
+        } catch (Exception e) {
+            throw new RestApiException("400", "Invalid question status");
+        }
+        List<ProductQuestion> questions = questionService.listByStore(merchantStore, questionStatus);
+        return questions.stream().map(ProductQuestionView::from).collect(java.util.stream.Collectors.toList());
+    }
+
+    @PutMapping("/{id}/answer")
+    @ResponseStatus(HttpStatus.OK)
+    public ProductQuestionView answer(@PathVariable Long id, @Valid @RequestBody AnswerRequest request,
+            @ApiIgnore MerchantStore merchantStore) {
+        // Check ownership before invoking the mutating service operation.  The
+        // service's id operation is intentionally store-agnostic for customer use.
+        findInStore(id, merchantStore);
+        try {
+            return ProductQuestionView.from(
+                    questionService.answer(id, request == null ? null : request.getAnswer()));
+        } catch (ProductQuestionException e) {
+            throw map(e);
+        }
+    }
+
+    @PutMapping("/{id}/reject")
+    @ResponseStatus(HttpStatus.OK)
+    public ProductQuestionView reject(@PathVariable Long id, @ApiIgnore MerchantStore merchantStore) {
+        findInStore(id, merchantStore);
+        ProductQuestion question;
+        try {
+            question = questionService.reject(id);
+        } catch (ProductQuestionException e) {
+            throw map(e);
+        }
+        assertStore(question, merchantStore);
+        return ProductQuestionView.from(question);
+    }
+
+    private ProductQuestion findInStore(Long id, MerchantStore store) {
+        if (store != null) {
+            for (ProductQuestionStatus status : ProductQuestionStatus.values()) {
+                for (ProductQuestion question : questionService.listByStore(store, status)) {
+                    if (id.equals(question.getId())) {
+                        return question;
+                    }
+                }
+            }
+        }
+        throw new RestApiException("404", "Question not found");
+    }
+
+    private void assertStore(ProductQuestion question, MerchantStore store) {
+        if (question == null || question.getMerchantStore() == null || store == null
+                || !question.getMerchantStore().getId().equals(store.getId())) {
+            throw new RestApiException("404", "Question not found");
+        }
+    }
+
+    private RuntimeException map(ProductQuestionException e) {
+        if (e.getReason() == ProductQuestionException.Reason.NOT_FOUND) {
+            return new RestApiException("404", e.getMessage());
+        }
+        if (e.getReason() == ProductQuestionException.Reason.CONFLICT) {
+            return new RestApiException("409", e.getMessage());
+        }
+        return new RestApiException("400", e.getMessage());
+    }
+
+    /**
+     * RestErrorHandler historically renders every RestApiException as 400.  The
+     * question API has two meaningful non-400 domain outcomes, so handle this
+     * controller's errors locally and preserve the error code as HTTP status.
+     */
+    @ExceptionHandler(RestApiException.class)
+    public ResponseEntity<ErrorEntity> handleQuestionError(RestApiException exception) {
+        ErrorEntity body = new ErrorEntity();
+        body.setErrorCode(exception.getErrorCode());
+        body.setMessage(exception.getErrorMessage());
+        int code = 400;
+        try {
+            code = Integer.parseInt(exception.getErrorCode());
+        } catch (Exception ignored) {
+            // Keep the API's normal bad-request fallback for malformed codes.
+        }
+        HttpStatus status = HttpStatus.resolve(code);
+        return ResponseEntity.status(status == null ? HttpStatus.BAD_REQUEST : status).body(body);
+    }
+
+    public static class AnswerRequest {
+        private String answer;
+        public String getAnswer() { return answer; }
+        public void setAnswer(String answer) { this.answer = answer; }
+    }
+}
