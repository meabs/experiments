+        if (value == null || value.length() < 1 || value.length() > 2000)
+            return ResponseEntity.badRequest().build();
+        ProductQuestion current = questionService.getById(id);
+        if (current == null || !sameStore(current, merchantStore))
+            throw new ResourceNotFoundException("Question with id " + id + " does not exist");
+        if (current.getStatus() == ProductQuestionStatus.REJECTED)
+            return ResponseEntity.status(HttpStatus.CONFLICT).build();
+        try {
+            return ResponseEntity.ok(new QuestionView(questionService.answer(id, value)));
+        } catch (IllegalArgumentException e) {
+            return ResponseEntity.badRequest().build();
+        } catch (IllegalStateException e) {
+            return ResponseEntity.status(HttpStatus.CONFLICT).build();
+        }
+    }
+
+    @PutMapping("/{id}/reject")
+    public ResponseEntity<?> reject(@PathVariable Long id, @ApiIgnore MerchantStore merchantStore) {
+        authorize();
+        ProductQuestion current = questionService.getById(id);
+        if (current == null || !sameStore(current, merchantStore))
+            throw new ResourceNotFoundException("Question with id " + id + " does not exist");
+        ProductQuestion rejected = questionService.reject(id);
+        return ResponseEntity.ok(new QuestionView(rejected));
+    }
+
+    private void authorize() {
+        String user = userFacade.authenticatedUser();
+        if (user == null) throw new UnauthorizedException();
+        userFacade.authorizedGroup(user, Stream.of(Constants.GROUP_SUPERADMIN, Constants.GROUP_ADMIN,
+                Constants.GROUP_ADMIN_CATALOGUE, Constants.GROUP_ADMIN_RETAIL).collect(Collectors.toList()));
+    }
+
+    private ProductQuestionStatus parseStatus(String value) {
+        try {
+            return ProductQuestionStatus.valueOf(value == null ? "PENDING" : value.trim().toUpperCase());
+        } catch (Exception e) {
+            throw new IllegalArgumentException("Invalid question status");
+        }
+    }
+
+    private boolean sameStore(ProductQuestion question, MerchantStore store) {
+        return question.getMerchantStore() != null && store != null
+                && question.getMerchantStore().getId().equals(store.getId());
+    }
+
+    public static class AnswerRequest {
+        public String answer;
+        public String getAnswer() { return answer; }
+        public void setAnswer(String answer) { this.answer = answer; }
+    }
+
+    public static class QuestionView {
+        private final Long id;
+        private final String sku;
+        private final String text;
+        private final String status;
+        private final String answer;
+        private final String askedBy;
+        private final Date askedAt;
+        private final Date answeredAt;
+        QuestionView(ProductQuestion q) {
+            this.id = q.getId(); this.sku = q.getProduct() == null ? null : q.getProduct().getSku();
+            this.text = q.getText(); this.status = q.getStatus() == null ? null : q.getStatus().name();
+            this.answer = q.getAnswer(); this.askedBy = q.getAskedBy(); this.askedAt = q.getAskedAt();
+            this.answeredAt = q.getAnsweredAt();
+        }
+        public Long getId() { return id; }
+        public String getSku() { return sku; }
+        public String getText() { return text; }
+        public String getStatus() { return status; }
+        public String getAnswer() { return answer; }
+        public String getAskedBy() { return askedBy; }
+        public Date getAskedAt() { return askedAt; }
+        public Date getAnsweredAt() { return answeredAt; }
+    }
