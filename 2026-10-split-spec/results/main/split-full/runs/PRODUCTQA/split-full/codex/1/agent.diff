+package com.salesmanager.core.business.services.catalog.product.question;
+
+import java.util.Date;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long, ProductQuestion>
+        implements ProductQuestionService {
+    private static final int MAX_PENDING = 3;
+    private final ProductQuestionRepository repository;
+
+    @Inject
+    public ProductQuestionServiceImpl(ProductQuestionRepository repository) {
+        super(repository);
+        this.repository = repository;
+    }
+
+    @Override
+    public void create(ProductQuestion question) {
+        if (question == null || question.getProduct() == null || question.getCustomer() == null
+                || question.getMerchantStore() == null) throw new IllegalArgumentException("Question associations are required");
+        String text = question.getText() == null ? null : question.getText().trim();
+        if (text == null || text.length() < 10 || text.length() > 500) throw new IllegalArgumentException("Question must be 10 to 500 characters");
+        if (repository.countByCustomerIdAndStatus(question.getCustomer().getId(), ProductQuestionStatus.PENDING) >= MAX_PENDING)
+            throw new IllegalArgumentException("Customer has too many pending questions");
+        question.setText(text);
+        question.setStatus(ProductQuestionStatus.PENDING);
+        question.setAnswer(null);
+        question.setAnsweredAt(null);
+        question.setAskedAt(new Date());
+        repository.saveAndFlush(question);
+    }
+
+    @Override
+    public ProductQuestion create(Product product, Customer customer, MerchantStore store, String text) {
+        ProductQuestion q = new ProductQuestion();
+        q.setProduct(product); q.setCustomer(customer); q.setMerchantStore(store); q.setText(text);
+        create(q);
+        return q;
+    }
+
+    @Override public List<ProductQuestion> getByCustomer(Customer customer) {
+        return repository.findByCustomerIdOrderByAskedAtDesc(customer.getId());
+    }
+    @Override public List<ProductQuestion> getByStoreAndStatus(MerchantStore store, ProductQuestionStatus status) {
+        return repository.findByMerchantStoreIdAndStatusOrderByAskedAtAsc(store.getId(), status);
+    }
+    @Override public List<ProductQuestion> getPublishedByProduct(Product product) {
+        return repository.findByProductIdAndStatusOrderByAnsweredAtDesc(product.getId(), ProductQuestionStatus.PUBLISHED);
+    }
+    @Override public ProductQuestion getById(Long id) { return id == null ? null : repository.findById(id).orElse(null); }
+
+    @Override public ProductQuestion answer(Long id, String answer) {
+        ProductQuestion q = getById(id);
+        if (q == null) return null;
+        if (q.getStatus() == ProductQuestionStatus.REJECTED) throw new IllegalStateException("Rejected question cannot be answered");
+        String value = answer == null ? null : answer.trim();
+        if (value == null || value.length() < 1 || value.length() > 2000) throw new IllegalArgumentException("Answer must be 1 to 2000 characters");
+        q.setAnswer(value); q.setStatus(ProductQuestionStatus.PUBLISHED); q.setAnsweredAt(new Date());
+        return repository.saveAndFlush(q);
+    }
+    @Override public ProductQuestion reject(Long id) {
+        ProductQuestion q = getById(id);
+        if (q == null) return null;
+        q.setStatus(ProductQuestionStatus.REJECTED);
+        return repository.saveAndFlush(q);
+    }
+}
