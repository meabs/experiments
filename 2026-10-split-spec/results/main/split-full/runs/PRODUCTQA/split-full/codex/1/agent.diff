+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.List;
+import java.util.stream.Collectors;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import springfox.documentation.annotations.ApiIgnore;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.catalog.product.question.ProductQuestionRequest;
+import com.salesmanager.shop.model.catalog.product.question.ReadableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.question.ReadablePublishedProductQuestion;
+import com.salesmanager.shop.model.catalog.product.question.ReadablePublishedProductQuestionList;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+
+/** Customer and anonymous product-question resources. */
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+    @Inject private ProductQuestionService questionService;
+    @Inject private ProductService productService;
+    @Inject private CustomerFacade customerFacade;
+
+    @PostMapping("/auth/products/{sku}/questions")
+    @ResponseStatus(HttpStatus.CREATED)
+    public ReadableProductQuestion ask(@PathVariable String sku, @RequestBody ProductQuestionRequest request,
+            @ApiIgnore MerchantStore store, HttpServletRequest httpRequest) {
+        Customer customer = customer(httpRequest, store);
+        Product product = product(sku, store);
+        if (request == null || request.getText() == null) throw bad("Question text is required");
+        String text = request.getText().trim();
+        if (text.length() < 10 || text.length() > 500) throw bad("Question must contain 10 to 500 characters");
+        return ReadableProductQuestion.from(questionService.create(product, customer, store, text));
+    }
+
+    @GetMapping("/auth/customer/questions")
+    public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store, HttpServletRequest request) {
+        Customer customer = customer(request, store);
+        return questionService.getByCustomer(customer).stream().map(ReadableProductQuestion::from).collect(Collectors.toList());
+    }
+
+    @GetMapping("/products/{sku}/questions")
+    public ReadablePublishedProductQuestionList published(@PathVariable String sku, @ApiIgnore MerchantStore store,
+            @ApiIgnore Language language) {
+        Product product = product(sku, store, language);
+        List<ReadablePublishedProductQuestion> items = questionService.getPublishedByProduct(product).stream()
+                .map(ReadablePublishedProductQuestion::from).collect(Collectors.toList());
+        return new ReadablePublishedProductQuestionList(items);
+    }
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal principal = request == null ? null : request.getUserPrincipal();
+        if (principal == null) throw new ServiceRuntimeException("401", "Authentication required");
+        Customer customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (customer == null) throw new ResourceNotFoundException("Customer not found");
+        return customer;
+    }
+    private Product product(String sku, MerchantStore store) { return product(sku, store, null); }
+    private Product product(String sku, MerchantStore store, Language language) {
+        try {
+            Product p = language == null ? productService.getBySku(sku, store) : productService.getBySku(sku, store, language);
+            if (p == null) throw new ResourceNotFoundException("Product sku [" + sku + "] not found");
+            return p;
+        } catch (ResourceNotFoundException e) { throw e; }
+        catch (Exception e) { throw new ResourceNotFoundException("Product sku [" + sku + "] not found"); }
+    }
+    private ServiceRuntimeException bad(String message) { return new ServiceRuntimeException("400", message); }
+}
