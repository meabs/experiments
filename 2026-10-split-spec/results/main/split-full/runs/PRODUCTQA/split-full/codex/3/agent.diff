+package com.salesmanager.core.business.services.catalog.product.question;
+
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion.Status;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl implements ProductQuestionService {
+    private final ProductQuestionRepository repository;
+    private final ProductService productService;
+    @Inject public ProductQuestionServiceImpl(ProductQuestionRepository repository, ProductService productService) {
+        this.repository = repository; this.productService = productService;
+    }
+    @Override public ProductQuestion ask(String sku, String text, Customer customer, MerchantStore store) {
+        if (sku == null || store == null) throw new IllegalArgumentException("Product and store are required");
+        Product product;
+        try { product = productService.getBySku(sku, store); } catch (Exception e) { product = null; }
+        if (product == null) throw new NoSuchElementException("Unknown product");
+        return ask(product, text, customer, store);
+    }
+    @Override public ProductQuestion ask(Product product, String text, Customer customer, MerchantStore store) {
+        if (product == null || customer == null || store == null) throw new IllegalArgumentException("Product, customer and store are required");
+        if (product.getMerchantStore() == null || !store.getId().equals(product.getMerchantStore().getId())) throw new NoSuchElementException("Unknown product");
+        String value = trimAndValidate(text, 10, 500, "Question");
+        if (repository.countByCustomerIdAndStatus(customer.getId(), Status.PENDING) >= 3) throw new IllegalArgumentException("Too many pending questions");
+        ProductQuestion q = new ProductQuestion(); q.setProduct(product); q.setCustomer(customer); q.setMerchantStore(store);
+        q.setText(value); q.setStatus(Status.PENDING); q.setAskedAt(new Date()); return repository.save(q);
+    }
+    @Override public List<ProductQuestion> findByCustomer(Customer customer) { return customer == null ? Collections.<ProductQuestion>emptyList() : repository.findByCustomerIdOrderByAskedAtDesc(customer.getId()); }
+    @Override public List<ProductQuestion> list(MerchantStore store, Status status) { if (store == null) throw new IllegalArgumentException("Store is required"); return repository.findByMerchantStoreIdAndStatusOrderByAskedAtAsc(store.getId(), status == null ? Status.PENDING : status); }
+    @Override public List<ProductQuestion> findPublishedBySku(String sku, MerchantStore store) {
+        Product product; try { product = productService.getBySku(sku, store); } catch (Exception e) { product = null; }
+        if (product == null) throw new NoSuchElementException("Unknown product");
+        return repository.findByProductIdAndStatusOrderByAnsweredAtDesc(product.getId(), Status.PUBLISHED);
+    }
+    @Override public ProductQuestion answer(Long id, String answer, MerchantStore store) {
+        ProductQuestion q = required(id, store); if (q.getStatus() == Status.REJECTED) throw new IllegalStateException("Rejected question cannot be answered");
+        q.setAnswer(trimAndValidate(answer, 1, 2000, "Answer")); q.setStatus(Status.PUBLISHED); q.setAnsweredAt(new Date()); return repository.save(q);
+    }
+    @Override public ProductQuestion reject(Long id, MerchantStore store) { ProductQuestion q = required(id, store); q.setStatus(Status.REJECTED); return repository.save(q); }
+    @Override public Optional<ProductQuestion> findById(Long id) { return repository.findById(id); }
+    @Override public Optional<ProductQuestion> findById(Long id, MerchantStore store) { return store == null ? Optional.<ProductQuestion>empty() : Optional.ofNullable(repository.findByIdAndMerchantStoreId(id, store.getId())); }
+    private ProductQuestion required(Long id, MerchantStore store) { ProductQuestion q = store == null ? null : repository.findByIdAndMerchantStoreId(id, store.getId()); if (q == null) throw new NoSuchElementException("Unknown question"); return q; }
+    private String trimAndValidate(String value, int min, int max, String name) { if (value == null) throw new IllegalArgumentException(name + " is required"); String v=value.trim(); if(v.length()<min||v.length()>max) throw new IllegalArgumentException(name + " length is invalid"); return v; }
+}
