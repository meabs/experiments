+package com.salesmanager.shop.store.api.v1.question;
+
+import java.util.List;
+import java.util.stream.Collectors;
+import java.util.stream.Stream;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion.Status;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.model.catalog.product.question.PersistableAnswer;
+import com.salesmanager.shop.model.catalog.product.question.ReadableQuestion;
+import com.salesmanager.shop.utils.AuthorizationUtils;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Administrative product-question moderation endpoints. */
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionAdminApi {
+
+    @Inject
+    private ProductQuestionService productQuestionService;
+
+    @Inject
+    private AuthorizationUtils authorizationUtils;
+
+    @GetMapping("/private/questions")
+    public ResponseEntity<?> list(
+            @RequestParam(name = "status", defaultValue = "PENDING") String status,
+            @ApiIgnore MerchantStore merchantStore) {
+        authorize(merchantStore);
+        final Status parsed;
+        try {
+            parsed = Status.valueOf(status.toUpperCase());
+        } catch (RuntimeException e) {
+            return ResponseEntity.badRequest().build();
+        }
+        List<ReadableQuestion> result = productQuestionService.list(merchantStore, parsed).stream()
+                .map(this::readable)
+                .collect(Collectors.toList());
