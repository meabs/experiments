+                Stream.of(Constants.GROUP_SUPERADMIN, Constants.GROUP_ADMIN,
+                        Constants.GROUP_ADMIN_CATALOGUE, Constants.GROUP_ADMIN_RETAIL)
+                        .collect(Collectors.toList()), store);
+    }
