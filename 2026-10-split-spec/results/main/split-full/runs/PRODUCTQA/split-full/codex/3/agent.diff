+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Customer-authenticated and public product-question endpoints. */
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+
+    @Inject
+    private ProductQuestionService questionService;
+
+    @Inject
+    private CustomerFacade customerFacade;
+
+    @PostMapping("/auth/products/{sku}/questions")
+    @ResponseStatus(HttpStatus.CREATED)
+    public Map<String, Object> ask(@PathVariable String sku,
+            @RequestBody QuestionRequest request,
+            @ApiIgnore MerchantStore merchantStore,
+            HttpServletRequest httpRequest) {
+        Customer customer = authenticatedCustomer(httpRequest, merchantStore);
+        try {
+            return customerQuestion(questionService.ask(sku, request == null ? null : request.getText(), customer, merchantStore));
+        } catch (IllegalArgumentException e) {
+            throw new RestApiException("400", e.getMessage(), e);
+        } catch (java.util.NoSuchElementException e) {
+            throw new ResourceNotFoundException(e.getMessage());
+        }
+    }
+
+    @GetMapping("/auth/customer/questions")
+    public List<Map<String, Object>> mine(@ApiIgnore MerchantStore merchantStore,
+            HttpServletRequest httpRequest) {
+        Customer customer = authenticatedCustomer(httpRequest, merchantStore);
+        List<Map<String, Object>> result = new ArrayList<>();
+        for (ProductQuestion question : questionService.findByCustomer(customer)) {
+            result.add(customerQuestion(question));
+        }
+        return result;
+    }
+
+    @GetMapping("/products/{sku}/questions")
+    public Map<String, Object> published(@PathVariable String sku,
+            @ApiIgnore MerchantStore merchantStore) {
+        try {
+            List<Map<String, Object>> items = new ArrayList<>();
+            for (ProductQuestion question : questionService.findPublishedBySku(sku, merchantStore)) {
+                Map<String, Object> item = new LinkedHashMap<>();
+                item.put("id", question.getId());
+                item.put("text", question.getText());
+                item.put("answer", question.getAnswer());
+                item.put("askedBy", askedBy(question));
+                item.put("answeredAt", question.getAnsweredAt());
+                items.add(item);
+            }
+            Map<String, Object> result = new LinkedHashMap<>();
+            result.put("count", items.size());
+            result.put("items", items);
+            return result;
+        } catch (java.util.NoSuchElementException e) {
+            throw new ResourceNotFoundException(e.getMessage());
+        }
+    }
+
+    private Customer authenticatedCustomer(HttpServletRequest request, MerchantStore store) {
+        Principal principal = request == null ? null : request.getUserPrincipal();
+        if (principal == null) {
+            throw new com.salesmanager.shop.store.api.exception.UnauthorizedException();
+        }
+        Customer customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (customer == null) {
+            throw new ResourceNotFoundException("Customer [" + principal.getName() + "] not found");
+        }
+        return customer;
+    }
+
+    private Map<String, Object> customerQuestion(ProductQuestion question) {
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("id", question.getId());
+        result.put("sku", question.getProduct() == null ? null : question.getProduct().getSku());
+        result.put("text", question.getText());
+        result.put("status", question.getStatus() == null ? null : question.getStatus().name());
+        result.put("answer", question.getAnswer());
+        result.put("askedBy", askedBy(question));
+        result.put("askedAt", question.getAskedAt());
+        result.put("answeredAt", question.getAnsweredAt());
+        return result;
+    }
+
+    private String askedBy(ProductQuestion question) {
+        if (question.getCustomer() == null || question.getCustomer().getBilling() == null) {
+            return null;
+        }
+        return question.getCustomer().getBilling().getFirstName();
+    }
+
+    public static class QuestionRequest {
+        private String text;
+        public String getText() { return text; }
+        public void setText(String text) { this.text = text; }
+    }
+}
