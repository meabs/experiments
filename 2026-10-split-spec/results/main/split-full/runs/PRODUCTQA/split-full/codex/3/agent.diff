+    private ReadableQuestion readable(ProductQuestion source) {
+        ReadableQuestion target = new ReadableQuestion();
+        target.setId(source.getId());
+        target.setSku(source.getProduct() == null ? null : source.getProduct().getSku());
+        target.setText(source.getText());
+        target.setStatus(source.getStatus() == null ? null : source.getStatus().name());
+        target.setAnswer(source.getAnswer());
+        target.setAskedBy(source.getCustomer() == null || source.getCustomer().getBilling() == null
+                ? null : source.getCustomer().getBilling().getFirstName());
