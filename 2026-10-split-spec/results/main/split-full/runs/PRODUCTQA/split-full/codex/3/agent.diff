+    @PutMapping("/private/questions/{id}/answer")
+    public ResponseEntity<?> answer(@PathVariable Long id,
+            @RequestBody PersistableAnswer request, @ApiIgnore MerchantStore merchantStore) {
+        authorize(merchantStore);
+        try {
+            ProductQuestion question = productQuestionService.answer(id,
+                    request == null ? null : request.getAnswer(), merchantStore);
