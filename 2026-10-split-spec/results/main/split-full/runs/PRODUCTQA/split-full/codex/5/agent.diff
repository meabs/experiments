+package com.salesmanager.shop.populator.catalog.question;
+import com.salesmanager.core.business.exception.ConversionException;
+import com.salesmanager.core.business.utils.AbstractDataPopulator;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.catalog.product.question.ReadableProductQuestion;
+public class ReadableProductQuestionPopulator extends AbstractDataPopulator<ProductQuestion, ReadableProductQuestion> {
+    @Override public ReadableProductQuestion populate(ProductQuestion source, ReadableProductQuestion target, MerchantStore store, Language language) throws ConversionException {
+        target.setId(source.getId()); target.setSku(source.getProduct() == null ? null : source.getProduct().getSku()); target.setText(source.getText()); target.setAnswer(source.getAnswer()); target.setStatus(source.getStatus() == null ? null : source.getStatus().name()); target.setAskedAt(source.getAskedAt()); target.setAnsweredAt(source.getAnsweredAt());
+        if (source.getCustomer() != null && source.getCustomer().getBilling() != null) target.setAskedBy(source.getCustomer().getBilling().getFirstName());
+        return target;
+    }
+    @Override protected ReadableProductQuestion createTarget() { return new ReadableProductQuestion(); }
+}
