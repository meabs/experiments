@@ -0,0 +1,120 @@
+package com.salesmanager.shop.store.api.v1;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.http.MediaType;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RequestParam;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.question.ProductQuestionRequest;
+import com.salesmanager.shop.model.catalog.product.question.ReadableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.question.ReadableProductQuestionList;
+import com.salesmanager.shop.populator.catalog.question.ReadableProductQuestionPopulator;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Store-admin operations for moderating product questions. */
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionAdminApi {
+
+    @Inject
+    private ProductQuestionService productQuestionService;
+
+    @Inject
+    private ReadableProductQuestionPopulator questionPopulator;
+
+    @GetMapping(value = "/private/questions", produces = MediaType.APPLICATION_JSON_VALUE)
+    @ApiImplicitParams({
+        @ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT")
+    })
+    public ResponseEntity<ReadableProductQuestionList> list(
+            @RequestParam(value = "status", defaultValue = "PENDING") String status,
+            @ApiIgnore MerchantStore merchantStore) {
+        final ProductQuestionStatus questionStatus;
+        try {
+            questionStatus = ProductQuestionStatus.valueOf(status == null ? "PENDING" : status.trim().toUpperCase());
+        } catch (IllegalArgumentException ex) {
+            return ResponseEntity.badRequest().build();
+        }
+
+        List<ReadableProductQuestion> items = new ArrayList<>();
+        for (ProductQuestion question : productQuestionService.getByStore(merchantStore, questionStatus)) {
+            items.add(toReadable(question, merchantStore));
+        }
+        ReadableProductQuestionList result = new ReadableProductQuestionList();
+        result.setCount(items.size());
+        result.setItems(items);
+        return ResponseEntity.ok(result);
+    }
+
+    @PutMapping(value = "/private/questions/{id}/answer", consumes = MediaType.APPLICATION_JSON_VALUE,
+            produces = MediaType.APPLICATION_JSON_VALUE)
+    @ApiImplicitParams({
+        @ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT")
+    })
+    public ResponseEntity<ReadableProductQuestion> answer(
+            @PathVariable Long id, @RequestBody ProductQuestionRequest request,
+            @ApiIgnore MerchantStore merchantStore) {
+        if (request == null || request.getAnswer() == null) {
+            return ResponseEntity.badRequest().build();
+        }
+        try {
+            ProductQuestion question = productQuestionService.answer(id, merchantStore, request.getAnswer());
+            if (question == null) {
+                return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+            }
+            return ResponseEntity.ok(toReadable(question, merchantStore));
+        } catch (ServiceException ex) {
+            // The service uses validation exceptions for an attempt to answer a rejected question.
+            // Preserve the API's conflict semantics while retaining 400 for malformed answers.
+            if (ex.getMessage() != null && ex.getMessage().toLowerCase().contains("rejected")) {
+                return ResponseEntity.status(HttpStatus.CONFLICT).build();
+            }
+            return ResponseEntity.badRequest().build();
+        }
+    }
+
+    @PutMapping(value = "/private/questions/{id}/reject", produces = MediaType.APPLICATION_JSON_VALUE)
+    @ApiImplicitParams({
+        @ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT")
+    })
+    public ResponseEntity<ReadableProductQuestion> reject(
+            @PathVariable Long id, @ApiIgnore MerchantStore merchantStore) {
+        try {
+            ProductQuestion question = productQuestionService.reject(id, merchantStore);
+            if (question == null) {
+                return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+            }
+            return ResponseEntity.ok(toReadable(question, merchantStore));
+        } catch (ServiceException ex) {
+            return ResponseEntity.badRequest().build();
+        }
+    }
+
+    private ReadableProductQuestion toReadable(ProductQuestion question, MerchantStore store) {
+        try {
+            return questionPopulator.populate(question, new ReadableProductQuestion(), store, null);
+        } catch (Exception ex) {
+            throw new RestApiException("Unable to render product question", ex);
+        }
+    }
+}
