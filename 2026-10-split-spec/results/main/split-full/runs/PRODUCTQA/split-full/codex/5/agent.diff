+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.catalog.product.question.ProductQuestionRequest;
+import com.salesmanager.shop.model.catalog.product.question.ReadableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.question.ReadableProductQuestionList;
+import com.salesmanager.shop.populator.catalog.question.ReadableProductQuestionPopulator;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Customer and public product-question endpoints. */
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+
+    @Inject private ProductQuestionService productQuestionService;
+    @Inject private ProductService productService;
+    @Inject private CustomerFacade customerFacade;
+
+    @PostMapping("/auth/products/{sku}/questions")
+    @ResponseStatus(HttpStatus.CREATED)
+    @ApiImplicitParams({
+        @ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT"),
+        @ApiImplicitParam(name = "lang", dataType = "String", defaultValue = "en")
+    })
+    public ReadableProductQuestion ask(@PathVariable String sku,
+            @RequestBody ProductQuestionRequest request,
+            @ApiIgnore MerchantStore merchantStore, @ApiIgnore Language language,
+            HttpServletRequest httpRequest) {
+        Principal principal = httpRequest.getUserPrincipal();
+        Customer customer = customer(principal, merchantStore);
+        Product product = product(sku, merchantStore);
+        try {
+            String text = request == null ? null : request.getText();
+            if (text == null || text.trim().length() < 10 || text.trim().length() > 500) {
+                throw new RestApiException("400", "text length is invalid");
+            }
+            ProductQuestion question = productQuestionService.create(product, merchantStore, customer,
+                    text);
+            return readable(question, merchantStore, language);
+        } catch (ServiceException e) {
+            throw badRequest(e);
+        }
+    }
+
+    @GetMapping("/auth/customer/questions")
+    @ApiImplicitParams({
+        @ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT"),
+        @ApiImplicitParam(name = "lang", dataType = "String", defaultValue = "en")
+    })
+    public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore merchantStore,
+            @ApiIgnore Language language, HttpServletRequest httpRequest) {
+        Customer customer = customer(httpRequest.getUserPrincipal(), merchantStore);
+        List<ReadableProductQuestion> result = new ArrayList<>();
+        for (ProductQuestion question : productQuestionService.getByCustomer(customer)) {
+            result.add(readable(question, merchantStore, language));
+        }
+        return result;
+    }
+
+    @GetMapping("/products/{sku}/questions")
+    @ApiImplicitParams({
+        @ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT"),
+        @ApiImplicitParam(name = "lang", dataType = "String", defaultValue = "en")
+    })
+    public Map<String, Object> published(@PathVariable String sku,
+            @ApiIgnore MerchantStore merchantStore) {
+        Product product = product(sku, merchantStore);
+        List<Map<String, Object>> items = new ArrayList<>();
+        for (ProductQuestion question : productQuestionService.getByProduct(product)) {
+            Map<String, Object> item = new LinkedHashMap<>();
+            item.put("id", question.getId());
+            item.put("text", question.getText());
+            item.put("answer", question.getAnswer());
+            item.put("askedBy", askedBy(question));
+            item.put("answeredAt", question.getAnsweredAt());
+            items.add(item);
+        }
+        Map<String, Object> result = new LinkedHashMap<>();
+        result.put("count", items.size());
+        result.put("items", items);
+        return result;
+    }
+
+    private Customer customer(Principal principal, MerchantStore store) {
+        if (principal == null) throw new RestApiException("401", "Customer authentication is required");
+        try {
+            Customer customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+            if (customer == null) throw new ResourceNotFoundException("Customer [" + principal.getName() + "] not found");
+            return customer;
+        } catch (ResourceNotFoundException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new ResourceNotFoundException("Customer [" + principal.getName() + "] not found");
+        }
+    }
+
+    private Product product(String sku, MerchantStore store) {
+        try {
+            Product product = productService.getBySku(sku, store);
+            if (product == null) throw new ResourceNotFoundException("Product sku [" + sku + "] not found");
+            return product;
+        } catch (ResourceNotFoundException e) {
+            throw e;
+        } catch (Exception e) {
+            throw new ResourceNotFoundException("Product sku [" + sku + "] not found");
+        }
+    }
+
+    private ReadableProductQuestion readable(ProductQuestion question, MerchantStore store, Language language) {
+        ReadableProductQuestion result = new ReadableProductQuestion();
+        try {
+            return new ReadableProductQuestionPopulator().populate(question, result, store, language);
+        } catch (Exception e) {
+            throw new RestApiException("500", "Unable to map product question", e);
+        }
+    }
+
+    private String askedBy(ProductQuestion question) {
+        return question.getCustomer() != null && question.getCustomer().getBilling() != null
+                ? question.getCustomer().getBilling().getFirstName() : null;
+    }
+
+    private RestApiException badRequest(ServiceException e) {
+        return new RestApiException("400", e.getMessage());
+    }
+}
