+package com.salesmanager.core.business.services.catalog.product.question;
+
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.*;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long, ProductQuestion> implements ProductQuestionService {
+    private final ProductQuestionRepository repository;
+    @Inject public ProductQuestionServiceImpl(ProductQuestionRepository repository) { super(repository); this.repository = repository; }
+    private ServiceException validation(String message) { return new ServiceException(ServiceException.EXCEPTION_VALIDATION, message); }
+    private String clean(String value, int max, String field) throws ServiceException {
+        if (value == null) throw validation(field + " is required");
+        String s = value.trim(); if (s.length() < 1 || s.length() > max) throw validation(field + " length is invalid"); return s;
+    }
+    private String cleanQuestion(String value) throws ServiceException {
+        if (value == null) throw validation("text is required");
+        String s = value.trim(); if (s.length() < 10 || s.length() > 500) throw validation("text length is invalid"); return s;
+    }
+    @Override public ProductQuestion create(Product product, Customer customer, String text) throws ServiceException { return create(product, product.getMerchantStore(), customer, text); }
+    @Override public ProductQuestion create(Product product, MerchantStore store, Customer customer, String text) throws ServiceException {
+        if (product == null || customer == null || store == null) throw validation("product, store and customer are required");
+        if (repository.countByCustomerIdAndStatus(customer.getId(), ProductQuestionStatus.PENDING) >= 3) throw validation("customer has too many pending questions");
+        ProductQuestion q = new ProductQuestion(); q.setProduct(product); q.setMerchantStore(store); q.setCustomer(customer); q.setText(cleanQuestion(text)); q.setStatus(ProductQuestionStatus.PENDING); q.setAskedAt(new java.util.Date());
+        return repository.saveAndFlush(q);
+    }
+    @Override public List<ProductQuestion> getByCustomer(Customer customer) { return repository.findByCustomerIdOrderByAskedAtDesc(customer.getId()); }
+    @Override public List<ProductQuestion> getByProduct(Product product) { return repository.findByProductIdAndStatusOrderByAnsweredAtDesc(product.getId(), ProductQuestionStatus.PUBLISHED); }
+    @Override public List<ProductQuestion> getByStore(MerchantStore store, ProductQuestionStatus status) { return repository.findByMerchantStoreIdAndStatusOrderByAskedAtAsc(store.getId(), status == null ? ProductQuestionStatus.PENDING : status); }
+    @Override public ProductQuestion answer(Long id, MerchantStore store, String answer) throws ServiceException { ProductQuestion q = repository.findById(id).orElse(null); if (q == null || !sameStore(q, store)) return null; return answer(q, answer); }
+    @Override public ProductQuestion answer(ProductQuestion q, String answer) throws ServiceException { if (q == null) return null; if (q.getStatus() == ProductQuestionStatus.REJECTED) throw new ServiceException(ServiceException.EXCEPTION_VALIDATION, "rejected question cannot be answered"); q.publish(clean(answer, 2000, "answer")); return repository.saveAndFlush(q); }
+    @Override public ProductQuestion reject(Long id, MerchantStore store) throws ServiceException { ProductQuestion q = repository.findById(id).orElse(null); if (q == null || !sameStore(q, store)) return null; return reject(q); }
+    @Override public ProductQuestion reject(ProductQuestion q) throws ServiceException { if (q == null) return null; q.reject(); return repository.saveAndFlush(q); }
+    private boolean sameStore(ProductQuestion q, MerchantStore s) { return s != null && q.getMerchantStore() != null && s.getId().equals(q.getMerchantStore().getId()); }
+}
