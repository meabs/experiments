+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.security.Principal;
+import java.util.ArrayList;
+import java.util.List;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionServiceImpl;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.catalog.product.question.ProductQuestionRequest;
+import com.salesmanager.shop.model.catalog.product.question.ProductQuestionResponse;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.api.exception.UnauthorizedException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+    @Inject private ProductQuestionService questionService;
+    @Inject private ProductService productService;
+    @Inject private CustomerService customerService;
+
+    @PostMapping("/auth/products/{sku}/questions")
+    @ResponseStatus(HttpStatus.CREATED)
+    public ProductQuestionResponse ask(@PathVariable String sku, @RequestBody ProductQuestionRequest request,
+            @ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest httpRequest) {
+        Customer customer = customer(httpRequest, store);
+        try {
+            if (productService.getBySku(sku, store) == null) throw new ResourceNotFoundException("Unknown product sku [" + sku + "]");
+        } catch (ServiceException e) {
+            throw new ResourceNotFoundException("Unknown product sku [" + sku + "]");
+        }
+        try { return full(questionService.askQuestion(sku, request == null ? null : request.getText(), customer, store)); }
+        catch (ServiceException e) { throw translate(e); }
+    }
+
+    @GetMapping("/auth/customer/questions")
+    public List<ProductQuestionResponse> mine(@ApiIgnore MerchantStore store, HttpServletRequest request) {
+        Customer customer = customer(request, store);
+        List<ProductQuestionResponse> result = new ArrayList<>();
+        for (ProductQuestion q : questionService.findByCustomer(customer)) result.add(full(q));
+        return result;
+    }
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal principal = request.getUserPrincipal();
+        if (principal == null) throw new UnauthorizedException("Customer authentication required");
+        Customer customer = customerService.getByNick(principal.getName(), store.getId().intValue());
+        if (customer == null) throw new UnauthorizedException("Customer authentication required");
+        return customer;
+    }
+    private ProductQuestionResponse full(ProductQuestion q) {
+        ProductQuestionResponse r = new ProductQuestionResponse();
+        r.setId(q.getId()); r.setSku(q.getSku()); r.setText(q.getText());
+        r.setStatus(q.getStatus() == null ? null : q.getStatus().name()); r.setAnswer(q.getAnswer());
+        r.setAskedBy(q.getAskedBy()); r.setAskedAt(q.getAskedAt()); r.setAnsweredAt(q.getAnsweredAt());
+        return r;
+    }
+    private RuntimeException translate(ServiceException e) {
+        String m = e.getMessage() == null ? "Question request failed" : e.getMessage();
+        return m.startsWith("Unknown product sku") ? new ResourceNotFoundException(m) : new ServiceRuntimeException("400", m);
+    }
+}
