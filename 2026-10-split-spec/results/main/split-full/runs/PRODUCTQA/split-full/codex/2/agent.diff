+/** Store-admin operations for product questions. */
+@RestController
+@RequestMapping("/api/v1")
+@Api(tags = { "Product questions administration" })
+public class ProductQuestionAdminApi {
+
+    @Inject
+    private ProductQuestionService productQuestionService;
+
+    @GetMapping(value = "/private/questions", produces = MediaType.APPLICATION_JSON_VALUE)
+    @ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "string", defaultValue = "DEFAULT") })
+    public List<ProductQuestion> list(
+            @RequestParam(name = "status", defaultValue = "PENDING") String status,
+            @ApiIgnore MerchantStore merchantStore) {
+        return productQuestionService.findByStoreAndStatus(merchantStore, parseStatus(status));
+    }
+
+    @PutMapping(value = "/private/questions/{id}/answer", produces = MediaType.APPLICATION_JSON_VALUE)
+    public ResponseEntity<ProductQuestion> answer(@PathVariable Long id,
+            @RequestBody AnswerRequest request, @ApiIgnore MerchantStore merchantStore) throws ServiceException {
+        ProductQuestion question = ownedQuestion(id, merchantStore);
+        // Keep validation here as well as in the service so malformed requests are
+        // consistently rejected before an update is attempted.
+        String answer = request == null || request.getAnswer() == null ? null : request.getAnswer().trim();
+        if (answer == null || answer.length() < 1 || answer.length() > 2000) {
+            throw new RestApiException("Answer must be between 1 and 2000 characters");
+        }
+        // Return the conflict directly. The application's broad exception
+        // handler assumes exceptions have causes, which is not true for a
+        // simple domain conflict and would otherwise turn this into a 500.
+        if (question.getStatus() == ProductQuestionStatus.REJECTED) {
+            return ResponseEntity.status(HttpStatus.CONFLICT).build();
+        }
+        try {
+            return ResponseEntity.ok(productQuestionService.answer(question.getId(), answer));
+        } catch (ServiceException e) {
+            throw new RestApiException(e.getMessage(), e);
+        }
+    }
+
+    @PutMapping(value = "/private/questions/{id}/reject", produces = MediaType.APPLICATION_JSON_VALUE)
+    public ResponseEntity<ProductQuestion> reject(@PathVariable Long id,
+            @ApiIgnore MerchantStore merchantStore) throws ServiceException {
+        ProductQuestion question = ownedQuestion(id, merchantStore);
+        return ResponseEntity.ok(productQuestionService.reject(question.getId()));
+    }
+
+    private ProductQuestion ownedQuestion(Long id, MerchantStore store) {
+        ProductQuestion question = productQuestionService.lookup(id);
+        if (question == null) {
+            throw new ResourceNotFoundException("Unknown question id [" + id + "]");
+        }
+        if (store == null || question.getProduct() == null || question.getProduct().getMerchantStore() == null
+                || !store.getId().equals(question.getProduct().getMerchantStore().getId())) {
+            throw new ResourceNotFoundException("Question id [" + id + "] not found for this store");
+        }
+        return question;
+    }
+
+    private ProductQuestionStatus parseStatus(String value) {
+        try {
+            return ProductQuestionStatus.valueOf(value == null ? "" : value.trim().toUpperCase());
+        } catch (IllegalArgumentException e) {
+            throw new RestApiException("Invalid question status [" + value + "]");
+        }
+    }
+
+    public static class AnswerRequest {
+        private String answer;
+        public String getAnswer() { return answer; }
+        public void setAnswer(String answer) { this.answer = answer; }
+    }
+
+}
