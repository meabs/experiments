+package com.salesmanager.core.business.services.catalog.product.question;
+
+import java.util.Collections;
+import java.util.Date;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long, ProductQuestion> implements ProductQuestionService {
+    private final ProductQuestionRepository repository;
+    private final ProductService productService;
+
+    @Inject
+    public ProductQuestionServiceImpl(ProductQuestionRepository repository, ProductService productService) {
+        super(repository);
+        this.repository = repository;
+        this.productService = productService;
+    }
+
+    @Override
+    public ProductQuestion askQuestion(String sku, String text, Customer customer, MerchantStore store) throws ServiceException {
+        if (customer == null || store == null) throw validation("Customer and store are required");
+        String value = text == null ? null : text.trim();
+        if (value == null || value.length() < 10 || value.length() > 500) throw validation("Question must be between 10 and 500 characters");
+        if (repository.countPendingByCustomer(customer.getId()) >= 3) throw validation("A customer may have at most 3 pending questions");
+        Product product = productService.getBySku(sku, store);
+        ProductQuestion q = new ProductQuestion();
+        q.setProduct(product); q.setCustomer(customer); q.setText(value);
+        q.setStatus(ProductQuestionStatus.PENDING); q.setAskedAt(new Date());
+        return repository.saveAndFlush(q);
+    }
+
+    private ServiceException validation(String message) { return new ServiceException(ServiceException.EXCEPTION_VALIDATION, message); }
+    public List<ProductQuestion> findByCustomer(Customer customer) { return customer == null ? Collections.emptyList() : repository.findByCustomer(customer.getId()); }
+    public List<ProductQuestion> findByStoreAndStatus(MerchantStore store, ProductQuestionStatus status) { return store == null || status == null ? Collections.emptyList() : repository.findByStoreAndStatus(store.getId(), status); }
+    public List<ProductQuestion> findPublicBySku(String sku, MerchantStore store) throws ServiceException {
+        if (store == null || !productService.exists(sku, store)) throw new ServiceException("Unknown product sku [" + sku + "]");
+        return repository.findPublishedBySku(store.getId(), sku);
+    }
+    public ProductQuestion lookup(Long id) { return repository.findOne(id); }
+    public ProductQuestion answer(Long id, String answer) throws ServiceException {
+        ProductQuestion q = required(id);
+        if (q.getStatus() == ProductQuestionStatus.REJECTED) throw new ServiceException(ServiceException.EXCEPTION_VALIDATION, "Rejected questions cannot be answered");
+        String value = answer == null ? null : answer.trim();
+        if (value == null || value.length() < 1 || value.length() > 2000) throw validation("Answer must be between 1 and 2000 characters");
+        q.setAnswer(value); q.setStatus(ProductQuestionStatus.PUBLISHED); q.setAnsweredAt(new Date());
+        return repository.saveAndFlush(q);
+    }
+    public ProductQuestion reject(Long id) throws ServiceException { ProductQuestion q = required(id); q.setStatus(ProductQuestionStatus.REJECTED); return repository.saveAndFlush(q); }
+    private ProductQuestion required(Long id) throws ServiceException { ProductQuestion q = repository.findOne(id); if (q == null) throw new ServiceException("Unknown question id [" + id + "]"); return q; }
+}
