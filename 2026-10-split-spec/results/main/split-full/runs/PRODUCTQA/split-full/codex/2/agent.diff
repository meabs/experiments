+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.ArrayList;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.catalog.product.question.PublicProductQuestionList;
+import com.salesmanager.shop.model.catalog.product.question.PublicProductQuestionResponse;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/products")
+public class ProductQuestionApi {
+    @Inject private ProductQuestionService questionService;
+
+    @GetMapping("/{sku}/questions")
+    public PublicProductQuestionList list(@PathVariable String sku, @ApiIgnore MerchantStore store,
+            @ApiIgnore Language language) {
+        try {
+            List<PublicProductQuestionResponse> items = new ArrayList<>();
+            for (ProductQuestion q : questionService.findPublicBySku(sku, store)) {
+                PublicProductQuestionResponse r = new PublicProductQuestionResponse();
+                r.setId(q.getId()); r.setText(q.getText()); r.setAnswer(q.getAnswer());
+                r.setAskedBy(q.getAskedBy()); r.setAnsweredAt(q.getAnsweredAt()); items.add(r);
+            }
+            PublicProductQuestionList result = new PublicProductQuestionList();
+            result.setCount(items.size()); result.setItems(items); return result;
+        } catch (ServiceException e) {
+            String m = e.getMessage() == null ? "Product not found" : e.getMessage();
+            if (m.startsWith("Unknown product sku")) throw new ResourceNotFoundException(m);
+            throw new ServiceRuntimeException("400", m);
+        }
+    }
+}
