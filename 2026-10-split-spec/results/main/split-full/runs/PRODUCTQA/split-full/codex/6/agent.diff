+import com.salesmanager.shop.store.api.exception.RestApiException;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.product.facade.ProductQuestionFacade;
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+    @Inject private ProductQuestionFacade questionFacade;
+    @Inject private CustomerFacade customerFacade;
+
+    @PostMapping("/auth/products/{sku}/questions")
+    @ResponseStatus(HttpStatus.CREATED)
+    @ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT") })
+    public ReadableProductQuestion ask(@PathVariable String sku, @RequestBody PersistableProductQuestion body,
+            @ApiIgnore MerchantStore store, HttpServletRequest request) {
+        Customer customer = customer(request, store);
+        if (body == null || StringUtils.isBlank(body.getText())) throw new RestApiException("Question text is required");
+        try { body.setText(body.getText().trim()); return questionFacade.ask(sku, body, customer, store); }
+        catch (java.util.NoSuchElementException e) { throw new ResourceNotFoundException(e.getMessage()); }
+        catch (IllegalArgumentException e) { throw new RestApiException(e.getMessage()); }
+    }
+
+    @GetMapping("/auth/customer/questions")
+    @ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT") })
+    public ReadableProductQuestionList customerQuestions(@ApiIgnore MerchantStore store, HttpServletRequest request) {
+        return questionFacade.getCustomerQuestions(customer(request, store), store);
+    }
+
+    @GetMapping("/products/{sku}/questions")
+    @ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT") })
+    public ProductQuestionList publicQuestions(@PathVariable String sku, @ApiIgnore MerchantStore store) {
+        try {
+            ReadableProductQuestionList full = questionFacade.getPublishedQuestions(sku, store);
+            ProductQuestionList result = new ProductQuestionList();
+            for (ReadableProductQuestion q : full.getItems()) {
+                ReadableProductQuestionPublic p = new ReadableProductQuestionPublic();
+                p.setId(q.getId()); p.setText(q.getText()); p.setAnswer(q.getAnswer());
+                p.setAskedBy(q.getAskedBy()); p.setAnsweredAt(q.getAnsweredAt());
+                result.getItems().add(p);
+            }
+            result.setCount(result.getItems().size());
+            return result;
+        }
+        catch (java.util.NoSuchElementException e) { throw new ResourceNotFoundException(e.getMessage()); }
+    }
+
+    @GetMapping("/private/questions")
+    @ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT") })
+    public ReadableProductQuestionList adminQuestions(@RequestParam(value="status", required=false, defaultValue="PENDING") String status,
+            @ApiIgnore MerchantStore store) {
+        if (!"PENDING".equals(status) && !"PUBLISHED".equals(status) && !"REJECTED".equals(status)) throw new RestApiException("Invalid question status: " + status);
+        return questionFacade.getAdminQuestions(status, store);
+    }
+
+    @PutMapping("/private/questions/{id}/answer")
+    public ReadableProductQuestion answer(@PathVariable Long id, @RequestBody PersistableProductQuestion body, @ApiIgnore MerchantStore store) {
+        if (body == null || StringUtils.isBlank(body.getAnswer())) throw new RestApiException("Answer is required");
+        try { body.setAnswer(body.getAnswer().trim()); return questionFacade.answer(id, body, store); }
+        catch (java.util.NoSuchElementException e) { throw new ResourceNotFoundException(e.getMessage()); }
+        catch (IllegalStateException e) { throw new QuestionConflictException(e.getMessage()); }
+        catch (IllegalArgumentException e) { throw new RestApiException(e.getMessage()); }
+    }
+
+    @PutMapping("/private/questions/{id}/reject")
+    public ReadableProductQuestion reject(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        try { return questionFacade.reject(id, store); }
+        catch (java.util.NoSuchElementException e) { throw new ResourceNotFoundException(e.getMessage()); }
+    }
+
+    private Customer customer(HttpServletRequest request, MerchantStore store) {
+        Principal principal = request == null ? null : request.getUserPrincipal();
+        if (principal == null || StringUtils.isBlank(principal.getName())) throw new ResourceNotFoundException("Authenticated customer not found");
+        Customer result = customerFacade.getCustomerByUserName(principal.getName(), store);
+        if (result == null) throw new ResourceNotFoundException("Customer [" + principal.getName() + "] not found");
+        return result;
+    }
+
+    @ExceptionHandler(QuestionConflictException.class)
+    @ResponseStatus(HttpStatus.CONFLICT)
+    public String conflict(QuestionConflictException exception) { return exception.getMessage(); }
+}
