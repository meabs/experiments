+
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+
+public interface ProductQuestionRepository extends JpaRepository<ProductQuestion, Long> {
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch q.customer c "
+            + "where p.id = :productId and p.merchantStore.id = :storeId and q.status = :status order by q.answeredAt desc, q.askedAt desc")
+    List<ProductQuestion> findPublishedByProduct(@Param("productId") Long productId, @Param("storeId") Integer storeId,
+            @Param("status") ProductQuestionStatus status);
+
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch q.customer c "
+            + "where c.id = :customerId and p.merchantStore.id = :storeId order by q.askedAt desc")
+    List<ProductQuestion> findByCustomerAndStore(@Param("customerId") Long customerId, @Param("storeId") Integer storeId);
+
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch q.customer c "
+            + "where p.merchantStore.id = :storeId and q.status = :status order by q.askedAt asc")
+    List<ProductQuestion> findByStoreAndStatus(@Param("storeId") Integer storeId, @Param("status") ProductQuestionStatus status);
+
+    @Query("select count(q) from ProductQuestion q where q.customer.id = :customerId and q.product.merchantStore.id = :storeId and q.status = :status")
+    long countByCustomerAndStoreAndStatus(@Param("customerId") Long customerId, @Param("storeId") Integer storeId,
+            @Param("status") ProductQuestionStatus status);
+
+    @Query("select q from ProductQuestion q join fetch q.product p join fetch q.customer c where q.id = :id and p.merchantStore.id = :storeId")
+    ProductQuestion findByIdAndStore(@Param("id") Long id, @Param("storeId") Integer storeId);
+
+    @Query("select p.id from Product p where p.sku = :sku and p.merchantStore.id = :storeId")
+    Long findProductIdBySku(@Param("sku") String sku, @Param("storeId") Integer storeId);
+}
