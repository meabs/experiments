@@ -0,0 +1,89 @@
+package com.salesmanager.core.business.services.catalog.product.question;
+
+import java.util.Date;
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.salesmanager.core.business.repositories.catalog.product.ProductRepository;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productQuestionService")
+@Transactional
+public class ProductQuestionServiceImpl implements ProductQuestionService {
+    private static final int MAX_PENDING = 3;
+    private final ProductQuestionRepository repository;
+    private final ProductRepository productRepository;
+
+    @Inject
+    public ProductQuestionServiceImpl(ProductQuestionRepository repository, ProductRepository productRepository) {
+        this.repository = repository;
+        this.productRepository = productRepository;
+    }
+
+    @Override
+    public ProductQuestion ask(Product product, Customer customer, String text) {
+        require(product, "product"); require(customer, "customer");
+        String value = text == null ? null : text.trim();
+        validate(value, 10, 500, "Question");
+        Integer storeId = product.getMerchantStore().getId();
+        if (repository.countByCustomerAndStoreAndStatus(customer.getId(), storeId, ProductQuestionStatus.PENDING) >= MAX_PENDING) {
+            throw new IllegalArgumentException("A customer may have at most 3 pending questions");
+        }
+        ProductQuestion question = new ProductQuestion();
+        question.setProduct(product); question.setCustomer(customer); question.setText(value);
+        question.setStatus(ProductQuestionStatus.PENDING); question.setAskedAt(new Date());
+        return repository.save(question);
+    }
+
+    @Override public List<ProductQuestion> listByCustomer(Customer customer, MerchantStore store) {
+        require(customer, "customer"); require(store, "store");
+        return repository.findByCustomerAndStore(customer.getId(), store.getId());
+    }
+    @Override public List<ProductQuestion> listPublished(Product product, MerchantStore store) {
+        require(product, "product"); require(store, "store");
+        return repository.findPublishedByProduct(product.getId(), store.getId(), ProductQuestionStatus.PUBLISHED);
+    }
+    @Override public List<ProductQuestion> listByStatus(MerchantStore store, ProductQuestionStatus status) {
+        require(store, "store"); require(status, "status");
+        return repository.findByStoreAndStatus(store.getId(), status);
+    }
+    @Override public ProductQuestion answer(Long id, MerchantStore store, String answer) {
+        ProductQuestion q = getById(id, store);
+        if (q.getStatus() == ProductQuestionStatus.REJECTED) throw new IllegalStateException("Rejected question cannot be answered");
+        String value = answer == null ? null : answer.trim();
+        validate(value, 1, 2000, "Answer");
+        q.setAnswer(value); q.setStatus(ProductQuestionStatus.PUBLISHED); q.setAnsweredAt(new Date());
+        return repository.save(q);
+    }
+    @Override public ProductQuestion reject(Long id, MerchantStore store) {
+        ProductQuestion q = getById(id, store); q.setStatus(ProductQuestionStatus.REJECTED); return repository.save(q);
+    }
+    @Override public ProductQuestion getById(Long id, MerchantStore store) {
+        require(store, "store");
+        ProductQuestion q = repository.findByIdAndStore(id, store.getId());
+        if (q == null) throw new java.util.NoSuchElementException("Unknown product question: " + id);
+        return q;
+    }
+    @Override public ProductQuestion getById(Long id) {
+        return repository.findById(id).orElseThrow(() -> new java.util.NoSuchElementException("Unknown product question: " + id));
+    }
+    @Override public Product findProductBySku(String sku, MerchantStore store) {
+        require(store, "store");
+        Long id = repository.findProductIdBySku(sku == null ? null : sku.trim(), store.getId());
+        if (id == null) throw new java.util.NoSuchElementException("Unknown product SKU: " + sku);
+        return productRepository.findById(id).orElseThrow(() -> new java.util.NoSuchElementException("Unknown product SKU: " + sku));
+    }
+    private static void validate(String value, int min, int max, String label) {
+        if (value == null || value.length() < min || value.length() > max) throw new IllegalArgumentException(label + " must be between " + min + " and " + max + " characters");
+    }
+    private static <T> void require(T value, String name) { if (value == null) throw new IllegalArgumentException(name + " is required"); }
+}
