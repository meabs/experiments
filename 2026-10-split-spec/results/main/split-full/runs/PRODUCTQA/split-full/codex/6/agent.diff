+/** Maps core product-question entities to the deliberately small shop API models. */
+public interface ProductQuestionFacade {
+    ReadableProductQuestion ask(String sku, PersistableProductQuestion request, Customer customer, MerchantStore store);
+    ReadableProductQuestionList getCustomerQuestions(Customer customer, MerchantStore store);
+    ReadableProductQuestionList getPublishedQuestions(String sku, MerchantStore store);
+    ReadableProductQuestionList getAdminQuestions(String status, MerchantStore store);
+    ReadableProductQuestion answer(Long id, PersistableProductQuestion request, MerchantStore store);
+    ReadableProductQuestion reject(Long id, MerchantStore store);
+    ReadableProductQuestion populate(Object question);
+    ReadableProductQuestionPublic populatePublic(Object question);
+    List<ReadableProductQuestion> populate(List<?> questions);
+    List<ReadableProductQuestionPublic> populatePublicList(List<?> questions);
+    ProductQuestionList publicList(List<?> questions);
+}
