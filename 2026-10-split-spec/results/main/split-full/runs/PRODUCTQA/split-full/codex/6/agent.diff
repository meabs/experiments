+package com.salesmanager.shop.store.controller.product.facade;
+
+import java.text.DateFormat;
+import java.text.SimpleDateFormat;
+import java.util.ArrayList;
+import java.util.Date;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestion;
+import com.salesmanager.core.model.catalog.product.question.ProductQuestionStatus;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.PersistableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestion;
+import com.salesmanager.shop.model.catalog.product.ReadableProductQuestionList;
+
+@Service("productQuestionFacade")
+public class ProductQuestionFacadeImpl implements ProductQuestionFacade {
+    private static final DateFormat ISO = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSSXXX");
+    @Inject private ProductQuestionService service;
+
+    @Override public ReadableProductQuestion ask(String sku, PersistableProductQuestion request, Customer customer, MerchantStore store) {
+        Product product = service.findProductBySku(sku, store);
+        return populate(service.ask(product, customer, request.getText()));
+    }
+    @Override public ReadableProductQuestionList getCustomerQuestions(Customer customer, MerchantStore store) { return list(service.listByCustomer(customer, store)); }
+    @Override public ReadableProductQuestionList getPublishedQuestions(String sku, MerchantStore store) { return publishedList(service.listPublished(service.findProductBySku(sku, store), store)); }
+    @Override public ReadableProductQuestionList getAdminQuestions(String status, MerchantStore store) { return list(service.listByStatus(store, ProductQuestionStatus.valueOf(status))); }
+    @Override public ReadableProductQuestion answer(Long id, PersistableProductQuestion request, MerchantStore store) { return populate(service.answer(id, store, request.getAnswer())); }
+    @Override public ReadableProductQuestion reject(Long id, MerchantStore store) { return populate(service.reject(id, store)); }
+
+    @Override public ReadableProductQuestion populate(Object q) { return populate((ProductQuestion) q); }
+    public ReadableProductQuestion populate(ProductQuestion q) {
+        ReadableProductQuestion out = new ReadableProductQuestion();
+        out.setId(q.getId()); out.setSku(q.getProduct() == null ? null : q.getProduct().getSku()); out.setText(trim(q.getText()));
+        out.setStatus(q.getStatus() == null ? null : q.getStatus().name()); out.setAnswer(trim(q.getAnswer()));
+        out.setAskedBy(q.getCustomer() == null || q.getCustomer().getBilling() == null ? null : trim(q.getCustomer().getBilling().getFirstName()));
+        out.setAskedAt(date(q.getAskedAt())); out.setAnsweredAt(date(q.getAnsweredAt())); return out;
+    }
+    @Override public List<ReadableProductQuestion> populate(List<?> qs) { List<ReadableProductQuestion> out = new ArrayList<>(); if (qs != null) for (Object q : qs) out.add(populate(q)); return out; }
+    @Override public com.salesmanager.shop.model.catalog.product.ReadableProductQuestionPublic populatePublic(Object q) { ReadableProductQuestion f = populate(q); com.salesmanager.shop.model.catalog.product.ReadableProductQuestionPublic p = new com.salesmanager.shop.model.catalog.product.ReadableProductQuestionPublic(); p.setId(f.getId()); p.setText(f.getText()); p.setAnswer(f.getAnswer()); p.setAskedBy(f.getAskedBy()); p.setAnsweredAt(f.getAnsweredAt()); return p; }
+    @Override public List<com.salesmanager.shop.model.catalog.product.ReadableProductQuestionPublic> populatePublicList(List<?> qs) { List<com.salesmanager.shop.model.catalog.product.ReadableProductQuestionPublic> out = new ArrayList<>(); if (qs != null) for (Object q : qs) out.add(populatePublic(q)); return out; }
+    @Override public com.salesmanager.shop.model.catalog.product.ProductQuestionList publicList(List<?> qs) { com.salesmanager.shop.model.catalog.product.ProductQuestionList out = new com.salesmanager.shop.model.catalog.product.ProductQuestionList(); out.setItems(populatePublicList(qs)); return out; }
+    private ReadableProductQuestionList list(List<ProductQuestion> qs) { ReadableProductQuestionList out = new ReadableProductQuestionList(); out.setItems(populate(qs)); return out; }
+    private ReadableProductQuestionList publishedList(List<ProductQuestion> qs) { ReadableProductQuestionList out = new ReadableProductQuestionList(); List<ReadableProductQuestion> items = new ArrayList<>(); for (ProductQuestion q : qs) items.add(populate(q)); out.setItems(items); return out; }
+    private static String trim(String s) { return s == null ? null : s.trim(); }
+    private static String date(Date d) { if (d == null) return null; synchronized (ISO) { return ISO.format(d); } }
+}
