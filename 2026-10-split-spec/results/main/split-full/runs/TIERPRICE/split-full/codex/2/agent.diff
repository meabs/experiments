+package com.salesmanager.shop.store.api.v1.product;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+import javax.inject.Inject;
+import org.springframework.http.MediaType;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class ProductTierApi {
+    @Inject private ProductService productService;
+    @GetMapping(value="/private/product/{id}/tiers", produces=MediaType.APPLICATION_JSON_VALUE)
+    public List<com.salesmanager.shop.model.catalog.product.ProductTier> get(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        return readable(productService.getTiers(product(id, store)));
+    }
+    @PutMapping(value="/private/product/{id}/tiers", produces=MediaType.APPLICATION_JSON_VALUE)
+    public List<com.salesmanager.shop.model.catalog.product.ProductTier> replace(@PathVariable Long id, @RequestBody List<com.salesmanager.shop.model.catalog.product.ProductTier> input, @ApiIgnore MerchantStore store) {
+        Product product = product(id, store);
+        List<com.salesmanager.shop.model.catalog.product.ProductTier> sorted = validate(input);
+        List<ProductTier> values = new ArrayList<ProductTier>();
+        for (com.salesmanager.shop.model.catalog.product.ProductTier tier : sorted) { ProductTier value = new ProductTier(); value.setMinQuantity(tier.getMinQuantity()); value.setPrice(tier.getPrice()); values.add(value); }
+        try { productService.replaceTiers(product, values); } catch (IllegalArgumentException e) { throw new RestApiException("400", e.getMessage(), e); }
+        return readable(productService.getTiers(product));
+    }
+    private Product product(Long id, MerchantStore store) { return productService.retrieveById(id, store).orElseThrow(() -> new ResourceNotFoundException("Product with id [" + id + "] not found")); }
+    private List<com.salesmanager.shop.model.catalog.product.ProductTier> validate(List<com.salesmanager.shop.model.catalog.product.ProductTier> input) {
+        if (input == null || input.size() > 10) throw new RestApiException("400", "Invalid product tiers");
+        List<com.salesmanager.shop.model.catalog.product.ProductTier> sorted = new ArrayList<com.salesmanager.shop.model.catalog.product.ProductTier>(input);
+        sorted.sort(Comparator.comparing(com.salesmanager.shop.model.catalog.product.ProductTier::getMinQuantity, Comparator.nullsFirst(Comparator.naturalOrder())));
+        Set<Integer> seen = new HashSet<Integer>(); BigDecimal previous = null;
+        for (com.salesmanager.shop.model.catalog.product.ProductTier tier : sorted) { if (tier == null || tier.getMinQuantity() == null || tier.getPrice() == null || tier.getMinQuantity() < 2 || tier.getPrice().compareTo(BigDecimal.ZERO) <= 0 || !seen.add(tier.getMinQuantity())) throw new RestApiException("400", "Invalid product tiers"); if (previous != null && tier.getPrice().compareTo(previous) >= 0) throw new RestApiException("400", "Higher quantity tiers must have lower prices"); previous = tier.getPrice(); }
+        return sorted;
+    }
+    private List<com.salesmanager.shop.model.catalog.product.ProductTier> readable(List<ProductTier> source) { List<com.salesmanager.shop.model.catalog.product.ProductTier> result = new ArrayList<com.salesmanager.shop.model.catalog.product.ProductTier>(); if (source != null) for (ProductTier tier : source) { com.salesmanager.shop.model.catalog.product.ProductTier value = new com.salesmanager.shop.model.catalog.product.ProductTier(); value.setMinQuantity(tier.getMinQuantity()); value.setPrice(tier.getPrice()); result.add(value); } result.sort(Comparator.comparing(com.salesmanager.shop.model.catalog.product.ProductTier::getMinQuantity)); return result; }
+}
