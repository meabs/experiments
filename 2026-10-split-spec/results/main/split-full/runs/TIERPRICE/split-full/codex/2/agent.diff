+	@Override
+	public List<ProductTier> getTiers(Product product) {
+		Validate.notNull(product, "product cannot be null");
+		List<ProductTier> result = new ArrayList<ProductTier>();
+		if (product.getTiers() != null) {
+			result.addAll(product.getTiers());
+		}
+		result.sort(Comparator.comparing(ProductTier::getMinQuantity));
+		return result;
+	}
+
+	@Override
+	public void replaceTiers(Product product, Collection<ProductTier> tiers) {
+		Validate.notNull(product, "product cannot be null");
+		List<ProductTier> replacement = validateTiers(tiers);
+		// Validation is completed before touching the managed collection, so a rejected
+		// request leaves the existing aggregate unchanged.
+		Set<ProductTier> stored = new java.util.LinkedHashSet<ProductTier>();
+		for (ProductTier tier : replacement) {
+			tier.setProduct(product);
+			stored.add(tier);
+		}
+		product.setTiers(stored);
+		productRepository.saveAndFlush(product);
+	}
+
+	@Override
+	public List<ProductTier> getTiers(Long productId, MerchantStore merchant) {
+		return getTiers(findOne(productId, merchant));
+	}
+
+	@Override
+	public void replaceTiers(Long productId, MerchantStore merchant, Collection<ProductTier> tiers) {
+		replaceTiers(findOne(productId, merchant), tiers);
+	}
+
+	private List<ProductTier> validateTiers(Collection<ProductTier> tiers) {
+		Validate.notNull(tiers, "tiers cannot be null");
+		if (tiers.size() > 10) {
+			throw new IllegalArgumentException("A product may have at most 10 tiers");
+		}
+		List<ProductTier> sorted = new ArrayList<ProductTier>(tiers);
+		sorted.sort(Comparator.nullsFirst(Comparator.comparing(ProductTier::getMinQuantity,
+				Comparator.nullsFirst(Integer::compareTo))));
+		Integer previousQuantity = null;
+		BigDecimal previousPrice = null;
+		for (ProductTier tier : sorted) {
+			if (tier == null || tier.getMinQuantity() == null || tier.getMinQuantity() < 2
+					|| tier.getPrice() == null || tier.getPrice().compareTo(BigDecimal.ZERO) <= 0) {
+				throw new IllegalArgumentException("Each tier requires minQuantity >= 2 and price > 0");
+			}
+			if (previousQuantity != null && tier.getMinQuantity().equals(previousQuantity)) {
+				throw new IllegalArgumentException("Tier minQuantity values must be unique");
+			}
+			if (previousPrice != null && tier.getPrice().compareTo(previousPrice) >= 0) {
+				throw new IllegalArgumentException("Higher quantity tiers must have lower prices");
+			}
+			previousQuantity = tier.getMinQuantity();
+			previousPrice = tier.getPrice();
+		}
+		return sorted;
+	}
+
 
 
 }
