+	/** Applies the current product tiers after base (including special) pricing has been resolved. */
+	private void applyQuantityTiers(final ShoppingCart cart, final OrderTotalSummary summary) {
+		BigDecimal delta = BigDecimal.ZERO;
+		if (cart.getLineItems() == null) return;
+		for (ShoppingCartItem item : cart.getLineItems()) {
+			if (item.getProduct() == null || item.getItemPrice() == null || item.getQuantity() == null) continue;
+			BigDecimal ownPrice = item.getItemPrice();
+			BigDecimal tierPrice = null;
+			// Sets are ordered by minQuantity, so the final reached tier wins.
+			if (item.getProduct().getTiers() != null) {
+				for (ProductTier tier : item.getProduct().getTiers())
+					if (tier.getMinQuantity() != null && tier.getMinQuantity() <= item.getQuantity()
+							&& tier.getPrice() != null) tierPrice = tier.getPrice();
+			}
+			if (tierPrice != null && tierPrice.compareTo(ownPrice) < 0) {
+				item.setItemPrice(tierPrice);
+				BigDecimal change = tierPrice.subtract(ownPrice).multiply(BigDecimal.valueOf(item.getQuantity()));
+				item.setSubTotal(tierPrice.multiply(BigDecimal.valueOf(item.getQuantity())));
+				delta = delta.add(change);
+			} else {
+				item.setSubTotal(ownPrice.multiply(BigDecimal.valueOf(item.getQuantity())));
+			}
+		}
+		if (summary != null && delta.signum() != 0) {
+			summary.setSubTotal(summary.getSubTotal().add(delta));
+			summary.setTotal(summary.getTotal().add(delta));
+			if (summary.getTotals() != null) for (com.salesmanager.core.model.order.OrderTotal total : summary.getTotals()) {
+				if (total.getOrderTotalCode() != null && total.getOrderTotalCode().contains("subtotal")) total.setValue(total.getValue().add(delta));
+				if (total.getOrderTotalCode() != null && total.getOrderTotalCode().equals("order.total.total")) total.setValue(total.getValue().add(delta));
+			}
+		}
+	}
+
 }
