@@ -0,0 +1,127 @@
+package com.salesmanager.core.business.services.catalog.product;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Optional;
+import java.util.Set;
+
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.repositories.catalog.product.ProductRepository;
+import com.salesmanager.core.business.repositories.catalog.product.ProductTierRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productTierService")
+public class ProductTierServiceImpl implements ProductTierService {
+	private final ProductTierRepository tierRepository;
+	private final ProductRepository productRepository;
+
+	@Inject
+	public ProductTierServiceImpl(ProductTierRepository tierRepository, ProductRepository productRepository) {
+		this.tierRepository = tierRepository;
+		this.productRepository = productRepository;
+	}
+
+	@Override
+	@Transactional
+	public List<ProductTier> getTiers(Long productId, MerchantStore store) {
+		Product product = productForStore(productId, store);
+		if (product == null) {
+			return null;
+		}
+		return tierRepository.findByProductIdOrderByMinQuantityAsc(productId);
+	}
+
+	@Override
+	@Transactional
+	public List<ProductTier> replaceTiers(Long productId, MerchantStore store, List<ProductTier> tiers) {
+		Product product = productForStore(productId, store);
+		if (product == null) {
+			return null;
+		}
+		List<ProductTier> replacement = tiers == null ? Collections.<ProductTier>emptyList() : tiers;
+		validate(replacement);
+
+		// Validation is deliberately complete before this delete: rejected requests
+		// therefore leave the previous set untouched.
+		tierRepository.deleteByProductId(productId);
+		List<ProductTier> stored = new ArrayList<ProductTier>(replacement.size());
+		for (ProductTier tier : replacement) {
+			tier.setId(null);
+			tier.setProduct(product);
+			stored.add(tier);
+		}
+		if (!stored.isEmpty()) {
+			tierRepository.saveAll(stored);
+		}
+		return tierRepository.findByProductIdOrderByMinQuantityAsc(productId);
+	}
+
+	@Override
+	@Transactional
+	public BigDecimal priceForQuantity(Product product, int quantity) {
+		if (product == null || quantity < 1) {
+			return null;
+		}
+		List<ProductTier> tiers = product.getTiers();
+		if (tiers == null || tiers.isEmpty() || product.getId() == null) {
+			return bestTier(tiers, quantity);
+		}
+		// A detached product may not have initialized tiers; use the repository
+		// while preserving the same deterministic ordering.
+		return bestTier(tierRepository.findByProductIdOrderByMinQuantityAsc(product.getId()), quantity);
+	}
+
+	private BigDecimal bestTier(List<ProductTier> tiers, int quantity) {
+		BigDecimal result = null;
+		int selectedQuantity = -1;
+		if (tiers != null) {
+			for (ProductTier tier : tiers) {
+				if (tier != null && tier.getMinQuantity() != null && tier.getMinQuantity() <= quantity
+						&& tier.getPrice() != null) {
+					if (tier.getMinQuantity() > selectedQuantity) {
+						selectedQuantity = tier.getMinQuantity();
+						result = tier.getPrice();
+					}
+				}
+			}
+		}
+		return result;
+	}
+
+	private void validate(List<ProductTier> tiers) {
+		if (tiers.size() > 10) throw new IllegalArgumentException("A product may have at most 10 tiers");
+		Set<Integer> quantities = new HashSet<Integer>();
+		List<ProductTier> ordered = new ArrayList<ProductTier>(tiers);
+		for (ProductTier tier : ordered) {
+			if (tier == null || tier.getMinQuantity() == null || tier.getMinQuantity() < 2
+					|| tier.getPrice() == null || tier.getPrice().compareTo(BigDecimal.ZERO) <= 0) {
+				throw new IllegalArgumentException("Tier quantity must be at least 2 and price must be positive");
+			}
+			if (!quantities.add(tier.getMinQuantity())) throw new IllegalArgumentException("Duplicate tier quantity");
+		}
+		ordered.sort(Comparator.comparing(ProductTier::getMinQuantity));
+		for (int i = 1; i < ordered.size(); i++) {
+			if (ordered.get(i).getPrice().compareTo(ordered.get(i - 1).getPrice()) >= 0) {
+				throw new IllegalArgumentException("Higher quantities must have lower prices");
+			}
+		}
+	}
+
+	private Product productForStore(Long id, MerchantStore store) {
+		if (id == null || store == null || store.getId() == null) return null;
+		Optional<Product> found = productRepository.findById(id);
+		if (!found.isPresent() || found.get().getMerchantStore() == null
+				|| !store.getId().equals(found.get().getMerchantStore().getId())) return null;
+		return found.get();
+	}
+}
