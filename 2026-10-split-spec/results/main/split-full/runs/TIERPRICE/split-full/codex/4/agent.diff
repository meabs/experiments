+import springfox.documentation.annotations.ApiIgnore;
+
+/** Administrative quantity-tier management for products. */
+@Controller
+@RequestMapping("/api/v1")
+@Api(tags = { "Product quantity tiers" })
+public class ProductTierApi {
+    @Inject
+    private ProductService productService;
+
+    @Inject
+    private ProductTierService productTierService;
+
+    @ResponseStatus(HttpStatus.OK)
+    @RequestMapping(value = "/private/product/{id}/tiers", method = RequestMethod.GET)
+    @ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT") })
+    public @ResponseBody List<ReadableProductTier> get(@PathVariable Long id,
+            @ApiIgnore MerchantStore merchantStore) {
+        Product product = product(id, merchantStore);
+        return readable(productTierService.getTiers(product));
+    }
+
+    @ResponseStatus(HttpStatus.OK)
+    @RequestMapping(value = "/private/product/{id}/tiers", method = RequestMethod.PUT)
+    @ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT") })
+    public @ResponseBody List<ReadableProductTier> replace(@PathVariable Long id,
+            @Valid @RequestBody List<@Valid PersistableProductTier> tiers,
+            @ApiIgnore MerchantStore merchantStore) {
