+package com.salesmanager.core.business.services.catalog.product;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+import javax.inject.Inject;
+
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.salesmanager.core.business.repositories.catalog.product.ProductTierRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductTier;
+import com.salesmanager.core.model.catalog.product.ProductTierDto;
+
+@Service("productTierService")
+public class ProductTierServiceImpl implements ProductTierService {
+    private final ProductTierRepository repository;
+
+    @Inject
+    public ProductTierServiceImpl(ProductTierRepository repository) {
+        this.repository = repository;
+    }
+
+    @Override
+    @Transactional(readOnly = true)
+    public List<ProductTier> getTiers(Product product) {
+        if (product == null || product.getId() == null) return Collections.emptyList();
+        return getTiers(product.getId());
+    }
+
+    @Override
+    @Transactional(readOnly = true)
+    public List<ProductTier> getTiers(Long productId) {
+        if (productId == null) return Collections.emptyList();
+        return repository.findByProductId(productId);
+    }
+
+    /** Validates the entire request before deleting or saving any existing tier. */
+    @Override
+    @Transactional
+    public List<ProductTier> replaceTiers(Product product, List<ProductTierDto> requested) {
+        if (product == null || product.getId() == null) {
+            throw new IllegalArgumentException("Product is required");
+        }
+        List<ProductTierDto> input = requested == null ? Collections.<ProductTierDto>emptyList() : requested;
+        validate(input);
+
+        // Validation is deliberately complete before this point: a rejected request cannot mutate storage.
+        repository.deleteByProductId(product.getId());
+        repository.flush();
+        List<ProductTier> result = new ArrayList<ProductTier>(input.size());
+        for (ProductTierDto dto : input) {
+            ProductTier tier = new ProductTier(dto.getMinQuantity(), dto.getPrice());
+            tier.setProduct(product);
+            result.add(tier);
+        }
+        return repository.saveAll(result);
+    }
+
+    private void validate(List<ProductTierDto> tiers) {
+        if (tiers.size() > 10) throw new IllegalArgumentException("At most 10 tiers are allowed");
+        Set<Integer> quantities = new HashSet<Integer>();
+        List<ProductTierDto> ordered = new ArrayList<ProductTierDto>(tiers);
+        for (ProductTierDto tier : ordered) {
+            if (tier == null || tier.getMinQuantity() == null || tier.getPrice() == null) {
+                throw new IllegalArgumentException("minQuantity and price are required");
+            }
+            if (tier.getMinQuantity() < 2 || !quantities.add(tier.getMinQuantity())) {
+                throw new IllegalArgumentException("minQuantity must be unique and at least 2");
+            }
+            if (tier.getPrice().compareTo(BigDecimal.ZERO) <= 0) {
+                throw new IllegalArgumentException("price must be greater than zero");
+            }
+        }
+        Collections.sort(ordered, Comparator.comparing(ProductTierDto::getMinQuantity));
+        for (int i = 1; i < ordered.size(); i++) {
+            if (ordered.get(i).getPrice().compareTo(ordered.get(i - 1).getPrice()) >= 0) {
+                throw new IllegalArgumentException("Higher quantities must have lower prices");
+            }
+        }
+    }
+}
