@@ -0,0 +1,64 @@
+package com.salesmanager.core.business.services.shoppingcart;
+
+import java.lang.reflect.Method;
+import java.math.BigDecimal;
+import java.util.Collection;
+
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.shoppingcart.ShoppingCartItem;
+
+/** Applies the product's quantity tiers to a cart line. Kept here so every
+ * cart calculation uses the same, product-local pricing rule. */
+final class ShoppingCartTierPricing {
+    private ShoppingCartTierPricing() { }
+
+    static void apply(ShoppingCartItem item) {
+        if (item == null || item.getProduct() == null || item.getItemPrice() == null
+                || item.getQuantity() == null) return;
+        // itemPrice is transient and may contain the tier selected by a
+        // previous calculation. Restore the effective catalogue price first.
+        if (item.getFinalPrice() != null && item.getFinalPrice().getFinalPrice() != null) {
+            item.setItemPrice(item.getFinalPrice().getFinalPrice());
+        }
+        Object tiers = invokeNoArg(item.getProduct(), "getTiers", "getPriceTiers", "getQuantityPriceTiers");
+        if (!(tiers instanceof Collection<?>)) return;
+        BigDecimal selected = null;
+        int selectedMin = -1;
+        int quantity = item.getQuantity();
+        for (Object tier : (Collection<?>) tiers) {
+            Number min = number(tier, "getMinQuantity", "getMinimumQuantity");
+            BigDecimal price = decimal(tier, "getPrice", "getTierPrice");
+            if (min != null && price != null && min.intValue() <= quantity
+                    && min.intValue() > selectedMin) {
+                selected = price;
+                selectedMin = min.intValue();
+            }
+        }
+        // A tier is a discount only; never make a line more expensive than its
+        // effective product price (which may already include a special price).
+        if (selected != null && selected.compareTo(item.getItemPrice()) < 0) {
+            item.setItemPrice(selected);
+        }
+        item.setSubTotal(item.getItemPrice().multiply(BigDecimal.valueOf(quantity)));
+    }
+
+    private static Object invokeNoArg(Object target, String... names) {
+        for (String name : names) {
+            try { return target.getClass().getMethod(name).invoke(target); }
+            catch (Exception ignored) { }
+        }
+        return null;
+    }
+
+    private static Number number(Object target, String... names) {
+        Object value = invokeNoArg(target, names);
+        return value instanceof Number ? (Number) value : null;
+    }
+
+    private static BigDecimal decimal(Object target, String... names) {
+        Object value = invokeNoArg(target, names);
+        if (value instanceof BigDecimal) return (BigDecimal) value;
+        if (value instanceof Number) return BigDecimal.valueOf(((Number) value).doubleValue());
+        return null;
+    }
+}
