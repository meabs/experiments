+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.ArrayList;
+import java.util.List;
+
+import javax.inject.Inject;
+
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.ResponseBody;
+import org.springframework.web.bind.annotation.ResponseStatus;
+import org.springframework.stereotype.Controller;
+
+import com.salesmanager.core.business.services.catalog.product.ProductTierService;
+import com.salesmanager.core.model.catalog.product.ProductTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.PersistableProductTier;
+import com.salesmanager.shop.model.catalog.product.ReadableProductTier;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Administration endpoints for quantity price tiers. */
+@Controller
+@RequestMapping("/api/v1")
+public class ProductTierApi {
+
+    @Inject
+    private ProductTierService productTierService;
+
+    @GetMapping("/private/product/{id}/tiers")
+    @ResponseStatus(HttpStatus.OK)
+    @ResponseBody
+    public List<ReadableProductTier> get(@PathVariable Long id, @ApiIgnore MerchantStore merchantStore) {
+        if (!productTierService.resolveProduct(id, merchantStore).isPresent()) {
+            throw new ResourceNotFoundException("Product [" + id + "] not found");
+        }
+        return readable(productTierService.getTiers(id, merchantStore));
+    }
+
+    @PutMapping("/private/product/{id}/tiers")
+    @ResponseStatus(HttpStatus.OK)
+    @ResponseBody
+    public List<ReadableProductTier> replace(@PathVariable Long id,
+            @RequestBody List<PersistableProductTier> requested,
+            @ApiIgnore MerchantStore merchantStore) {
+        if (!productTierService.resolveProduct(id, merchantStore).isPresent()) {
+            throw new ResourceNotFoundException("Product [" + id + "] not found");
+        }
+        if (requested == null) {
+            throw new RestApiException("400", "Tier list is required");
+        }
+        List<ProductTier> tiers = new ArrayList<ProductTier>(requested.size());
+        for (PersistableProductTier tier : requested) {
+            if (tier == null) {
+                throw new RestApiException("400", "Tier must not be null");
+            }
+            tiers.add(new ProductTier(tier.getMinQuantity(), tier.getPrice()));
+        }
+        try {
+            return readable(productTierService.replaceTiers(id, merchantStore, tiers));
+        } catch (IllegalArgumentException e) {
+            throw new RestApiException("400", e.getMessage());
+        }
+    }
+
+    private List<ReadableProductTier> readable(List<ProductTier> tiers) {
+        List<ReadableProductTier> result = new ArrayList<ReadableProductTier>();
+        if (tiers != null) {
+            for (ProductTier tier : tiers) {
+                result.add(new ReadableProductTier(tier.getMinQuantity(), tier.getPrice()));
+            }
+        }
+        return result;
+    }
+}
