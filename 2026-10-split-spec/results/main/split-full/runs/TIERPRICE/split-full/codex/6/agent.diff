+package com.salesmanager.core.model.catalog.product;
+
+import java.math.BigDecimal;
+
+import javax.persistence.Column;
+import javax.persistence.Entity;
+import javax.persistence.GeneratedValue;
+import javax.persistence.GenerationType;
+import javax.persistence.Id;
+import javax.persistence.JoinColumn;
+import javax.persistence.ManyToOne;
+import javax.persistence.Table;
+import javax.persistence.TableGenerator;
+
+/** A quantity threshold and the unit price used at that threshold. */
+@Entity
+@Table(name = "PRODUCT_TIER")
+public class ProductTier {
+    @Id
+    @Column(name = "PRODUCT_TIER_ID")
+    @TableGenerator(name = "TABLE_GEN", table = "SM_SEQUENCER", pkColumnName = "SEQ_NAME",
+            valueColumnName = "SEQ_COUNT", pkColumnValue = "PRODUCT_TIER_SEQ_NEXT_VAL")
+    @GeneratedValue(strategy = GenerationType.TABLE, generator = "TABLE_GEN")
+    private Long id;
+
+    @ManyToOne
+    @JoinColumn(name = "PRODUCT_ID", nullable = false)
+    private Product product;
+
+    @Column(name = "MIN_QUANTITY", nullable = false)
+    private Integer minQuantity;
+
+    @Column(name = "PRICE", nullable = false, precision = 19, scale = 4)
+    private BigDecimal price;
+
+    public ProductTier() { }
+
+    public ProductTier(Integer minQuantity, BigDecimal price) {
+        this.minQuantity = minQuantity;
+        this.price = price;
+    }
+
+    public Long getId() { return id; }
+    public void setId(Long id) { this.id = id; }
+    public Product getProduct() { return product; }
+    public void setProduct(Product product) { this.product = product; }
+    public Integer getMinQuantity() { return minQuantity; }
+    public void setMinQuantity(Integer minQuantity) { this.minQuantity = minQuantity; }
+    public BigDecimal getPrice() { return price; }
+    public void setPrice(BigDecimal price) { this.price = price; }
+}
