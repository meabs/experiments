+package com.salesmanager.core.business.services.catalog.product;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Optional;
+
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.repositories.catalog.product.ProductTierRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productTierService")
+public class ProductTierServiceImpl implements ProductTierService {
+    private final ProductService productService;
+    private final ProductTierRepository tierRepository;
+
+    @Inject
+    public ProductTierServiceImpl(ProductService productService, ProductTierRepository tierRepository) {
+        this.productService = productService;
+        this.tierRepository = tierRepository;
+    }
+
+    @Override
+    public Optional<Product> resolveProduct(Long productId, MerchantStore store) {
+        return Optional.ofNullable(productService.findOne(productId, store));
+    }
+
+    @Override
+    @Transactional
+    public List<ProductTier> getTiers(Long productId, MerchantStore store) {
+        Optional<Product> product = resolveProduct(productId, store);
+        return product.map(this::getTiers).orElseGet(ArrayList::new);
+    }
+
+    @Override
+    @Transactional
+    public List<ProductTier> getTiers(Product product) {
+        if (product == null || product.getId() == null) return new ArrayList<ProductTier>();
+        return new ArrayList<ProductTier>(tierRepository.findByProductIdOrderByMinQuantityAsc(product.getId()));
+    }
+
+    @Override
+    @Transactional
+    public List<ProductTier> replaceTiers(Long productId, MerchantStore store, Collection<ProductTier> requested) {
+        Product product = resolveProduct(productId, store).orElse(null);
+        if (product == null) return null;
+        List<ProductTier> incoming = requested == null ? null : new ArrayList<ProductTier>(requested);
+        validate(incoming);
+        tierRepository.deleteByProductId(product.getId());
+        if (incoming != null) {
+            for (ProductTier tier : incoming) tier.setProduct(product);
+            tierRepository.saveAll(incoming);
+        }
+        return getTiers(product);
+    }
+
+    private void validate(List<ProductTier> tiers) {
+        if (tiers == null) throw new IllegalArgumentException("tiers must be a list");
+        if (tiers.size() > 10) throw new IllegalArgumentException("at most 10 tiers are allowed");
+        tiers.sort(Comparator.comparing(ProductTier::getMinQuantity,
+                Comparator.nullsFirst(Comparator.naturalOrder())));
+        Integer priorQuantity = null;
+        BigDecimal priorPrice = null;
+        HashSet<Integer> quantities = new HashSet<Integer>();
+        for (ProductTier tier : tiers) {
+            if (tier == null || tier.getMinQuantity() == null || tier.getPrice() == null)
+                throw new IllegalArgumentException("minQuantity and price are required");
+            if (tier.getMinQuantity() < 2 || !quantities.add(tier.getMinQuantity()))
+                throw new IllegalArgumentException("minQuantity must be unique and at least 2");
+            if (tier.getPrice().compareTo(BigDecimal.ZERO) <= 0)
+                throw new IllegalArgumentException("price must be greater than zero");
+            if (priorQuantity != null && tier.getPrice().compareTo(priorPrice) >= 0)
+                throw new IllegalArgumentException("higher quantities must have lower prices");
+            priorQuantity = tier.getMinQuantity();
+            priorPrice = tier.getPrice();
+        }
+    }
+}
