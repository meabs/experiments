+package com.salesmanager.shop.model.catalog.product;
+
+import java.math.BigDecimal;
+import java.math.BigInteger;
+
+import com.fasterxml.jackson.core.JsonParser;
+import com.fasterxml.jackson.core.JsonToken;
+import com.fasterxml.jackson.databind.DeserializationContext;
+import com.fasterxml.jackson.databind.JsonDeserializer;
+import com.fasterxml.jackson.databind.annotation.JsonDeserialize;
+import java.io.IOException;
+
+/** Input representation of a quantity price tier. */
+public class PersistableProductTier {
+    @JsonDeserialize(using = WholeIntegerDeserializer.class)
+    private Integer minQuantity;
+    private BigDecimal price;
+
+    public Integer getMinQuantity() { return minQuantity; }
+    public void setMinQuantity(Integer minQuantity) { this.minQuantity = minQuantity; }
+    public BigDecimal getPrice() { return price; }
+    public void setPrice(BigDecimal price) { this.price = price; }
+
+    /** Reject decimals instead of allowing Jackson's numeric narrowing to truncate them. */
+    public static class WholeIntegerDeserializer extends JsonDeserializer<Integer> {
+        @Override
+        public Integer deserialize(JsonParser parser, DeserializationContext context) throws IOException {
+            if (parser.currentToken() != JsonToken.VALUE_NUMBER_INT) {
+                throw context.weirdStringException(parser.getValueAsString(), Integer.class,
+                        "minQuantity must be a whole number");
+            }
+            BigInteger value = parser.getBigIntegerValue();
+            if (value.compareTo(BigInteger.valueOf(Integer.MIN_VALUE)) < 0
+                    || value.compareTo(BigInteger.valueOf(Integer.MAX_VALUE)) > 0) {
+                throw context.weirdStringException(value.toString(), Integer.class,
+                        "minQuantity is outside the supported range");
+            }
+            return value.intValue();
+        }
+    }
+}
