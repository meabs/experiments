+package com.salesmanager.core.business.services.catalog.product;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Set;
+
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+
+import org.springframework.stereotype.Service;
+
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.ProductTierRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+@Service("productTierService")
+public class ProductTierServiceImpl implements ProductTierService {
+    private final ProductTierRepository tierRepository;
+    private final ProductService productService;
+
+    @Inject
+    public ProductTierServiceImpl(ProductTierRepository tierRepository, ProductService productService) {
+        this.tierRepository = tierRepository;
+        this.productService = productService;
+    }
+
+    @Override
+    @Transactional
+    public List<ProductTier> getTiers(Long productId, MerchantStore store) throws ServiceException {
+        requireProduct(productId, store);
+        return tierRepository.findByProductIdOrderByMinQuantityAsc(productId);
+    }
+
+    @Override
+    @Transactional
+    public List<ProductTier> replaceTiers(Long productId, MerchantStore store, List<ProductTier> tiers)
+            throws ServiceException {
+        Product product = requireProduct(productId, store);
+        validate(tiers);
+
+        // Validate completely before touching the existing collection/database.
+        List<ProductTier> replacement = new ArrayList<ProductTier>();
+        if (tiers != null) {
+            for (ProductTier input : tiers) {
+                ProductTier tier = new ProductTier(input.getMinQuantity(), input.getPrice());
+                tier.setProduct(product);
+                replacement.add(tier);
+            }
+        }
+        tierRepository.deleteByProductId(productId);
+        tierRepository.flush();
+        if (!replacement.isEmpty()) {
+            tierRepository.saveAll(replacement);
+        }
+        return tierRepository.findByProductIdOrderByMinQuantityAsc(productId);
+    }
+
+    private Product requireProduct(Long productId, MerchantStore store) throws ServiceException {
+        if (productId == null || store == null) {
+            throw new ServiceException("Product and store are required");
+        }
+        Product product = productService.findOne(productId, store);
+        if (product == null) {
+            throw new ServiceException("Product not found");
+        }
+        return product;
+    }
+
+    private void validate(List<ProductTier> tiers) throws ServiceException {
+        if (tiers == null) {
+            throw new ServiceException("Tiers are required");
+        }
+        if (tiers.size() > 10) {
+            throw new ServiceException("A product may have at most 10 tiers");
+        }
+        Set<Integer> quantities = new HashSet<Integer>();
+        List<ProductTier> ordered = new ArrayList<ProductTier>(tiers);
+        for (ProductTier tier : ordered) {
+            if (tier == null || tier.getMinQuantity() == null || tier.getMinQuantity() < 2
+                    || tier.getPrice() == null || tier.getPrice().compareTo(BigDecimal.ZERO) <= 0
+                    || !quantities.add(tier.getMinQuantity())) {
+                throw new ServiceException("Invalid tier");
+            }
+        }
+        ordered.sort(Comparator.comparing(ProductTier::getMinQuantity));
+        for (int i = 1; i < ordered.size(); i++) {
+            if (ordered.get(i).getPrice().compareTo(ordered.get(i - 1).getPrice()) >= 0) {
+                throw new ServiceException("Tier prices must decrease as quantity increases");
+            }
+        }
+    }
+}
