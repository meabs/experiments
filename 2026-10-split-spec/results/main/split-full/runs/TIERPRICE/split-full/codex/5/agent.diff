+
+/** Administration API for product quantity price tiers. */
+@Controller
+@RequestMapping("/api/v1")
+public class ProductTierApi {
+    private static final int MAX_TIERS = 10;
+
+    @Inject
+    private ProductService productService;
+
+    @Inject
+    private ProductTierService productTierService;
+
+    @GetMapping("/private/product/{id}/tiers")
+    public List<ReadableProductTier> get(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        product(id, store);
+        try {
+            return read(productTierService.getTiers(id, store));
+        } catch (ServiceException e) {
+            throw new ServiceRuntimeException(e);
+        }
+    }
+
+    @PutMapping("/private/product/{id}/tiers")
+    @ResponseStatus(HttpStatus.OK)
+    public List<ReadableProductTier> replace(@PathVariable Long id,
+            @RequestBody List<PersistableProductTier> request, @ApiIgnore MerchantStore store) {
+        Product product = product(id, store);
+        validate(request);
+
+        // Build and validate the replacement before touching the managed product.
+        List<PersistableProductTier> ordered = new ArrayList<PersistableProductTier>(request);
+        ordered.sort(Comparator.comparing(PersistableProductTier::getMinQuantity));
+        List<ProductTier> tiers = new ArrayList<ProductTier>();
+        BigDecimal previousPrice = null;
+        for (PersistableProductTier input : ordered) {
+            if (previousPrice != null && input.getPrice().compareTo(previousPrice) >= 0) {
+                throw bad("A tier for more units must have a lower price");
+            }
+            previousPrice = input.getPrice();
+            ProductTier tier = new ProductTier(input.getMinQuantity(), input.getPrice());
+            tiers.add(tier);
+        }
+        try {
+            return read(productTierService.replaceTiers(id, store, tiers));
+        } catch (ServiceException e) {
+            throw new ServiceRuntimeException(e);
+        }
+    }
+
+    private Product product(Long id, MerchantStore store) {
+        Product product = productService.findOne(id, store);
+        if (product == null) {
+            throw new ResourceNotFoundException("Product [" + id + "] not found");
+        }
+        return product;
+    }
+
+    private void validate(List<PersistableProductTier> request) {
+        if (request == null) throw bad("Tier list is required");
+        if (request.size() > MAX_TIERS) throw bad("A maximum of 10 tiers is allowed");
+        Set<Integer> quantities = new HashSet<Integer>();
+        for (PersistableProductTier tier : request) {
+            if (tier == null || tier.getMinQuantity() == null || tier.getPrice() == null) {
+                throw bad("minQuantity and price are required");
+            }
+            if (tier.getMinQuantity() < 2) throw bad("minQuantity must be at least 2");
+            if (tier.getPrice().compareTo(BigDecimal.ZERO) <= 0) throw bad("price must be more than 0");
+            if (!quantities.add(tier.getMinQuantity())) throw bad("Duplicate minQuantity");
+        }
+    }
+
+    private List<ReadableProductTier> read(List<ProductTier> tiers) {
+        if (tiers == null) return new ArrayList<ReadableProductTier>();
+        return tiers.stream()
+                .sorted(Comparator.comparing(ProductTier::getMinQuantity))
+                .map(t -> new ReadableProductTier(t.getMinQuantity(), t.getPrice()))
+                .collect(Collectors.toList());
+    }
+
+    private RestApiException bad(String message) { return new RestApiException("400", message); }
