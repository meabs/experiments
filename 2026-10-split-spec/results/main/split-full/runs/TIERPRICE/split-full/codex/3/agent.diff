+        if (productService.findOne(id, store) == null) {
+            throw new ResourceNotFoundException("Product not found: " + id);
+        }
+        List<ProductTier> tiers = parse(body);
+        try {
+            productService.replaceProductTiers(id, store, tiers);
+        } catch (IllegalArgumentException e) {
+            throw new RestApiException("400", e.getMessage());
+        }
+        return productService.getProductTiers(id, store);
+    }
+
+    private List<ProductTier> parse(JsonNode body) {
+        if (body == null || !body.isArray() || body.size() > 10) {
