+    @ApiImplicitParams(@ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT"))
+    public List<ProductTier> get(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        List<ProductTier> tiers = productService.getProductTiers(id, store);
+        if (tiers == null) {
