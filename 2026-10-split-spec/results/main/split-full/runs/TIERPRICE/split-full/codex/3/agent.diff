+		Product product = findOne(productId, store);
+		if (product == null) throw new IllegalArgumentException("Product not found");
+		if (tiers == null) throw new IllegalArgumentException("tiers must not be null");
+		if (tiers.size() > 10) throw new IllegalArgumentException("At most 10 tiers are allowed");
+		List<ProductTier> ordered = new ArrayList<>(tiers);
+		ordered.sort(Comparator.comparing(ProductTier::getMinQuantity, Comparator.nullsFirst(Integer::compareTo)));
