+					|| tier.getPrice() == null || tier.getPrice().compareTo(BigDecimal.ZERO) <= 0) {
+				throw new IllegalArgumentException("Each tier requires minQuantity >= 2 and price > 0");
+			}
+			if (previousQuantity != null && tier.getMinQuantity().equals(previousQuantity)) {
+				throw new IllegalArgumentException("Duplicate minQuantity");
+			}
+			if (previousPrice != null && tier.getPrice().compareTo(previousPrice) >= 0) {
+				throw new IllegalArgumentException("Higher quantities must have lower prices");
+			}
+			previousQuantity = tier.getMinQuantity();
+			previousPrice = tier.getPrice();
+		}
+		// Validation is complete before touching the managed collection: rejected requests are atomic.
+		productTierRepository.deleteByProductId(product.getId());
+		productTierRepository.flush();
+		for (ProductTier tier : ordered) {
+			tier.setId(null);
+			tier.setProduct(product);
+		}
+		productTierRepository.saveAll(ordered);
+		productTierRepository.flush();
+	}
