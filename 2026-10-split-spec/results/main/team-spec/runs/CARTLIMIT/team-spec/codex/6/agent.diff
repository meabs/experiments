+	private void validateNewItem(ShoppingCart cart, PersistableShoppingCartItem request, MerchantStore store, boolean replace) throws Exception {
+		Product p = productService.getBySku(request.getProduct(), store, store.getDefaultLanguage());
+		if (p == null) return;
+		int q = request.getQuantity();
+		if (q > 0 && p.getMinPerCart() != null && q < p.getMinPerCart()) throw new CartLimitException("MIN_PER_CART", "Minimum quantity is " + p.getMinPerCart());
+		if (q > 0 && p.getMaxPerCart() != null && q > p.getMaxPerCart()) throw new CartLimitException("MAX_PER_CART", "Maximum quantity is " + p.getMaxPerCart());
+		if (q > 0 && p.getPackSize() != null && q % p.getPackSize() != 0) throw new CartLimitException("PACK_SIZE", "Quantity must be a multiple of " + p.getPackSize());
+		java.util.Map<Long,Integer> quantities = new java.util.HashMap<Long,Integer>();
+		if (cart.getLineItems() != null) for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : cart.getLineItems()) quantities.put(i.getProduct().getId(), i.getQuantity());
+		Integer old = quantities.get(p.getId());
+		if (!replace && old != null) q += old;
+		if (q == 0) quantities.remove(p.getId()); else quantities.put(p.getId(), q);
+		if (store.getMaxCartLines() != null && old == null && q > 0 && quantities.size() > store.getMaxCartLines()) throw new CartLimitException("MAX_LINES", "Maximum cart lines exceeded");
+		int units = 0; for (Integer n : quantities.values()) units += n == null ? 0 : n;
+		if (store.getMaxCartUnits() != null && q > (old == null ? 0 : old) && units > store.getMaxCartUnits()) throw new CartLimitException("MAX_UNITS", "Maximum cart units exceeded");
+	}
+
+	private void validateMultiCaps(ShoppingCart cart, List<PersistableShoppingCartItem> requests, MerchantStore store) throws Exception {
+		java.util.Map<Long,Integer> values = new java.util.HashMap<Long,Integer>();
+		if (cart.getLineItems() != null) for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : cart.getLineItems()) values.put(i.getProduct().getId(), i.getQuantity());
+		int oldUnits = 0; for (Integer q : values.values()) oldUnits += q == null ? 0 : q;
+		boolean addedLine = false;
+		for (PersistableShoppingCartItem r : requests) {
+			Product p = productService.getBySku(r.getProduct(), store, store.getDefaultLanguage()); if (p == null) continue;
+			int q = r.getQuantity();
+			if (q == 0) values.remove(p.getId());
+			else { if (!values.containsKey(p.getId())) addedLine = true; values.put(p.getId(), q); }
+		}
+		if (store.getMaxCartLines() != null && addedLine && values.size() > store.getMaxCartLines()) throw new CartLimitException("MAX_LINES", "Maximum cart lines exceeded");
+		int units=0; for(Integer q:values.values()) units += q == null ? 0 : q;
+		if (store.getMaxCartUnits() != null && units > oldUnits && units > store.getMaxCartUnits()) throw new CartLimitException("MAX_UNITS", "Maximum cart units exceeded");
+	}
+
