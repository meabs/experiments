+package com.salesmanager.shop.store.api.v1;
+
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductLimits;
+import com.salesmanager.shop.model.shoppingcart.CartRules;
+import com.salesmanager.shop.store.api.exception.CartLimitException;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private")
+public class CartRulesApi {
+ @Inject private ProductService productService;
+ @Inject private MerchantStoreService merchantStoreService;
+ @GetMapping("/product/{id}/limits") public ProductLimits productLimits(@PathVariable Long id,@ApiIgnore MerchantStore store) {
+  Product p=productService.retrieveById(id,store).orElse(null); if(p==null || p.getMerchantStore()==null || !p.getMerchantStore().getId().equals(store.getId())) throw new ResourceNotFoundException("404","Product not found"); return limits(p);
+ }
+ @PutMapping("/product/{id}/limits") public ProductLimits setProductLimits(@PathVariable Long id,@RequestBody ProductLimits in,@ApiIgnore MerchantStore store) throws Exception {
+  validate(in.getMinPerCart(),in.getMaxPerCart(),in.getPackSize()); Product p=productService.retrieveById(id,store).orElse(null); if(p==null || p.getMerchantStore()==null || !p.getMerchantStore().getId().equals(store.getId())) throw new ResourceNotFoundException("404","Product not found"); p.setMinPerCart(in.getMinPerCart());p.setMaxPerCart(in.getMaxPerCart());p.setPackSize(in.getPackSize());productService.saveProduct(p);return limits(p);
+ }
+ @GetMapping("/cart-rules") public CartRules rules(@ApiIgnore MerchantStore s){CartRules r=new CartRules();r.setMaxLines(s.getMaxCartLines());r.setMaxUnits(s.getMaxCartUnits());return r;}
+ @PutMapping("/cart-rules") public CartRules setRules(@RequestBody CartRules in,@ApiIgnore MerchantStore s) throws Exception { if(in.getMaxLines()!=null&&in.getMaxLines()<1||in.getMaxUnits()!=null&&in.getMaxUnits()<1) throw new CartLimitException("INVALID_LIMIT","Invalid cart limit");s.setMaxCartLines(in.getMaxLines());s.setMaxCartUnits(in.getMaxUnits());merchantStoreService.saveOrUpdate(s);return rules(s); }
+ private ProductLimits limits(Product p){ProductLimits l=new ProductLimits();l.setMinPerCart(p.getMinPerCart());l.setMaxPerCart(p.getMaxPerCart());l.setPackSize(p.getPackSize());return l;}
+ private void validate(Integer min,Integer max,Integer pack){if(min!=null&&min<1||max!=null&&max<1||pack!=null&&pack<1||min!=null&&max!=null&&min>max||max!=null&&pack!=null&&max<pack)throw new CartLimitException("INVALID_LIMIT","Invalid cart limit");}
+}
