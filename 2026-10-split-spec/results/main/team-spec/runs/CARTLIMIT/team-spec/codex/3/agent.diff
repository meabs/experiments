+package com.salesmanager.shop.store.api.v1.product;
+import javax.inject.Inject;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.cart.*;
+import com.salesmanager.shop.store.api.exception.*;
+import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private")
+public class CartLimitsApi {
+ @Inject private ProductService products;
+ @Inject private MerchantStoreService storeService;
+ private void valid(Integer a,Integer b,Integer c){if((a!=null&&a<1)||(b!=null&&b<1)||(c!=null&&c<1)||(a!=null&&b!=null&&a>b)||(b!=null&&c!=null&&b<c)) throw new RestApiException("400","Invalid cart limit");}
+ @GetMapping("/product/{id}/limits") public CartLimits get(@PathVariable Long id,@ApiIgnore MerchantStore store){Product p=products.retrieveById(id,store).orElseThrow(()->new ResourceNotFoundException("Product not found")); CartLimits x=new CartLimits();x.setMinPerCart(p.getMinPerCart());x.setMaxPerCart(p.getMaxPerCart());x.setPackSize(p.getPackSize());return x;}
+ @PutMapping("/product/{id}/limits") public CartLimits put(@PathVariable Long id,@RequestBody CartLimits x,@ApiIgnore MerchantStore store){valid(x.getMinPerCart(),x.getMaxPerCart(),x.getPackSize());Product p=products.retrieveById(id,store).orElseThrow(()->new ResourceNotFoundException("Product not found"));p.setMinPerCart(x.getMinPerCart());p.setMaxPerCart(x.getMaxPerCart());p.setPackSize(x.getPackSize());try{products.saveProduct(p);}catch(Exception e){throw new RestApiException(e);}return x;}
+ @GetMapping("/cart-rules") public CartRules getRules(@ApiIgnore MerchantStore s){CartRules x=new CartRules();x.setMaxLines(s.getMaxLines());x.setMaxUnits(s.getMaxUnits());return x;}
+ @PutMapping("/cart-rules") public CartRules putRules(@RequestBody CartRules x,@ApiIgnore MerchantStore s){if((x.getMaxLines()!=null&&x.getMaxLines()<1)||(x.getMaxUnits()!=null&&x.getMaxUnits()<1))throw new RestApiException("400","Invalid cart rule");s.setMaxLines(x.getMaxLines());s.setMaxUnits(x.getMaxUnits());try{storeService.saveOrUpdate(s);}catch(Exception e){throw new RestApiException(e);}return x;}
+}
