+		for(com.salesmanager.core.model.shoppingcart.ShoppingCartItem i:requested){validateProduct(i.getProduct(),i.getQuantity()); projected.put(i.getProduct().getId(),i.getQuantity());}
+		int lines=0,total=0; for(Integer q:projected.values()) if(q>0){lines++;total+=q;}
+		int oldLines=0; for(Integer q:cart.getLineItems().stream().map(x->x.getQuantity()).collect(Collectors.toList())) if(q>0) oldLines++;
+		if(lines>oldLines && store.getMaxLines()!=null && lines>store.getMaxLines()) throw new ServiceRuntimeException("MAX_LINES","Cart exceeds maximum lines");
