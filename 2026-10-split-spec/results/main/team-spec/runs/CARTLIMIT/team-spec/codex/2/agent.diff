+public class CartLimitsApi {
+ @Inject ProductService products; @Inject MerchantStoreService stores;
+ private void valid(Integer a,Integer b,Integer c){ if(a!=null&&a<1||b!=null&&b<1||c!=null&&c<1||a!=null&&b!=null&&a>b||b!=null&&c!=null&&b<c) throw new RestApiException("INVALID_LIMIT","Invalid cart limit"); }
+ @PutMapping("/product/{id}/limits") public ProductLimits putProduct(@PathVariable Long id,@RequestBody ProductLimits body,@ApiIgnore MerchantStore store){ Product p=products.findOne(id,store); if(p==null) throw new ResourceNotFoundException("Product not found"); valid(body.getMinPerCart(),body.getMaxPerCart(),body.getPackSize()); p.setMinPerCart(body.getMinPerCart());p.setMaxPerCart(body.getMaxPerCart());p.setPackSize(body.getPackSize()); try{products.saveProduct(p);}catch(Exception e){throw new RestApiException(e);} return body; }
+ @GetMapping("/product/{id}/limits") public ProductLimits getProduct(@PathVariable Long id,@ApiIgnore MerchantStore store){ Product p=products.findOne(id,store); if(p==null) throw new ResourceNotFoundException("Product not found"); ProductLimits x=new ProductLimits();x.setMinPerCart(p.getMinPerCart());x.setMaxPerCart(p.getMaxPerCart());x.setPackSize(p.getPackSize());return x; }
+ @PutMapping("/cart-rules") public CartRules putRules(@RequestBody CartRules body,@ApiIgnore MerchantStore store){valid(body.getMaxLines(),body.getMaxUnits(),null);store.setMaxCartLines(body.getMaxLines());store.setMaxCartUnits(body.getMaxUnits());try{stores.saveOrUpdate(store);}catch(Exception e){throw new RestApiException(e);}return body;}
+ @GetMapping("/cart-rules") public CartRules getRules(@ApiIgnore MerchantStore store){CartRules x=new CartRules();x.setMaxLines(store.getMaxCartLines());x.setMaxUnits(store.getMaxCartUnits());return x;}
+}
