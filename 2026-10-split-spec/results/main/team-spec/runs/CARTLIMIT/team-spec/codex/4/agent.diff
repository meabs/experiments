+package com.salesmanager.shop.store.api.v1.shoppingCart;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.shoppingcart.CartRules;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class CartRulesApi {
+ @Autowired private MerchantStoreService stores;
+ @GetMapping("/private/cart-rules") public CartRules get(@ApiIgnore MerchantStore s){return dto(s);}
+ @PutMapping("/private/cart-rules") @ResponseStatus(HttpStatus.OK) public CartRules put(@RequestBody CartRules x,@ApiIgnore MerchantStore s){valid(x);s.setCartMaxLines(x.getMaxLines());s.setCartMaxUnits(x.getMaxUnits());try{stores.saveOrUpdate(s);}catch(Exception e){throw new RestApiException("500",e.getMessage(),e);}return dto(s);}
+ private void valid(CartRules x){if(x==null)throw new RestApiException("400","Invalid cart rules");if(x.getMaxLines()!=null&&x.getMaxLines()<1||x.getMaxUnits()!=null&&x.getMaxUnits()<1)throw new RestApiException("400","Caps must be positive");}
+ private CartRules dto(MerchantStore s){CartRules x=new CartRules();x.setMaxLines(s.getCartMaxLines());x.setMaxUnits(s.getCartMaxUnits());return x;}
+}
