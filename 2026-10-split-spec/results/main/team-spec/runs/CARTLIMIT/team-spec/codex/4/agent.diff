+package com.salesmanager.shop.store.api.v1.product;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductLimits;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController @RequestMapping("/api/v1")
+public class ProductLimitsApi {
+ @Autowired private ProductService products;
+ @GetMapping("/private/product/{id}/limits") public ProductLimits get(@PathVariable Long id,@ApiIgnore MerchantStore store){return dto(find(id,store));}
+ @PutMapping("/private/product/{id}/limits") @ResponseStatus(HttpStatus.OK)
+ public ProductLimits put(@PathVariable Long id,@RequestBody ProductLimits in,@ApiIgnore MerchantStore store){
+  valid(in); Product p=find(id,store); p.setMinPerCart(in.getMinPerCart()); p.setMaxPerCart(in.getMaxPerCart()); p.setPackSize(in.getPackSize());
+  try { products.saveProduct(p); } catch(Exception e){throw new RestApiException("500",e.getMessage(),e);} return dto(p);
+ }
+ private Product find(Long id,MerchantStore s){Product p=products.findOne(id,s);if(p==null) throw new RestApiException("404","Product not found");return p;}
+ private void valid(ProductLimits x){if(x==null)throw new RestApiException("400","Invalid limits"); Integer[] a={x.getMinPerCart(),x.getMaxPerCart(),x.getPackSize()};for(Integer n:a)if(n!=null&&n<1)throw new RestApiException("400","Limits must be positive");if(x.getMinPerCart()!=null&&x.getMaxPerCart()!=null&&x.getMinPerCart()>x.getMaxPerCart())throw new RestApiException("400","MIN_PER_CART exceeds MAX_PER_CART");if(x.getMaxPerCart()!=null&&x.getPackSize()!=null&&x.getMaxPerCart()<x.getPackSize())throw new RestApiException("400","MAX_PER_CART below PACK_SIZE");}
+ private ProductLimits dto(Product p){ProductLimits x=new ProductLimits();x.setMinPerCart(p.getMinPerCart());x.setMaxPerCart(p.getMaxPerCart());x.setPackSize(p.getPackSize());return x;}
+}
