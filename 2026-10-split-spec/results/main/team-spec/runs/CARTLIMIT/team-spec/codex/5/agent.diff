+package com.salesmanager.shop.store.api.v1;
+
+import javax.inject.Inject;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.shoppingcart.CartRules;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+@RestController
+@RequestMapping("/api/v1/private/cart-rules")
+public class CartRulesApi {
+    @Inject private MerchantStoreService merchantStoreService;
+    @GetMapping public CartRules get(@RequestParam String store) { return dto(resolve(store)); }
+    @PutMapping public CartRules put(@RequestParam String store, @RequestBody CartRules r) {
+        if ((r.getMaxLines()!=null && r.getMaxLines()<1) || (r.getMaxUnits()!=null && r.getMaxUnits()<1)) throw new RestApiException("400", "Invalid cart rules");
+        MerchantStore s=resolve(store); s.setMaxLines(r.getMaxLines()); s.setMaxUnits(r.getMaxUnits());
+        try { merchantStoreService.update(s); } catch(Exception e) { throw new RestApiException("500", e.getMessage(), e); }
+        return dto(s);
+    }
+    private MerchantStore resolve(String code) { try { MerchantStore s=merchantStoreService.getByCode(code); if(s==null) throw new Exception(); return s; } catch(Exception e) { throw new RestApiException("404", "Store not found"); } }
+    private CartRules dto(MerchantStore s) { CartRules r=new CartRules(); r.setMaxLines(s.getMaxLines()); r.setMaxUnits(s.getMaxUnits()); return r; }
+}
