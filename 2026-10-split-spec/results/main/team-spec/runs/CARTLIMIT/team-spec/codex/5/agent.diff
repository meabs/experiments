+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.Optional;
+import javax.inject.Inject;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.merchant.MerchantStoreService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductCartLimits;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.RestApiException;
+
+@RestController
+// The /private path is covered by the application's authenticated admin security chain,
+// consistently with the other private product endpoints.
+@RequestMapping("/api/v1/private/product")
+public class ProductCartLimitsApi {
+    @Inject private ProductService productService;
+    @Inject private MerchantStoreService merchantStoreService;
+
+    @GetMapping("/{id}/limits")
+    public ProductCartLimits get(@PathVariable Long id, @RequestParam String store) {
+        Product p = product(id, store);
+        return dto(p);
+    }
+
+    @PutMapping("/{id}/limits")
+    public ProductCartLimits put(@PathVariable Long id, @RequestParam String store, @RequestBody ProductCartLimits request) {
+        Product p = product(id, store);
+        validate(request);
+        p.setMinPerCart(request.getMinPerCart()); p.setMaxPerCart(request.getMaxPerCart()); p.setPackSize(request.getPackSize());
+        try { productService.update(p); } catch (Exception e) { throw new RestApiException("500", e.getMessage(), e); }
+        return dto(p);
+    }
+    private Product product(Long id, String storeCode) {
+        try {
+            MerchantStore store = merchantStoreService.getByCode(storeCode);
+            if (store == null) throw new ResourceNotFoundException("Product not found");
+            Optional<Product> found = productService.retrieveById(id, store);
+            if (!found.isPresent() || found.get().getMerchantStore() == null || !storeCode.equals(found.get().getMerchantStore().getCode())) throw new ResourceNotFoundException("Product not found");
+            return found.get();
+        } catch (ResourceNotFoundException e) { throw e; } catch (Exception e) { throw new ResourceNotFoundException("Product not found"); }
+    }
+    private ProductCartLimits dto(Product p) { ProductCartLimits d = new ProductCartLimits(); d.setMinPerCart(p.getMinPerCart()); d.setMaxPerCart(p.getMaxPerCart()); d.setPackSize(p.getPackSize()); return d; }
+    private void validate(ProductCartLimits d) {
+        if ((d.getMinPerCart()!=null && d.getMinPerCart()<1) || (d.getMaxPerCart()!=null && d.getMaxPerCart()<1) || (d.getPackSize()!=null && d.getPackSize()<1) || (d.getMinPerCart()!=null && d.getMaxPerCart()!=null && d.getMinPerCart()>d.getMaxPerCart()) || (d.getMaxPerCart()!=null && d.getPackSize()!=null && d.getMaxPerCart()<d.getPackSize())) throw new RestApiException("400", "Invalid product cart limits");
+    }
+}
