+	/** Validates a proposed cart state before any entity is mutated or persisted. */
+	private void validateProductQuantity(Product product, int quantity) {
+		if (quantity == 0) return;
+		if (quantity < 0) throw new ServiceRuntimeException("MIN_PER_CART", "Quantity cannot be negative");
+		if (product.getMinPerCart() != null && quantity < product.getMinPerCart())
+			throw new ServiceRuntimeException("MIN_PER_CART", "Quantity is below the product minimum");
+		if (product.getMaxPerCart() != null && quantity > product.getMaxPerCart())
+			throw new ServiceRuntimeException("MAX_PER_CART", "Quantity exceeds the product maximum");
+		if (product.getPackSize() != null && quantity % product.getPackSize() != 0)
+			throw new ServiceRuntimeException("PACK_SIZE", "Quantity must be a multiple of the pack size");
+	}
+
