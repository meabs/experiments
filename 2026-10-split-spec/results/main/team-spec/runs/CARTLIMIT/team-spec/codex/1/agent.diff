+	private void validateCartCaps(ShoppingCart cart, String sku, int quantity, MerchantStore store, boolean replacement) {
+		MerchantConfiguration rules = cartRules(store);
+		if (rules == null) return;
+		int oldUnits = 0;
+		boolean existing = false;
+		if (cart.getLineItems() != null) for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : cart.getLineItems()) {
+			oldUnits += i.getQuantity();
+			if (i.getProduct().getSku().equals(sku)) existing = true;
+		}
+		int newLines = cart.getLineItems() == null ? 0 : cart.getLineItems().size();
+		if (!existing && quantity > 0) newLines++;
+		int newUnits = oldUnits;
+		if (existing) {
+			for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : cart.getLineItems())
+				if (i.getProduct().getSku().equals(sku)) { newUnits += quantity - i.getQuantity(); break; }
+		} else newUnits += quantity;
+		if (rules.getMaxLines() != null && newLines > rules.getMaxLines() && !existing)
+			throw new ServiceRuntimeException("MAX_LINES", "Cart exceeds the maximum number of lines");
+		if (rules.getMaxUnits() != null && newUnits > rules.getMaxUnits() && newUnits > oldUnits)
+			throw new ServiceRuntimeException("MAX_UNITS", "Cart exceeds the maximum number of units");
+	}
