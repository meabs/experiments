+package com.salesmanager.shop.store.api.v1.limits;
+
+import javax.inject.Inject;
+import java.util.Arrays;
+import java.util.stream.Collectors;
+
+import org.springframework.http.ResponseEntity;
+import org.springframework.stereotype.Controller;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.system.MerchantConfigurationService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.system.MerchantConfiguration;
+import com.salesmanager.shop.model.catalog.product.product.ProductLimits;
+import com.salesmanager.shop.model.store.CartRules;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.api.exception.UnauthorizedException;
+import com.salesmanager.shop.constants.Constants;
+import com.salesmanager.shop.store.controller.user.facade.UserFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Administrative purchase-limit endpoints. */
+@Controller
+@RequestMapping("/api/v1/private")
+public class CartLimitsApi {
+    private static final String CART_RULES = "CART_RULES";
+    @Inject private ProductService productService;
+    @Inject private MerchantConfigurationService configurationService;
+    @Inject private UserFacade userFacade;
+
+    @GetMapping("/product/{id}/limits")
+    public ProductLimits getProductLimits(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        authorize(store);
+        Product product = product(id, store);
+        return limits(product);
+    }
+
+    @PutMapping("/product/{id}/limits")
+    public ProductLimits putProductLimits(@PathVariable Long id, @RequestBody ProductLimits request,
+            @ApiIgnore MerchantStore store) {
+        authorize(store);
+        if (request == null) throw new ServiceRuntimeException("400", "Request body is required");
+        validate(request.getMinPerCart(), request.getMaxPerCart(), request.getPackSize());
+        Product product = product(id, store);
+        product.setMinPerCart(request.getMinPerCart());
+        product.setMaxPerCart(request.getMaxPerCart());
+        product.setPackSize(request.getPackSize());
+        try { productService.saveProduct(product); } catch (Exception e) { throw new ServiceRuntimeException(e); }
+        return limits(product);
+    }
+
+    @GetMapping("/cart-rules")
+    public CartRules getCartRules(@ApiIgnore MerchantStore store) {
+        authorize(store);
+        MerchantConfiguration c = config(store);
+        CartRules result = new CartRules();
+        if (c != null) { result.setMaxLines(c.getMaxLines()); result.setMaxUnits(c.getMaxUnits()); }
+        return result;
+    }
+
+    @PutMapping("/cart-rules")
+    public CartRules putCartRules(@RequestBody CartRules request, @ApiIgnore MerchantStore store) {
+        authorize(store);
+        if (request == null) throw new ServiceRuntimeException("400", "Request body is required");
+        validate(request.getMaxLines(), request.getMaxUnits(), null);
+        MerchantConfiguration c = config(store);
+        if (c == null) { c = new MerchantConfiguration(); c.setMerchantStore(store); c.setKey(CART_RULES); }
+        c.setMaxLines(request.getMaxLines()); c.setMaxUnits(request.getMaxUnits());
+        try { configurationService.saveOrUpdate(c); } catch (Exception e) { throw new ServiceRuntimeException(e); }
+        return request;
+    }
+
+    private Product product(Long id, MerchantStore store) {
+        Product p = productService.retrieveById(id, store).orElse(null);
+        if (p == null || p.getMerchantStore() == null || !p.getMerchantStore().getId().equals(store.getId()))
+            throw new ResourceNotFoundException("Product not found");
+        return p;
+    }
+    private ProductLimits limits(Product p) {
+        ProductLimits r = new ProductLimits(); r.setMinPerCart(p.getMinPerCart()); r.setMaxPerCart(p.getMaxPerCart()); r.setPackSize(p.getPackSize()); return r;
+    }
+    private MerchantConfiguration config(MerchantStore store) {
+        try { return configurationService.getMerchantConfiguration(CART_RULES, store); } catch (Exception e) { return null; }
+    }
+    private void validate(Integer a, Integer b, Integer c) {
+        if (a != null && a < 1 || b != null && b < 1 || c != null && c < 1 || a != null && b != null && a > b || b != null && c != null && b < c)
+            throw new ServiceRuntimeException("400", "Invalid cart limit");
+    }
+    private void authorize(MerchantStore store) {
+        String user = userFacade.authenticatedUser();
+        if (user == null) throw new UnauthorizedException();
+        userFacade.authorizedGroup(user, Arrays.asList(Constants.GROUP_SUPERADMIN, Constants.GROUP_ADMIN, Constants.GROUP_ADMIN_RETAIL));
+        if (!userFacade.userInRoles(user, Arrays.asList(Constants.GROUP_SUPERADMIN)) && !userFacade.authorizedStore(user, store.getCode()))
+            throw new UnauthorizedException("Operation unauthorized for store [" + store.getCode() + "]");
+    }
+}
