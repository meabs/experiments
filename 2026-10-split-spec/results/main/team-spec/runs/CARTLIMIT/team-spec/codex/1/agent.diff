+		for (com.salesmanager.core.model.shoppingcart.ShoppingCartItem i : changes) {
+			validateProductQuantity(i.getProduct(), i.getQuantity());
+			quantities.put(i.getProduct().getSku(), i.getQuantity());
+		}
+		MerchantConfiguration rules = cartRules(store);
+		if (rules == null) return;
+		int oldUnits = cart.getLineItems() == null ? 0 : cart.getLineItems().stream().mapToInt(i -> i.getQuantity()).sum();
+		int newUnits = quantities.values().stream().mapToInt(Integer::intValue).filter(q -> q > 0).sum();
+		int oldLines = cart.getLineItems() == null ? 0 : cart.getLineItems().size();
+		int newLines = (int) quantities.values().stream().filter(q -> q > 0).count();
+		if (rules.getMaxLines() != null && newLines > rules.getMaxLines() && newLines > oldLines)
+			throw new ServiceRuntimeException("MAX_LINES", "Cart exceeds the maximum number of lines");
+		if (rules.getMaxUnits() != null && newUnits > rules.getMaxUnits() && newUnits > oldUnits)
