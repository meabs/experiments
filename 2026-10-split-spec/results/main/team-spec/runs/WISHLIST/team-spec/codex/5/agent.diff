+package com.salesmanager.core.business.services.wishlist;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.wishlist.WishlistRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.wishlist.WishlistItem;
+@Service("wishlistService")
+public class WishlistServiceImpl implements WishlistService {
+ @Inject private WishlistRepository repository;
+ public List<WishlistItem> list(Long id, MerchantStore s) throws ServiceException { return repository.findCustomer(id,s.getId()); }
+ public WishlistItem find(Long id, MerchantStore s,String sku) throws ServiceException { return repository.findOne(id,s.getId(),sku); }
+ @Transactional public WishlistItem add(Long id,MerchantStore s,Product p)throws ServiceException {
+   WishlistItem old=repository.findOne(id,s.getId(),p.getSku()); if(old!=null)return old;
+   if(repository.findCustomer(id,s.getId()).size()>=50) throw new ServiceException("Wishlist cannot contain more than 50 products");
+   WishlistItem w=new WishlistItem(); w.setCustomerId(id); w.setMerchantStore(s); w.setProduct(p); w.setAddedAt(new Date()); return repository.saveAndFlush(w);
+ }
+ @Transactional public void remove(Long id,MerchantStore s,String sku)throws ServiceException { WishlistItem w=find(id,s,sku); if(w!=null)repository.delete(w); }
+ @Transactional public void removeProduct(Long id)throws ServiceException { repository.deleteByProduct(id); }
+ public List<Object[]> popular(MerchantStore s)throws ServiceException { return repository.popular(s.getId()); }
+}
