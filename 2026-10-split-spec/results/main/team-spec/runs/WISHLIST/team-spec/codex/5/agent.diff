+package com.salesmanager.shop.store.api.v1.wishlist;
+import java.security.Principal; import java.util.List; import javax.inject.Inject; import javax.servlet.http.HttpServletRequest; import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.reference.language.Language; import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart; import com.salesmanager.shop.model.wishlist.*; import com.salesmanager.shop.store.api.exception.*; import com.salesmanager.shop.store.controller.wishlist.facade.WishlistFacade; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class WishlistApi {
+ @Inject private WishlistFacade facade;
+ private String user(HttpServletRequest r){Principal p=r.getUserPrincipal();if(p==null)throw new UnauthorizedException();return p.getName();}
+ @GetMapping("/auth/customer/wishlist") public ReadableWishlist get(@ApiIgnore MerchantStore s,@ApiIgnore Language l,HttpServletRequest r){return facade.get(user(r),s,l);}
+ @PostMapping("/auth/customer/wishlist") public ResponseEntity<ReadableWishlist> add(@RequestBody WishlistAddRequest b,@ApiIgnore MerchantStore s,@ApiIgnore Language l,HttpServletRequest r){if(b==null||b.getProduct()==null||b.getProduct().trim().isEmpty())throw new RestApiException("product is required");String u=user(r);boolean old=facade.exists(u,b.getProduct(),s);return ResponseEntity.status(old?HttpStatus.OK:HttpStatus.CREATED).body(facade.add(u,b.getProduct(),s,l));}
+ @DeleteMapping("/auth/customer/wishlist/{sku}") @ResponseStatus(HttpStatus.NO_CONTENT) public void remove(@PathVariable String sku,@ApiIgnore MerchantStore s,HttpServletRequest r){facade.remove(user(r),sku,s);}
+ @PostMapping("/auth/customer/wishlist/{sku}/cart/{cartCode}") public ReadableShoppingCart move(@PathVariable String sku,@PathVariable String cartCode,@ApiIgnore MerchantStore s,@ApiIgnore Language l,HttpServletRequest r)throws Exception{return facade.move(user(r),sku,cartCode,s,l);}
+ @GetMapping("/private/wishlists/popular") public List<PopularWishlistItem> popular(@ApiIgnore MerchantStore s){return facade.popular(s);}
+}
