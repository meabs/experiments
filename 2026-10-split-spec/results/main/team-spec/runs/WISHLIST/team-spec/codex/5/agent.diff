+package com.salesmanager.shop.store.controller.wishlist.facade;
+import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service; import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.business.services.catalog.pricing.PricingService; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.wishlist.WishlistService; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.availability.ProductAvailability; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.reference.language.Language; import com.salesmanager.shop.model.shoppingcart.*; import com.salesmanager.shop.model.wishlist.*; import com.salesmanager.shop.store.api.exception.*; import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade; import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+@Service("wishlistFacade") public class WishlistFacadeImpl implements WishlistFacade {
+ @Inject WishlistService service; @Inject ProductService products; @Inject PricingService pricing; @Inject CustomerFacade customers; @Inject ShoppingCartFacade carts;
+ private Customer c(String u,MerchantStore s){Customer c=customers.getCustomerByUserName(u,s);if(c==null)throw new ResourceNotFoundException("Customer not found");return c;}
+ public boolean exists(String u,String sku,MerchantStore s){try{return service.find(c(u,s).getId(),s,sku)!=null;}catch(Exception e){throw new ServiceRuntimeException(e);}}
+ private ReadableWishlist dto(List<com.salesmanager.core.model.wishlist.WishlistItem> ws){ReadableWishlist r=new ReadableWishlist(); for(com.salesmanager.core.model.wishlist.WishlistItem w:ws){Product p=w.getProduct();WishlistItem i=new WishlistItem();i.setSku(p.getSku());i.setName(p.getProductDescription()==null?null:p.getProductDescription().getName());i.setAddedAt(w.getAddedAt());try{i.setPrice(pricing.calculateProductPrice(p).getFinalPrice());}catch(Exception ignored){}boolean a=p!=null&&p.isAvailable()&&p.getAvailabilities()!=null&&!p.getAvailabilities().isEmpty();if(a){a=false;for(ProductAvailability av:p.getAvailabilities())if(Boolean.TRUE.equals(av.getAvailable())&&av.getProductQuantity()!=null&&av.getProductQuantity()>0){a=true;break;}}i.setAvailable(a);r.getItems().add(i);}r.setCount(r.getItems().size());return r;}
+ public ReadableWishlist get(String u,MerchantStore s,Language l){try{return dto(service.list(c(u,s).getId(),s));}catch(Exception e){throw new ServiceRuntimeException(e);}}
+ public ReadableWishlist add(String u,String sku,MerchantStore s,Language l){try{Customer c=c(u,s);Product p=products.getBySku(sku,s);if(p==null)throw new ResourceNotFoundException("Product not found");service.add(c.getId(),s,p);return dto(service.list(c.getId(),s));}catch(ResourceNotFoundException e){throw e;}catch(Exception e){throw new ServiceRuntimeException(e);}}
+ public void remove(String u,String sku,MerchantStore s){try{Customer c=c(u,s);if(service.find(c.getId(),s,sku)==null)throw new ResourceNotFoundException("Wishlist item not found");service.remove(c.getId(),s,sku);}catch(ResourceNotFoundException e){throw e;}catch(Exception e){throw new ServiceRuntimeException(e);}}
+ public ReadableShoppingCart move(String u,String sku,String code,MerchantStore s,Language l)throws Exception{Customer c=c(u,s);if(service.find(c.getId(),s,sku)==null)throw new ResourceNotFoundException("Wishlist item not found");Product p=products.getBySku(sku,s);boolean ok=p!=null&&p.isAvailable()&&p.getAvailabilities()!=null; if(ok){ok=false;for(ProductAvailability av:p.getAvailabilities())if(Boolean.TRUE.equals(av.getAvailable())&&av.getProductQuantity()!=null&&av.getProductQuantity()>0){ok=true;break;}}if(!ok)throw new WishlistConflictException("Product unavailable");ReadableShoppingCart existing=carts.getByCode(code,s,l);if(existing==null)throw new ResourceNotFoundException("Cart not found");int q=1;for(com.salesmanager.shop.model.shoppingcart.ReadableShoppingCartItem x:existing.getProducts())if(sku.equals(x.getSku()))q=x.getQuantity()+1;PersistableShoppingCartItem request=new PersistableShoppingCartItem();request.setProduct(sku);request.setQuantity(q);ReadableShoppingCart r=carts.modifyCart(code,request,s,l);service.remove(c.getId(),s,sku);return r;}
+ public List<PopularWishlistItem> popular(MerchantStore s){try{List<PopularWishlistItem> r=new ArrayList<>();for(Object[] x:service.popular(s))if(r.size()<10)r.add(new PopularWishlistItem((String)x[0],((Number)x[1]).longValue()));return r;}catch(Exception e){throw new ServiceRuntimeException(e);}}
+}
