+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.security.Principal; import java.util.*; import javax.inject.Inject; import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import springfox.documentation.annotations.ApiIgnore;
+import com.salesmanager.core.business.services.customer.*; import com.salesmanager.core.business.services.catalog.product.*; import com.salesmanager.core.business.services.catalog.product.availability.*; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.customer.WishlistItem; import com.salesmanager.core.model.catalog.product.*; import com.salesmanager.core.model.catalog.product.availability.ProductAvailability; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.customer.*; import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem; import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart; import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade; import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade; import com.salesmanager.shop.store.api.exception.*;
+
+@RestController @RequestMapping("/api/v1") public class WishlistApi {
+ @Inject private WishlistService wishlist; @Inject private CustomerService customers; @Inject private ProductService products; @Inject private ProductAvailabilityService availability; @Inject private ShoppingCartFacade carts;
+ private Customer customer(Principal p,MerchantStore s){ if(p==null) throw new UnauthorizedException(); Customer c=customers.getByNick(p.getName(),s.getCode()); if(c==null) throw new UnauthorizedException(); return c; }
+ private Product product(String sku,MerchantStore s){ try { Product p=products.getBySku(sku,s); if(p==null) throw new ResourceNotFoundException("Product not found"); return p; } catch(Exception e){if(e instanceof ResourceNotFoundException)throw (ResourceNotFoundException)e; throw new ResourceNotFoundException("Product not found");} }
+ private ReadableWishlist read(Customer c){ ReadableWishlist out=new ReadableWishlist(); List<WishlistProduct> list=new ArrayList<>(); for(WishlistItem i:wishlist.list(c)){Product p=i.getProduct(); WishlistProduct x=new WishlistProduct();x.setSku(p.getSku());x.setName(p.getDescriptions().isEmpty()?null:p.getDescriptions().iterator().next().getName());x.setAddedAt(i.getAddedAt()); boolean hasStock=false; BigDecimalHolder price=new BigDecimalHolder(); for(ProductAvailability a:availability.getBySku(p.getSku(),c.getMerchantStore())){hasStock=hasStock||(a.getProductQuantity()!=null&&a.getProductQuantity()>0&&(a.getAvailable()==null||a.getAvailable())); if(price.value==null&&a.defaultPrice()!=null)price.value=a.defaultPrice().getProductPriceAmount();} x.setAvailable(p.isAvailable()&&hasStock);x.setPrice(price.value);list.add(x);} out.setItems(list);out.setCount(list.size());return out; }
+ private static class BigDecimalHolder { java.math.BigDecimal value; }
+ @GetMapping("/auth/customer/wishlist") public ReadableWishlist get(@ApiIgnore MerchantStore s,HttpServletRequest r){return read(customer(r.getUserPrincipal(),s));}
+ @PostMapping("/auth/customer/wishlist") public ResponseEntity<ReadableWishlist> add(@RequestBody PersistableWishlist body,@ApiIgnore MerchantStore s,HttpServletRequest r){if(body==null||body.getProduct()==null||body.getProduct().trim().isEmpty())throw new ServiceRuntimeException("400","product is required"); Customer c=customer(r.getUserPrincipal(),s); Product p=product(body.getProduct(),s); if(wishlist.find(c,p)==null&&wishlist.count(c)>=50)throw new ServiceRuntimeException("400","wishlist limit reached"); boolean existed=wishlist.find(c,p)!=null;wishlist.add(c,p);return new ResponseEntity<>(read(c),existed?HttpStatus.OK:HttpStatus.CREATED);}
+ @DeleteMapping("/auth/customer/wishlist/{sku}") @ResponseStatus(HttpStatus.NO_CONTENT) public void remove(@PathVariable String sku,@ApiIgnore MerchantStore s,HttpServletRequest r){Customer c=customer(r.getUserPrincipal(),s);Product p=product(sku,s);if(wishlist.find(c,p)==null)throw new ResourceNotFoundException("Wishlist item not found");wishlist.remove(c,p);}
+ @PostMapping("/auth/customer/wishlist/{sku}/cart/{code}") public ReadableShoppingCart move(@PathVariable String sku,@PathVariable String code,@ApiIgnore MerchantStore s,@ApiIgnore Language l,HttpServletRequest r){Customer c=customer(r.getUserPrincipal(),s);Product p=product(sku,s);if(wishlist.find(c,p)==null)throw new ResourceNotFoundException("Wishlist item not found");boolean ok=false;for(ProductAvailability a:availability.getBySku(sku,s))ok|=p.isAvailable()&&a.getProductQuantity()!=null&&a.getProductQuantity()>0&&(a.getAvailable()==null||a.getAvailable());if(!ok)throw new ServiceRuntimeException("409","Product is unavailable");try{ReadableShoppingCart cart=carts.modifyCart(code,new PersistableShoppingCartItem(){ {setProduct(sku);setQuantity(1);} },s,l);wishlist.remove(c,p);return cart;}catch(ResourceNotFoundException e){throw e;}catch(Exception e){throw new ResourceNotFoundException("Cart not found");}}
+ @GetMapping("/private/wishlists/popular") public List<PopularWishlistProduct> popular(@ApiIgnore MerchantStore s){List<PopularWishlistProduct> out=new ArrayList<>();for(Object[] row:wishlist.popular(s)){out.add(new PopularWishlistProduct(String.valueOf(row[0]),((Number)row[1]).longValue()));if(out.size()==10)break;}return out;}
+}
