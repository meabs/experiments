+package com.salesmanager.core.business.services.customer;
+import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.customer.WishlistRepository; import com.salesmanager.core.model.customer.*; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("wishlistService") public class WishlistServiceImpl implements WishlistService {
+ @Inject private WishlistRepository repository;
+ public List<WishlistItem> list(Customer c){return repository.findByCustomerOrderByAddedAtDesc(c);}
+ public WishlistItem find(Customer c,Product p){return repository.findByCustomerAndProduct(c,p).orElse(null);}
+ public WishlistItem add(Customer c,Product p){WishlistItem old=find(c,p); if(old!=null)return old; WishlistItem i=new WishlistItem();i.setCustomer(c);i.setProduct(p);i.setAddedAt(new Date());return repository.save(i);}
+ public void remove(Customer c,Product p){repository.deleteByCustomerAndProduct(c,p);}
+ public long count(Customer c){return repository.countByCustomer(c);}
+ public void removeProduct(Product p){repository.deleteByProduct(p);}
+ public List<Object[]> popular(MerchantStore s){return repository.popular(s);}
+}
