+package com.salesmanager.core.business.repositories.customer;
+
+import java.util.List;
+
+import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Modifying;
+import org.springframework.data.jpa.repository.Query;
+import org.springframework.data.repository.query.Param;
+
+import com.salesmanager.core.model.customer.Wishlist;
+
+public interface WishlistRepository extends JpaRepository<Wishlist, Long> {
+    @Query("select w from Wishlist w join fetch w.product p where w.customer.id = :customer and w.merchantStore.id = :store order by w.addedAt desc")
+    List<Wishlist> findForCustomer(@Param("customer") Long customerId, @Param("store") Integer storeId);
+    Wishlist findByCustomerIdAndMerchantStoreIdAndSku(Long customerId, Integer storeId, String sku);
+    long countByCustomerIdAndMerchantStoreId(Long customerId, Integer storeId);
+    @Modifying
+    @Query("delete from Wishlist w where w.customer.id = :customer and w.merchantStore.id = :store and w.sku = :sku")
+    int deleteByCustomerAndStoreAndSku(@Param("customer") Long customerId, @Param("store") Integer storeId, @Param("sku") String sku);
+    @Modifying
+    @Query("delete from Wishlist w where w.product.id = :product")
+    int deleteByProductId(@Param("product") Long productId);
+    @Query("select w.sku, count(w.id) from Wishlist w where w.merchantStore.id = :store group by w.sku order by count(w.id) desc, w.sku asc")
+    List<Object[]> popular(@Param("store") Integer storeId);
+}
