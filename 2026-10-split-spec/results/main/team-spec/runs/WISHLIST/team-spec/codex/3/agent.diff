+package com.salesmanager.shop.store.api.v1.customer;
+import java.security.Principal; import javax.inject.Inject; import javax.servlet.http.HttpServletRequest; import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.business.services.customer.WishlistService; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.customer.WishlistItem; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.reference.language.Language; import com.salesmanager.shop.model.wishlist.*; import com.salesmanager.shop.model.shoppingcart.*; import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade; import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade; import com.salesmanager.shop.store.api.exception.*; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class WishlistApi {
+ @Inject WishlistService service; @Inject ProductService products; @Inject CustomerFacade customers; @Inject ShoppingCartFacade carts;
+ private Customer customer(HttpServletRequest r,MerchantStore s){Principal p=r.getUserPrincipal();if(p==null)throw new UnauthorizedException();Customer c=customers.getCustomerByUserName(p.getName(),s);if(c==null)throw new ResourceNotFoundException("Customer not found");return c;}
+ private Wishlist view(Customer c,MerchantStore s){Wishlist out=new Wishlist();for(WishlistItem w:service.list(c,s)){Product p=w.getProduct();WishlistViewItem i=new WishlistViewItem();i.setSku(p.getSku());i.setName(p.getProductDescription()==null?null:p.getProductDescription().getName());i.setAddedAt(w.getAddedAt());i.setAvailable(p.isAvailable()&&p.getAvailabilities()!=null&&p.getAvailabilities().stream().anyMatch(a->a.getProductQuantity()!=null&&a.getProductQuantity()>0));out.getItems().add(i);}out.setCount(out.getItems().size());return out;}
+ @PostMapping("/auth/customer/wishlist") public ResponseEntity<Wishlist> add(@RequestBody WishlistProductRequest req,@ApiIgnore MerchantStore store,HttpServletRequest r){if(req==null||req.getProduct()==null||req.getProduct().trim().isEmpty())throw new ConstraintException("product is required");Customer c=customer(r,store);Product p;try{p=products.getBySku(req.getProduct(),store);}catch(Exception e){throw new ResourceNotFoundException("Product not found");}if(p==null)throw new ResourceNotFoundException("Product not found");if(service.find(c,store,p)==null){if(service.list(c,store).size()>=50)throw new ConstraintException("Wishlist is full");service.add(c,store,p);return ResponseEntity.status(201).body(view(c,store));}return ResponseEntity.ok(view(c,store));}
+ @GetMapping("/auth/customer/wishlist") public Wishlist list(@ApiIgnore MerchantStore store,HttpServletRequest r){return view(customer(r,store),store);}
+ @DeleteMapping("/auth/customer/wishlist/{sku}") @ResponseStatus(HttpStatus.NO_CONTENT) public void remove(@PathVariable String sku,@ApiIgnore MerchantStore store,HttpServletRequest r)throws Exception{Customer c=customer(r,store);Product p=products.getBySku(sku,store);WishlistItem w=p==null?null:service.find(c,store,p);if(w==null)throw new ResourceNotFoundException("Wishlist item not found");service.remove(w);}
+ @PostMapping("/auth/customer/wishlist/{sku}/cart/{code}") public ReadableShoppingCart move(@PathVariable String sku,@PathVariable String code,@ApiIgnore MerchantStore store,@ApiIgnore Language language,HttpServletRequest r)throws Exception{Customer c=customer(r,store);Product p=products.getBySku(sku,store);WishlistItem w=p==null?null:service.find(c,store,p);if(w==null)throw new ResourceNotFoundException("Wishlist item not found");if(!p.isAvailable()||p.getAvailabilities()==null||p.getAvailabilities().stream().noneMatch(a->a.getProductQuantity()!=null&&a.getProductQuantity()>0))throw new WishlistConflictException();PersistableShoppingCartItem item=new PersistableShoppingCartItem();item.setProduct(sku);item.setQuantity(1);ReadableShoppingCart cart=carts.modifyCart(code,item,store,language);if(cart==null)throw new ResourceNotFoundException("Cart not found");service.remove(w);return cart;}
+}
