+package com.salesmanager.shop.store.api.v1;
+import java.util.*; import javax.inject.Inject; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.business.services.customer.WishlistService; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.wishlist.PopularWishlistItem; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/wishlists") public class WishlistAdminApi { @Inject WishlistService service; @GetMapping("/popular") public List<PopularWishlistItem> popular(@ApiIgnore MerchantStore store){List<PopularWishlistItem> out=new ArrayList<>();for(Object[] row:service.popular(store)){out.add(new PopularWishlistItem((String)row[0],((Number)row[1]).longValue()));}out.sort(Comparator.comparingLong(PopularWishlistItem::getCount).reversed().thenComparing(PopularWishlistItem::getSku));return out.size()>10?out.subList(0,10):out;} }
