+package com.salesmanager.core.business.services.customer;
+import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service; import com.salesmanager.core.business.repositories.customer.WishlistItemRepository; import com.salesmanager.core.model.customer.*; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service public class WishlistServiceImpl implements WishlistService { private final WishlistItemRepository repo; @Inject public WishlistServiceImpl(WishlistItemRepository r){repo=r;} public List<WishlistItem> list(Customer c,MerchantStore s){return repo.findForCustomer(c.getId(),s.getId());} public WishlistItem find(Customer c,MerchantStore s,Product p){return repo.findByCustomerIdAndMerchantStoreIdAndProductId(c.getId(),s.getId(),p.getId());} public WishlistItem add(Customer c,MerchantStore s,Product p){WishlistItem w=new WishlistItem();w.setCustomer(c);w.setMerchantStore(s);w.setProduct(p);w.setAddedAt(new Date());return repo.save(w);} public void remove(WishlistItem w){repo.delete(w);} public void removeProduct(Product p){repo.deleteByProduct(p.getId());} public List<Object[]> popular(MerchantStore s){return repo.popular(s.getId());} }
