+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.math.BigDecimal;
+import java.security.Principal;
+import java.util.*;
+import javax.inject.Inject;
+import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.*;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.repositories.customer.WishlistRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.WishlistItem;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.customer.*;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class WishlistApi {
+ @Inject private WishlistRepository repository;
+ @Inject private ProductService productService;
+ @Inject private CustomerFacade customerFacade;
+ @Inject private ShoppingCartFacade shoppingCartFacade;
+
+ private Customer customer(HttpServletRequest req, MerchantStore store) {
+  Principal p=req.getUserPrincipal();
+  if(p==null) throw new ServiceRuntimeException("401", "Customer authentication required");
+  Customer c=customerFacade.getCustomerByUserName(p.getName(),store);
+  if(c==null) throw new ResourceNotFoundException("Customer not found");
+  return c;
+ }
+ private ReadableWishlist read(Customer c, MerchantStore store) {
+  ReadableWishlist out=new ReadableWishlist(); List<WishlistProduct> items=new ArrayList<>();
+  for(WishlistItem w:repository.findByCustomerIdAndMerchantStoreIdOrderByAddedAtDesc(c.getId(),store.getId())) {
+   Product p=w.getProduct(); WishlistProduct i=new WishlistProduct(); i.setSku(p.getSku());
+   i.setName(p.getDescriptions().isEmpty()?p.getSku():p.getDescriptions().iterator().next().getName());
+   BigDecimal price=BigDecimal.ZERO; boolean hasStock=false;
+   for(ProductAvailability a:p.getAvailabilities()){ if(a.defaultPrice()!=null) price=a.defaultPrice().getProductPriceAmount(); if(a.getProductQuantity()!=null&&a.getProductQuantity()>0) hasStock=true; }
+   boolean available=p.isAvailable() && hasStock;
+   i.setPrice(price); i.setAvailable(available); i.setAddedAt(w.getAddedAt()); items.add(i);
+  }
+  out.setItems(items); out.setCount(items.size()); return out;
+ }
+ @PostMapping("/auth/customer/wishlist")
+ public ResponseEntity<ReadableWishlist> add(@RequestBody PersistableWishlist body,@ApiIgnore MerchantStore store,HttpServletRequest req) throws Exception {
+  if(body==null||body.getProduct()==null||body.getProduct().trim().isEmpty()) throw new ServiceRuntimeException("400","product is required");
+  Customer c=customer(req,store); Product p=productService.getBySku(body.getProduct(),store);
+  if(p==null) throw new ResourceNotFoundException("Product not found");
+  WishlistItem old=repository.findByCustomerIdAndMerchantStoreIdAndProductId(c.getId(),store.getId(),p.getId());
+  if(old!=null) return ResponseEntity.ok(read(c,store));
+  if(repository.findByCustomerIdAndMerchantStoreIdOrderByAddedAtDesc(c.getId(),store.getId()).size()>=50) throw new ServiceRuntimeException("400","Wishlist limit exceeded");
+  WishlistItem w=new WishlistItem(); w.setCustomer(c); w.setProduct(p); w.setMerchantStore(store); repository.save(w);
+  return new ResponseEntity<>(read(c,store),HttpStatus.CREATED);
+ }
+ @GetMapping("/auth/customer/wishlist") public ReadableWishlist get(@ApiIgnore MerchantStore store,HttpServletRequest req){return read(customer(req,store),store);}
+ @DeleteMapping("/auth/customer/wishlist/{sku}") public ResponseEntity<Void> remove(@PathVariable String sku,@ApiIgnore MerchantStore store,HttpServletRequest req) throws Exception{
+  Customer c=customer(req,store); Product p=productService.getBySku(sku,store); WishlistItem w=p==null?null:repository.findByCustomerIdAndMerchantStoreIdAndProductId(c.getId(),store.getId(),p.getId()); if(w==null) throw new ResourceNotFoundException("Wishlist product not found"); repository.delete(w); return ResponseEntity.noContent().build();
+ }
+ @PostMapping("/auth/customer/wishlist/{sku}/cart/{cartCode}") public ReadableShoppingCart move(@PathVariable String sku,@PathVariable String cartCode,@ApiIgnore MerchantStore store,@ApiIgnore Language lang,HttpServletRequest req) throws Exception {
+  Customer c=customer(req,store); Product p=productService.getBySku(sku,store); WishlistItem w=p==null?null:repository.findByCustomerIdAndMerchantStoreIdAndProductId(c.getId(),store.getId(),p.getId()); if(w==null) throw new ResourceNotFoundException("Wishlist product not found");
+  if(shoppingCartFacade.getByCode(cartCode,store,lang)==null) throw new ResourceNotFoundException("Cart not found");
+  boolean available=false; for(ProductAvailability a:p.getAvailabilities()) if(a.getProductQuantity()!=null&&a.getProductQuantity()>0) available=true;
+  if(!p.isAvailable()||!available) throw new ServiceRuntimeException("409","Product is not available");
+  PersistableShoppingCartItem item=new PersistableShoppingCartItem(); item.setProduct(sku); item.setQuantity(1); ReadableShoppingCart cart=shoppingCartFacade.modifyCart(cartCode,item,store,lang); repository.delete(w); return cart;
+ }
+ @GetMapping("/private/wishlists/popular") public List<PopularWishlistProduct> popular(@ApiIgnore MerchantStore store){List<PopularWishlistProduct> out=new ArrayList<>(); for(Object[] row:repository.popular(store.getId())){out.add(new PopularWishlistProduct((String)row[0],((Number)row[1]).longValue())); if(out.size()==10)break;} return out;}
+}
