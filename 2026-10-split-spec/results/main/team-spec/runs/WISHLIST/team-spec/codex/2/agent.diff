+package com.salesmanager.shop.store.api.v1.customer;
+import java.security.Principal; import java.util.*; import javax.inject.Inject; import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.*; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.customer.*; import com.salesmanager.core.business.services.catalog.product.*; import com.salesmanager.core.business.services.catalog.pricing.PricingService; import com.salesmanager.core.business.services.customer.WishlistService; import com.salesmanager.core.model.customer.WishlistItem; import com.salesmanager.core.model.catalog.product.*; import com.salesmanager.core.model.catalog.product.price.FinalPrice; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.reference.language.Language; import com.salesmanager.shop.model.customer.WishlistData; import com.salesmanager.shop.model.customer.WishlistRequest; import com.salesmanager.shop.model.customer.PopularWishlistItem; import com.salesmanager.shop.model.shoppingcart.*; import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade; import com.salesmanager.shop.store.api.exception.*; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class WishlistApi {
+ @Inject WishlistService ws; @Inject CustomerService cs; @Inject ProductService ps; @Inject PricingService pricingService; @Inject ShoppingCartFacade carts;
+ private com.salesmanager.core.model.customer.Customer customer(HttpServletRequest r,MerchantStore s){Principal p=r.getUserPrincipal(); if(p==null) throw new UnauthorizedException(); com.salesmanager.core.model.customer.Customer c=cs.getByNick(p.getName(),s.getId()); if(c==null) throw new UnauthorizedException(); return c;}
+ @GetMapping("/auth/customer/wishlist") public WishlistData list(@ApiIgnore MerchantStore s,@ApiIgnore Language l,HttpServletRequest r){return data(ws.list(customer(r,s),s),s,l);}
+ @PostMapping("/auth/customer/wishlist") public ResponseEntity<WishlistData> add(@RequestBody WishlistRequest q,@ApiIgnore MerchantStore s,@ApiIgnore Language l,HttpServletRequest r){if(q==null||q.getProduct()==null||q.getProduct().trim().isEmpty()) throw new RestApiException("400","product is required"); com.salesmanager.core.model.customer.Customer c=customer(r,s); Product p=product(q.getProduct(),s,l); if(ws.find(c,s,p.getSku())!=null)return ResponseEntity.ok(data(ws.list(c,s),s,l)); if(ws.list(c,s).size()>=50) throw new RestApiException("400","Wishlist limit reached"); ws.add(c,s,p.getSku()); return ResponseEntity.status(HttpStatus.CREATED).body(data(ws.list(c,s),s,l));}
+ @DeleteMapping("/auth/customer/wishlist/{sku}") @ResponseStatus(HttpStatus.NO_CONTENT) public void remove(@PathVariable String sku,@ApiIgnore MerchantStore s,HttpServletRequest r){com.salesmanager.core.model.customer.Customer c=customer(r,s); if(ws.find(c,s,sku)==null)throw new ResourceNotFoundException("Wishlist item not found"); ws.delete(c,s,sku);}
+ @PostMapping("/auth/customer/wishlist/{sku}/cart/{code}") public Object move(@PathVariable String sku,@PathVariable String code,@ApiIgnore MerchantStore s,@ApiIgnore Language l,HttpServletRequest r)throws Exception{com.salesmanager.core.model.customer.Customer c=customer(r,s); if(ws.find(c,s,sku)==null)throw new ResourceNotFoundException("Wishlist item not found"); Product p=product(sku,s,l); if(!p.isAvailable()||p.getAvailabilities().stream().noneMatch(a->Boolean.TRUE.equals(a.getAvailable())&&a.getProductQuantity()>0))throw new WishlistConflictException("Product unavailable"); PersistableShoppingCartItem i=new PersistableShoppingCartItem(); i.setProduct(sku); i.setQuantity(1); Object cart=carts.modifyCart(code,i,s,l); ws.delete(c,s,sku); return cart;}
+ @GetMapping("/private/wishlists/popular") public List<PopularWishlistItem> popular(@ApiIgnore MerchantStore s){List<PopularWishlistItem> out=new ArrayList<>(); for(Object[] x:ws.popular(s)){out.add(new PopularWishlistItem((String)x[0],((Number)x[1]).longValue())); if(out.size()==10)break;}return out;}
+ private Product product(String sku,MerchantStore s,Language l){try{Product p=ps.getBySku(sku,s,l);if(p==null)throw new ResourceNotFoundException("Product not found");return p;}catch(Exception e){if(e instanceof ResourceNotFoundException)throw (ResourceNotFoundException)e;throw new ResourceNotFoundException("Product not found");}}
+ private WishlistData data(List<WishlistItem> xs,MerchantStore s,Language l){WishlistData d=new WishlistData();d.setCount(xs.size());for(WishlistItem x:xs){Product p=product(x.getProductSku(),s,l);WishlistData.Item i=new WishlistData.Item();i.setSku(x.getProductSku());i.setAddedAt(x.getAddedAt());i.setName(p.getProductDescription()==null?null:p.getProductDescription().getName());try { FinalPrice fp=pricingService.calculateProductPrice(p); if(fp!=null)i.setPrice(fp.getFinalPrice()); } catch(Exception ignored) {} i.setAvailable(p.isAvailable()&&p.getAvailabilities().stream().anyMatch(a->Boolean.TRUE.equals(a.getAvailable())&&a.getProductQuantity()>0));d.getItems().add(i);}return d;}
+}
