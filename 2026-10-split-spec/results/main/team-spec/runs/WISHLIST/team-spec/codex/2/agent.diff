+package com.salesmanager.core.business.services.customer;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.customer.WishlistRepository;
+import com.salesmanager.core.model.customer.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("wishlistService") public class WishlistService {
+ @Inject private WishlistRepository repo;
+ public List<WishlistItem> list(Customer c, MerchantStore s){return repo.findByCustomerIdAndMerchantStoreIdOrderByAddedAtDesc(c.getId(),s.getId());}
+ public WishlistItem find(Customer c, MerchantStore s,String sku){return repo.findByCustomerIdAndMerchantStoreIdAndProductSku(c.getId(),s.getId(),sku).orElse(null);}
+ public WishlistItem add(Customer c,MerchantStore s,String sku){ WishlistItem x=new WishlistItem(); x.setCustomer(c);x.setMerchantStore(s);x.setProductSku(sku);return repo.save(x); }
+ public void delete(Customer c,MerchantStore s,String sku){repo.delete(find(c,s,sku));}
+ public List<Object[]> popular(MerchantStore s){return repo.popular(s.getId());}
+ public void removeProduct(String sku,Integer store){repo.deleteByProductSkuAndMerchantStoreId(sku,store);}
+}
