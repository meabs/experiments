+package com.salesmanager.shop.store.api.v1.discount;
+import java.time.LocalDate; import java.util.*; import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.business.services.discount.DiscountCodeService; import com.salesmanager.core.business.services.catalog.category.CategoryService; import com.salesmanager.core.model.discount.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.discount.DiscountCodeRequest; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/discounts") public class DiscountApi {
+ private final DiscountCodeService service; private final CategoryService categories; public DiscountApi(DiscountCodeService s,CategoryService c){service=s;categories=c;}
+ @PostMapping public ResponseEntity<DiscountCode> create(@ApiIgnore MerchantStore s,@RequestBody DiscountCodeRequest r){return new ResponseEntity<>(save(null,r,s),HttpStatus.CREATED);}
+ @GetMapping public List<DiscountCode> list(@ApiIgnore MerchantStore s){return service.list(s);}
+ @PutMapping("/{id}") public DiscountCode update(@PathVariable Long id,@ApiIgnore MerchantStore s,@RequestBody DiscountCodeRequest r){DiscountCode d=service.find(id,s);if(d==null)throw new Bad("not found");return save(d,r,s);}
+ @DeleteMapping("/{id}") @ResponseStatus(HttpStatus.NO_CONTENT) public void delete(@PathVariable Long id,@ApiIgnore MerchantStore s){DiscountCode d=service.find(id,s);if(d==null)throw new Bad("not found");try{service.delete(d);}catch(Exception e){throw new Bad(e.getMessage());}}
+ private DiscountCode save(DiscountCode d,DiscountCodeRequest r,MerchantStore s){if(r.getCode()==null||r.getCode().trim().isEmpty()||r.getValue()==null)throw new Bad("code and value required"); DiscountType t;try{t=DiscountType.valueOf(r.getType().toUpperCase());}catch(Exception e){throw new Bad("invalid type");} if(r.getValue().signum()<=0||(t==DiscountType.PERCENT&&r.getValue().compareTo(new java.math.BigDecimal("100"))>0)||r.getMinimumSubtotal()!=null&&r.getMinimumSubtotal().signum()<0)throw new Bad("invalid value"); LocalDate st=r.getStartDate()==null?LocalDate.now():r.getStartDate();if(r.getEndDate()!=null&&r.getEndDate().isBefore(st))throw new Bad("invalid dates");List<String> cs=r.getCategories()==null?Collections.emptyList():r.getCategories();for(String c:cs)if(c==null||c.trim().isEmpty()||!categoryExists(s,c))throw new Bad("unknown category");DiscountCode old=service.find(r.getCode(),s);if(old!=null&&(d==null||!old.getId().equals(d.getId())))throw new Conflict("duplicate code");if(d==null)d=new DiscountCode();d.setMerchantStore(s);d.setCode(r.getCode());d.setType(t);d.setValue(r.getValue());d.setMinimumSubtotal(r.getMinimumSubtotal());d.setStartDate(st);d.setEndDate(r.getEndDate());d.setActive(r.getActive()==null||r.getActive());d.setCategories(new HashSet<>(cs));try{return service.save(d);}catch(Exception e){throw new Bad(e.getMessage());}}
+ private boolean categoryExists(MerchantStore s,String c){try{return categories.getByCode(s,c)!=null;}catch(Exception e){return false;}}
+ @ResponseStatus(HttpStatus.BAD_REQUEST) static class Bad extends RuntimeException{Bad(String m){super(m);}} @ResponseStatus(HttpStatus.CONFLICT) static class Conflict extends RuntimeException{Conflict(String m){super(m);}}
+}
