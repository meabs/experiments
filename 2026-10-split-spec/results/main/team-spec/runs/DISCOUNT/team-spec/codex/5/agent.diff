+package com.salesmanager.shop.store.api.v1.discount;
+import java.time.LocalDate;
+import java.time.ZoneId;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.http.*;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.services.discount.DiscountService;
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.model.discount.Discount;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.discount.DiscountEntity;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import springfox.documentation.annotations.ApiIgnore;
+@RestController
+@RequestMapping("/api/v1/private/discounts")
+public class DiscountApi {
+ @Inject private DiscountService service;
+ @Inject private CategoryService categoryService;
+ private Date date(String s){try{return Date.from(LocalDate.parse(s).atStartOfDay(ZoneId.systemDefault()).toInstant());}catch(Exception e){throw new ServiceRuntimeException("400", "Invalid date");}}
+ private Discount map(DiscountEntity x,MerchantStore store){Discount d=new Discount();d.setId(x.getId());d.setMerchantStore(store);d.setCode(x.getCode());d.setType(x.getType());d.setValue(x.getValue());d.setMinimumSubtotal(x.getMinimumSubtotal());d.setStartDate(x.getStartDate()==null?null:date(x.getStartDate()));d.setEndDate(x.getEndDate()==null?null:date(x.getEndDate()));d.setActive(x.isActive());d.setCategories(new HashSet<>(x.getCategories()==null?Collections.<String>emptyList():x.getCategories()));return d;}
+ private DiscountEntity out(Discount d){DiscountEntity x=new DiscountEntity();x.setId(d.getId());x.setCode(d.getCode());x.setType(d.getType());x.setValue(d.getValue());x.setMinimumSubtotal(d.getMinimumSubtotal());x.setStartDate(d.getStartDate()==null?null:d.getStartDate().toInstant().atZone(ZoneId.systemDefault()).toLocalDate().toString());x.setEndDate(d.getEndDate()==null?null:d.getEndDate().toInstant().atZone(ZoneId.systemDefault()).toLocalDate().toString());x.setCategories(new ArrayList<>(d.getCategories()));x.setActive(d.isActive());return x;}
+ private void save(Discount d){try{if(d.getCategories()!=null) for(String c:d.getCategories()) if(categoryService.getByCode(d.getMerchantStore(),c)==null) throw new ServiceException("Unknown category"); service.validate(d); if(d.getId()==null)service.create(d);else service.update(d);}catch(ServiceException e){if(e.getMessage()!=null&&e.getMessage().toLowerCase().contains("duplicate"))throw new ServiceRuntimeException("409",e.getMessage());throw new ServiceRuntimeException("400",e.getMessage());}}
+ @PostMapping public ResponseEntity<DiscountEntity> create(@RequestBody DiscountEntity x,@ApiIgnore MerchantStore store){Discount d=map(x,store);save(d);return new ResponseEntity<>(out(d),HttpStatus.CREATED);}
+ @GetMapping public List<DiscountEntity> list(@ApiIgnore MerchantStore store){List<DiscountEntity> r=new ArrayList<>();for(Discount d:service.listByStore(store))r.add(out(d));return r;}
+ @PutMapping("/{id}") public DiscountEntity update(@PathVariable Long id,@RequestBody DiscountEntity x,@ApiIgnore MerchantStore store){Discount d=map(x,store);d.setId(id);if(service.getById(id)==null||service.getById(id).getMerchantStore().getId().intValue()!=store.getId().intValue())throw new ServiceRuntimeException("404","Discount not found");save(d);return out(d);}
+ @DeleteMapping("/{id}") @ResponseStatus(HttpStatus.NO_CONTENT) public void delete(@PathVariable Long id,@ApiIgnore MerchantStore store){Discount d=service.getById(id);if(d==null||d.getMerchantStore().getId().intValue()!=store.getId().intValue())throw new ServiceRuntimeException("404","Discount not found");try{service.delete(d);}catch(ServiceException e){throw new ServiceRuntimeException(e);}}
+}
