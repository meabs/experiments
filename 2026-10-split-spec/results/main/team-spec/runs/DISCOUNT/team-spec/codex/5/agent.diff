+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("discountService")
+public class DiscountServiceImpl extends SalesManagerEntityServiceImpl<Long,Discount> implements DiscountService {
+ private final DiscountRepository repo;
+ @Inject public DiscountServiceImpl(DiscountRepository repo){super(repo);this.repo=repo;}
+ public List<Discount> listByStore(MerchantStore s){return repo.findByStore(s.getId());}
+ public Discount findByCode(MerchantStore s,String c){return c==null?null:repo.findByStoreAndCode(s.getId(),c);}
+ public boolean codeExists(MerchantStore s,String c,Long id){return repo.countCode(s.getId(),c,id)>0;}
+ public void validate(Discount d) throws ServiceException {
+  if(d==null || d.getMerchantStore()==null || d.getCode()==null || d.getCode().trim().isEmpty() || d.getType()==null || d.getValue()==null || d.getValue().compareTo(BigDecimal.ZERO)<=0) throw new ServiceException("Invalid discount");
+  if(d.getType()==DiscountType.PERCENT && d.getValue().compareTo(new BigDecimal("100"))>0) throw new ServiceException("Invalid percent");
+  if(d.getStartDate()==null)d.setStartDate(Date.from(LocalDate.now().atStartOfDay(ZoneId.systemDefault()).toInstant()));
+  if(d.getEndDate()!=null && d.getEndDate().before(d.getStartDate())) throw new ServiceException("Invalid dates");
+  if(codeExists(d.getMerchantStore(),d.getCode(),d.getId())) throw new ServiceException("Duplicate discount code");
+ }
+ @Override public void create(Discount d)throws ServiceException{validate(d);super.create(d);}
+ @Override public void update(Discount d)throws ServiceException{validate(d);super.update(d);}
+}
