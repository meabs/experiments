+package com.salesmanager.core.business.services.discount;
+import java.time.LocalDate; import java.util.*;
+import javax.inject.Inject; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.discount.DiscountCodeRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.discount.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("discountCodeService") public class DiscountCodeServiceImpl extends SalesManagerEntityServiceImpl<Long,DiscountCode> implements DiscountCodeService {
+ private final DiscountCodeRepository repo;
+ @Inject public DiscountCodeServiceImpl(DiscountCodeRepository r){super(r);repo=r;}
+ private void validate(DiscountCode d, MerchantStore s, Long id) {
+  if(d==null||s==null||d.getCode()==null||d.getCode().trim().isEmpty()||d.getType()==null||d.getValue()==null) throw new IllegalArgumentException("Invalid discount");
+  d.setMerchantStore(s); d.setCode(d.getCode()); if(d.getStartDate()==null)d.setStartDate(LocalDate.now());
+  if(d.getEndDate()!=null&&d.getEndDate().isBefore(d.getStartDate())) throw new IllegalArgumentException("Invalid dates");
+  if(d.getValue().signum()<=0||(d.getType()==DiscountType.PERCENT&&d.getValue().compareTo(java.math.BigDecimal.valueOf(100))>0)) throw new IllegalArgumentException("Invalid value");
+  boolean exists=id==null?repo.existsByMerchantStoreIdAndCodeKey(s.getId(),d.getCodeKey()):repo.existsByMerchantStoreIdAndCodeKeyAndIdNot(s.getId(),d.getCodeKey(),id); if(exists) throw new DuplicateDiscountException();
+ }
+ @Transactional public DiscountCode create(DiscountCode d,MerchantStore s)throws Exception{validate(d,s,null);return repo.save(d);}
+ @Transactional public DiscountCode update(DiscountCode d,MerchantStore s)throws Exception{validate(d,s,d.getId()); if(repo.findByIdAndMerchantStoreId(d.getId(),s.getId()).isEmpty())return null; return repo.save(d);}
+ public List<DiscountCode> list(MerchantStore s){return repo.findByMerchantStoreId(s.getId());}
+ public DiscountCode get(Long id,MerchantStore s){return repo.findByIdAndMerchantStoreId(id,s.getId()).orElse(null);}
+ public DiscountCode find(String code,MerchantStore s){return code==null?null:repo.findByMerchantStoreIdAndCodeKey(s.getId(),code.trim().toUpperCase(Locale.ROOT)).orElse(null);}
+ @Transactional public void delete(Long id,MerchantStore s)throws Exception{DiscountCode d=get(id,s);if(d!=null)repo.delete(d);}
+ public static class DuplicateDiscountException extends RuntimeException {}
+}
