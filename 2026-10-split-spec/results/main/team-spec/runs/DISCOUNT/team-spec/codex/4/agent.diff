+package com.salesmanager.shop.store.api.v1.discount;
+import java.util.*; import java.util.stream.Collectors; import javax.inject.Inject; import javax.validation.Valid;
+import org.springframework.http.*; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.category.CategoryService; import com.salesmanager.core.business.services.discount.*; import com.salesmanager.core.model.catalog.category.Category; import com.salesmanager.core.model.discount.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.discount.DiscountCodeData; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/discounts") public class DiscountCodeApi {
+ @Inject DiscountCodeService service; @Inject CategoryService categoryService;
+ private DiscountCode map(DiscountCodeData d,MerchantStore s,Long id)throws Exception{ DiscountCode x=new DiscountCode();x.setId(id);x.setCode(d.getCode());x.setType(d.getType());x.setValue(d.getValue());x.setMinimumSubtotal(d.getMinimumSubtotal());x.setStartDate(d.getStartDate());x.setEndDate(d.getEndDate());x.setActive(d.isActive()); Set<Category> cs=new HashSet<>(); if(d.getCategories()!=null)for(String c:d.getCategories()){Category cat=categoryService.getByCode(s,c);if(cat==null)throw new IllegalArgumentException("Unknown category");cs.add(cat);}x.setCategories(cs);return x; }
+ private DiscountCodeData out(DiscountCode x){DiscountCodeData d=new DiscountCodeData();d.setId(x.getId());d.setCode(x.getCode());d.setType(x.getType());d.setValue(x.getValue());d.setMinimumSubtotal(x.getMinimumSubtotal());d.setStartDate(x.getStartDate());d.setEndDate(x.getEndDate());d.setActive(x.isActive());d.setCategories(x.getCategories()==null?new ArrayList<>():x.getCategories().stream().map(Category::getCode).collect(Collectors.toList()));return d;}
