+package com.salesmanager.shop.store.api.v1.discount;
+import java.util.*; import javax.inject.Inject; import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.business.services.discount.DiscountCodeService; import com.salesmanager.core.model.discount.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.discount.PersistableDiscountCode; import com.salesmanager.shop.store.api.exception.*; import com.salesmanager.shop.store.controller.user.facade.UserFacade; import com.salesmanager.shop.constants.Constants; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/discounts") public class DiscountApi {
+ @Inject private DiscountCodeService service; @Inject private UserFacade users;
+ private void auth(){String u=users.authenticatedUser();if(u==null)throw new UnauthorizedException();users.authorizedGroup(u,Arrays.asList(Constants.GROUP_SUPERADMIN,Constants.GROUP_ADMIN,Constants.GROUP_ADMIN_RETAIL));}
+ private DiscountCode map(PersistableDiscountCode x,MerchantStore s){DiscountCode d=new DiscountCode();d.setId(x.getId());d.setMerchantStore(s);d.setCode(x.getCode());try{d.setType(DiscountType.valueOf(x.getType()));}catch(Exception e){throw new IllegalArgumentException("unknown type");}d.setValue(x.getValue());d.setMinimumSubtotal(x.getMinimumSubtotal());d.setStartDate(x.getStartDate());d.setEndDate(x.getEndDate());d.setCategories(x.getCategories());d.setActive(x.getActive()==null||x.getActive());return d;}
+ private PersistableDiscountCode out(DiscountCode d){PersistableDiscountCode x=new PersistableDiscountCode();x.setId(d.getId());x.setCode(d.getCode());x.setType(d.getType().name());x.setValue(d.getValue());x.setMinimumSubtotal(d.getMinimumSubtotal());x.setStartDate(d.getStartDate());x.setEndDate(d.getEndDate());x.setCategories(d.getCategories());x.setActive(d.isActive());return x;}
+ @PostMapping public ResponseEntity<PersistableDiscountCode> create(@RequestBody PersistableDiscountCode x,@ApiIgnore MerchantStore s){auth();try{return new ResponseEntity<>(out(service.save(map(x,s),s)),HttpStatus.CREATED);}catch(IllegalStateException e){return new ResponseEntity<>(HttpStatus.CONFLICT);}catch(IllegalArgumentException e){throw new ServiceRuntimeException("400",e.getMessage());}}
+ @GetMapping public List<PersistableDiscountCode> list(@ApiIgnore MerchantStore s){auth();List<PersistableDiscountCode> r=new ArrayList<>();for(DiscountCode d:service.list(s))r.add(out(d));return r;}
+ @PutMapping("/{id}") public PersistableDiscountCode update(@PathVariable Long id,@RequestBody PersistableDiscountCode x,@ApiIgnore MerchantStore s){auth();x.setId(id);try {DiscountCode d=service.save(map(x,s),s);if(d==null)throw new ResourceNotFoundException("discount");return out(d);} catch(IllegalStateException e){throw new ServiceRuntimeException("409",e.getMessage());} catch(IllegalArgumentException e){throw new ServiceRuntimeException("400",e.getMessage());}}
+ @DeleteMapping("/{id}") @ResponseStatus(HttpStatus.NO_CONTENT) public void delete(@PathVariable Long id,@ApiIgnore MerchantStore s){auth();service.delete(id,s);}
+}
