+ @Id @GeneratedValue(strategy=GenerationType.TABLE, generator="TABLE_GEN") @TableGenerator(name="TABLE_GEN", table="SM_SEQUENCER", pkColumnName="SEQ_NAME", valueColumnName="SEQ_COUNT", pkColumnValue="DISCOUNT_SEQ_NEXT_VAL") private Long id;
