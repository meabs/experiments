+package com.salesmanager.core.business.services.discount;
+import java.time.LocalDate; import java.util.*; import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.discount.DiscountCodeRepository; import com.salesmanager.core.business.services.catalog.category.CategoryService; import com.salesmanager.core.model.catalog.category.Category; import com.salesmanager.core.model.discount.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("discountCodeService") public class DiscountCodeServiceImpl implements DiscountCodeService {
+ @Inject private DiscountCodeRepository repo; @Inject private CategoryService categories;
+ public DiscountCode save(DiscountCode d,MerchantStore s){ if(d.getCode()==null||d.getCode().trim().isEmpty()||d.getType()==null||d.getValue()==null) throw new IllegalArgumentException("code, type and value are required"); if(d.getType()==DiscountType.PERCENT&&(d.getValue().signum()<=0||d.getValue().compareTo(java.math.BigDecimal.valueOf(100))>0)||d.getType()==DiscountType.AMOUNT&&d.getValue().signum()<=0) throw new IllegalArgumentException("invalid value"); if(d.getStartDate()==null)d.setStartDate(LocalDate.now()); if(d.getEndDate()!=null&&d.getEndDate().isBefore(d.getStartDate()))throw new IllegalArgumentException("invalid dates"); DiscountCode existing=repo.findByMerchantStoreIdAndCodeIgnoreCase(s.getId(),d.getCode()); if(existing!=null&&(d.getId()==null||!existing.getId().equals(d.getId())))throw new IllegalStateException("duplicate code"); if(d.getCategories()!=null) for(String c:d.getCategories()) try { if(categories.getByCode(s,c)==null)throw new IllegalArgumentException("unknown category: "+c); } catch(com.salesmanager.core.business.exception.ServiceException e){throw new IllegalArgumentException("unknown category: "+c,e);} d.setMerchantStore(s); return repo.save(d); }
+ public List<DiscountCode> list(MerchantStore s){return repo.findByMerchantStoreId(s.getId());} public DiscountCode get(Long id,MerchantStore s){return repo.findByIdAndMerchantStoreId(id,s.getId());} public void delete(Long id,MerchantStore s){DiscountCode d=get(id,s);if(d!=null)repo.delete(d);} public DiscountCode find(String c,MerchantStore s){return c==null?null:repo.findByMerchantStoreIdAndCodeIgnoreCase(s.getId(),c);}
+}
