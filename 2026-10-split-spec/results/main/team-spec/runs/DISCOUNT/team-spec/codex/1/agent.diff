+package com.salesmanager.core.business.services.discount;
+import java.math.*; import java.time.*; import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service; import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.business.repositories.discount.DiscountCodeRepository; import com.salesmanager.core.model.discount.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("discountCodeService") public class DiscountCodeServiceImpl implements DiscountCodeService { @Inject private DiscountCodeRepository repo;
+ public DiscountCode save(DiscountCode d,MerchantStore s)throws ServiceException { if(d==null||d.getCode()==null||d.getCode().trim().isEmpty()||d.getType()==null||d.getValue()==null) throw new ServiceException("code, type and value are required"); if(d.getType()==DiscountType.PERCENT && (d.getValue().compareTo(BigDecimal.ZERO)<=0||d.getValue().compareTo(new BigDecimal("100"))>0)) throw new ServiceException("invalid percentage"); if(d.getType()==DiscountType.AMOUNT&&d.getValue().compareTo(BigDecimal.ZERO)<=0)throw new ServiceException("invalid amount"); if(d.getStartDate()==null)d.setStartDate(LocalDate.now()); if(d.getEndDate()!=null&&d.getEndDate().isBefore(d.getStartDate()))throw new ServiceException("invalid dates"); DiscountCode x=repo.findByCode(s.getId(),d.getCode()); if(x!=null&&(d.getId()==null||!x.getId().equals(d.getId())))throw new DuplicateDiscountException(); d.setMerchantStore(s); return repo.save(d); }
+ public List<DiscountCode> list(MerchantStore s){return repo.findByStore(s.getId());} public DiscountCode get(Long id,MerchantStore s){return repo.findByIdAndStore(id,s.getId());} public DiscountCode find(String c,MerchantStore s){return repo.findByCode(s.getId(),c);} public void delete(Long id,MerchantStore s)throws ServiceException{DiscountCode d=get(id,s);if(d==null)throw new ServiceException("not found");repo.delete(d);}
+ public boolean applies(DiscountCode d,MerchantStore s,BigDecimal sub,Set<String> cats){LocalDate n=LocalDate.now();return d!=null&&d.getMerchantStore().getId().equals(s.getId())&&d.isActive()&&(d.getStartDate()==null||!n.isBefore(d.getStartDate()))&&(d.getEndDate()==null||!n.isAfter(d.getEndDate()))&&(d.getMinimumSubtotal()==null||sub.compareTo(d.getMinimumSubtotal())>=0)&&(d.getCategories().isEmpty()||!Collections.disjoint(d.getCategories(),cats));}
+ public BigDecimal discount(DiscountCode d,BigDecimal eligible){BigDecimal x=d.getType()==DiscountType.PERCENT?eligible.multiply(d.getValue()).divide(new BigDecimal("100"),8,RoundingMode.HALF_UP):d.getValue();return x.min(eligible).setScale(2,RoundingMode.HALF_UP);}
+ public static class DuplicateDiscountException extends ServiceException {public DuplicateDiscountException(){super("discount code already exists");}}
+}
