+package com.salesmanager.shop.store.api.v1.discount;
+import java.util.*; import javax.inject.Inject; import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.business.services.discount.*; import com.salesmanager.core.model.discount.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.reference.language.Language; import com.salesmanager.shop.model.discount.PersistableDiscountCode; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/discounts") public class DiscountApi { @Inject private DiscountCodeService service;
+ private DiscountCode convert(PersistableDiscountCode x,MerchantStore s){DiscountCode d=new DiscountCode();d.setId(x.getId());d.setCode(x.getCode());d.setType(x.getType());d.setValue(x.getValue());d.setMinimumSubtotal(x.getMinimumSubtotal());d.setStartDate(x.getStartDate());d.setEndDate(x.getEndDate());d.setCategories(x.getCategories()==null?new HashSet<>():x.getCategories());d.setActive(x.getActive()==null||x.getActive());d.setMerchantStore(s);return d;}
+ @PostMapping public ResponseEntity<DiscountCode> create(@RequestBody PersistableDiscountCode x,@ApiIgnore MerchantStore s,@ApiIgnore Language l)throws Exception{return new ResponseEntity<>(service.save(convert(x,s),s),HttpStatus.CREATED);}
