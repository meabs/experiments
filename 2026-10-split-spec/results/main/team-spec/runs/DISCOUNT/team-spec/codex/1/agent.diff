+ @PutMapping("/{id}") public DiscountCode update(@PathVariable Long id,@RequestBody PersistableDiscountCode x,@ApiIgnore MerchantStore s,@ApiIgnore Language l)throws Exception{x.setId(id);return service.save(convert(x,s),s);}
+ @DeleteMapping("/{id}") @ResponseStatus(HttpStatus.NO_CONTENT) public void delete(@PathVariable Long id,@ApiIgnore MerchantStore s)throws Exception{service.delete(id,s);}
