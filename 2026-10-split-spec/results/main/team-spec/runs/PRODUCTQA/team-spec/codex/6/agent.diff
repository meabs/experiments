+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal; import java.util.*; import javax.inject.Inject; import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.*; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.*; import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.ProductQuestion; import com.salesmanager.core.model.catalog.product.ProductQuestionStatus; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.catalog.product.*; import com.salesmanager.shop.store.api.exception.ResourceNotFoundException; import com.salesmanager.shop.store.api.exception.RestApiException; import com.salesmanager.shop.store.api.exception.UnauthorizedException; import com.salesmanager.shop.store.api.exception.ConflictException; import springfox.documentation.annotations.ApiIgnore;
+
+@RestController @RequestMapping("/api/v1") public class ProductQuestionApi {
+ @Inject ProductQuestionService questions; @Inject ProductService products; @Inject CustomerService customers;
+ private Product product(String sku, MerchantStore store){ try { Product p=products.getBySku(sku,store); if(p==null) throw new ResourceNotFoundException("Product not found"); return p; } catch(Exception e){ if(e instanceof ResourceNotFoundException) throw (ResourceNotFoundException)e; throw new ResourceNotFoundException("Product not found"); } }
+ private ProductQuestionData data(ProductQuestion q){ ProductQuestionData d=new ProductQuestionData(); d.id=q.getId(); d.sku=q.getProduct().getSku(); d.text=q.getText(); d.status=q.getStatus().name(); d.answer=q.getAnswer(); d.askedAt=q.getAskedAt(); d.answeredAt=q.getAnsweredAt(); try { d.askedBy=q.getCustomer().getBilling().getFirstName(); } catch(Exception e){ d.askedBy=""; } return d; }
+ private void valid(String v,int max){if(v==null)throw new RestApiException("400","value is required"); String x=v.trim(); if(x.length()<1||x.length()>max) throw new RestApiException("400","invalid length");}
+ @PostMapping("/auth/products/{sku}/questions") @ResponseStatus(HttpStatus.CREATED) public ProductQuestionData ask(@PathVariable String sku,@RequestBody ProductQuestionRequest req,@ApiIgnore MerchantStore store,HttpServletRequest request){valid(req.getText(),500); if(req.getText().trim().length()<10) throw new RestApiException("400","question too short"); Principal pr=request.getUserPrincipal(); if(pr==null) throw new UnauthorizedException(); Customer c=customers.getByNick(pr.getName(),store.getId().intValue()); if(c==null) throw new UnauthorizedException(); Product p=product(sku,store); if(questions.pending(c)>=3) throw new RestApiException("400","too many pending questions"); ProductQuestion q=new ProductQuestion(); q.setProduct(p);q.setCustomer(c);q.setMerchantStore(store);q.setText(req.getText().trim()); return data(questions.save(q)); }
+ @GetMapping("/auth/customer/questions") public ProductQuestionList mine(@ApiIgnore MerchantStore store,HttpServletRequest request){Principal pr=request.getUserPrincipal();if(pr==null)throw new UnauthorizedException();Customer c=customers.getByNick(pr.getName(),store.getId().intValue());if(c==null)throw new UnauthorizedException();return list(questions.byCustomer(c,store),false);}
+ @GetMapping("/products/{sku}/questions") public ProductQuestionList published(@PathVariable String sku,@ApiIgnore MerchantStore store){return list(questions.byProduct(product(sku,store)),true);}
+ private ProductQuestionList list(List<ProductQuestion> qs,boolean pub){ProductQuestionList l=new ProductQuestionList();for(ProductQuestion q:qs){ProductQuestionData d=data(q);if(pub){d.sku=null;d.status=null;d.askedAt=null;}l.items.add(d);}l.count=l.items.size();return l;}
+ @GetMapping("/private/questions") public ProductQuestionList admin(@RequestParam(defaultValue="PENDING") String status,@ApiIgnore MerchantStore store){ProductQuestionStatus s;try{s=ProductQuestionStatus.valueOf(status);}catch(Exception e){throw new RestApiException("400","invalid status");}return list(questions.byStore(store,s),false);}
+ @PutMapping("/private/questions/{id}/answer") public ProductQuestionData answer(@PathVariable Long id,@RequestBody ProductAnswerRequest req,@ApiIgnore MerchantStore store){valid(req.getAnswer(),2000);ProductQuestion q=questions.get(id);if(q==null)throw new ResourceNotFoundException("Question not found");if(q.getMerchantStore().getId().longValue()!=store.getId().longValue())throw new ResourceNotFoundException("Question not found");if(q.getStatus()==ProductQuestionStatus.REJECTED)throw new ConflictException("rejected question");q.setAnswer(req.getAnswer().trim());q.setAnsweredAt(new Date());q.setStatus(ProductQuestionStatus.PUBLISHED);return data(questions.save(q));}
+ @PutMapping("/private/questions/{id}/reject") public ProductQuestionData reject(@PathVariable Long id,@ApiIgnore MerchantStore store){ProductQuestion q=questions.get(id);if(q==null||q.getMerchantStore().getId().longValue()!=store.getId().longValue())throw new ResourceNotFoundException("Question not found");q.setStatus(ProductQuestionStatus.REJECTED);return data(questions.save(q));}
+}
