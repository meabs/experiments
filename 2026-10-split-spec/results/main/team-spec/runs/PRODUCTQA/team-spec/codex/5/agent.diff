+package com.salesmanager.shop.store.api.v1.product;
+import java.security.Principal; import java.util.*; import javax.servlet.http.HttpServletRequest; import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import javax.inject.Inject;
+import com.salesmanager.core.business.services.catalog.product.ProductQuestionService; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.customer.CustomerService; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.ProductQuestion; import com.salesmanager.core.model.catalog.product.ProductQuestionStatus; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.catalog.product.ProductQuestionRequest; import com.salesmanager.shop.model.catalog.product.ReadableProductQuestion; import com.salesmanager.shop.model.catalog.product.ReadableProductQuestionList; import com.salesmanager.shop.store.api.exception.*; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class ProductQuestionApi {
+ @Inject private ProductQuestionService questions; @Inject private ProductService products; @Inject private CustomerService customers;
+ private Product product(String sku, MerchantStore store){try{Product p=products.getBySku(sku,store); if(p==null) throw new ResourceNotFoundException("Product not found"); return p;}catch(Exception e){if(e instanceof ResourceNotFoundException) throw (ResourceNotFoundException)e; throw new ResourceNotFoundException("Product not found");}}
+ private Customer customer(HttpServletRequest r, MerchantStore s){Principal p=r.getUserPrincipal(); if(p==null) throw new UnauthorizedException(); Customer c=customers.getByNick(p.getName(),s.getId()); if(c==null) throw new ResourceNotFoundException("Customer not found"); return c;}
+ private ReadableProductQuestion dto(ProductQuestion q, boolean full){ReadableProductQuestion d=new ReadableProductQuestion(); d.setId(q.getId()); d.setSku(q.getProduct().getSku()); d.setText(q.getText()); d.setStatus(q.getStatus().name()); d.setAnswer(q.getAnswer()); d.setAskedAt(q.getAskedAt()); d.setAnsweredAt(q.getAnsweredAt()); d.setAskedBy(q.getCustomer().getBilling()==null?null:q.getCustomer().getBilling().getFirstName()); if(!full){d.setStatus(null);d.setSku(null);d.setAskedAt(null);} return d;}
+ private void valid(String s,int max,String what){if(s==null || s.trim().length()< (what.equals("question")?10:1) || s.trim().length()>max) throw new RestApiException(what+" length is invalid");}
+ @PostMapping("/auth/products/{sku}/questions") @ResponseStatus(HttpStatus.CREATED) public ReadableProductQuestion ask(@PathVariable String sku,@RequestBody ProductQuestionRequest b,@ApiIgnore MerchantStore store,HttpServletRequest req){valid(b.getText(),500,"question"); Customer c=customer(req,store); if(questions.pending(c.getId())>=3) throw new RestApiException("Too many pending questions"); ProductQuestion q=new ProductQuestion(); q.setProduct(product(sku,store));q.setCustomer(c);q.setText(b.getText().trim());save(q);return dto(q,true);}
+ @GetMapping("/auth/customer/questions") public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store,HttpServletRequest req){List<ReadableProductQuestion> out=new ArrayList<>();for(ProductQuestion q:questions.byCustomer(customer(req,store).getId()))out.add(dto(q,true));return out;}
+ @GetMapping("/products/{sku}/questions") public ReadableProductQuestionList pub(@PathVariable String sku,@ApiIgnore MerchantStore store){List<ReadableProductQuestion> out=new ArrayList<>();for(ProductQuestion q:questions.published(product(sku,store).getId()))out.add(dto(q,false));ReadableProductQuestionList l=new ReadableProductQuestionList();l.setItems(out);l.setCount(out.size());return l;}
+ @GetMapping("/private/questions") public List<ReadableProductQuestion> admin(@RequestParam(defaultValue="PENDING") String status,@ApiIgnore MerchantStore store){ProductQuestionStatus s;try{s=ProductQuestionStatus.valueOf(status);}catch(Exception e){throw new RestApiException("Invalid status");}List<ReadableProductQuestion> out=new ArrayList<>();for(ProductQuestion q:questions.byStore(Long.valueOf(store.getId()),s))out.add(dto(q,true));return out;}
+ private ProductQuestion q(Long id){try{return questions.getById(id);}catch(Exception e){return null;}}
+ private void save(ProductQuestion q){try{questions.save(q);}catch(Exception e){throw new RestApiException("Unable to save question",e);}}
+ @PutMapping("/private/questions/{id}/answer") public ReadableProductQuestion answer(@PathVariable Long id,@RequestBody ProductQuestionRequest b,@ApiIgnore MerchantStore store){valid(b.getAnswer(),2000,"answer");ProductQuestion q=q(id);if(q==null)throw new ResourceNotFoundException("Question not found");if(q.getProduct().getMerchantStore().getId().intValue()!=store.getId().intValue())throw new ResourceNotFoundException("Question not found");if(q.getStatus()==ProductQuestionStatus.REJECTED)throw new ProductQuestionConflictException("Rejected question");q.setAnswer(b.getAnswer().trim());q.setStatus(ProductQuestionStatus.PUBLISHED);q.setAnsweredAt(new Date());save(q);return dto(q,true);}
+ @PutMapping("/private/questions/{id}/reject") public ReadableProductQuestion reject(@PathVariable Long id,@ApiIgnore MerchantStore store){ProductQuestion q=q(id);if(q==null||q.getProduct().getMerchantStore().getId().intValue()!=store.getId().intValue())throw new ResourceNotFoundException("Question not found");q.setStatus(ProductQuestionStatus.REJECTED);save(q);return dto(q,true);}
+}
