+import com.salesmanager.core.model.catalog.product.*; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("productQuestionService") public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long,ProductQuestion> implements ProductQuestionService {
+ private final ProductQuestionRepository repo; @Inject public ProductQuestionServiceImpl(ProductQuestionRepository r){super(r);repo=r;}
+ @Override public ProductQuestion getById(Long id){return repo.findById(id).orElse(null);}
+ public List<ProductQuestion> listPublished(Product p){return repo.findByProductAndStatusOrderByAnsweredAtDesc(p,ProductQuestionStatus.PUBLISHED);}
+ public List<ProductQuestion> listCustomer(Customer c){return repo.findByCustomerOrderByAskedAtDesc(c);}
+ public List<ProductQuestion> listStore(MerchantStore s,ProductQuestionStatus st){return repo.findByMerchantStoreAndStatusOrderByAskedAtAsc(s,st);}
+ public long pending(Customer c){return repo.countByCustomerAndStatus(c,ProductQuestionStatus.PENDING);}
+}
