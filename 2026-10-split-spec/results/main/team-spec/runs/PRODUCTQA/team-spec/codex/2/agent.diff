+package com.salesmanager.shop.store.api.v1.catalog;
+import java.security.Principal; import java.util.*; import javax.inject.Inject; import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.*; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.*; import com.salesmanager.core.business.services.customer.CustomerService; import com.salesmanager.core.model.catalog.product.*; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.catalog.*; import com.salesmanager.shop.store.api.exception.*; import com.salesmanager.shop.store.controller.store.facade.StoreFacade; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class ProductQuestionApi {
+ @Inject ProductQuestionService questions; @Inject ProductService products; @Inject CustomerService customers;
+ private Product product(String sku,MerchantStore store){try{Product p=products.getBySku(sku,store);if(p==null)throw new ResourceNotFoundException("Product not found");return p;}catch(Exception e){if(e instanceof ResourceNotFoundException)throw (ResourceNotFoundException)e;throw new ResourceNotFoundException("Product not found");}}
+ private Customer customer(HttpServletRequest req,MerchantStore store){Principal p=req.getUserPrincipal();if(p==null)throw new UnauthorizedException();Customer c=customers.getByNick(p.getName(),store.getId().intValue());if(c==null)throw new UnauthorizedException();return c;}
+ private ProductQuestionResponse dto(ProductQuestion q){ProductQuestionResponse d=new ProductQuestionResponse();d.id=q.getId();d.sku=q.getProduct().getSku();d.text=q.getText();d.status=q.getStatus().name();d.answer=q.getAnswer();d.askedBy=q.getCustomer().getBilling()==null?null:q.getCustomer().getBilling().getFirstName();d.askedAt=q.getAskedAt();d.answeredAt=q.getAnsweredAt();return d;}
+ @PostMapping("/auth/products/{sku}/questions") @ResponseStatus(HttpStatus.CREATED) public ProductQuestionResponse ask(@PathVariable String sku,@RequestBody ProductQuestionRequest in,@ApiIgnore MerchantStore store,HttpServletRequest req){String t=in.getText()==null?null:in.getText().trim();if(t==null||t.length()<10||t.length()>500)throw new ServiceRuntimeException("400","Invalid question");Product p=product(sku,store);Customer c=customer(req,store);if(questions.pending(c)>=3)throw new ServiceRuntimeException("400","Too many pending questions");ProductQuestion q=new ProductQuestion();q.setProduct(p);q.setCustomer(c);q.setMerchantStore(store);q.setText(t);try{questions.create(q);}catch(Exception e){throw new ServiceRuntimeException("400",e.getMessage());}return dto(q);}
+ @GetMapping("/auth/customer/questions") public List<ProductQuestionResponse> mine(@ApiIgnore MerchantStore store,HttpServletRequest req){List<ProductQuestionResponse> out=new ArrayList<>();for(ProductQuestion q:questions.listCustomer(customer(req,store)))out.add(dto(q));return out;}
+ @GetMapping("/products/{sku}/questions") public ProductQuestionList published(@PathVariable String sku,@ApiIgnore MerchantStore store){List<PublicProductQuestion> out=new ArrayList<>();for(ProductQuestion q:questions.listPublished(product(sku,store))) {ProductQuestionResponse d=dto(q);PublicProductQuestion p=new PublicProductQuestion();p.id=d.id;p.text=d.text;p.answer=d.answer;p.askedBy=d.askedBy;p.answeredAt=d.answeredAt;out.add(p);}return new ProductQuestionList(out);}
+ @GetMapping("/private/questions") public List<ProductQuestionResponse> admin(@RequestParam(defaultValue="PENDING") String status,@ApiIgnore MerchantStore store){ProductQuestionStatus s;try{s=ProductQuestionStatus.valueOf(status);}catch(Exception e){throw new ServiceRuntimeException("400","Invalid status");}List<ProductQuestionResponse> out=new ArrayList<>();for(ProductQuestion q:questions.listStore(store,s))out.add(dto(q));return out;}
+ @PutMapping("/private/questions/{id}/answer") public ProductQuestionResponse answer(@PathVariable Long id,@RequestBody ProductQuestionRequest in,@ApiIgnore MerchantStore store){ProductQuestion q=get(id,store);if(q.getStatus()==ProductQuestionStatus.REJECTED)throw new ServiceRuntimeException("409","Rejected question");String a=in.getAnswer()==null?null:in.getAnswer().trim();if(a==null||a.length()<1||a.length()>2000)throw new ServiceRuntimeException("400","Invalid answer");q.setAnswer(a);q.setStatus(ProductQuestionStatus.PUBLISHED);q.setAnsweredAt(new Date());try{questions.update(q);}catch(Exception e){throw new ServiceRuntimeException("400",e.getMessage());}return dto(q);}
+ @PutMapping("/private/questions/{id}/reject") public ProductQuestionResponse reject(@PathVariable Long id,@ApiIgnore MerchantStore store){ProductQuestion q=get(id,store);q.setStatus(ProductQuestionStatus.REJECTED);try{questions.update(q);}catch(Exception e){throw new ServiceRuntimeException("400",e.getMessage());}return dto(q);}
+ private ProductQuestion get(Long id,MerchantStore s){ProductQuestion q;try{q=questions.getById(id);}catch(Exception e){q=null;}if(q==null||q.getMerchantStore()==null||!q.getMerchantStore().getId().equals(s.getId()))throw new ResourceNotFoundException("Question not found");return q;}
+}
