+package com.salesmanager.shop.store.api.v1.product;
+import java.security.Principal; import java.util.*; import javax.inject.Inject;
+import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import org.springframework.security.core.context.SecurityContextHolder;
+import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.catalog.product.question.*; import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.question.*; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.*; import com.salesmanager.shop.store.api.exception.*; import com.salesmanager.shop.store.security.user.JWTUser; import springfox.documentation.annotations.ApiIgnore;
+
+@RestController @RequestMapping("/api/v1") public class ProductQuestionApi {
+ @Inject ProductService products; @Inject ProductQuestionService questions; @Inject CustomerService customers;
+ private Customer customer(){Object p=SecurityContextHolder.getContext().getAuthentication()==null?null:SecurityContextHolder.getContext().getAuthentication().getPrincipal(); if(!(p instanceof JWTUser)) throw new UnauthorizedException(); Long id=((JWTUser)p).getId(); Customer c=customers.getById(id); if(c==null) throw new UnauthorizedException(); return c;}
+ private ProductQuestionEntity dto(ProductQuestion q, boolean pub){ProductQuestionEntity d=new ProductQuestionEntity(); d.setId(q.getId()); d.setSku(q.getProduct().getSku()); d.setText(q.getText()); d.setAnswer(q.getAnswer()); d.setStatus(q.getStatus().name()); d.setAskedAt(q.getAskedAt()); d.setAnsweredAt(q.getAnsweredAt()); if(q.getCustomer()!=null&&q.getCustomer().getBilling()!=null)d.setAskedBy(q.getCustomer().getBilling().getFirstName()); if(pub){d.setStatus(null);d.setSku(null);d.setAskedAt(null);} return d;}
+ @PostMapping("/auth/products/{sku}/questions") @ResponseStatus(HttpStatus.CREATED) public ProductQuestionEntity ask(@PathVariable String sku,@RequestBody ProductQuestionRequest in,@ApiIgnore MerchantStore store){Customer c=customer(); String text=in==null?null:in.getText(); if(text==null||(text=text.trim()).length()<10||text.length()>500)throw new QuestionBadRequestException("Question must be between 10 and 500 characters"); Product p=product(sku,store); if(p==null)throw new ResourceNotFoundException("Unknown product"); if(questions.countPending(c)>=3)throw new QuestionBadRequestException("Too many pending questions"); ProductQuestion q=new ProductQuestion();q.setProduct(p);q.setCustomer(c);q.setMerchantId(store.getId());q.setText(text); try{questions.create(q);}catch(Exception e){throw new ServiceRuntimeException(e);} return dto(q,false);}
+ @GetMapping("/auth/customer/questions") public List<ProductQuestionEntity> mine(){List<ProductQuestionEntity> out=new ArrayList<>();for(ProductQuestion q:questions.getByCustomer(customer()))out.add(dto(q,false));return out;}
+ @GetMapping("/products/{sku}/questions") public ProductQuestionList published(@PathVariable String sku,@ApiIgnore MerchantStore store){Product p=product(sku,store);if(p==null)throw new ResourceNotFoundException("Unknown product");List<PublicProductQuestion> out=new ArrayList<>();for(ProductQuestion q:questions.getPublishedByProduct(p.getId())){PublicProductQuestion d=new PublicProductQuestion();d.setId(q.getId());d.setText(q.getText());d.setAnswer(q.getAnswer());d.setAnsweredAt(q.getAnsweredAt());if(q.getCustomer()!=null&&q.getCustomer().getBilling()!=null)d.setAskedBy(q.getCustomer().getBilling().getFirstName());out.add(d);}return new ProductQuestionList(out);}
+ @GetMapping("/private/questions") public List<ProductQuestionEntity> adminList(@RequestParam(defaultValue="PENDING") String status,@ApiIgnore MerchantStore store){ProductQuestionStatus s;try{s=ProductQuestionStatus.valueOf(status);}catch(Exception e){throw new QuestionBadRequestException("Invalid status");}List<ProductQuestionEntity> out=new ArrayList<>();for(ProductQuestion q:questions.getByStoreAndStatus(store.getId(),s))out.add(dto(q,false));return out;}
+ @PutMapping("/private/questions/{id}/answer") public ProductQuestionEntity answer(@PathVariable Long id,@RequestBody ProductQuestionRequest in,@ApiIgnore MerchantStore store){ProductQuestion q=adminQuestion(id,store); if(q.getStatus()==ProductQuestionStatus.REJECTED)throw new QuestionConflictException("Rejected question cannot be answered");String a=in==null?null:in.getAnswer();if(a==null||(a=a.trim()).length()<1||a.length()>2000)throw new QuestionBadRequestException("Answer must be between 1 and 2000 characters");q.setAnswer(a);q.setStatus(ProductQuestionStatus.PUBLISHED);q.setAnsweredAt(new Date());save(q);return dto(q,false);}
+ @PutMapping("/private/questions/{id}/reject") public ProductQuestionEntity reject(@PathVariable Long id,@ApiIgnore MerchantStore store){ProductQuestion q=adminQuestion(id,store);q.setStatus(ProductQuestionStatus.REJECTED);save(q);return dto(q,false);}
+ private ProductQuestion adminQuestion(Long id,MerchantStore s){ProductQuestion q=questions.getById(id);if(q==null||q.getMerchantId()==null||!q.getMerchantId().equals(s.getId()))throw new ResourceNotFoundException("Unknown question");return q;} private void save(ProductQuestion q){try{questions.update(q);}catch(Exception e){throw new ServiceRuntimeException(e);}}
+ private Product product(String sku, MerchantStore store){try{return products.getBySku(sku,store);}catch(Exception e){throw new ServiceRuntimeException(e);}}
+}
