+package com.salesmanager.core.business.services.catalog.product.question;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.business.services.common.generic.SalesManagerEntityServiceImpl;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.*;
+import com.salesmanager.core.model.customer.Customer;
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl extends SalesManagerEntityServiceImpl<Long,ProductQuestion> implements ProductQuestionService {
+ private final ProductQuestionRepository repo;
+ @Inject public ProductQuestionServiceImpl(ProductQuestionRepository repo){super(repo);this.repo=repo;}
+ public ProductQuestion ask(Product p,Customer c,String text){ProductQuestion q=new ProductQuestion();q.setProduct(p);q.setCustomer(c);q.setText(text);q.setStatus(ProductQuestionStatus.PENDING);q.setAskedAt(new Date());return repo.saveAndFlush(q);}
+ public ProductQuestion find(Long id){return repo.findById(id).orElse(null);}
+ public List<ProductQuestion> byCustomer(Customer c){return repo.findByCustomerIdOrderByAskedAtDesc(c.getId());}
+ public List<ProductQuestion> published(Product p){return repo.findByProductIdAndStatusOrderByAnsweredAtDesc(p.getId(),ProductQuestionStatus.PUBLISHED);}
+ public List<ProductQuestion> byStore(Integer id,ProductQuestionStatus s){return repo.findByProductMerchantStoreIdAndStatusOrderByAskedAtAsc(id,s);}
+ public long pendingCount(Customer c){return repo.countByCustomerIdAndStatus(c.getId(),ProductQuestionStatus.PENDING);}
+ public ProductQuestion answer(ProductQuestion q,String a){q.setAnswer(a);q.setStatus(ProductQuestionStatus.PUBLISHED);q.setAnsweredAt(new Date());return repo.saveAndFlush(q);}
+ public ProductQuestion reject(ProductQuestion q){q.setStatus(ProductQuestionStatus.REJECTED);return repo.saveAndFlush(q);}
+}
