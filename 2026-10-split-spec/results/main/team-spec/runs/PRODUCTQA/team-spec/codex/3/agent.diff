+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal; import java.util.*; import javax.inject.Inject; import javax.servlet.http.HttpServletRequest;
+import org.springframework.http.*; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.business.services.customer.CustomerService; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.question.*; import com.salesmanager.core.model.customer.Customer; import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.*; import com.salesmanager.shop.store.api.exception.*; import com.salesmanager.shop.utils.DateUtil; import springfox.documentation.annotations.ApiIgnore;
+
+@RestController @RequestMapping("/api/v1")
+public class ProductQuestionApi {
+ @Inject private ProductService products; @Inject private CustomerService customers; @Inject private ProductQuestionService questions;
+ @PostMapping("/auth/products/{sku}/questions") @ResponseStatus(HttpStatus.CREATED)
+ public ReadableProductQuestion ask(@PathVariable String sku,@RequestBody ProductQuestionRequest body,@ApiIgnore MerchantStore store,HttpServletRequest req){
+  Product p=product(sku,store); Customer c=customer(req,store); String text=trim(body==null?null:body.getText()); valid(text,10,500,"Question text"); if(questions.pendingCount(c)>=3) throw new ConstraintException("Customer may have at most 3 pending questions"); return full(questions.ask(p,c,text)); }
+ @GetMapping("/auth/customer/questions") public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store,HttpServletRequest req){return full(questions.byCustomer(customer(req,store)));}
+ @GetMapping("/products/{sku}/questions") public ReadableProductQuestionList published(@PathVariable String sku,@ApiIgnore MerchantStore store){List<ReadableProductQuestion> out=publicView(questions.published(product(sku,store))); ReadableProductQuestionList l=new ReadableProductQuestionList();l.setItems(out);l.setCount(out.size());return l;}
+ @GetMapping("/private/questions") public List<ReadableProductQuestion> admin(@RequestParam(defaultValue="PENDING") String status,@ApiIgnore MerchantStore store){ProductQuestionStatus s;try{s=ProductQuestionStatus.valueOf(status);}catch(Exception e){throw new ConstraintException("Invalid question status");}return full(questions.byStore(store.getId(),s));}
+ @PutMapping("/private/questions/{id}/answer") public ReadableProductQuestion answer(@PathVariable Long id,@RequestBody ProductQuestionRequest body,@ApiIgnore MerchantStore store){ProductQuestion q=get(id,store);if(q.getStatus()==ProductQuestionStatus.REJECTED)throw new QuestionConflictException("Rejected question cannot be answered");String a=trim(body==null?null:body.getAnswer());valid(a,1,2000,"Answer");return full(questions.answer(q,a));}
+ @PutMapping("/private/questions/{id}/reject") public ReadableProductQuestion reject(@PathVariable Long id,@ApiIgnore MerchantStore store){return full(questions.reject(get(id,store)));}
+ private Product product(String sku,MerchantStore store){try{Product p=products.getBySku(sku,store);if(p==null)throw new ResourceNotFoundException("Unknown sku: "+sku);return p;}catch(ResourceNotFoundException e){throw e;}catch(Exception e){throw new ResourceNotFoundException("Unknown sku: "+sku);}}
+ private Customer customer(HttpServletRequest r,MerchantStore s){Principal p=r.getUserPrincipal();if(p==null)throw new UnauthorizedException();Customer c=customers.getByNick(p.getName(),s.getCode());if(c==null)throw new UnauthorizedException();return c;}
+ private ProductQuestion get(Long id,MerchantStore s){ProductQuestion q=questions.find(id);if(q==null||q.getProduct()==null||q.getProduct().getMerchantStore().getId().intValue()!=s.getId().intValue())throw new ResourceNotFoundException("Unknown question id: "+id);return q;}
+ private static String trim(String x){return x==null?null:x.trim();} private static void valid(String x,int min,int max,String n){if(x==null||x.length()<min||x.length()>max)throw new ConstraintException(n+" must be between "+min+" and "+max+" characters");}
+ private ReadableProductQuestion full(ProductQuestion q){ReadableProductQuestion r=base(q);r.setStatus(q.getStatus().name());r.setSku(q.getProduct().getSku());r.setAskedAt(q.getAskedAt()==null?null:DateUtil.formatLongDate(q.getAskedAt()));r.setAnsweredAt(q.getAnsweredAt()==null?null:DateUtil.formatLongDate(q.getAnsweredAt()));r.setAskedBy(q.getCustomer().getBilling()==null?null:q.getCustomer().getBilling().getFirstName());return r;}
+ private ReadableProductQuestion base(ProductQuestion q){ReadableProductQuestion r=new ReadableProductQuestion();r.setId(q.getId());r.setText(q.getText());r.setAnswer(q.getAnswer());return r;}
+ private List<ReadableProductQuestion> full(List<ProductQuestion> qs){List<ReadableProductQuestion> r=new ArrayList<>();for(ProductQuestion q:qs)r.add(full(q));return r;}
+ private List<ReadableProductQuestion> publicView(List<ProductQuestion> qs){List<ReadableProductQuestion> r=new ArrayList<>();for(ProductQuestion q:qs){ReadableProductQuestion x=base(q);x.setAskedBy(q.getCustomer().getBilling()==null?null:q.getCustomer().getBilling().getFirstName());x.setAnsweredAt(q.getAnsweredAt()==null?null:DateUtil.formatLongDate(q.getAnsweredAt()));r.add(x);}return r;}
+}
