+package com.salesmanager.shop.store.api.v1.product;
+
+import java.security.Principal;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.http.HttpStatus;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.question.ProductQuestionService;
+import com.salesmanager.core.business.services.customer.CustomerService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.*;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.question.*;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class ProductQuestionApi {
+ @Inject private ProductService products; @Inject private ProductQuestionService questions; @Inject private CustomerService customers;
+ @PostMapping("/auth/products/{sku}/questions") @ResponseStatus(HttpStatus.CREATED)
+ public ReadableProductQuestion ask(@PathVariable String sku,@RequestBody ProductQuestionRequest body,@ApiIgnore MerchantStore store,Principal principal){
+  Customer c=customer(principal,store); Product p=product(sku,store); String text=trim(body==null?null:body.getText());
+  if(text.length()<10||text.length()>500) bad("Question text must be between 10 and 500 characters"); if(questions.pendingCount(c)>=3) bad("Customer has too many pending questions");
+  try{return read(questions.ask(p,c,store,text),true);}catch(Exception e){throw new ServiceRuntimeException("Unable to save question",e);}
+ }
+ @GetMapping("/auth/customer/questions") public List<ReadableProductQuestion> mine(@ApiIgnore MerchantStore store,Principal principal){ Customer c=customer(principal,store); List<ReadableProductQuestion> out=new ArrayList<>(); for(ProductQuestion q:questions.byCustomer(c,store))out.add(read(q,true)); return out; }
+ @GetMapping("/products/{sku}/questions") public PublicProductQuestionList published(@PathVariable String sku,@ApiIgnore MerchantStore store){ Product p=product(sku,store); PublicProductQuestionList l=new PublicProductQuestionList(); List<PublicProductQuestion> out=new ArrayList<>(); for(ProductQuestion q:questions.published(p)){ PublicProductQuestion r=new PublicProductQuestion(); r.setId(q.getId());r.setText(q.getText());r.setAnswer(q.getAnswer());r.setAnsweredAt(q.getAnsweredAt());if(q.getCustomer()!=null&&q.getCustomer().getBilling()!=null)r.setAskedBy(q.getCustomer().getBilling().getFirstName());out.add(r); } l.setItems(out);l.setCount(out.size());return l; }
+ @GetMapping("/private/questions") public List<ReadableProductQuestion> admin(@RequestParam(required=false,defaultValue="PENDING") String status,@ApiIgnore MerchantStore store){ ProductQuestionStatus st; try{st=ProductQuestionStatus.valueOf(status);}catch(Exception e){bad("Invalid question status");return null;} List<ReadableProductQuestion> out=new ArrayList<>();for(ProductQuestion q:questions.byStore(store,st))out.add(read(q,true));return out; }
+ @PutMapping("/private/questions/{id}/answer") public ReadableProductQuestion answer(@PathVariable Long id,@RequestBody ProductQuestionAnswerRequest body,@ApiIgnore MerchantStore store){ ProductQuestion q=owned(id,store); if(q.getStatus()==ProductQuestionStatus.REJECTED) throw new ConflictException(); String a=trim(body==null?null:body.getAnswer());if(a.length()<1||a.length()>2000)bad("Answer must be between 1 and 2000 characters");q.setAnswer(a);q.setStatus(ProductQuestionStatus.PUBLISHED);q.setAnsweredAt(new Date());try{return read(questions.save(q),true);}catch(Exception e){throw new ServiceRuntimeException(e);} }
+ @PutMapping("/private/questions/{id}/reject") public ReadableProductQuestion reject(@PathVariable Long id,@ApiIgnore MerchantStore store){ ProductQuestion q=owned(id,store);q.setStatus(ProductQuestionStatus.REJECTED);try{return read(questions.save(q),true);}catch(Exception e){throw new ServiceRuntimeException(e);} }
+ private Product product(String sku,MerchantStore s){try{Product p=products.getBySku(sku,s);if(p==null)throw new Exception();return p;}catch(Exception e){throw new ResourceNotFoundException("Unknown product");}}
+ private Customer customer(Principal p,MerchantStore s){if(p==null)throw new ResourceNotFoundException("Customer not found");Customer c=customers.getByNick(p.getName(),s.getCode());if(c==null)throw new ResourceNotFoundException("Customer not found");return c;}
+ private ProductQuestion owned(Long id,MerchantStore s){ProductQuestion q=questions.get(id);if(q==null||q.getMerchantStore()==null||!q.getMerchantStore().getId().equals(s.getId()))throw new ResourceNotFoundException("Unknown question");return q;}
+ private String trim(String x){return x==null?"":x.trim();} private void bad(String m){throw new ServiceRuntimeException("400",m,new IllegalArgumentException(m));}
+ private ReadableProductQuestion read(ProductQuestion q,boolean full){ReadableProductQuestion r=new ReadableProductQuestion();r.setId(q.getId());r.setText(q.getText());r.setAnswer(q.getAnswer());r.setAnsweredAt(q.getAnsweredAt());if(full){r.setSku(q.getProduct().getSku());r.setStatus(q.getStatus().name());r.setAskedAt(q.getAskedAt());}if(q.getCustomer()!=null&&q.getCustomer().getBilling()!=null)r.setAskedBy(q.getCustomer().getBilling().getFirstName());return r;}
+ @ResponseStatus(HttpStatus.CONFLICT) @ExceptionHandler(ConflictException.class) public void conflict(){}
+ public static class ConflictException extends RuntimeException {private static final long serialVersionUID=1L;}
+}
