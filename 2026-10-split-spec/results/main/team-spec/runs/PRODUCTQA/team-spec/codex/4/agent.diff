+package com.salesmanager.core.business.services.catalog.product.question;
+import java.util.List;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.question.ProductQuestionRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.question.*;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("productQuestionService")
+public class ProductQuestionServiceImpl implements ProductQuestionService {
+ @Inject private ProductQuestionRepository repository;
+ public ProductQuestion ask(Product p, Customer c, MerchantStore s, String text) throws ServiceException { ProductQuestion q=new ProductQuestion(); q.setProduct(p);q.setCustomer(c);q.setMerchantStore(s);q.setText(text); return repository.saveAndFlush(q); }
+ public List<ProductQuestion> byCustomer(Customer c, MerchantStore s){return repository.findByCustomerAndMerchantStoreOrderByAskedAtDesc(c,s);}
+ public List<ProductQuestion> published(Product p){return repository.findByProductAndStatusOrderByAnsweredAtDesc(p,ProductQuestionStatus.PUBLISHED);}
+ public List<ProductQuestion> byStore(MerchantStore s, ProductQuestionStatus st){return repository.findByMerchantStoreAndStatusOrderByAskedAtAsc(s,st);}
+ public ProductQuestion get(Long id){return repository.findQuestion(id);}
+ public ProductQuestion save(ProductQuestion q) throws ServiceException{return repository.saveAndFlush(q);}
+ public long pendingCount(Customer c){return repository.countByCustomerAndStatus(c,ProductQuestionStatus.PENDING);}
+ public void deleteByProduct(Product p){repository.deleteByProduct(p);}
+}
