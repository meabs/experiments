+package com.salesmanager.core.business.services.catalog.product;
+import java.math.BigDecimal; import java.util.*;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.ProductTierRepository;
+import com.salesmanager.core.model.catalog.product.*;
+@Service("productTierService")
+public class ProductTierServiceImpl implements ProductTierService {
+ @Inject private ProductTierRepository repository;
+ @Override @Transactional(readOnly=true) public List<ProductTier> get(Product p){ return repository.findByProductIdOrderByMinQuantityAsc(p.getId()); }
+ @Override @Transactional public void replace(Product p,List<ProductTier> input) throws ServiceException {
+  if(input==null || input.size()>10) throw new ServiceException("Invalid tiers");
+  List<ProductTier> sorted = new ArrayList<>(input);
+  for(ProductTier t: sorted){ if(t==null||t.getMinQuantity()==null||t.getPrice()==null||t.getMinQuantity()<2||t.getPrice().compareTo(BigDecimal.ZERO)<=0) throw new ServiceException("Invalid tier"); }
+  sorted.sort(Comparator.comparing(ProductTier::getMinQuantity));
+  int previous=0; BigDecimal previousPrice=null; Set<Integer> seen=new HashSet<>();
+  for(ProductTier t: sorted){ if(!seen.add(t.getMinQuantity()) || t.getMinQuantity()<=previous || (previousPrice!=null && t.getPrice().compareTo(previousPrice)>=0)) throw new ServiceException("Invalid tier ordering"); previous=t.getMinQuantity(); previousPrice=t.getPrice(); }
+  repository.deleteByProductId(p.getId());
+  for(ProductTier t:sorted){ t.setId(null); t.setProduct(p); repository.save(t); }
+ }
+}
