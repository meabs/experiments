+package com.salesmanager.core.business.services.catalog.product.price;
+
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.exception.ServiceException;
+import com.salesmanager.core.business.repositories.catalog.product.price.ProductPriceTierRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.price.ProductPriceTier;
+
+@Service("productPriceTierService")
+public class ProductPriceTierServiceImpl implements ProductPriceTierService {
+    private final ProductPriceTierRepository repository;
+    @Inject public ProductPriceTierServiceImpl(ProductPriceTierRepository repository) { this.repository = repository; }
+    @Override public List<ProductPriceTier> get(Product product) { return new ArrayList<>(product.getPriceTiers()); }
+    @Override @Transactional
+    public List<ProductPriceTier> replace(Product product, List<ProductPriceTier> tiers) throws ServiceException {
+        if (tiers == null || tiers.size() > 10) throw new ServiceException("At most 10 tiers are allowed");
+        List<ProductPriceTier> sorted = new ArrayList<>(tiers);
+        sorted.sort(Comparator.comparing(ProductPriceTier::getMinQuantity));
+        Integer previousQuantity = null; java.math.BigDecimal previousPrice = null;
+        for (ProductPriceTier tier : sorted) {
+            if (tier.getMinQuantity() == null || tier.getMinQuantity() < 2 || tier.getPrice() == null || tier.getPrice().signum() <= 0)
+                throw new ServiceException("Invalid price tier");
+            if (previousQuantity != null && (previousQuantity.equals(tier.getMinQuantity()) || tier.getPrice().compareTo(previousPrice) >= 0))
+                throw new ServiceException("Invalid price tier ordering");
+            previousQuantity = tier.getMinQuantity(); previousPrice = tier.getPrice();
+        }
+        product.getPriceTiers().clear();
+        for (ProductPriceTier tier : sorted) { tier.setId(null); tier.setProduct(product); product.getPriceTiers().add(tier); }
+        return get(product);
+    }
+}
