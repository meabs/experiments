+package com.salesmanager.shop.store.api.v1.product;
+import java.util.*; import javax.inject.Inject;
+import org.springframework.http.*; import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductQuantityTierService;
+import com.salesmanager.core.model.catalog.product.ProductQuantityTier; import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException; import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1/private/product/{id}/tiers") public class ProductQuantityTierApi {
+ @Inject private ProductQuantityTierService service;
+ @GetMapping public List<com.salesmanager.shop.model.catalog.product.ProductQuantityTier> get(@PathVariable Long id,@ApiIgnore MerchantStore store){return convert(required(id,store));}
+ @PutMapping public List<com.salesmanager.shop.model.catalog.product.ProductQuantityTier> put(@PathVariable Long id,@RequestBody List<com.salesmanager.shop.model.catalog.product.ProductQuantityTier> body,@ApiIgnore MerchantStore store){
+  if(body==null) throw new ServiceRuntimeException("400","Invalid tiers"); List<ProductQuantityTier> in=new ArrayList<>(); for(com.salesmanager.shop.model.catalog.product.ProductQuantityTier x:body){ProductQuantityTier t=new ProductQuantityTier();t.setMinQuantity(x==null?null:x.getMinQuantity());t.setPrice(x==null?null:x.getPrice());in.add(t);} try{return convert(requiredReplace(id,store,in));}catch(IllegalArgumentException e){throw new ServiceRuntimeException("400",e.getMessage());}
+ }
+ private List<ProductQuantityTier> required(Long id,MerchantStore s){List<ProductQuantityTier> x=service.get(id,s);if(x==null)throw new ResourceNotFoundException("Product not found");return x;}
+ private List<ProductQuantityTier> requiredReplace(Long id,MerchantStore s,List<ProductQuantityTier> x){List<ProductQuantityTier> r=service.replace(id,s,x);if(r==null)throw new ResourceNotFoundException("Product not found");return r;}
+ private List<com.salesmanager.shop.model.catalog.product.ProductQuantityTier> convert(List<ProductQuantityTier> x){List<com.salesmanager.shop.model.catalog.product.ProductQuantityTier> out=new ArrayList<>();for(ProductQuantityTier t:x){com.salesmanager.shop.model.catalog.product.ProductQuantityTier d=new com.salesmanager.shop.model.catalog.product.ProductQuantityTier();d.setMinQuantity(t.getMinQuantity());d.setPrice(t.getPrice());out.add(d);}return out;}
+}
