+package com.salesmanager.core.business.services.catalog.product;
+import java.math.BigDecimal; import java.util.*; import javax.inject.Inject;
+import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.catalog.product.*; import com.salesmanager.core.model.catalog.product.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("productQuantityTierService") public class ProductQuantityTierServiceImpl implements ProductQuantityTierService {
+ @Inject ProductRepository products; @Inject ProductQuantityTierRepository tiers;
+ private Product product(Long id, MerchantStore s){ Product p=products.findById(id).orElse(null); return p!=null && p.getMerchantStore()!=null && p.getMerchantStore().getId().equals(s.getId())?p:null; }
+ public List<ProductQuantityTier> get(Long id, MerchantStore s){ Product p=product(id,s); return p==null?null:tiers.findByProductIdOrderByMinQuantityAsc(id); }
+ @Transactional public List<ProductQuantityTier> replace(Long id, MerchantStore s, List<ProductQuantityTier> input){ Product p=product(id,s); if(p==null)return null; if(input==null||input.size()>10)throw new IllegalArgumentException(); for(ProductQuantityTier t:input) if(t==null||t.getMinQuantity()==null||t.getPrice()==null) throw new IllegalArgumentException(); List<ProductQuantityTier> copy=new ArrayList<>(input); copy.sort(Comparator.comparing(ProductQuantityTier::getMinQuantity)); BigDecimal previous=null; Integer last=null; for(ProductQuantityTier t:copy){ if(t.getMinQuantity()<2||t.getPrice().compareTo(BigDecimal.ZERO)<=0||(last!=null&&last.equals(t.getMinQuantity()))||(previous!=null&&t.getPrice().compareTo(previous)>=0))throw new IllegalArgumentException(); last=t.getMinQuantity(); previous=t.getPrice(); } tiers.deleteByProductId(id); for(ProductQuantityTier t:copy){t.setId(null);t.setProduct(p);tiers.save(t);} return tiers.findByProductIdOrderByMinQuantityAsc(id); }
+}
