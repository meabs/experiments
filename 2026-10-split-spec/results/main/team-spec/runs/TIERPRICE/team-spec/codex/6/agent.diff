+package com.salesmanager.shop.store.api.v1.product;
+
+import java.math.BigDecimal;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.http.*;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductQuantityTierService;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductQuantityTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.product.ProductQuantityTierRequest;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.api.exception.ServiceRuntimeException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1/private/product/{id}/tiers")
+public class ProductQuantityTierApi {
+    @Inject private ProductService productService;
+    @Inject private ProductQuantityTierService tierService;
+
+    @GetMapping
+    public List<ProductQuantityTierRequest> get(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+        Product product = product(id, store);
+        return output(tierService.findByProduct(product));
+    }
+
+    @PutMapping
+    public ResponseEntity<List<ProductQuantityTierRequest>> put(@PathVariable Long id,
+            @RequestBody List<ProductQuantityTierRequest> request, @ApiIgnore MerchantStore store) throws Exception {
+        Product product = product(id, store);
+        validate(request);
+        List<ProductQuantityTier> tiers = new ArrayList<>();
+        for (ProductQuantityTierRequest input : request) {
+            ProductQuantityTier tier = new ProductQuantityTier();
+            tier.setMinQuantity(input.getMinQuantity()); tier.setPrice(input.getPrice()); tiers.add(tier);
+        }
+        tiers.sort(Comparator.comparing(ProductQuantityTier::getMinQuantity));
+        tierService.replace(product, tiers);
+        return ResponseEntity.ok(output(tiers));
+    }
+    private Product product(Long id, MerchantStore store) {
+        Product p = productService.findOne(id, store);
+        if (p == null) throw new ResourceNotFoundException("Product not found", new IllegalArgumentException("product"));
+        return p;
+    }
+    private void validate(List<ProductQuantityTierRequest> list) {
+        if (list == null || list.size() > 10) bad();
+        Set<Integer> mins = new HashSet<>(); BigDecimal previous = null;
+        List<ProductQuantityTierRequest> sorted = new ArrayList<>(list);
+        sorted.sort((a,b) -> {
+            Integer av = a == null ? null : a.getMinQuantity();
+            Integer bv = b == null ? null : b.getMinQuantity();
+            return Comparator.nullsFirst(Integer::compareTo).compare(av, bv);
+        });
+        for (ProductQuantityTierRequest t : sorted) {
+            if (t == null || t.getMinQuantity() == null || t.getPrice() == null || t.getMinQuantity() < 2 || t.getPrice().compareTo(BigDecimal.ZERO) <= 0 || !mins.add(t.getMinQuantity())) bad();
+            if (previous != null && t.getPrice().compareTo(previous) >= 0) bad();
+            previous = t.getPrice();
+        }
+    }
+    private void bad() { throw new ServiceRuntimeException("400", "Invalid quantity tiers", new IllegalArgumentException("tier")); }
+    private List<ProductQuantityTierRequest> output(List<ProductQuantityTier> tiers) {
+        List<ProductQuantityTierRequest> result = new ArrayList<>();
+        for (ProductQuantityTier t : tiers) { ProductQuantityTierRequest r = new ProductQuantityTierRequest(); r.setMinQuantity(t.getMinQuantity()); r.setPrice(t.getPrice()); result.add(r); }
+        return result;
+    }
+}
