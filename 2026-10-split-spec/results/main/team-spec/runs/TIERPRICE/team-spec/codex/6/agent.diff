+package com.salesmanager.core.model.catalog.product;
+
+import java.math.BigDecimal;
+import javax.persistence.*;
+import com.salesmanager.core.model.generic.SalesManagerEntity;
+
+/** A quantity break price belonging to exactly one product. */
+@Entity
+@Table(name = "PRODUCT_QUANTITY_TIER", uniqueConstraints = @UniqueConstraint(columnNames = {"PRODUCT_ID", "MIN_QUANTITY"}))
+public class ProductQuantityTier extends SalesManagerEntity<Long, ProductQuantityTier> {
+    @Id @GeneratedValue(strategy = GenerationType.AUTO)
+    @Column(name = "TIER_ID")
+    private Long id;
+    @ManyToOne(fetch = FetchType.LAZY, optional = false)
+    @JoinColumn(name = "PRODUCT_ID", nullable = false)
+    private Product product;
+    @Column(name = "MIN_QUANTITY", nullable = false)
+    private Integer minQuantity;
+    @Column(name = "PRICE", nullable = false, precision = 19, scale = 6)
+    private BigDecimal price;
+    public Long getId() { return id; }
+    public void setId(Long id) { this.id = id; }
+    public Product getProduct() { return product; }
+    public void setProduct(Product product) { this.product = product; }
+    public Integer getMinQuantity() { return minQuantity; }
+    public void setMinQuantity(Integer minQuantity) { this.minQuantity = minQuantity; }
+    public BigDecimal getPrice() { return price; }
+    public void setPrice(BigDecimal price) { this.price = price; }
+}
