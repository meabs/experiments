+package com.salesmanager.core.business.services.catalog.product;
+
+import java.math.BigDecimal;
+import java.util.*;
+import javax.inject.Inject;
+import javax.transaction.Transactional;
+import org.springframework.stereotype.Service;
+import com.salesmanager.core.business.repositories.catalog.product.ProductQuantityTierRepository;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.ProductQuantityTier;
+
+@Service("productQuantityTierService")
+public class ProductQuantityTierServiceImpl implements ProductQuantityTierService {
+    private final ProductQuantityTierRepository repository;
+    @Inject public ProductQuantityTierServiceImpl(ProductQuantityTierRepository repository) { this.repository = repository; }
+    public List<ProductQuantityTier> findByProduct(Product product) { return repository.findByProductIdOrderByMinQuantityAsc(product.getId()); }
+    @Transactional
+    public void replace(Product product, List<ProductQuantityTier> tiers) {
+        repository.deleteByProductId(product.getId());
+        repository.flush();
+        for (ProductQuantityTier tier : tiers) tier.setProduct(product);
+        repository.saveAll(tiers);
+        repository.flush();
+    }
+    public BigDecimal priceForQuantity(Product product, int quantity) {
+        BigDecimal result = null;
+        for (ProductQuantityTier t : findByProduct(product)) if (quantity >= t.getMinQuantity()) result = t.getPrice();
+        return result;
+    }
+}
