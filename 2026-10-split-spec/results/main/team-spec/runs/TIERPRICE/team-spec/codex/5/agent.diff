+package com.salesmanager.core.business.services.catalog.product;
+import java.math.BigDecimal; import java.util.*; import javax.inject.Inject;
+import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.catalog.product.ProductQuantityTierRepository;
+import com.salesmanager.core.model.catalog.product.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("productQuantityTierService") public class ProductQuantityTierServiceImpl implements ProductQuantityTierService {
+ @Inject private ProductService productService; @Inject private ProductQuantityTierRepository repository;
+ public List<ProductQuantityTier> get(Long id, MerchantStore store) { Product p=product(id,store); List<ProductQuantityTier> r=new ArrayList<>(p.getQuantityTiers()); r.sort(Comparator.comparing(ProductQuantityTier::getMinQuantity)); return r; }
+ @Transactional public List<ProductQuantityTier> replace(Long id, MerchantStore store, List<ProductQuantityTier> tiers) { Product p=product(id,store); validate(tiers); p.getQuantityTiers().clear(); for(ProductQuantityTier t:tiers){t.setId(null);t.setProduct(p);p.getQuantityTiers().add(t);} try { productService.update(p); } catch(Exception e) { throw new IllegalStateException(e); } return get(id,store); }
+ private Product product(Long id, MerchantStore s) { return productService.retrieveById(id,s).orElseThrow(() -> new NoSuchElementException("Product not found")); }
+ private void validate(List<ProductQuantityTier> ts) { if(ts==null||ts.size()>10) throw new IllegalArgumentException("Invalid tiers"); Set<Integer> seen=new HashSet<>(); List<ProductQuantityTier> sorted=new ArrayList<>(ts); for(ProductQuantityTier t:sorted) { if(t==null||t.getMinQuantity()==null||t.getMinQuantity()<2||t.getPrice()==null||t.getPrice().compareTo(BigDecimal.ZERO)<=0||!seen.add(t.getMinQuantity())) throw new IllegalArgumentException("Invalid tier"); } sorted.sort(Comparator.comparing(ProductQuantityTier::getMinQuantity)); for(int i=1;i<sorted.size();i++) if(sorted.get(i).getPrice().compareTo(sorted.get(i-1).getPrice())>=0) throw new IllegalArgumentException("Prices must decrease"); }
+}
