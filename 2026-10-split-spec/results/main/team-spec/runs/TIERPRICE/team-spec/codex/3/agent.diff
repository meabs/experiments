+package com.salesmanager.core.business.services.catalog.product;
+import java.util.*;
+import java.math.BigDecimal;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.model.catalog.product.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("productTierService")
+public class ProductTierServiceImpl implements ProductTierService {
+ @Inject private ProductService productService;
+ @Override @Transactional(readOnly=true) public List<ProductTier> get(Long id, MerchantStore store) {
+   Product p=productService.findOne(id,store); if(p==null) return null;
+   return new ArrayList<ProductTier>(p.getTiers());
+ }
+ @Override @Transactional public List<ProductTier> replace(Long id, MerchantStore store, List<ProductTier> input) {
+   Product p=productService.findOne(id,store); if(p==null) return null;
+   if(input==null || input.size()>10) throw new IllegalArgumentException("Invalid tiers");
+   List<ProductTier> ordered=new ArrayList<ProductTier>(input);
+   Collections.sort(ordered, new Comparator<ProductTier>() { public int compare(ProductTier a, ProductTier b) { if(a==null||a.getMinQuantity()==null) return -1; if(b==null||b.getMinQuantity()==null) return 1; return a.getMinQuantity().compareTo(b.getMinQuantity()); } });
+   Set<Integer> seen=new HashSet<Integer>(); int previous=0; BigDecimal previousPrice=null;
+   for(ProductTier t:ordered) {
+    if(t==null || t.getMinQuantity()==null || t.getPrice()==null || t.getMinQuantity()<2 || t.getPrice().compareTo(BigDecimal.ZERO)<=0 || !seen.add(t.getMinQuantity()) || t.getMinQuantity()<=previous || (previousPrice!=null && t.getPrice().compareTo(previousPrice)>=0)) throw new IllegalArgumentException("Invalid tiers");
+    previous=t.getMinQuantity(); previousPrice=t.getPrice();
+   }
+   p.getTiers().clear(); for(ProductTier t:ordered){t.setId(null); t.setProduct(p); p.getTiers().add(t);} try { productService.update(p); } catch(Exception e) { throw new IllegalArgumentException("Unable to save tiers", e); }
+   return new ArrayList<ProductTier>(p.getTiers());
+ }
+}
