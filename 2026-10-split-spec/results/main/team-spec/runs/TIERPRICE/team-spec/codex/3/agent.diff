+package com.salesmanager.core.model.catalog.product;
+
+import java.math.BigDecimal;
+import javax.persistence.*;
+import com.salesmanager.core.model.generic.SalesManagerEntity;
+
+@Entity
+@Table(name = "PRODUCT_TIER", uniqueConstraints = @UniqueConstraint(columnNames = {"PRODUCT_ID", "MIN_QUANTITY"}))
+public class ProductTier extends SalesManagerEntity<Long, ProductTier> {
+    @Id @GeneratedValue(strategy = GenerationType.TABLE, generator = "TABLE_GEN")
+    @TableGenerator(name="TABLE_GEN", table="SM_SEQUENCER", pkColumnName="SEQ_NAME", valueColumnName="SEQ_COUNT", pkColumnValue="PRODUCT_TIER_SEQ_NEXT_VAL")
+    @Column(name="PRODUCT_TIER_ID") private Long id;
+    @Column(name="MIN_QUANTITY", nullable=false) private Integer minQuantity;
+    @Column(name="PRICE", nullable=false, precision=19, scale=6) private BigDecimal price;
+    @ManyToOne(fetch=FetchType.LAZY) @JoinColumn(name="PRODUCT_ID", nullable=false) private Product product;
+    public Long getId(){return id;} public void setId(Long id){this.id=id;}
+    public Integer getMinQuantity(){return minQuantity;} public void setMinQuantity(Integer v){minQuantity=v;}
+    public BigDecimal getPrice(){return price;} public void setPrice(BigDecimal v){price=v;}
+    public Product getProduct(){return product;} public void setProduct(Product v){product=v;}
+}
