+package com.salesmanager.shop.store.api.v1.product;
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.http.*;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductTierService;
+import com.salesmanager.core.model.catalog.product.ProductTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import springfox.documentation.annotations.ApiIgnore;
+@RestController
+@RequestMapping("/api/v1/private/product/{id}/tiers")
+public class ProductTierApi {
+ @Inject private ProductTierService service;
+ @GetMapping public List<com.salesmanager.shop.model.catalog.product.ProductTier> get(@PathVariable Long id,@ApiIgnore MerchantStore store){
+  List<ProductTier> tiers=service.get(id,store); if(tiers==null) throw new ResourceNotFoundException("Product not found"); return map(tiers);
+ }
+ @PutMapping public ResponseEntity<List<com.salesmanager.shop.model.catalog.product.ProductTier>> put(@PathVariable Long id,@RequestBody List<com.salesmanager.shop.model.catalog.product.ProductTier> body,@ApiIgnore MerchantStore store){
+  try { List<ProductTier> in=new ArrayList<ProductTier>(); for(com.salesmanager.shop.model.catalog.product.ProductTier x:body){ProductTier t=new ProductTier();t.setMinQuantity(x.getMinQuantity());t.setPrice(x.getPrice());in.add(t);} List<ProductTier> out=service.replace(id,store,in); if(out==null) throw new ResourceNotFoundException("Product not found"); return ResponseEntity.ok(map(out)); } catch(IllegalArgumentException e){return ResponseEntity.badRequest().build();}
+ }
+ private List<com.salesmanager.shop.model.catalog.product.ProductTier> map(List<ProductTier> src){List<com.salesmanager.shop.model.catalog.product.ProductTier> r=new ArrayList<>();for(ProductTier t:src){com.salesmanager.shop.model.catalog.product.ProductTier x=new com.salesmanager.shop.model.catalog.product.ProductTier();x.setMinQuantity(t.getMinQuantity());x.setPrice(t.getPrice());r.add(x);}return r;}
+}
