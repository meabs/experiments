+	private void applyTiers(ShoppingCart cart, MerchantStore store) {
+		if (cart.getLineItems()==null) return;
+		for (ShoppingCartItem item : cart.getLineItems()) {
+			if (item.getProduct()==null || item.getQuantity()==null) continue;
+			List<ProductTier> tiers = productTierService.get(item.getProduct().getId(), store);
+			if (tiers==null) continue;
+			BigDecimal base=item.getItemPrice();
+			try {
+				FinalPrice fp;
+				if (item.getVariant()!=null) {
+					com.salesmanager.core.model.catalog.product.variant.ProductVariant v = productVariantService.getById(item.getVariant(), store).orElse(null);
+					fp = v == null ? null : pricingService.calculateProductPrice(v);
+				} else fp=pricingService.calculateProductPrice(item.getProduct());
+				if(fp!=null && fp.getFinalPrice()!=null) base=fp.getFinalPrice();
+			} catch(Exception ignored) { }
+			BigDecimal selected=base;
+			for(ProductTier tier:tiers) if(item.getQuantity()>=tier.getMinQuantity() && tier.getPrice().compareTo(selected)<0) selected=tier.getPrice();
+			item.setItemPrice(selected);
+		}
+	}
 
 }
