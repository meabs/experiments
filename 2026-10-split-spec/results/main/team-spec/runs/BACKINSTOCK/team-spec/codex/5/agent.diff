+import javax.validation.Valid; import org.springframework.http.*; import org.springframework.stereotype.Controller; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.catalog.product.stockalert.*; import com.salesmanager.shop.store.facade.product.StockAlertFacade; import springfox.documentation.annotations.ApiIgnore;
+@Controller @RequestMapping("/api/v1") public class StockAlertApi { private final StockAlertFacade facade; public StockAlertApi(StockAlertFacade f){facade=f;}
