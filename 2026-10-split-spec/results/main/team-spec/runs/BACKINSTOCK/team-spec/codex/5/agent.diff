+package com.salesmanager.core.business.services.catalog.product.stockalert;
+import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service; import com.salesmanager.core.business.repositories.catalog.product.stockalert.*; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.stockalert.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("stockAlertService") public class StockAlertServiceImpl implements StockAlertService {
+ @Inject StockAlertRepository alerts; @Inject StockAlertOutboxRepository outbox;
+ public StockAlert request(String sku,String email,MerchantStore store,Product product){ Optional<StockAlert> old=alerts.findByMerchantStoreCodeAndSkuAndEmailIgnoreCaseAndStatus(store.getCode(),sku,email,"PENDING"); if(old.isPresent())return old.get(); StockAlert a=new StockAlert(); a.setMerchantStore(store);a.setSku(sku);a.setEmail(email);a.setStatus("PENDING"); return alerts.save(a); }
+ public void cancel(String sku,String email,MerchantStore store){ StockAlert a=alerts.findByMerchantStoreCodeAndSkuAndEmailIgnoreCaseAndStatus(store.getCode(),sku,email,"PENDING").orElseThrow(NoSuchElementException::new); alerts.delete(a); }
+ public List<StockAlert> list(MerchantStore s,String status){return status==null?alerts.findByMerchantStoreCodeOrderByCreatedAtAsc(s.getCode()):alerts.findByMerchantStoreCodeAndStatusOrderByCreatedAtAsc(s.getCode(),status);}
+ public List<StockAlertOutbox> outbox(MerchantStore s){return outbox.findByMerchantStoreCodeOrderByCreatedAtAsc(s.getCode());}
+ public void restocked(String sku,MerchantStore s,Product p){String name=p==null?sku:p.getProductDescription().getName(); for(StockAlert a:alerts.findByMerchantStoreCodeAndSkuAndStatusOrderByCreatedAtAsc(s.getCode(),sku,"PENDING")){a.setStatus("SENT");a.setSentAt(new Date());alerts.save(a);StockAlertOutbox m=new StockAlertOutbox();m.setMerchantStore(s);m.setSku(sku);m.setTo(a.getEmail());m.setSubject(name+" is back in stock");outbox.save(m);}}
+ public void delete(String sku,MerchantStore s){alerts.deleteAll(alerts.findByMerchantStoreCodeOrderByCreatedAtAsc(s.getCode()).stream().filter(a -> sku.equals(a.getSku())).collect(java.util.stream.Collectors.toList()));outbox.deleteBySkuAndMerchantStoreCode(sku,s.getCode());}
+}
