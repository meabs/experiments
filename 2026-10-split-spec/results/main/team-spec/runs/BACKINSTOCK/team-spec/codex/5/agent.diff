+package com.salesmanager.shop.store.facade.product;
+import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.catalog.product.stockalert.StockAlertService; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.stockalert.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.catalog.product.stockalert.*; import com.salesmanager.shop.store.api.exception.*;
+@Service public class StockAlertFacadeImpl implements StockAlertFacade { @Inject StockAlertService service; @Inject ProductService products;
+ private Product product(String sku,MerchantStore s){try{return products.getBySku(sku,s);}catch(Exception e){throw new ResourceNotFoundException("Product with sku ["+sku+"] not found");}}
+ private ReadableStockAlert dto(StockAlert a){ReadableStockAlert d=new ReadableStockAlert();d.setId(a.getId());d.setSku(a.getSku());d.setEmail(a.getEmail());d.setStatus(a.getStatus());d.setCreatedAt(a.getCreatedAt());d.setSentAt(a.getSentAt());return d;}
+ public ReadableStockAlert request(String sku,String email,MerchantStore s){return requestResult(sku,email,s).getAlert();}
+ public StockAlertResult requestResult(String sku,String email,MerchantStore s){Product p=product(sku,s);if(p.getAvailabilities()!=null&&p.getAvailabilities().stream().anyMatch(a->a.getProductQuantity()!=null&&a.getProductQuantity()>0))throw new RestApiException("409","Product is in stock");Optional<StockAlert> existing=service.list(s,"PENDING").stream().filter(a->sku.equals(a.getSku())&&email.equalsIgnoreCase(a.getEmail())).findFirst();return new StockAlertResult(dto(service.request(sku,email,s,p)),!existing.isPresent());}
+ public void cancel(String sku,String email,MerchantStore s){product(sku,s);try{service.cancel(sku,email,s);}catch(NoSuchElementException e){throw new ResourceNotFoundException("Stock alert not found");}}
+ public List<ReadableStockAlert> list(MerchantStore s,String status){if(status!=null&&!status.equals("PENDING")&&!status.equals("SENT"))throw new RestApiException("400","Invalid status");List<ReadableStockAlert> r=new ArrayList<>();for(StockAlert a:service.list(s,status))r.add(dto(a));return r;}
+ public List<ReadableStockAlertOutbox> outbox(MerchantStore s){List<ReadableStockAlertOutbox> r=new ArrayList<>();for(StockAlertOutbox a:service.outbox(s)){ReadableStockAlertOutbox d=new ReadableStockAlertOutbox();d.setTo(a.getTo());d.setSku(a.getSku());d.setSubject(a.getSubject());d.setCreatedAt(a.getCreatedAt());r.add(d);}return r;}
+}
