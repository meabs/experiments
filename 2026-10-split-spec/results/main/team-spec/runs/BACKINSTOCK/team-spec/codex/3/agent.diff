+package com.salesmanager.core.business.services.catalog.product.stock;
+import java.util.*; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional; import org.springframework.beans.factory.annotation.Autowired; import com.salesmanager.core.business.repositories.catalog.product.stock.*; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.stock.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("stockAlertService") public class StockAlertServiceImpl implements StockAlertService {
+ @Autowired StockAlertRepository alerts; @Autowired StockAlertOutboxRepository outbox; @Autowired ProductService products;
+ public void removeForProduct(String sku,MerchantStore s){ alerts.deleteByMerchantStoreIdAndSku(s.getId(),sku); }
+ private Product product(String sku,MerchantStore s) throws ServiceException { Product p=products.getBySku(sku,s); if(p==null) throw new ServiceException("Product not found"); return p; }
+ public StockAlert subscribe(String sku,String email,MerchantStore s)throws ServiceException { Product p=product(sku,s); boolean in=p.getAvailabilities()!=null && p.getAvailabilities().stream().anyMatch(a->a.getProductQuantity()!=null&&a.getProductQuantity()>0); if(in) throw new IllegalStateException("Product is in stock"); Optional<StockAlert> old=alerts.findByMerchantStoreIdAndSkuAndEmailIgnoreCaseAndStatus(s.getId(),sku,email,StockAlertStatus.PENDING); if(old.isPresent()) return old.get(); StockAlert a=new StockAlert();a.setMerchantStore(s);a.setSku(sku);a.setEmail(email);return alerts.save(a); }
+ public void cancel(String sku,String email,MerchantStore s)throws ServiceException { StockAlert a=alerts.findByMerchantStoreIdAndSkuAndEmailIgnoreCaseAndStatus(s.getId(),sku,email,StockAlertStatus.PENDING).orElseThrow(()->new NoSuchElementException("Alert not found")); alerts.delete(a); }
+ public List<StockAlert> list(MerchantStore s,StockAlertStatus st){return st==null?alerts.findByMerchantStoreIdOrderByCreatedAtAsc(s.getId()):alerts.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(s.getId(),st);}
+ public List<StockAlertOutboxMessage> outbox(MerchantStore s){return outbox.findByMerchantStoreIdOrderByCreatedAtAsc(s.getId());}
+ @Transactional public void restocked(String sku,MerchantStore s)throws ServiceException { Product p=product(sku,s); String name=p.getDescriptions()!=null&&!p.getDescriptions().isEmpty()?p.getDescriptions().iterator().next().getName():sku; for(StockAlert a:alerts.findByMerchantStoreIdAndSkuAndStatus(s.getId(),sku,StockAlertStatus.PENDING)){a.setStatus(StockAlertStatus.SENT);a.setSentAt(new Date());alerts.save(a);StockAlertOutboxMessage m=new StockAlertOutboxMessage();m.setMerchantStore(s);m.setSku(sku);m.setToEmail(a.getEmail());m.setSubject(name+" is back in stock");outbox.save(m);} }
+}
