+package com.salesmanager.shop.store.api.v1.product;
+import java.util.*; import javax.validation.Valid; import javax.validation.constraints.Email; import javax.validation.constraints.NotBlank; import org.springframework.beans.factory.annotation.Autowired; import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.business.services.catalog.product.stock.StockAlertService; import com.salesmanager.core.model.catalog.product.stock.*; import com.salesmanager.core.model.merchant.MerchantStore; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class StockAlertApi {
+ @Autowired private StockAlertService service;
+ public static class Request { @NotBlank @Email public String email; }
+ @PostMapping("/products/{sku}/alerts") public ResponseEntity<Map<String,Object>> subscribe(@PathVariable String sku,@Valid @RequestBody Request req,@ApiIgnore MerchantStore store){ boolean existing=service.list(store,StockAlertStatus.PENDING).stream().anyMatch(a->a.getSku().equalsIgnoreCase(sku)&&a.getEmail().equalsIgnoreCase(req.email)); StockAlert a=serviceCall(()->service.subscribe(sku,req.email,store)); Map<String,Object> m=new LinkedHashMap<>();m.put("sku",a.getSku());m.put("email",a.getEmail());m.put("status",a.getStatus().name());return ResponseEntity.status(existing?HttpStatus.OK:HttpStatus.CREATED).body(m); }
+ @DeleteMapping("/products/{sku}/alerts") public ResponseEntity<Void> cancel(@PathVariable String sku,@RequestParam @Email String email,@ApiIgnore MerchantStore store){if(email==null||email.trim().isEmpty())throw new org.springframework.web.server.ResponseStatusException(HttpStatus.BAD_REQUEST,"Invalid email");serviceCall(()->{service.cancel(sku,email,store);return null;});return ResponseEntity.noContent().build();}
+ @GetMapping("/private/stock-alerts") public List<Map<String,Object>> list(@RequestParam(required=false) String status,@ApiIgnore MerchantStore store){StockAlertStatus st=null;if(status!=null)try{st=StockAlertStatus.valueOf(status);}catch(Exception e){throw new org.springframework.web.server.ResponseStatusException(HttpStatus.BAD_REQUEST,"Invalid status");}List<Map<String,Object>> r=new ArrayList<>();for(StockAlert a:service.list(store,st)){Map<String,Object> m=new LinkedHashMap<>();m.put("id",a.getId());m.put("sku",a.getSku());m.put("email",a.getEmail());m.put("status",a.getStatus().name());m.put("createdAt",a.getCreatedAt());m.put("sentAt",a.getSentAt());r.add(m);}return r;}
+ @GetMapping("/private/stock-alerts/outbox") public List<Map<String,Object>> outbox(@ApiIgnore MerchantStore store){List<Map<String,Object>> r=new ArrayList<>();for(StockAlertOutboxMessage a:service.outbox(store)){Map<String,Object> m=new LinkedHashMap<>();m.put("to",a.getToEmail());m.put("sku",a.getSku());m.put("subject",a.getSubject());m.put("createdAt",a.getCreatedAt());r.add(m);}return r;}
+ private interface C<T>{T run() throws Exception;} private <T>T serviceCall(C<T> c){try{return c.run();}catch(IllegalStateException e){throw new org.springframework.web.server.ResponseStatusException(HttpStatus.CONFLICT,e.getMessage());}catch(NoSuchElementException e){throw new org.springframework.web.server.ResponseStatusException(HttpStatus.NOT_FOUND,e.getMessage());}catch(Exception e){if(e.getMessage()!=null&&e.getMessage().contains("Product"))throw new org.springframework.web.server.ResponseStatusException(HttpStatus.NOT_FOUND,e.getMessage());throw new org.springframework.web.server.ResponseStatusException(HttpStatus.BAD_REQUEST,e.getMessage());}}
+}
