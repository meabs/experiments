+package com.salesmanager.core.business.services.catalog.product.alert;
+import java.util.*; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional; import org.springframework.beans.factory.annotation.Autowired; import com.salesmanager.core.business.repositories.catalog.product.alert.*; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.alert.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("stockAlertService") public class StockAlertServiceImpl implements StockAlertService {
+ @Autowired StockAlertRepository alerts; @Autowired StockAlertOutboxRepository outbox;
+ public StockAlert request(Product p, MerchantStore s, String email){ if(email==null||!email.matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$")) throw new IllegalArgumentException("Invalid email"); Optional<StockAlert> old=alerts.findByProductAndMerchantStoreAndEmailIgnoreCaseAndStatus(p,s,email,StockAlertStatus.PENDING); if(old.isPresent()) return old.get(); StockAlert a=new StockAlert(); a.setProduct(p);a.setMerchantStore(s);a.setEmail(email); return alerts.save(a); }
+ public void cancel(Product p, MerchantStore s, String email){ StockAlert a=alerts.findByProductAndMerchantStoreAndEmailIgnoreCaseAndStatus(p,s,email,StockAlertStatus.PENDING).orElseThrow(NoSuchElementException::new); alerts.delete(a); }
+ public List<StockAlert> list(MerchantStore s, StockAlertStatus st){return st==null?alerts.findByMerchantStoreOrderByCreatedAtAsc(s):alerts.findByMerchantStoreAndStatusOrderByCreatedAtAsc(s,st);}
+ public List<StockAlertOutbox> outbox(MerchantStore s){return outbox.findByMerchantStoreOrderByCreatedAtAsc(s);}
+ @Transactional public void restocked(Product p, MerchantStore s){String name=p.getSku(); if(p.getDescriptions()!=null&&!p.getDescriptions().isEmpty()){String n=p.getDescriptions().iterator().next().getName();if(n!=null&&!n.trim().isEmpty())name=n;} for(StockAlert a:alerts.findByProductAndMerchantStoreAndStatusOrderByCreatedAtAsc(p,s,StockAlertStatus.PENDING)){a.setStatus(StockAlertStatus.SENT);a.setSentAt(new Date()); StockAlertOutbox o=new StockAlertOutbox();o.setMerchantStore(s);o.setToEmail(a.getEmail());o.setSku(p.getSku());o.setSubject(name+" is back in stock");outbox.save(o);alerts.save(a);}}
+}
