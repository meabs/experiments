+package com.salesmanager.shop.store.api.v1.product;
+import java.util.*; import org.springframework.beans.factory.annotation.Autowired; import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.business.services.catalog.product.alert.*; import com.salesmanager.core.model.catalog.product.Product; import com.salesmanager.core.model.catalog.product.alert.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.catalog.product.alert.*; import com.salesmanager.shop.store.api.exception.*; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class StockAlertApi {
+ @Autowired ProductService products; @Autowired StockAlertService service;
+ @PostMapping("/products/{sku}/alerts") @ResponseStatus(HttpStatus.CREATED) public ReadableStockAlert request(@PathVariable String sku,@RequestBody StockAlertRequest req,@ApiIgnore MerchantStore store){Product p=get(sku,store); if(p.getAvailabilities()!=null && p.getAvailabilities().stream().anyMatch(a->a.getProductQuantity()!=null&&a.getProductQuantity()>0)) throw new ConflictException("Product is in stock"); try { return map(service.request(p,store,req.getEmail())); } catch (IllegalArgumentException e) { throw new RestApiException("Invalid email", e); }}
+ @DeleteMapping("/products/{sku}/alerts") @ResponseStatus(HttpStatus.NO_CONTENT) public void cancel(@PathVariable String sku,@RequestParam String email,@ApiIgnore MerchantStore store){try{service.cancel(get(sku,store),store,email);}catch(NoSuchElementException e){throw new ResourceNotFoundException("Alert not found");}}
+ @GetMapping("/private/stock-alerts") public List<ReadableStockAlert> list(@RequestParam(required=false) String status,@ApiIgnore MerchantStore store){StockAlertStatus st=null;if(status!=null)try{st=StockAlertStatus.valueOf(status);}catch(Exception e){throw new RestApiException("Invalid status");} List<ReadableStockAlert> r=new ArrayList<>();for(StockAlert a:service.list(store,st))r.add(map(a));return r;}
+ @GetMapping("/private/stock-alerts/outbox") public List<ReadableStockAlertOutbox> outbox(@ApiIgnore MerchantStore store){List<ReadableStockAlertOutbox> r=new ArrayList<>();for(StockAlertOutbox o:service.outbox(store)){ReadableStockAlertOutbox x=new ReadableStockAlertOutbox();x.to=o.getToEmail();x.sku=o.getSku();x.subject=o.getSubject();x.createdAt=o.getCreatedAt();r.add(x);}return r;}
+ private Product get(String sku,MerchantStore s){try{return products.getBySku(sku,s);}catch(Exception e){throw new ResourceNotFoundException("Product not found");}}
+ private ReadableStockAlert map(StockAlert a){ReadableStockAlert x=new ReadableStockAlert();x.id=a.getId();x.sku=a.getProduct().getSku();x.email=a.getEmail();x.status=a.getStatus().name();x.createdAt=a.getCreatedAt();x.sentAt=a.getSentAt();return x;}
+}
