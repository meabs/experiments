+package com.salesmanager.core.business.services.catalog.product.alert;
+import java.util.*;
+import java.util.regex.Pattern;
+import javax.inject.Inject;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.catalog.product.alert.*;
+import com.salesmanager.core.model.catalog.product.alert.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("stockAlertService")
+public class StockAlertServiceImpl implements StockAlertService {
+ private static final Pattern EMAIL=Pattern.compile("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$");
+ @Inject private StockAlertRepository alerts; @Inject private StockAlertOutboxRepository outbox;
+ @Override @Transactional public StockAlert request(MerchantStore store,String sku,String email){
+  if(email==null||!EMAIL.matcher(email).matches()) throw new IllegalArgumentException("Invalid email");
+  StockAlert old=alerts.findFirstByMerchantStoreIdAndSkuAndEmailIgnoreCaseAndStatus(store.getId(),sku,email,StockAlertStatus.PENDING); if(old!=null)return old;
+  StockAlert a=new StockAlert(); a.setMerchantStore(store); a.setSku(sku); a.setEmail(email); return alerts.save(a);
+ }
+ @Override @Transactional public void cancel(MerchantStore store,String sku,String email){ StockAlert a=alerts.findFirstByMerchantStoreIdAndSkuAndEmailIgnoreCaseAndStatus(store.getId(),sku,email,StockAlertStatus.PENDING); if(a==null)throw new NoSuchElementException(); alerts.delete(a); }
+ @Override public List<StockAlert> list(MerchantStore store,StockAlertStatus status){return status==null?alerts.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId()):alerts.findByMerchantStoreIdAndStatusOrderByCreatedAtAsc(store.getId(),status);}
+ @Override public List<StockAlertOutbox> outbox(MerchantStore store){return outbox.findByMerchantStoreIdOrderByCreatedAtAsc(store.getId());}
+ @Override @Transactional public void dispatch(MerchantStore store,String sku,String name){ for(StockAlert a:alerts.findByMerchantStoreIdAndSkuAndStatusOrderByCreatedAtAsc(store.getId(),sku,StockAlertStatus.PENDING)){ a.setStatus(StockAlertStatus.SENT); a.setSentAt(new Date()); alerts.save(a); StockAlertOutbox m=new StockAlertOutbox(); m.setMerchantStore(store);m.setSku(sku);m.setToEmail(a.getEmail());m.setSubject(name+" is back in stock");outbox.save(m); } }
+ @Override @Transactional public void deleteForProduct(MerchantStore store,String sku){ alerts.deleteAll(alerts.findByMerchantStoreIdAndSkuOrderByCreatedAtAsc(store.getId(),sku)); }
+}
