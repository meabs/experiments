+package com.salesmanager.shop.store.api.v1.product;
+
+import java.util.*;
+import javax.inject.Inject;
+import org.springframework.http.*;
+import org.springframework.web.bind.annotation.*;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.business.services.catalog.product.alert.StockAlertService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.alert.*;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import springfox.documentation.annotations.ApiIgnore;
+
+@RestController
+@RequestMapping("/api/v1")
+public class StockAlertApi {
+ @Inject private StockAlertService service; @Inject private ProductService products;
+ public static class Request { public String email; public String getEmail(){return email;} public void setEmail(String e){email=e;} }
+ private Product product(String sku,MerchantStore store){try { Product p=products.getBySku(sku,store); if(p==null)throw new ResourceNotFoundException("Product not found"); return p;}catch(Exception e){if(e instanceof ResourceNotFoundException)throw (ResourceNotFoundException)e; throw new ResourceNotFoundException("Product not found");}}
+ private boolean inStock(Product p){return p.getAvailabilities()!=null && p.getAvailabilities().stream().anyMatch(a->a.getProductQuantity()!=null&&a.getProductQuantity()>0);}
+ @PostMapping("/products/{sku}/alerts") public ResponseEntity<Map<String,Object>> request(@PathVariable String sku,@RequestBody Request body,@ApiIgnore MerchantStore store){
+  Product p=product(sku,store); if(inStock(p)) return ResponseEntity.status(HttpStatus.CONFLICT).build();
+  if(body==null||body.email==null||!body.email.matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$")) return ResponseEntity.badRequest().build();
+  StockAlert a=service.request(store,sku,body.email); Map<String,Object> m=new LinkedHashMap<>();m.put("sku",sku);m.put("email",a.getEmail());m.put("status",a.getStatus().name()); return ResponseEntity.status(a.getId()!=null&&a.getCreatedAt()!=null?HttpStatus.CREATED:HttpStatus.OK).body(m);
+ }
+ @DeleteMapping("/products/{sku}/alerts") @ResponseStatus(HttpStatus.NO_CONTENT) public void cancel(@PathVariable String sku,@RequestParam String email,@ApiIgnore MerchantStore store){product(sku,store);try{service.cancel(store,sku,email);}catch(NoSuchElementException e){throw new ResourceNotFoundException("Alert not found");}}
+ @GetMapping("/private/stock-alerts") public List<StockAlert> list(@RequestParam(required=false) String status,@ApiIgnore MerchantStore store){StockAlertStatus s=null;if(status!=null)try{s=StockAlertStatus.valueOf(status);}catch(Exception e){throw new IllegalArgumentException("Invalid status");}return service.list(store,s);}
+ @GetMapping("/private/stock-alerts/outbox") public List<StockAlertOutbox> outbox(@ApiIgnore MerchantStore store){return service.outbox(store);}
+}
