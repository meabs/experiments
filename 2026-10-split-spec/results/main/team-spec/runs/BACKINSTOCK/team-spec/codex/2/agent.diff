+public interface StockAlertService { StockAlert request(String sku,String email,MerchantStore store); void cancel(String sku,String email,MerchantStore store); List<StockAlert> list(MerchantStore store,String status); List<StockAlertOutbox> outbox(MerchantStore store); void restocked(Product product,MerchantStore store); }
