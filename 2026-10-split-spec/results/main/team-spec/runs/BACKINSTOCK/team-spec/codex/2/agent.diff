+package com.salesmanager.core.business.services.catalog.product;
+import java.util.*; import java.util.regex.Pattern; import javax.inject.Inject; import org.springframework.stereotype.Service; import org.springframework.transaction.annotation.Transactional;
+import com.salesmanager.core.business.repositories.catalog.product.*; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.model.catalog.product.*; import com.salesmanager.core.model.merchant.MerchantStore;
+@Service("stockAlertService") public class StockAlertServiceImpl implements StockAlertService {
+ private static final Pattern EMAIL=Pattern.compile("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$");
+ @Inject private StockAlertRepository alerts; @Inject private StockAlertOutboxRepository outbox; @Inject private ProductService products;
+ private Product product(String sku,MerchantStore store){ try { Product p=products.getBySku(sku,store); if(p==null) throw new NoSuchElementException("Product not found"); return p; } catch(com.salesmanager.core.business.exception.ServiceException e){ throw new NoSuchElementException("Product not found"); } }
+ private boolean stock(Product p){ if(p.getAvailabilities()==null)return false; for(com.salesmanager.core.model.catalog.product.availability.ProductAvailability a:p.getAvailabilities()) if(a.getProductQuantity()!=null&&a.getProductQuantity()>0)return true; return false; }
+ @Transactional public StockAlert request(String sku,String email,MerchantStore store){ if(email==null||!EMAIL.matcher(email).matches())throw new IllegalArgumentException("Invalid email"); Product p=product(sku,store); if(stock(p))throw new IllegalStateException("Product is in stock"); Optional<StockAlert> old=alerts.findByMerchantStoreIdIdAndProductIdAndEmailIgnoreCaseAndStatus(store.getId(),p.getId(),email,"PENDING"); if(old.isPresent())return old.get(); StockAlert a=new StockAlert();a.setProduct(p);a.setMerchantStore(store);a.setEmail(email);return alerts.save(a); }
+ @Transactional public void cancel(String sku,String email,MerchantStore store){ Product p=product(sku,store); StockAlert a=alerts.findByMerchantStoreIdIdAndProductIdAndEmailIgnoreCaseAndStatus(store.getId(),p.getId(),email,"PENDING").orElseThrow(()->new NoSuchElementException("Alert not found")); alerts.delete(a); }
+ public List<StockAlert> list(MerchantStore s,String status){ if(status==null)return alerts.findByMerchantStoreIdIdOrderByCreatedAtAsc(s.getId()); return alerts.findByMerchantStoreIdIdAndStatusOrderByCreatedAtAsc(s.getId(),status); }
+ public List<StockAlertOutbox> outbox(MerchantStore s){return outbox.findByMerchantStoreIdIdOrderByCreatedAtAsc(s.getId());}
+ @Transactional public void restocked(Product p,MerchantStore s){ for(StockAlert a:alerts.findByMerchantStoreIdIdAndProductIdAndStatus(s.getId(),p.getId(),"PENDING")){a.setStatus("SENT");a.setSentAt(new Date());alerts.save(a);StockAlertOutbox m=new StockAlertOutbox();m.setMerchantStore(s);m.setRecipient(a.getEmail());m.setSku(p.getSku());String n=p.getDescriptions().isEmpty()?p.getSku():p.getDescriptions().iterator().next().getName();m.setSubject(n+" is back in stock");outbox.save(m);} }
+}
