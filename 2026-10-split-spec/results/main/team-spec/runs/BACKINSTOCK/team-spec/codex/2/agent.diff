+package com.salesmanager.shop.store.api.v1.product;
+import java.util.*; import javax.validation.Valid; import org.springframework.http.*; import org.springframework.web.bind.annotation.*; import org.springframework.web.server.ResponseStatusException; import com.salesmanager.core.business.services.catalog.product.StockAlertService; import com.salesmanager.core.model.catalog.product.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.catalog.product.*; import com.salesmanager.shop.store.api.exception.*; import springfox.documentation.annotations.ApiIgnore;
+@RestController @RequestMapping("/api/v1") public class StockAlertApi {
+ @javax.inject.Inject private StockAlertService service;
+ @PostMapping("/products/{sku}/alerts") public ResponseEntity<ReadableStockAlert> request(@PathVariable String sku,@Valid @RequestBody StockAlertRequest req,@ApiIgnore MerchantStore store){try{boolean duplicate=service.list(store,"PENDING").stream().anyMatch(a->sku.equals(a.getProduct().getSku())&&req.getEmail().equalsIgnoreCase(a.getEmail())); ReadableStockAlert r=alert(service.request(sku,req.getEmail(),store)); return ResponseEntity.status(duplicate?HttpStatus.OK:HttpStatus.CREATED).body(r);}catch(NoSuchElementException e){throw new ResourceNotFoundException(e.getMessage());}catch(IllegalStateException e){throw new ResponseStatusException(HttpStatus.CONFLICT,e.getMessage());}catch(IllegalArgumentException e){throw new RestApiException(e.getMessage());}}
+ @DeleteMapping("/products/{sku}/alerts") @ResponseStatus(HttpStatus.NO_CONTENT) public void cancel(@PathVariable String sku,@RequestParam String email,@ApiIgnore MerchantStore store){if(email==null||!email.matches("^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"))throw new RestApiException("Invalid email");try{service.cancel(sku,email,store);}catch(NoSuchElementException e){throw new ResourceNotFoundException(e.getMessage());}}
+ @GetMapping("/private/stock-alerts") public List<ReadableStockAlert> list(@RequestParam(required=false) String status,@ApiIgnore MerchantStore store){if(status!=null&&!status.equals("PENDING")&&!status.equals("SENT"))throw new RestApiException("Invalid status");List<ReadableStockAlert> r=new ArrayList<>();for(StockAlert a:service.list(store,status))r.add(alert(a));return r;}
+ @GetMapping("/private/stock-alerts/outbox") public List<ReadableStockAlertOutbox> outbox(@ApiIgnore MerchantStore store){List<ReadableStockAlertOutbox> r=new ArrayList<>();for(StockAlertOutbox m:service.outbox(store)){ReadableStockAlertOutbox x=new ReadableStockAlertOutbox();x.setTo(m.getRecipient());x.setSku(m.getSku());x.setSubject(m.getSubject());x.setCreatedAt(m.getCreatedAt());r.add(x);}return r;}
+ private ReadableStockAlert alert(StockAlert a){ReadableStockAlert x=new ReadableStockAlert();x.setId(a.getId());x.setSku(a.getProduct().getSku());x.setEmail(a.getEmail());x.setStatus(a.getStatus());x.setCreatedAt(a.getCreatedAt());x.setSentAt(a.getSentAt());return x;}
+}
