+public interface StockAlertService { StockAlert request(String sku,String email,MerchantStore store); void cancel(String sku,String email,MerchantStore store); List<StockAlert> list(MerchantStore store,String status); List<StockAlertOutbox> outbox(MerchantStore store); void restocked(String sku,MerchantStore store,String productName); void delete(String sku,MerchantStore store); }
diff --git a/sm-core/src/main/java/com/salesmanager/core/business/services/catalog/stockalert/StockAlertServiceImpl.java b/sm-core/src/main/java/com/salesmanager/core/business/services/catalog/stockalert/StockAlertServiceImpl.java
new file mode 100644
