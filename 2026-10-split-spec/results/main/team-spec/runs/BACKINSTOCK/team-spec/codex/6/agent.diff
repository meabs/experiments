+package com.salesmanager.shop.store.api.v1.stockalert;
+import java.util.*; import javax.inject.Inject; import org.springframework.http.*; import org.springframework.stereotype.Controller; import org.springframework.web.bind.annotation.*; import com.salesmanager.core.business.services.catalog.stockalert.StockAlertService; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.shop.model.catalog.stockalert.*; import com.salesmanager.shop.store.api.exception.*; import springfox.documentation.annotations.ApiIgnore;
+@Controller @RequestMapping("/api/v1") public class StockAlertApi { @Inject StockAlertService service;
+ @PostMapping("/products/{sku}/alerts") @ResponseStatus(HttpStatus.CREATED) public StockAlertDto create(@PathVariable String sku,@RequestBody StockAlertRequest r,@ApiIgnore MerchantStore store){if(r==null||r.getEmail()==null||!r.getEmail().matches("^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"))throw new RestApiException("Invalid email");try{return new StockAlertDto(service.request(sku,r.getEmail(),store));}catch(IllegalStateException e){throw new StockApiException(HttpStatus.CONFLICT,e.getMessage());}catch(IllegalArgumentException e){throw new ResourceNotFoundException("Product not found");}}
+ @DeleteMapping("/products/{sku}/alerts") @ResponseStatus(HttpStatus.NO_CONTENT) public void cancel(@PathVariable String sku,@RequestParam String email,@ApiIgnore MerchantStore store){try{service.cancel(sku,email,store);}catch(NoSuchElementException e){throw new ResourceNotFoundException("Alert not found");}}
+ @GetMapping("/private/stock-alerts") public List<StockAlertDto> list(@RequestParam(required=false) String status,@ApiIgnore MerchantStore store){if(status!=null&&!status.equals("PENDING")&&!status.equals("SENT"))throw new RestApiException("Invalid status");List<StockAlertDto> r=new ArrayList<>();service.list(store,status).forEach(a->r.add(new StockAlertDto(a)));return r;}
+ @GetMapping("/private/stock-alerts/outbox") public List<StockOutboxDto> outbox(@ApiIgnore MerchantStore store){List<StockOutboxDto> r=new ArrayList<>();service.outbox(store).forEach(a->r.add(new StockOutboxDto(a)));return r;}
+}
