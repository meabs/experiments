+package com.salesmanager.core.business.services.catalog.stockalert;
+import java.util.*; import javax.inject.Inject; import org.springframework.stereotype.Service; import com.salesmanager.core.business.repositories.catalog.stockalert.*; import com.salesmanager.core.model.catalog.stockalert.*; import com.salesmanager.core.model.merchant.MerchantStore; import com.salesmanager.core.business.exception.ServiceException; import com.salesmanager.core.business.services.catalog.product.ProductService; import com.salesmanager.core.model.catalog.product.Product;
+@Service("stockAlertService") public class StockAlertServiceImpl implements StockAlertService { @Inject StockAlertRepository alerts; @Inject StockAlertOutboxRepository outbox; @Inject ProductService products;
+ public StockAlert request(String sku,String email,MerchantStore s){ try { Product p=products.getBySku(sku,s); if(p==null) throw new IllegalArgumentException("Unknown sku"); boolean inStock=p.getAvailabilities()!=null&&p.getAvailabilities().stream().anyMatch(a->a.getProductQuantity()!=null&&a.getProductQuantity()>0); if(inStock) throw new IllegalStateException("Product is in stock"); Optional<StockAlert> old=alerts.findByMerchantStoreAndSkuAndEmailIgnoreCaseAndStatus(s,sku,email,"PENDING"); if(old.isPresent()) return old.get(); StockAlert a=new StockAlert(); a.setSku(sku);a.setEmail(email);a.setMerchantStore(s); return alerts.save(a); } catch(ServiceException e){throw new IllegalArgumentException(e);} }
+ public void cancel(String sku,String email,MerchantStore s){ StockAlert a=alerts.findByMerchantStoreAndSkuAndEmailIgnoreCaseAndStatus(s,sku,email,"PENDING").orElseThrow(()->new NoSuchElementException("Alert not found")); alerts.delete(a); }
+ public List<StockAlert> list(MerchantStore s,String status){return status==null?alerts.findByMerchantStoreOrderByCreatedAtAsc(s):alerts.findByMerchantStoreAndStatusOrderByCreatedAtAsc(s,status);}
+ public List<StockAlertOutbox> outbox(MerchantStore s){return outbox.findByMerchantStoreOrderByCreatedAtAsc(s);}
+ public void restocked(String sku,MerchantStore s,String name){for(StockAlert a:alerts.findByMerchantStoreAndSkuAndStatus(s,sku,"PENDING")){a.setStatus("SENT");a.setSentAt(new Date());alerts.save(a);StockAlertOutbox o=new StockAlertOutbox();o.setMerchantStore(s);o.setSku(sku);o.setRecipient(a.getEmail());o.setSubject(name+" is back in stock");outbox.save(o);}}
+ public void delete(String sku,MerchantStore s){alerts.deleteBySkuAndMerchantStore(sku,s);}
+}
