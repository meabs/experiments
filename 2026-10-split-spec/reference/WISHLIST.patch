+package com.salesmanager.shop.store.api.v1.customer;
+
+import java.math.BigDecimal;
+import java.security.Principal;
+import java.text.SimpleDateFormat;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Date;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.TimeZone;
+
+import javax.servlet.http.HttpServletRequest;
+
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.web.bind.annotation.DeleteMapping;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PostMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.repositories.customer.wishlist.WishlistItemRepository;
+import com.salesmanager.core.business.services.catalog.pricing.PricingService;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.availability.ProductAvailability;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.customer.wishlist.WishlistItem;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.shoppingcart.PersistableShoppingCartItem;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCart;
+import com.salesmanager.shop.model.shoppingcart.ReadableShoppingCartItem;
+import com.salesmanager.shop.store.api.exception.ResourceNotFoundException;
+import com.salesmanager.shop.store.controller.customer.facade.CustomerFacade;
+import com.salesmanager.shop.store.controller.shoppingCart.facade.ShoppingCartFacade;
+
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** A logged-in customer's wishlist, and the store's most wished products (reference implementation for WISHLIST). */
+@RestController
+@RequestMapping("/api/v1")
+@ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT"),
+		@ApiImplicitParam(name = "lang", dataType = "String", defaultValue = "en") })
+public class WishlistApi {
+
+	static final int MAX_ITEMS = 50;
+	static final int POPULAR = 10;
+
+	@Autowired
+	private WishlistItemRepository repository;
+
+	@Autowired
+	private ProductService productService;
+
+	@Autowired
+	private PricingService pricingService;
+
+	@Autowired
+	private CustomerFacade customerFacade;
+
+	@Autowired
+	private ShoppingCartFacade shoppingCartFacade;
+
+	@GetMapping("/auth/customer/wishlist")
+	public Map<String, Object> list(@ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest request) {
+		return readable(customer(store, request), store, language);
+	}
+
+	@PostMapping("/auth/customer/wishlist")
+	public ResponseEntity<?> add(@RequestBody Map<String, Object> body, @ApiIgnore MerchantStore store,
+			@ApiIgnore Language language, HttpServletRequest request) {
+		Customer customer = customer(store, request);
+		Object sku = body.get("product");
+		if (sku == null || String.valueOf(sku).trim().isEmpty()) {
+			return bad("product is required");
+		}
+		Product product = product(String.valueOf(sku).trim(), store, language);
+		if (product == null) {
+			return ResponseEntity.status(HttpStatus.NOT_FOUND).body(Collections.singletonMap("message", "unknown product"));
+		}
+		if (repository.findByCustomerAndProduct(customer.getId(), product.getId()).isPresent()) {
+			return ResponseEntity.ok(readable(customer, store, language));
+		}
+		if (repository.countByCustomer(customer.getId()) >= MAX_ITEMS) {
+			return bad("a wishlist holds at most " + MAX_ITEMS + " products");
+		}
+		WishlistItem w = new WishlistItem();
+		w.setMerchantId(store.getId());
+		w.setCustomerId(customer.getId());
+		w.setProductId(product.getId());
+		w.setSku(product.getSku());
+		w.setAddedAt(new Date());
+		repository.save(w);
+		return ResponseEntity.status(HttpStatus.CREATED).body(readable(customer, store, language));
+	}
+
+	@DeleteMapping("/auth/customer/wishlist/{sku}")
+	public ResponseEntity<?> remove(@PathVariable String sku, @ApiIgnore MerchantStore store, @ApiIgnore Language language,
+			HttpServletRequest request) {
+		Customer customer = customer(store, request);
+		Optional<WishlistItem> w = item(customer, sku);
+		if (!w.isPresent()) {
+			return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+		}
+		repository.delete(w.get());
+		return ResponseEntity.noContent().build();
+	}
+
+	@PostMapping("/auth/customer/wishlist/{sku}/cart/{cartCode}")
+	public ResponseEntity<?> moveToCart(@PathVariable String sku, @PathVariable String cartCode,
+			@ApiIgnore MerchantStore store, @ApiIgnore Language language, HttpServletRequest request) throws Exception {
+		Customer customer = customer(store, request);
+		Optional<WishlistItem> w = item(customer, sku);
+		if (!w.isPresent()) {
+			return ResponseEntity.status(HttpStatus.NOT_FOUND).body(Collections.singletonMap("message", "not on the wishlist"));
+		}
+		ReadableShoppingCart cart = shoppingCartFacade.getByCode(cartCode, store, language);
+		if (cart == null) {
+			return ResponseEntity.status(HttpStatus.NOT_FOUND).body(Collections.singletonMap("message", "unknown cart"));
+		}
+		Product product = product(w.get().getSku(), store, language);
+		if (product == null || !available(product)) {
+			return ResponseEntity.status(HttpStatus.CONFLICT).body(Collections.singletonMap("message", "not available"));
+		}
+		int quantity = 1;
+		if (cart.getProducts() != null) {
+			for (ReadableShoppingCartItem i : cart.getProducts()) {
+				if (product.getSku().equals(i.getSku())) {
+					quantity += i.getQuantity();
+				}
+			}
+		}
+		PersistableShoppingCartItem item = new PersistableShoppingCartItem();
+		item.setProduct(product.getSku());
+		item.setQuantity(quantity);
+		ReadableShoppingCart updated = shoppingCartFacade.modifyCart(cartCode, item, store, language);
+		repository.delete(w.get());
+		return ResponseEntity.ok(updated);
+	}
+
+	@GetMapping("/private/wishlists/popular")
+	public List<Map<String, Object>> popular(@ApiIgnore MerchantStore store) {
+		List<Map<String, Object>> out = new ArrayList<>();
+		for (Object[] row : repository.popular(store.getId())) {
+			if (out.size() == POPULAR) {
+				break;
+			}
+			Map<String, Object> m = new LinkedHashMap<>();
+			m.put("sku", row[0]);
+			m.put("count", ((Number) row[1]).intValue());
+			out.add(m);
+		}
+		return out;
+	}
+
+	private Customer customer(MerchantStore store, HttpServletRequest request) {
+		Principal principal = request.getUserPrincipal();
+		Customer customer;
+		try {
+			customer = customerFacade.getCustomerByUserName(principal.getName(), store);
+		} catch (Exception e) {
+			customer = null;
+		}
+		if (customer == null) {
+			throw new ResourceNotFoundException("No customer for " + principal.getName());
+		}
+		return customer;
+	}
+
+	private Optional<WishlistItem> item(Customer customer, String sku) {
+		return repository.findByCustomer(customer.getId()).stream().filter(w -> w.getSku().equals(sku)).findFirst();
+	}
+
+	private Product product(String sku, MerchantStore store, Language language) {
+		try {
+			return productService.getBySku(sku, store, language);
+		} catch (Exception e) {
+			return null;
+		}
+	}
+
+	private static boolean available(Product p) {
+		if (!p.isAvailable()) {
+			return false;
+		}
+		int quantity = 0;
+		if (p.getAvailabilities() != null) {
+			for (ProductAvailability a : p.getAvailabilities()) {
+				quantity += a.getProductQuantity() == null ? 0 : a.getProductQuantity();
+			}
+		}
+		return quantity > 0;
+	}
+
+	private Map<String, Object> readable(Customer customer, MerchantStore store, Language language) {
+		SimpleDateFormat iso = new SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'");
+		iso.setTimeZone(TimeZone.getTimeZone("UTC"));
+		List<Map<String, Object>> items = new ArrayList<>();
+		for (WishlistItem w : repository.findByCustomer(customer.getId())) {
+			Product p = product(w.getSku(), store, language);
+			if (p == null) {
+				continue;
+			}
+			Map<String, Object> m = new LinkedHashMap<>();
+			m.put("sku", p.getSku());
+			m.put("name", p.getProductDescription() == null ? p.getSku() : p.getProductDescription().getName());
+			BigDecimal price;
+			try {
+				price = pricingService.calculateProductPrice(p).getFinalPrice();
+			} catch (Exception e) {
+				price = null;
+			}
+			m.put("price", price);
+			m.put("available", available(p));
+			m.put("addedAt", iso.format(w.getAddedAt()));
+			items.add(m);
+		}
+		Map<String, Object> out = new LinkedHashMap<>();
+		out.put("count", items.size());
+		out.put("items", items);
+		return out;
+	}
+
+	private static ResponseEntity<?> bad(String message) {
+		return ResponseEntity.badRequest().body(Collections.singletonMap("message", message));
+	}
+}
