+package com.salesmanager.core.business.repositories.customer.wishlist;
+
+import java.util.List;
+import java.util.Optional;
+
+import org.springframework.data.jpa.repository.JpaRepository;
+import org.springframework.data.jpa.repository.Modifying;
+import org.springframework.data.jpa.repository.Query;
+import org.springframework.transaction.annotation.Transactional;
+
+import com.salesmanager.core.model.customer.wishlist.WishlistItem;
+
+public interface WishlistItemRepository extends JpaRepository<WishlistItem, Long> {
+
+	/** Most recently added first; the id breaks ties between items added in the same millisecond. */
+	@Query("select w from WishlistItem w where w.customerId = ?1 order by w.addedAt desc, w.id desc")
+	List<WishlistItem> findByCustomer(Long customerId);
+
+	@Query("select w from WishlistItem w where w.customerId = ?1 and w.productId = ?2")
+	Optional<WishlistItem> findByCustomerAndProduct(Long customerId, Long productId);
+
+	@Query("select count(w) from WishlistItem w where w.customerId = ?1")
+	long countByCustomer(Long customerId);
+
+	/** [sku, number of customers], for one store, most wished first, then by sku. */
+	@Query("select w.sku, count(w) from WishlistItem w where w.merchantId = ?1 group by w.sku order by count(w) desc, w.sku asc")
+	List<Object[]> popular(Integer merchantId);
+
+	@Transactional
+	@Modifying
+	@Query("delete from WishlistItem w where w.productId = ?1")
+	void deleteByProduct(Long productId);
+}
