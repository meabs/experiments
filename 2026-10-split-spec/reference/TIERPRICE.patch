+++ b/sm-shop/src/main/java/com/salesmanager/shop/store/api/v1/product/ProductPriceTierApi.java
@@ -0,0 +1,140 @@
+package com.salesmanager.shop.store.api.v1.product;
+
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.http.HttpStatus;
+import org.springframework.http.ResponseEntity;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.web.bind.annotation.GetMapping;
+import org.springframework.web.bind.annotation.PathVariable;
+import org.springframework.web.bind.annotation.PutMapping;
+import org.springframework.web.bind.annotation.RequestBody;
+import org.springframework.web.bind.annotation.RequestMapping;
+import org.springframework.web.bind.annotation.RestController;
+
+import com.salesmanager.core.business.repositories.catalog.product.price.ProductPriceTierRepository;
+import com.salesmanager.core.business.services.catalog.product.ProductService;
+import com.salesmanager.core.model.catalog.product.Product;
+import com.salesmanager.core.model.catalog.product.price.ProductPriceTier;
+import com.salesmanager.core.model.merchant.MerchantStore;
+
+import io.swagger.annotations.ApiImplicitParam;
+import io.swagger.annotations.ApiImplicitParams;
+import springfox.documentation.annotations.ApiIgnore;
+
+/** Admin API for a product's quantity price tiers (reference implementation for TIERPRICE). */
+@RestController
+@RequestMapping("/api/v1/private/product/{id}/tiers")
+@ApiImplicitParams({ @ApiImplicitParam(name = "store", dataType = "String", defaultValue = "DEFAULT") })
+public class ProductPriceTierApi {
+
+	static final int MAX_TIERS = 10;
+
+	@Autowired
+	private ProductPriceTierRepository repository;
+
+	@Autowired
+	private ProductService productService;
+
+	@GetMapping
+	public ResponseEntity<?> list(@PathVariable Long id, @ApiIgnore MerchantStore store) {
+		if (product(id, store) == null) {
+			return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+		}
+		return ResponseEntity.ok(readable(repository.findByProduct(id)));
+	}
+
+	@PutMapping
+	@Transactional
+	public ResponseEntity<?> replace(@PathVariable Long id, @RequestBody Object body, @ApiIgnore MerchantStore store) {
+		if (product(id, store) == null) {
+			return ResponseEntity.status(HttpStatus.NOT_FOUND).build();
+		}
+		if (!(body instanceof List)) {
+			return bad("the body must be a list of tiers");
+		}
+		List<ProductPriceTier> tiers = new ArrayList<>();
+		Set<Integer> seen = new HashSet<>();
+		for (Object o : (List<?>) body) {
+			if (!(o instanceof Map)) {
+				return bad("each tier must be an object");
+			}
+			Map<?, ?> m = (Map<?, ?>) o;
+			Integer min;
+			BigDecimal price;
+			try {
+				min = wholeNumber(m.get("minQuantity"));
+				price = m.get("price") == null ? null : new BigDecimal(String.valueOf(m.get("price")));
+			} catch (NumberFormatException e) {
+				return bad("minQuantity must be a whole number and price a number");
+			}
+			if (min == null || price == null) {
+				return bad("minQuantity and price are required");
+			}
+			if (min < 2) {
+				return bad("minQuantity must be at least 2");
+			}
+			if (price.signum() <= 0) {
+				return bad("price must be more than 0");
+			}
+			if (!seen.add(min)) {
+				return bad("two tiers have minQuantity " + min);
+			}
+			ProductPriceTier t = new ProductPriceTier();
+			t.setProductId(id);
+			t.setMinQuantity(min);
+			t.setPrice(price);
+			tiers.add(t);
+		}
+		if (tiers.size() > MAX_TIERS) {
+			return bad("at most " + MAX_TIERS + " tiers");
+		}
+		tiers.sort((a, b) -> Integer.compare(a.getMinQuantity(), b.getMinQuantity()));
+		for (int i = 1; i < tiers.size(); i++) {
+			if (tiers.get(i).getPrice().compareTo(tiers.get(i - 1).getPrice()) >= 0) {
+				return bad("a tier for more units must have a lower price");
+			}
+		}
+		repository.deleteByProduct(id);
+		repository.flush();
+		return ResponseEntity.ok(readable(repository.saveAll(tiers)));
+	}
+
+	private Product product(Long id, MerchantStore store) {
+		// getById(id) returns a lazy reference that fails later for a missing id; this query returns null instead
+		return productService.findOne(id, store);
+	}
+
+	private static Integer wholeNumber(Object o) {
+		if (o == null) {
+			return null;
+		}
+		BigDecimal d = new BigDecimal(String.valueOf(o));
+		if (d.stripTrailingZeros().scale() > 0) {
+			throw new NumberFormatException("not whole");
+		}
+		return d.intValueExact();
+	}
+
+	private static ResponseEntity<?> bad(String message) {
+		return ResponseEntity.badRequest().body(Collections.singletonMap("message", message));
+	}
+
+	private static List<Map<String, Object>> readable(List<ProductPriceTier> tiers) {
+		return tiers.stream().sorted((a, b) -> Integer.compare(a.getMinQuantity(), b.getMinQuantity())).map(t -> {
+			Map<String, Object> m = new LinkedHashMap<>();
+			m.put("minQuantity", t.getMinQuantity());
+			m.put("price", t.getPrice());
+			return m;
+		}).collect(Collectors.toList());
+	}
+}
