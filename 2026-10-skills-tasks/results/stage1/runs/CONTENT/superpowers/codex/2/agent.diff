+package com.salesmanager.test.shop.content;
+
+import static org.junit.Assert.assertTrue;
+import static org.mockito.Mockito.when;
+
+import java.util.Collections;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.InjectMocks;
+import org.mockito.Mock;
+import org.mockito.junit.MockitoJUnitRunner;
+import org.springframework.data.domain.PageImpl;
+
+import com.salesmanager.core.business.services.content.ContentService;
+import com.salesmanager.core.model.content.Content;
+import com.salesmanager.core.model.content.ContentType;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.content.page.ReadableContentPage;
+import com.salesmanager.shop.model.entity.ReadableEntityList;
+import com.salesmanager.shop.store.facade.content.ContentFacadeImpl;
+
+@RunWith(MockitoJUnitRunner.class)
+public class ContentFacadeImplTest {
+
+    @Mock
+    private ContentService contentService;
+
+    @InjectMocks
+    private ContentFacadeImpl contentFacade;
+
+    private MerchantStore store;
+    private Language language;
+
+    @Before
+    public void setUp() {
+        store = new MerchantStore();
+        language = new Language();
+    }
+
+    @Test
+    public void getContentPagesReturnsPageItems() throws Exception {
+        Content content = new Content();
+        content.setCode("home");
+        content.setContentType(ContentType.PAGE);
+        when(contentService.listByType(ContentType.PAGE, store, 0, 10))
+                .thenReturn(new PageImpl<>(Collections.singletonList(content)));
+
+        ReadableEntityList<ReadableContentPage> result = contentFacade.getContentPages(store, language, 0, 10);
+
+        assertTrue(result.getItems().get(0) instanceof ReadableContentPage);
+    }
+}
