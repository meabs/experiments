+package com.salesmanager.test.shop.api.v1.category;
+
+import static org.junit.Assert.assertSame;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+import org.junit.Before;
+import org.junit.Test;
+import org.mockito.Mock;
+import org.mockito.MockitoAnnotations;
+import org.springframework.test.util.ReflectionTestUtils;
+
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.core.model.reference.language.Language;
+import com.salesmanager.shop.model.catalog.category.ReadableCategory;
+import com.salesmanager.shop.store.api.v1.category.CategoryApi;
+import com.salesmanager.shop.store.controller.category.facade.CategoryFacade;
+
+public class CategoryApiLookupTest {
+
+    @Mock
+    private CategoryFacade categoryFacade;
+
+    private CategoryApi categoryApi;
+
+    @Before
+    public void setUp() {
+        MockitoAnnotations.openMocks(this);
+        categoryApi = new CategoryApi();
+        ReflectionTestUtils.setField(categoryApi, "categoryFacade", categoryFacade);
+    }
+
+    @Test
+    public void numericLookupUsesCategoryId() throws Exception {
+        MerchantStore store = new MerchantStore();
+        Language language = new Language();
+        ReadableCategory expected = new ReadableCategory();
+        when(categoryFacade.getById(store, 12L, language)).thenReturn(expected);
+
+        assertSame(expected, categoryApi.get("12", store, language));
+        verify(categoryFacade).getById(store, 12L, language);
+    }
+
+    @Test
+    public void friendlyUrlLookupUsesFriendlyUrl() throws Exception {
+        MerchantStore store = new MerchantStore();
+        Language language = new Language();
+        ReadableCategory expected = new ReadableCategory();
+        when(categoryFacade.getCategoryByFriendlyUrl(store, "dining-chairs", language)).thenReturn(expected);
+
+        assertSame(expected, categoryApi.get("dining-chairs", store, language));
+        verify(categoryFacade).getCategoryByFriendlyUrl(store, "dining-chairs", language);
+    }
+}
