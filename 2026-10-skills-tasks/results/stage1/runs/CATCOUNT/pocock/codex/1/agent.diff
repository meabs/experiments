+	@Override
+	public List<Object[]> countProductsByCategoryLineage(MerchantStore store) {
+		String hql = "select root.id, count(distinct product.id) "
+				+ "from Product product join product.categories productCategory, Category root "
+				+ "where product.merchantStore.id = :mid and root.merchantStore.id = :mid "
+				+ "and product.available = true and product.dateAvailable <= :dt "
+				+ "and productCategory.lineage like concat(root.lineage, '%') "
+				+ "group by root.id";
+		Query q = this.em.createQuery(hql);
+		q.setParameter("mid", store.getId());
+		q.setParameter("dt", new Date());
+		@SuppressWarnings("unchecked")
+		List<Object[]> counts = q.getResultList();
+		return counts;
+	}
 	
