@@ -0,0 +1,23 @@
+package com.salesmanager.shop.store.facade.category;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+
+import java.util.List;
+import java.util.Map;
+
+import org.junit.jupiter.api.Test;
+
+class CategoryProductCountCalculatorTest {
+
+    @Test
+    void countsEachProductOnceAcrossAllDescendantCategories() {
+        Map<Long, Integer> counts = CategoryProductCountCalculator.calculate(
+                Map.of(1L, List.of(10L, 11L), 2L, List.of(10L), 3L, List.of(11L), 4L, List.of(12L)),
+                Map.of(1L, List.of(2L, 3L), 2L, List.of(4L), 3L, List.of()));
+
+        assertEquals(3, counts.get(1L));
+        assertEquals(2, counts.get(2L));
+        assertEquals(1, counts.get(3L));
+        assertEquals(1, counts.get(4L));
+    }
+}
