+	@Override
+	public List<Object[]> countProductsByCategoryHierarchy(MerchantStore store, List<Long> categoryIds) {
+		String hql = "select distinct target.id, product.id from Product product "
+				+ "join product.categories assigned, Category target "
+				+ "where target.id in (:cid) and (assigned.id = target.id "
+				+ "or assigned.lineage like concat(target.lineage, '%')) "
+				+ "and product.merchantStore.id = :mid and product.available=true "
+				+ "and product.dateAvailable<=:dt";
+		Query q = this.em.createQuery(hql);
+		q.setParameter("cid", categoryIds);
+		q.setParameter("mid", store.getId());
+		q.setParameter("dt", new Date());
+		@SuppressWarnings("unchecked")
+		List<Object[]> counts = q.getResultList();
+		return counts;
+	}
 	
