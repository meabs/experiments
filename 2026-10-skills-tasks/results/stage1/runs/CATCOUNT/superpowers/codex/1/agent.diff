--- /dev/null
+++ b/sm-shop/src/main/java/com/salesmanager/shop/store/facade/category/CategoryProductCountCalculator.java
@@ -0,0 +1,33 @@
+package com.salesmanager.shop.store.facade.category;
+
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+final class CategoryProductCountCalculator {
+
+    private CategoryProductCountCalculator() {}
+
+    static Map<Long, Integer> calculate(Map<Long, List<Long>> productsByCategory,
+            Map<Long, List<Long>> childrenByCategory) {
+        Map<Long, Integer> counts = new HashMap<>();
+        for (Long categoryId : productsByCategory.keySet()) {
+            Set<Long> products = new HashSet<>(productsByCategory.get(categoryId));
+            addDescendantProducts(categoryId, childrenByCategory, productsByCategory, products,
+                    new HashSet<>());
+            counts.put(categoryId, products.size());
+        }
+        return counts;
+    }
+
+    private static void addDescendantProducts(Long categoryId, Map<Long, List<Long>> childrenByCategory,
+            Map<Long, List<Long>> productsByCategory, Set<Long> products, Set<Long> visited) {
+        if (!visited.add(categoryId)) return;
+        for (Long childId : childrenByCategory.getOrDefault(categoryId, List.of())) {
+            products.addAll(productsByCategory.getOrDefault(childId, List.of()));
+            addDescendantProducts(childId, childrenByCategory, productsByCategory, products, visited);
+        }
+    }
+}
