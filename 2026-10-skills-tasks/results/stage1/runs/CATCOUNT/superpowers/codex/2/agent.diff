+	@Override
+	public List<Object[]> countProductsByCategoryHierarchy(MerchantStore store, List<Long> categoryIds) {
+		String hql = "select ancestor.id, count(distinct product.id) from Product product "
+				+ "join product.categories productCategory, Category ancestor "
+				+ "where ancestor.id in (:cid) and productCategory.lineage like concat(ancestor.lineage, '%') "
+				+ "and product.merchantStore = :store and product.available=true and product.dateAvailable<=:dt "
+				+ "group by ancestor.id";
+		Query q = this.em.createQuery(hql);
+		q.setParameter("cid", categoryIds);
+		q.setParameter("store", store);
+		q.setParameter("dt", new Date());
+		return q.getResultList();
+	}
 	
