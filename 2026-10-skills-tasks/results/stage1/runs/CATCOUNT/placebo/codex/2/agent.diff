+	@Override
+	public List<Object[]> countProductsByCategoryLineage(MerchantStore store, List<Long> categoryIds) {
+		String hql = "select parent.id, count(distinct product.id) from Category parent "
+				+ "join Product product with product.merchantStore.id = :mid "
+				+ "join product.categories category where parent.id in (:cid) "
+				+ "and product.available=true and product.dateAvailable<=:dt "
+				+ "and (category.id = parent.id or category.lineage like concat(parent.lineage, parent.id, '/%')) "
+				+ "group by parent.id";
+		Query query = this.em.createQuery(hql);
+		query.setParameter("mid", store.getId());
+		query.setParameter("cid", categoryIds);
+		query.setParameter("dt", new Date());
+		return query.getResultList();
+	}
 	
