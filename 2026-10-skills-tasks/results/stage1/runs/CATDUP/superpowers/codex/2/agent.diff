+package com.salesmanager.test.shop.store.facade.category;
+
+import static org.junit.Assert.assertThrows;
+import static org.mockito.Mockito.when;
+import static org.mockito.Mockito.verify;
+
+import java.util.Collections;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.mockito.InjectMocks;
+import org.mockito.Mock;
+import org.mockito.junit.MockitoJUnitRunner;
+
+import com.salesmanager.core.business.services.catalog.category.CategoryService;
+import com.salesmanager.core.model.catalog.category.Category;
+import com.salesmanager.core.model.merchant.MerchantStore;
+import com.salesmanager.shop.model.catalog.category.PersistableCategory;
+import com.salesmanager.shop.populator.catalog.PersistableCategoryPopulator;
+import com.salesmanager.shop.store.api.exception.ConflictException;
+import com.salesmanager.shop.store.facade.category.CategoryFacadeImpl;
+
+@RunWith(MockitoJUnitRunner.class)
+public class CategoryFacadeImplTest {
+
+    @Mock
+    private CategoryService categoryService;
+
+    @Mock
+    private PersistableCategoryPopulator categoryPopulator;
+
+    @InjectMocks
+    private CategoryFacadeImpl categoryFacade;
+
+    @Test
+    public void rejectsCodeUsedByAnotherCategoryBeforePersisting() throws Exception {
+        MerchantStore store = new MerchantStore();
+        PersistableCategory category = new PersistableCategory();
+        category.setCode("duplicate");
+        Category existing = new Category();
+        existing.setId(7L);
+        when(categoryService.getByCode(store, "duplicate")).thenReturn(existing);
+
+        assertThrows(ConflictException.class, () -> categoryFacade.saveCategory(store, category));
+    }
+
+    @Test
+    public void permitsKeepingOwnCode() throws Exception {
+        MerchantStore store = new MerchantStore();
+        PersistableCategory category = new PersistableCategory();
+        category.setId(7L);
+        category.setCode("same");
+        Category existing = new Category();
+        existing.setId(7L);
+        existing.setCategories(Collections.emptyList());
+        when(categoryService.getByCode(store, "same")).thenReturn(existing);
+        when(categoryService.getById(7L)).thenReturn(existing);
+        when(categoryPopulator.populate(category, existing, store, null)).thenReturn(existing);
+
+        categoryFacade.saveCategory(store, category);
+
+        verify(categoryService).saveOrUpdate(existing);
+    }
+
+}
