+package com.salesmanager.test.shop.populator.customer;
+
+import static org.junit.Assert.assertEquals;
+
+import org.junit.Test;
+
+import com.salesmanager.core.model.common.Billing;
+import com.salesmanager.core.model.customer.Customer;
+import com.salesmanager.core.model.reference.country.Country;
+import com.salesmanager.shop.model.customer.address.Address;
+import com.salesmanager.shop.populator.customer.PersistableCustomerShippingAddressPopulator;
+
+public class PersistableCustomerShippingAddressPopulatorTest {
+
+    @Test
+    public void storesDeliveryFieldsAndUsesBillingForMissingAddressFields() throws Exception {
+        Customer customer = new Customer();
+        Billing billing = new Billing();
+        billing.setAddress("Billing street");
+        billing.setCity("Billing city");
+        billing.setPostalCode("BILLING-POSTAL");
+        Country billingCountry = new Country();
+        billingCountry.setIsoCode("BE");
+        billing.setCountry(billingCountry);
+        customer.setBilling(billing);
+
+        Address delivery = new Address();
+        delivery.setFirstName("Jane");
+        delivery.setLastName("Doe");
+        delivery.setPostalCode("DELIVERY-POSTAL");
+        delivery.setStateProvince("DELIVERY-STATE");
+
+        new PersistableCustomerShippingAddressPopulator().populate(delivery, customer, null, null);
+
+        assertEquals("Billing street", customer.getDelivery().getAddress());
+        assertEquals("Billing city", customer.getDelivery().getCity());
+        assertEquals("DELIVERY-POSTAL", customer.getDelivery().getPostalCode());
+        assertEquals("DELIVERY-STATE", customer.getDelivery().getState());
+    }
+}
