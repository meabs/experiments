@@ -0,0 +1,24 @@
+package com.salesmanager.test.shop.manufacturer;
+
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import org.junit.Test;
+
+import com.salesmanager.shop.store.facade.manufacturer.ManufacturerCodeValidator;
+
+public class ManufacturerCodeValidatorTest {
+
+    @Test
+    public void acceptsCodesWithAllowedCharactersAndLength() {
+        assertTrue(ManufacturerCodeValidator.isValid("ab-12_X"));
+        assertTrue(ManufacturerCodeValidator.isValid("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"));
+    }
+
+    @Test
+    public void rejectsCodesOutsideTheTwoToThirtyTwoCharacterAllowedRange() {
+        assertFalse(ManufacturerCodeValidator.isValid("a"));
+        assertFalse(ManufacturerCodeValidator.isValid("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"));
+        assertFalse(ManufacturerCodeValidator.isValid("Bad Code!"));
+    }
+}
