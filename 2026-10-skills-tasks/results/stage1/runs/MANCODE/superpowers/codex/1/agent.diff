@@ -0,0 +1,9 @@
+package com.salesmanager.shop.store.facade.manufacturer;
+
+import java.util.regex.Pattern;
+
+public final class ManufacturerCodeValidator {
+    private static final Pattern VALID_CODE = Pattern.compile("[A-Za-z0-9_-]{2,32}");
+    private ManufacturerCodeValidator() { }
+    public static boolean isValid(String code) { return code != null && VALID_CODE.matcher(code).matches(); }
+}
