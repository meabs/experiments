+	/** Codes are 2 to 32 letters, digits, hyphens or underscores, unique per store. Sends 400 or 409 and returns false otherwise. */
+	private boolean codeAccepted(String code, Long id, MerchantStore store, HttpServletResponse response) {
+		try {
+			if (code == null || !code.matches("[A-Za-z0-9_-]{2,32}")) {
+				response.sendError(400, "Manufacturer code must be 2 to 32 letters, digits, hyphens or underscores");
+				return false;
+			}
+			Manufacturer existing = manufacturerService.getByCode(store, code);
+			if (existing != null && (id == null || !existing.getId().equals(id))) {
+				response.sendError(409, "Manufacturer code [" + code + "] is already used");
+				return false;
+			}
+			return true;
+		} catch (java.io.IOException e) {
+			throw new RuntimeException(e);
+		}
+	}
