+	/** Sets productCount on a category and its children: products in the category or any subcategory, each once. */
+	private void setProductCounts(ReadableCategory category, MerchantStore store) {
+		try {
+			List<Long> ids = new ArrayList<Long>();
+			ids.add(category.getId());
+			if (category.getLineage() != null) {
+				for (Category c : categoryService.getListByLineage(store, category.getLineage())) {
+					ids.add(c.getId());
+				}
+			}
+			category.setProductCount((int) categoryService.countDistinctAvailableProducts(store, ids));
+		} catch (ServiceException e) {
+			throw new ServiceRuntimeException("Error while counting products", e);
+		}
+		for (ReadableCategory child : category.getChildren()) {
+			setProductCounts(child, store);
+		}
+	}
